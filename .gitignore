# Token personal de Supabase (Management API). Fuera de git A PROPOSITO:
# es de CUENTA, no de proyecto — puede borrar proyectos enteros, y en el
# historial de GitHub quedaria para siempre. Vive en el servidor con perms 600.
.supabase-token

# Token suelto de captura de leads: es un secreto, nunca al historial.
leads-captura-token.txt

# Credenciales del CRM para QA con navegador: nunca al historial.
.crm-login
.cron-secret-prod
.vercel-token
.google-maps-key

# Sesión OAuth de YouTube. Lleva un refresh_token que permite editar el canal
# entero: si entra al historial, no se arregla borrándolo del repo — hay que
# revocarlo en myaccount.google.com/permissions. Misma regla que .supabase-token.
.yt-token.json
sitio/.yt-token.json
