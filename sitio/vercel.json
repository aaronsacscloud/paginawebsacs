    },
    {
      "path": "/api/cron/sync-sacs-activity",
      "schedule": "24 9 * * *"
    },
    {
      "path": "/api/cron/sync-sacs-uso",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron/arr-reminders",
      "schedule": "0 15 * * *"
    },
    {
