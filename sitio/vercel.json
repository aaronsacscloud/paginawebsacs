    },
    {
      "path": "/api/cron/quote-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-sacs-activity",
