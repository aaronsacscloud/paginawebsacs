---
/**
 * «El lector cuenta. Tú caminas.» (/experiencia/rfid): una pasada por el rack con el scroll (data-tramos="4"): el
 * conteo (1,248 piezas en 42 s), el estilo por talla contra Sacs, lo que no cuadra (faltan 2 M) y dónde están (la
 * bodega, caja 14). La foto de la vendedora con el lector a pantalla completa (un «cover» propio: las ondas de las
 * etiquetas no se mueven de su sitio) y, encima, la pantalla del lector. Ejemplo y en construcción.
 * Sin JS o con «reducir movimiento»: la pantalla en el último paso y los cuatro pasos en lista.
 */
import { RFID_PASADA } from '../../../data/experiencia-rfid';
const I = '/images/experiencia/';
const ETIQUETAS = [[70.3, 36], [78, 34], [88, 42], [71, 30], [93, 38]];
const { tallas } = RFID_PASADA;
---
<section class="rp" data-escena data-tramos="4" data-tramo="3" aria-labelledby="rp-h">
  <div class="rp-riel" data-riel>
    <div class="rp-escena">
      <div class="rp-lienzo">
        <img class="rp-foto" src={`${I}rfid-lector-1536.webp`} srcset={`${I}rfid-lector-1280.webp 1280w, ${I}rfid-lector-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" alt="Una vendedora apunta un lector RFID de mano a un rack de vestidos y camisas de lino con etiquetas blancas" loading="lazy" decoding="async" />
        {ETIQUETAS.map(([x, y], i) => <span class="rp-onda" style={`left:${x}%;top:${y}%;--i:${i}`} aria-hidden="true"></span>)}
      </div>

      <!-- la pantalla del lector -->
      <div class="rp-pant" role="img" aria-label={`La pantalla del lector: ${RFID_PASADA.total} piezas leídas en ${RFID_PASADA.segundos} segundos; del ${RFID_PASADA.estilo}, Sacs dice 3 M y se leyó 1: faltan 2, que están en la bodega, caja 14`}>
        <p class="rp-top"><span class="rp-vivo"><i></i>Leyendo</span><b>Rack 3 · Vestidos</b><em>Ejemplo</em></p>

        <div class="rp-v rp-v0">
          <p class="rp-n">{RFID_PASADA.total.toLocaleString('es-MX')}<small>piezas</small></p>
          <span class="rp-prog"><i></i></span>
          <p class="rp-s">leídas en <b>{RFID_PASADA.segundos} s</b> · sin sacar ninguna</p>
        </div>

        <div class="rp-v rp-v1">
          <p class="rp-estilo">{RFID_PASADA.estilo}</p>
          <div class="rp-tabla">
            <p class="rp-fila rp-fila--h"><span>Talla</span><span>Sacs</span><span>Leídas</span><span></span></p>
            {tallas.map((t) => <p class:list={['rp-fila', { 'is-mal': t.sacs !== t.leidas }]}><b>{t.t}</b><span>{t.sacs}</span><span>{t.leidas}</span><i>{t.sacs === t.leidas ? '✓' : '!'}</i></p>)}
          </div>
        </div>

        <div class="rp-v rp-v2">
          <p class="rp-alerta"><b>Faltan 2 M</b><span>Sacs dice 3 · el lector leyó 1</span></p>
          <ul class="rp-donde"><li>¿Vendidas sin registrar?</li><li>¿En el probador?</li><li>¿En la bodega?</li></ul>
        </div>

        <div class="rp-v rp-v3">
          <p class="rp-lugar"><small>Encontradas</small><b>Bodega · caja 14</b><span>2 M · {RFID_PASADA.estilo}</span></p>
          <p class="rp-btn">Súbelas al piso</p>
        </div>
      </div>

      <div class="rp-txt">
        <p class="rp-k">{RFID_PASADA.k}</p>
        <h2 class="rp-h" id="rp-h">{RFID_PASADA.h}</h2>
        <ol class="rp-pasos">
          {RFID_PASADA.pasos.map((p, k) => (
            <li class="rp-paso" data-k={k}>
              <span class="rp-paso-n">{p.n}</span>
              <span class="rp-paso-t"><b>{p.t}</b><span>{p.d}</span></span>
              <i class="rp-barra" aria-hidden="true"><b></b></i>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .rp { position: relative; background: #0B0B0C; color: #fff; }
  .rp-escena { position: relative; overflow: hidden; }
  .rp-lienzo { position: relative; width: 100%; aspect-ratio: 1536 / 1024; }
  .rp-foto { position: absolute; inset: 0; width: 100%; height: 100%; }
  .rp-onda { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: #fff; box-shadow: 0 0 12px rgba(91, 134, 234, 0.9); opacity: 0; transition: opacity 0.4s ease; }
  .rp-onda::before, .rp-onda::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.9); animation: rpOnda 2.2s ease-out infinite; animation-delay: calc(var(--i) * 0.3s); }
  .rp-onda::after { animation-delay: calc(var(--i) * 0.3s + 1.1s); }
  .rp[data-tramo="0"] .rp-onda { opacity: 1; }
  @keyframes rpOnda { 0% { transform: scale(0.6); opacity: 0.95; } 100% { transform: scale(3.2); opacity: 0; } }

  /* la pantalla del lector */
  .rp-pant { position: relative; width: min(100% - 40px, 340px); margin: 24px auto 0; padding: 16px 18px 18px; border-radius: 22px; background: #fff; color: #141414; box-shadow: 0 40px 80px -36px rgba(0, 0, 0, 0.85); min-height: 236px; }
  .rp-top { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; padding-bottom: 12px; border-bottom: 1px solid #ECE9E3; font: 600 12px/1.2 var(--font-display); }
  .rp-top b { flex: 1; font-weight: 600; color: #4A4741; }
  .rp-top em { padding: 3px 7px; border-radius: 99px; background: #F2C46B; font-style: normal; font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; }
  .rp-vivo { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 99px; background: #EAF0FD; color: #2F55C4; }
  .rp-vivo i { width: 7px; height: 7px; border-radius: 50%; background: #2F55C4; animation: rpLate 1.1s ease-in-out infinite; }
  @keyframes rpLate { 50% { opacity: 0.3; } }
  .rp-v { display: none; }
  .rp[data-tramo="0"] .rp-v0, .rp[data-tramo="1"] .rp-v1, .rp[data-tramo="2"] .rp-v2, .rp[data-tramo="3"] .rp-v3 { display: grid; gap: 10px; animation: rpAparece 0.45s ease both; }
  .rp-n { display: flex; align-items: baseline; gap: 8px; margin: 0; font: 700 64px/1 var(--pd-clash, var(--font-display)); letter-spacing: -0.03em; }
  .rp-n small { font: 600 14px/1 var(--font-display); color: #2F55C4; letter-spacing: 0; }
  .rp-prog { height: 8px; border-radius: 99px; background: #EAF0FD; overflow: hidden; }
  .rp-prog i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, #5B86EA, #2F55C4); transform-origin: 0 50%; }
  .rp[data-tramo="0"] .rp-prog i { animation: rpProg 2.2s cubic-bezier(0.3, 0.6, 0.4, 1) both; }
  @keyframes rpProg { from { transform: scaleX(0); } to { transform: none; } }
  .rp-s { margin: 0; font: 500 14px/1.3 var(--font-body); color: #4A4741; }
  .rp-s b { color: #2F55C4; }
  .rp-estilo { margin: 0; font: 700 15px/1.25 var(--font-display); }
  .rp-tabla { display: grid; }
  .rp-fila { display: grid; grid-template-columns: 1fr 1fr 1fr 28px; align-items: center; gap: 8px; margin: 0; padding: 9px 0; border-bottom: 1px solid #ECE9E3; font: 600 15px/1 var(--font-display); }
  .rp-fila--h { font: 600 10.5px/1.2 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #6B6862; padding-top: 0; }
  .rp-fila i { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #E3F4EA; color: #17804F; font-style: normal; font-size: 12px; font-weight: 700; }
  .rp-fila.is-mal { color: #B23A3A; }
  .rp-fila.is-mal i { background: #FBE3E3; color: #B23A3A; }
  .rp-alerta { display: grid; gap: 4px; margin: 0; padding: 14px 16px; border-radius: 14px; background: #FBE3E3; color: #8C2525; }
  .rp-alerta b { font: 700 30px/1 var(--pd-clash, var(--font-display)); }
  .rp-alerta span { font: 600 13.5px/1.3 var(--font-display); }
  .rp-donde { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; font: 500 14px/1.3 var(--font-body); color: #4A4741; }
  .rp-donde li::before { content: '· '; color: #B23A3A; font-weight: 700; }
  .rp-lugar { display: grid; gap: 4px; margin: 0; padding: 14px 16px; border-radius: 14px; background: #E3F4EA; color: #145C3A; }
  .rp-lugar small { font: 600 10.5px/1.2 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; }
  .rp-lugar b { font: 700 26px/1.05 var(--pd-clash, var(--font-display)); }
  .rp-lugar span { font: 500 13.5px/1.3 var(--font-body); }
  .rp-btn { margin: 0; display: grid; place-items: center; height: 44px; border-radius: 99px; background: #141414; color: #fff; font: 700 14px/1 var(--font-display); }
  @keyframes rpAparece { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .rp-txt { padding: 36px 20px 56px; }
  .rp-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #9DB8F5; }
  .rp-h { margin: 0; color: #fff; font: 700 clamp(40px, 5.2vw, 78px)/0.94 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; text-wrap: balance; }
  .rp-pasos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.3); }
  .rp-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 4px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .rp-paso-n { font: 700 19px/1.2 var(--pd-clash, var(--font-display)); color: #9DB8F5; }
  .rp-paso-t { display: grid; gap: 3px; }
  .rp-paso-t b { font: 700 16px/1.3 var(--font-display); color: #fff; }
  .rp-paso-t > span { font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.82); }
  .rp-barra { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .rp-barra b { display: block; height: 100%; background: #5B86EA; transform: scaleX(0); transform-origin: 0 50%; }
  @keyframes rpBarra { from { transform: scaleX(0); } to { transform: none; } }

  /* ── con el scroll ── */
  .rp.is-escena .rp-riel { height: 460vh; }
  .rp.is-escena .rp-escena { position: sticky; top: 0; height: 100vh; height: 100svh; }
  .rp.is-escena .rp-lienzo { position: absolute; left: 50%; top: 50%; width: max(100vw, calc(100svh * 1.5)); transform: translate(-50%, -50%); }
  .rp.is-escena .rp-pant { position: absolute; z-index: 3; margin: 0; }
  .rp.is-escena .rp-paso-n { color: rgba(255, 255, 255, 0.45); }
  .rp.is-escena[data-tramo="0"] .rp-paso[data-k="0"] .rp-paso-n, .rp.is-escena[data-tramo="1"] .rp-paso[data-k="1"] .rp-paso-n, .rp.is-escena[data-tramo="2"] .rp-paso[data-k="2"] .rp-paso-n, .rp.is-escena[data-tramo="3"] .rp-paso[data-k="3"] .rp-paso-n { color: #9DB8F5; }
  .rp.is-escena[data-tramo="0"] .rp-paso[data-k="0"] .rp-barra b, .rp.is-escena[data-tramo="1"] .rp-paso[data-k="1"] .rp-barra b, .rp.is-escena[data-tramo="2"] .rp-paso[data-k="2"] .rp-barra b, .rp.is-escena[data-tramo="3"] .rp-paso[data-k="3"] .rp-barra b { animation: rpBarra 4.5s linear both; }

  @media (min-width: 900px) {
    .rp.is-escena .rp-escena::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(8, 8, 10, 0.88) 0%, rgba(8, 8, 10, 0.6) 24%, rgba(8, 8, 10, 0) 38%); }
    .rp.is-escena .rp-txt { position: absolute; left: 0; top: 50%; z-index: 2; width: min(32vw, 430px); padding: 0 0 0 4.4vw; transform: translateY(-50%); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
    .rp.is-escena .rp-paso-t > span { display: none; }
    .rp.is-escena[data-tramo="0"] .rp-paso[data-k="0"] .rp-paso-t > span, .rp.is-escena[data-tramo="1"] .rp-paso[data-k="1"] .rp-paso-t > span, .rp.is-escena[data-tramo="2"] .rp-paso[data-k="2"] .rp-paso-t > span, .rp.is-escena[data-tramo="3"] .rp-paso[data-k="3"] .rp-paso-t > span { display: block; }
    .rp.is-escena .rp-pant { right: 4vw; bottom: 8vh; width: 340px; }
  }
  @media (max-width: 899px) {
    .rp.is-escena .rp-lienzo { left: 0; top: 0; width: auto; height: 56svh; transform: translateX(calc(-55% + 50vw)); }
    .rp.is-escena .rp-pant { left: 16px; right: 16px; width: auto; top: calc(56svh - 150px); min-height: 0; padding: 12px 14px 14px; }
    .rp.is-escena .rp-top { margin-bottom: 10px; padding-bottom: 8px; }
    .rp.is-escena .rp-n { font-size: 44px; }
    .rp.is-escena .rp-fila { padding: 6px 0; font-size: 13px; }
    .rp.is-escena .rp-donde { display: none; }
    .rp.is-escena .rp-txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 20px 20px 18px; background: #0B0B0C; }
    .rp.is-escena .rp-k { margin-bottom: 8px; }
    .rp.is-escena .rp-h { font-size: clamp(28px, 8vw, 38px); }
    .rp.is-escena .rp-pasos { margin-top: 10px; }
    .rp.is-escena .rp-paso { display: none; padding: 10px 0 8px; }
    .rp.is-escena[data-tramo="0"] .rp-paso[data-k="0"], .rp.is-escena[data-tramo="1"] .rp-paso[data-k="1"], .rp.is-escena[data-tramo="2"] .rp-paso[data-k="2"], .rp.is-escena[data-tramo="3"] .rp-paso[data-k="3"] { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rp * { animation: none !important; transition: none !important; }
  }
  /* teléfono: una sombra ligera (las grandes y difuminadas pesan al hacer scroll) */
  @media (max-width: 767px) {
    .rp-pant { box-shadow: 0 12px 24px -14px rgba(0, 0, 0, 0.5); }
  }
  /* teléfono: cada paso pide unas tres cuartas partes de pantalla de scroll (en escritorio, casi una completa) */
  @media (max-width: 899px) {
    .rp.is-escena .rp-riel { height: 400vh; }
  }
</style>
