---
/**
 * Portada de una experiencia (/experiencia/*): la foto a pantalla completa con el título encima, como la entrada de
 * /planeacion-de-demanda pero con la foto como protagonista (pedido del dueño, 2-oct-2026: «la imagen en pantalla
 * completa»). En escritorio, la foto horizontal (el texto vive en su tercio tranquilo, a la izquierda); en el teléfono,
 * la vertical, con el texto abajo sobre un velo. La foto es el LCP: eager + fetchpriority (la página precarga la del
 * teléfono).
 * `aviso` (3-oct-2026): una pastilla arriba del título para las experiencias que todavía están en construcción. El slot
 * va encima de la foto (capas propias de cada experiencia, como el mapa de calor de las cámaras).
 */
interface Props {
  folio: string;
  etiqueta: string;
  titulo: string;
  bajada: string;
  /** foto horizontal: [src 1280, src 1920] y su alto a 1920 */
  ancha: { s1280: string; s1920: string; alto1920: number };
  /** foto vertical del teléfono */
  vertical: { src: string; ancho: number; alto: number };
  alt: string;
  ancla: string;
  /** pastilla arriba del título (p. ej. «En construcción · así va a funcionar») */
  aviso?: string;
  /** el texto del enlace que baja a la primera sección (por omisión «Así se vive») */
  sigue?: string;
}
const { folio, etiqueta, titulo, bajada, ancha, vertical, alt, ancla, aviso, sigue = 'Así se vive' } = Astro.props;
---
<section class="exh" aria-labelledby="exh-h">
  <picture>
    <source media="(min-width: 768px)" srcset={`${ancha.s1280} 1280w, ${ancha.s1920} 1920w`} sizes="100vw" width="1920" height={ancha.alto1920} />
    <img class="exh-foto" src={vertical.src} width={vertical.ancho} height={vertical.alto} alt={alt} loading="eager" fetchpriority="high" decoding="async" />
  </picture>
  <slot />
  <div class="exh-velo" aria-hidden="true"></div>
  <div class="exh-in">
    <p class="exh-folio"><span>{folio}</span><span>{etiqueta}</span></p>
    {aviso && <p class="exh-aviso"><i aria-hidden="true"></i>{aviso}</p>}
    <h1 class="exh-h" id="exh-h">{titulo}</h1>
    <p class="exh-p">{bajada}</p>
    <div class="exh-acc">
      <a class="exh-cta" href="/contacto" data-evento="experiencia_cta_portada">Agenda una demo</a>
      <a class="exh-sigue" href={`#${ancla}`}>{sigue}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .exh { position: relative; display: flex; align-items: flex-end; min-height: max(620px, 100svh); overflow: hidden; background: #0B0B0C; color: #fff; isolation: isolate; }
  .exh picture { position: absolute; inset: 0; z-index: -2; }
  .exh-foto { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  /* teléfono: el velo de abajo, donde va el texto */
  .exh-velo { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(11, 11, 12, 0) 34%, rgba(11, 11, 12, 0.72) 62%, rgba(11, 11, 12, 0.94) 100%); }
  .exh-in { width: 100%; max-width: 1160px; margin: 0 auto; padding: 0 20px 56px; }
  .exh-folio { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 18px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.45); font: 600 11px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; }
  .exh-aviso { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; padding: 7px 14px 7px 11px; border-radius: 99px; background: #F2C46B; color: #141414; font: 700 12.5px/1.2 var(--font-display); letter-spacing: 0.02em; }
  .exh-aviso i { width: 8px; height: 8px; border-radius: 50%; background: #141414; }
  .exh-h { margin: 0; max-width: 11ch; color: #fff; font: 700 clamp(46px, 8.4vw, 124px)/0.92 var(--pd-clash, var(--font-display)); letter-spacing: -0.025em; text-wrap: balance; }
  .exh-p { margin: 18px 0 0; max-width: 38ch; font: 500 17px/1.5 var(--font-body); color: rgba(255, 255, 255, 0.9); }
  .exh-acc { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  .exh-cta { display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; background: #fff; color: #141414; font: 700 15px/1 var(--font-display); text-decoration: none; transition: transform 0.2s; }
  .exh-cta:hover { color: #141414; text-decoration: none; transform: translateY(-1px); }
  .exh-sigue { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding-bottom: 2px; border-bottom: 1.5px solid #fff; color: #fff; font: 600 15px/1 var(--font-display); text-decoration: none; }
  .exh-sigue:hover { color: #fff; text-decoration: none; opacity: 0.8; }
  .exh-cta:focus-visible, .exh-sigue:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  @media (min-width: 768px) {
    .exh { align-items: center; }
    .exh-foto { object-position: 70% 50%; }
    /* el texto vive en el tercio tranquilo de la foto, a la izquierda */
    .exh-velo { background: linear-gradient(90deg, rgba(11, 11, 12, 0.84) 0%, rgba(11, 11, 12, 0.55) 34%, rgba(11, 11, 12, 0) 62%), linear-gradient(180deg, rgba(11, 11, 12, 0) 70%, rgba(11, 11, 12, 0.5) 100%); }
    .exh-in { padding: 120px 5vw 80px; }
    .exh-folio { max-width: 520px; }
    /* el texto no pasa del tercio tranquilo de la foto */
    .exh-h { max-width: 42vw; font-size: clamp(46px, 6.4vw, 104px); }
    .exh-p { max-width: min(38ch, 40vw); }
    .exh-p { font-size: 19px; }
  }
</style>
