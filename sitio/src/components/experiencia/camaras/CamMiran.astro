---
/**
 * «Lo miran, pero no lo compran» (/experiencia/camaras-con-ia): lo que la caja no ve. A la izquierda, la mesa de
 * novedades con su mancha de calor; a la derecha, lo que diría la cámara (se detienen, se quedan, compran) junto a lo
 * que Sacs YA sabe (la venta, la talla, lo que hay en piso) y la acción. En fucsia, con su palabra gigante. Ejemplo y
 * en construcción (la cámara); cada renglón entra al verse (.rv → .is-on, script de la página).
 */
import { CAM_MIRAN } from '../../../data/experiencia-camaras';
const I = '/images/experiencia/';
const PALABRA = Array.from({ length: 3 }, () => 'LO MIRAN').join(' · ');
---
<section class="pda cm pd-fucsia" aria-labelledby="cm-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <p class="pd-folio"><span>{CAM_MIRAN.k}</span><span>En construcción</span></p>
  <div class="cm-grid">
    <figure class="cm-foto rv" style="--i:0">
      <img src={`${I}camaras-mesa-1280.webp`} srcset={`${I}camaras-mesa-1280.webp 1280w, ${I}camaras-mesa-1536.webp 1536w`} sizes="(min-width: 900px) 50vw, 100vw" width="1536" height="1024" alt="Una clienta revisa una camisa de lino mandarina en la mesa de novedades" loading="lazy" decoding="async" />
      <span class="cm-mancha" aria-hidden="true"></span>
      <figcaption>Mesa de novedades</figcaption>
    </figure>
    <div class="cm-txt">
      <h2 class="pda-h cm-h" id="cm-h">{CAM_MIRAN.h}</h2>
      <p class="cm-p">{CAM_MIRAN.p}</p>
      <dl class="cm-filas">
        {CAM_MIRAN.filas.map((f, i) => <div class="rv" style={`--i:${i + 1}`}><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
      </dl>
      <p class="cm-porque rv" style="--i:4"><b>Por qué</b>{CAM_MIRAN.porque}</p>
      <p class="cm-accion rv" style="--i:5"><span aria-hidden="true">→</span>{CAM_MIRAN.accion}</p>
    </div>
  </div>
</section>

<style>
  .cm-grid { display: grid; gap: 32px; margin-top: 8px; }
  .cm-foto { position: relative; margin: 0; overflow: hidden; border-radius: 22px; box-shadow: 0 40px 80px -40px rgba(60, 0, 20, 0.6); }
  .cm-foto img { display: block; width: 100%; height: auto; }
  .cm-mancha { position: absolute; left: 52%; top: 60%; width: 58%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(255, 31, 61, 0.75) 0%, rgba(255, 106, 26, 0.6) 32%, rgba(255, 210, 63, 0.35) 62%, rgba(255, 228, 122, 0) 100%); mix-blend-mode: multiply; animation: cmLate 5s ease-in-out infinite alternate; }
  @keyframes cmLate { from { transform: translate(-50%, -50%) scale(0.92); } to { transform: translate(-50%, -50%) scale(1.05); } }
  .cm-foto figcaption { position: absolute; left: 16px; bottom: 16px; padding: 8px 13px; border-radius: 99px; background: rgba(255, 255, 255, 0.95); color: #141414; font: 700 13px/1 var(--font-display); }
  .cm-h { max-width: 12ch; }
  .cm-p { margin: 18px 0 0; max-width: 44ch; font: 500 17px/1.55 var(--font-body); color: #fff; }
  .cm-filas { margin: 26px 0 0; border-top: 2px solid #fff; }
  .cm-filas > div { display: grid; grid-template-columns: 140px 1fr; gap: 12px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--pd-filete); }
  .cm-filas dt { font: 600 12px/1.3 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: #fff; }
  .cm-filas dd { margin: 0; font: 700 clamp(20px, 2.2vw, 28px)/1.15 var(--pd-clash); color: #fff; }
  .cm-porque { display: grid; gap: 6px; margin: 22px 0 0; padding: 16px 18px; border-radius: 16px; background: #fff; color: #141414; font: 600 16px/1.45 var(--font-display); }
  .cm-porque b { font: 700 11px/1.2 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: #B02A5B; }
  .cm-accion { display: inline-flex; align-items: center; gap: 10px; margin: 14px 0 0; padding: 12px 18px; border-radius: 99px; background: #141414; color: #fff; font: 700 15px/1.2 var(--font-display); }
  :global(.js-rv) .cm .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.08s); }
  :global(.js-rv) .cm .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .cm-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 5vw; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cm-mancha { animation: none; }
    :global(.js-rv) .cm .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
