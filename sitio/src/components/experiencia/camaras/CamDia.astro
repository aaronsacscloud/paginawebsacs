---
/**
 * «Un día en tu tienda» (/experiencia/camaras-con-ia): la planta de la tienda vista desde el techo y su mapa de calor,
 * que se arma con el scroll de la apertura al cierre (data-tramos="4": 11:00 · 14:00 · 17:00 · 20:00). Cada zona es
 * una mancha (SVG, degradado radial) cuyo calor por tramo viene de CAM_ZONAS; las zonas frías salen en azul al final,
 * con las etiquetas del mapa del día. A la derecha, la tarjeta de la zona más vista y su permanencia.
 * Escritorio: la foto a pantalla completa con un «cover» propio (el lienzo conserva la proporción: manchas y
 * etiquetas no se mueven de su sitio). Teléfono: la foto arriba, recorriéndose a la zona del tramo; el paso, abajo.
 * Sin JS o con «reducir movimiento»: el mapa del día completo y los cuatro pasos en lista. Todo es de ejemplo.
 */
import { CAM_DIA, CAM_ZONAS } from '../../../data/experiencia-camaras';
const I = '/images/experiencia/';
const W = 1536, H = 1024;
---
<section class="cd" data-escena data-tramos="4" data-tramo="3" aria-labelledby="cd-h">
  <div class="cd-riel" data-riel>
    <div class="cd-escena">
      <div class="cd-lienzo">
        <img class="cd-foto" src={`${I}camaras-planta-1536.webp`} srcset={`${I}camaras-planta-1280.webp 1280w, ${I}camaras-planta-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" alt="La planta de una boutique vista desde el techo: la mesa redonda de novedades al centro, racks en las paredes, la pared de mezclilla, los probadores, la caja y la entrada con su aparador" loading="lazy" decoding="async" />
        <svg class="cd-calor" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <radialGradient id="cd-caliente"><stop offset="0" stop-color="#FF1F3D" stop-opacity=".78" /><stop offset=".32" stop-color="#FF6A1A" stop-opacity=".62" /><stop offset=".62" stop-color="#FFD23F" stop-opacity=".38" /><stop offset="1" stop-color="#FFE47A" stop-opacity="0" /></radialGradient>
            <radialGradient id="cd-frio"><stop offset="0" stop-color="#2F7BFF" stop-opacity=".7" /><stop offset=".55" stop-color="#5FA8FF" stop-opacity=".36" /><stop offset="1" stop-color="#5FA8FF" stop-opacity="0" /></radialGradient>
          </defs>
          {CAM_ZONAS.map((z) => (
            <g class:list={['cd-z', { 'is-frio': z.frio }]} style={z.calor.map((c, k) => `--c${k}:${c}`).join(';')}>
              <circle cx={(z.x * W) / 100} cy={(z.y * H) / 100} r={(z.r * W) / 100} fill={z.frio ? 'url(#cd-frio)' : 'url(#cd-caliente)'} />
            </g>
          ))}
        </svg>
        {CAM_DIA.etiquetas.map((e, i) => (
          <span class={`cd-et cd-et--${e.tipo}`} data-i={i} style={`left:${e.x}%;top:${e.y}%;--i:${i}`} aria-hidden="true"><i></i><b>{e.t}</b><em>{e.v}</em></span>
        ))}
      </div>

      <div class="cd-tarjeta" aria-hidden="true">
        <p class="cd-reloj">{CAM_DIA.tramos.map((t, k) => <span data-k={k}>{t.hora}</span>)}</p>
        <p class="cd-fila"><small>Zona más vista</small><b>{CAM_DIA.tramos.map((t, k) => <span data-k={k}>{t.zona}</span>)}</b></p>
        <p class="cd-fila cd-fila--perm"><small>Permanencia promedio</small><b>{CAM_DIA.tramos.map((t, k) => <span data-k={k}>{t.perm}<em> min</em></span>)}</b></p>
      </div>

      <div class="cd-txt">
        <p class="cd-k">{CAM_DIA.k}</p>
        <h2 class="cd-h" id="cd-h">{CAM_DIA.h}</h2>
        <ol class="cd-pasos">
          {CAM_DIA.tramos.map((p, k) => (
            <li class="cd-paso" data-k={k}>
              <span class="cd-paso-n">{p.hora}</span>
              <span class="cd-paso-t"><b>{p.t}</b><span>{p.d}</span></span>
              <i class="cd-barra" aria-hidden="true"><b></b></i>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .cd { position: relative; background: #0B0B0C; color: #fff; }
  .cd-escena { position: relative; overflow: hidden; }
  /* sin escena: la foto con el mapa del día y los pasos debajo */
  .cd-lienzo { position: relative; width: 100%; aspect-ratio: 1536 / 1024; }
  .cd-foto { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cd-calor { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cd-z { transform-box: fill-box; transform-origin: center; opacity: var(--c); transform: scale(calc(0.4 + var(--c) * 0.6)); transition: opacity 0.9s ease, transform 1.1s cubic-bezier(0.22, 1, 0.36, 1); }
  .cd[data-tramo="0"] .cd-z { --c: var(--c0); }
  .cd[data-tramo="1"] .cd-z { --c: var(--c1); }
  .cd[data-tramo="2"] .cd-z { --c: var(--c2); }
  .cd[data-tramo="3"] .cd-z { --c: var(--c3); }
  /* lo frío solo se pinta en el mapa del día */
  .cd .cd-z.is-frio { opacity: 0; transform: scale(0.6); }
  .cd[data-tramo="3"] .cd-z.is-frio { opacity: 1; transform: none; }
  .cd-et { position: absolute; z-index: 2; display: inline-grid; grid-template-columns: auto auto; align-items: center; gap: 2px 8px; padding: 8px 13px 9px 10px; border-radius: 12px; background: rgba(255, 255, 255, 0.95); color: #141414; transform: translate(-50%, -50%); white-space: nowrap; box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.55); opacity: 0; transition: opacity 0.5s ease, transform 0.5s ease; }
  .cd-et i { grid-row: span 2; width: 10px; height: 10px; border-radius: 50%; background: #FF3B30; box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.22); }
  .cd-et--frio i { background: #2F7BFF; box-shadow: 0 0 0 4px rgba(47, 123, 255, 0.22); }
  .cd-et b { font: 700 13.5px/1.1 var(--font-display); }
  .cd-et em { font: 600 12px/1.1 var(--font-display); font-style: normal; color: #B02A1A; }
  .cd-et--frio em { color: #1F4FB8; }
  .cd[data-tramo="3"] .cd-et { opacity: 1; transition-delay: calc(0.5s + var(--i) * 0.25s); }

  .cd-tarjeta { display: grid; gap: 12px; width: min(100% - 40px, 300px); margin: 24px auto 0; padding: 16px 18px; border-radius: 18px; background: #fff; color: #141414; }
  .cd-reloj { margin: 0; font: 700 30px/1 var(--pd-clash, var(--font-display)); color: #141414; }
  .cd-fila { display: grid; gap: 3px; margin: 0; }
  .cd-fila small { font: 600 10.5px/1.2 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #6B6862; }
  .cd-fila b { font: 700 18px/1.15 var(--font-display); }
  .cd-fila--perm b { font: 700 34px/1 var(--pd-clash, var(--font-display)); color: #2F55C4; }
  .cd-fila em { font-style: normal; font-size: 13px; color: #6B6862; }
  .cd-tarjeta [data-k] { display: none; }
  .cd[data-tramo="0"] .cd-tarjeta [data-k="0"], .cd[data-tramo="1"] .cd-tarjeta [data-k="1"], .cd[data-tramo="2"] .cd-tarjeta [data-k="2"], .cd[data-tramo="3"] .cd-tarjeta [data-k="3"] { display: inline; animation: cdAparece 0.45s ease both; }

  .cd-txt { padding: 36px 20px 56px; }
  .cd-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #FFB15C; }
  .cd-h { margin: 0; color: #fff; font: 700 clamp(40px, 5.2vw, 78px)/0.94 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; }
  .cd-pasos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.3); }
  .cd-paso { position: relative; display: grid; grid-template-columns: 62px 1fr; gap: 4px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .cd-paso-n { font: 700 17px/1.3 var(--pd-clash, var(--font-display)); color: #FFB15C; transition: color 0.3s; }
  .cd-paso-t { display: grid; gap: 3px; }
  .cd-paso-t b { font: 700 16px/1.3 var(--font-display); color: #fff; }
  .cd-paso-t > span { font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.8); }
  .cd-barra { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .cd-barra b { display: block; height: 100%; background: #FF7A1A; transform: scaleX(0); transform-origin: 0 50%; }

  /* ── con el scroll ── */
  .cd.is-escena .cd-riel { height: 460vh; }
  .cd.is-escena .cd-escena { position: sticky; top: 0; height: 100vh; height: 100svh; }
  .cd.is-escena .cd-lienzo { position: absolute; left: 50%; top: 50%; width: max(100vw, calc(100svh * 1.5)); transform: translate(-50%, -50%); transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1); }
  .cd.is-escena .cd-tarjeta { position: absolute; z-index: 3; margin: 0; }
  .cd.is-escena .cd-paso-n { color: rgba(255, 255, 255, 0.45); }
  .cd.is-escena[data-tramo="0"] .cd-paso[data-k="0"] .cd-paso-n, .cd.is-escena[data-tramo="1"] .cd-paso[data-k="1"] .cd-paso-n, .cd.is-escena[data-tramo="2"] .cd-paso[data-k="2"] .cd-paso-n, .cd.is-escena[data-tramo="3"] .cd-paso[data-k="3"] .cd-paso-n { color: #FFB15C; }
  .cd.is-escena[data-tramo="0"] .cd-paso[data-k="0"] .cd-barra b, .cd.is-escena[data-tramo="1"] .cd-paso[data-k="1"] .cd-barra b, .cd.is-escena[data-tramo="2"] .cd-paso[data-k="2"] .cd-barra b, .cd.is-escena[data-tramo="3"] .cd-paso[data-k="3"] .cd-barra b { animation: cdBarra 4.5s linear both; }
  @keyframes cdBarra { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes cdAparece { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  @media (min-width: 900px) {
    .cd.is-escena .cd-escena::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(8, 8, 10, 0.88) 0%, rgba(8, 8, 10, 0.62) 24%, rgba(8, 8, 10, 0) 40%); }
    .cd.is-escena .cd-txt { position: absolute; left: 0; top: 50%; z-index: 2; width: min(32vw, 440px); padding: 0 0 0 4.4vw; transform: translateY(-50%); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
    .cd.is-escena .cd-paso-t > span { display: none; }
    .cd.is-escena[data-tramo="0"] .cd-paso[data-k="0"] .cd-paso-t > span, .cd.is-escena[data-tramo="1"] .cd-paso[data-k="1"] .cd-paso-t > span, .cd.is-escena[data-tramo="2"] .cd-paso[data-k="2"] .cd-paso-t > span, .cd.is-escena[data-tramo="3"] .cd-paso[data-k="3"] .cd-paso-t > span { display: block; }
    .cd.is-escena .cd-tarjeta { right: 3.5vw; bottom: 7vh; width: 260px; padding: 18px 20px; }
    .cd.is-escena .cd-reloj { font-size: 40px; }
    .cd.is-escena .cd-fila--perm b { font-size: 42px; }
  }
  @media (max-width: 899px) {
    /* la foto arriba, recorriéndose a la zona del tramo */
    .cd.is-escena .cd-lienzo { left: 0; top: 0; width: auto; height: 58svh; transform: translateX(var(--x, -30%)); }
    .cd.is-escena[data-tramo="0"] .cd-lienzo { --x: calc(-50% + 50vw); }
    .cd.is-escena[data-tramo="1"] .cd-lienzo { --x: calc(-50% + 50vw); }
    .cd.is-escena[data-tramo="2"] .cd-lienzo { --x: calc(-74% + 50vw); }
    .cd.is-escena[data-tramo="3"] .cd-lienzo { --x: calc(-42% + 50vw); }
    .cd.is-escena .cd-tarjeta { right: 12px; top: calc(58svh - 128px); width: 190px; gap: 6px; padding: 10px 12px; }
    .cd.is-escena .cd-reloj { font-size: 22px; }
    .cd.is-escena .cd-fila b { font-size: 14px; }
    .cd.is-escena .cd-fila--perm b { font-size: 24px; }
    .cd.is-escena .cd-txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 26px 20px 18px; background: linear-gradient(180deg, rgba(11, 11, 12, 0) 0, #0B0B0C 24px); }
    .cd.is-escena .cd-k { margin-bottom: 8px; }
    .cd.is-escena .cd-h { font-size: clamp(30px, 8.6vw, 40px); }
    .cd.is-escena .cd-pasos { margin-top: 10px; }
    .cd.is-escena .cd-paso { display: none; padding: 10px 0 8px; }
    .cd.is-escena[data-tramo="0"] .cd-paso[data-k="0"], .cd.is-escena[data-tramo="1"] .cd-paso[data-k="1"], .cd.is-escena[data-tramo="2"] .cd-paso[data-k="2"], .cd.is-escena[data-tramo="3"] .cd-paso[data-k="3"] { display: grid; }
    .cd-et { padding: 6px 10px 7px 8px; }
    /* en el teléfono el mapa del día no alcanza a enseñar los probadores (quedan fuera, a la derecha): sin su etiqueta cortada */
    .cd-et[data-i="1"] { display: none; }
    .cd-et b { font-size: 12px; }
    .cd-et em { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cd * { animation: none !important; transition: none !important; }
  }
  /* teléfono: cada paso pide unas tres cuartas partes de pantalla de scroll (en escritorio, casi una completa) */
  @media (max-width: 899px) {
    .cd.is-escena .cd-riel { height: 400vh; }
  }
</style>
