---
/**
 * «Cambias el acomodo y ves si funcionó» (/experiencia/camaras-con-ia): un cambio de acomodo medido antes y después
 * (la mezclilla del fondo a la entrada; dos semanas con cada acomodo). Marino con líneas, como «Lo prendes tú» del
 * probador: dos columnas con el número grande y la flecha. Números de ejemplo.
 */
import { CAM_MUEVE } from '../../../data/experiencia-camaras';
const PALABRA = Array.from({ length: 3 }, () => 'MUEVE Y MIDE').join(' · ');
const { antes, despues } = CAM_MUEVE;
---
<section class="pda cmv pd-marino" aria-labelledby="cmv-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <p class="pd-folio"><span>{CAM_MUEVE.k}</span><span>Dos semanas</span></p>
  <h2 class="pda-h" id="cmv-h">{CAM_MUEVE.h}</h2>
  <div class="cmv-cols">
    <div class="cmv-col rv" style="--i:0">
      <p class="cmv-k">Antes</p>
      <p class="cmv-t">{antes.t}</p>
      <p class="cmv-big">{antes.v}<small>{antes.s}</small></p>
      <p class="cmv-n">{antes.n}</p>
    </div>
    <p class="cmv-flecha rv" style="--i:1" aria-hidden="true">→</p>
    <div class="cmv-col cmv-col--despues rv" style="--i:2">
      <p class="cmv-k">Después</p>
      <p class="cmv-t">{despues.t}</p>
      <p class="cmv-big">{despues.v}<small>{despues.s}</small></p>
      <p class="cmv-n">{despues.n}</p>
    </div>
  </div>
  <p class="pda-nota">{CAM_MUEVE.nota}</p>
</section>

<style>
  .cmv-cols { display: grid; gap: 8px; margin-top: 44px; border-top: 2px solid #fff; }
  .cmv-col { padding: 24px 0 18px; }
  .cmv-k { margin: 0; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--pd-tenue); }
  .cmv-t { margin: 10px 0 0; font: 700 clamp(20px, 2.2vw, 28px)/1.2 var(--pd-clash); color: #fff; }
  .cmv-big { display: flex; align-items: baseline; gap: 12px; margin: 18px 0 0; font: 700 clamp(64px, 8vw, 128px)/0.9 var(--pd-clash); letter-spacing: -0.03em; color: #fff; }
  .cmv-big small { font: 600 15px/1.2 var(--font-display); letter-spacing: 0; color: var(--pd-tenue); }
  .cmv-col--despues .cmv-big { color: #9DB8F5; }
  .cmv-n { margin: 12px 0 0; font: 600 16px/1.4 var(--font-display); color: #fff; }
  .cmv-flecha { margin: 0; font: 700 56px/1 var(--font-display); color: #9DB8F5; transform: rotate(90deg); justify-self: start; }
  :global(.js-rv) .cmv .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.12s); }
  :global(.js-rv) .cmv .rv.is-on { opacity: 1; transform: none; }
  :global(.js-rv) .cmv .cmv-flecha.rv.is-on { transform: rotate(90deg); }
  @media (min-width: 900px) {
    .cmv-cols { grid-template-columns: 1fr auto 1fr; align-items: center; gap: 4vw; }
    .cmv-flecha { transform: none; justify-self: center; }
    :global(.js-rv) .cmv .cmv-flecha.rv.is-on { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .cmv .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
