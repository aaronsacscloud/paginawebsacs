---
/**
 * Antes y después de una experiencia (/experiencia/*): la doble página de «Así era» contra «Con Sacs», como «Lo que
 * antes tomaba una semana» del alta de productos (AltaAntes) pero con sus datos por props, para las experiencias que
 * vienen después (03-oct-2026: cámaras, conteo de personas, RFID).
 * Con el scroll (escritorio): cada renglón de «Así era» se tacha, el azul entra por la mitad de la derecha y aparecen
 * los renglones nuevos. En el teléfono, sin movimiento o sin JS: todo a la vista, ya tachado.
 * Variables: --p (escenas.ts) → --a tachado, --w barrido, --b lo nuevo.
 */
interface Lado { k: string; total: string; pasos: { d: string; t: string }[] }
interface Props { id?: string; folio: [string, string]; titulo: string; antes: Lado; despues: Lado; nota?: string }
const { id, folio, titulo, antes, despues, nota } = Astro.props;
const hid = `${id || 'ead'}-h`;
---
<section class="ead pd-marfil" id={id} data-escena aria-labelledby={hid}>
  <div class="ead-in">
    <p class="pd-folio"><span>{folio[0]}</span><span>{folio[1]}</span></p>
    <h2 class="ead-h" id={hid}>{titulo}</h2>
  </div>
  <div class="ead-riel" data-riel>
    <div class="ead-escena">
      <div class="ead-cols">
        <div class="ead-col ead-col--antes">
          <p class="ead-k">{antes.k}</p>
          <p class="ead-total">{antes.total}</p>
          <ol>{antes.pasos.map((p, k) => <li style={`--k:${k}`}><b>{p.d}</b><span>{p.t}</span></li>)}</ol>
        </div>
        <div class="ead-azul pd-azul" aria-hidden="true"></div>
        <div class="ead-col ead-col--despues pd-azul">
          <p class="ead-k">{despues.k}</p>
          <p class="ead-total">{despues.total}</p>
          <ol>{despues.pasos.map((p, k) => <li style={`--k:${k}`}><b>{p.d}</b><span>{p.t}</span></li>)}</ol>
        </div>
      </div>
      {nota && <p class="ead-nota">{nota}</p>}
    </div>
  </div>
</section>

<style>
  .ead { padding: 72px 0 80px; }
  .ead-in, .ead-escena { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  .ead-h { margin: 0; max-width: 15ch; color: var(--pd-texto); font: 700 clamp(40px, 6.2vw, 90px)/0.94 var(--pd-clash); letter-spacing: -0.02em; text-wrap: balance; }
  .ead-cols { position: relative; display: grid; margin-top: 44px; border-top: 2px solid var(--pd-texto); }
  .ead-col { position: relative; padding: 26px 0 34px; }
  .ead-col--antes { z-index: 1; }
  .ead-col--despues { z-index: 3; margin: 0 -20px; padding: 30px 20px 38px; }
  .ead-azul { display: none; }
  .ead-k { margin: 0; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--pd-texto); }
  .ead-total { margin: 8px 0 18px; color: var(--pd-texto); font: 700 clamp(34px, 4.4vw, 60px)/1 var(--pd-clash); letter-spacing: -0.02em; text-wrap: balance; }
  .ead-col ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--pd-filete); }
  .ead-col li { display: grid; grid-template-columns: 112px 1fr; gap: 10px; padding: 13px 0; border-bottom: 1px solid var(--pd-filete); font: 500 16px/1.45 var(--font-body); color: var(--pd-texto); }
  .ead-col li b { font: 700 14px/1.5 var(--font-display); }
  /* el tachado de cada renglón (sin escena: ya tachado) */
  .ead-col--antes li span { background: linear-gradient(#B23A3A, #B23A3A) no-repeat 0 58% / 100% 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; color: var(--pd-apagado); }
  .ead-nota { margin: 22px 0 0; max-width: 70ch; font: 500 13.5px/1.5 var(--font-body); color: var(--pd-apagado); }

  @media (min-width: 900px) {
    .ead { padding: 112px 0 120px; }
    .ead-in, .ead-escena { padding: 0 5vw; }
    .ead-cols { grid-template-columns: 1fr 1fr; }
    .ead-col--antes { padding: 34px 48px 44px 0; }
    .ead-col--despues { margin: 0; padding: 34px 40px 44px; }
  }

  /* ══ escritorio con movimiento: se tacha, el azul entra por la derecha y aparece lo nuevo ══ */
  @media (min-width: 900px) and (min-height: 640px) {
    .ead.is-escena .ead-riel { height: 240vh; }
    .ead.is-escena .ead-escena { position: sticky; top: 0; height: 100vh; height: 100svh; display: flex; flex-direction: column; justify-content: center; --a: clamp(0, calc(var(--p, 0) / 0.36), 1); --w: clamp(0, calc((var(--p, 0) - 0.3) / 0.34), 1); --b: clamp(0, calc((var(--p, 0) - 0.58) / 0.3), 1); }
    .ead.is-escena .ead-cols { margin-top: 0; }
    .ead.is-escena .ead-col--antes li span { color: var(--pd-texto); background-size: calc(clamp(0, calc(var(--a) * 5 - var(--k)), 1) * 100%) 2px; }
    .ead.is-escena .ead-col--antes li { opacity: calc(1 - clamp(0, calc(var(--a) * 5 - var(--k)), 1) * 0.42); }
    .ead.is-escena .ead-col--antes { opacity: calc(1 - var(--w) * 0.3); }
    .ead.is-escena .ead-azul { display: block; position: absolute; top: 0; bottom: 0; left: 50%; right: 0; z-index: 2; clip-path: inset(0 0 0 calc((1 - var(--w)) * 100%)); }
    .ead.is-escena .ead-col--despues { background: none; }
    .ead.is-escena .ead-col--despues .ead-total { opacity: clamp(0, calc(var(--b) * 3), 1); transform: translateY(calc((1 - clamp(0, calc(var(--b) * 3), 1)) * 16px)); }
    .ead.is-escena .ead-col--despues li { opacity: clamp(0, calc(var(--b) * 3 - var(--k) * 0.6), 1); transform: translateY(calc((1 - clamp(0, calc(var(--b) * 3 - var(--k) * 0.6), 1)) * 14px)); }
    .ead.is-escena .ead-nota { opacity: clamp(0, calc((var(--b) - 0.7) * 4), 1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ead * { transition: none !important; }
  }
</style>
