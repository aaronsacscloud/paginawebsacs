---
/**
 * «La ficha se llena sola» (/experiencia/alta-de-productos): el ADN de la prenda (sacs_api lib/estudio/adn.lib.js)
 * contado sobre la foto que tomó el celular. Pedido del dueño: «muy importante que todos los campos comunes de ropa se
 * llenen automático con el reconocimiento de foto con la IA, que se entienda el proceso y el ahorro de tiempo».
 *
 * Escritorio con movimiento: la escena se pega; una línea de lectura recorre la foto y, con el scroll, la ficha se
 * llena campo por campo; los que la IA ve en la prenda (cuello, manga, cinto, largo, tela, color…) sacan su etiqueta
 * desde ese punto de la foto. Composición y cuidado quedan «por confirmar» (salen de la etiqueta; no se inventan).
 * El conteo y los campos se prenden con --p (escenas.ts) leído aquí con un MutationObserver.
 * Teléfono, sin JS o con «reducir movimiento»: la foto con sus puntos y la ficha completa debajo.
 */
import { FICHA } from '../../../data/experiencia-alta';
const I = '/images/experiencia/';
const { campos } = FICHA;
const llenos = campos.filter((c) => !c.vacio).length;
const conPunto = campos.map((c, i) => ({ ...c, i })).filter((c) => c.punto);
// la etiqueta sale del lado libre de la foto: su orilla interior en % del ancho de la foto
const ORILLA = { izq: 24, der: 76 };
---
<section class="af pd-fucsia" data-escena data-ficha aria-labelledby="af-h">
  <div class="af-riel" data-riel>
    <div class="af-escena">
      <div class="af-escenario">
        <figure class="af-foto">
          <div class="af-marco">
            <img src={`${I}alta-cruda.webp`} width="720" height="1080" alt="La foto que tomó el celular: un vestido midi de lino mandarina con cinto, colgado en una pared rosa" loading="lazy" decoding="async" />
            <span class="af-scan" aria-hidden="true"></span>
            {conPunto.map((c) => <span class="af-punto" data-m={c.i} style={`left:${c.punto!.x}%;top:${c.punto!.y}%`} aria-hidden="true"></span>)}
          </div>
          {conPunto.map((c) => {
            const p = c.punto!;
            const o = ORILLA[p.lado];
            const a = Math.min(o, p.x);
            return (
              <>
                <span class="af-linea" data-m={c.i} style={`left:${a}%;width:${Math.abs(p.x - o)}%;top:${p.y}%`} aria-hidden="true"></span>
                <span class={`af-tag af-tag--${p.lado}`} data-m={c.i} style={p.lado === 'izq' ? `right:${100 - o}%;top:${p.y}%` : `left:${o}%;top:${p.y}%`} aria-hidden="true">
                  <small>{c.k}</small><b>{c.hex && <i style={`--c:${c.hex}`}></i>}{c.v}</b>
                </span>
              </>
            );
          })}
          <figcaption>La foto que tomó el celular</figcaption>
        </figure>
      </div>

      <div class="af-txt">
        <p class="af-k">{FICHA.k}</p>
        <h2 class="af-h" id="af-h">{FICHA.h}</h2>
        <p class="af-p">{FICHA.p}</p>
        <div class="af-ficha">
          <p class="af-ficha-k"><span>Ficha de la prenda</span><b><span data-cuenta>{llenos}</span> de {campos.length} campos, sin teclear</b></p>
          <dl class="af-campos">
            {campos.map((c, i) => (
              <div class:list={['af-campo', { 'is-ancho': c.ancho, 'is-vacio': c.vacio, 'con-punto': c.punto }]} data-f={i} data-vacio={c.vacio ? '' : undefined}>
                <dt>{c.k}</dt>
                <dd>{c.hex && <i class="af-hex" style={`--c:${c.hex}`}></i>}<span>{c.v}</span>{c.hex && <small>{c.hex}</small>}{!c.vacio && <em aria-hidden="true">✓</em>}</dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="af-nota">{FICHA.nota}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Con el scroll (escritorio con movimiento): cuántos campos van llenos, según --p de la escena.
  (() => {
    const sec = document.querySelector<HTMLElement>('[data-ficha]');
    if (!sec) return;
    const filas = Array.from(sec.querySelectorAll<HTMLElement>('[data-f]'));
    const marcas = Array.from(sec.querySelectorAll<HTMLElement>('[data-m]'));
    const cuenta = sec.querySelector<HTMLElement>('[data-cuenta]');
    const mq = window.matchMedia('(min-width: 900px) and (min-height: 640px)');
    const N = filas.length;
    let ultimo = -1;
    const pinta = () => {
      const vivo = mq.matches && sec.classList.contains('is-escena');
      const p = parseFloat(sec.style.getPropertyValue('--p') || '0') || 0;
      const n = vivo ? Math.max(0, Math.min(N, Math.round(((p - 0.08) / 0.74) * N))) : N;
      if (n === ultimo) return;
      ultimo = n;
      filas.forEach((f, i) => f.classList.toggle('is-on', i < n));
      marcas.forEach((m) => m.classList.toggle('is-on', Number(m.dataset.m) < n));
      if (cuenta) cuenta.textContent = String(filas.slice(0, n).filter((f) => !f.hasAttribute('data-vacio')).length);
      sec.classList.toggle('is-leyendo', vivo && n < N);
    };
    new MutationObserver(pinta).observe(sec, { attributes: true, attributeFilter: ['style', 'class'] });
    mq.addEventListener('change', () => { ultimo = -1; pinta(); });
    pinta();
  })();
</script>

<style>
  .af { position: relative; overflow-x: clip; }
  .af-escena { display: grid; gap: 40px; max-width: 1240px; margin: 0 auto; padding: 72px 20px 80px; }
  .af-escenario { display: grid; place-items: center; }
  .af-foto { position: relative; width: min(100%, 360px); margin: 0; }
  .af-marco { position: relative; overflow: hidden; border-radius: 22px; box-shadow: 0 40px 80px -40px rgba(60, 0, 20, 0.6); background: #F3DAD5; }
  .af-marco img { display: block; width: 100%; height: auto; }
  .af-foto figcaption { margin-top: 12px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: #fff; text-align: center; }
  /* el punto donde la IA ve el dato */
  .af-punto { position: absolute; z-index: 2; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 4px rgba(208, 58, 112, 0.55), 0 2px 8px rgba(0, 0, 0, 0.3); transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .af-punto::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid #fff; animation: afOnda 2s ease-out infinite; }
  .af-scan { display: none; }
  /* las etiquetas y sus líneas solo viven en la escena de escritorio */
  .af-linea, .af-tag { display: none; }

  .af-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #fff; }
  .af-h { margin: 0; max-width: 12ch; color: #fff; font: 700 clamp(40px, 5.4vw, 80px)/0.94 var(--pd-clash); letter-spacing: -0.02em; text-wrap: balance; }
  .af-p { margin: 16px 0 0; max-width: 46ch; font: 500 17px/1.5 var(--font-body); color: #fff; }
  .af-ficha { margin-top: 26px; padding: 18px 20px 12px; border-radius: 20px; background: #fff; color: #141414; box-shadow: 0 30px 60px -36px rgba(60, 0, 20, 0.55); }
  .af-ficha-k { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; margin: 0 0 6px; padding-bottom: 12px; border-bottom: 2px solid #141414; font: 700 16px/1.2 var(--font-display); }
  .af-ficha-k b { font: 700 13px/1.2 var(--font-display); color: #B02A5B; }
  .af-ficha-k [data-cuenta] { font-variant-numeric: tabular-nums; }
  .af-campos { display: grid; margin: 0; }
  .af-campo { display: grid; grid-template-columns: 104px 1fr; gap: 10px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid #EEE9EA; }
  .af-campo dt { font: 600 11px/1.3 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: #77706F; }
  .af-campo.con-punto dt::before { content: ''; display: inline-block; width: 7px; height: 7px; margin: 0 6px 1px 0; border-radius: 50%; background: #D03A70; vertical-align: middle; }
  .af-campo dd { display: flex; align-items: baseline; gap: 6px; margin: 0; font: 600 14.5px/1.35 var(--font-display); }
  .af-campo dd span { flex: 0 1 auto; }
  .af-campo dd em { margin-left: auto; font-style: normal; font-weight: 700; color: #17804F; }
  .af-campo dd small { font: 500 12px/1 var(--font-body); color: #77706F; }
  .af-hex { flex: none; align-self: center; width: 12px; height: 12px; border-radius: 50%; background: var(--c); }
  .af-campo.is-vacio dd { color: #8A5A00; font-weight: 600; }
  .af-campo.is-vacio dd span { white-space: nowrap; padding: 1px 8px; border: 1.5px dashed #E0B45C; border-radius: 99px; background: #FFF7E6; font-size: 13px; }
  .af-campo.is-ancho dd { font: 500 14px/1.45 var(--font-body); }
  .af-nota { margin: 16px 0 0; max-width: 62ch; font: 500 13.5px/1.5 var(--font-body); color: #fff; }

  @media (min-width: 600px) {
    .af-campos { grid-template-columns: 1fr 1fr; column-gap: 28px; }
    .af-campo.is-ancho { grid-column: 1 / -1; }
  }

  /* ══ escritorio: foto a la izquierda, la ficha a la derecha ══ */
  @media (min-width: 900px) {
    .af-escena { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); align-items: center; gap: 4vw; padding: 110px 5vw 120px; }
    .af-foto { width: min(100%, 400px); }
    .af-linea, .af-tag { display: block; }
    .af-linea { position: absolute; z-index: 2; height: 0; border-top: 1.5px solid #fff; transform: translateY(-50%); transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
    .af-tag { position: absolute; z-index: 3; display: grid; gap: 3px; padding: 9px 13px 10px; border-radius: 12px; background: #fff; color: #141414; white-space: nowrap; transform: translateY(-50%); box-shadow: 0 14px 30px -14px rgba(60, 0, 20, 0.6); transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
    .af-tag small { font: 600 10px/1 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: #B02A5B; }
    .af-tag b { display: flex; align-items: center; gap: 6px; font: 700 15px/1.15 var(--font-display); }
    .af-tag b i { width: 12px; height: 12px; border-radius: 50%; background: var(--c); }
  }

  /* ══ escritorio con movimiento: la escena se pega y la ficha se llena con el scroll ══ */
  @media (min-width: 900px) and (min-height: 640px) {
    .af.is-escena .af-riel { height: 320vh; }
    .af.is-escena .af-escena { position: sticky; top: 0; height: 100vh; height: 100svh; max-width: none; padding: 0 5vw; }
    .af.is-escena .af-foto { width: auto; }
    .af.is-escena .af-marco { height: min(78svh, 740px); aspect-ratio: 720 / 1080; }
    .af.is-escena .af-marco img { height: 100%; object-fit: cover; }
    .af.is-escena .af-txt { max-width: 720px; }
    .af.is-escena .af-scan { display: block; position: absolute; left: 0; right: 0; top: 0; z-index: 1; height: 22%; background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.28) 88%, #fff 100%); opacity: 0; pointer-events: none; }
    .af.is-escena.is-leyendo .af-scan { animation: afScan 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .af.is-escena .af-punto:not(.is-on) { opacity: 0; transform: scale(0.3); }
    .af.is-escena .af-linea:not(.is-on) { opacity: 0; }
    .af.is-escena .af-tag:not(.is-on) { opacity: 0; }
    .af.is-escena .af-tag--izq:not(.is-on) { transform: translate(-14px, -50%); }
    .af.is-escena .af-tag--der:not(.is-on) { transform: translate(14px, -50%); }
    .af.is-escena .af-campo dd { transition: opacity 0.35s ease, clip-path 0.5s ease; clip-path: inset(0 0 0 0); }
    .af.is-escena .af-campo:not(.is-on) dd { opacity: 0; clip-path: inset(0 100% 0 0); }
    .af.is-escena .af-campo.is-on { animation: afFila 0.7s ease; }
    .af.is-escena .af-nota { transition: opacity 0.4s ease; }
    .af.is-escena.is-leyendo .af-nota { opacity: 0; }
  }
  @media (min-width: 900px) and (min-height: 640px) and (max-height: 860px) {
    .af.is-escena .af-p { display: none; }
    .af.is-escena .af-h { font-size: clamp(36px, 4.4vw, 64px); }
    .af.is-escena .af-ficha { margin-top: 18px; }
    .af.is-escena .af-campo { padding: 6px 0; }
  }
  @media (min-width: 900px) and (min-height: 640px) and (max-height: 760px) {
    .af.is-escena .af-nota { display: none; }
    .af.is-escena .af-h { font-size: clamp(32px, 3.8vw, 52px); }
  }
  @keyframes afScan { 0% { top: -22%; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  @keyframes afOnda { 0% { transform: scale(0.6); opacity: 0.9; } 100% { transform: scale(2.2); opacity: 0; } }
  @keyframes afFila { 0% { background: rgba(208, 58, 112, 0.1); } 100% { background: transparent; } }
  @media (prefers-reduced-motion: reduce) {
    .af * { animation: none !important; transition: none !important; }
  }
</style>
