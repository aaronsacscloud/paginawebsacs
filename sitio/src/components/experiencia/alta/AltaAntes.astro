---
/**
 * «Lo que antes tomaba una semana» (/experiencia/alta-de-mercancia): la doble página del antes y el después, como «Lo
 * que cambia» de Planeación. Con el scroll (escritorio): cada día del proceso de siempre se tacha, el azul barre la
 * página y entran los minutos con AXO. En el teléfono, sin movimiento o sin JS: todo a la vista, ya tachado.
 * Variables: --p (escenas.ts) → --a tachado, --w barrido (solo la mitad de «Con AXO»), --b los minutos.
 */
import { ANTES } from '../../../data/experiencia-alta';
const { antes, despues } = ANTES;
---
<section class="aa pd-marfil" data-escena aria-labelledby="aa-h">
  <div class="aa-in">
    <p class="pd-folio"><span>Antes y después</span><span>Alta de mercancía</span></p>
    <h2 class="aa-h" id="aa-h">{ANTES.titulo}</h2>
  </div>
  <div class="aa-riel" data-riel>
    <div class="aa-escena">
      <div class="aa-cols">
        <div class="aa-col aa-col--antes">
          <p class="aa-k">{antes.k}</p>
          <p class="aa-total">{antes.total}</p>
          <ol>{antes.pasos.map((p, k) => <li style={`--k:${k}`}><b>{p.d}</b><span>{p.t}</span></li>)}</ol>
        </div>
        <div class="aa-azul pd-azul" aria-hidden="true"></div>
        <div class="aa-col aa-col--despues pd-azul">
          <p class="aa-k">{despues.k}</p>
          <p class="aa-total">{despues.total}</p>
          <ol>{despues.pasos.map((p, k) => <li style={`--k:${k}`}><b>{p.d}</b><span>{p.t}</span></li>)}</ol>
        </div>
      </div>
      <p class="aa-nota">{ANTES.nota}</p>
    </div>
  </div>
</section>

<style>
  .aa { padding: 72px 0 80px; }
  .aa-in, .aa-escena { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  .aa-h { margin: 0; max-width: 14ch; color: var(--pd-texto); font: 700 clamp(40px, 6.2vw, 90px)/0.94 var(--pd-clash); letter-spacing: -0.02em; text-wrap: balance; }
  .aa-cols { position: relative; display: grid; margin-top: 44px; border-top: 2px solid var(--pd-texto); }
  .aa-col { position: relative; padding: 26px 0 34px; }
  .aa-col--antes { z-index: 1; }
  .aa-col--despues { z-index: 3; margin: 0 -20px; padding: 30px 20px 38px; }
  .aa-azul { display: none; }
  .aa-k { margin: 0; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--pd-texto); }
  .aa-total { margin: 8px 0 18px; color: var(--pd-texto); font: 700 clamp(34px, 4.4vw, 60px)/1 var(--pd-clash); letter-spacing: -0.02em; }
  .aa-col ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--pd-filete); }
  .aa-col li { display: grid; grid-template-columns: 92px 1fr; gap: 10px; padding: 13px 0; border-bottom: 1px solid var(--pd-filete); font: 500 16px/1.45 var(--font-body); color: var(--pd-texto); }
  .aa-col li b { font: 700 14px/1.5 var(--font-display); }
  /* el tachado de cada día (sin escena: ya tachado) */
  .aa-col--antes li span { background: linear-gradient(#B23A3A, #B23A3A) no-repeat 0 58% / 100% 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; color: var(--pd-apagado); }
  .aa-nota { margin: 22px 0 0; max-width: 70ch; font: 500 13.5px/1.5 var(--font-body); color: var(--pd-apagado); }

  @media (min-width: 900px) {
    .aa { padding: 112px 0 120px; }
    .aa-in, .aa-escena { padding: 0 5vw; }
    .aa-cols { grid-template-columns: 1fr 1fr; }
    .aa-col--antes { padding: 34px 48px 44px 0; }
    .aa-col--despues { margin: 0; padding: 34px 40px 44px; }
  }

  /* ══ escritorio con movimiento: la doble página pegada; se tacha, barre el azul y entran los minutos ══ */
  @media (min-width: 900px) and (min-height: 640px) {
    .aa.is-escena .aa-riel { height: 240vh; }
    .aa.is-escena .aa-escena { position: sticky; top: 0; height: 100vh; height: 100svh; display: flex; flex-direction: column; justify-content: center; --a: clamp(0, calc(var(--p, 0) / 0.36), 1); --w: clamp(0, calc((var(--p, 0) - 0.3) / 0.34), 1); --b: clamp(0, calc((var(--p, 0) - 0.58) / 0.3), 1); }
    .aa.is-escena .aa-cols { margin-top: 0; }
    .aa.is-escena .aa-col--antes li span { color: var(--pd-texto); background-size: calc(clamp(0, calc(var(--a) * 5 - var(--k)), 1) * 100%) 2px; }
    .aa.is-escena .aa-col--antes li { opacity: calc(1 - clamp(0, calc(var(--a) * 5 - var(--k)), 1) * 0.42); }
    .aa.is-escena .aa-col--antes { opacity: calc(1 - var(--w) * 0.3); }
    /* el azul entra desde la orilla derecha y cubre la mitad de «Con AXO» */
    .aa.is-escena .aa-azul { display: block; position: absolute; top: 0; bottom: 0; left: 50%; right: 0; z-index: 2; clip-path: inset(0 0 0 calc((1 - var(--w)) * 100%)); }
    .aa.is-escena .aa-col--despues { background: none; }
    .aa.is-escena .aa-col--despues .aa-total { opacity: clamp(0, calc(var(--b) * 3), 1); transform: translateY(calc((1 - clamp(0, calc(var(--b) * 3), 1)) * 16px)); }
    .aa.is-escena .aa-col--despues li { opacity: clamp(0, calc(var(--b) * 3 - var(--k) * 0.6), 1); transform: translateY(calc((1 - clamp(0, calc(var(--b) * 3 - var(--k) * 0.6), 1)) * 14px)); }
    .aa.is-escena .aa-nota { opacity: clamp(0, calc((var(--b) - 0.7) * 4), 1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .aa * { transition: none !important; }
  }
</style>
