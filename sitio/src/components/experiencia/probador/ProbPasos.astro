  /* teléfono con movimiento: arriba la tienda (centrada entre la clienta y la pantalla); abajo el paso actual */
  @media (max-width: 899px) {
    .pt.is-escena .pt-lienzo { position: absolute; top: 0; left: calc(50vw - 64svh * 1.7684 * 0.58); width: calc(64svh * 1.7684); }
    /* la pantalla de la tienda, de frente y legible: una tarjeta a la derecha de la clienta (en lugar de la de la foto, que en el teléfono mide 100 px) */
