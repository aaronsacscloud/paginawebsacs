---
/**
 * «Así se lo prueba» (/experiencia/probador-virtual) — v3, 3-oct-2026. El dueño, sobre la v2: «el fondo no puede ser el
 * de su casa, no es congruente: debe verse el fondo de la tienda donde está la persona, y con unos clics pueda cambiarlo
 * y se vea un fondo loco atrás; hazlo más atractivo, que la pantalla no sea tan grande, que se vea parte de la tienda,
 * una tienda con más color y más diseño, como la de WOW Concept».
 *
 * - La tienda (gpt-image-2.5): colorida, de arte y neón, con una pantalla de tamaño humano en su base y la clienta (la
 *   de su foto: playera blanca y jeans) frente a ella.
 * - La pantalla de HTML se calza sobre la de la foto con perspectiva: matrix3d calculado (homografía) de su tamaño base
 *   a las 4 esquinas del marco en la foto (% de 2688×1520). Sin JS va como rectángulo aproximado.
 * - La prenda puesta (gpt-image-2, edición con su foto, la tienda y el vestido): ella misma con el vestido DENTRO de la
 *   tienda, porque el probador conserva el fondo de la foto que se toma ahí («Keep the same framing and background»).
 * - Paso 5, el fondo de fantasía: EN CONSTRUCCIÓN (asterisco y nota): hoy el probador no cambia el fondo.
 * data-tramos="5". Sin JS o con «reducir movimiento»: el último paso, completo.
 */
import { PASOS, OBRA_PASOS } from '../../../data/experiencia-probador';
const F = '/images/probador/';
const I = '/images/experiencia/';
const VESTIDOS = [
  { img: 'cat-vestido-rosa-360', c: 'Rosa' },
  { img: 'cat-vestido-negro-360', c: 'Negro' },
  { img: 'cat-vestido-verde-360', c: 'Verde' },
];
const COLORES = [{ n: 'Rosa', c: '#E0457B' }, { n: 'Negro', c: '#141414' }, { n: 'Verde esmeralda', c: '#1E7A4C' }];
const FONDOS = ['Tu tienda', 'Flores', 'Nubes', 'Neón'];
// Las 4 esquinas del marco de la pantalla en la foto (% de 2688×1520): arriba-izq, arriba-der, abajo-der, abajo-izq.
const ESQUINAS = [[52.716, 20.72], [63.504, 19.61], [63.504, 59.41], [52.716, 58.03]];
---
<section class="pt pd-negro" id="exp-pasos" data-escena data-tramos="5" data-tramo="4" aria-labelledby="pt-h">
  <div class="pt-riel" data-riel>
    <div class="pt-escena">
      <div class="pt-lienzo" data-esquinas={JSON.stringify(ESQUINAS)}>
        <img class="pt-foto" src={`${I}probador-tienda-color-1920.webp`} srcset={`${I}probador-tienda-color-1280.webp 1280w, ${I}probador-tienda-color-1920.webp 1920w, ${I}probador-tienda-color-2560.webp 2560w`} sizes="(max-width: 899px) 120vh, 112vw" width="2688" height="1520" alt="Una tienda de moda llena de color, con arco de neón rosa, columnas azules y piso de terrazo; la clienta, de playera blanca y jeans, frente a una pantalla" loading="lazy" decoding="async" />

        <!-- la pantalla: su marco y la tienda en línea con el probador, calzada sobre la de la foto -->
        <div class="pt-pantalla" role="img" aria-label="En la pantalla: vestidos de satén en talla M, sus medidas que dan talla M, la clienta con el vestido rosa puesto dentro de la tienda, luego en verde y apartado, y con un fondo de flores gigantes">
          <div class="pt-vidrio">
            <div class="pt-barra"><b>A U R E A</b><span>Probador virtual</span></div>

            <!-- 01 · lo que busca, en su talla -->
            <div class="pt-s pt-s0">
              <p class="pt-mini">Lo que buscas</p>
              <p class="pt-tit">Vestidos de satén</p>
              <div class="pt-chips"><span class="is-on">✓ Talla M</span><span>Satén</span></div>
              <ul class="pt-grid">
                {VESTIDOS.map((v, i) => (
                  <li style={`--i:${i}`}><span class="pt-gimg"><img src={`${F}${v.img}.webp`} alt="" width="360" height="540" loading="lazy" decoding="async" /></span><small>{v.c} · Hay en M</small></li>
                ))}
              </ul>
              <span class="pt-cta">✦ Pruébatelo</span>
            </div>

            <!-- 02 · ¿Cuál es mi talla? -->
            <div class="pt-s pt-s1">
              <p class="pt-mini">¿Cuál es mi talla?</p>
              <div class="pt-campo" style="--d:0"><span>Busto</span><b>88</b></div>
              <div class="pt-campo" style="--d:1"><span>Cintura</span><b>70</b></div>
              <div class="pt-campo" style="--d:2"><span>Cadera</span><b>96</b></div>
              <div class="pt-talla"><span class="pt-talla-k">Tu talla</span><b>M</b><em>Segura</em></div>
              <span class="pt-cta">✦ Pruébatelo con tu foto</span>
            </div>

            <!-- 03 · se ve con la prenda puesta, en la tienda -->
            <div class="pt-s pt-s2">
              <img class="pt-res" src={`${I}probador-en-tienda-rosa.webp`} alt="" width="720" height="1080" loading="lazy" decoding="async" />
              <div class="pt-prep"><i class="pt-cam"></i><i class="pt-anillo"></i><b>Preparando tu foto…</b><small>Suele tardar de 30 a 60 segundos</small></div>
              <span class="pt-ia">Prueba virtual generada con IA</span>
              <div class="pt-pie"><b>Slip de satén</b><span>Rosa · M</span></div>
            </div>

            <!-- 04 · otro color, y lo aparta -->
            <div class="pt-s pt-s3">
              <img class="pt-res" src={`${I}probador-en-tienda-verde.webp`} alt="" width="720" height="1080" loading="lazy" decoding="async" />
              <span class="pt-ia">Prueba virtual generada con IA</span>
              <div class="pt-hoja">
                <div class="pt-colores">{COLORES.map((c, i) => <i class:list={[{ 'is-on': i === 2 }]} style={`--c:${c.c}`}></i>)}</div>
                <span class="pt-btn">Apartar en talla M</span>
              </div>
              <div class="pt-ok">✓ Apartado</div>
            </div>

            <!-- 05 · un fondo de locura (en construcción) -->
            <div class="pt-s pt-s4">
              <img class="pt-res pt-res--tienda" src={`${I}probador-en-tienda-verde.webp`} alt="" width="720" height="1080" loading="lazy" decoding="async" />
              <img class="pt-res pt-res--loco" src={`${I}probador-en-tienda-loco.webp`} alt="" width="720" height="1080" loading="lazy" decoding="async" />
              <span class="pt-ia">Prueba virtual generada con IA</span>
              <div class="pt-fondos">{FONDOS.map((n, i) => <span class:list={[{ 'is-on': i === 1 }]} style={`--i:${i}`}>{n}</span>)}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-txt">
        <p class="pt-k">En la pantalla de tu tienda</p>
        <h2 class="pt-h" id="pt-h">Así se lo prueba.</h2>
        <ol class="pt-pasos">
          {PASOS.map((p, k) => (
            <li class="pt-paso" data-k={k}>
              <span class="pt-paso-n">{p.n}</span>
              <span class="pt-paso-t"><b>{p.t}{p.obra && <span class="pt-ast"><span aria-hidden="true">*</span><span class="sr-only"> (en construcción)</span></span>}</b><span>{p.d}</span></span>
              <i class="pt-barra-av" aria-hidden="true"><b></b></i>
            </li>
          ))}
        </ol>
        <p class="pt-nota"><span aria-hidden="true">*</span> {OBRA_PASOS}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pt { position: relative; background: #0B0B0C; color: #fff; }
  /* sin escena (sin JS o «reducir movimiento»): la foto arriba y los pasos abajo, todo a la vista */
  .pt-escena { position: relative; overflow: hidden; }
  .pt-lienzo { position: relative; width: 100%; aspect-ratio: 2688 / 1520; }
  .pt-foto { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* ── la pantalla: sin JS, un rectángulo sobre la de la foto; con JS, calzada en perspectiva (matrix3d) ── */
  .pt-pantalla { position: absolute; left: 52.716%; top: 19.6%; width: 10.79%; height: 39.6%; padding: 2.6%; border-radius: 1.4%; background: #0D0D10; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 0 60px rgba(255, 120, 200, 0.25); }
  .pt-pantalla.is-calzada { left: 0; top: 0; width: 300px; height: 606px; padding: 8px; border-radius: 4px; transform-origin: 0 0; }
  .pt-vidrio { position: relative; width: 100%; height: 100%; overflow: hidden; background: #F5F3EF; color: #141414; container-type: size; }
  .pt-barra { position: absolute; left: 0; right: 0; top: 0; z-index: 4; display: flex; justify-content: space-between; align-items: center; padding: 4cqh 6cqw 2.6cqh; border-bottom: 1px solid rgba(20, 20, 20, 0.08); background: rgba(245, 243, 239, 0.96); }
  .pt-barra b { font: 600 calc(5cqw * var(--ef, 1))/1 var(--font-display); letter-spacing: 0.3em; }
  .pt-barra span { padding: 1.8cqw 3.4cqw; border-radius: 99px; background: #141414; color: #fff; font: 600 calc(4cqw * var(--ef, 1))/1 var(--font-display); }
  .pt-s { position: absolute; inset: 0; padding: 12.5cqh 6cqw 4cqh; opacity: 0; visibility: hidden; transition: opacity 0.5s ease, visibility 0s linear 0.5s; }
  .pt-mini { margin: 0; font: 600 calc(4.6cqw * var(--ef, 1))/1.2 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: #6B6862; }

  /* 01 · lo que busca */
  .pt-tit { margin: 1.4cqh 0 0; font: 700 calc(10.4cqw * var(--ef, 1))/1 var(--pd-clash, var(--font-display)); letter-spacing: -0.01em; }
  .pt-chips { display: flex; gap: 2.4cqw; margin-top: 2.2cqh; }
  .pt-chips span { padding: 2.2cqw 3.8cqw; border: 1px solid rgba(20, 20, 20, 0.18); border-radius: 99px; font: 600 calc(4.4cqw * var(--ef, 1))/1 var(--font-display); }
  .pt-chips .is-on { background: #141414; border-color: #141414; color: #fff; }
  .pt-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3cqw; margin: 2.6cqh 0 0; padding: 0; list-style: none; }
  .pt-gimg { display: block; overflow: hidden; border-radius: 2.6cqw; background: #ECE8E1; aspect-ratio: 2 / 3.6; }
  .pt-gimg img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pt-grid small { display: block; margin-top: 1cqh; font: 600 calc(3.6cqw * var(--ef, 1))/1.2 var(--font-display); color: #1F7A4C; }
  .pt-cta { position: absolute; left: 6cqw; right: 6cqw; bottom: 3.6cqh; display: flex; justify-content: center; padding: 2.4cqh 0; border-radius: 99px; background: #141414; color: #fff; font: 700 calc(5cqw * var(--ef, 1))/1 var(--font-display); }

  /* 02 · la talla */
  .pt-campo { display: flex; justify-content: space-between; align-items: baseline; margin-top: 1.6cqh; padding: 2cqh 4.4cqw; border: 1px solid rgba(20, 20, 20, 0.16); border-radius: 3.4cqw; background: #fff; font: 500 calc(5cqw * var(--ef, 1))/1 var(--font-body); }
  .pt-s1 .pt-mini { margin-bottom: 1.4cqh; }
  .pt-campo b { font: 700 calc(6.4cqw * var(--ef, 1))/1 var(--font-display); }
  .pt-talla { display: grid; grid-template-columns: auto 1fr; column-gap: 5cqw; align-items: center; margin-top: 2.6cqh; padding: 2.4cqh 5cqw; border-radius: 4.4cqw; background: #141414; color: #fff; }
  .pt-talla-k { grid-column: 1 / -1; font: 600 calc(4cqw * var(--ef, 1))/1 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); }
  .pt-talla b { font: 700 calc(24cqw * var(--ef, 1))/1 var(--pd-clash, var(--font-display)); }
  .pt-talla em { font: 700 calc(6cqw * var(--ef, 1))/1.2 var(--font-display); font-style: normal; color: #6FD3A3; }

  /* 03, 04 y 05 · la prenda puesta: la foto llena la pantalla */
  .pt-s2, .pt-s3, .pt-s4 { padding: 0; }
  .pt-res { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .pt-prep { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2cqh; padding: 8cqw; background: #F5F3EF; text-align: center; opacity: 0; }
  .pt-cam { width: 16cqw; height: 12cqw; border-radius: 3cqw; border: 1.2cqw solid #141414; position: relative; }
  .pt-cam::after { content: ''; position: absolute; left: 50%; top: 50%; width: 5cqw; height: 5cqw; border-radius: 50%; border: 1.2cqw solid #141414; transform: translate(-50%, -50%); }
  .pt-prep b { font: 700 calc(6.4cqw * var(--ef, 1))/1.2 var(--font-display); }
  .pt-prep small { font: 500 calc(4.6cqw * var(--ef, 1))/1.3 var(--font-body); color: #6B6862; }
  .pt-anillo { width: 11cqw; height: 11cqw; border-radius: 50%; border: 1.2cqw solid rgba(20, 20, 20, 0.12); border-top-color: #E0457B; animation: ptGira 1s linear infinite; }
  .pt-ia { position: absolute; left: 50%; top: 12cqh; z-index: 3; padding: 2cqw 4cqw; border-radius: 99px; background: rgba(20, 20, 20, 0.78); color: #fff; font: 600 calc(3.9cqw * var(--ef, 1))/1 var(--font-display); white-space: nowrap; transform: translateX(-50%); }
  .pt-pie { position: absolute; left: 5cqw; right: 5cqw; bottom: 3.6cqh; z-index: 3; display: flex; justify-content: space-between; align-items: baseline; padding: 2.2cqh 4.6cqw; border-radius: 4cqw; background: rgba(255, 255, 255, 0.95); font: 700 calc(4.6cqw * var(--ef, 1))/1.2 var(--font-display); }
  .pt-pie span { font: 500 calc(4.2cqw * var(--ef, 1))/1.2 var(--font-body); color: #6B6862; }
  .pt-hoja { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 2.6cqh 6cqw 3.4cqh; border-radius: 6cqw 6cqw 0 0; background: rgba(245, 243, 239, 0.97); }
  .pt-colores { display: flex; justify-content: center; gap: 4cqw; }
  .pt-colores i { width: 8cqw; height: 8cqw; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1.2cqw #F5F3EF, 0 0 0 1.6cqw rgba(20, 20, 20, 0.2); }
  .pt-colores i.is-on { box-shadow: 0 0 0 1.2cqw #F5F3EF, 0 0 0 2cqw #141414; }
  .pt-btn { display: flex; justify-content: center; margin-top: 2.2cqh; padding: 2.2cqh 0; border-radius: 99px; background: #141414; color: #fff; font: 700 calc(5cqw * var(--ef, 1))/1 var(--font-display); }
  .pt-ok { position: absolute; left: 50%; top: 20cqh; z-index: 4; padding: 2.6cqw 5cqw; border-radius: 99px; background: #1F9D63; color: #fff; font: 700 calc(4.6cqw * var(--ef, 1))/1 var(--font-display); white-space: nowrap; transform: translate(-50%, -3cqh); opacity: 0; }
  .pt-res--loco { clip-path: inset(0 0 0 0); }
  .pt-fondos { position: absolute; left: 4cqw; right: 4cqw; bottom: 3.4cqh; z-index: 3; display: flex; justify-content: center; flex-wrap: wrap; gap: 2cqw; }
  .pt-fondos span { padding: 2.2cqw 3.6cqw; border-radius: 99px; background: rgba(255, 255, 255, 0.92); font: 600 calc(4cqw * var(--ef, 1))/1 var(--font-display); }
  .pt-fondos .is-on { background: #E0457B; color: #fff; }

  /* ── el texto: los pasos ── */
  .pt-txt { padding: 40px 20px 56px; }
  .pt-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #F07FA6; }
  .pt-h { margin: 0; color: #fff; font: 700 clamp(40px, 5.2vw, 80px)/0.94 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; }
  .pt-pasos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.3); }
  .pt-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 4px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .pt-paso-n { font: 700 19px/1.2 var(--pd-clash, var(--font-display)); color: rgba(255, 255, 255, 0.45); transition: color 0.3s; }
  .pt-paso-t { display: grid; gap: 3px; }
  .pt-paso-t b { font: 700 16px/1.3 var(--font-display); color: #fff; }
  .pt-paso-t > span { font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.78); }
  .pt-ast { margin-left: 2px; color: #F07FA6; }
  .pt-barra-av { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .pt-barra-av b { display: block; height: 100%; background: #E0457B; transform: scaleX(0); transform-origin: 0 50%; }
  .pt-nota { margin: 14px 0 0; font: 500 13px/1.4 var(--font-body); color: rgba(255, 255, 255, 0.7); }

  /* ── el paso que se ve (sin JS: el último, completo) ── */
  .pt[data-tramo="0"] .pt-s0, .pt[data-tramo="1"] .pt-s1, .pt[data-tramo="2"] .pt-s2, .pt[data-tramo="3"] .pt-s3, .pt[data-tramo="4"] .pt-s4 { opacity: 1; visibility: visible; transition: opacity 0.5s ease, visibility 0s; }
  .pt[data-tramo="0"] .pt-paso[data-k="0"] .pt-paso-n, .pt[data-tramo="1"] .pt-paso[data-k="1"] .pt-paso-n, .pt[data-tramo="2"] .pt-paso[data-k="2"] .pt-paso-n, .pt[data-tramo="3"] .pt-paso[data-k="3"] .pt-paso-n, .pt[data-tramo="4"] .pt-paso[data-k="4"] .pt-paso-n { color: #F07FA6; }
  .pt[data-tramo="1"] .pt-paso[data-k="0"] .pt-barra-av b,
  .pt[data-tramo="2"] .pt-paso[data-k="0"] .pt-barra-av b, .pt[data-tramo="2"] .pt-paso[data-k="1"] .pt-barra-av b,
  .pt[data-tramo="3"] .pt-paso[data-k="0"] .pt-barra-av b, .pt[data-tramo="3"] .pt-paso[data-k="1"] .pt-barra-av b, .pt[data-tramo="3"] .pt-paso[data-k="2"] .pt-barra-av b,
  .pt[data-tramo="4"] .pt-paso .pt-barra-av b { transform: none; }
  .pt:not(.is-escena) .pt-ok { opacity: 1; transform: translate(-50%, 0); }

  /* ── con el scroll: cada paso se reproduce al entrar ── */
  .pt.is-escena[data-tramo="0"] .pt-grid li { animation: ptEntra 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(0.3s + var(--i) * 0.15s); }
  .pt.is-escena[data-tramo="1"] .pt-campo b { animation: ptAparece 0.4s steps(2) both; animation-delay: calc(0.4s + var(--d) * 0.5s); }
  .pt.is-escena[data-tramo="1"] .pt-talla { animation: ptEntra 0.6s cubic-bezier(0.16, 1, 0.3, 1) 2s both; }
  .pt.is-escena[data-tramo="2"] .pt-prep { animation: ptPrep 3.2s ease 0.2s both; }
  .pt.is-escena[data-tramo="2"] .pt-ia, .pt.is-escena[data-tramo="2"] .pt-pie { animation: ptAparece 0.6s ease 3.2s both; }
  .pt.is-escena[data-tramo="3"] .pt-hoja { animation: ptSube 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both; }
  .pt.is-escena[data-tramo="3"] .pt-ok { animation: ptOk 0.5s cubic-bezier(0.16, 1, 0.3, 1) 2.2s both; }
  /* el fondo de fantasía barre de abajo hacia arriba, y «Flores» se prende */
  .pt.is-escena[data-tramo="4"] .pt-res--loco { animation: ptBarre 1.4s cubic-bezier(0.65, 0, 0.35, 1) 1.1s both; }
  .pt.is-escena[data-tramo="4"] .pt-fondos .is-on { animation: ptToque 0.5s ease 0.6s both; }
  .pt.is-escena[data-tramo="0"] .pt-paso[data-k="0"] .pt-barra-av b,
  .pt.is-escena[data-tramo="1"] .pt-paso[data-k="1"] .pt-barra-av b,
  .pt.is-escena[data-tramo="2"] .pt-paso[data-k="2"] .pt-barra-av b,
  .pt.is-escena[data-tramo="3"] .pt-paso[data-k="3"] .pt-barra-av b,
  .pt.is-escena[data-tramo="4"] .pt-paso[data-k="4"] .pt-barra-av b { animation: ptBarra 4.5s linear both; }
  @keyframes ptEntra { from { opacity: 0; transform: translateY(2.4cqh); } to { opacity: 1; transform: none; } }
  @keyframes ptAparece { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ptPrep { 0%, 82% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ptSube { from { transform: translateY(100%); } to { transform: none; } }
  @keyframes ptOk { from { opacity: 0; transform: translate(-50%, -3cqh); } to { opacity: 1; transform: translate(-50%, 0); } }
  @keyframes ptBarre { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes ptToque { 0% { background: rgba(255, 255, 255, 0.92); color: #141414; transform: scale(1); } 60% { transform: scale(0.92); } 100% { background: #E0457B; color: #fff; transform: scale(1); } }
  @keyframes ptBarra { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes ptGira { to { transform: rotate(360deg); } }

  /* ══ con movimiento: la escena pegada; la tienda hace su propio «cover» para no separarse de la pantalla ══ */
  .pt.is-escena .pt-riel { height: 520vh; }
  .pt.is-escena .pt-escena { position: sticky; top: 0; height: 100vh; height: 100svh; }
  @media (min-width: 900px) {
    .pt.is-escena .pt-lienzo { position: absolute; left: 50%; top: 50%; width: max(100vw, calc(100svh * 1.7684)); transform: translate(-50%, -50%); }
    .pt.is-escena .pt-escena::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(8, 8, 10, 0.8) 0%, rgba(8, 8, 10, 0.55) 24%, rgba(8, 8, 10, 0) 40%); }
    .pt.is-escena .pt-txt { position: absolute; left: 0; top: 50%; z-index: 2; width: min(32vw, 440px); padding: 0 0 0 4.4vw; transform: translateY(-50%); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
