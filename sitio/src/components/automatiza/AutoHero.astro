---
/**
 * Portada de una página de Automatiza: la foto editorial a pantalla completa con el título encima, en la línea de
 * las /experiencia (ExpHero). En escritorio la foto horizontal y el texto en su lado tranquilo (izquierda); en el
 * teléfono, la vertical con el texto abajo sobre un velo. La foto es el LCP (eager + fetchpriority).
 */
interface Props { n: string; etiqueta: string; titulo: string; bajada: string; foto: string; alt: string; ancla: string; aviso?: string; foco?: string }
const { n, etiqueta, titulo, bajada, foto, alt, ancla, aviso, foco = '50% 80%' } = Astro.props;
const I = '/images/automatiza/';
---
<section class="auh" aria-labelledby="auh-h" style={`--foco:${foco}`}>
  <picture>
    <source media="(min-width: 768px)" srcset={`${I}${foto}-1280.webp 1280w, ${I}${foto}-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" />
    <img class="auh-foto" src={`${I}${foto}-vertical-1024.webp`} srcset={`${I}${foto}-vertical-800.webp 800w, ${I}${foto}-vertical-1024.webp 1024w`} sizes="100vw" width="1024" height="1536" alt={alt} loading="eager" fetchpriority="high" decoding="async" />
  </picture>
  <div class="auh-velo" aria-hidden="true"></div>
  <div class="auh-in">
    <p class="auh-folio"><span>Automatiza · {n}</span><span>{etiqueta}</span></p>
    {aviso && <p class="auh-aviso"><i aria-hidden="true"></i>{aviso}</p>}
    <h1 class="auh-h" id="auh-h">{titulo}</h1>
    <p class="auh-p">{bajada}</p>
    <div class="auh-acc">
      <a class="auh-cta" href="/contacto" data-evento="automatiza_cta_portada">Agenda una demo</a>
      <a class="auh-sigue" href={`#${ancla}`}>Así se ve con AXO
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* teléfono: la foto arriba, con la persona a la vista, y el texto debajo sobre negro */
  .auh { position: relative; display: flex; flex-direction: column; overflow: hidden; background: #0B0B0C; color: #fff; isolation: isolate; }
  .auh picture { position: relative; display: block; height: 58svh; min-height: 360px; }
  .auh-foto { width: 100%; height: 100%; object-fit: cover; object-position: var(--foco); }
  .auh-velo { position: absolute; inset: 0; height: 58svh; min-height: 360px; z-index: 0; background: linear-gradient(180deg, rgba(11, 11, 12, 0) 62%, #0B0B0C 100%); }
  .auh-in { position: relative; z-index: 1; width: 100%; max-width: 1160px; margin: -28px auto 0; padding: 0 20px 48px; }
  .auh-folio { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 18px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.45); font: 600 11px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; }
  .auh-aviso { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; padding: 7px 14px 7px 11px; border-radius: 99px; background: #F2C46B; color: #141414; font: 700 12.5px/1.2 var(--font-display); }
  .auh-aviso i { width: 8px; height: 8px; border-radius: 50%; background: #141414; }
  .auh-h { margin: 0; max-width: 12ch; color: #fff; font: 700 clamp(44px, 8vw, 118px)/0.93 var(--pd-clash, var(--font-display)); letter-spacing: -0.025em; text-wrap: balance; }
  .auh-p { margin: 18px 0 0; max-width: 40ch; font: 500 17px/1.5 var(--font-body); color: rgba(255, 255, 255, 0.9); }
  .auh-acc { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  .auh-cta { display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; background: #fff; color: #141414; font: 700 15px/1 var(--font-display); text-decoration: none; transition: transform 0.2s; }
  .auh-cta:hover { color: #141414; text-decoration: none; transform: translateY(-1px); }
  .auh-sigue { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding-bottom: 2px; border-bottom: 1.5px solid #fff; color: #fff; font: 600 15px/1 var(--font-display); text-decoration: none; }
  .auh-sigue:hover { color: #fff; text-decoration: none; opacity: 0.8; }
  .auh-cta:focus-visible, .auh-sigue:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  @media (min-width: 768px) {
    .auh { flex-direction: row; align-items: center; min-height: max(620px, 100svh); }
    .auh picture { position: absolute; inset: 0; height: auto; min-height: 0; z-index: -2; }
    .auh-velo { height: auto; min-height: 0; z-index: -1; }
    .auh-in { margin: 0 auto; }
    .auh-foto { object-position: 70% 50%; }
    .auh-velo { background: linear-gradient(90deg, rgba(11, 11, 12, 0.86) 0%, rgba(11, 11, 12, 0.58) 36%, rgba(11, 11, 12, 0) 64%), linear-gradient(180deg, rgba(11, 11, 12, 0) 70%, rgba(11, 11, 12, 0.5) 100%); }
    .auh-in { padding: 120px 5vw 80px; }
    .auh-folio { max-width: 540px; }
    .auh-h { max-width: 44vw; font-size: clamp(46px, 6.2vw, 100px); }
    .auh-p { max-width: min(40ch, 40vw); font-size: 19px; }
  }
</style>
