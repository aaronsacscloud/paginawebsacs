<!-- Page tracking script — records pages visited, time spent, and engagement -->
<script is:inline>
(function() {
  var STORAGE_KEY = 'sacs_visitor';
  var startTime = Date.now();
  var maxScroll = 0;

  // Get or create visitor data
  function getVisitor() {
    try {
      var data = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (data && data.id) return data;
    } catch(e) {}
    // Se GUARDA en el acto. Antes solo se devolvía el objeto nuevo y el guardado
    // dependía de savePageVisit, que no siempre corre: cada carga de página
    // estrenaba id. Con un id distinto por página, ninguna regla de recorrido
    // —combinación, secuencia, repetición— podía verse como una sola persona.
    var nuevo = {
      id: 'v_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
      firstSeen: new Date().toISOString(),
      pages: [],
      totalTime: 0,
      score: 0
    };
    saveVisitor(nuevo);
    return nuevo;
  }

  function saveVisitor(v) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(v)); } catch(e) {}
    // Y en cookie. localStorage solo lo ve el navegador: cualquier formulario
    // que no se acuerde de mandar el visitorId a mano rompe el puente entre lo
    // que la persona navegó de anónima y su ficha del CRM. En cookie el
    // servidor lo lee SIEMPRE, venga de la forma que venga. Un año de vida,
    // sin HttpOnly porque el propio rastreador la lee.
    try {
      document.cookie = 'sacs_vid=' + encodeURIComponent(v.id) +
        '; Path=/; Max-Age=31536000; SameSite=Lax' +
        (location.protocol === 'https:' ? '; Secure' : '');
    } catch(e) {}
  }

  // Track scroll depth
  function onScroll() {
    var scrollPct = Math.round((window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100);
    if (scrollPct > maxScroll) maxScroll = scrollPct;
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  // Save page visit on unload
  function savePageVisit() {
    var v = getVisitor();
    var timeSpent = Math.round((Date.now() - startTime) / 1000);
    var path = window.location.pathname;

    v.pages.push({
      path: path,
      date: new Date().toISOString(),
      timeSeconds: timeSpent,
      scrollDepth: maxScroll
    });

    v.totalTime = (v.totalTime || 0) + timeSpent;

    // Calculate score
    var score = 0;
    var uniquePages = [];
    v.pages.forEach(function(p) {
      if (uniquePages.indexOf(p.path) === -1) uniquePages.push(p.path);
    });

    score += uniquePages.length * 5;                                    // 5 pts per unique page
    score += Math.min(v.totalTime, 600) / 10;                          // up to 60 pts for time (max 10min)
    if (uniquePages.indexOf('/planes') > -1) score += 20;              // saw pricing
    if (uniquePages.indexOf('/prueba-gratis') > -1) score += 30;       // went to signup
    if (uniquePages.indexOf('/contacto') > -1) score += 15;            // went to contact
    if (uniquePages.indexOf('/casos-de-exito') > -1) score += 10;      // saw case studies
    v.score = Math.round(Math.min(score, 100));

    // Keep only last 50 pages
    if (v.pages.length > 50) v.pages = v.pages.slice(-50);

    saveVisitor(v);
  }

  window.addEventListener('beforeunload', savePageVisit);
  // Also save periodically
  setInterval(savePageVisit, 30000);

  // Expose for signup form
  window.__sacsVisitor = getVisitor;

  // ── Reporte de la visita al CRM ──────────────────────────────────────
  //
  // Antes esto solo corría si el navegador YA tenía el correo guardado, y
  // además leía `sacs_visitor_id`, una llave que NADIE escribe (el id vive
  // dentro del objeto `sacs_visitor`). Resultado: el 90% del tráfico —el
  // anónimo— era invisible, y alguien podía pasar tres veces por la página de
  // precios sin que el CRM se enterara. Peor: si esa persona después dejaba
  // sus datos, su recorrido previo ya se había perdido, que es justo la parte
  // que dice si venía comparando o si llegó por accidente.
  //
  // Ahora se reporta SIEMPRE, con el id anónimo del navegador. El servidor
  // decide qué hace con eso: si no conoce a la persona, guarda la visita
  // anónima y la liga hacia atrás el día que se identifique.
  try {
    var visitante = getVisitor();
    saveVisitor(visitante);          // re-sella la cookie en cada carga
    var correoGuardado = localStorage.getItem('sacs_visitor_email');
    var entrada = Date.now();
    var reportado = false;

    function reportar(segundos) {
      if (reportado && !segundos) return;   // el periódico solo manda una vez
      reportado = true;
      var cuerpo = JSON.stringify({
        email: correoGuardado || null,
        visitor_id: visitante && visitante.id ? visitante.id : null,
        page_url: window.location.pathname + window.location.search,
        page_title: document.title,
        referrer: document.referrer || null,
        // Cuánto se quedó: distingue el rebote de la lectura real, que es
        // media señal de intención. Se manda al salir, no al entrar.
        segundos: segundos || null,
      });
      // sendBeacon sobrevive al cierre de la pestaña; fetch no siempre.
      if (segundos && navigator.sendBeacon) {
        navigator.sendBeacon('/api/tracking/identify', new Blob([cuerpo], { type: 'application/json' }));
      } else {
        fetch('/api/tracking/identify', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: cuerpo, keepalive: true,
        }).catch(function () {});
      }
    }

    // Al entrar: la visita se registra de una, sin esperar a que se vaya.
    reportar(0);

    // Al salir: el tiempo real de permanencia. UNA sola vez por carga —
    // `visibilitychange` se dispara cada vez que se cambia de pestaña, así que
    // ir y venir generaba una fila por viaje: la misma visita contada cinco
    // veces inflaba las reglas de repetición y de permanencia.
    var salidaReportada = false;
    function alSalir() {
      if (salidaReportada) return;
      var seg = Math.round((Date.now() - entrada) / 1000);
      if (seg < 3 || seg >= 3600) return;   // <3s es rebote, >1h es pestaña olvidada
      salidaReportada = true;
      reportar(seg);
    }
    window.addEventListener('pagehide', alSalir);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') alSalir();
    });
  } catch (e) {}
})();
</script>
