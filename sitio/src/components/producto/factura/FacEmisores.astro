---
/**
 * «Cada sucursal factura con su razón social» (/producto/facturacion-electronica): varios emisores, el emisor de cada
 * sucursal y sus folios con serie (la operatividad real: «Por cuenta» o «Por sucursal»). Las series corren solas
 * mientras se ve, como si cada tienda estuviera facturando (nombres y RFC de ejemplo). Azul.
 */
import { EMISORES } from '../../../data/producto-facturacion';
const RAZON = ['MODA DEMO S.A. DE C.V.', 'MODA DEMO S.A. DE C.V.', 'BOUTIQUE ALMA S.A. DE C.V.'];
const RFC = ['MDE240115AB1', 'MDE240115AB1', 'BAF970624AL1'];
---
<section class="pda fem pd-azul" id="fac-emisores" aria-labelledby="fem-h">
  <div class="pda-fondo" aria-hidden="true"><span>EMISORES · SERIES · FOLIOS</span><span>EMISORES · SERIES · FOLIOS</span></div>
  <p class="pd-folio"><span>{EMISORES.k}</span><span>Varias razones sociales</span></p>
  <div class="fem-grid">
    <div class="fem-lado">
      <h2 class="pda-h" id="fem-h">{EMISORES.h}</h2>
      <p class="fem-p">{EMISORES.p}</p>
    </div>
    <div class="fem-tabla" data-fem>
      <span class="fem-modo"><small>Operatividad de facturación</small><span><i>Por cuenta</i><i class="is-on">Por sucursal</i></span></span>
      <ul>
        {EMISORES.series.map((x, i) => (
          <li class="rv" style={`--i:${i}`}>
            <span class="fem-suc"><b>{x.suc}</b><small>{RAZON[i]} · {RFC[i]}</small></span>
            <span class="fem-folio"><small>Siguiente folio</small><b>{x.serie}-<span data-fem-n={x.n}>{String(x.n).padStart(3, '0')}</span></b></span>
          </li>
        ))}
      </ul>
      <span class="fem-timbres"><b>Timbres</b> de toda la cuenta, para todas tus sucursales</span>
    </div>
  </div>
</section>

<style>
  .fem-grid { display: grid; gap: 32px; }
  .fem-lado { display: grid; gap: 16px; align-content: center; }
  .fem-p { margin: 0; max-width: 44ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .fem-tabla { display: grid; gap: 12px; padding: 18px; border-radius: 22px; background: #fff; color: #141414; box-shadow: 0 30px 50px -30px rgba(10, 22, 72, 0.6); }
  .fem-modo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid #ECEDEF; }
  .fem-modo small { font: 700 11px/1.2 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #6B6A64; }
  .fem-modo > span { display: flex; padding: 3px; border-radius: 10px; background: #F1F2F5; }
  .fem-modo i { padding: 6px 11px; border-radius: 8px; font: 700 12px/1 var(--font-display); font-style: normal; color: #6B6A64; }
  .fem-modo i.is-on { background: #fff; color: #2F55C4; box-shadow: 0 1px 3px rgba(20, 20, 20, 0.15); }
  .fem-tabla ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .fem-tabla li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 14px; border-radius: 14px; background: #F6F7F9; }
  .fem-suc { display: grid; gap: 3px; min-width: 0; }
  .fem-suc b { font: 700 16px/1.2 var(--font-display); }
  .fem-suc small { font: 500 11.5px/1.3 var(--font-body); color: #6B6A64; overflow-wrap: anywhere; }
  .fem-folio { display: grid; justify-items: end; gap: 3px; flex: none; }
  .fem-folio small { font: 600 10.5px/1.2 var(--font-display); color: #8C8A84; }
  .fem-folio b { font: 700 15px/1.1 'JetBrains Mono', ui-monospace, monospace; color: #2F55C4; }
  .fem-folio b span { display: inline-block; }
  .fem-folio b span.is-sube { animation: femSube 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes femSube { from { opacity: 0; transform: translateY(70%); } to { opacity: 1; transform: none; } }
  .fem-timbres { padding-top: 10px; border-top: 1px solid #ECEDEF; font: 500 13px/1.4 var(--font-body); color: #45433E; }
  .fem-timbres b { font-family: var(--font-display); color: #141414; }
  :global(.js-rv) .fem-tabla .rv { opacity: 0; transform: translateX(30px); transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.12s + 0.1s); }
  :global(.js-rv) .fem-tabla .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .fem-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5vw; align-items: center; }
    .fem-tabla { padding: 24px; }
  }
  @media (max-width: 767px) {
    .fem-tabla li { align-items: flex-start; }
    .fem-folio b { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fem-folio b span.is-sube { animation: none; }
    :global(.js-rv) .fem-tabla .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Cada 1.6 s una sucursal «factura»: su folio sube uno. Solo mientras la tabla se ve y la pestaña está activa.
  (() => {
    const tabla = document.querySelector<HTMLElement>('[data-fem]');
    if (!tabla || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const nums = Array.from(tabla.querySelectorAll<HTMLElement>('[data-fem-n]'));
    let reloj = 0, visible = false, k = 0;
    const sube = () => {
      const el = nums[[0, 1, 0, 2, 1, 0][k++ % 6]];
      const n = Number(el.dataset.femN) + 1; el.dataset.femN = String(n);
      el.textContent = String(n).padStart(3, '0');
      el.classList.remove('is-sube');
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-sube')));
    };
    const prende = () => { if (!reloj && visible && !document.hidden) reloj = window.setInterval(sube, 1600); };
    const apaga = () => { if (reloj) { window.clearInterval(reloj); reloj = 0; } };
    new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; visible ? prende() : apaga(); }), { threshold: 0.4 }).observe(tabla);
    document.addEventListener('visibilitychange', () => (document.hidden ? apaga() : prende()));
  })();
</script>
