---
/**
 * «Lo que pasa después, también» (/producto/facturacion-electronica): notas de crédito, complementos de pago y
 * cancelación, con las opciones REALES (tipos 01 y 03, Pagos 2.0 por abono de una PPD, motivos del SAT 01–04).
 * Entrada: las tres cartas salen de un mazo al centro y se abren como abanico. Fucsia.
 */
import { NOTAS } from '../../../data/producto-facturacion';
---
<section class="pda fno pd-fucsia" id="fac-notas" aria-labelledby="fno-h">
  <p class="pd-folio"><span>{NOTAS.k}</span><span>Notas, complementos y cancelaciones</span></p>
  <h2 class="pda-h" id="fno-h">{NOTAS.h}</h2>
  <ul class="fno-mazo">
    {NOTAS.cartas.map((c, i) => (
      <li class="rv" style={`--i:${i}`}>
        <span class="fno-tag">{c.tag}</span>
        <b>{c.t}</b>
        <ul>{c.puntos.map((p) => <li>{p}</li>)}</ul>
        <span class="fno-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      </li>
    ))}
  </ul>
  <p class="fno-nota">{NOTAS.nota}</p>
</section>

<style>
  .fno-mazo { display: grid; gap: 14px; margin: 40px 0 0; padding: 0; list-style: none; }
  .fno-mazo > li { position: relative; display: grid; align-content: start; gap: 12px; min-height: 300px; padding: 24px 22px; overflow: hidden; border-radius: 22px; background: #fff; color: #141414; box-shadow: 0 24px 44px -26px rgba(60, 0, 20, 0.55); }
  .fno-tag { justify-self: start; padding: 6px 11px; border-radius: 99px; background: #FDEAF1; color: #B42A5E; font: 700 11.5px/1.2 var(--font-display); }
  .fno-mazo > li > b { font: 700 clamp(24px, 2.4vw, 32px)/1.05 var(--pd-clash); letter-spacing: -0.01em; }
  .fno-mazo ul { display: grid; gap: 0; margin: 4px 0 0; padding: 0; list-style: none; border-top: 1px solid #ECEDEF; }
  .fno-mazo ul li { position: relative; padding: 11px 0 11px 24px; border-bottom: 1px solid #ECEDEF; font: 600 14.5px/1.35 var(--font-display); color: #2C2B28; }
  .fno-mazo ul li::before { content: '✓'; position: absolute; left: 0; top: 11px; color: #D03A70; font-weight: 700; }
  .fno-num { position: absolute; right: 16px; bottom: -14px; font: 700 96px/1 var(--pd-clash); color: transparent; -webkit-text-stroke: 1.5px rgba(208, 58, 112, 0.22); pointer-events: none; }
  .fno-nota { margin: 28px 0 0; max-width: 60ch; font: 600 16px/1.5 var(--font-display); color: #fff; }
  /* entrada: un mazo al centro que se abre en abanico */
  :global(.js-rv) .fno-mazo > .rv { opacity: 0; transform: translateY(40px) rotate(calc((var(--i) - 1) * 7deg)); transform-origin: 50% 120%; transition: opacity 0.6s ease, transform 1s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i) * 0.12s); }
  :global(.js-rv) .fno-mazo > .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .fno-mazo { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 56px; }
    .fno-mazo > li { min-height: 380px; padding: 28px 26px; }
    :global(.js-rv) .fno-mazo > .rv { transform: translateX(calc((1 - var(--i)) * 104%)) rotate(calc((var(--i) - 1) * 9deg)) scale(0.94); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .fno-mazo > .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
