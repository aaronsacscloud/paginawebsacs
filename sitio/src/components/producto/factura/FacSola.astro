    /* teléfonos chicos: el ticket completo cabe arriba del texto */
    .fso.is-escena .fso-carta[data-k="0"] { zoom: 0.8; }
  }
  @media (max-width: 899px) and (max-height: 700px) {
    .fso.is-escena .fso-carta[data-k="0"] { zoom: 0.7; }
