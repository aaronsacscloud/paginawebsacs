    .fso.is-escena .fso-paso { display: none; padding: 10px 0 8px; }
    .fso.is-escena[data-tramo="0"] .fso-paso[data-k="0"], .fso.is-escena[data-tramo="1"] .fso-paso[data-k="1"], .fso.is-escena[data-tramo="2"] .fso-paso[data-k="2"], .fso.is-escena[data-tramo="3"] .fso-paso[data-k="3"] { display: grid; }
