<script>
  // Lo que el scroll mueve y el CSS no alcanza: el paso de cada carta (antes / ahora / después) y la foto del momento.
  // Lee data-tramo, que pone iniciaEscenas (scripts/experiencia/escenas.ts); sin escena, todo queda en su estado final.
  (() => {
    const sec = document.querySelector<HTMLElement>('.fso');
    if (!sec) return;
    const cartas = Array.from(sec.querySelectorAll<HTMLElement>('.fso-carta'));
    let ultimo = -1;
    const pinta = () => {
      const escena = sec.classList.contains('is-escena');
      const t = Number(sec.dataset.tramo || 0);
      const clave = escena ? t : -2;
      if (clave === ultimo) return;
      ultimo = clave;
      cartas.forEach((c) => { const k = Number(c.dataset.k); c.dataset.estado = !escena || k === t ? 'ahora' : k < t ? 'antes' : 'despues'; });
      sec.dataset.foto = t === 0 ? 'caja' : 'cliente';
    };
    new MutationObserver(pinta).observe(sec, { attributes: true, attributeFilter: ['data-tramo', 'class'] });
    pinta();
  })();
</script>
