---
/**
 * «El público en general, en una sola factura» (/producto/facturacion-electronica): la factura global. Sobre la foto
 * del cierre de noche (gpt-image-2.5), los tickets del día vuelan y se apilan en una sola tarjeta de CFDI con el
 * receptor real (XAXX010101000 · PÚBLICO EN GENERAL) cuyo contador de conceptos sube; los 6 pasos REALES del asistente
 * se encienden uno a uno; la pantalla REAL del paso 1 (cuenta con facturación real, sin el menú lateral) y el botón
 * «Generar factura de hoy», que existe si lo activas (un clic por sucursal; no es automático). Marino.
 */
import { GLOBAL, I } from '../../../data/producto-facturacion';
import StaffVentana from '../../plugins/staff/StaffVentana.astro';
const TICKETS = ['$1,290.00', '$2,190.00', '$589.00', '$3,480.00', '$749.00', '$1,050.00', '$2,830.00', '$415.00'];
---
<section class="pda fgl pd-marino" id="fac-global" aria-labelledby="fgl-h">
  <div class="pda-fondo" aria-hidden="true"><span>GLOBAL · GLOBAL · GLOBAL</span><span>GLOBAL · GLOBAL · GLOBAL</span></div>
  <p class="pd-folio"><span>{GLOBAL.k}</span><span>Público en general</span></p>
  <div class="fgl-cab">
    <h2 class="pda-h" id="fgl-h">{GLOBAL.h}</h2>
    <p class="fgl-p">{GLOBAL.p}</p>
  </div>

  <div class="fgl-escena" data-fgl>
    <figure class="fgl-foto">
      <img src={`${I}noche-1280.webp`} srcset={`${I}noche-900.webp 900w, ${I}noche-1280.webp 1280w`} sizes="(min-width: 900px) 1160px, 100vw" width="1280" height="853" alt="De noche, la dueña cierra el día en su laptop sobre el mostrador de la boutique" loading="lazy" decoding="async" />
    </figure>
    <div class="fgl-vuelo" aria-hidden="true">
      {TICKETS.map((t, i) => <span class="fgl-tk" style={`--i:${i}`}><i></i><i></i><b>{t}</b></span>)}
    </div>
    <div class="fgl-cfdi" role="img" aria-label="Una sola factura global para el público en general, con cada venta como concepto">
      <small>CFDI 4.0 · Factura global</small>
      <b>{GLOBAL.receptor}</b>
      <span class="fgl-fila"><span>Conceptos</span><strong data-fgl-n>0</strong></span>
      <span class="fgl-fila"><span>Periodicidad</span><strong>01 · Diaria</strong></span>
      <span class="fgl-barra"><i></i></span>
      <u>Vista previa · Timbrar</u>
    </div>
  </div>

  <ol class="fgl-pasos">
    {GLOBAL.pasos.map((x, i) => <li style={`--i:${i}`}><span>{i + 1}</span>{x}</li>)}
  </ol>

  <div class="fgl-pie">
    <div class="fgl-ventana rv">
      <StaffVentana src={`${I}pantalla-global.webp`} w={1400} h={948} alt="El asistente de la factura global en su paso 1, «Comprobante y datos generales»: la sucursal, el lugar de expedición, la forma de pago, el objeto de impuesto y la fecha de emisión, con los seis pasos arriba" barra="Factura global" />
    </div>
    <div class="fgl-boton rv">
      <p class="fgl-b-k">Si lo activas</p>
      <b>{GLOBAL.boton.t}</b>
      <span>{GLOBAL.boton.d}</span>
      <ul aria-label="Generar factura global de hoy, por sucursal">
        <li><span>Polanco</span><u>Generar</u></li>
        <li><span>Santa Fe</span><u>Generar</u></li>
        <li><span>Coyoacán</span><em>Manual — usa el asistente</em></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .fgl-cab { display: grid; gap: 14px; }
  .fgl-p { margin: 0; max-width: 50ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .fgl-escena { position: relative; margin-top: 36px; overflow: hidden; border-radius: 22px; }
  .fgl-foto { margin: 0; aspect-ratio: 4 / 3; }
  .fgl-foto img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; filter: brightness(0.62); }
  /* los tickets salen de la izquierda y se meten en la tarjeta */
  .fgl-vuelo { position: absolute; inset: 0; pointer-events: none; }
  .fgl-tk { position: absolute; left: 6%; top: calc(14% + var(--i) * 9%); display: grid; gap: 3px; width: 76px; padding: 7px 8px 9px; border-radius: 3px; background: #FBFAF7; box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.8); opacity: 0; }
  .fgl-tk i { height: 3px; border-radius: 2px; background: #D7D5CF; }
  .fgl-tk i + i { width: 70%; }
  .fgl-tk b { font: 700 10px/1.1 'JetBrains Mono', ui-monospace, monospace; color: #141414; }
  .fgl-escena.is-on .fgl-tk { animation: fglVuela 4.8s cubic-bezier(0.55, 0, 0.3, 1) infinite; animation-delay: calc(var(--i) * 0.42s); }
  @keyframes fglVuela {
    0% { opacity: 0; transform: translate(-30px, 0) rotate(-8deg); }
    12% { opacity: 1; transform: translate(0, 0) rotate(-4deg); }
    55% { opacity: 1; }
    72%, 100% { opacity: 0; transform: translate(var(--dx, 52vw), var(--dy, 0px)) rotate(6deg) scale(0.4); }
  }
  .fgl-cfdi { position: absolute; right: 16px; bottom: 16px; display: grid; gap: 8px; width: min(78%, 330px); padding: 18px 18px 16px; border-radius: 16px; background: #fff; color: #141414; box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.8); }
  .fgl-cfdi small { font: 700 10.5px/1 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: #2F55C4; }
  .fgl-cfdi > b { font: 700 13px/1.3 'JetBrains Mono', ui-monospace, monospace; }
  .fgl-fila { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px solid #ECEDEF; font: 500 13px/1.2 var(--font-body); color: #45433E; }
  .fgl-fila strong { font: 700 14px/1.2 var(--font-display); color: #141414; font-variant-numeric: tabular-nums; }
  .fgl-barra { height: 6px; margin-top: 4px; overflow: hidden; border-radius: 99px; background: #E7E8EC; }
  .fgl-barra i { display: block; width: 100%; height: 100%; background: #2F55C4; transform-origin: 0 50%; transform: scaleX(0); }
  .fgl-escena.is-on .fgl-barra i { animation: fglBarra 4.8s linear infinite; }
  @keyframes fglBarra { 0% { transform: scaleX(0); } 90%, 100% { transform: scaleX(1); } }
  .fgl-cfdi u { display: grid; place-items: center; height: 36px; margin-top: 4px; border-radius: 10px; background: #2F55C4; color: #fff; font: 700 13px/1 var(--font-display); text-decoration: none; }
  /* los 6 pasos se encienden uno a uno */
  .fgl-pasos { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; padding: 0; list-style: none; }
  .fgl-pasos li { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px 7px 7px; border-radius: 99px; background: rgba(157, 184, 245, 0.12); box-shadow: inset 0 0 0 1px rgba(157, 184, 245, 0.28); font: 600 13.5px/1.2 var(--font-display); color: rgba(255, 255, 255, 0.86); transition: background 0.4s ease, color 0.4s ease; transition-delay: calc(var(--i) * 0.28s + 0.2s); }
  .fgl-pasos span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: rgba(157, 184, 245, 0.25); color: #fff; font: 700 12px/1 var(--font-display); transition: background 0.4s ease; transition-delay: calc(var(--i) * 0.28s + 0.2s); }
  .fgl-pasos.is-on li { background: #fff; color: #0A1648; }
  .fgl-pasos.is-on span { background: #2F55C4; }
  :global(html:not(.js-rv)) .fgl-pasos li { background: #fff; color: #0A1648; }
  .fgl-pie { display: grid; gap: 20px; margin-top: 32px; }
  .fgl-boton { display: grid; gap: 8px; align-content: start; padding: 22px; border-radius: 20px; background: #13215C; box-shadow: inset 0 0 0 1px rgba(157, 184, 245, 0.22); }
  .fgl-b-k { margin: 0; font: 600 11.5px/1.3 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--pd-acento); }
  .fgl-boton > b { font: 700 22px/1.15 var(--pd-clash); color: #fff; }
  .fgl-boton > span { font: 500 14.5px/1.5 var(--font-body); color: var(--pd-tenue); }
  .fgl-boton ul { display: grid; gap: 8px; margin: 8px 0 0; padding: 0; list-style: none; }
  .fgl-boton li { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border-radius: 12px; background: #fff; color: #141414; font: 600 14px/1.2 var(--font-display); }
  .fgl-boton u { padding: 7px 14px; border-radius: 9px; background: #2F55C4; color: #fff; font: 700 12.5px/1 var(--font-display); text-decoration: none; }
  .fgl-boton em { font: 600 12px/1.2 var(--font-display); font-style: normal; color: #6B6A64; }
  :global(.js-rv) .fgl-pie .rv { opacity: 0; transform: translateY(40px); transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js-rv) .fgl-pie .fgl-boton.rv { transition-delay: 0.2s; }
  :global(.js-rv) .fgl-pie .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .fgl-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .fgl-escena { margin-top: 52px; }
    .fgl-foto { aspect-ratio: 21 / 9; }
    .fgl-tk { left: 4%; top: calc(10% + var(--i) * 10%); width: 96px; }
    .fgl-tk b { font-size: 11px; }
    .fgl-cfdi { right: 5%; bottom: 50%; transform: translateY(50%); width: 340px; }
    .fgl-pie { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 3vw; align-items: start; margin-top: 40px; }
  }
  @media (max-width: 767px) {
    .fgl-foto { aspect-ratio: 4 / 5; }
    .fgl-tk { width: 64px; padding: 5px 6px 7px; }
    .fgl-tk b { font-size: 8.5px; }
    .fgl-cfdi { width: auto; left: 16px; padding: 14px 14px 12px; }
    .fgl-cfdi > b { font-size: 11.5px; }
    .fgl-ventana { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 10px; }
    .fgl-ventana > :global(.sv) { width: 640px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fgl-escena.is-on .fgl-tk, .fgl-escena.is-on .fgl-barra i { animation: none; }
    .fgl-tk { opacity: 1; }
    .fgl-barra i { transform: none; }
    .fgl-pasos li, .fgl-pasos span { transition: none; }
    :global(.js-rv) .fgl .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Los tickets vuelan (y el contador de conceptos sube) solo mientras la escena se ve; los pasos se encienden la
  // primera vez. El destino de cada ticket (--dx/--dy) es el centro de la tarjeta, medido al cambiar el tamaño.
  (() => {
    const esc = document.querySelector<HTMLElement>('[data-fgl]');
    const pasos = document.querySelector<HTMLElement>('.fgl-pasos');
    if (!esc) return;
    const cfdi = esc.querySelector<HTMLElement>('.fgl-cfdi');
    const n = esc.querySelector<HTMLElement>('[data-fgl-n]');
    const tks = Array.from(esc.querySelectorAll<HTMLElement>('.fgl-tk'));
    const mide = () => {
      if (!cfdi) return;
      const e = esc.getBoundingClientRect(), c = cfdi.getBoundingClientRect();
      tks.forEach((t) => {
        // offsetLeft/Top/Width/Height: la caja sin la animación (el transform no cuenta)
        const x0 = t.offsetLeft, y0 = t.offsetTop;
        t.style.setProperty('--dx', Math.round(c.left - e.left + c.width / 2 - x0 - t.offsetWidth / 2) + 'px');
        t.style.setProperty('--dy', Math.round(c.top - e.top + c.height / 2 - y0 - t.offsetHeight / 2) + 'px');
      });
    };
    new ResizeObserver(mide).observe(esc);
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let reloj = 0, cuenta = 0;
    const late = () => { cuenta = (cuenta + 1) % 9; if (n) n.textContent = String(Math.round((148 * cuenta) / 8)); };
    const prende = () => { if (!reloj && !reducido && !document.hidden) reloj = window.setInterval(late, 533); };
    const apaga = () => { if (reloj) { window.clearInterval(reloj); reloj = 0; } };
    if (reducido && n) n.textContent = '148';
    if (!('IntersectionObserver' in window)) { esc.classList.add('is-on'); pasos?.classList.add('is-on'); return; }
    new IntersectionObserver((es) => es.forEach((e) => { esc.classList.toggle('is-on', e.isIntersecting); e.isIntersecting ? prende() : apaga(); }), { threshold: 0.3 }).observe(esc);
    document.addEventListener('visibilitychange', () => (document.hidden ? apaga() : esc.classList.contains('is-on') && prende()));
    if (pasos) { const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { pasos.classList.add('is-on'); io.disconnect(); } }, { threshold: 0.6 }); io.observe(pasos); }
  })();
</script>
