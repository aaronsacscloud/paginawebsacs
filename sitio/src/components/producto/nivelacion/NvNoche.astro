<script>
  // Lo que el scroll mueve y el CSS no alcanza: el estado de cada carta (antes / ahora / después), el paso de la lista,
  // la foto del momento y la hora del reloj. Lee data-tramo, que pone iniciaEscenas (scripts/experiencia/escenas.ts);
  // sin escena todo se queda en su estado final.
  (() => {
    const sec = document.querySelector<HTMLElement>('.nvn');
    if (!sec) return;
    const cartas = Array.from(sec.querySelectorAll<HTMLElement>('.nvn-carta'));
    const pasos = Array.from(sec.querySelectorAll<HTMLElement>('.nvn-paso'));
    const reloj = sec.querySelector<HTMLElement>('.nvn-reloj');
    const hora = sec.querySelector<HTMLElement>('[data-hora]');
    const sufijo = sec.querySelector<HTMLElement>('[data-sufijo]');
    const horas: [string, string][] = JSON.parse(sec.dataset.horas || '[]');
    const fotos: string[] = JSON.parse(sec.dataset.fotos || '[]');
    let ultimo = -1;
    const pinta = () => {
      const t = Number(sec.dataset.tramo || 0);
      if (t === ultimo) return;
      ultimo = t;
      cartas.forEach((c, k) => { c.dataset.estado = k < t ? 'despues' : k === t ? 'ahora' : 'antes'; });
      pasos.forEach((p, k) => p.classList.toggle('is-ahora', k === t));
      sec.dataset.foto = fotos[t] || '';
      const h = horas[t];
      if (h && hora && sufijo && reloj) {
        hora.textContent = h[0];
        sufijo.textContent = h[1];
        reloj.classList.remove('is-cambia');
        requestAnimationFrame(() => requestAnimationFrame(() => reloj.classList.add('is-cambia')));
      }
    };
    new MutationObserver(pinta).observe(sec, { attributes: true, attributeFilter: ['data-tramo', 'class'] });
    pinta();
  })();
</script>
