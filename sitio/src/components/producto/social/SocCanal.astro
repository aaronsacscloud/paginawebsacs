---
/**
 * «Sabes qué red te vende» (/producto/social-commerce): cada pedido con su canal. Barras por red que crecen al verse
 * (dibujo con valores de ejemplo) y la lista REAL de Pedidos de la cuenta demo, donde cada pedido trae su canal
 * (TikTok Shop, tienda en línea…; nombres de ejemplo). Entrada: las barras crecen escalonadas, la ventana entra con un
 * giro leve desde la izquierda. Marfil.
 */
import { CANAL } from '../../../data/producto-social';
import StaffVentana from '../../plugins/staff/StaffVentana.astro';
---
<section class="pda sca2 pd-marfil" id="soc-canal" aria-labelledby="sca2-h">
  <p class="pd-folio"><span>{CANAL.k}</span><span>Pedidos y reportes</span></p>
  <div class="sca2-cab">
    <h2 class="pda-h" id="sca2-h">{CANAL.h}</h2>
    <p class="sca2-p">{CANAL.p}</p>
  </div>
  <div class="sca2-grid">
    <div class="sca2-barras" data-sca2 role="img" aria-label="Ventas por canal, con valores de ejemplo: Instagram, TikTok Shop, WhatsApp, tienda en línea y Facebook">
      <span class="sca2-t" aria-hidden="true"><b>Ventas por canal</b><em>Ejemplo</em></span>
      {CANAL.canales.map((c, i) => (
        <span class="sca2-f" style={`--i:${i};--v:${c.v}%`} aria-hidden="true"><span>{c.t}</span><i><b></b></i></span>
      ))}
    </div>
    <div class="sca2-ventana rv"><StaffVentana src="/images/producto/apartados-y-pedidos/pantalla-pedidos.webp" w={1400} h={863} alt="La lista de pedidos de Sacs: cada pedido con su clienta, su canal (TikTok Shop, tienda en línea), la sucursal, el vendedor, lo pagado, la entrega y su estado" barra="Pedidos" /></div>
  </div>
</section>

<style>
  .sca2-cab { display: grid; gap: 14px; }
  .sca2-p { margin: 0; max-width: 48ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .sca2-grid { display: grid; gap: 24px; margin-top: 40px; }
  .sca2-barras { display: grid; gap: 14px; align-content: start; padding: 22px; border-radius: 20px; background: #fff; box-shadow: 0 0 0 1px rgba(20, 20, 20, 0.06); }
  .sca2-t { display: flex; align-items: center; justify-content: space-between; }
  .sca2-t b { font: 800 13px/1 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #45433E; }
  .sca2-t em { padding: 4px 9px; border-radius: 99px; background: #F2F3F6; color: #8A8A85; font: 600 11px/1.2 var(--font-display); font-style: normal; }
  .sca2-f { display: grid; gap: 6px; font: 700 15px/1.2 var(--font-display); color: #141414; }
  .sca2-f i { display: block; height: 12px; border-radius: 99px; background: #F2F3F6; overflow: hidden; }
  .sca2-f i b { display: block; width: var(--v); height: 100%; border-radius: 99px; background: linear-gradient(90deg, #D03A70, #F07FA6); transform-origin: 0 50%; }
  .sca2-f:nth-child(3) i b { background: linear-gradient(90deg, #141414, #45433E); }
  .sca2-f:nth-child(4) i b { background: linear-gradient(90deg, #1F9D63, #3DD68C); }
  .sca2-f:nth-child(5) i b { background: linear-gradient(90deg, #2F55C4, #5B86EA); }
  .sca2-f:nth-child(6) i b { background: linear-gradient(90deg, #4470D8, #9DB8F5); }
  :global(.js-rv) .sca2-barras .sca2-f i b { transform: scaleX(0); }
  .sca2-barras.is-on .sca2-f i b { transform: none; transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(0.2s + var(--i) * 0.12s); }
  :global(.js-rv) .sca2-ventana.rv { opacity: 0; transform: translateX(-60px) perspective(1600px) rotateY(8deg); transform-origin: 0 50%; transition: opacity 0.7s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js-rv) .sca2-ventana.rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .sca2-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .sca2-grid { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: 4vw; align-items: center; margin-top: 56px; }
  }
  @media (max-width: 767px) {
    .sca2-ventana { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 10px; }
    .sca2-ventana > :global(.sv) { width: 720px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .sca2-barras .sca2-f i b, :global(.js-rv) .sca2-ventana.rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Las barras crecen la primera vez que se ven.
  (() => {
    const el = document.querySelector<HTMLElement>('[data-sca2]');
    if (!el) return;
    if (!('IntersectionObserver' in window)) { el.classList.add('is-on'); return; }
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { el.classList.add('is-on'); io.disconnect(); } }, { threshold: 0.4 });
    io.observe(el);
  })();
</script>
