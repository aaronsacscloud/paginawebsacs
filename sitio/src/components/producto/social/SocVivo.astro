---
/**
 * «Vende en vivo, sin perder un pedido» (/producto/social-commerce): una dinámica de redes con el scroll
 * (data-tramos="5"). Al fondo, la vendedora presenta una gabardina frente a su celular (gpt-image-2.5); encima, el live
 * con sus comentarios que suben solos y el panel de Sacs que cambia en cada paso: la dinámica programada, «Crear
 * apartado» con la talla que pidieron, la liga para mandar por mensaje, el pago en línea y el cierre con sus números.
 * Textos del módulo Dinámicas de Redes; los números del cierre son de ejemplo. Sin JS o con «reducir movimiento»: los
 * pasos en lista, con el live quieto.
 */
import { VIVO, I } from '../../../data/producto-social';
const P = VIVO.prenda;
---
<section class="svi" id="soc-vivo" data-escena data-tramos="5" data-tramo="4" aria-labelledby="svi-h">
  <div class="svi-riel" data-riel>
    <div class="svi-escena">
      <div class="svi-foto">
        <img src={`${I}live-1280.webp`} srcset={`${I}live-900.webp 900w, ${I}live-1280.webp 1280w, ${I}live-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" alt="La vendedora presenta una gabardina camel frente a su celular en un tripié con aro de luz, en la boutique" loading="lazy" decoding="async" />
      </div>

      <div class="svi-txt">
        <p class="svi-k">{VIVO.k}</p>
        <h2 class="svi-h" id="svi-h">{VIVO.h}</h2>
        <ol class="svi-pasos">
          {VIVO.tramos.map((p, k) => (
            <li class="svi-paso" data-k={k}>
              <span class="svi-paso-n">{p.n}</span>
              <span class="svi-paso-t"><b>{p.t}</b><span>{p.d}</span></span>
              <i class="svi-barra" aria-hidden="true"><b></b></i>
            </li>
          ))}
        </ol>
      </div>

      <div class="svi-mesa" aria-hidden="true">
        <!-- el live: comentarios que suben -->
        <div class="svi-live">
          <span class="svi-live-top"><em>EN VIVO</em><span>👁 1,284</span></span>
          <span class="svi-comentarios"><span class="svi-c-riel">{[...VIVO.comentarios, ...VIVO.comentarios].map((c) => <span class="svi-c"><b>{c.u}</b>{c.t}</span>)}</span></span>
          <span class="svi-prenda"><b>{P.t}</b><span>{P.precio}</span></span>
        </div>

        <!-- el panel de Sacs, paso por paso -->
        <div class="svi-panel" data-k="0">
          <span class="svi-p-t"><b>Nueva Dinámica</b><em>📡 Live</em></span>
          <span class="svi-r"><small>Nombre</small><b>Live viernes de abrigos</b></span>
          <span class="svi-r2"><span class="svi-r"><small>Canal</small><b>Instagram</b></span><span class="svi-r"><small>Hora</small><b>Vie 7:00 p. m.</b></span></span>
          <span class="svi-r2"><span class="svi-r"><small>Meta de ventas</small><b>$30,000</b></span><span class="svi-r"><small>Responsable</small><b>Daniela Ríos</b></span></span>
          <span class="svi-tira"><span>6 prendas</span><span>Polanco Boutique</span></span>
        </div>
        <div class="svi-panel" data-k="1">
          <span class="svi-p-t"><b>{P.t}</b><em class="svi-rojo">● En vivo</em></span>
          <span class="svi-tallas">{P.tallas.map((t) => <i class:list={{ 'is-on': t === 'M' }}>{t}</i>)}</span>
          <span class="svi-bots"><u>CREAR PEDIDO</u><u class="is-on">CREAR APARTADO</u></span>
          <span class="svi-ok">✓ Apartado creado · talla M separada</span>
        </div>
        <div class="svi-panel" data-k="2">
          <span class="svi-p-t"><b>Apartado creado</b><em>APA-POL-35</em></span>
          <small class="svi-nota">Manda este link al cliente por Instagram o Facebook…</small>
          <span class="svi-link">tu-tienda/apartado/APA-POL-35</span>
          <span class="svi-bots"><u>📋 Copiar link</u><u class="is-wa">💬 WhatsApp</u></span>
        </div>
        <div class="svi-panel" data-k="3">
          <span class="svi-p-t"><b>Tu apartado</b><em>Pagar en línea</em></span>
          <span class="svi-saldo"><small>Saldo</small><b>$2,312.00</b></span>
          <span class="svi-bots svi-bots--col"><u class="is-mp">Pagar con Mercado Pago</u><u>Pagar con tarjeta</u></span>
        </div>
        <div class="svi-panel" data-k="4">
          <span class="svi-p-t"><b>Live viernes de abrigos</b><em>Terminada</em></span>
          <span class="svi-nums">
            <span><b>$18,420</b><small>Vendido</small></span>
            <span><b>6</b><small>Apartados</small></span>
            <span><b>41 %</b><small>Conversión</small></span>
            <span><b>$2,302</b><small>Ticket promedio</small></span>
          </span>
          <small class="svi-ej">3 prendas regresaron al inventario · Ejemplo</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .svi { position: relative; background: #0B0B0C; color: #fff; }
  .svi-escena { position: relative; overflow: hidden; }
  .svi-foto { position: relative; aspect-ratio: 3 / 2; overflow: hidden; }
  .svi-foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  .svi-txt { padding: 36px 20px 8px; }
  .svi-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #F07FA6; }
  .svi-h { margin: 0; max-width: 14ch; color: #fff; font: 700 clamp(34px, 3.8vw, 58px)/0.98 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; text-wrap: balance; }
  .svi-pasos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.3); }
  .svi-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 4px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .svi-paso-n { font: 700 19px/1.2 var(--pd-clash, var(--font-display)); color: #F07FA6; }
  .svi-paso-t { display: grid; gap: 3px; }
  .svi-paso-t b { font: 700 16px/1.3 var(--font-display); color: #fff; }
  .svi-paso-t > span { font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.82); }
  .svi-barra { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .svi-barra b { display: block; height: 100%; background: #F07FA6; transform: scaleX(0); transform-origin: 0 50%; }

  /* ── la mesa (sin escena: el live y los cinco paneles en rejilla) ── */
  .svi-mesa { display: grid; gap: 16px; padding: 20px 20px 64px; font-size: 14px; }
  .svi-live { position: relative; display: grid; align-content: space-between; gap: 10px; width: min(100%, 15em); aspect-ratio: 9 / 16; padding: 0.9em; border-radius: 1.6em; background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.6)), url('/images/producto/social-commerce/live-900.webp') 64% 40% / cover; box-shadow: 0 0 0 0.45em #141416, 0 30px 60px -28px rgba(0, 0, 0, 0.9); overflow: hidden; }
  .svi-live-top { display: flex; align-items: center; gap: 0.5em; font: 700 0.78em/1 var(--font-display); }
  .svi-live-top em { padding: 0.35em 0.6em; border-radius: 0.4em; background: #E8344F; font-style: normal; letter-spacing: 0.06em; }
  .svi-live-top span { padding: 0.35em 0.6em; border-radius: 0.4em; background: rgba(0, 0, 0, 0.45); }
  .svi-comentarios { position: relative; display: block; height: 9.5em; overflow: hidden; -webkit-mask-image: linear-gradient(transparent, #000 35%); mask-image: linear-gradient(transparent, #000 35%); }
  .svi-c-riel { position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 0.45em; }
  .svi-c { display: block; padding: 0.4em 0.6em; border-radius: 0.7em; background: rgba(0, 0, 0, 0.42); font: 500 0.8em/1.3 var(--font-body); color: #fff; }
  .svi-c b { margin-right: 0.4em; font-weight: 700; }
  .svi-prenda { display: flex; justify-content: space-between; gap: 0.6em; padding: 0.6em 0.75em; border-radius: 0.8em; background: #fff; color: #141414; font: 700 0.85em/1.2 var(--font-display); }
  .svi-panel { display: grid; gap: 0.75em; align-content: start; width: 100%; max-width: 24em; padding: 1.15em 1.2em; border-radius: 1.1em; background: #fff; color: #141414; box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.85); }
  .svi-p-t { display: flex; align-items: center; justify-content: space-between; gap: 0.8em; }
  .svi-p-t b { font: 700 1.15em/1.2 var(--font-display); }
  .svi-p-t em { padding: 0.3em 0.6em; border-radius: 99px; background: #F2F3F6; color: #45433E; font: 700 0.75em/1.2 var(--font-display); font-style: normal; white-space: nowrap; }
  .svi-p-t em.svi-rojo { background: #FDE8EC; color: #C8233D; }
  .svi-r { display: grid; gap: 0.2em; padding: 0.55em 0.7em; border-radius: 0.6em; background: #F6F7F9; }
  .svi-r small { font: 600 0.72em/1.2 var(--font-display); color: #6B6A64; }
  .svi-r b { font: 700 0.92em/1.25 var(--font-display); }
  .svi-r2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5em; }
  .svi-tira { display: flex; justify-content: space-between; font: 600 0.8em/1.2 var(--font-display); color: #2F55C4; }
  .svi-tallas { display: flex; gap: 0.45em; }
  .svi-tallas i { display: grid; place-items: center; width: 2.6em; height: 2.6em; border-radius: 0.7em; background: #F2F3F6; font: 700 0.9em/1 var(--font-display); font-style: normal; }
  .svi-tallas i.is-on { background: #141414; color: #fff; }
  .svi-bots { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5em; }
  .svi-bots--col { grid-template-columns: 1fr; }
  .svi-bots u { display: grid; place-items: center; min-height: 2.8em; padding: 0 0.6em; border-radius: 0.7em; background: #F2F3F6; font: 700 0.82em/1.2 var(--font-display); text-align: center; text-decoration: none; }
  .svi-bots u.is-on { background: #2F55C4; color: #fff; }
  .svi-bots u.is-wa { background: #1FAF5A; color: #fff; }
  .svi-bots u.is-mp { background: #009EE3; color: #fff; }
  .svi-ok { justify-self: start; padding: 0.45em 0.7em; border-radius: 0.6em; background: #E3F4EA; color: #17804F; font: 700 0.82em/1.2 var(--font-display); }
  .svi-nota { font: 500 0.85em/1.4 var(--font-body); color: #55534E; }
  .svi-link { padding: 0.6em 0.75em; border-radius: 0.6em; background: #F6F7F9; font: 600 0.82em/1.2 'JetBrains Mono', ui-monospace, monospace; color: #2F55C4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .svi-saldo { display: flex; align-items: baseline; justify-content: space-between; padding: 0.6em 0.75em; border-radius: 0.6em; background: #FFF4E5; }
  .svi-saldo small { font: 600 0.8em/1.2 var(--font-display); color: #8A5A00; }
  .svi-saldo b { font: 700 1.3em/1 var(--pd-clash, var(--font-display)); color: #8A5A00; }
  .svi-nums { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5em; }
  .svi-nums > span { display: grid; gap: 0.15em; padding: 0.7em; border-radius: 0.7em; background: #F6F7F9; }
  .svi-nums b { font: 700 1.35em/1 var(--pd-clash, var(--font-display)); }
  .svi-nums small { font: 600 0.72em/1.2 var(--font-display); color: #6B6A64; }
  .svi-ej { font: 500 0.75em/1.3 var(--font-body); color: #8A8A85; }

  /* ══ con el scroll ══ */
  .svi.is-escena .svi-riel { height: 560vh; }
  .svi.is-escena .svi-escena { position: sticky; top: var(--sub, 0px); height: calc(100vh - var(--sub, 0px)); height: calc(100svh - var(--sub, 0px)); }
  .svi.is-escena .svi-foto { position: absolute; inset: 0; aspect-ratio: auto; }
  .svi.is-escena .svi-mesa { position: absolute; z-index: 3; display: block; padding: 0; }
  .svi.is-escena .svi-panel { position: absolute; opacity: 0; transform: translateY(24px) scale(0.96); transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .svi.is-escena[data-tramo="0"] .svi-panel[data-k="0"], .svi.is-escena[data-tramo="1"] .svi-panel[data-k="1"], .svi.is-escena[data-tramo="2"] .svi-panel[data-k="2"], .svi.is-escena[data-tramo="3"] .svi-panel[data-k="3"], .svi.is-escena[data-tramo="4"] .svi-panel[data-k="4"] { opacity: 1; transform: none; }
  .svi.is-escena .svi-c-riel { animation: sviSube 14s linear infinite; }
  @keyframes sviSube { from { transform: translateY(0); } to { transform: translateY(50%); } }
  .svi.is-escena[data-tramo="1"] .svi-ok { animation: sviOk 0.5s ease both 0.6s; }
  @keyframes sviOk { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .svi.is-escena .svi-paso-n { color: rgba(255, 255, 255, 0.45); }
  .svi.is-escena[data-tramo="0"] .svi-paso[data-k="0"] .svi-paso-n, .svi.is-escena[data-tramo="1"] .svi-paso[data-k="1"] .svi-paso-n, .svi.is-escena[data-tramo="2"] .svi-paso[data-k="2"] .svi-paso-n, .svi.is-escena[data-tramo="3"] .svi-paso[data-k="3"] .svi-paso-n, .svi.is-escena[data-tramo="4"] .svi-paso[data-k="4"] .svi-paso-n { color: #F07FA6; }
  .svi.is-escena[data-tramo="0"] .svi-paso[data-k="0"] .svi-barra b, .svi.is-escena[data-tramo="1"] .svi-paso[data-k="1"] .svi-barra b, .svi.is-escena[data-tramo="2"] .svi-paso[data-k="2"] .svi-barra b, .svi.is-escena[data-tramo="3"] .svi-paso[data-k="3"] .svi-barra b, .svi.is-escena[data-tramo="4"] .svi-paso[data-k="4"] .svi-barra b { animation: sviBarra 4.5s linear both; }
  @keyframes sviBarra { from { transform: scaleX(0); } to { transform: none; } }

  @media (min-width: 900px) {
    .svi:not(.is-escena) .svi-txt, .svi:not(.is-escena) .svi-mesa { max-width: 1160px; margin: 0 auto; }
    .svi:not(.is-escena) .svi-pasos { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
    .svi:not(.is-escena) .svi-mesa { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    .svi:not(.is-escena) .svi-foto { aspect-ratio: 21 / 9; }
    .svi.is-escena .svi-escena::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, rgba(8, 8, 10, 0.93) 0%, rgba(8, 8, 10, 0.72) 30%, rgba(8, 8, 10, 0.15) 58%, rgba(8, 8, 10, 0.35) 100%); }
    .svi.is-escena .svi-txt { position: absolute; left: 0; top: 50%; z-index: 4; width: min(36vw, 480px); padding: 0 0 0 4.4vw; transform: translateY(-50%); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
    .svi.is-escena .svi-paso-t > span { display: none; }
    .svi.is-escena[data-tramo="0"] .svi-paso[data-k="0"] .svi-paso-t > span, .svi.is-escena[data-tramo="1"] .svi-paso[data-k="1"] .svi-paso-t > span, .svi.is-escena[data-tramo="2"] .svi-paso[data-k="2"] .svi-paso-t > span, .svi.is-escena[data-tramo="3"] .svi-paso[data-k="3"] .svi-paso-t > span, .svi.is-escena[data-tramo="4"] .svi-paso[data-k="4"] .svi-paso-t > span { display: block; }
    /* la mesa a la derecha: el live abajo a la izquierda, el panel arriba a la derecha */
    .svi.is-escena .svi-mesa { right: 5vw; top: 12%; bottom: 8%; width: min(46vw, 640px); font-size: clamp(13px, 1.1vw, 16px); }
    .svi.is-escena .svi-live { position: absolute; left: 0; bottom: 0; width: 15em; }
    .svi.is-escena .svi-panel { right: 0; top: 0; width: 24em; }
  }
  @media (max-width: 899px) {
    .svi.is-escena .svi-riel { height: 480vh; }
    .svi.is-escena .svi-foto { bottom: auto; height: calc((100svh - var(--sub, 0px)) * 0.58); }
    .svi.is-escena .svi-foto::after { content: ''; position: absolute; inset: 0; background: rgba(8, 8, 10, 0.45); }
    .svi.is-escena .svi-mesa { left: 16px; right: 16px; top: 14px; height: calc((100svh - var(--sub, 0px)) * 0.58 - 28px); font-size: clamp(11px, 3.2vw, 13px); }
    .svi.is-escena .svi-live { position: absolute; left: 0; bottom: 0; width: 11em; }
    .svi.is-escena .svi-panel { right: 0; top: 0; width: min(21em, 74%); }
    .svi.is-escena .svi-txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 22px 20px 18px; background: linear-gradient(180deg, rgba(11, 11, 12, 0) 0, #0B0B0C 22px); }
    .svi.is-escena .svi-k { margin-bottom: 8px; }
    .svi.is-escena .svi-h { font-size: clamp(25px, 7.2vw, 34px); }
    .svi.is-escena .svi-pasos { margin-top: 10px; }
    .svi.is-escena .svi-paso { display: none; padding: 10px 0 8px; }
    .svi.is-escena[data-tramo="0"] .svi-paso[data-k="0"], .svi.is-escena[data-tramo="1"] .svi-paso[data-k="1"], .svi.is-escena[data-tramo="2"] .svi-paso[data-k="2"], .svi.is-escena[data-tramo="3"] .svi-paso[data-k="3"], .svi.is-escena[data-tramo="4"] .svi-paso[data-k="4"] { display: grid; }
    .svi:not(.is-escena) .svi-mesa { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svi * { animation: none !important; transition: none !important; }
  }
</style>
