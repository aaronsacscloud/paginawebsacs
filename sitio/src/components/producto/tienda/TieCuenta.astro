---
/**
 * «Su cuenta, con todo lo suyo» (/producto/tienda-en-linea): la cuenta de la clienta. El celular con la pantalla REAL de
 * la tienda demo al pasar a pagar («Antes de continuar»: acumulas puntos, sigues tu pedido, facturas cuando quieras;
 * entrar, crear cuenta o seguir como invitada) y, al lado, el menú real de su cuenta, que se va armando renglón por
 * renglón al verse. Entrada: el teléfono gira desde atrás hasta quedar de frente. Marfil.
 */
import { CUENTA, I } from '../../../data/producto-tienda';
const ICONOS = ['📦', '🧾', '✨', '👛', '💎', '📄', '🧮', '♡', '🎟', '👤'];
---
<section class="pda tcu pd-marfil" id="tie-cuenta" aria-labelledby="tcu-h">
  <p class="pd-folio"><span>{CUENTA.k}</span><span>Mi cuenta</span></p>
  <div class="tcu-grid">
    <div class="tcu-cel rv">
      <span class="tcu-marco"><img src={`${I}pantalla-cuenta.webp`} width="780" height="1688" alt="Al pasar a pagar en la tienda: «Antes de continuar», con lo que gana con cuenta (acumula puntos, sigue su pedido, se factura cuando quiere) y las opciones Entrar, Crear cuenta o Continuar como invitado" loading="lazy" decoding="async" /></span>
    </div>
    <div class="tcu-lado">
      <h2 class="pda-h" id="tcu-h">{CUENTA.h}</h2>
      <p class="tcu-p">{CUENTA.p}</p>
      <ul class="tcu-menu">
        {CUENTA.menu.map((x, i) => <li class="rv" style={`--i:${i}`}><span aria-hidden="true">{ICONOS[i]}</span>{x}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .tcu-grid { display: grid; gap: 36px; margin-top: 8px; }
  .tcu-cel { justify-self: center; width: min(300px, 78%); perspective: 1400px; }
  .tcu-marco { display: block; overflow: hidden; border: 10px solid #141416; border-radius: 40px; background: #fff; box-shadow: 0 40px 70px -36px rgba(20, 20, 20, 0.6); aspect-ratio: 780 / 1688; }
  .tcu-marco img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .tcu-lado { display: grid; gap: 16px; align-content: start; }
  .tcu-p { margin: 0; max-width: 46ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .tcu-menu { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 10px 0 0; padding: 0; list-style: none; }
  .tcu-menu li { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px rgba(20, 20, 20, 0.06); font: 600 15px/1.2 var(--font-display); color: #141414; }
  .tcu-menu li span { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 9px; background: #F2EEE6; font-size: 15px; }
  :global(.js-rv) .tcu-cel.rv { opacity: 0; transform: rotateY(-32deg) translateX(-30px); transform-origin: 100% 50%; transition: opacity 0.7s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js-rv) .tcu-cel.rv.is-on { opacity: 1; transform: none; }
  :global(.js-rv) .tcu-menu .rv { opacity: 0; transform: translateY(10px) scale(0.97); transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.06s + 0.2s); }
  :global(.js-rv) .tcu-menu .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .tcu-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 6vw; align-items: center; }
    .tcu-cel { width: min(330px, 100%); }
  }
  @media (max-width: 380px) {
    .tcu-menu { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .tcu .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
