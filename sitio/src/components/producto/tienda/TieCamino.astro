---
/**
 * «Del clic a sus manos» (/producto/tienda-en-linea): una compra en la tienda en línea con el scroll (data-tramos="5").
 * Arriba, una ruta con cinco paradas (elige, paga, se separa, recoge, envío) por la que avanza la bolsa con el scroll;
 * al fondo, la foto de cada momento (gpt-image-2.5: la clienta en su cama de noche, la dueña con su laptop, la entrega en
 * el mostrador, la paquetería en la puerta) y, a la derecha, el celular con la pantalla REAL de la tienda de la cuenta
 * demo en cada paso (tallas con su existencia, el pago, la fecha de recolección, la entrega). En «se separa» va la
 * tarjeta del pedido como llega a Pedidos y en «recoge», el código para mostrador (dibujados con sus textos reales).
 * Sin JS o con «reducir movimiento»: los pasos en lista, cada uno con su pantalla.
 */
import { CAMINO, I } from '../../../data/producto-tienda';
const FOTOS = [
  { f: 'noche', alt: 'De noche, una clienta compra desde su celular en su cama' },
  { f: 'duena', alt: '' },
  { f: 'recoge', alt: '' },
  { f: 'envio', alt: '' },
];
const P = CAMINO.pedido;
---
<section class="tca" id="tie-camino" data-escena data-tramos="5" data-tramo="4" data-foto="envio" aria-labelledby="tca-h">
  <div class="tca-riel" data-riel>
    <div class="tca-escena">
      <div class="tca-fotos">
        {FOTOS.map((x, i) => (
          <img class="tca-foto" data-f={x.f} src={`${I}${x.f}-1280.webp`} srcset={`${I}${x.f}-900.webp 900w, ${I}${x.f}-1280.webp 1280w, ${I}${x.f}-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" alt={x.alt} aria-hidden={i === 0 ? undefined : 'true'} loading="lazy" decoding="async" />
        ))}
      </div>

      <div class="tca-ruta" aria-hidden="true">
        <span class="tca-linea"><i></i></span>
        <span class="tca-bolsa">🛍</span>
        {CAMINO.paradas.map((p, k) => <span class="tca-parada" data-k={k} style={`--x:${k * 25}%`}><i></i><b>{p}</b></span>)}
      </div>

      <div class="tca-mesa" aria-hidden="true">
        {CAMINO.tramos.map((t, k) => t.img ? (
          <div class="tca-carta tca-carta--cel" data-k={k} data-estado={k === 4 ? 'ahora' : 'antes'}>
            <span class="tca-cel"><img src={t.img} width="780" height="1688" alt="" loading="lazy" decoding="async" /></span>
            {k === 3 && (
              <span class="tca-qr">
                <small>Códigos para mostrador</small>
                <span class="tca-qr-cod"><i></i></span>
                <span class="tca-barras"></span>
                <b>PEDIDO-41</b>
              </span>
            )}
          </div>
        ) : (
          <div class="tca-carta" data-k={k} data-estado="antes">
            <span class="tca-pedido">
              <span class="tca-p-cab"><b>Pedido {P.folio}</b><em>● Pagado</em></span>
              <span class="tca-p-canal">🌐 {P.canal}</span>
              <span class="tca-p-prenda"><span>{P.prenda}</span><b>{P.total}</b></span>
              <span class="tca-p-recoge">{P.recoge}</span>
              <span class="tca-p-stock"><small>Existencia en Polanco · talla L</small><span class="tca-p-num"><s>1</s><b>0</b></span><small>apartada para este pedido</small></span>
            </span>
          </div>
        ))}
      </div>

      <div class="tca-txt">
        <p class="tca-k">{CAMINO.k}</p>
        <h2 class="tca-h" id="tca-h">{CAMINO.h}</h2>
        <ol class="tca-pasos">
          {CAMINO.tramos.map((p, k) => (
            <li class="tca-paso" data-k={k}>
              <span class="tca-paso-n">{p.n}</span>
              <span class="tca-paso-t"><b>{p.t}</b><span>{p.d}</span></span>
              <i class="tca-barra" aria-hidden="true"><b></b></i>
              {p.img && <figure class="tca-quieta"><img src={p.img} width="780" height="1688" alt={p.alt} loading="lazy" decoding="async" /></figure>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .tca { position: relative; background: #0B0B0C; color: #fff; }
  .tca-escena { position: relative; overflow: hidden; }
  .tca-fotos { position: relative; aspect-ratio: 3 / 2; overflow: hidden; }
  .tca-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 40%; opacity: 0; transition: opacity 1s ease; }
  .tca-foto[data-f="noche"] { opacity: 1; }
  .tca-ruta, .tca-mesa { display: none; }
  .tca-txt { padding: 36px 20px 56px; }
  .tca-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #9DB8F5; }
  .tca-h { margin: 0; max-width: 14ch; color: #fff; font: 700 clamp(34px, 3.8vw, 58px)/0.98 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; text-wrap: balance; }
  .tca-pasos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.3); }
  .tca-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 4px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .tca-paso-n { font: 700 19px/1.2 var(--pd-clash, var(--font-display)); color: #9DB8F5; }
  .tca-paso-t { display: grid; gap: 3px; }
  .tca-paso-t b { font: 700 16px/1.3 var(--font-display); color: #fff; }
  .tca-paso-t > span { font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.82); }
  .tca-barra { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .tca-barra b { display: block; height: 100%; background: #5B86EA; transform: scaleX(0); transform-origin: 0 50%; }
  .tca-quieta { grid-column: 1 / -1; justify-self: center; width: min(260px, 70%); margin: 12px 0 0; overflow: hidden; border: 7px solid #141416; border-radius: 26px; background: #fff; }
  .tca-quieta img { display: block; width: 100%; height: auto; }

  /* ── el pedido y el código para mostrador (dibujados) ── */
  .tca-pedido { display: grid; gap: 0.7em; width: min(100%, 22em); padding: 1.2em 1.25em; border-radius: 1.1em; background: #fff; color: #141414; box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.85); font-size: 15px; }
  .tca-p-cab { display: flex; align-items: center; justify-content: space-between; gap: 0.8em; }
  .tca-p-cab b { font: 700 1.15em/1.2 var(--font-display); }
  .tca-p-cab em { padding: 0.3em 0.6em; border-radius: 99px; background: #E3F4EA; color: #17804F; font: 700 0.75em/1.2 var(--font-display); font-style: normal; }
  .tca-p-canal { justify-self: start; padding: 0.35em 0.7em; border-radius: 0.5em; background: #EEF2FD; color: #2F55C4; font: 700 0.8em/1.2 var(--font-display); }
  .tca-p-prenda { display: flex; justify-content: space-between; gap: 1em; padding: 0.7em 0; border-top: 1px solid #ECEDEF; border-bottom: 1px solid #ECEDEF; font: 600 0.9em/1.3 var(--font-display); }
  .tca-p-recoge { font: 600 0.85em/1.3 var(--font-display); color: #6B6A64; }
  .tca-p-stock { display: grid; gap: 0.3em; padding: 0.8em; border-radius: 0.8em; background: #F6F7F9; }
  .tca-p-stock small { font: 600 0.75em/1.2 var(--font-display); color: #6B6A64; }
  .tca-p-num { display: flex; align-items: baseline; gap: 0.6em; font: 700 1.8em/1 var(--pd-clash, var(--font-display)); }
  .tca-p-num s { color: #B4B2AC; }
  .tca-p-num b { color: #2F55C4; }
  .tca-qr { position: absolute; left: -6.5em; bottom: 8%; display: grid; justify-items: center; gap: 0.5em; width: 9.5em; padding: 0.9em 0.8em; border-radius: 1em; background: #fff; color: #141414; box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.8); font-size: 15px; }
  .tca-qr small { font: 700 0.65em/1.2 var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; color: #6B6A64; text-align: center; }
  .tca-qr-cod { position: relative; width: 6.4em; height: 6.4em; background: conic-gradient(from 90deg, #141414 25%, #fff 0 50%, #141414 0 75%, #fff 0) 0 0 / 0.8em 0.8em; }
  .tca-qr-cod::before, .tca-qr-cod::after, .tca-qr-cod i { content: ''; position: absolute; width: 1.9em; height: 1.9em; border: 0.38em solid #141414; background: #fff; box-shadow: inset 0 0 0 0.3em #fff, inset 0 0 0 1em #141414; }
  .tca-qr-cod::before { left: 0; top: 0; }
  .tca-qr-cod::after { right: 0; top: 0; }
  .tca-qr-cod i { left: 0; bottom: 0; }
  .tca-barras { width: 7em; height: 1.6em; background: repeating-linear-gradient(90deg, #141414 0 2px, #fff 2px 4px, #141414 4px 5px, #fff 5px 8px); }
  .tca-qr b { font: 700 0.8em/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.06em; }

  /* ══ con el scroll ══ */
  .tca.is-escena .tca-riel { height: 560vh; }
  .tca.is-escena .tca-escena { position: sticky; top: var(--sub, 0px); height: calc(100vh - var(--sub, 0px)); height: calc(100svh - var(--sub, 0px)); }
  .tca.is-escena .tca-fotos { position: absolute; inset: 0; aspect-ratio: auto; }
  .tca.is-escena .tca-foto { opacity: 0; transform: scale(1.05); transition: opacity 1s ease, transform 5s ease-out; }
  .tca.is-escena[data-foto="noche"] .tca-foto[data-f="noche"], .tca.is-escena[data-foto="duena"] .tca-foto[data-f="duena"], .tca.is-escena[data-foto="recoge"] .tca-foto[data-f="recoge"], .tca.is-escena[data-foto="envio"] .tca-foto[data-f="envio"] { opacity: 1; transform: none; }
  .tca.is-escena .tca-quieta { display: none; }
  .tca.is-escena .tca-mesa { position: absolute; z-index: 3; display: block; }
  .tca.is-escena .tca-carta { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; transition: opacity 0.5s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
  .tca.is-escena .tca-carta[data-estado="antes"] { opacity: 0; transform: translateX(-18%) scale(0.94); }
  .tca.is-escena .tca-carta[data-estado="despues"] { opacity: 0; transform: translateX(18%) scale(0.94); }
  .tca.is-escena .tca-carta[data-estado="ahora"] { opacity: 1; transform: none; }
  .tca-cel { position: relative; display: block; height: 100%; aspect-ratio: 780 / 1688; overflow: hidden; border: 9px solid #141416; border-radius: 34px; background: #fff; box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.9); }
  .tca-cel img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .tca.is-escena .tca-carta[data-estado="ahora"] .tca-qr { animation: tcaQr 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both 0.5s; }
  @keyframes tcaQr { from { opacity: 0; transform: translateY(20px) rotate(-6deg) scale(0.9); } to { opacity: 1; transform: none; } }
  .tca.is-escena .tca-carta[data-estado="ahora"] .tca-p-num s { animation: tcaTacha 0.5s ease both 0.5s; }
  .tca.is-escena .tca-carta[data-estado="ahora"] .tca-p-num b { animation: tcaBaja 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both 0.9s; }
  @keyframes tcaTacha { from { color: #141414; text-decoration-color: transparent; } to { color: #B4B2AC; } }
  @keyframes tcaBaja { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: none; } }

  /* la ruta: cinco paradas y la bolsa que avanza con el scroll */
  .tca.is-escena .tca-ruta { position: absolute; z-index: 4; display: block; height: 46px; }
  .tca-linea { position: absolute; left: 0; right: 0; top: 13px; height: 2px; border-radius: 2px; background: rgba(255, 255, 255, 0.25); overflow: hidden; }
  .tca-linea i { display: block; height: 100%; background: #9DB8F5; transform: scaleX(var(--p, 1)); transform-origin: 0 50%; }
  .tca-bolsa { position: absolute; top: 0; left: calc(var(--p, 1) * 100%); display: grid; place-items: center; width: 28px; height: 28px; margin-left: -14px; border-radius: 50%; background: #fff; font-size: 14px; box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.6); }
  .tca-parada { position: absolute; top: 9px; left: var(--x); display: grid; justify-items: center; gap: 8px; transform: translateX(-50%); }
  .tca-parada i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.35); box-shadow: 0 0 0 3px rgba(11, 11, 12, 0.6); transition: background 0.3s ease; }
  .tca-parada b { font: 700 11.5px/1 var(--font-display); color: rgba(255, 255, 255, 0.6); white-space: nowrap; transition: color 0.3s ease; }
  .tca.is-escena[data-tramo="0"] .tca-parada[data-k="0"] i, .tca.is-escena[data-tramo="1"] .tca-parada:is([data-k="0"], [data-k="1"]) i, .tca.is-escena[data-tramo="2"] .tca-parada:is([data-k="0"], [data-k="1"], [data-k="2"]) i, .tca.is-escena[data-tramo="3"] .tca-parada:not([data-k="4"]) i, .tca.is-escena[data-tramo="4"] .tca-parada i { background: #9DB8F5; }
  .tca.is-escena[data-tramo="0"] .tca-parada[data-k="0"] b, .tca.is-escena[data-tramo="1"] .tca-parada[data-k="1"] b, .tca.is-escena[data-tramo="2"] .tca-parada[data-k="2"] b, .tca.is-escena[data-tramo="3"] .tca-parada[data-k="3"] b, .tca.is-escena[data-tramo="4"] .tca-parada[data-k="4"] b { color: #fff; }

  .tca.is-escena .tca-paso-n { color: rgba(255, 255, 255, 0.45); }
  .tca.is-escena[data-tramo="0"] .tca-paso[data-k="0"] .tca-paso-n, .tca.is-escena[data-tramo="1"] .tca-paso[data-k="1"] .tca-paso-n, .tca.is-escena[data-tramo="2"] .tca-paso[data-k="2"] .tca-paso-n, .tca.is-escena[data-tramo="3"] .tca-paso[data-k="3"] .tca-paso-n, .tca.is-escena[data-tramo="4"] .tca-paso[data-k="4"] .tca-paso-n { color: #9DB8F5; }
  .tca.is-escena[data-tramo="0"] .tca-paso[data-k="0"] .tca-barra b, .tca.is-escena[data-tramo="1"] .tca-paso[data-k="1"] .tca-barra b, .tca.is-escena[data-tramo="2"] .tca-paso[data-k="2"] .tca-barra b, .tca.is-escena[data-tramo="3"] .tca-paso[data-k="3"] .tca-barra b, .tca.is-escena[data-tramo="4"] .tca-paso[data-k="4"] .tca-barra b { animation: tcaBarra 4.5s linear both; }
  @keyframes tcaBarra { from { transform: scaleX(0); } to { transform: none; } }

  @media (min-width: 900px) {
    .tca:not(.is-escena) .tca-pasos { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
    .tca:not(.is-escena) .tca-txt { max-width: 1160px; margin: 0 auto; }
    .tca:not(.is-escena) .tca-fotos { aspect-ratio: 21 / 9; }
    .tca.is-escena .tca-escena::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, rgba(8, 8, 10, 0.93) 0%, rgba(8, 8, 10, 0.72) 30%, rgba(8, 8, 10, 0.25) 58%, rgba(8, 8, 10, 0.45) 100%); }
    .tca.is-escena .tca-txt { position: absolute; left: 0; top: 54%; z-index: 4; width: min(36vw, 480px); padding: 0 0 0 4.4vw; transform: translateY(-50%); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
    .tca.is-escena .tca-paso-t > span { display: none; }
    .tca.is-escena[data-tramo="0"] .tca-paso[data-k="0"] .tca-paso-t > span, .tca.is-escena[data-tramo="1"] .tca-paso[data-k="1"] .tca-paso-t > span, .tca.is-escena[data-tramo="2"] .tca-paso[data-k="2"] .tca-paso-t > span, .tca.is-escena[data-tramo="3"] .tca-paso[data-k="3"] .tca-paso-t > span, .tca.is-escena[data-tramo="4"] .tca-paso[data-k="4"] .tca-paso-t > span { display: block; }
    .tca.is-escena .tca-ruta { left: 4.4vw; right: 5vw; top: 5%; }
    .tca.is-escena .tca-mesa { right: 9vw; top: 15%; bottom: 6%; width: min(36vw, 520px); }
  }
  @media (max-width: 899px) {
    .tca.is-escena .tca-riel { height: 480vh; }
    .tca.is-escena .tca-fotos { bottom: auto; height: calc((100svh - var(--sub, 0px)) * 0.58); }
    .tca.is-escena .tca-fotos::after { content: ''; position: absolute; inset: 0; background: rgba(8, 8, 10, 0.5); }
    .tca.is-escena .tca-ruta { left: 28px; right: 28px; top: 10px; }
    .tca.is-escena .tca-parada b { font-size: 10px; }
    .tca.is-escena .tca-mesa { left: 16px; right: 16px; top: 58px; height: calc((100svh - var(--sub, 0px)) * 0.58 - 70px); }
    .tca.is-escena .tca-cel { border-width: 6px; border-radius: 22px; }
    .tca.is-escena .tca-qr { left: 0; bottom: 4%; font-size: 11px; }
    .tca.is-escena .tca-pedido { font-size: 12.5px; }
    .tca.is-escena .tca-txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 22px 20px 18px; background: linear-gradient(180deg, rgba(11, 11, 12, 0) 0, #0B0B0C 22px); }
    .tca.is-escena .tca-k { margin-bottom: 8px; }
    .tca.is-escena .tca-h { font-size: clamp(25px, 7.2vw, 34px); }
    .tca.is-escena .tca-pasos { margin-top: 10px; }
    .tca.is-escena .tca-paso { display: none; padding: 10px 0 8px; }
    .tca.is-escena[data-tramo="0"] .tca-paso[data-k="0"], .tca.is-escena[data-tramo="1"] .tca-paso[data-k="1"], .tca.is-escena[data-tramo="2"] .tca-paso[data-k="2"], .tca.is-escena[data-tramo="3"] .tca-paso[data-k="3"], .tca.is-escena[data-tramo="4"] .tca-paso[data-k="4"] { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tca * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  // El paso de cada carta (antes / ahora / después) y la foto de cada momento. Lee data-tramo de iniciaEscenas; --p
  // (que mueve la ruta) ya lo pone ese mismo script en la sección.
  (() => {
    const sec = document.querySelector<HTMLElement>('.tca');
    if (!sec) return;
    const cartas = Array.from(sec.querySelectorAll<HTMLElement>('.tca-carta'));
    const fotos = ['noche', 'noche', 'duena', 'recoge', 'envio'];
    let ultimo = -1;
    const pinta = () => {
      const t = Number(sec.dataset.tramo || 0);
      if (t === ultimo) return;
      ultimo = t;
      cartas.forEach((c) => { const k = Number(c.dataset.k); c.dataset.estado = k < t ? 'antes' : k === t ? 'ahora' : 'despues'; });
      sec.dataset.foto = fotos[t] || 'envio';
    };
    new MutationObserver(pinta).observe(sec, { attributes: true, attributeFilter: ['data-tramo', 'class'] });
    pinta();
  })();
</script>
