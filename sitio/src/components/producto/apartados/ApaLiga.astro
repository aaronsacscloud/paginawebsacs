---
/**
 * «Su apartado, en su bolsillo» (/producto/apartados-y-pedidos): la liga pública del apartado. La foto de la clienta
 * con su celular en un café (gpt-image-2.5) y, encima, un teléfono con la página REAL del apartado APA-POL-1 (cuenta
 * demo, nombre de ejemplo) que se recorre sola mientras se ve: estado, tiempo restante, seguimiento, prendas,
 * movimientos de inventario y comprobantes. Entrada: el teléfono sube enderezándose. A un lado, lo que trae la liga.
 * Blanco.
 */
import { LIGA, I } from '../../../data/producto-apartados';
---
<section class="pda ali" id="apa-liga" aria-labelledby="ali-h">
  <p class="pd-folio"><span>{LIGA.k}</span><span>Lo que ve tu clienta</span></p>
  <div class="ali-grid">
    <div class="ali-escena" data-ali>
      <figure class="ali-foto">
        <img src={`${I}telefono-1280.webp`} srcset={`${I}telefono-900.webp 900w, ${I}telefono-1280.webp 1280w`} sizes="(min-width: 900px) 52vw, 100vw" width="1280" height="853" alt="Una clienta revisa su apartado en el celular mientras toma un café" loading="lazy" decoding="async" />
      </figure>
      <div class="ali-cel rv" role="img" aria-label="La liga del apartado APA-POL-1 en el celular: apartado vigente, saldo de $2,784, 12 días restantes, el seguimiento, sus dos prendas, la mercancía reservada y el comprobante del anticipo de $696">
        <span class="ali-pantalla"><img src={`${I}pantalla-liga-completa.webp`} width="780" height="3560" alt="" loading="lazy" decoding="async" /></span>
      </div>
    </div>
    <div class="ali-lado">
      <h2 class="pda-h" id="ali-h">{LIGA.h}</h2>
      <p class="ali-p">{LIGA.p}</p>
      <ul class="ali-puntos">
        {LIGA.puntos.map((x, i) => <li class="rv" style={`--i:${i}`}><b>{x.t}</b><span>{x.d}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .ali { background: #fff; color: #141414; --pd-texto: #141414; --pd-tenue: #45433E; --pd-filete: rgba(20, 20, 20, 0.16); }
  .ali-grid { display: grid; gap: 36px; margin-top: 8px; }
  .ali-escena { position: relative; padding-bottom: 64px; }
  .ali-foto { margin: 0; overflow: hidden; border-radius: 22px; aspect-ratio: 4 / 3; }
  .ali-foto img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%; }
  .ali-cel { position: absolute; right: 14px; bottom: 0; width: min(46%, 230px); aspect-ratio: 9 / 18.6; overflow: hidden; border: 8px solid #141416; border-radius: 34px; background: #fff; box-shadow: 0 30px 50px -24px rgba(0, 0, 0, 0.6); }
  .ali-pantalla { position: absolute; inset: 0; overflow: hidden; }
  .ali-pantalla img { display: block; width: 100%; height: auto; }
  /* mientras se ve, la página baja sola hasta los comprobantes y regresa */
  .ali-escena.is-on .ali-pantalla img { animation: aliBaja 16s cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite; }
  @keyframes aliBaja { 0%, 8% { transform: translateY(0); } 46%, 58% { transform: translateY(calc(-100% + var(--alto, 420px))); } 96%, 100% { transform: translateY(0); } }
  .ali-lado { display: grid; gap: 16px; align-content: start; }
  .ali-p { margin: 0; max-width: 44ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .ali-puntos { display: grid; gap: 0; margin: 8px 0 0; padding: 0; list-style: none; border-top: 2px solid #141414; }
  .ali-puntos li { display: grid; gap: 3px; padding: 13px 0; border-bottom: 1px solid var(--pd-filete); }
  .ali-puntos b { font: 700 16.5px/1.25 var(--font-display); }
  .ali-puntos span { font: 500 14.5px/1.45 var(--font-body); color: var(--pd-tenue); }
  /* entrada: el teléfono sube enderezándose; los renglones, escalonados */
  :global(.js-rv) .ali-cel.rv { opacity: 0; transform: translateY(70px) rotate(7deg); transform-origin: 50% 100%; transition: opacity 0.7s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js-rv) .ali-cel.rv.is-on { opacity: 1; transform: none; }
  :global(.js-rv) .ali-puntos .rv { opacity: 0; transform: translateY(14px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i, 0) * 0.07s + 0.15s); }
  :global(.js-rv) .ali-puntos .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .ali-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 5vw; align-items: center; }
    .ali-escena { padding: 0 0 0 0; }
    .ali-foto { width: 82%; aspect-ratio: 4 / 4.4; }
    .ali-cel { right: 0; bottom: -28px; width: min(42%, 270px); border-width: 10px; border-radius: 40px; }
    .ali-puntos { grid-template-columns: 1fr 1fr; column-gap: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ali-escena.is-on .ali-pantalla img { animation: none; }
    :global(.js-rv) .ali .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // La página del teléfono se recorre sola mientras la escena está a la vista (y se detiene fuera de ella). --alto es la
  // altura visible de la pantalla, para que el recorrido termine justo en el último comprobante.
  (() => {
    const el = document.querySelector<HTMLElement>('[data-ali]');
    const pan = el?.querySelector<HTMLElement>('.ali-pantalla');
    if (!el || !pan || !('IntersectionObserver' in window)) return;
    const mide = () => el.style.setProperty('--alto', Math.round(pan.getBoundingClientRect().height) + 'px');
    new ResizeObserver(mide).observe(pan);
    new IntersectionObserver((es) => es.forEach((e) => el.classList.toggle('is-on', e.isIntersecting)), { threshold: 0.3 }).observe(el);
  })();
</script>
