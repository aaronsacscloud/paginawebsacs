---
/**
 * «Vende la talla que no tienes» (/producto/apartados-y-pedidos): la venta sobre pedido. Cuatro pasos unidos por una
 * línea que se dibuja al verse (lo vendes → lo pides → llega y se aparta → le avisamos), cada punto se enciende cuando
 * la línea lo alcanza, y al final el correo que recibe la clienta con su asunto real («¡Tu mercancía ya llegó!»).
 * Fucsia.
 */
import { SOBRE } from '../../../data/producto-apartados';
---
<section class="pda aso pd-fucsia" id="ped-sobre" aria-labelledby="aso-h">
  <p class="pd-folio"><span>{SOBRE.k}</span><span>Venta sobre pedido</span></p>
  <div class="aso-cab">
    <h2 class="pda-h" id="aso-h">{SOBRE.h}</h2>
    <p class="aso-p">{SOBRE.p}</p>
  </div>
  <div class="aso-ruta" data-aso>
    <svg class="aso-linea" viewBox="0 0 1000 20" preserveAspectRatio="none" aria-hidden="true"><path d="M0 10 H1000" pathLength="1" /></svg>
    <ol>
      {SOBRE.pasos.map((x, i) => (
        <li style={`--i:${i}`}>
          <span class="aso-punto" aria-hidden="true">{i + 1}</span>
          <b>{x.t}</b>
          <span>{x.d}</span>
        </li>
      ))}
    </ol>
  </div>
  <div class="aso-pie">
    <div class="aso-correo rv" role="img" aria-label="El correo que le llega a la clienta: ¡Tu mercancía ya llegó!">
      <span class="aso-c-de"><i aria-hidden="true">P</i><span><b>Polanco Boutique</b><small>para Fernanda</small></span></span>
      <b class="aso-c-asunto">¡Tu mercancía ya llegó!</b>
      <span class="aso-c-l"></span><span class="aso-c-l aso-c-l--b"></span>
      <span class="aso-c-prenda"><span aria-hidden="true">📦</span>Blazer sastre cruzado · M · Beige</span>
    </div>
    <p class="aso-nota">{SOBRE.nota}</p>
  </div>
</section>

<style>
  .aso-cab { display: grid; gap: 14px; }
  .aso-p { margin: 0; max-width: 48ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .aso-ruta { position: relative; margin-top: 44px; }
  .aso-linea { display: none; }
  .aso-ruta ol { display: grid; gap: 22px; margin: 0; padding: 0; list-style: none; }
  .aso-ruta li { position: relative; display: grid; grid-template-columns: 44px 1fr; column-gap: 14px; row-gap: 4px; }
  .aso-punto { grid-row: span 2; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #D03A70; font: 700 18px/1 var(--pd-clash); transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease; }
  .aso-ruta li b { font: 700 19px/1.2 var(--font-display); color: #fff; }
  .aso-ruta li > span:last-child { font: 500 15px/1.5 var(--font-body); color: rgba(255, 255, 255, 0.92); }
  /* teléfono: una línea vertical entre los puntos */
  .aso-ruta li:not(:last-child)::after { content: ''; position: absolute; left: 21px; top: 48px; bottom: -20px; width: 2px; background: rgba(255, 255, 255, 0.45); }
  :global(.js-rv) .aso-ruta li { opacity: 0.35; transition: opacity 0.5s ease; transition-delay: calc(var(--i) * 0.45s + 0.2s); }
  :global(.js-rv) .aso-ruta li .aso-punto { transform: scale(0.7); transition-delay: calc(var(--i) * 0.45s + 0.2s); }
  .aso-ruta.is-on li { opacity: 1 !important; }
  .aso-ruta.is-on .aso-punto { transform: none !important; box-shadow: 0 0 0 7px rgba(255, 255, 255, 0.22); }
  .aso-pie { display: grid; gap: 22px; margin-top: 44px; }
  .aso-correo { display: grid; gap: 10px; width: min(100%, 420px); padding: 18px 20px 20px; border-radius: 18px; background: #fff; color: #141414; box-shadow: 0 24px 44px -24px rgba(0, 0, 0, 0.45); }
  .aso-c-de { display: flex; align-items: center; gap: 10px; }
  .aso-c-de i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #141414; color: #fff; font: 700 14px/1 var(--font-display); font-style: normal; }
  .aso-c-de span { display: grid; }
  .aso-c-de b { font: 700 14px/1.2 var(--font-display); }
  .aso-c-de small { font: 500 12px/1.3 var(--font-body); color: #6B6A64; }
  .aso-c-asunto { font: 700 21px/1.15 var(--font-display); }
  .aso-c-l { height: 7px; border-radius: 4px; background: #ECEDEF; }
  .aso-c-l--b { width: 70%; }
  .aso-c-prenda { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 12px; background: #FFF4E5; color: #8A5A00; font: 600 13.5px/1.3 var(--font-display); }
  .aso-nota { margin: 0; max-width: 40ch; font: 600 16px/1.5 var(--font-display); color: #fff; }
  :global(.js-rv) .aso-correo.rv { opacity: 0; transform: translateY(30px) rotate(-3deg); transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 0.3s; }
  :global(.js-rv) .aso-correo.rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .aso-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .aso-ruta { margin-top: 64px; }
    /* escritorio: una línea horizontal que se dibuja del primer punto al último (4 columnas, 28 px de hueco) */
    .aso-linea { position: absolute; left: 22px; top: 12px; display: block; width: calc(75% + 21px); height: 20px; overflow: visible; }
    .aso-linea path { fill: none; stroke: rgba(255, 255, 255, 0.85); stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; transition: stroke-dashoffset 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.2s; }
    .aso-ruta.is-on .aso-linea path { stroke-dashoffset: 0; }
    :global(html:not(.js-rv)) .aso-linea path { stroke-dashoffset: 0; }
    .aso-ruta ol { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
    .aso-ruta li { grid-template-columns: 1fr; row-gap: 8px; }
    .aso-punto { grid-row: auto; margin-bottom: 8px; }
    .aso-ruta li:not(:last-child)::after { display: none; }
    .aso-pie { grid-template-columns: auto 1fr; align-items: center; gap: 5vw; margin-top: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .aso-ruta li, :global(.js-rv) .aso-ruta li .aso-punto, .aso-linea path { opacity: 1; transform: none; transition: none; stroke-dashoffset: 0; }
    :global(.js-rv) .aso-correo.rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // La línea se dibuja y los puntos se encienden la primera vez que la ruta se ve.
  (() => {
    const el = document.querySelector<HTMLElement>('[data-aso]');
    if (!el) return;
    if (!('IntersectionObserver' in window)) { el.classList.add('is-on'); return; }
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { el.classList.add('is-on'); io.disconnect(); } }, { threshold: 0.4 });
    io.observe(el);
  })();
</script>
