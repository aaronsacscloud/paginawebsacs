---
/**
 * «Las reglas las pones tú» (/producto/apartados-y-pedidos): las opciones REALES de Configuración › Apartados (anticipo
 * mínimo, tiempo límite en horas o días, qué pasa al vencer, plan de abonos, mora y prórrogas, momento de la venta)
 * dichas como frases grandes. El valor de cada frase va en una pastilla que se cambia sola, como si alguien estuviera
 * probando opciones (una frase a la vez, mientras la sección se ve). Sin JS, cada frase con su primer valor. Azul.
 */
import { REGLAS } from '../../../data/producto-apartados';
---
<section class="pda are pd-azul" id="apa-reglas" aria-labelledby="are-h">
  <div class="pda-fondo" aria-hidden="true"><span>TUS REGLAS · TUS REGLAS</span><span>TUS REGLAS · TUS REGLAS</span></div>
  <p class="pd-folio"><span>{REGLAS.k}</span><span>Una vez, para todas tus sucursales</span></p>
  <div class="are-cab">
    <h2 class="pda-h" id="are-h">{REGLAS.h}</h2>
    <p class="are-p">{REGLAS.p}</p>
  </div>
  <ol class="are-frases" data-are>
    {REGLAS.frases.map((f, i) => (
      <li class="rv" style={`--i:${i}`}>
        <span class="are-n">{String(i + 1).padStart(2, '0')}</span>
        <p>
          {f.antes}{' '}
          <span class="are-valor" data-valores={JSON.stringify(f.valores)}><span class="are-v">{f.valores[0]}</span></span>
          {f.despues !== '.' && ' ' + f.despues}
        </p>
      </li>
    ))}
  </ol>
  <ul class="are-extra">{REGLAS.extra.map((x) => <li>{x}</li>)}</ul>
</section>

<style>
  .are-cab { display: grid; gap: 14px; }
  .are-p { margin: 0; max-width: 46ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .are-frases { display: grid; gap: 0; margin: 40px 0 0; padding: 0; list-style: none; border-top: 2px solid #fff; }
  .are-frases li { display: grid; grid-template-columns: 44px 1fr; gap: 8px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--pd-linea); }
  .are-n { font: 700 18px/1.3 var(--pd-clash); color: rgba(255, 255, 255, 0.7); }
  .are-frases p { margin: 0; font: 700 clamp(21px, 2.5vw, 34px)/1.3 var(--pd-clash); letter-spacing: -0.01em; color: #fff; text-wrap: pretty; }
  .are-valor { display: inline-grid; vertical-align: baseline; overflow: hidden; padding: 0 0.42em; border-radius: 0.5em; background: #fff; color: #2F55C4; line-height: 1.32; }
  .are-v { grid-area: 1 / 1; display: inline-block; white-space: nowrap; transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease; }
  .are-v.is-sale { transform: translateY(-110%); opacity: 0; }
  .are-v.is-entra { transform: translateY(110%); opacity: 0; transition: none; }
  .are-extra { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; padding: 0; list-style: none; }
  .are-extra li { padding: 8px 13px; border-radius: 99px; background: rgba(255, 255, 255, 0.16); font: 600 13px/1.2 var(--font-display); color: #fff; }
  :global(.js-rv) .are-frases .rv { opacity: 0; clip-path: inset(0 100% 0 0); transition: opacity 0.5s ease, clip-path 0.9s cubic-bezier(0.65, 0, 0.35, 1); transition-delay: calc(var(--i) * 0.09s); }
  :global(.js-rv) .are-frases .rv.is-on { opacity: 1; clip-path: inset(0 0 0 0); }
  @media (min-width: 900px) {
    .are-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .are-frases { margin-top: 56px; }
    .are-frases li { grid-template-columns: 64px 1fr; padding: 22px 0; }
  }
  @media (max-width: 767px) {
    .are-valor { white-space: normal; }
    .are-v { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .are-frases .rv { opacity: 1; clip-path: none; transition: none; }
    .are-v { transition: none; }
  }
</style>

<script>
  // Cada 2.4 s una frase prueba su siguiente valor (en orden, una a la vez), solo mientras la sección se ve y la
  // pestaña está activa. Con «reducir movimiento» no cambia nada.
  (() => {
    const lista = document.querySelector<HTMLElement>('[data-are]');
    if (!lista || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const pastillas = Array.from(lista.querySelectorAll<HTMLElement>('.are-valor')).map((el) => ({ el, v: el.querySelector<HTMLElement>('.are-v')!, valores: JSON.parse(el.dataset.valores || '[]') as string[], k: 0 }));
    let turno = 0, reloj = 0, visible = false;
    // el valor nuevo entra por abajo mientras el viejo sale por arriba (los dos en la misma celda de la pastilla)
    const cambia = () => {
      const p = pastillas[turno % pastillas.length]; turno++;
      if (!p || p.valores.length < 2) return;
      p.k = (p.k + 1) % p.valores.length;
      const viejo = p.v, nuevo = viejo.cloneNode() as HTMLElement;
      nuevo.textContent = p.valores[p.k];
      nuevo.classList.add('is-entra');
      p.el.appendChild(nuevo);
      p.v = nuevo;
      requestAnimationFrame(() => requestAnimationFrame(() => { nuevo.classList.remove('is-entra'); viejo.classList.add('is-sale'); }));
      window.setTimeout(() => viejo.remove(), 500);
    };
    const prende = () => { if (!reloj && visible && !document.hidden) reloj = window.setInterval(cambia, 2400); };
    const apaga = () => { if (reloj) { window.clearInterval(reloj); reloj = 0; } };
    new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; visible ? prende() : apaga(); }), { threshold: 0.25 }).observe(lista);
    document.addEventListener('visibilitychange', () => (document.hidden ? apaga() : prende()));
  })();
</script>
