---
/**
 * «Cada prenda, con su letra» (/producto/reportes-y-analitica): el Dashboard de Inventario. Tres fichas A, B y C caen
 * como fichas de juego (con su significado); la pantalla REAL del «ABC Moda (Retail)» de la boutique de la cuenta demo;
 * la edad del inventario en una barra que se reparte en sus cuatro tramos (valores de EJEMPLO) y el glosario en
 * palabras de dueña: GMROI, sell-through, cobertura y semáforo. Entrada: las fichas caen girando, la barra crece por
 * tramos. Negro.
 */
import { ABC, I } from '../../../data/producto-reportes';
import StaffVentana from '../../plugins/staff/StaffVentana.astro';
---
<section class="pda rpab pd-negro" id="rep-abc" aria-labelledby="rpab-h">
  <div class="pda-fondo" aria-hidden="true"><span>A · B · C · A · B · C · A · B · C</span><span>A · B · C · A · B · C · A · B · C</span></div>
  <p class="pd-folio"><span>{ABC.k}</span><span>ABC de moda · edad · GMROI</span></p>
  <div class="rpab-cab">
    <h2 class="pda-h" id="rpab-h">{ABC.h}</h2>
    <p class="rpab-p">{ABC.p}</p>
  </div>

  <ul class="rpab-letras">
    {ABC.letras.map((x, i) => (
      <li class="rv" style={`--i:${i}`}><span class="rpab-ficha" aria-hidden="true">{x.l}</span><span class="rpab-ficha-t"><b>{x.t}</b><span>{x.d}</span></span></li>
    ))}
  </ul>

  <div class="rpab-grid">
    <div class="rpab-ventana rv"><StaffVentana src={`${I}pantalla-abc.webp`} w={1400} h={860} alt="Dashboard de Inventario con el reporte ABC Moda (Retail) de la boutique: cada prenda con su clase A, B o C, sus ventas, su margen y su rotación" barra="Inventarios › Dashboard de Inventario" /></div>
    <div class="rpab-lado">
      <div class="rpab-edad rv" role="img" aria-label={`Edad del inventario, valores de ejemplo: ${ABC.edad.map((e) => `${e.t}, ${e.v} %`).join('; ')}`}>
        <span class="rpab-edad-t" aria-hidden="true"><b>Edad del inventario</b><em>Ejemplo</em></span>
        <span class="rpab-edad-barra" aria-hidden="true">{ABC.edad.map((e, i) => <i style={`--v:${e.v};--i:${i}`}></i>)}</span>
        <span class="rpab-edad-ley" aria-hidden="true">{ABC.edad.map((e, i) => <span style={`--i:${i}`}><b>{e.v} %</b>{e.t}</span>)}</span>
      </div>
      <dl class="rpab-glosario">
        {ABC.glosario.map((g) => <div><dt>{g.t}</dt><dd>{g.d}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

<style>
  .rpab-cab { display: grid; gap: 14px; }
  .rpab-p { margin: 0; max-width: 50ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  /* las fichas */
  .rpab-letras { display: grid; gap: 12px; margin: 40px 0 0; padding: 0; list-style: none; }
  .rpab-letras li { display: flex; align-items: center; gap: 16px; }
  .rpab-ficha { display: grid; place-items: center; flex: none; width: 72px; height: 72px; border-radius: 16px; background: #F5F3EE; color: #0B0B0C; font: 700 40px/1 var(--pd-clash); box-shadow: inset 0 -5px 0 rgba(0, 0, 0, 0.12), 0 14px 28px -14px rgba(0, 0, 0, 0.9); }
  .rpab-letras li:nth-child(1) .rpab-ficha { background: #3DD68C; }
  .rpab-letras li:nth-child(2) .rpab-ficha { background: #F2C46B; }
  .rpab-letras li:nth-child(3) .rpab-ficha { background: #F7A3A3; }
  .rpab-ficha-t { display: grid; gap: 3px; }
  .rpab-ficha-t b { font: 700 19px/1.2 var(--font-display); color: #fff; }
  .rpab-ficha-t span { font: 500 14.5px/1.4 var(--font-body); color: var(--pd-tenue); }
  :global(.js-rv) .rpab-letras .rv .rpab-ficha { opacity: 0; transform: translateY(-70px) rotate(-24deg); transition: opacity 0.4s ease, transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: calc(var(--i) * 0.16s); }
  :global(.js-rv) .rpab-letras .rv.is-on .rpab-ficha { opacity: 1; transform: none; }
  :global(.js-rv) .rpab-letras .rv .rpab-ficha-t { opacity: 0; transition: opacity 0.5s ease; transition-delay: calc(var(--i) * 0.16s + 0.35s); }
  :global(.js-rv) .rpab-letras .rv.is-on .rpab-ficha-t { opacity: 1; }
  .rpab-grid { display: grid; gap: 28px; margin-top: 44px; }
  .rpab-lado { display: grid; gap: 26px; align-content: start; }
  /* la edad del inventario */
  .rpab-edad { display: grid; gap: 12px; padding: 18px; border-radius: 18px; background: #18181A; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08); }
  .rpab-edad-t { display: flex; align-items: center; justify-content: space-between; }
  .rpab-edad-t b { font: 800 12.5px/1 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.86); }
  .rpab-edad-t em { padding: 4px 9px; border-radius: 99px; background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.72); font: 600 11px/1.2 var(--font-display); font-style: normal; }
  .rpab-edad-barra { display: flex; gap: 4px; height: 18px; }
  .rpab-edad-barra i { flex: var(--v) 1 0; border-radius: 5px; transform-origin: 0 50%; }
  .rpab-edad-barra i:nth-child(1), .rpab-edad-ley span:nth-child(1) b { --c: #3DD68C; }
  .rpab-edad-barra i:nth-child(2), .rpab-edad-ley span:nth-child(2) b { --c: #9DB8F5; }
  .rpab-edad-barra i:nth-child(3), .rpab-edad-ley span:nth-child(3) b { --c: #F2C46B; }
  .rpab-edad-barra i:nth-child(4), .rpab-edad-ley span:nth-child(4) b { --c: #F28B8B; }
  .rpab-edad-barra i { background: var(--c); }
  .rpab-edad-ley { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .rpab-edad-ley span { display: grid; gap: 2px; font: 600 11.5px/1.25 var(--font-display); color: rgba(255, 255, 255, 0.7); }
  .rpab-edad-ley b { font: 700 18px/1 var(--pd-clash); color: var(--c); }
  :global(.js-rv) .rpab-edad.rv .rpab-edad-barra i { transform: scaleX(0); transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(0.2s + var(--i) * 0.18s); }
  :global(.js-rv) .rpab-edad.rv.is-on .rpab-edad-barra i { transform: none; }
  /* el glosario */
  .rpab-glosario { display: grid; gap: 0; margin: 0; border-top: 1.5px solid rgba(255, 255, 255, 0.5); }
  .rpab-glosario > div { display: grid; gap: 3px; padding: 12px 0; border-bottom: 1px solid var(--pd-linea); }
  .rpab-glosario dt { font: 700 16px/1.25 var(--font-display); color: #9DB8F5; }
  .rpab-glosario dd { margin: 0; font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.84); }
  :global(.js-rv) .rpab-ventana.rv { opacity: 0; transform: perspective(1600px) rotateY(-10deg) translateX(-30px); transform-origin: 100% 50%; transition: opacity 0.7s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js-rv) .rpab-ventana.rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .rpab-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .rpab-letras { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 56px; }
    .rpab-ficha { width: 88px; height: 88px; font-size: 50px; border-radius: 18px; }
    .rpab-grid { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: 4vw; align-items: start; margin-top: 56px; }
  }
  @media (max-width: 767px) {
    .rpab-ventana { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 10px; }
    .rpab-ventana > :global(.sv) { width: 720px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .rpab .rv, :global(.js-rv) .rpab .rv .rpab-ficha, :global(.js-rv) .rpab .rv .rpab-ficha-t, :global(.js-rv) .rpab-edad.rv .rpab-edad-barra i { opacity: 1; transform: none; transition: none; }
  }
</style>
