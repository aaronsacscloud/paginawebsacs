---
/**
 * «Una pregunta, una respuesta» (/producto/reportes-y-analitica): seis preguntas de dueña y la pantalla REAL de Sacs que
 * contesta cada una, con el scroll (data-tramos="6"). Arriba, la pregunta se escribe sola en una barra de búsqueda;
 * debajo, la pantalla llega como la hoja siguiente de un reporte (la anterior se dobla hacia atrás) y un marco señala
 * el dato que contesta. La sexta no tiene pantalla: va el correo de una rutina de AXO («Sucursal contra sucursal», con
 * valores de ejemplo). En el teléfono: el escenario arriba y la pregunta abajo. Sin JS o con «reducir movimiento»: la
 * lista de preguntas, cada una con su pantalla. Marino.
 */
import { PREGUNTA } from '../../../data/producto-reportes';
const CORREO = [
  { t: 'Polanco Boutique', v: 100, d: '+12 %' },
  { t: 'SMA Centro', v: 78, d: '+4 %' },
  { t: 'Querétaro Antea', v: 64, d: '−3 %' },
  { t: 'León Altacia', v: 51, d: '+9 %' },
];
const ultimo = PREGUNTA.tramos.length - 1;
---
<section class="rppr" id="rep-pregunta" data-escena data-tramos={PREGUNTA.tramos.length} data-tramo={ultimo} aria-labelledby="rppr-h">
  <div class="rppr-riel" data-riel>
    <div class="rppr-escena">
      <div class="rppr-txt">
        <p class="rppr-k">{PREGUNTA.k}</p>
        <h2 class="rppr-h" id="rppr-h">{PREGUNTA.h}</h2>
        <ol class="rppr-pasos">
          {PREGUNTA.tramos.map((p, k) => (
            <li class="rppr-paso" data-k={k}>
              <span class="rppr-n">{p.n}</span>
              <span class="rppr-cuerpo">
                <b class="rppr-q">{p.q}</b>
                <span class="rppr-d"><b>{p.t}.</b> {p.d}</span>
              </span>
              <i class="rppr-barra" aria-hidden="true"><b></b></i>
              {p.img ? (
                <figure class="rppr-quieta"><img src={p.img} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" /></figure>
              ) : (
                <div class="rppr-quieta rppr-quieta--correo" role="img" aria-label="El correo de la rutina «Sucursal contra sucursal»: las cuatro tiendas, lado a lado, con su variación contra la semana anterior (valores de ejemplo)">
                  <span class="rppr-correo" aria-hidden="true">
                    <span class="rppr-c-top"><i>A</i><span><b>AXO · Sacs</b><small>para mí · lunes 8:00</small></span></span>
                    <b class="rppr-c-asunto">🔁 Sucursal contra sucursal</b>
                    <span class="rppr-c-sub">Tu semana, tienda por tienda · diseño Comparativo</span>
                    {CORREO.map((c) => <span class="rppr-c-fila"><span>{c.t}</span><i style={`--v:${c.v}%`}></i><em class:list={{ 'is-baja': c.d.startsWith('−') }}>{c.d}</em></span>)}
                    <span class="rppr-c-pie">Ejemplo · te llega cada lunes</span>
                  </span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>

      <div class="rppr-mesa" aria-hidden="true">
        <div class="rppr-busca">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <span class="rppr-escrito" data-escribe>{PREGUNTA.tramos[ultimo].q}</span><i class="rppr-cursor"></i>
        </div>
        <div class="rppr-hojas">
          {PREGUNTA.tramos.map((p, k) => (
            <div class="rppr-hoja" data-k={k} data-q={p.q} data-estado={k === ultimo ? 'ahora' : 'antes'}>
              {p.img ? (
                <figure class="rppr-ventana">
                  <span class="rppr-vbarra"><i></i><i></i><i></i><span>{p.t}</span></span>
                  <span class="rppr-vimg">
                    <img src={p.img} width={p.w} height={p.h} alt="" loading="lazy" decoding="async" />
                    {p.marca && <i class="rppr-marca" style={`left:${p.marca[0]}%;top:${p.marca[1]}%;width:${p.marca[2]}%;height:${p.marca[3]}%`}></i>}
                  </span>
                </figure>
              ) : (
                <span class="rppr-correo rppr-correo--mesa">
                  <span class="rppr-c-top"><i>A</i><span><b>AXO · Sacs</b><small>para mí · lunes 8:00</small></span></span>
                  <b class="rppr-c-asunto">🔁 Sucursal contra sucursal</b>
                  <span class="rppr-c-sub">Tu semana, tienda por tienda · diseño Comparativo</span>
                  {CORREO.map((c) => <span class="rppr-c-fila"><span>{c.t}</span><i style={`--v:${c.v}%`}></i><em class:list={{ 'is-baja': c.d.startsWith('−') }}>{c.d}</em></span>)}
                  <span class="rppr-c-pie">Ejemplo · te llega cada lunes</span>
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rppr { position: relative; background: #0A1648; color: #fff; }
  .rppr-escena { position: relative; overflow: hidden; background: radial-gradient(ellipse at 78% 110%, rgba(75, 123, 229, 0.42), transparent 60%), repeating-linear-gradient(0deg, transparent 0 63px, rgba(127, 163, 240, 0.08) 63px 64px), repeating-linear-gradient(90deg, transparent 0 63px, rgba(127, 163, 240, 0.08) 63px 64px), #0A1648; }

  /* ── sin escena: la lista de preguntas, cada una con su pantalla ── */
  .rppr-mesa { display: none; }
  .rppr-txt { max-width: 1160px; margin: 0 auto; padding: 72px 20px 80px; }
  .rppr-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #9DB8F5; }
  .rppr-h { margin: 0; max-width: 14ch; color: #fff; font: 700 clamp(36px, 4.4vw, 64px)/0.98 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; text-wrap: balance; }
  .rppr-pasos { margin: 26px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(157, 184, 245, 0.4); }
  .rppr-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 4px; padding: 14px 0; border-bottom: 1px solid rgba(157, 184, 245, 0.2); }
  .rppr-n { font: 700 19px/1.3 var(--pd-clash, var(--font-display)); color: #9DB8F5; }
  .rppr-cuerpo { display: grid; gap: 5px; }
  .rppr-q { font: 700 clamp(18px, 1.7vw, 22px)/1.25 var(--font-display); color: #fff; }
  .rppr-d { font: 500 15px/1.5 var(--font-body); color: rgba(255, 255, 255, 0.82); }
  .rppr-d b { color: #fff; font-family: var(--font-display); }
  .rppr-barra { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .rppr-barra b { display: block; height: 100%; background: #9DB8F5; transform: scaleX(0); transform-origin: 0 50%; }
  .rppr-quieta { grid-column: 1 / -1; margin: 12px 0 0; overflow: hidden; border-radius: 12px; background: #fff; box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.8); }
  .rppr-quieta img { display: block; width: 100%; height: auto; }
  .rppr-quieta--correo { justify-self: start; width: min(100%, 420px); padding: 0; background: transparent; box-shadow: none; }

  /* ── el correo de la rutina (dibujo con valores de ejemplo) ── */
  .rppr-correo { display: grid; gap: 8px; width: min(100%, 440px); padding: 18px 20px 16px; border-radius: 18px; background: #fff; color: #141414; box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.9); }
  .rppr-c-top { display: flex; align-items: center; gap: 10px; padding-bottom: 10px; border-bottom: 1px solid #ECEDEF; }
  .rppr-c-top i { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 50%; background: #2F55C4; color: #fff; font: 800 14px/1 var(--font-display); font-style: normal; }
  .rppr-c-top > span { display: grid; gap: 2px; }
  .rppr-c-top b { font: 700 13.5px/1.2 var(--font-display); }
  .rppr-c-top small { font: 500 12px/1.2 var(--font-body); color: #6B6A64; }
  .rppr-c-asunto { margin-top: 4px; font: 700 19px/1.2 var(--font-display); }
  .rppr-c-sub { margin-bottom: 4px; font: 500 13px/1.35 var(--font-body); color: #6B6A64; }
  .rppr-c-fila { display: grid; grid-template-columns: 118px 1fr 50px; align-items: center; gap: 10px; font: 600 12.5px/1.2 var(--font-display); }
  .rppr-c-fila i { display: block; height: 9px; width: var(--v); border-radius: 99px; background: linear-gradient(90deg, #2F55C4, #5B86EA); }
  .rppr-c-fila em { font-style: normal; text-align: right; color: #17804F; font-variant-numeric: tabular-nums; }
  .rppr-c-fila em.is-baja { color: #C62828; }
  .rppr-c-pie { margin-top: 6px; padding-top: 10px; border-top: 1px solid #ECEDEF; font: 600 11.5px/1.2 var(--font-display); color: #8A8A85; }

  /* ══ con el scroll ══ */
  .rppr.is-escena .rppr-riel { height: 620vh; }
  .rppr.is-escena .rppr-escena { position: sticky; top: var(--sub, 0px); height: calc(100vh - var(--sub, 0px)); height: calc(100svh - var(--sub, 0px)); }
  .rppr.is-escena .rppr-mesa { position: absolute; z-index: 2; display: block; perspective: 1800px; }
  .rppr.is-escena .rppr-quieta { display: none; }
  .rppr-busca { position: absolute; left: 0; right: 0; top: 0; display: flex; align-items: center; gap: 12px; height: 58px; padding: 0 22px; border-radius: 16px; background: #fff; color: #2F55C4; box-shadow: 0 24px 50px -26px rgba(0, 0, 0, 0.9), 0 0 0 4px rgba(157, 184, 245, 0.25); }
  .rppr-escrito { overflow: hidden; color: #141414; font: 600 clamp(15px, 1.35vw, 19px)/1.2 var(--font-display); white-space: nowrap; text-overflow: ellipsis; }
  .rppr-cursor { flex: none; width: 2px; height: 22px; margin-left: -9px; background: #2F55C4; animation: rpprParpadea 1s steps(1) infinite; }
  @keyframes rpprParpadea { 50% { opacity: 0; } }
  .rppr-hojas { position: absolute; left: 0; right: 0; top: 82px; bottom: 0; }
  .rppr-hoja { position: absolute; inset: 0; display: flex; align-items: flex-start; justify-content: center; transform-origin: 50% 0; transition: opacity 0.5s ease, transform 0.85s cubic-bezier(0.22, 1, 0.36, 1); }
  .rppr-hoja[data-estado="antes"] { opacity: 0; transform: translateY(-6%) rotateX(24deg) scale(0.94); }
  .rppr-hoja[data-estado="despues"] { opacity: 0; transform: translateY(14%) rotateX(-10deg); }
  .rppr-hoja[data-estado="ahora"] { opacity: 1; transform: none; }
  .rppr-ventana { display: flex; flex-direction: column; max-width: 100%; max-height: 100%; margin: 0; overflow: hidden; border-radius: 14px; background: #fff; box-shadow: 0 34px 70px -30px rgba(0, 0, 0, 0.95); }
  .rppr-vbarra { display: flex; flex: none; align-items: center; gap: 6px; height: 30px; padding: 0 12px; background: #F2F3F6; border-bottom: 1px solid #E6E8EE; }
  .rppr-vbarra i { width: 9px; height: 9px; border-radius: 50%; background: #D7DAE1; }
  .rppr-vbarra span { margin-left: 10px; font: 600 11.5px/1 var(--font-display); color: #7A8090; }
  .rppr-vimg { position: relative; display: block; min-height: 0; overflow: hidden; }
  .rppr-vimg img { display: block; width: 100%; height: auto; max-height: calc(100svh - var(--sub, 0px) - 230px); object-fit: cover; object-position: 50% 0; }
  .rppr-marca { position: absolute; border-radius: 10px; box-shadow: 0 0 0 3px #2F55C4, 0 0 0 9999px rgba(10, 22, 72, 0.22); opacity: 0; transform: scale(1.12); transition: opacity 0.4s ease 0.55s, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.55s; }
  .rppr-hoja[data-estado="ahora"] .rppr-marca { opacity: 1; transform: none; }
  .rppr-correo--mesa { width: min(100%, 460px); }
  .rppr.is-escena .rppr-n { color: rgba(157, 184, 245, 0.55); }
  .rppr.is-escena .rppr-q { color: rgba(255, 255, 255, 0.55); transition: color 0.3s ease; }
  .rppr.is-escena .rppr-d { display: none; }
  .rppr.is-escena[data-tramo="0"] .rppr-paso[data-k="0"] .rppr-q, .rppr.is-escena[data-tramo="1"] .rppr-paso[data-k="1"] .rppr-q, .rppr.is-escena[data-tramo="2"] .rppr-paso[data-k="2"] .rppr-q, .rppr.is-escena[data-tramo="3"] .rppr-paso[data-k="3"] .rppr-q, .rppr.is-escena[data-tramo="4"] .rppr-paso[data-k="4"] .rppr-q, .rppr.is-escena[data-tramo="5"] .rppr-paso[data-k="5"] .rppr-q { color: #fff; }
  .rppr.is-escena[data-tramo="0"] .rppr-paso[data-k="0"] .rppr-n, .rppr.is-escena[data-tramo="1"] .rppr-paso[data-k="1"] .rppr-n, .rppr.is-escena[data-tramo="2"] .rppr-paso[data-k="2"] .rppr-n, .rppr.is-escena[data-tramo="3"] .rppr-paso[data-k="3"] .rppr-n, .rppr.is-escena[data-tramo="4"] .rppr-paso[data-k="4"] .rppr-n, .rppr.is-escena[data-tramo="5"] .rppr-paso[data-k="5"] .rppr-n { color: #9DB8F5; }
  .rppr.is-escena[data-tramo="0"] .rppr-paso[data-k="0"] .rppr-barra b, .rppr.is-escena[data-tramo="1"] .rppr-paso[data-k="1"] .rppr-barra b, .rppr.is-escena[data-tramo="2"] .rppr-paso[data-k="2"] .rppr-barra b, .rppr.is-escena[data-tramo="3"] .rppr-paso[data-k="3"] .rppr-barra b, .rppr.is-escena[data-tramo="4"] .rppr-paso[data-k="4"] .rppr-barra b, .rppr.is-escena[data-tramo="5"] .rppr-paso[data-k="5"] .rppr-barra b { animation: rpprBarra 4.5s linear both; }
  @keyframes rpprBarra { from { transform: scaleX(0); } to { transform: none; } }

  @media (min-width: 900px) {
    .rppr.is-escena .rppr-txt { position: absolute; left: 0; top: 50%; z-index: 3; width: min(36vw, 480px); max-width: none; margin: 0; padding: 0 0 0 4.4vw; transform: translateY(-50%); }
    .rppr.is-escena .rppr-pasos { margin-top: 22px; }
    .rppr.is-escena .rppr-paso { padding: 11px 0; }
    .rppr.is-escena[data-tramo="0"] .rppr-paso[data-k="0"] .rppr-d, .rppr.is-escena[data-tramo="1"] .rppr-paso[data-k="1"] .rppr-d, .rppr.is-escena[data-tramo="2"] .rppr-paso[data-k="2"] .rppr-d, .rppr.is-escena[data-tramo="3"] .rppr-paso[data-k="3"] .rppr-d, .rppr.is-escena[data-tramo="4"] .rppr-paso[data-k="4"] .rppr-d, .rppr.is-escena[data-tramo="5"] .rppr-paso[data-k="5"] .rppr-d { display: block; }
    .rppr.is-escena .rppr-mesa { right: 4.4vw; top: 9%; bottom: 7%; width: min(52vw, 800px); }
    .rppr:not(.is-escena) .rppr-pasos { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
  }
  @media (min-width: 900px) and (max-height: 760px) {
    .rppr.is-escena .rppr-h { font-size: 40px; }
    .rppr.is-escena .rppr-paso { padding: 8px 0; }
    .rppr.is-escena .rppr-q { font-size: 16px; }
  }
  @media (max-width: 899px) {
    .rppr.is-escena .rppr-riel { height: 520vh; }
    /* el escenario arriba (la búsqueda y la hoja), la pregunta abajo */
    .rppr.is-escena .rppr-mesa { left: 16px; right: 16px; top: 14px; height: calc((100svh - var(--sub, 0px)) * 0.56); }
    .rppr-busca { height: 44px; padding: 0 14px; gap: 8px; border-radius: 12px; }
    .rppr-escrito { font-size: 14px; }
    .rppr-cursor { height: 17px; margin-left: -5px; }
    .rppr-hojas { top: 58px; }
    .rppr-vbarra { height: 20px; padding: 0 8px; gap: 4px; }
    .rppr-vbarra i { width: 6px; height: 6px; }
    .rppr-vbarra span { display: none; }
    .rppr-vimg img { max-height: calc((100svh - var(--sub, 0px)) * 0.56 - 90px); }
    .rppr-ventana { border-radius: 10px; }
    .rppr-correo--mesa { gap: 6px; padding: 12px 14px; }
    .rppr-correo--mesa .rppr-c-asunto { font-size: 15px; }
    .rppr-correo--mesa .rppr-c-sub { display: none; }
    .rppr-correo--mesa .rppr-c-fila { grid-template-columns: 100px 1fr 42px; font-size: 11px; }
    .rppr.is-escena .rppr-txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 22px 20px 18px; background: linear-gradient(180deg, rgba(10, 22, 72, 0) 0, #0A1648 22px); }
    .rppr.is-escena .rppr-k { margin-bottom: 8px; }
    .rppr.is-escena .rppr-h { font-size: clamp(25px, 7.2vw, 34px); }
    .rppr.is-escena .rppr-pasos { margin-top: 10px; }
    .rppr.is-escena .rppr-paso { display: none; padding: 10px 0 8px; }
    .rppr.is-escena[data-tramo="0"] .rppr-paso[data-k="0"], .rppr.is-escena[data-tramo="1"] .rppr-paso[data-k="1"], .rppr.is-escena[data-tramo="2"] .rppr-paso[data-k="2"], .rppr.is-escena[data-tramo="3"] .rppr-paso[data-k="3"], .rppr.is-escena[data-tramo="4"] .rppr-paso[data-k="4"], .rppr.is-escena[data-tramo="5"] .rppr-paso[data-k="5"] { display: grid; }
    .rppr.is-escena .rppr-d { display: block; font-size: 14px; }
    .rppr-c-fila { grid-template-columns: 104px 1fr 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rppr * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  // Lo que el scroll mueve y el CSS no alcanza: el estado de cada hoja (antes / ahora / después) y la pregunta, que se
  // escribe sola en la barra de búsqueda. Lee data-tramo, que pone iniciaEscenas (scripts/experiencia/escenas.ts).
  (() => {
    const sec = document.querySelector<HTMLElement>('.rppr');
    if (!sec) return;
    const hojas = Array.from(sec.querySelectorAll<HTMLElement>('.rppr-hoja'));
    const out = sec.querySelector<HTMLElement>('[data-escribe]');
    const qs = hojas.map((h) => h.dataset.q || '');
    let ultimo = -1, timer = 0;
    const escribe = (t: string) => {
      window.clearInterval(timer);
      if (!out) return;
      if (!sec.classList.contains('is-escena') || document.hidden) { out.textContent = t; return; }
      let i = 0;
      out.textContent = '';
      timer = window.setInterval(() => { i += 1; out.textContent = t.slice(0, i); if (i >= t.length) window.clearInterval(timer); }, 30);
    };
    const pinta = () => {
      const t = Number(sec.dataset.tramo || 0);
      if (t === ultimo) return;
      ultimo = t;
      hojas.forEach((h, k) => { h.dataset.estado = k < t ? 'antes' : k === t ? 'ahora' : 'despues'; });
      escribe(qs[t] || '');
    };
    new MutationObserver(pinta).observe(sec, { attributes: true, attributeFilter: ['data-tramo'] });
    document.addEventListener('visibilitychange', () => { if (document.hidden) { window.clearInterval(timer); if (out) out.textContent = qs[ultimo] || ''; } });
    pinta();
  })();
</script>
