---
/**
 * «Tu punto de venta, en el bolsillo» (/producto/punto-de-venta): SACSMobile, la app del celular, tiene el punto de venta
 * completo (inventario del código, 4-oct-2026). La foto del bazar con la vendedora cobrando con el celular (gpt-image-2.5)
 * a todo lo ancho y, encima, tres pantallas REALES de SACSMobile (cuenta demo): el control de caja, las acciones del
 * punto de venta y su menú (corte, historial, pedidos, apartados), que se abren en abanico al verse. Negro.
 */
import { CELULAR, I } from '../../../data/producto-pos';
const TELS = [
  { src: `${I}cel-caja.webp`, alt: 'Control de caja en el celular: la caja en operación, lista para vender, con su cajero y su sucursal' },
  { src: `${I}cel-acciones.webp`, alt: 'Las acciones del punto de venta en el celular: crear producto rápido, buscar por foto con IA, ventas guardadas, últimas transacciones, movimiento de caja y más' },
  { src: `${I}cel-menu.webp`, alt: 'El menú del punto de venta en el celular: corte en curso, historial de cortes, ventas, transacciones, pedidos, apartados e inventario' },
];
---
<section class="pce" id="pos-celular" aria-labelledby="pce-h">
  <div class="pce-hero" data-pce>
    <img class="pce-foto" src={`${I}bazar-1280.webp`} srcset={`${I}bazar-900.webp 900w, ${I}bazar-1280.webp 1280w`} sizes="100vw" width="1280" height="853" alt="En un bazar de diseño, la vendedora cobra a una clienta con el celular y una terminal de tarjetas" loading="lazy" decoding="async" />
    <div class="pce-txt">
      <p class="pce-k">{CELULAR.k}</p>
      <h2 class="pce-h" id="pce-h">{CELULAR.h}</h2>
      <p class="pce-p">{CELULAR.p}</p>
    </div>
    <div class="pce-tels" aria-hidden="true">
      {TELS.map((t, i) => <span class="pce-tel" style={`--i:${i}`}><img src={t.src} width="780" height="1688" alt="" loading="lazy" decoding="async" /></span>)}
    </div>
  </div>
  <div class="pce-cuerpo">
    <ul class="pce-puntos">{CELULAR.puntos.map((x, i) => <li class="rv" style={`--i:${i}`}><b>{x.t}</b><span>{x.d}</span></li>)}</ul>
    <ul class="pce-alts" aria-label="Lo que muestran las pantallas">{TELS.map((t) => <li>{t.alt}</li>)}</ul>
  </div>
</section>

<style>
  .pce { position: relative; background: #0B0B0C; color: #fff; scroll-margin-top: 56px; }
  .pce-hero { position: relative; overflow: hidden; }
  .pce-foto { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 70% 50%; }
  .pce-txt { padding: 28px 20px 0; }
  .pce-k { margin: 0 0 12px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #9DB8F5; }
  .pce-h { margin: 0; max-width: 14ch; color: #fff; font: 700 clamp(34px, 4.6vw, 68px)/0.96 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; text-wrap: balance; }
  .pce-p { margin: 16px 0 0; max-width: 44ch; font: 500 17px/1.55 var(--font-body); color: rgba(255, 255, 255, 0.85); }
  .pce-tels { position: relative; display: flex; justify-content: center; height: 420px; margin-top: 28px; }
  .pce-tel { position: absolute; top: 0; width: 180px; padding: 6px; border-radius: 30px; background: #121216; box-shadow: 0 30px 50px -24px rgba(0, 0, 0, 0.85), inset 0 0 0 1.5px rgba(255, 255, 255, 0.14); transform: translateX(calc((var(--i) - 1) * 0%)) rotate(0deg); transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i) * 0.08s); }
  .pce-tel img { display: block; width: 100%; height: auto; border-radius: 24px; }
  .pce-hero.is-on .pce-tel { transform: translateX(calc((var(--i) - 1) * 62%)) translateY(18px) rotate(calc((var(--i) - 1) * 7deg)); }
  .pce-hero.is-on .pce-tel:nth-child(2) { transform: none; }
  .pce-tel:nth-child(2) { z-index: 2; }
  .pce-cuerpo { max-width: 1160px; margin: 0 auto; padding: 24px 20px 80px; }
  .pce-puntos { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 2px solid #fff; }
  .pce-puntos li { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .pce-puntos b { font: 700 17px/1.25 var(--font-display); color: #fff; }
  .pce-puntos span { font: 500 14.5px/1.5 var(--font-body); color: rgba(255, 255, 255, 0.78); }
  .pce-alts { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(.js-rv) .pce .rv { opacity: 0; transform: translateY(16px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i, 0) * 0.08s); }
  :global(.js-rv) .pce .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .pce-hero { height: min(92vh, 900px); min-height: 620px; }
    .pce-foto { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
    .pce-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8, 8, 10, 0.9) 0%, rgba(8, 8, 10, 0.55) 34%, rgba(8, 8, 10, 0.1) 60%), linear-gradient(180deg, rgba(11, 11, 12, 0) 72%, #0B0B0C 100%); }
    .pce-txt { position: absolute; z-index: 2; left: 5vw; top: 50%; width: min(38vw, 540px); padding: 0; transform: translateY(-50%); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
    .pce-tels { position: absolute; z-index: 2; right: 8vw; top: 50%; width: 420px; height: auto; margin: 0; transform: translateY(-48%); }
    .pce-tel { position: relative; width: 200px; }
    .pce-tel:not(:nth-child(2)) { position: absolute; top: 0; left: 110px; }
    .pce-cuerpo { padding: 0 5vw 120px; box-sizing: content-box; }
    .pce-puntos { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; border-top: 0; }
    .pce-puntos li { border-top: 2px solid #fff; border-bottom: 0; padding-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pce-tel { transition: none; }
    :global(.js-rv) .pce .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  (() => {
    const el = document.querySelector<HTMLElement>('[data-pce]');
    if (!el || !('IntersectionObserver' in window)) { el?.classList.add('is-on'); return; }
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-on'); io.disconnect(); } }), { threshold: 0.3 });
    io.observe(el);
  })();
</script>
