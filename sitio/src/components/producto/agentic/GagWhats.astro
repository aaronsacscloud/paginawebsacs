---
/**
 * «Tu vendedora no se va a dormir» (/producto/agentic-commerce): el agente de WhatsApp con IA. Sobre la foto de la
 * boutique cerrada de noche (gpt-image-2.5), un celular con la conversación de las 23:48: la clienta pregunta por el
 * blazer de lino en M, el agente contesta con las existencias por sucursal y su foto, aparta y comparte la liga del
 * anticipo. Los mensajes llegan uno por uno, con su «escribiendo…», mientras se ve (chat dibujado, neutro, con el
 * diseño de Sacs). Visión del producto (ver src/data/producto-agentic.ts). Negro.
 */
import { WHATS, I } from '../../../data/producto-agentic';
---
<section class="pda gwh pd-negro" id="gag-whats" aria-labelledby="gwh-h">
  <div class="gwh-foto" aria-hidden="true">
    <img src={`${I}cerrado-1280.webp`} srcset={`${I}cerrado-900.webp 900w, ${I}cerrado-1280.webp 1280w, ${I}cerrado-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" alt="" loading="lazy" decoding="async" />
  </div>
  <p class="pd-folio"><span>{WHATS.k}</span><span>A cualquier hora</span></p>
  <div class="gwh-grid">
    <div class="gwh-lado">
      <h2 class="pda-h" id="gwh-h">{WHATS.h}</h2>
      <p class="gwh-p">{WHATS.p}</p>
      <ul class="gwh-puntos">{WHATS.puntos.map((x, i) => <li class="rv" style={`--i:${i}`}><b>{x.t}</b><span>{x.d}</span></li>)}</ul>
    </div>
    <div class="gwh-cel" data-gwh role="img" aria-label="Conversación de WhatsApp a las 23:48: la clienta pregunta por el blazer de lino azul en M; el agente contesta que queda 1 en Polanco y 2 en Santa Fe, a $2,290, con su foto; ella pide que se lo aparte y el agente se lo aparta y le manda la liga para dejar su anticipo">
      <span class="gwh-top" aria-hidden="true"><i>P</i><span><b>Polanco Boutique</b><small>en línea</small></span></span>
      <span class="gwh-msgs" aria-hidden="true">
        {WHATS.chat.map((m, i) => (
          <span class:list={['gwh-m', `gwh-m--${m.de}`]} style={`--i:${i}`}>
            {m.img && <img src={m.img} width="360" height="540" alt="" loading="lazy" decoding="async" />}
            <span>{m.t}</span>
            {m.liga && <u>{m.liga} →</u>}
            <small>{m.h}</small>
          </span>
        ))}
        <span class="gwh-escribe"><i></i><i></i><i></i></span>
      </span>
    </div>
  </div>
</section>

<style>
  .gwh { overflow: hidden; }
  .gwh > .gwh-foto { position: absolute; inset: 0; max-width: none; margin: 0; }
  .gwh-foto img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; opacity: 0.38; }
  .gwh-foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11, 11, 12, 0.92), rgba(11, 11, 12, 0.55)); }
  .gwh-grid { display: grid; gap: 36px; }
  .gwh-lado { display: grid; gap: 16px; align-content: start; }
  .gwh-p { margin: 0; max-width: 48ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .gwh-puntos { display: grid; gap: 0; margin: 8px 0 0; padding: 0; list-style: none; border-top: 2px solid #fff; }
  .gwh-puntos li { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--pd-linea); }
  .gwh-puntos b { font: 700 17px/1.25 var(--font-display); color: #fff; }
  .gwh-puntos span { font: 500 14.5px/1.5 var(--font-body); color: var(--pd-tenue); }
  :global(.js-rv) .gwh-puntos .rv { opacity: 0; transform: translateY(14px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.08s); }
  :global(.js-rv) .gwh-puntos .rv.is-on { opacity: 1; transform: none; }
  /* el celular */
  .gwh-cel { justify-self: center; display: grid; grid-template-rows: auto 1fr; width: min(100%, 360px); height: 600px; overflow: hidden; border: 10px solid #141416; border-radius: 40px; background: #EFE7DD; box-shadow: 0 40px 70px -30px rgba(0, 0, 0, 0.9); }
  .gwh-top { display: flex; align-items: center; gap: 10px; padding: 14px 14px 12px; background: #fff; color: #141414; }
  .gwh-top i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #141414; color: #fff; font: 700 14px/1 var(--font-display); font-style: normal; }
  .gwh-top span { display: grid; }
  .gwh-top b { font: 700 14.5px/1.2 var(--font-display); }
  .gwh-top small { font: 500 11.5px/1.2 var(--font-body); color: #1FAF5A; }
  .gwh-msgs { display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; padding: 14px 12px; overflow: hidden; }
  .gwh-m { position: relative; display: grid; gap: 6px; max-width: 84%; padding: 8px 10px 18px; border-radius: 12px; color: #141414; font: 500 13.5px/1.4 var(--font-body); box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08); }
  .gwh-m--c { align-self: flex-end; background: #D9FDD3; border-bottom-right-radius: 3px; }
  .gwh-m--a { align-self: flex-start; background: #fff; border-bottom-left-radius: 3px; }
  .gwh-m img { display: block; width: 150px; height: auto; aspect-ratio: 3 / 3.3; object-fit: cover; object-position: 50% 30%; border-radius: 8px; background: #EFEDE8; }
  .gwh-m u { display: grid; place-items: center; padding: 8px 10px; border-radius: 8px; background: #EAF0FE; color: #2F55C4; font: 700 12.5px/1.2 var(--font-display); text-decoration: none; }
  .gwh-m small { position: absolute; right: 8px; bottom: 4px; font: 500 10px/1 var(--font-body); color: #8A8A85; }
  .gwh-escribe { display: none; align-self: flex-start; gap: 4px; padding: 10px 12px; border-radius: 12px; background: #fff; }
  .gwh-escribe i { width: 7px; height: 7px; border-radius: 50%; background: #9A9893; animation: gwhPunto 1.1s ease-in-out infinite; }
  .gwh-escribe i:nth-child(2) { animation-delay: 0.15s; }
  .gwh-escribe i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes gwhPunto { 0%, 100% { opacity: 0.35; transform: none; } 50% { opacity: 1; transform: translateY(-2px); } }
  /* con JS: los mensajes llegan uno por uno (data-n = cuántos van) */
  .gwh-cel.is-js .gwh-m { display: none; }
  .gwh-cel.is-js[data-n="1"] .gwh-m:nth-child(-n + 1), .gwh-cel.is-js[data-n="2"] .gwh-m:nth-child(-n + 2), .gwh-cel.is-js[data-n="3"] .gwh-m:nth-child(-n + 3), .gwh-cel.is-js[data-n="4"] .gwh-m:nth-child(-n + 4) { display: grid; animation: gwhLlega 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .gwh-cel.is-js.is-escribe .gwh-escribe { display: inline-flex; }
  @keyframes gwhLlega { from { opacity: 0; transform: translateY(10px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (min-width: 900px) {
    .gwh-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 5vw; align-items: center; }
    .gwh-cel { height: 640px; }
  }
  @media (max-width: 767px) {
    .gwh-cel { height: 560px; border-width: 8px; border-radius: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gwh-escribe i { animation: none; }
    .gwh-cel.is-js .gwh-m { display: grid !important; animation: none !important; }
    :global(.js-rv) .gwh-puntos .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // La conversación avanza sola mientras el celular se ve: «escribiendo…», llega un mensaje, y así hasta el último;
  // después de una pausa vuelve a empezar. Se detiene fuera de vista y con la pestaña oculta.
  (() => {
    const cel = document.querySelector<HTMLElement>('[data-gwh]');
    if (!cel || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const total = cel.querySelectorAll('.gwh-m').length;
    cel.classList.add('is-js');
    cel.dataset.n = '0';
    let n = 0, reloj = 0, visible = false;
    const siguiente = () => {
      reloj = 0;
      if (!visible || document.hidden) return;
      if (n >= total) { reloj = window.setTimeout(() => { n = 0; cel.dataset.n = '0'; siguiente(); }, 4200); return; }
      const deAgente = n % 2 === 1;
      if (deAgente) {
        cel.classList.add('is-escribe');
        reloj = window.setTimeout(() => { cel.classList.remove('is-escribe'); n++; cel.dataset.n = String(n); reloj = window.setTimeout(siguiente, 900); }, 1300);
      } else {
        n++; cel.dataset.n = String(n); reloj = window.setTimeout(siguiente, 900);
      }
    };
    const para = () => { if (reloj) { window.clearTimeout(reloj); reloj = 0; } cel.classList.remove('is-escribe'); };
    new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; if (visible && !reloj) siguiente(); else if (!visible) para(); }), { threshold: 0.3 }).observe(cel);
    document.addEventListener('visibilitychange', () => { if (document.hidden) para(); else if (visible && !reloj) siguiente(); });
  })();
</script>
