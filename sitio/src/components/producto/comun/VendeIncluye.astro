---
/**
 * «Todo lo que incluye» de las páginas de «Vende» (/producto/promociones, /apartados-y-pedidos,
 * /facturacion-electronica…): la rejilla de tarjetas de color de /producto/punto-de-venta (PosIncluye) en un solo
 * componente. Cada tarjeta lleva su pantalla real o un dibujo hecho con los textos reales (cupón, reloj, factura, liga,
 * sobre pedido, reglas, precio tachado, boleto, margen, barras, impulso con `fotos`) y enlaza a su sección. Entrada: cada tarjeta se levanta con una inclinación, escalonada (script de la
 * página: .rv).
 * Rejilla de escritorio: 4 columnas; una tarjeta `alta` ocupa dos filas y las `ancha`, dos columnas.
 */
export interface PiezaIncluye { id: string; t: string; d: string; img?: string; w?: number; h?: number; tono: 'negro' | 'fucsia' | 'marfil' | 'marino' | 'azul'; ancha?: boolean; alta?: boolean; cubre?: boolean; dibujo?: 'cupon' | 'reloj' | 'factura' | 'liga' | 'sobre' | 'reglas' | 'precio' | 'boleto' | 'margen' | 'barras' | 'impulso'; fotos?: string[] }
interface Props { folio: [string, string]; titulo: string; intro: string; piezas: PiezaIncluye[] }
const { folio, titulo, intro, piezas } = Astro.props;
const PALABRA = Array.from({ length: 3 }, () => 'TODO INCLUIDO').join(' · ');
---
<section class="pda vin pd-negro" aria-labelledby="vin-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <p class="pd-folio"><span>{folio[0]}</span><span>{folio[1]}</span></p>
  <h2 class="pda-h" id="vin-h">{titulo}</h2>
  <p class="vin-p">{intro}</p>
  <ul class="vin-rejilla">
    {piezas.map((x, i) => (
      <li class:list={['vin-t', `vin-t--${x.tono}`, { 'vin-t--ancha': x.ancha, 'vin-t--alta': x.alta }, 'rv']} style={`--i:${i}`}>
        <a href={`#${x.id}`}>
          <span class="vin-txt"><b>{x.t}</b><span>{x.d}</span><em aria-hidden="true">Ver →</em></span>
          {x.img ? (
            <span class:list={['vin-img', { 'vin-img--cubre': x.cubre }]}><img src={x.img} width={x.w} height={x.h} alt="" loading="lazy" decoding="async" /></span>
          ) : x.dibujo === 'cupon' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-cupon"><small>Cupón</small><b>PRIMAVERA15</b><i>Un uso por cliente</i></span></span>
          ) : x.dibujo === 'reloj' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-reloj"><span class="vin-esfera"><i class="vin-h"></i><i class="vin-m"></i></span><span class="vin-horas"><b>18:00</b><small>arranca sola</small><b>21:00</b><small>termina sola</small></span></span></span>
          ) : x.dibujo === 'factura' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-cfdi"><small>CFDI 4.0</small><b>Factura</b><i></i><i></i><i></i><span class="vin-qr"></span><u>XML · PDF</u></span></span>
          ) : x.dibujo === 'precio' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-precio"><span class="vin-pl"><b>Vestido de punto manga larga</b><small>S · Camel</small></span><span class="vin-pp"><s>$2,490.00</s><b>$1,743.00</b></span><span class="vin-tira"><svg class="vin-tag" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2h5.6l6.4 6.4-5.6 5.6L2 7.6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="5.2" cy="5.2" r="1.2" fill="currentColor"/></svg>Fin de temporada</span></span></span>
          ) : x.dibujo === 'boleto' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-boleto"><small>OFERTA ESPECIAL PARA TI</small><b>VC-8K2M4Q</b><span>15% DE DESCUENTO</span><i>Válido hasta: 20/10/2026</i></span></span>
          ) : x.dibujo === 'margen' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-margen"><small>Validación de margen</small><span class="vin-mf"><b>Blazer sastre cruzado</b><em>Crítico</em></span><span class="vin-mn"><span>Margen <b>12 %</b></span><span>Umbral <b>30 %</b></span></span><span class="vin-mb"><u>Cancelar</u><u>Guardar igual</u></span></span></span>
          ) : x.dibujo === 'barras' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-barras"><small>Ventas por promoción</small>{['Fin de temporada', '3x2 en camisetas', 'Martes de 6 a 9'].map((n, k) => <span class="vin-br" style={`--w:${[92, 64, 41][k]}%`}><span>{n}</span><i></i></span>)}</span></span>
          ) : x.dibujo === 'impulso' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-impulso">{(x.fotos || []).slice(0, 3).map((src) => <span><img src={src} width="240" height="240" alt="" loading="lazy" decoding="async" /><u>Agregar</u></span>)}</span></span>
          ) : x.dibujo === 'reglas' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-reglas"><span><small>Anticipo mínimo</small><b>20 %</b></span><span><small>Para liquidar</small><b>15 días</b></span><span><small>Si vence</small><b>Libera la mercancía</b></span></span></span>
          ) : x.dibujo === 'sobre' ? (
            <span class="vin-dib" aria-hidden="true"><span class="vin-sobre"><small>📦 Sobre pedido</small><b>Blazer sastre cruzado · M</b><span class="vin-pasos"><i class="is-ok">Pedido</i><i class="is-ok">Recibido</i><i>Apartado</i></span></span></span>
          ) : (
            <span class="vin-dib" aria-hidden="true"><span class="vin-liga"><small>Tu apartado</small><b>Saldo $2,784.00</b><span class="vin-barra"><i></i></span><u>Abonar ahora</u></span></span>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .vin-p { margin: 18px 0 0; max-width: 52ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .vin-rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 36px auto 0; padding: 0; list-style: none; perspective: 1400px; }
  .vin-t a { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: 20px; background: var(--fondo); color: var(--tinta); text-decoration: none; transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .vin-t a:hover { transform: translateY(-4px); color: var(--tinta); text-decoration: none; }
  .vin-t a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .vin-t--negro { --fondo: #1C1C1F; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.72); --acento: #9DB8F5; }
  .vin-t--fucsia { --fondo: #D03A70; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.9); --acento: #fff; }
  .vin-t--marfil { --fondo: #F5F3EE; --tinta: #141414; --tenue: #45433E; --acento: #2F55C4; }
  .vin-t--marino { --fondo: #0A1648; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.78); --acento: #9DB8F5; }
  .vin-t--azul { --fondo: #4470D8; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.92); --acento: #fff; }
  .vin-txt { display: grid; gap: 5px; padding: 16px 16px 12px; }
  .vin-txt b { font: 700 clamp(17px, 1.5vw, 22px)/1.12 var(--pd-clash); letter-spacing: -0.01em; }
  .vin-txt > span { font: 500 13.5px/1.45 var(--font-body); color: var(--tenue); }
  .vin-txt em { margin-top: 4px; font: 700 12.5px/1 var(--font-display); font-style: normal; color: var(--acento); }
  .vin-img { position: relative; flex: 1; min-height: 110px; margin: 0 12px; overflow: hidden; border-radius: 12px 12px 0 0; background: #fff; box-shadow: 0 -10px 30px -18px rgba(0, 0, 0, 0.5); }
  .vin-img img { position: absolute; left: 0; top: 0; width: 100%; height: auto; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .vin-t a:hover .vin-img img { transform: translateY(-3%); }
  /* fotos (no pantallas): llenan su caja */
  .vin-img--cubre img { height: 100%; object-fit: cover; object-position: 50% 40%; }
  .vin-t a:hover .vin-img--cubre img { transform: scale(1.03); }
  /* en las tarjetas altas el dibujo va al centro, más grande */
  .vin-t--alta .vin-dib { place-items: center; }
  .vin-t--alta .vin-reloj { flex-direction: column; gap: 18px; padding: 24px 22px; }
  .vin-t--alta .vin-esfera { width: 108px; height: 108px; box-shadow: inset 0 0 0 4px #141414; }
  .vin-t--alta .vin-esfera i { width: 4px; }
  .vin-t--alta .vin-h { height: 28px; }
  .vin-t--alta .vin-m { height: 42px; }
  .vin-t--alta .vin-horas b { font-size: 19px; }
  .vin-t--alta { grid-row: span 2; }
  .vin-t--ancha { grid-column: span 2; }
  .vin-t--ancha a { flex-direction: row; align-items: stretch; }
  .vin-t--ancha .vin-txt { flex: 1; align-content: center; }
  .vin-t--ancha .vin-img, .vin-t--ancha .vin-dib { flex: 0 0 54%; margin: 14px 14px 0 0; border-radius: 14px 14px 0 0; }
  /* dibujos */
  .vin-dib { position: relative; display: grid; place-items: end center; flex: 1; min-height: 120px; padding: 0 14px; overflow: hidden; }
  .vin-cupon { position: relative; display: grid; gap: 4px; width: min(100%, 230px); margin-bottom: 18px; padding: 16px 18px; border-radius: 12px; background: #fff; color: #141414; -webkit-mask: radial-gradient(circle 9px at 0 50%, #0000 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 9px at 100% 50%, #0000 98%, #000) right / 51% 100% no-repeat; mask: radial-gradient(circle 9px at 0 50%, #0000 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 9px at 100% 50%, #0000 98%, #000) right / 51% 100% no-repeat; }
  .vin-cupon small { font: 700 10px/1 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: #D03A70; }
  .vin-cupon b { font: 700 20px/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.04em; }
  .vin-cupon i { font: 500 11px/1.2 var(--font-body); font-style: normal; color: #6B6A64; }
  .vin-reloj { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; padding: 14px 16px; border-radius: 16px; background: #fff; color: #141414; }
  .vin-esfera { position: relative; flex: none; width: 52px; height: 52px; border-radius: 50%; box-shadow: inset 0 0 0 2.5px #141414; }
  .vin-esfera i { position: absolute; left: 50%; bottom: 50%; width: 2.5px; border-radius: 2px; background: #141414; transform-origin: 50% 100%; }
  .vin-h { height: 14px; transform: translateX(-50%) rotate(180deg); }
  .vin-m { height: 20px; transform: translateX(-50%) rotate(0deg); background: #D03A70 !important; }
  .vin-horas { display: grid; grid-template-columns: auto auto; gap: 2px 8px; align-items: baseline; }
  .vin-horas b { font: 700 15px/1 'JetBrains Mono', ui-monospace, monospace; }
  .vin-horas small { font: 600 11px/1.2 var(--font-display); color: #6B6A64; }
  .vin-cfdi { position: relative; display: grid; gap: 6px; width: min(78%, 220px); padding: 14px 14px 34px; border-radius: 10px 10px 0 0; background: #fff; color: #141414; }
  .vin-cfdi small { font: 700 9.5px/1 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: #2F55C4; }
  .vin-cfdi b { font: 700 14px/1 var(--font-display); }
  .vin-cfdi > i { height: 5px; border-radius: 3px; background: #E7E8EC; }
  .vin-cfdi > i:nth-of-type(2) { width: 82%; }
  .vin-cfdi > i:nth-of-type(3) { width: 60%; }
  .vin-qr { position: absolute; right: 10px; bottom: 8px; width: 24px; height: 24px; background: conic-gradient(from 90deg, #141414 25%, #fff 0 50%, #141414 0 75%, #fff 0) 0 0 / 8px 8px; }
  .vin-cfdi u { position: absolute; left: 14px; bottom: 12px; font: 700 10px/1 var(--font-display); text-decoration: none; color: #6B6A64; }
  .vin-liga { display: grid; gap: 7px; width: min(78%, 220px); margin-bottom: 16px; padding: 14px; border-radius: 16px; background: #fff; color: #141414; }
  .vin-liga small { font: 700 10px/1 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: #6B6A64; }
  .vin-liga b { font: 700 16px/1.1 var(--font-display); }
  .vin-barra { height: 7px; overflow: hidden; border-radius: 99px; background: #E7E8EC; }
  .vin-barra i { display: block; width: 20%; height: 100%; border-radius: 99px; background: #1F9D63; }
  .vin-liga u { display: grid; place-items: center; height: 30px; border-radius: 9px; background: #2F55C4; color: #fff; font: 700 12px/1 var(--font-display); text-decoration: none; }
  .vin-tag { width: 12px; height: 12px; flex: none; }
  .vin-precio { display: grid; gap: 6px; width: min(92%, 270px); margin-bottom: 16px; padding: 12px 12px 10px; border-radius: 14px; background: #fff; color: #141414; }
  .vin-pl { display: grid; gap: 2px; }
  .vin-pl b { font: 700 12.5px/1.2 var(--font-display); }
  .vin-pl small { font: 600 10.5px/1.2 var(--font-display); color: #2F55C4; }
  .vin-pp { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
  .vin-pp s { font: 500 10.5px/1.2 var(--font-body); color: #8A8A85; }
  .vin-pp b { font: 700 13px/1.2 var(--font-display); color: #141414; }
  .vin-tira { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 7px; background: #EAF0FE; color: #2F55C4; font: 700 11px/1.2 var(--font-display); }
  .vin-boleto { display: grid; justify-items: center; gap: 4px; width: min(78%, 200px); padding: 14px 12px 20px; background: #FBFBF8; color: #141414; text-align: center; font-family: 'JetBrains Mono', ui-monospace, monospace; -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 16px 100%; mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 16px 100%; }
  .vin-boleto small { font-size: 9.5px; font-weight: 700; letter-spacing: 0.04em; }
  .vin-boleto b { padding: 4px 8px; border: 1.5px dashed #141414; font-size: 15px; letter-spacing: 0.06em; }
  .vin-boleto span { font-size: 11px; font-weight: 700; }
  .vin-boleto i { font-size: 9.5px; font-style: normal; color: #55534E; }
  .vin-margen { display: grid; gap: 8px; width: min(90%, 250px); margin-bottom: 16px; padding: 12px 14px; border-radius: 14px; background: #fff; color: #141414; }
  .vin-margen > small { font: 700 10px/1 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #6B6A64; }
  .vin-mf { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .vin-mf b { font: 700 12.5px/1.2 var(--font-display); }
  .vin-mf em { padding: 3px 7px; border-radius: 99px; background: #FDE8E8; color: #C62828; font: 700 10px/1.2 var(--font-display); font-style: normal; }
  .vin-mn { display: flex; gap: 14px; font: 500 11px/1.2 var(--font-body); color: #6B6A64; }
  .vin-mn b { color: #141414; font-family: var(--font-display); }
  .vin-mb { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .vin-mb u { display: grid; place-items: center; height: 26px; border-radius: 7px; background: #F2F3F6; font: 700 10.5px/1 var(--font-display); text-decoration: none; }
  .vin-mb u + u { background: #2F55C4; color: #fff; }
  .vin-barras { display: grid; gap: 7px; width: min(90%, 250px); margin-bottom: 16px; padding: 12px 14px; border-radius: 14px; background: #fff; color: #141414; }
  .vin-barras > small { font: 700 10px/1 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #6B6A64; }
  .vin-br { display: grid; gap: 3px; font: 600 11px/1.2 var(--font-display); }
  .vin-br i { display: block; height: 7px; width: var(--w); border-radius: 99px; background: linear-gradient(90deg, #2F55C4, #5B86EA); }
  .vin-impulso { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; width: min(92%, 260px); margin-bottom: 16px; padding: 8px; border-radius: 14px; background: #fff; }
  .vin-impulso > span { display: grid; gap: 5px; }
  .vin-impulso img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .vin-impulso u { display: grid; place-items: center; height: 22px; border-radius: 6px; background: #2F55C4; color: #fff; font: 700 10px/1 var(--font-display); text-decoration: none; }
  .vin-reglas { display: grid; width: min(86%, 250px); margin-bottom: 16px; padding: 6px 14px; border-radius: 16px; background: #fff; color: #141414; }
  .vin-reglas > span { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 9px 0; border-bottom: 1px solid #ECEDEF; }
  .vin-reglas > span:last-child { border-bottom: 0; }
  .vin-reglas small { font: 600 11px/1.2 var(--font-display); color: #6B6A64; }
  .vin-reglas b { font: 700 13px/1.2 var(--font-display); text-align: right; }
  .vin-sobre { display: grid; gap: 8px; width: min(84%, 236px); margin-bottom: 16px; padding: 14px; border-radius: 16px; background: #fff; color: #141414; }
  .vin-sobre small { justify-self: start; padding: 4px 8px; border-radius: 99px; background: #FFF4E5; color: #8A5A00; font: 700 10.5px/1.2 var(--font-display); }
  .vin-sobre b { font: 700 14px/1.2 var(--font-display); }
  .vin-pasos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .vin-pasos i { padding-top: 7px; border-top: 3px solid #E7E8EC; font: 600 10.5px/1.2 var(--font-display); font-style: normal; color: #6B6A64; }
  .vin-pasos i.is-ok { border-color: #1F9D63; color: #17804F; }
  /* entrada: se levantan inclinadas */
  :global(.js-rv) .vin-rejilla .rv { opacity: 0; transform: translateY(26px) rotateX(16deg); transform-origin: 50% 100%; transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.07s); }
  :global(.js-rv) .vin-rejilla .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .vin-rejilla { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(230px, auto); grid-auto-flow: dense; gap: 16px; margin-top: 48px; }
    .vin-txt { padding: 20px 20px 14px; }
    .vin-img { margin: 0 16px; min-height: 120px; }
    .vin-t--ancha .vin-txt { padding: 24px; }
    .vin-t--ancha .vin-txt b { font-size: clamp(22px, 2.2vw, 32px); }
  }
  @media (max-width: 899px) {
    .vin-t--ancha a { flex-direction: column; }
    .vin-t--ancha .vin-img { flex: none; height: 150px; margin: 0 12px; border-radius: 12px 12px 0 0; }
    .vin-t--ancha .vin-dib { flex: none; height: 150px; margin: 0 12px; }
    .vin-img { min-height: 104px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .vin-rejilla .rv { opacity: 1; transform: none; transition: none; }
    .vin-t a, .vin-img img { transition: none; }
  }
</style>
