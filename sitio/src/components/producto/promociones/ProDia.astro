</style>

<script>
  // Lo que el scroll mueve y el CSS no alcanza: el estado de cada tarjeta, la foto del momento y el reloj (manecillas y
  // hora digital). Cada tramo va de su hora a la del siguiente (la última, hasta las 22:00). Lee --p y data-tramo de
  // iniciaEscenas; sin escena, todo se queda en las 21:30.
  (() => {
    const sec = document.querySelector<HTMLElement>('.pdi');
    if (!sec) return;
    const cartas = Array.from(sec.querySelectorAll<HTMLElement>('.pdi-carta'));
    const reloj = sec.querySelector<HTMLElement>('.pdi-reloj');
    const digital = sec.querySelector<HTMLElement>('[data-digital]');
    const fotos = ['dia', 'caja', 'caja', 'noche', 'noche'];
    const horas = [600, 750, 795, 1080, 1290, 1320]; // minutos: 10:00, 12:30, 13:15, 18:00, 21:30, 22:00
    let ultimo = -1, ultimaHora = '';
    const pinta = () => {
      const t = Number(sec.dataset.tramo || 0);
      if (t !== ultimo) {
        ultimo = t;
        cartas.forEach((c, k) => { c.dataset.estado = k < t ? 'antes' : k === t ? 'ahora' : 'despues'; });
        sec.dataset.foto = fotos[t] || 'noche';
      }
      const enEscena = sec.classList.contains('is-escena');
      const p = enEscena ? Number(sec.style.getPropertyValue('--p') || 0) : 1;
      const f = enEscena ? Math.min(1, Math.max(0, p * 5 - t)) : 0;
      const min = enEscena ? horas[t] + (horas[t + 1] - horas[t]) * f : 1290;
      if (reloj) {
        reloj.style.setProperty('--rh', ((min / 60) % 12) * 30 + 'deg');
        reloj.style.setProperty('--rm', (min % 60) * 6 + 'deg');
      }
      const hh = Math.floor(min / 60), mm = Math.floor(min % 60 / 5) * 5;
      const txt = String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0');
      if (digital && txt !== ultimaHora) { ultimaHora = txt; digital.textContent = txt; }
    };
    new MutationObserver(pinta).observe(sec, { attributes: true, attributeFilter: ['style', 'data-tramo', 'class'] });
    pinta();
  })();
</script>
