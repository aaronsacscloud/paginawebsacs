---
/**
 * «Y en tu tienda en línea, también» (/producto/promociones): el módulo propio de la tienda en línea («Cupones y
 * promociones»). La foto de la clienta comprando desde su sillón (gpt-image-2.5) y, encima, la tarjeta de producto de la
 * tienda dibujada con sus textos reales (el precio tachado con «% OFF», el aviso «Agrega $X más para tu…» y el cupón),
 * con una foto REAL del catálogo demo. Entrada: la etiqueta de descuento cae y la barra del aviso se llena. Marino.
 */
import { ONLINE, I } from '../../../data/producto-promociones';
---
<section class="pda pon pd-marino" id="pro-online" aria-labelledby="pon-h">
  <div class="pda-fondo" aria-hidden="true"><span>EN LÍNEA · EN LÍNEA · EN LÍNEA</span><span>EN LÍNEA · EN LÍNEA · EN LÍNEA</span></div>
  <p class="pd-folio"><span>{ONLINE.k}</span><span>Cupones y promociones</span></p>
  <div class="pon-grid">
    <div class="pon-escena" data-pon>
      <figure class="pon-foto">
        <img src={`${I}online-1280.webp`} srcset={`${I}online-900.webp 900w, ${I}online-1280.webp 1280w`} sizes="(min-width: 900px) 52vw, 100vw" width="1280" height="853" alt="Una clienta compra desde su celular, en el sillón de su casa" loading="lazy" decoding="async" />
      </figure>
      <div class="pon-card" role="img" aria-label="La tarjeta del producto en la tienda en línea: camiseta estampada azul de $1,290 a $903 con 30% OFF, el aviso «Agrega $310 más para tu envío gratis» y un cupón escrito">
        <span class="pon-img"><img src={`${I}prenda-azul.webp`} width="240" height="240" alt="" loading="lazy" decoding="async" /><em>30% OFF</em></span>
        <span class="pon-info">
          <b>Camiseta estampada azul</b>
          <span class="pon-precio"><s>$1,290.00</s><strong>$903.00</strong></span>
          <span class="pon-nudge"><small>Agrega $310 más para tu envío gratis</small><i><b></b></i></span>
          <span class="pon-cupon"><span>PRIMAVERA15</span><u>Aplicar</u></span>
        </span>
      </div>
    </div>
    <div class="pon-lado">
      <h2 class="pda-h" id="pon-h">{ONLINE.h}</h2>
      <p class="pon-p">{ONLINE.p}</p>
      <ul class="pon-tipos">{ONLINE.tipos.map((x, i) => <li class="rv" style={`--i:${i}`}>{x}</li>)}</ul>
      <ul class="pon-puntos">{ONLINE.puntos.map((x) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ul>
    </div>
  </div>
</section>

<style>
  .pon-grid { display: grid; gap: 36px; }
  .pon-escena { position: relative; padding-bottom: 92px; }
  .pon-foto { margin: 0; overflow: hidden; border-radius: 22px; aspect-ratio: 4 / 3; }
  .pon-foto img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 66% 40%; }
  .pon-card { position: absolute; left: 14px; right: 14px; bottom: 0; display: grid; grid-template-columns: 112px 1fr; gap: 14px; padding: 14px; border-radius: 18px; background: #fff; color: #141414; box-shadow: 0 30px 50px -26px rgba(0, 0, 0, 0.7); }
  .pon-img { position: relative; align-self: start; }
  .pon-img img { display: block; width: 100%; height: auto; border-radius: 12px; background: #F2F1EE; }
  .pon-img em { position: absolute; left: 6px; top: 6px; padding: 4px 7px; border-radius: 7px; background: #D03A70; color: #fff; font: 800 11px/1 var(--font-display); font-style: normal; }
  .pon-info { display: grid; gap: 8px; align-content: start; }
  .pon-info > b { font: 700 15px/1.2 var(--font-display); }
  .pon-precio { display: flex; align-items: baseline; gap: 8px; }
  .pon-precio s { font: 500 13px/1 var(--font-body); color: #8A8A85; }
  .pon-precio strong { font: 700 20px/1 var(--pd-clash); color: #D03A70; }
  .pon-nudge { display: grid; gap: 5px; padding: 8px 10px; border-radius: 10px; background: #F4F6FA; }
  .pon-nudge small { font: 600 12px/1.3 var(--font-display); color: #2F55C4; }
  .pon-nudge i { display: block; height: 6px; border-radius: 99px; background: #E2E6EF; overflow: hidden; }
  .pon-nudge i b { display: block; width: 74%; height: 100%; border-radius: 99px; background: #2F55C4; transform-origin: 0 50%; }
  .pon-cupon { display: grid; grid-template-columns: 1fr auto; gap: 6px; }
  .pon-cupon span { display: flex; align-items: center; height: 34px; padding: 0 10px; border-radius: 9px; box-shadow: inset 0 0 0 1.5px #D7DAE1; font: 700 13px/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.06em; }
  .pon-cupon u { display: grid; place-items: center; padding: 0 14px; border-radius: 9px; background: #141414; color: #fff; font: 700 12.5px/1 var(--font-display); text-decoration: none; }
  .pon-lado { display: grid; gap: 16px; align-content: start; }
  .pon-p { margin: 0; max-width: 46ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .pon-tipos { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 0; padding: 0; list-style: none; }
  .pon-tipos li { padding: 9px 15px; border-radius: 99px; background: #fff; color: #0A1648; font: 700 14px/1.1 var(--font-display); }
  .pon-puntos { display: grid; gap: 0; margin: 8px 0 0; padding: 0; list-style: none; border-top: 2px solid #fff; }
  .pon-puntos li { display: grid; gap: 4px; padding: 13px 0; border-bottom: 1px solid var(--pd-linea); }
  .pon-puntos b { font: 700 16.5px/1.25 var(--font-display); color: #fff; }
  .pon-puntos span { font: 500 14.5px/1.5 var(--font-body); color: var(--pd-tenue); }
  /* entrada: la etiqueta cae, el precio nuevo aparece y la barra se llena */
  :global(.js-rv) .pon-escena .pon-img em { opacity: 0; transform: translateY(-14px) rotate(-12deg); }
  :global(.js-rv) .pon-escena .pon-precio strong { opacity: 0; }
  :global(.js-rv) .pon-escena .pon-nudge i b { transform: scaleX(0); }
  .pon-escena.is-on .pon-img em { opacity: 1; transform: none; transition: opacity 0.3s ease 0.5s, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s; }
  .pon-escena.is-on .pon-precio strong { opacity: 1; transition: opacity 0.5s ease 0.8s; }
  .pon-escena.is-on .pon-nudge i b { transform: none; transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1) 1s; }
  :global(.js-rv) .pon-tipos .rv { opacity: 0; transform: translateY(-20px); transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: calc(var(--i) * 0.07s); }
  :global(.js-rv) .pon-tipos .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .pon-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 5vw; align-items: center; }
    .pon-escena { padding-bottom: 0; }
    .pon-foto { aspect-ratio: 4 / 4.2; width: 88%; }
    .pon-card { left: auto; right: 0; bottom: 8%; width: min(80%, 420px); grid-template-columns: 128px 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .pon-escena .pon-img em, :global(.js-rv) .pon-escena .pon-precio strong, :global(.js-rv) .pon-escena .pon-nudge i b, :global(.js-rv) .pon-tipos .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // La tarjeta se anima la primera vez que se ve.
  (() => {
    const el = document.querySelector<HTMLElement>('[data-pon]');
    if (!el) return;
    if (!('IntersectionObserver' in window)) { el.classList.add('is-on'); return; }
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { el.classList.add('is-on'); io.disconnect(); } }, { threshold: 0.4 });
    io.observe(el);
  })();
</script>
