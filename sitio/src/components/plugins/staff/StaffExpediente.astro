---
/**
 * «Todo de cada persona, en un solo lugar» (/plugins/staff): el expediente digital. Arriba, la lista REAL de empleados
 * activos de la cuenta dibujotecnico (sin el registro de prueba); abajo, el cajón del expediente con sus pestañas
 * reales, que aquí se pueden tocar (Resumen · Documentos · Vacaciones · Kardex · Ciclo). Sin JS se ven todas, una
 * debajo de otra. Sin datos sensibles: el recorte deja fuera salario, CURP/RFC/NSS, domicilio y teléfono.
 */
import { EXPEDIENTE } from '../../../data/plugin-staff';
import StaffVentana from './StaffVentana.astro';
const I = '/images/plugins/staff/';
---
<section class="pda sex" id="staff-expediente" aria-labelledby="sex-h">
  <p class="pd-folio"><span>{EXPEDIENTE.k}</span><span>Lista de Empleados</span></p>
  <div class="sex-cab">
    <h2 class="pda-h" id="sex-h">{EXPEDIENTE.h}</h2>
    <p class="sex-p">{EXPEDIENTE.p}</p>
  </div>
  <div class="sex-lista rv">
    <StaffVentana src={`${I}lista.webp`} w={2168} h={962} movil={{ src: `${I}lista-movil.webp`, w: 916, h: 962 }} alt="La lista de empleados activos: cada persona con su puesto, su sucursal, su antigüedad y sus días de vacaciones" barra="Lista de Empleados" />
  </div>

  <div class="sex-cajon" data-pestanas>
    <div class="sex-tabs" role="tablist" aria-label="Pestañas del expediente">
      {EXPEDIENTE.pestanas.map((t, i) => (
        <button type="button" role="tab" id={`sex-tab-${t.id}`} aria-controls={`sex-pan-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>
          <b>{t.t}</b><span>{t.d}</span>
        </button>
      ))}
      <p class="sex-privado"><span aria-hidden="true">🔒</span>{EXPEDIENTE.privado}</p>
    </div>
    <div class="sex-paneles">
      {EXPEDIENTE.pestanas.map((t, i) => (
        <div class="sex-panel" role="tabpanel" id={`sex-pan-${t.id}`} aria-labelledby={`sex-tab-${t.id}`} data-panel={t.id} data-activo={i === 0 ? '' : undefined}>
          <figure class="sex-hoja"><img src={`${I}${t.img}.webp`} width={t.w} height={t.h} alt={`El expediente de una colaboradora, pestaña ${t.t}`} loading="lazy" decoding="async" /></figure>
        </div>
      ))}
    </div>
  </div>
  <ul class="sex-acciones" aria-label="Lo que haces desde el expediente">{EXPEDIENTE.acciones.map((a) => <li>{a}</li>)}</ul>
</section>

<style>
  .sex { background: #fff; color: #141414; --pd-texto: #141414; --pd-tenue: #45433E; --pd-filete: rgba(20, 20, 20, 0.16); }
  .sex-cab { display: grid; gap: 14px; }
  .sex-p { margin: 0; max-width: 46ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .sex-lista { margin-top: 36px; }
  .sex-cajon { display: grid; gap: 20px; margin-top: 48px; }
  .sex-tabs { display: grid; gap: 8px; align-content: start; }
  .sex-tabs button { display: grid; gap: 4px; padding: 14px 16px; border: 1px solid rgba(20, 20, 20, 0.12); border-radius: 14px; background: #F7F7F5; color: #141414; text-align: left; cursor: pointer; font: inherit; transition: background 0.25s, border-color 0.25s, transform 0.25s; }
  .sex-tabs button b { font: 700 16px/1.2 var(--font-display); }
  .sex-tabs button span { display: none; font: 500 14px/1.45 var(--font-body); color: #45433E; }
  .sex-tabs button[aria-selected='true'] { background: #141414; border-color: #141414; color: #fff; }
  .sex-tabs button[aria-selected='true'] span { display: block; color: rgba(255, 255, 255, 0.85); }
  .sex-tabs button:hover { border-color: #141414; }
  .sex-tabs button:focus-visible { outline: 3px solid #2F55C4; outline-offset: 2px; }
  .sex-privado { display: flex; gap: 8px; margin: 8px 0 0; padding: 12px 14px; border-radius: 12px; background: #EEF3FD; font: 600 13.5px/1.45 var(--font-display); color: #1F3F99; }
  .sex-paneles { position: relative; }
  .sex-hoja { margin: 0; overflow: hidden; border-radius: 16px; background: #fff; box-shadow: 0 30px 60px -34px rgba(16, 24, 40, 0.45), 0 0 0 1px rgba(16, 24, 40, 0.08); }
  .sex-hoja img { display: block; width: 100%; height: auto; }
  /* sin JS: todas las hojas, una debajo de otra; con JS, solo la de la pestaña */
  .sex-panel + .sex-panel { margin-top: 16px; }
  :global(.js-tabs) .sex-panel { display: none; margin: 0; }
  :global(.js-tabs) .sex-panel[data-activo] { display: block; animation: sexEntra 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  .sex-acciones { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; padding: 0; list-style: none; }
  .sex-acciones li { padding: 8px 14px; border-radius: 99px; background: #F2F2EF; font: 600 13px/1 var(--font-display); color: #141414; }
  @keyframes sexEntra { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  :global(.js-rv) .sex .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js-rv) .sex .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .sex-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .sex-lista { margin-top: 52px; }
    .sex-cajon { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 4vw; margin-top: 72px; align-items: start; }
    .sex-paneles { max-width: 560px; justify-self: end; width: 100%; }
  }
  @media (max-width: 899px) {
    /* las pestañas en una fila que se desliza */
    .sex-tabs { grid-auto-flow: column; grid-auto-columns: max-content; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
    .sex-tabs::-webkit-scrollbar { display: none; }
    .sex-tabs button { padding: 10px 14px; }
    .sex-tabs button span { display: none !important; }
    .sex-privado { grid-column: 1 / -1; display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-tabs) .sex-panel[data-activo] { animation: none; }
    :global(.js-rv) .sex .rv { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Pestañas del expediente: clic o flechas del teclado; la hoja cambia. Sin JS se ven todas.
  (() => {
    const caja = document.querySelector<HTMLElement>('[data-pestanas]');
    if (!caja) return;
    document.documentElement.classList.add('js-tabs');
    const tabs = Array.from(caja.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = Array.from(caja.querySelectorAll<HTMLElement>('[data-panel]'));
    const activa = (id: string, foco = false) => {
      tabs.forEach((t) => { const on = t.dataset.tab === id; t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1; if (on && foco) t.focus(); });
      paneles.forEach((p) => { if (p.dataset.panel === id) p.setAttribute('data-activo', ''); else p.removeAttribute('data-activo'); });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activa(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k !== 'ArrowRight' && k !== 'ArrowLeft' && k !== 'ArrowDown' && k !== 'ArrowUp') return;
        e.preventDefault();
        const n = (i + (k === 'ArrowRight' || k === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        activa(tabs[n].dataset.tab!, true);
      });
    });
  })();
</script>
