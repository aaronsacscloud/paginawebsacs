---
/**
 * «Vacaciones por ley, sin Excel» (/plugins/staff): la tabla de la LFT 2023 (12 → 32 días por años de servicio) en
 * barras que crecen al verse; la foto de una vendedora en su descanso con su app REAL de solicitudes (SACSMobile); los
 * tres pasos de una solicitud y los tipos de solicitud que hay. Azul, como un acto de Planeación.
 */
import { VACACIONES } from '../../../data/plugin-staff';
const I = '/images/plugins/staff/';
const max = Math.max(...VACACIONES.tabla.map((x) => x.d));
---
<section class="pda sva pd-azul" id="staff-vacaciones" aria-labelledby="sva-h">
  <p class="pd-folio"><span>{VACACIONES.k}</span><span>LFT · reforma 2023</span></p>
  <div class="sva-grid">
    <div class="sva-txt">
      <h2 class="pda-h" id="sva-h">{VACACIONES.h}</h2>
      <p class="sva-p">{VACACIONES.p}</p>
      <figure class="sva-ley rv" aria-label="Días de vacaciones por años de servicio, según la Ley Federal del Trabajo">
        <div class="sva-barras">
          {VACACIONES.tabla.map((x, i) => (
            <span class="sva-b" style={`--h:${((x.d / max) * 100).toFixed(1)}%;--i:${i}`}><b>{x.d}</b><i></i><small>{x.a}</small></span>
          ))}
        </div>
        <figcaption><span>Años de servicio</span><span>Días de vacaciones</span></figcaption>
      </figure>
      <ol class="sva-pasos">{VACACIONES.pasos.map((p, i) => <li class="rv" style={`--i:${i + 1}`}><b>{p.n}</b><span><strong>{p.t}</strong>{p.d}</span></li>)}</ol>
    </div>
    <div class="sva-foto rv">
      <img class="sva-img" src={`${I}descanso-800.webp`} srcset={`${I}descanso-800.webp 800w, ${I}descanso-1024.webp 1024w`} sizes="(min-width: 900px) 40vw, 100vw" width="800" height="1200" alt="Una vendedora en su descanso revisa su celular en el cuarto de personal de la boutique" loading="lazy" decoding="async" />
      <figure class="sva-tel"><img src={`${I}tel-vacaciones.webp`} width="780" height="1688" alt="Sus solicitudes en la app: vacaciones aprobadas y su saldo de días" loading="lazy" decoding="async" /></figure>
    </div>
  </div>
  <ul class="sva-tipos" aria-label="Tipos de solicitud">{VACACIONES.tipos.map((t) => <li>{t}</li>)}</ul>
</section>

<style>
  .sva-grid { display: grid; gap: 36px; }
  .sva-p { margin: 18px 0 0; max-width: 48ch; font: 500 17px/1.55 var(--font-body); color: #fff; }
  .sva-ley { margin: 30px 0 0; padding: 18px 18px 14px; border-radius: 18px; background: rgba(255, 255, 255, 0.12); }
  .sva-barras { display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 6px; align-items: end; height: 170px; }
  /* cada barra: el número, la barra (alto proporcional a los días) y los años, apilados desde abajo */
  .sva-b { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 5px; height: 100%; }
  .sva-b b { font: 700 12.5px/1 var(--pd-clash); color: #fff; }
  .sva-b i { display: block; width: 100%; height: calc(var(--h) * 0.72); border-radius: 6px 6px 2px 2px; background: linear-gradient(180deg, #fff, rgba(255, 255, 255, 0.55)); transform-origin: 50% 100%; }
  .sva-b small { font: 600 9.5px/1 var(--font-display); color: rgba(255, 255, 255, 0.85); white-space: nowrap; }
  .sva-ley figcaption { display: flex; justify-content: space-between; margin-top: 10px; font: 600 11px/1 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
  .sva-pasos { display: grid; margin: 26px 0 0; padding: 0; list-style: none; border-top: 2px solid #fff; }
  .sva-pasos li { display: grid; grid-template-columns: 44px 1fr; gap: 8px; padding: 14px 0; border-bottom: 1px solid var(--pd-filete); }
  .sva-pasos b { font: 700 18px/1.3 var(--pd-clash); color: #fff; }
  .sva-pasos span { display: grid; gap: 3px; font: 500 15px/1.5 var(--font-body); color: #fff; }
  .sva-pasos strong { font: 700 17px/1.25 var(--font-display); }
  .sva-foto { position: relative; margin-bottom: 40px; }
  .sva-img { display: block; width: 100%; height: auto; border-radius: 22px; }
  .sva-tel { position: absolute; right: -6px; bottom: -40px; width: 44%; margin: 0; padding: 6px; border-radius: 30px; background: #141418; box-shadow: 0 16px 30px -16px rgba(0, 0, 0, 0.6); }
  .sva-tel img { display: block; width: 100%; height: auto; border-radius: 25px; }
  .sva-tipos { display: flex; flex-wrap: wrap; gap: 8px; margin: 40px auto 0; padding: 0; list-style: none; }
  .sva-tipos li { padding: 8px 14px; border-radius: 99px; background: rgba(255, 255, 255, 0.16); color: #fff; font: 600 13px/1 var(--font-display); }
  :global(.js-rv) .sva .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i, 0) * 0.1s); }
  :global(.js-rv) .sva .rv.is-on { opacity: 1; transform: none; }
  :global(.js-rv) .sva-ley.rv .sva-b i { transform: scaleY(0); transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(0.2s + var(--i) * 0.06s); }
  :global(.js-rv) .sva-ley.rv.is-on .sva-b i { transform: none; }
  @media (min-width: 900px) {
    .sva-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 5vw; align-items: start; }
    .sva-barras { height: 200px; gap: 8px; }
    .sva-b small { font-size: 10.5px; }
    .sva-foto { margin-top: 20px; }
    .sva-tel { right: -24px; width: 46%; }
  }
  /* teléfono: barras acostadas (de pie, las etiquetas «11–15» se enciman) */
  @media (max-width: 599px) {
    .sva-barras { display: grid; grid-template-columns: 1fr; gap: 6px; height: auto; }
    .sva-b { display: grid; grid-template-columns: 52px 1fr 26px; align-items: center; gap: 8px; height: auto; }
    .sva-b small { order: 0; text-align: right; font-size: 11.5px; }
    .sva-b i { order: 1; width: var(--h); height: 12px; border-radius: 2px 6px 6px 2px; background: linear-gradient(90deg, rgba(255, 255, 255, 0.55), #fff); transform-origin: 0 50%; }
    .sva-b b { order: 2; font-size: 13px; }
    :global(.js-rv) .sva-ley.rv .sva-b i { transform: scaleX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .sva .rv { opacity: 1; transform: none; transition: none; }
    :global(.js-rv) .sva-ley.rv .sva-b i { transform: none; transition: none; }
  }
</style>
