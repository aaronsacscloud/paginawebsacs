---
/**
 * «Todo lo que incluye» (/plugins/staff): el mapa del plugin en una rejilla de tarjetas de color, cada una con su
 * pantalla real (recortes de la cuenta dibujotecnico) y un enlace a su sección. La app del colaborador va alta; el
 * reloj checador, los premios y la prenómina, anchos (así las tres filas quedan completas: 4 + 3 + 2 en escritorio). Cada tarjeta entra al verse (.rv → .is-on, script de la página).
 */
import { INCLUYE } from '../../../data/plugin-staff';
const PALABRA = Array.from({ length: 3 }, () => 'TODO INCLUIDO').join(' · ');
---
<section class="pda sin pd-negro" aria-labelledby="sin-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <p class="pd-folio"><span>Todo lo que incluye</span><span>8 piezas, un solo plugin</span></p>
  <h2 class="pda-h" id="sin-h">De la entrada al expediente.</h2>
  <p class="sin-p">Esto es Staff completo. Toca cualquier pieza para verla por dentro, con pantallas reales de una cuenta que ya lo usa.</p>
  <ul class="sin-rejilla">
    {INCLUYE.map((x, i) => (
      <li class:list={['sin-t', `sin-t--${x.tono}`, `sin-t--${x.id.replace('staff-', '')}`, { 'sin-t--ancha': x.ancha }, 'rv']} style={`--i:${i}`}>
        <a href={`#${x.id}`}>
          <span class="sin-txt"><b>{x.t}</b><span>{x.d}</span><em aria-hidden="true">Ver →</em></span>
          {x.img ? (
            <span class="sin-img"><img src={x.img} width={x.w} height={x.h} alt="" loading="lazy" decoding="async" /></span>
          ) : (
            <span class="sin-acta" aria-hidden="true">
              <span class="sin-acta-hoja"><small>Acta administrativa</small><b>AA-2026-0012</b><i></i><i></i><i></i><span class="sin-acta-firmas"><u></u><u></u><u></u></span><span class="sin-acta-qr"></span></span>
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .sin-p { margin: 18px 0 0; max-width: 52ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .sin-rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 36px auto 0; padding: 0; list-style: none; }
  .sin-t a { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: 20px; background: var(--fondo); color: var(--tinta); text-decoration: none; transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .sin-t a:hover { transform: translateY(-4px); color: var(--tinta); text-decoration: none; }
  .sin-t a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .sin-t--negro { --fondo: #1C1C1F; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.72); --acento: #9DB8F5; }
  .sin-t--fucsia { --fondo: #D03A70; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.9); --acento: #fff; }
  .sin-t--marfil { --fondo: #F5F3EE; --tinta: #141414; --tenue: #45433E; --acento: #2F55C4; }
  .sin-t--marino { --fondo: #0A1648; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.78); --acento: #9DB8F5; }
  .sin-t--azul { --fondo: #4470D8; --tinta: #fff; --tenue: rgba(255, 255, 255, 0.92); --acento: #fff; }
  .sin-txt { display: grid; gap: 5px; padding: 16px 16px 12px; }
  .sin-txt b { font: 700 clamp(17px, 1.5vw, 22px)/1.12 var(--pd-clash); letter-spacing: -0.01em; }
  .sin-txt > span { font: 500 13.5px/1.45 var(--font-body); color: var(--tenue); }
  .sin-txt em { margin-top: 4px; font: 700 12.5px/1 var(--font-display); font-style: normal; color: var(--acento); }
  .sin-img { position: relative; flex: 1; min-height: 110px; margin: 0 12px; overflow: hidden; border-radius: 12px 12px 0 0; background: #fff; box-shadow: 0 -10px 30px -18px rgba(0, 0, 0, 0.5); }
  .sin-img img { position: absolute; left: 0; top: 0; width: 100%; height: auto; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .sin-t a:hover .sin-img img { transform: translateY(-3%); }
  /* la app del colaborador: el teléfono completo, alto */
  .sin-t--app { grid-row: span 2; }
  .sin-t--app .sin-img { margin: 0 auto; width: 74%; border-radius: 22px 22px 0 0; background: #F4F6FA; }
  .sin-t--ancha { grid-column: span 2; }
  .sin-t--ancha a { flex-direction: row; align-items: stretch; }
  .sin-t--ancha .sin-txt { flex: 1; align-content: center; }
  .sin-t--ancha .sin-img { flex: 0 0 52%; margin: 14px 14px 0 0; border-radius: 14px 14px 0 0; }
  /* el acta (no hay pantalla pública: un documento dibujado) */
  .sin-acta { display: grid; place-items: end center; flex: 1; min-height: 110px; padding: 0 16px; }
  .sin-acta-hoja { position: relative; display: grid; gap: 6px; width: 78%; padding: 12px 12px 34px; border-radius: 10px 10px 0 0; background: #fff; color: #141414; }
  .sin-acta-hoja small { font: 600 9.5px/1 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #7A8090; }
  .sin-acta-hoja b { font: 700 13px/1 var(--font-display); }
  .sin-acta-hoja > i { height: 5px; border-radius: 3px; background: #E7E8EC; }
  .sin-acta-hoja > i:nth-of-type(2) { width: 82%; }
  .sin-acta-hoja > i:nth-of-type(3) { width: 64%; }
  .sin-acta-firmas { display: flex; gap: 8px; margin-top: 6px; }
  .sin-acta-firmas u { flex: 1; height: 14px; border-bottom: 1.5px solid #141414; background: radial-gradient(ellipse at 40% 70%, transparent 55%, transparent 56%), none; }
  .sin-acta-qr { position: absolute; right: 10px; bottom: 8px; width: 24px; height: 24px; background: conic-gradient(from 90deg, #141414 25%, #fff 0 50%, #141414 0 75%, #fff 0) 0 0 / 8px 8px; }
  :global(.js-rv) .sin-rejilla .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.06s); }
  :global(.js-rv) .sin-rejilla .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .sin-rejilla { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(230px, auto); gap: 16px; margin-top: 48px; }
    .sin-txt { padding: 20px 20px 14px; }
    .sin-img { margin: 0 16px; min-height: 120px; }
    .sin-t--ancha .sin-txt { padding: 24px; }
    .sin-t--ancha .sin-txt b { font-size: clamp(22px, 2.2vw, 32px); }
  }
  @media (max-width: 899px) {
    .sin-t--ancha a { flex-direction: column; }
    .sin-t--ancha .sin-img { flex: none; height: 150px; margin: 0 12px; border-radius: 12px 12px 0 0; }
    .sin-t--app .sin-img { width: 82%; }
    .sin-img { min-height: 104px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .sin-rejilla .rv { opacity: 1; transform: none; transition: none; }
    .sin-t a, .sin-img img { transition: none; }
  }
</style>
