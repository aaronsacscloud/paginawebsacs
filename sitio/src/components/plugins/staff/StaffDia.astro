---
/**
 * «Abres Sacs y ya sabes qué hacer» (/plugins/staff): el Dashboard de Empleados real de la cuenta dibujotecnico
 * (3-oct-2026), en tres recortes con su número: lo que te está esperando, la asistencia de hoy y las solicitudes
 * pendientes. Las tarjetas que en el sistema dicen «Próximamente» no se muestran. Marfil, como una doble página.
 */
import { DIA } from '../../../data/plugin-staff';
import StaffVentana from './StaffVentana.astro';
const I = '/images/plugins/staff/';
---
<section class="pda sdi pd-marfil" id="staff-dia" aria-labelledby="sdi-h">
  <p class="pd-folio"><span>{DIA.k}</span><span>Lo primero que ves</span></p>
  <div class="sdi-cab">
    <h2 class="pda-h" id="sdi-h">{DIA.h}</h2>
    <p class="sdi-p">{DIA.p}</p>
  </div>
  <div class="sdi-collage">
    <div class="sdi-a rv" style="--i:0">
      <span class="sdi-n" aria-hidden="true">01</span>
      <StaffVentana src={`${I}dash-espera.webp`} w={2280} h={316} movil={{ src: `${I}dash-espera-movil.webp`, w: 1144, h: 316 }} alt="Dashboard de Empleados: 3 solicitudes por aprobar, 10 justificantes por revisar, 0 cambios de turno y 0 actas por aprobar" barra="Dashboard de Empleados" />
    </div>
    <div class="sdi-b rv" style="--i:1">
      <span class="sdi-n" aria-hidden="true">02</span>
      <StaffVentana src={`${I}dash-hoy.webp`} w={756} h={380} alt="Asistencia de hoy: 9 de 24 activos ya marcaron, 7 a tiempo, 0 con retardo y 15 sin marcar" />
    </div>
    <div class="sdi-c rv" style="--i:2">
      <StaffVentana src={`${I}dash-solicitudes.webp`} w={1140} h={392} alt="Solicitudes pendientes: permisos con y sin goce y tiempo extra, marcadas en rojo las que llevan más días esperando" />
    </div>
  </div>
  <ol class="sdi-notas">
    {DIA.notas.map((n, i) => <li class="rv" style={`--i:${i + 2}`}><b>{n.n}</b><span><strong>{n.t}</strong>{n.d}</span></li>)}
  </ol>
</section>

<style>
  .sdi-cab { display: grid; gap: 14px; }
  .sdi-p { margin: 0; max-width: 46ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .sdi-collage { display: grid; gap: 14px; margin-top: 36px; }
  .sdi-a, .sdi-b, .sdi-c { position: relative; }
  .sdi-n { position: absolute; z-index: 2; left: -10px; top: -12px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #141414; color: #fff; font: 700 13px/1 var(--pd-clash); box-shadow: 0 0 0 4px var(--pd-fondo); }
  .sdi-notas { display: grid; gap: 0; margin: 32px 0 0; padding: 0; list-style: none; border-top: 2px solid var(--pd-texto); }
  .sdi-notas li { display: grid; grid-template-columns: 44px 1fr; gap: 8px; padding: 16px 0; border-bottom: 1px solid var(--pd-filete); }
  .sdi-notas b { font: 700 18px/1.3 var(--pd-clash); color: var(--pd-texto); }
  .sdi-notas span { display: grid; gap: 4px; font: 500 15px/1.5 var(--font-body); color: var(--pd-tenue); }
  .sdi-notas strong { font: 700 17px/1.25 var(--font-display); color: var(--pd-texto); }
  :global(.js-rv) .sdi .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.1s); }
  :global(.js-rv) .sdi .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .sdi-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .sdi-collage { grid-template-columns: 0.9fr 1.35fr; gap: 22px; margin-top: 52px; }
    .sdi-a { grid-column: 1 / -1; }
    .sdi-notas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 0; margin-top: 40px; }
    .sdi-notas li { grid-template-columns: 40px 1fr; border-top: 2px solid var(--pd-texto); border-bottom: 0; padding-top: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .sdi .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
