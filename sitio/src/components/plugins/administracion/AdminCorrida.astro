---
/**
 * «Paga lo que toca, de una sola vez» (/plugins/administracion): la Antigüedad de Saldos REAL (tres proveedores de la
 * cuenta demo, sin el renglón de totales, que sumaría los registros de prueba) y la Corrida de Pagos REAL («Pagar lo
 * que vence antes de», pagable, bloqueado, partidas y los grupos por proveedor, hasta «Pagar seleccionadas»). Marino.
 */
import { CORRIDA } from '../../../data/plugin-administracion';
import StaffVentana from '../staff/StaffVentana.astro';
const I = '/images/plugins/administracion/';
---
<section class="pda aco pd-marino" id="admin-corrida" aria-labelledby="aco-h">
  <div class="pda-fondo" aria-hidden="true"><span>PAGOS · CORRIDA · PAGOS</span><span>PAGOS · CORRIDA · PAGOS</span></div>
  <p class="pd-folio"><span>{CORRIDA.k}</span><span>Antigüedad de saldos</span></p>
  <h2 class="pda-h" id="aco-h">{CORRIDA.h}</h2>
  <p class="aco-p">{CORRIDA.p}</p>
  <p class="aco-desliza" aria-hidden="true">Desliza para verla completa →</p>
  <div class="aco-corrida rv">
    <StaffVentana src={`${I}corrida.webp`} w={2400} h={1580} alt="La corrida de pagos: pagar lo que vence antes del 10 de octubre; lo pagable, lo bloqueado y once partidas, agrupadas por proveedor con su folio, su concepto, su vencimiento y su monto, y el botón Pagar seleccionadas" />
  </div>
  <div class="aco-grid">
    <p class="aco-desliza aco-desliza--b" aria-hidden="true">Desliza para ver todos los plazos →</p>
    <div class="aco-antig rv" id="admin-antiguedad">
      <StaffVentana src={`${I}antiguedad.webp`} w={2400} h={834} alt="Antigüedad de saldos: cuánto le debes a cada proveedor y desde cuándo, por vencer, de 1 a 30, de 31 a 60, de 61 a 90 y más de 90 días" />
    </div>
    <ul class="aco-puntos">{CORRIDA.puntos.map((x, i) => <li class="rv" style={`--i:${i}`}><b>{x.t}</b><span>{x.d}</span></li>)}</ul>
  </div>
</section>

<style>
  .aco-p { margin: 18px 0 0; max-width: 54ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .aco-desliza { display: none; }
  .aco-corrida { margin-top: 36px; max-height: 640px; overflow: hidden; border-radius: 14px; }
  .aco-grid { display: grid; gap: 28px; margin-top: 28px; scroll-margin-top: 80px; }
  .aco-antig { scroll-margin-top: 80px; }
  .aco-puntos { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 2px solid #fff; }
  .aco-puntos li { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--pd-filete); }
  .aco-puntos b { font: 700 17px/1.25 var(--font-display); color: #fff; }
  .aco-puntos span { font: 500 14.5px/1.5 var(--font-body); color: var(--pd-tenue); }
  :global(.js-rv) .aco .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i, 0) * 0.08s); }
  :global(.js-rv) .aco .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .aco-corrida { margin-top: 52px; max-height: none; }
    .aco-grid { gap: 36px; margin-top: 40px; }
    .aco-puntos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 0; }
    .aco-puntos li { border-top: 2px solid #fff; border-bottom: 0; padding-top: 16px; }
  }
  @media (max-width: 767px) {
    .aco-desliza { display: block; margin: 28px 0 8px; font: 700 12.5px/1 var(--font-display); color: #9DB8F5; }
    .aco-desliza--b { margin: 0 0 -20px; }
    .aco-corrida { margin-top: 0; max-height: 520px; overflow-x: auto; overscroll-behavior-x: contain; border-radius: 10px; -webkit-mask-image: linear-gradient(#000 82%, transparent); mask-image: linear-gradient(#000 82%, transparent); }
    .aco-corrida > :global(.sv), .aco-antig > :global(.sv) { width: 820px; }
    .aco-antig { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .aco .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
