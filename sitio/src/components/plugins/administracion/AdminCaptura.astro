---
/**
 * «Un gasto, en lo que tardas en tomarle foto» (/plugins/administracion): la captura con IA con el scroll
 * (data-tramos="3"), como el reloj checador de Staff.
 *  0 · Le tomas foto al recibo: la foto (gpt-image-2.5) y el primer paso REAL del asistente («¿Cómo quieres registrar
 *      el gasto?»: Manual · Con Recibo IA · Con Factura IA; cuenta demo).
 *  1 · La IA lo lee: el recibo de ejemplo con la línea que lo recorre, «Escaneando recibo… / Extrayendo información con
 *      IA» y «Datos extraídos automáticamente» con sus campos entrando uno por uno, como en el asistente real
 *      (sacs3 gastos/wizard-nuevo-gasto.html; textos y colores de ahí). La categoría la elige la IA del catálogo.
 *  2 · Cómo se paga: «¿Cómo se pagará?» con Contado · Parcial · Programado (textos reales), el cronograma de
 *      parcialidades y el gasto ya en Cuentas por pagar.
 * Sin JS o con «reducir movimiento»: las tres cosas, una debajo de otra, ya terminadas, y los pasos en lista.
 */
import { CAPTURA } from '../../../data/plugin-administracion';
import StaffVentana from '../staff/StaffVentana.astro';
const I = '/images/plugins/administracion/';
const { recibo, datos, tipos, cronograma } = CAPTURA;
const ICO: Record<string, string> = {
  store: 'M3.5 9.5 5 4h14l1.5 5.5M3.5 9.5h17M4.5 9.5V20h15V9.5M9.5 20v-5.5h5V20',
  calendar: 'M4 6h16v14H4zM4 10.5h16M8.5 3.5v4M15.5 3.5v4',
  tag: 'M3.5 12.5V4h8.5l8.5 8.5-8 8zM8 8h.01',
  doc: 'M7 3.5h7l4.5 4.5v12.5H7zM14 3.5V8h4.5M10 13h5.5M10 16.5h5.5',
  money: 'M12 3.5v17M16.5 7.5c0-1.7-2-2.8-4.5-2.8S7.5 5.8 7.5 7.6s2 2.5 4.5 2.9 4.6 1.3 4.6 3.1-2 3-4.6 3-4.6-1.1-4.6-2.9',
};
const PASOS = ['Método', 'Captura', 'Datos', 'Monto', 'Pago', 'Confirmar'];
---
<section class="acp" id="admin-captura" data-escena data-tramos="3" data-tramo="2" aria-labelledby="acp-h">
  <div class="acp-riel" data-riel>
    <div class="acp-escena">
      <!-- 0 · la foto y el primer paso real -->
      <div class="acp-capa acp-capa--foto">
        <img class="acp-foto" src={`${I}recibo-1536.webp`} srcset={`${I}recibo-1280.webp 1280w, ${I}recibo-1536.webp 1536w`} sizes="100vw" width="1536" height="1024" alt="La encargada de la boutique le toma foto a un recibo con la tablet, sobre el mostrador" loading="lazy" decoding="async" />
        <div class="acp-metodo">
          <StaffVentana src={`${I}metodo.webp`} w={1680} h={960} alt="El primer paso del asistente de Sacs: «¿Cómo quieres registrar el gasto?», manual, con recibo (IA) o con factura (IA)" barra="Nuevo Gasto" />
        </div>
      </div>

      <!-- 1 · la IA lee el recibo -->
      <div class="acp-capa acp-capa--ia">
        <div class="acp-mesa">
          <figure class="acp-ticket" aria-hidden="true">
            <b class="acp-tk-t">{recibo.tienda}</b>
            <small>{recibo.sucursal}</small>
            <small>{recibo.fecha}</small>
            <span class="acp-tk-sep"></span>
            {recibo.lineas.map((l) => <span class="acp-tk-l"><span>{l.d}</span><span>{l.c}</span><span>{l.i}</span></span>)}
            <span class="acp-tk-sep"></span>
            <span class="acp-tk-l acp-tk-l--r"><span>SUBTOTAL</span><span>{recibo.subtotal}</span></span>
            <span class="acp-tk-l acp-tk-l--r"><span>IVA 16%</span><span>{recibo.iva}</span></span>
            <span class="acp-tk-l acp-tk-l--r acp-tk-tot"><span>TOTAL</span><span>${recibo.total}</span></span>
            <small class="acp-tk-gr">GRACIAS POR SU COMPRA</small>
            <i class="acp-scan"></i>
          </figure>
          <div class="acp-wiz" role="img" aria-label={`Sacs leyó el recibo con IA: proveedor ${datos[0].v}, fecha ${datos[1].v}, categoría ${datos[2].v}, concepto ${datos[3].v} y total a pagar $${recibo.total} MXN`}>
            <ol class="acp-steps" aria-hidden="true">{PASOS.map((p, i) => <li class:list={{ 'is-ok': i < 2, 'is-on': i === 2 }}><i>{i < 2 ? '✓' : i + 1}</i>{p}</li>)}</ol>
            <div class="acp-wiz-scan" aria-hidden="true">
              <span class="acp-spin"></span>
              <b>Escaneando recibo...</b>
              <small>Extrayendo información con IA</small>
              <span class="acp-prog"><i></i></span>
            </div>
            <div class="acp-wiz-datos">
              <div class="acp-det-h">
                <span class="acp-ok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                <b>Datos extraídos automáticamente</b>
                <span class="acp-edit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" /></svg>Editar</span>
              </div>
              <div class="acp-campos">
                {datos.map((d, k) => (
                  <div class:list={['acp-campo', { 'acp-campo--ancho': d.ancho }]} style={`--k:${k}`}>
                    <span class="acp-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICO[d.ico]} /></svg></span>
                    <span class="acp-cv"><small>{d.k}</small>{d.chip ? <b class="acp-chip">{d.v}<em>IA</em></b> : <b>{d.v}</b>}</span>
                  </div>
                ))}
                <div class="acp-campo acp-campo--ancho acp-campo--total" style={`--k:${datos.length}`}>
                  <span class="acp-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICO.money} /></svg></span>
                  <span class="acp-cv"><small>Total a Pagar</small><b>${recibo.total} MXN</b></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2 · cómo se paga -->
      <div class="acp-capa acp-capa--pago">
        <div class="acp-pago" role="img" aria-label="¿Cómo se pagará? Contado, parcial o programado; programado en tres parcialidades de $928.00, y el gasto queda en Cuentas por pagar">
          <ol class="acp-steps" aria-hidden="true">{PASOS.map((p, i) => <li class:list={{ 'is-ok': i < 4, 'is-on': i === 4 }}><i>{i < 4 ? '✓' : i + 1}</i>{p}</li>)}</ol>
          <p class="acp-pago-h">¿Cómo se pagará?</p>
          <p class="acp-pago-s">Define si es un pago único o se difiere en parcialidades</p>
          <div class="acp-tipos">
            {tipos.map((t, i) => (
              <span class:list={['acp-tipo', { 'is-sel': i === 2 }]} style={`--i:${i}`}>
                <i class="acp-tipo-ico" aria-hidden="true">{['$', '½', '↻'][i]}</i>
                <b>{t.t}</b><small>{t.d}</small>
              </span>
            ))}
          </div>
          <div class="acp-crono">
            <p class="acp-crono-h">Cronograma de pagos ({cronograma.length})</p>
            {cronograma.map((c, i) => <p class="acp-crono-f" style={`--i:${i}`}><span>{c.n} · {c.f} · Transferencia</span><b>{c.m}</b></p>)}
          </div>
          <p class="acp-listo"><b>✓</b>Listo: queda en Cuentas por pagar, con sus tres vencimientos.</p>
        </div>
      </div>

      <div class="acp-txt">
        <p class="acp-k">{CAPTURA.k}</p>
        <h2 class="acp-h" id="acp-h">{CAPTURA.h}</h2>
        <ol class="acp-pasos">
          {CAPTURA.tramos.map((p, k) => (
            <li class="acp-paso" data-k={k}>
              <span class="acp-paso-n">{p.n}</span>
              <span class="acp-paso-t"><b>{p.t}</b><span>{p.d}</span></span>
              <i class="acp-barra" aria-hidden="true"><b></b></i>
            </li>
          ))}
        </ol>
        <ul class="acp-extra">{CAPTURA.extra.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .acp { position: relative; background: #0B0B0C; color: #fff; }
  .acp-escena { position: relative; overflow: hidden; display: grid; }
  .acp-foto { display: block; width: 100%; height: auto; }

  /* ── sin escena: una debajo de otra ── */
  .acp-capa { position: relative; }
  .acp-metodo { position: relative; width: min(92%, 520px); margin: -64px auto 0; }
  .acp-capa--ia { padding: 40px 20px 0; }
  .acp-capa--pago { padding: 32px 20px 0; }
  .acp-mesa { display: grid; gap: 20px; justify-items: center; }

  /* ── el recibo de papel ── */
  .acp-ticket { position: relative; display: grid; gap: 3px; width: 236px; margin: 0; padding: 18px 16px 26px; background: #FBFAF6; color: #2A2A2A; font: 500 11px/1.35 'JetBrains Mono', ui-monospace, Menlo, monospace; text-transform: uppercase; transform: rotate(-3deg); box-shadow: 0 30px 50px -24px rgba(0, 0, 0, 0.8); overflow: hidden;
    -webkit-mask: linear-gradient(#000, #000) top / 100% calc(100% - 8px) no-repeat, conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 12px 8px repeat-x;
    mask: linear-gradient(#000, #000) top / 100% calc(100% - 8px) no-repeat, conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 12px 8px repeat-x; }
  .acp-tk-t { text-align: center; font-size: 14px; font-weight: 800; letter-spacing: 0.04em; }
  .acp-ticket > small { text-align: center; font-size: 9.5px; color: #555; }
  .acp-tk-sep { height: 0; margin: 6px 0; border-top: 1.5px dashed #9A9A9A; }
  .acp-tk-l { display: grid; grid-template-columns: 1fr auto 62px; gap: 6px; }
  .acp-tk-l > span:last-child { text-align: right; }
  .acp-tk-l--r { grid-template-columns: 1fr auto; }
  .acp-tk-tot { margin-top: 3px; font-size: 13px; font-weight: 800; }
  .acp-tk-gr { margin-top: 10px; }
  .acp-scan { position: absolute; left: 0; right: 0; top: 0; height: 46px; background: linear-gradient(180deg, rgba(91, 134, 234, 0), rgba(91, 134, 234, 0.32) 80%, #5B86EA 100%); opacity: 0; pointer-events: none; }

  /* ── el asistente (diseño de wizard-nuevo-gasto.html) ── */
  .acp-wiz, .acp-pago { position: relative; width: 100%; max-width: 540px; padding: 18px; border-radius: 18px; background: #fff; color: #111827; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.85); font-family: var(--font-body); }
  .acp-steps { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0 0 14px; padding: 0 0 12px; list-style: none; border-bottom: 1px solid #F3F4F6; font: 600 11px/1 var(--font-display); color: #9CA3AF; }
  .acp-steps li { display: inline-flex; align-items: center; gap: 5px; }
  .acp-steps i { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #F3F4F6; color: #6B7280; font: 700 9.5px/1 var(--font-display); font-style: normal; }
  .acp-steps .is-ok { color: #374151; }
  .acp-steps .is-ok i { background: #DBEAFE; color: #2563EB; }
  .acp-steps .is-on { color: #2563EB; }
  .acp-steps .is-on i { background: #2563EB; color: #fff; }
  .acp-wiz-scan { position: absolute; inset: 0; z-index: 2; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border-radius: 18px; background: rgba(0, 0, 0, 0.85); color: #fff; text-align: center; }
  .acp-wiz-scan b { font: 600 19px/1.2 var(--font-display); }
  .acp-wiz-scan small { font: 500 14px/1.3 var(--font-body); color: rgba(255, 255, 255, 0.7); }
  .acp-spin { width: 34px; height: 34px; margin-bottom: 6px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, 0.18); border-top-color: #fff; animation: acpGira 0.9s linear infinite; }
  .acp-prog { width: 200px; height: 4px; margin-top: 12px; overflow: hidden; border-radius: 2px; background: rgba(255, 255, 255, 0.2); }
  .acp-prog i { display: block; width: 100%; height: 100%; background: #fff; transform: scaleX(0); transform-origin: 0 50%; }
  .acp-det-h { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid #F3F4F6; }
  .acp-det-h > b { font: 700 16px/1.2 var(--font-display); color: #111827; }
  .acp-ok { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, #10B981 0%, #059669 100%); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
  .acp-ok svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .acp-edit { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; padding: 6px 10px; border-radius: 8px; color: #3B82F6; font: 600 13px/1 var(--font-display); }
  .acp-edit svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  .acp-campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .acp-campo { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px; border: 1px solid #F3F4F6; border-radius: 12px; background: #F9FAFB; }
  .acp-campo--ancho { grid-column: 1 / -1; }
  .acp-ico { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 10px; background: #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06); }
  .acp-ico svg { width: 19px; height: 19px; fill: none; stroke: #6B7280; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .acp-cv { display: grid; gap: 3px; min-width: 0; }
  .acp-cv small { font: 500 10.5px/1.2 var(--font-display); letter-spacing: 0.03em; text-transform: uppercase; color: #9CA3AF; }
  .acp-cv b { font: 600 14.5px/1.25 var(--font-display); color: #111827; }
  .acp-chip { display: inline-flex; align-items: center; gap: 6px; justify-self: start; padding: 3px 9px; border-radius: 8px; background: #3B82F6; color: #fff !important; font-size: 13px !important; }
  .acp-chip em { padding: 2px 5px; border-radius: 99px; background: rgba(255, 255, 255, 0.25); font: 700 9px/1 var(--font-display); font-style: normal; }
  .acp-campo--total { border: 0; padding: 14px 16px; background: linear-gradient(135deg, #10B981 0%, #059669 100%); }
  .acp-campo--total .acp-ico { background: rgba(255, 255, 255, 0.2); box-shadow: none; }
  .acp-campo--total .acp-ico svg { stroke: #fff; }
  .acp-campo--total small { color: rgba(255, 255, 255, 0.8); }
  .acp-campo--total b { color: #fff; font-size: 19px; font-weight: 700; }

  /* ── ¿Cómo se pagará? ── */
  .acp-pago-h { margin: 0; font: 700 19px/1.2 var(--font-display); color: #111827; }
  .acp-pago-s { margin: 4px 0 14px; font: 500 13px/1.4 var(--font-body); color: #6B7280; }
  .acp-tipos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .acp-tipo { display: grid; justify-items: center; align-content: start; gap: 4px; padding: 14px 10px; border: 2px solid #E5E7EB; border-radius: 14px; background: #fff; text-align: center; }
  .acp-tipo-ico { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 4px; border-radius: 12px; background: #F3F4F6; color: #6B7280; font: 700 19px/1 var(--font-display); font-style: normal; }
  .acp-tipo b { font: 700 15px/1.2 var(--font-display); color: #111827; }
  .acp-tipo small { font: 500 12px/1.4 var(--font-body); color: #6B7280; }
  .acp-tipo.is-sel { border-color: #3B82F6; background: #EFF6FF; }
  .acp-tipo.is-sel .acp-tipo-ico { background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff; }
  .acp-crono { margin-top: 12px; padding: 12px 14px; border: 1px solid #E5E7EB; border-radius: 12px; }
  .acp-crono-h { margin: 0 0 6px; font: 700 12px/1.2 var(--font-display); color: #374151; }
  .acp-crono-f { display: flex; justify-content: space-between; gap: 10px; margin: 0; padding: 7px 0; border-top: 1px solid #F3F4F6; font: 500 12.5px/1.3 var(--font-body); color: #4B5563; }
  .acp-crono-f b { font: 700 13px/1.3 var(--font-display); color: #111827; }
  .acp-listo { display: flex; align-items: center; gap: 10px; margin: 12px 0 0; padding: 11px 14px; border-radius: 12px; background: #ECFDF5; color: #065F46; font: 600 13.5px/1.35 var(--font-display); }
  .acp-listo b { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; background: #10B981; color: #fff; font: 800 12px/1 var(--font-display); }

  /* ── el texto ── */
  .acp-txt { padding: 36px 20px 56px; }
  .acp-k { margin: 0 0 14px; font: 600 12px/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #F07FA6; }
  .acp-h { margin: 0; color: #fff; font: 700 clamp(36px, 4vw, 60px)/0.96 var(--pd-clash, var(--font-display)); letter-spacing: -0.02em; text-wrap: balance; }
  .acp-pasos { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.3); }
  .acp-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 4px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
  .acp-paso-n { font: 700 19px/1.2 var(--pd-clash, var(--font-display)); color: #F07FA6; }
  .acp-paso-t { display: grid; gap: 3px; }
  .acp-paso-t b { font: 700 16px/1.3 var(--font-display); color: #fff; }
  .acp-paso-t > span { font: 500 14.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.82); }
  .acp-barra { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .acp-barra b { display: block; height: 100%; background: #D03A70; transform: scaleX(0); transform-origin: 0 50%; }
  .acp-extra { display: grid; gap: 6px; margin: 16px 0 0; padding: 0; list-style: none; }
  .acp-extra li { position: relative; padding-left: 18px; font: 500 13.5px/1.45 var(--font-body); color: rgba(255, 255, 255, 0.72); }
  .acp-extra li::before { content: '✓'; position: absolute; left: 0; color: #6FD3A3; font-weight: 700; }

  /* ══ con el scroll ══ */
  .acp.is-escena .acp-riel { height: 400vh; }
  .acp.is-escena .acp-escena { position: sticky; top: 0; display: block; height: 100vh; height: 100svh; }
  .acp.is-escena .acp-capa { position: absolute; inset: 0; padding: 0; opacity: 0; visibility: hidden; transition: opacity 0.7s ease, visibility 0s linear 0.7s; }
  .acp.is-escena[data-tramo="0"] .acp-capa--foto, .acp.is-escena[data-tramo="1"] .acp-capa--ia, .acp.is-escena[data-tramo="2"] .acp-capa--pago { opacity: 1; visibility: visible; transition: opacity 0.7s ease, visibility 0s; }
  .acp.is-escena .acp-capa--foto .acp-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% 50%; }
  .acp.is-escena .acp-capa--ia, .acp.is-escena .acp-capa--pago { background: radial-gradient(ellipse at 72% 50%, rgba(208, 58, 112, 0.2), transparent 60%), #0B0B0C; }
  .acp.is-escena .acp-metodo { position: absolute; margin: 0; }
  .acp.is-escena .acp-paso-n { color: rgba(255, 255, 255, 0.45); }
  .acp.is-escena[data-tramo="0"] .acp-paso[data-k="0"] .acp-paso-n, .acp.is-escena[data-tramo="1"] .acp-paso[data-k="1"] .acp-paso-n, .acp.is-escena[data-tramo="2"] .acp-paso[data-k="2"] .acp-paso-n { color: #F07FA6; }
  .acp.is-escena[data-tramo="0"] .acp-paso[data-k="0"] .acp-barra b, .acp.is-escena[data-tramo="1"] .acp-paso[data-k="1"] .acp-barra b, .acp.is-escena[data-tramo="2"] .acp-paso[data-k="2"] .acp-barra b { animation: acpBarra 4.5s linear both; }
  /* 0 · el paso real entra */
  .acp.is-escena[data-tramo="0"] .acp-metodo { animation: acpSube 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both; }
  /* 1 · escanea → los datos entran uno por uno */
  .acp.is-escena .acp-wiz-scan { display: flex; opacity: 0; }
  .acp.is-escena .acp-campo, .acp.is-escena .acp-det-h { opacity: 0; }
  .acp.is-escena[data-tramo="1"] .acp-scan { animation: acpScan 1.9s ease-in-out 0.25s both; }
  .acp.is-escena[data-tramo="1"] .acp-wiz-scan { animation: acpScanCapa 2.6s linear both; }
  .acp.is-escena[data-tramo="1"] .acp-prog i { animation: acpProg 2.1s ease-out 0.2s both; }
  .acp.is-escena[data-tramo="1"] .acp-det-h { animation: acpSube 0.45s ease 2.5s both; }
