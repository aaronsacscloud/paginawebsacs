---
/**
 * «Todo lo que sale, en una sola lista» (/plugins/administracion): la lista REAL de gastos de la cuenta demo (encabezado
 * con «Por pagar», pestañas y cinco renglones reales, sin los registros de prueba ni la columna de proveedor vacía),
 * «A dónde se va el dinero» del Dashboard de análisis (real) y la tarjeta «Alertas y anomalías (30 días)» dibujada con
 * el diseño y los mensajes reales de Sacs y datos de ejemplo (la demo no tiene presupuestos que las disparen).
 * Marfil, como una doble página.
 */
import { GASTOS } from '../../../data/plugin-administracion';
import StaffVentana from '../staff/StaffVentana.astro';
const I = '/images/plugins/administracion/';
---
<section class="pda aga pd-marfil" id="admin-gastos" aria-labelledby="aga-h">
  <p class="pd-folio"><span>{GASTOS.k}</span><span>La lista y el análisis</span></p>
  <div class="aga-cab">
    <h2 class="pda-h" id="aga-h">{GASTOS.h}</h2>
    <p class="aga-p">{GASTOS.p}</p>
  </div>
  <div class="aga-collage">
    <div class="aga-a rv" style="--i:0">
      <span class="aga-n" aria-hidden="true">01</span>
      <StaffVentana src={`${I}gastos-cab.webp`} w={2676} h={168} alt="El encabezado de Gastos: «Saber dónde gastas es el primer paso para crecer», lo que hay por pagar, los gastos sin factura y el botón Nuevo gasto" barra="Gastos" clase="aga-cabv" />
      <p class="aga-desliza" aria-hidden="true">Desliza →</p>
      <div class="aga-lista">
        <StaffVentana src={`${I}gastos-lista.webp`} w={2000} h={754} movil={{ src: `${I}gastos-lista-movil.webp`, w: 1350, h: 754 }} alt="La lista de gastos con sus pestañas (Todos, Pagados, Pendientes, Por aprobar, Sin factura) y cada gasto con su folio, sus fechas, su concepto, su categoría y su importe" />
      </div>
    </div>
    <div class="aga-b rv" style="--i:1">
      <span class="aga-n" aria-hidden="true">02</span>
      <StaffVentana src={`${I}categorias.webp`} w={1254} h={554} alt="«A dónde se va el dinero»: el gasto del periodo por categoría, de nómina a mantenimiento" barra="Dashboard de análisis" clase="aga-catv" />
      <figure class="aga-cat" aria-label="A dónde se va el dinero: el gasto del periodo por categoría">
        <p class="aga-al-t"><span aria-hidden="true">◇</span>A dónde se va el dinero</p>
        {GASTOS.categorias.map((c) => <p class="aga-cat-f"><span>{c.n}</span><i><b style={`width:${c.pct}%`}></b></i><strong>{c.t} <small>({c.c})</small></strong></p>)}
      </figure>
    </div>
    <div class="aga-c rv" style="--i:2">
      <span class="aga-n" aria-hidden="true">03</span>
      <figure class="aga-alertas" aria-label="Ejemplo de la tarjeta de alertas y anomalías del Dashboard de análisis">
        <p class="aga-al-t"><span aria-hidden="true">◎</span>Alertas y anomalías (30 días)<i class="aga-ej">Ejemplo</i></p>
        {GASTOS.alertas.map((a) => (
          <div class="aga-al-row">
            <p class="aga-al-c">{a.folio} · {a.concepto}</p>
            <p class="aga-al-d">{a.detalle}</p>
            {a.msgs.map((m) => <p class:list={['aga-al-msg', { 'is-rojo': m.nivel === 'rojo' }]}>{m.msg}</p>)}
          </div>
        ))}
      </figure>
    </div>
  </div>
  <ol class="aga-notas">
    {GASTOS.notas.map((n, i) => <li class="rv" style={`--i:${i + 2}`}><b>{n.n}</b><span><strong>{n.t}</strong>{n.d}</span></li>)}
  </ol>
</section>

<style>
  .aga-cab { display: grid; gap: 14px; }
  .aga-p { margin: 0; max-width: 46ch; font: 500 17px/1.55 var(--font-body); color: var(--pd-tenue); }
  .aga-collage { display: grid; gap: 14px; margin-top: 36px; }
  .aga-a, .aga-b, .aga-c { position: relative; }
  .aga-a { display: grid; gap: 10px; }
  .aga-desliza { display: none; }
  .aga-n { position: absolute; z-index: 2; left: -10px; top: -12px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #141414; color: #fff; font: 700 13px/1 var(--pd-clash); box-shadow: 0 0 0 4px var(--pd-fondo); }
  /* «A dónde se va el dinero» dibujada (solo en el teléfono: la captura no se lee a ese ancho); diseño de
     gastos/demo.html: .flujo-semana-row, .flujo-semana-bar.cat */
  .aga-cat { display: none; margin: 0; padding: 16px 16px 10px; border-radius: 14px; background: #fff; color: #0F172A; box-shadow: 0 12px 24px -14px rgba(16, 24, 40, 0.45), 0 0 0 1px rgba(16, 24, 40, 0.06); }
  .aga-cat-f { display: grid; grid-template-columns: 96px minmax(0, 1fr) 108px; gap: 10px; align-items: center; margin: 0; padding: 6px 0; }
  .aga-cat-f span { font: 500 12.5px/1.2 var(--font-body); color: #64748B; }
  .aga-cat-f i { height: 10px; overflow: hidden; border-radius: 999px; background: #F1F5F9; }
  .aga-cat-f b { display: block; height: 100%; min-width: 2px; border-radius: 999px; background: linear-gradient(90deg, #A78BFA, #7C3AED); }
  .aga-cat-f strong { font: 700 13px/1.2 var(--font-display); color: #0F172A; text-align: right; font-variant-numeric: tabular-nums; }
  .aga-cat-f small { font-weight: 500; color: #94A3B8; }
  /* la tarjeta de alertas (diseño de gastos/demo.html: .analisis-card, .anomalia-row, .anomalia-msg) */
  .aga-alertas { margin: 0; padding: 18px 20px 12px; border-radius: 14px; background: #fff; color: #0F172A; box-shadow: 0 30px 60px -34px rgba(16, 24, 40, 0.45), 0 0 0 1px rgba(16, 24, 40, 0.06); }
  .aga-al-t { display: flex; align-items: center; gap: 8px; margin: 0 0 6px; font: 700 14.5px/1.2 var(--font-display); }
  .aga-al-t > span { color: #2563EB; font-size: 17px; }
  .aga-ej { margin-left: auto; padding: 4px 9px; border-radius: 99px; background: #F2C46B; color: #141414; font: 700 10px/1 var(--font-display); font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; }
  .aga-al-row { padding: 10px 0; border-bottom: 1px solid #F1F5F9; }
  .aga-al-row:last-child { border-bottom: 0; }
  .aga-al-c { margin: 0; font: 600 14px/1.3 var(--font-display); color: #0F172A; }
  .aga-al-d { margin: 2px 0 0; font: 500 12.5px/1.3 var(--font-body); color: #64748B; }
  .aga-al-msg { margin: 6px 0 0; padding: 7px 10px; border-radius: 8px; border: 1px solid #FDE68A; background: #FFFBEB; color: #92400E; font: 500 12.5px/1.45 var(--font-body); }
  .aga-al-msg.is-rojo { border-color: #FECACA; background: #FEF2F2; color: #991B1B; }
  .aga-notas { display: grid; gap: 0; margin: 32px 0 0; padding: 0; list-style: none; border-top: 2px solid var(--pd-texto); }
  .aga-notas li { display: grid; grid-template-columns: 44px 1fr; gap: 8px; padding: 16px 0; border-bottom: 1px solid var(--pd-filete); }
  .aga-notas b { font: 700 18px/1.3 var(--pd-clash); color: var(--pd-texto); }
  .aga-notas span { display: grid; gap: 4px; font: 500 15px/1.5 var(--font-body); color: var(--pd-tenue); }
  .aga-notas strong { font: 700 17px/1.25 var(--font-display); color: var(--pd-texto); }
  :global(.js-rv) .aga .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.1s); }
  :global(.js-rv) .aga .rv.is-on { opacity: 1; transform: none; }
  @media (min-width: 900px) {
    .aga-cab { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 5vw; }
    .aga-collage { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; margin-top: 52px; align-items: start; }
    .aga-a { grid-column: 1 / -1; }
    .aga-notas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 0; margin-top: 40px; }
    .aga-notas li { grid-template-columns: 40px 1fr; border-top: 2px solid var(--pd-texto); border-bottom: 0; padding-top: 18px; }
  }
  @media (max-width: 767px) {
    /* el encabezado azul no se lee a lo ancho del teléfono: la lista ya trae sus pestañas */
    .aga-a :global(.aga-cabv), .aga-b :global(.aga-catv) { display: none; }
    .aga-cat { display: block; }
    /* la lista se desliza: a lo ancho del teléfono no se leería */
    .aga-desliza { display: block; margin: 0 0 -2px 34px; font: 700 12.5px/1 var(--font-display); color: #2F55C4; }
    .aga-lista { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 10px; }
    .aga-lista > :global(.sv) { width: 600px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-rv) .aga .rv { opacity: 1; transform: none; transition: none; }
  }
</style>
