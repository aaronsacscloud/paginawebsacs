---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonical?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  canonical,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://www.sacscloud.com';
const pageUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
/* La marca se escribe «Sacs», no «SACS»: así es como se ve en el sitio y como
   la dice el cliente. En mayúsculas parecía un acrónimo de otra cosa —y de
   hecho SACS lo es de varias—, que es justo lo que no conviene cuando lo que se
   busca es que un buscador y un modelo reconozcan UNA entidad. El nombre único
   y sin ambigüedad (Sacscloud) va en los datos estructurados, donde sirve para
   identificar; el título lleva el nombre corto, que es el que la gente lee. */
// Y si el título YA dice la marca, no se repite: «Todo lo que hace Sacs | Sacs»
// gasta en la coletilla los caracteres que el buscador sí recorta.
// Amby es el CRM (23-sep-2026): su pestaña dice «Amby CRM», sin «| Sacs» detrás.
const fullTitle = /\b(sacs(cloud)?|amby)\b/i.test(title) ? title : `${title} | Sacs`;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={pageUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<!-- El idioma de la ficha social sale de la RUTA, no de una constante: desde el
     19-sep-2026 hay seis páginas reales en /en/, y anunciarlas como es_MX le
     dice a Facebook y a LinkedIn que la página está en español cuando no lo
     está. -->
<meta property="og:locale" content={Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en' ? 'en_US' : 'es_MX'} />
<!-- Tiene que decir lo MISMO que `name` en el schema WebSite: si los dos no
     coinciden, Google descarta los dos y pinta el dominio pelado. -->
<meta property="og:site_name" content="Sacscloud" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={pageUrl} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
