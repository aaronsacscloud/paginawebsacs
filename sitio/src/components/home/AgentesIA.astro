---
/**
 * AgentesIA — «Un día en piloto automático» (29-sep-2026 · v2 editorial, rumbo a la expo de tecnología y moda).
 *
 * Va justo después de «La orden» (la dueña le pide a Sacs que opere su día): aquí se ve ese día, hora por
 * hora, como un editorial de moda. A la izquierda la hora gigante y lo que hizo el agente; a la derecha la
 * foto de ese momento. Arriba, el equipo (Inventario, Ventas, Clientes, Compras, Precios) se enciende y queda
 * marcado; las decisiones con dinero esperan el «Aprobar» de la dueña (se pueden tocar); al final, el collage
 * del día y el interruptor de piloto automático ponen a los agentes a trabajar en vivo.
 *
 * Escritorio (≥1024 px y sin «reducir movimiento»): riel con escena pegada, el mismo patrón de las historias.
 * Teléfono, tableta vertical y «reducir movimiento»: cada hora es foto + texto, en flujo normal (sin bloquear
 * el scroll). El scroll se lee con rAF y listener pasivo solo mientras la sección está en vista; los
 * temporizadores se apagan al salir de la vista o al ocultar la pestaña.
 *
 * Todo es un ejemplo ilustrativo; las funciones son las que ya promete el plan Automatiza (surtido y traspasos,
 * drop multicanal, avisos por WhatsApp, orden al proveedor, rebajas). Fotos: gpt-image-2.5, public/images/fashion-os/.
 */
const WA = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.2l-.9 1.2c-.2.2-.4.2-.7.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>';
const F = '/images/fashion-os/';

// El equipo: cinco agentes, en el orden de su hora. `pos` centra a la persona en los recortes verticales.
const AGENTES = [
  { id: 'inv', n: '01', nombre: 'Inventario', rol: 'Surte tus tiendas antes de abrir', foto: 'h07', pos: '80% 50%' },
  { id: 'ven', n: '02', nombre: 'Ventas', rol: 'Lanza el drop en todos tus canales', foto: 'h10', pos: '57% 50%' },
  { id: 'cli', n: '03', nombre: 'Clientes', rol: 'Le avisa primero a tu clienta', foto: 'h13', pos: '62% 50%' },
  { id: 'com', n: '04', nombre: 'Compras', rol: 'Arma la orden al proveedor', foto: 'h16', pos: '66% 50%' },
  { id: 'pre', n: '05', nombre: 'Precios', rol: 'Rebaja en el momento exacto', foto: 'h19', pos: '62% 50%' },
];

type Accion = { img?: string; alt?: string; titulo: string; detalle: string; chip?: string; chipTipo?: 'ok' | 'vivo'; aprobar?: string; que?: string; wa?: boolean };
const CAPS: { agente: string; hora: string; momento: string; quien: string; lugar: string; foto: string; alt: string; titulo: string; texto: string; accion: Accion }[] = [
  {
    agente: 'inv', hora: '07:00', momento: 'Antes de abrir', quien: 'Agente de Inventario', lugar: 'Polanco, CDMX',
    foto: 'h07', alt: 'Antes de abrir, una vendedora acomoda por talla la mercancía que llegó en la madrugada',
    titulo: 'Los surtidos, listos antes de abrir.',
    texto: 'Revisó tus cinco tiendas y el CEDIS mientras dormías: acomodó 38 tallas donde se van a vender y movió el vestido rosa M de Satélite a Polanco. A las 7:52 te avisó por WhatsApp: surtidos terminados.',
    accion: { img: '/images/prod-vestido-rosa.webp', alt: 'Vestido rosa', titulo: 'Surtidos terminados', detalle: '38 tallas · 5 tiendas · te avisó a las 7:52', chip: '✓ Avisado', chipTipo: 'ok' },
  },
  {
    agente: 'ven', hora: '10:30', momento: 'Sale el drop', quien: 'Agente de Ventas', lugar: 'Roma Norte, CDMX',
    foto: 'h10', alt: 'Foto de campaña de la colección de primavera: modelo con vestido de lino y bolsa rosa',
    titulo: 'El drop sale solo, en todos tus canales.',
    texto: 'Publicó la colección nueva en tu tienda en línea, Instagram y TikTok Shop con las mismas tallas y precios, y cobra cada pedido por WhatsApp. Si una talla se agota en tienda, se apaga en todos lados.',
    accion: { img: '/images/prod-bolsa.webp', alt: 'Bolsa rosa acolchada', titulo: 'Drop Primavera', detalle: '24 modelos · 4 canales · 12 pedidos en la primera hora', chip: 'En vivo', chipTipo: 'vivo' },
  },
  {
    agente: 'cli', hora: '13:00', momento: 'Tus clientas', quien: 'Agente de Clientes', lugar: 'Condesa, CDMX',
    foto: 'h13', alt: 'Una clienta sonríe al leer en su celular que ya llegó su talla',
    titulo: 'Tu clienta se entera primero.',
    texto: 'Avisó por WhatsApp a las 212 clientas que compran tu marca que ya llegó su talla, con los puntos de su monedero listos para usarse. 31 contestaron y 9 ya apartaron.',
    accion: { img: '/images/prod-vestido-negro.webp', alt: 'Vestido negro', titulo: '«Ya llegó tu talla»', detalle: 'Vestido negro · 212 clientas · 9 apartados', chip: '✓ Enviado', chipTipo: 'ok' },
  },
  {
    agente: 'com', hora: '16:00', momento: 'La compra', quien: 'Agente de Compras', lugar: 'León, Guanajuato',
    foto: 'h16', alt: 'Un artesano revisa un botín negro en su taller, frente a los estantes de producción',
    titulo: 'Compra lo que se va a vender.',
    texto: 'El botín negro 25 se va a agotar en seis días. Calculó la curva por tienda con lo que de verdad rotó y dejó lista la orden al proveedor. El dinero lo decides tú.',
    accion: { img: '/images/botin-negro.webp', alt: 'Botín negro', titulo: 'Orden de compra · Botín negro', detalle: 'Curva 23 a 27 · 60 pares · llega en 9 días', aprobar: '✓ Enviada al proveedor', que: 'compra' },
  },
  {
    agente: 'pre', hora: '19:00', momento: 'Fin de temporada', quien: 'Agente de Precios', lugar: 'Tus 5 tiendas y en línea',
    foto: 'h19', alt: 'Al atardecer, una mano cambia la etiqueta de un vestido verde de seda',
    titulo: 'La rebaja llega en el momento exacto.',
    texto: 'Detectó 14 modelos de la temporada pasada que ya no rotan. Programó la rebaja para el lunes en tus cinco tiendas y en línea, y dejó de resurtirlos.',
    accion: { img: '/images/rack-vestido.webp', alt: 'Vestido verde', titulo: 'Rebaja programada · lunes', detalle: '14 modelos · −30 % · 5 tiendas y en línea', aprobar: '✓ Programada', que: 'rebaja' },
  },
  {
    agente: 'tu', hora: '21:00', momento: 'Tu resumen', quien: 'Tú, desde tu celular', lugar: 'En casa',
    foto: 'h21', alt: 'La dueña, en su terraza por la noche, lee en su celular el resumen del día',
    titulo: 'Tú solo decides lo que importa.',
    texto: 'Tu resumen llega a tu WhatsApp: cuánto vendiste, lo que hicieron tus agentes y lo que espera tu visto bueno.',
    accion: { wa: true, titulo: 'Tu día: $186,450 en ventas', detalle: '1,240 tareas de tus agentes · surtidos terminados' },
  },
];
const FINAL_I = CAPS.length + 1;
// Orden en el flujo del teléfono: foto de la hora y luego su texto (en escritorio van en dos columnas).
const O = (k: number) => 2 * k;
const hhmm = (h: string) => h.split(':');
---
<section class="ag" id="agentes" aria-label="Fashion OS: un día de tu marca en piloto automático">
  <div class="ag-escena">
    <div class="ag-barra">
      <p class="ag-barra-t"><b>Fashion OS</b> — Un día en piloto automático</p>
      <ol class="ag-equipo" aria-label="Tus agentes">
        {AGENTES.map((a) => <li data-agente={a.id}><i aria-hidden="true"></i>{a.nombre}</li>)}
      </ol>
      <dl class="ag-metricas">
        <div><dt>Ventas de hoy</dt><dd class="ag-m-ventas">$0</dd></div>
        <div><dt>Tareas</dt><dd class="ag-m-tareas">0</dd></div>
        <div><dt>Tus decisiones</dt><dd class="ag-m-dec">1 de 3</dd></div>
      </dl>
    </div>

    <div class="ag-marco">
      <div class="ag-caps">
        <div class="ag-cap ag-cap--intro is-on" data-i="0" data-hora="06:00" style={`--o:${O(0) + 1}`}>
          <p class="ag-kicker"><i aria-hidden="true"></i>Tu equipo de agentes de IA</p>
          <h2 class="ag-h2">Tú orquestas.<br /><span>Tus agentes operan.</span></h2>
          <p class="ag-p">Así corre un martes en una marca de moda con cinco tiendas. Cada agente de IA se encarga de una parte de la operación; tú solo apruebas lo que importa.</p>
          <p class="ag-baja" aria-hidden="true">Baja y mira su día
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </p>
        </div>

        {CAPS.map((c, k) => (
          <article class="ag-cap" data-i={k + 1} data-hora={c.hora} data-agente={c.agente} style={`--o:${O(k + 1) + 1}`}>
            <p class="ag-hora"><time>{hhmm(c.hora)[0]}<i>:</i>{hhmm(c.hora)[1]}</time></p>
            <p class="ag-meta"><span>{c.momento}</span><b><i aria-hidden="true"></i>{c.quien}</b></p>
            <h3 class="ag-h3">{c.titulo}</h3>
            <p class="ag-p">{c.texto}</p>
            <div class:list={['ag-accion', { 'ag-accion--resumen': c.accion.wa }]} data-estado={c.accion.aprobar ? 'pendiente' : 'listo'} data-que={c.accion.que}>
              {c.accion.wa
                ? <span class="ag-accion-wa" set:html={WA} />
                : <img class="ag-accion-img" src={c.accion.img} alt={c.accion.alt} width="160" height="160" loading="lazy" decoding="async" />}
              <div class="ag-accion-txt">
                <b>{c.accion.titulo}</b>
                <small>{c.accion.detalle}{c.accion.wa && <> · <span class="ag-resumen-dec">te esperan 2 decisiones: apruébalas desde aquí o desde tu WhatsApp.</span></>}</small>
              </div>
              {c.accion.chip && <span class:list={['ag-chip', `ag-chip--${c.accion.chipTipo}`]}>{c.accion.chipTipo === 'vivo' && <i aria-hidden="true"></i>}{c.accion.chip}</span>}
              {c.accion.aprobar && <button type="button" class="ag-aprobar" data-hecho={c.accion.aprobar}>Aprobar</button>}
            </div>
          </article>
        ))}

        <div class="ag-cap ag-cap--final" data-i={FINAL_I} data-hora="24/7" data-agente="auto" style={`--o:${O(FINAL_I) + 1}`}>
          <p class="ag-hora ag-hora--247">24/7</p>
          <h2 class="ag-h2 ag-h2--final">Tu marca, en <span>piloto automático.</span></h2>
          <p class="ag-p">Fashion OS no reemplaza tu criterio: lo multiplica. Tus agentes hacen la operación de todos los días y tú diriges la marca.</p>
          <div class="ag-auto">
            <button type="button" class="ag-switch" role="switch" aria-checked="false">
              <span class="ag-switch-riel" aria-hidden="true"><span class="ag-switch-bola"></span></span>
              <span class="ag-switch-txt">Piloto automático <b>Apagado</b></span>
            </button>
            <p class="ag-vivo" aria-live="polite"><i aria-hidden="true"></i><span>Enciéndelo y mira a tus agentes trabajar.</span></p>
          </div>
          <div class="ag-ctas">
            <a class="ag-cta ag-cta--1" href="/prueba-gratis" data-evento="agentes_cta_prueba">Prueba 7 días gratis</a>
            <a class="ag-cta ag-cta--2" href="/contacto" data-evento="agentes_cta_demo">Agenda una demo</a>
          </div>
        </div>
      </div>

      <div class="ag-fotos">
        <figure class="ag-foto ag-foto--intro is-on" data-i="0" style={`--o:${O(0) + 2}`}>
          <ol class="ag-reparto" aria-label="Tu equipo de agentes">
            {AGENTES.map((a, k) => (
              <li style={`--k:${k}`}>
                <span class="ag-reparto-img"><img src={`${F}${a.foto}-480.webp`} srcset={`${F}${a.foto}-480.webp 480w, ${F}${a.foto}-960.webp 960w`} sizes="(min-width: 1024px) 22vw, 97vw" alt="" width="480" height="320" loading="lazy" decoding="async" style={`object-position:${a.pos}`} /></span>
                <span class="ag-reparto-n">N.º {a.n}</span>
                <b>{a.nombre}</b>
                <small>{a.rol}</small>
              </li>
            ))}
          </ol>
        </figure>

        {CAPS.map((c, k) => (
          <figure class="ag-foto" data-i={k + 1} style={`--o:${O(k + 1)}`}>
            <img
              src={`${F}${c.foto}-960.webp`}
              srcset={`${F}${c.foto}-960.webp 960w, ${F}${c.foto}.webp 1536w`}
              sizes="(min-width: 1024px) 56vw, 100vw"
              alt={c.alt} width="1536" height="1024" loading="lazy" decoding="async"
            />
            <figcaption><span>{c.hora} — {c.lugar}</span><span>{c.quien}</span></figcaption>
          </figure>
        ))}

        <figure class="ag-foto ag-foto--final" data-i={FINAL_I} style={`--o:${O(FINAL_I) + 2}`}>
          <ol class="ag-dia" aria-label="Tu día, hecho">
            {CAPS.map((c) => (
              <li data-agente={c.agente}>
                <img src={`${F}${c.foto}-480.webp`} srcset={`${F}${c.foto}-480.webp 480w, ${F}${c.foto}-960.webp 960w`} sizes="(min-width: 1024px) 21vw, 44vw" alt="" width="480" height="320" loading="lazy" decoding="async" />
                <span>{c.hora}</span><i aria-hidden="true">✓</i>
              </li>
            ))}
          </ol>
          <figcaption class="ag-dia-pie">Tu día, hecho — 1,240 tareas y tres decisiones tuyas.</figcaption>
        </figure>
      </div>
    </div>

    <nav class="ag-tiempo" aria-label="Horas del día">
      <ol>
        {CAPS.map((c, k) => <li data-i={k + 1}><button type="button"><i><b></b></i><span>{c.hora}</span></button></li>)}
        <li data-i={FINAL_I}><button type="button"><i><b></b></i><span>24/7</span></button></li>
      </ol>
      <a class="ag-saltar" href="#paso-a-paso" data-evento="agentes_saltar">Saltar
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </nav>
  </div>
</section>

<style>
  /* ── Base = editorial en flujo (teléfono, tableta vertical, «reducir movimiento» y sin JS) ── */
  .ag {
    --ag-marfil: #F5F3EE; --ag-tinta: #141414; --ag-azul: #4B7BE5; --ag-azul-o: #3A62C4; --ag-azul-b: #4470D8;
    --ag-texto: #45433E; --ag-tenue: #6E6A62; --ag-linea: rgba(20, 20, 20, 0.12); --ag-foto: #E6E2D9;
    position: relative; background: var(--ag-marfil); color: var(--ag-tinta); overflow: clip;
  }
  .ag-escena { position: relative; padding: 76px 16px 80px; }
  .ag-barra, .ag-tiempo, .ag-baja { display: none; }
  .ag-marco { display: flex; flex-direction: column; gap: 22px; max-width: 620px; margin: 0 auto; }
  .ag-caps, .ag-fotos { display: contents; }
  .ag-cap, .ag-foto { order: var(--o); }
  .ag:not(.is-escena) .ag-foto:not(.ag-foto--intro):not(.ag-foto--final) { margin-top: 44px; }
  .ag:not(.is-escena) .ag-foto--final { margin-top: 8px; }

  .ag-kicker { display: flex; align-items: center; gap: 10px; margin: 0 0 18px; font-family: var(--font-display); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ag-azul-o); }
  .ag-kicker i { width: 8px; height: 8px; flex-shrink: 0; border-radius: 50%; background: var(--ag-azul); }
  .ag-h2 { margin: 0; font-family: 'Clash Display', var(--font-display); font-weight: 700; font-size: clamp(40px, 10.4vw, 84px); line-height: 0.94; letter-spacing: -0.02em; color: var(--ag-tinta); text-wrap: balance; }
  .ag-h2 span { color: var(--ag-azul); }
  .ag-p { margin: 16px 0 0; max-width: 46ch; font-size: clamp(15px, 1.1vw, 17.5px); line-height: 1.6; color: var(--ag-texto); }

  /* la hora, gigante: el titular de cada página del día */
  .ag-hora { margin: 0; font-family: 'Clash Display', var(--font-display); font-weight: 700; font-size: clamp(64px, 19vw, 104px); line-height: 0.86; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; color: var(--ag-tinta); }
  .ag-hora i { font-style: normal; }
  .ag-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin: 16px 0 0; font-family: var(--font-display); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ag-tenue); }
  .ag-meta b { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; color: var(--ag-azul-o); }
  .ag-meta b i { width: 7px; height: 7px; border-radius: 50%; background: var(--ag-azul); }
  .ag-h3 { margin: 14px 0 0; font-family: 'Clash Display', var(--font-display); font-weight: 700; font-size: clamp(30px, 3.1vw, 50px); line-height: 0.98; letter-spacing: -0.02em; color: var(--ag-tinta); text-wrap: balance; }

  /* la tarjeta de lo que hizo el agente: blanca, como una notificación */
  .ag-accion { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 22px; padding: 12px 14px 12px 12px; max-width: 480px; background: #fff; border: 1px solid var(--ag-linea); border-radius: 14px; box-shadow: 0 18px 40px -30px rgba(20, 20, 20, 0.45); transition: box-shadow 0.3s, border-color 0.3s; }
  .ag-accion-img { width: 56px; height: 56px; flex-shrink: 0; border-radius: 9px; object-fit: cover; background: #F1EEE8; }
  .ag-accion-wa { width: 56px; height: 56px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center; background: #25D366; color: #fff; }
  .ag-accion-wa :global(svg) { width: 28px; height: 28px; }
  .ag-accion-txt { flex: 1 1 180px; min-width: 0; }
  .ag-accion-txt b { display: block; font-family: var(--font-display); font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  .ag-accion-txt small { display: block; margin-top: 3px; font-size: 12.5px; line-height: 1.4; color: #5B5A57; }
  .ag-chip { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; padding: 7px 11px; border-radius: 999px; font-family: var(--font-display); font-size: 11.5px; font-weight: 700; white-space: nowrap; }
  .ag-chip--ok { background: #E7EEFD; color: var(--ag-azul-o); }
  .ag-chip--vivo { background: var(--ag-tinta); color: #fff; }
  .ag-chip--vivo i { width: 7px; height: 7px; border-radius: 50%; background: #FF4D4D; animation: agLate 1.2s ease-in-out infinite; }
  .ag-aprobar { flex-shrink: 0; min-height: 40px; padding: 0 18px; border: 0; border-radius: 999px; background: var(--ag-azul-b); color: #fff; font-family: var(--font-display); font-size: 13px; font-weight: 700; cursor: pointer; transition: background 0.25s, transform 0.2s; }
  .ag-aprobar:hover { background: var(--ag-azul-o); }
  .ag-aprobar:active { transform: scale(0.97); }
  .ag-aprobar:focus-visible, .ag-switch:focus-visible, .ag-tiempo button:focus-visible, .ag-cta:focus-visible, .ag-saltar:focus-visible { outline: 2px solid var(--ag-azul); outline-offset: 3px; }
  .ag-accion[data-estado="aprobada"] { border-color: var(--ag-azul); box-shadow: 0 0 0 1px var(--ag-azul), 0 18px 40px -30px rgba(20, 20, 20, 0.45); }
  .ag-accion[data-estado="aprobada"] .ag-aprobar { background: var(--ag-tinta); cursor: default; }

  /* las fotos: sin esquinas redondas de app, como en una revista */
  .ag-foto { position: relative; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 3px; background: var(--ag-foto); }
  .ag-foto > img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ag-foto figcaption { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; gap: 12px; padding: 36px 14px 12px; background: linear-gradient(to top, rgba(10, 10, 10, 0.55), rgba(10, 10, 10, 0)); color: #fff; font-family: var(--font-display); font-size: 10.5px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; }

  /* el reparto: los cinco agentes, como una alineación de desfile */
  .ag-foto--intro, .ag-foto--final { aspect-ratio: auto; overflow: visible; border-radius: 0; background: none; }
  .ag-reparto { display: flex; gap: 10px; margin: 6px -16px 0; padding: 0 16px 6px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; list-style: none; scrollbar-width: none; }
  .ag-reparto::-webkit-scrollbar { display: none; }
  .ag-reparto li { flex: 0 0 44%; scroll-snap-align: start; }
  .ag-reparto-img { display: block; aspect-ratio: 3 / 4.4; overflow: hidden; border-radius: 3px; background: var(--ag-foto); }
  .ag-reparto-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ag-reparto-n { display: block; margin-top: 12px; font-family: var(--font-display); font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; color: var(--ag-azul-o); }
  .ag-reparto b { display: block; margin-top: 4px; font-family: 'Clash Display', var(--font-display); font-size: 20px; font-weight: 700; line-height: 1.05; }
  .ag-reparto small { display: block; margin-top: 4px; font-size: 12.5px; line-height: 1.35; color: var(--ag-tenue); }

  /* el cierre: el collage del día, cada hora con su palomita */
  .ag-dia { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin: 0; padding: 0; list-style: none; }
  .ag-dia li { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 3px; background: var(--ag-foto); transition: box-shadow 0.4s; }
  .ag-dia img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ag-dia span { position: absolute; left: 6px; bottom: 6px; padding: 3px 7px; border-radius: 2px; background: #fff; font-family: var(--font-display); font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; color: var(--ag-tinta); }
  .ag-dia i { position: absolute; right: 6px; top: 6px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--ag-azul); color: #fff; font-size: 11px; font-style: normal; font-weight: 700; }
  .ag-dia li.is-pulso { animation: agPulsoFoto 1.3s ease; }
  /* el pie del collage va debajo, en tinta tenue (no es el pie oscuro de las fotos) */
  .ag-foto .ag-dia-pie { position: static; display: block; margin-top: 12px; padding: 0; background: none; font-family: var(--font-display); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ag-tenue); }

  /* ── cierre: el interruptor de piloto automático ── */
  .ag-hora--247 { color: var(--ag-azul); }
  .ag-h2--final { margin-top: 14px; }
  .ag-auto { display: flex; flex-direction: column; gap: 14px; margin-top: 26px; }
  .ag-switch { display: inline-flex; align-items: center; gap: 14px; align-self: flex-start; padding: 0; border: 0; background: none; color: var(--ag-tinta); cursor: pointer; font-family: var(--font-display); font-size: 15px; font-weight: 600; }
  .ag-switch-riel { position: relative; width: 72px; height: 40px; flex-shrink: 0; border-radius: 999px; background: #D9D5CC; transition: background 0.35s; }
  .ag-switch-bola { position: absolute; top: 4px; left: 4px; width: 32px; height: 32px; border-radius: 50%; background: #fff; box-shadow: 0 2px 6px rgba(20, 20, 20, 0.18); transition: transform 0.4s cubic-bezier(0.3, 1.4, 0.5, 1); }
  .ag-switch[aria-checked="true"] .ag-switch-riel { background: var(--ag-azul); }
  .ag-switch[aria-checked="true"] .ag-switch-bola { transform: translateX(32px); }
  .ag-switch-txt b { margin-left: 4px; color: var(--ag-tenue); font-weight: 600; }
  .ag-switch[aria-checked="true"] .ag-switch-txt b { color: var(--ag-azul-o); }
  .ag-vivo { display: flex; align-items: center; gap: 10px; min-height: 1.6em; margin: 0; font-size: 14px; line-height: 1.4; color: var(--ag-texto); }
  .ag-vivo i { width: 8px; height: 8px; flex-shrink: 0; border-radius: 50%; background: #C9C4BA; }
  .ag.is-auto .ag-vivo i { background: #22C55E; animation: agLate 1.2s ease-in-out infinite; }
  .ag.is-auto .ag-vivo { color: var(--ag-tinta); }
  .ag-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .ag-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 26px; border-radius: 999px; font-family: var(--font-display); font-size: 15px; font-weight: 700; text-decoration: none; transition: transform 0.2s, background 0.2s, color 0.2s, border-color 0.2s; }
  .ag-cta--1 { background: var(--ag-azul-b); color: #fff; }
  .ag-cta--1:hover { background: var(--ag-azul-o); color: #fff; text-decoration: none; transform: translateY(-1px); }
  .ag-cta--2 { border: 1px solid rgba(20, 20, 20, 0.3); color: var(--ag-tinta); }
  .ag-cta--2:hover { border-color: var(--ag-tinta); color: var(--ag-tinta); text-decoration: none; transform: translateY(-1px); }

  /* en flujo: cada hora entra al verse */
  .ag.is-js:not(.is-escena) .ag-cap, .ag.is-js:not(.is-escena) .ag-foto { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .ag.is-js:not(.is-escena) .is-visto { opacity: 1 !important; transform: none !important; }
  .ag:not(.is-visible) .ag-chip--vivo i, .ag:not(.is-visible) .ag-vivo i, .ag:not(.is-visible) .ag-equipo i { animation-play-state: paused; }

  /* ── Escritorio: escena pegada; el scroll pasa las horas del día ── */
  .ag.is-escena { height: 620vh; overflow: visible; }
  .ag.is-escena .ag-escena { position: sticky; top: 0; height: 100vh; padding: 0; overflow: hidden; }
  .ag.is-escena .ag-barra { display: flex; position: absolute; top: 88px; left: 4vw; right: 4vw; z-index: 3; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--ag-linea); }
  .ag-barra-t { margin: 0; font-family: var(--font-display); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ag-tenue); white-space: nowrap; }
  .ag-barra-t b { color: var(--ag-tinta); font-weight: 600; }
  .ag-equipo { display: flex; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .ag-equipo li { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px 6px 10px; border: 1px solid var(--ag-linea); border-radius: 999px; font-family: var(--font-display); font-size: 12px; font-weight: 600; color: var(--ag-tenue); background: rgba(255, 255, 255, 0.5); transition: background 0.35s, color 0.35s, border-color 0.35s; }
  .ag-equipo i { width: 7px; height: 7px; border-radius: 50%; background: #C9C4BA; transition: background 0.35s; }
  .ag-equipo li.is-on { background: var(--ag-azul); border-color: var(--ag-azul); color: #fff; }
  .ag-equipo li.is-on i { background: #fff; animation: agLate 1s ease-in-out infinite; }
  .ag-equipo li.is-hecho { color: var(--ag-tinta); border-color: rgba(20, 20, 20, 0.28); }
  .ag-equipo li.is-hecho i { background: var(--ag-azul); }
  .ag.is-auto .ag-equipo li i { background: #22C55E; }
  .ag-equipo li.is-pulso { animation: agPulso 1.2s ease; }
  .ag-metricas { display: flex; gap: clamp(16px, 1.8vw, 28px); margin: 0; }
  .ag-metricas dt { font-family: var(--font-display); font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ag-tenue); white-space: nowrap; }
  .ag-metricas dd { margin: 4px 0 0; font-family: 'Clash Display', var(--font-display); font-weight: 700; font-size: clamp(17px, 1.4vw, 21px); line-height: 1; font-variant-numeric: tabular-nums; color: var(--ag-tinta); }

  .ag.is-escena .ag-marco { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 4vw, 72px); max-width: none; height: 100%; margin: 0; padding: 150px 4vw 104px; }
  .ag.is-escena .ag-caps, .ag.is-escena .ag-fotos { display: block; position: relative; }
  /* la hora que sale se va rápido y la que entra espera a que se vaya: los textos no se enciman */
  .ag.is-escena .ag-cap { position: absolute; left: 0; right: 0; top: 50%; opacity: 0; visibility: hidden; transform: translateY(calc(-50% + 22px)); transition: opacity 0.26s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.26s; pointer-events: none; }
  .ag.is-escena .ag-cap.is-on { opacity: 1; visibility: visible; transform: translateY(-50%); pointer-events: auto; transition: opacity 0.5s ease 0.22s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.22s, visibility 0s linear 0s; }
  .ag.is-escena .ag-cap.is-on .ag-accion { animation: agEntra 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
  .ag.is-escena .ag-hora { font-size: min(16vh, 9.4vw); }
  .ag.is-escena .ag-h2 { font-size: clamp(48px, 4.8vw, 84px); }
  .ag.is-escena .ag-baja { display: inline-flex; align-items: center; gap: 8px; margin: 30px 0 0; font-family: var(--font-display); font-size: 13px; font-weight: 600; color: var(--ag-tinta); }
  .ag.is-escena .ag-baja svg { animation: agBaja 1.6s ease-in-out infinite; }

  /* la columna de fotos: cada hora entra como cortina sobre la anterior */
  .ag.is-escena .ag-foto { position: absolute; inset: 0; margin: 0; aspect-ratio: auto; clip-path: inset(100% 0 0 0); transition: clip-path 0.95s cubic-bezier(0.7, 0, 0.2, 1); }
  .ag.is-escena .ag-foto.is-on, .ag.is-escena .ag-foto.is-ido { clip-path: inset(0 0 0 0); }
  .ag.is-escena .ag-foto > img { transform: scale(1.1); transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .ag.is-escena .ag-foto.is-on > img { transform: none; }
  .ag.is-escena .ag-foto figcaption { padding: 60px 22px 18px; font-size: 11px; }
  .ag.is-escena .ag-foto--intro, .ag.is-escena .ag-foto--final { display: flex; flex-direction: column; justify-content: center; background: var(--ag-marfil); }
  .ag.is-escena .ag-reparto { margin: 0; padding: 0; overflow: visible; gap: clamp(10px, 1vw, 16px); }
  .ag.is-escena .ag-reparto li { flex: 1 1 0; min-width: 0; opacity: 0; transform: translateY(28px); transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(0.1s + var(--k) * 0.09s); }
  .ag.is-escena .ag-foto--intro.is-on .ag-reparto li { opacity: 1; transform: none; }
  .ag.is-escena .ag-reparto li:nth-child(even) { margin-top: 44px; }
  .ag.is-escena .ag-reparto-img { aspect-ratio: 3 / 4.6; }
  .ag.is-escena .ag-reparto b { font-size: clamp(17px, 1.45vw, 22px); }
  .ag.is-escena .ag-reparto small { font-size: 12px; }
  .ag.is-escena .ag-dia { gap: 8px; }
  .ag.is-escena .ag-dia li { aspect-ratio: 4 / 3.4; opacity: 0; transform: scale(0.96); transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .ag.is-escena .ag-foto--final.is-on .ag-dia li { opacity: 1; transform: none; }
  .ag.is-escena .ag-foto--final.is-on .ag-dia li:nth-child(2) { transition-delay: 0.08s; }
  .ag.is-escena .ag-foto--final.is-on .ag-dia li:nth-child(3) { transition-delay: 0.16s; }
  .ag.is-escena .ag-foto--final.is-on .ag-dia li:nth-child(4) { transition-delay: 0.24s; }
  .ag.is-escena .ag-foto--final.is-on .ag-dia li:nth-child(5) { transition-delay: 0.32s; }
  .ag.is-escena .ag-foto--final.is-on .ag-dia li:nth-child(6) { transition-delay: 0.4s; }

  /* la regla del tiempo, abajo */
  .ag.is-escena .ag-tiempo { display: flex; position: absolute; left: 4vw; right: 4vw; bottom: 26px; z-index: 3; align-items: flex-end; gap: 28px; }
  .ag-tiempo ol { display: flex; flex: 1; margin: 0; padding: 0; list-style: none; }
  .ag-tiempo li { flex: 1; }
  .ag-tiempo button { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; width: 100%; padding: 6px 0; border: 0; background: none; cursor: pointer; font-family: var(--font-display); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; color: var(--ag-tenue); transition: color 0.3s; }
  .ag-tiempo button i { position: relative; display: block; width: calc(100% - 10px); height: 2px; overflow: hidden; background: var(--ag-linea); }
  .ag-tiempo button i b { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--ag-azul); }
  .ag-tiempo li.is-hecho button i { background: rgba(20, 20, 20, 0.55); }
  .ag-tiempo li.is-on button { color: var(--ag-tinta); }
  .ag-tiempo button:hover { color: var(--ag-tinta); }
  .ag-saltar { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border: 1px solid rgba(20, 20, 20, 0.2); border-radius: 999px; font-family: var(--font-display); font-size: 12.5px; font-weight: 600; color: var(--ag-tinta); text-decoration: none; transition: background 0.3s, color 0.3s; }
  .ag-saltar:hover { background: var(--ag-tinta); color: #fff; text-decoration: none; }
  .ag.is-final .ag-saltar { opacity: 0; pointer-events: none; }

  @keyframes agLate { 50% { opacity: 0.35; } }
  @keyframes agPulso { 30% { background: var(--ag-azul); border-color: var(--ag-azul); color: #fff; } }
  @keyframes agPulsoFoto { 30% { box-shadow: 0 0 0 3px var(--ag-azul); } }
  @keyframes agEntra { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  @keyframes agBaja { 50% { transform: translateY(4px); } }

  /* Escritorio angosto: la barra de arriba sin título para que quepan equipo y números */
  @media (max-width: 1279px) {
    .ag-barra-t { display: none; }
  }
  /* Teléfono: la tarjeta de acción a lo ancho y el botón debajo del texto */
  @media (max-width: 767px) {
    .ag-accion { max-width: none; }
    .ag-aprobar { flex: 1 1 100%; }
    .ag-ctas { flex-direction: column; }
    .ag-cta { width: 100%; }
    .ag-foto figcaption span:last-child { display: none; }
    .ag-accion { box-shadow: 0 8px 18px -14px rgba(20, 20, 20, 0.35); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ag-chip--vivo i, .ag-vivo i, .ag-equipo i, .ag-dia li { animation: none !important; }
    .ag.is-js .ag-cap, .ag.is-js .ag-foto { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>

<script>
  (() => {
    const sec = document.getElementById('agentes');
    if (!sec) return;
    const q = <T extends Element>(s: string) => sec.querySelector<T>(s);
    const qa = <T extends Element>(s: string) => Array.from(sec.querySelectorAll<T>(s));
    // Todo lo que se toca en cada cuadro se busca UNA vez (regla de rendimiento: nada de querySelector en el scroll).
    const caps = qa<HTMLElement>('.ag-cap');
    const fotos = qa<HTMLElement>('.ag-foto');
    const equipo = qa<HTMLElement>('.ag-equipo li');
    const tiles = qa<HTMLElement>('.ag-dia li');
    const marcas = qa<HTMLElement>('.ag-tiempo li');
    const barras = marcas.map((m) => m.querySelector<HTMLElement>('b')!);
    const mVentas = q<HTMLElement>('.ag-m-ventas');
    const mTareas = q<HTMLElement>('.ag-m-tareas');
    const mDec = q<HTMLElement>('.ag-m-dec');
    const resumenDec = q<HTMLElement>('.ag-resumen-dec');
    const sw = q<HTMLButtonElement>('.ag-switch');
    const swTxt = q<HTMLElement>('.ag-switch-txt b');
    const vivoTxt = q<HTMLElement>('.ag-vivo span');
    const finalCap = q<HTMLElement>('.ag-cap--final');
    const N = caps.length;            // intro + 6 horas + cierre
    const FINAL = N - 1;
    // Un día de ejemplo que sube con las horas (el resumen de las 21:00 dice lo mismo).
    const VENTAS = [0, 0, 38900, 92300, 131750, 164200, 186450, 186450];
    const TAREAS = [0, 126, 418, 702, 881, 1037, 1240, 1240];
    const VIVO: [string, string][] = [
      ['ven', 'Agente de Ventas · cobró el pedido #1,284 por WhatsApp'],
      ['inv', 'Agente de Inventario · pasó 2 piezas talla S a Coyoacán'],
      ['cli', 'Agente de Clientes · le recordó su apartado a Mariana'],
      ['com', 'Agente de Compras · confirmó 60 pares en camino al CEDIS'],
      ['pre', 'Agente de Precios · dejó lista la rebaja del lunes en 5 tiendas'],
      ['ven', 'Agente de Ventas · publicó 3 looks nuevos en TikTok Shop'],
    ];
    const idxEquipo: Record<string, number> = {};
    equipo.forEach((n, k) => { idxEquipo[n.dataset.agente || ''] = k; });
    const idxTile: Record<string, number> = {};
    tiles.forEach((t, k) => { if (!(t.dataset.agente! in idxTile)) idxTile[t.dataset.agente || ''] = k; });
    const fmt = new Intl.NumberFormat('es-MX');
    const ph = (ev: string, props?: Record<string, unknown>) => { try { (window as any).sacsPH?.(ev, props); } catch { /* medir no rompe nada */ } };
    const hitos = new Set<string>();
    const hito = (k: string, props?: Record<string, unknown>) => { if (hitos.has(k)) return; hitos.add(k); ph('agentes_' + k, props); };
    const mq = window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');

    let escena = false, visible = false, cur = -1, raf = 0, alto = 0;
    let auto = false, vivoT = 0, vivoK = 0, finalVisible = false;
    let aprobadas = 1;                // el aviso de surtidos de las 7:52 ya viene resuelto
    const TOTAL_DEC = 3;
    sec.classList.add('is-js');

    /* ── el equipo de arriba: quién trabaja y quién ya terminó en el momento `i` del día ── */
    function pintaEquipo(i: number) {
      equipo.forEach((n, k) => {
        const c = k + 1;              // capítulo (hora) de ese agente
        n.classList.toggle('is-on', i === c);
        n.classList.toggle('is-hecho', i > c);
      });
    }

    /* ── contadores que corren al número de la hora ── */
    const corriendo = new Map<HTMLElement, number>();
    function cuenta(el: HTMLElement | null, desde: number, hasta: number, pinta: (v: number) => string) {
      if (!el) return;
      cancelAnimationFrame(corriendo.get(el) || 0);
      const t0 = performance.now(), dur = 700;
      const paso = (t: number) => {
        const f = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - f, 3);
        el.textContent = pinta(desde + (hasta - desde) * e);
        if (f < 1) corriendo.set(el, requestAnimationFrame(paso)); else corriendo.delete(el);
      };
      corriendo.set(el, requestAnimationFrame(paso));
    }

    function muestra(i: number) {
      if (i === cur) return;
      const antes = cur < 0 ? 0 : cur;
      cur = i;
      caps.forEach((c, k) => c.classList.toggle('is-on', k === i));
      fotos.forEach((f, k) => { f.classList.toggle('is-on', k === i); f.classList.toggle('is-ido', k < i); });
      pintaEquipo(i);
      marcas.forEach((m) => { const k = +(m.dataset.i || 0); m.classList.toggle('is-on', k === i); m.classList.toggle('is-hecho', k < i); });
      sec!.classList.toggle('is-final', i === FINAL);
      cuenta(mVentas, VENTAS[antes] ?? 0, VENTAS[i] ?? 0, (v) => '$' + fmt.format(Math.round(v)));
      cuenta(mTareas, TAREAS[antes] ?? 0, TAREAS[i] ?? 0, (v) => fmt.format(Math.round(v)));
      alFinal(i === FINAL);
      if (i >= 1) hito('dia');
      if (i >= 4) hito('50');
      if (i === FINAL) hito('final');
    }
    function barra(i: number, f: number) {
      barras.forEach((b, k) => {
        const m = +(marcas[k].dataset.i || 0);
        const w = m < i ? 100 : m === i ? Math.round(f * 100) : 0;
        b.style.width = w + '%';
      });
    }

    /* ── escritorio: el progreso del riel decide la hora ── */
    function mide() {
      raf = 0;
      const r = sec!.getBoundingClientRect();
      const total = alto - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      const x = p * N;
      const i = Math.min(N - 1, Math.floor(x));
      muestra(i);
      barra(i, i === FINAL ? 1 : x - i);
    }
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(mide); };
    marcas.forEach((m) => m.querySelector('button')?.addEventListener('click', () => {
      const k = +(m.dataset.i || 0);
      const top = sec!.getBoundingClientRect().top + window.scrollY;
      const total = alto - window.innerHeight;
      window.scrollTo({ top: top + ((k + 0.35) / N) * total, behavior: 'smooth' });
      ph('agentes_hora', { a: k });
    }));

    /* ── piloto automático: el interruptor del cierre ── */
    function late(el: HTMLElement | undefined) { if (!el) return; el.classList.remove('is-pulso'); requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-pulso'))); }   // doble rAF, sin forzar reflow
    function tickVivo() {
      const [a, t] = VIVO[vivoK++ % VIVO.length];
      if (vivoTxt) vivoTxt.textContent = t;
      late(equipo[idxEquipo[a]]);
      late(tiles[idxTile[a]]);
    }
    function puedeCorrer() { return auto && visible && !document.hidden && (escena ? cur === FINAL : finalVisible); }
    function arrancaVivo() { if (vivoT || !puedeCorrer()) return; tickVivo(); vivoT = window.setInterval(() => { if (puedeCorrer()) tickVivo(); else paraVivo(); }, 2300); }
    function paraVivo() { if (vivoT) { clearInterval(vivoT); vivoT = 0; } }
    function enciende(on: boolean, porUsuario: boolean) {
      auto = on;
      sw?.setAttribute('aria-checked', String(on));
      if (swTxt) swTxt.textContent = on ? 'Encendido' : 'Apagado';
      sec!.classList.toggle('is-auto', on);
      if (on) arrancaVivo();
      else { paraVivo(); if (vivoTxt) vivoTxt.textContent = 'Modo manual: cada acción espera tu aprobación.'; }
      if (porUsuario) ph('agentes_piloto', { on });
    }
    // La primera vez que se llega al cierre, el interruptor se prende solo (es la demostración); después manda el usuario.
    function alFinal(enFinal: boolean) {
      if (!enFinal) { paraVivo(); return; }
      if (!hitos.has('auto_solo')) { hitos.add('auto_solo'); window.setTimeout(() => { if (!auto && (escena ? cur === FINAL : finalVisible)) enciende(true, false); }, 700); }
      else arrancaVivo();
    }
    sw?.addEventListener('click', () => enciende(!auto, true));

    /* ── aprobar: las decisiones con dinero son de la dueña ── */
    function pintaDecisiones() {
      if (mDec) mDec.textContent = `${aprobadas} de ${TOTAL_DEC}`;
      if (!resumenDec) return;
      const f = TOTAL_DEC - aprobadas;
      resumenDec.textContent = f === 0
        ? 'aprobaste las 3 decisiones del día; lo demás lo hicieron tus agentes.'
        : f === 1 ? 'te espera 1 decisión: apruébala desde aquí o desde tu WhatsApp.' : `te esperan ${f} decisiones: apruébalas desde aquí o desde tu WhatsApp.`;
    }
    qa<HTMLButtonElement>('.ag-aprobar').forEach((b) => b.addEventListener('click', () => {
      const card = b.closest<HTMLElement>('.ag-accion');
      if (!card || card.dataset.estado === 'aprobada') return;
      card.dataset.estado = 'aprobada';
      b.textContent = b.dataset.hecho || '✓ Aprobada';
      b.disabled = true;
      aprobadas = Math.min(TOTAL_DEC, aprobadas + 1);
      pintaDecisiones();
      ph('agentes_aprobar', { que: card.dataset.que });
    }));
    pintaDecisiones();

    /* ── en flujo (teléfono): cada hora entra al verse y el cierre enciende el piloto ── */
    const ioFinal = finalCap ? new IntersectionObserver((es) => {
      finalVisible = es[0].isIntersecting;
      if (escena) return;
      if (finalVisible) { hito('final'); alFinal(true); } else paraVivo();
    }, { threshold: 0.4 }) : null;
    const ioCap = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visto'); ioCap.unobserve(e.target); } }), { threshold: 0.12 });

    function aplicaModo() {
      escena = mq.matches;
      sec!.classList.toggle('is-escena', escena);
      alto = sec!.offsetHeight;
      cur = -1;
      paraVivo();
      if (escena) {
        ioCap.disconnect();
        if (visible) { window.addEventListener('scroll', onScroll, { passive: true }); mide(); }
      } else {
        window.removeEventListener('scroll', onScroll);
        caps.forEach((c) => c.classList.remove('is-on'));
        fotos.forEach((f) => f.classList.remove('is-on', 'is-ido'));
        [...caps, ...fotos].forEach((el) => ioCap.observe(el));
        if (finalCap) ioFinal?.observe(finalCap);
      }
    }

    const io = new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      sec.classList.toggle('is-visible', visible);
      document.body.classList.toggle('agentes-activo', visible && escena);   // la barra flotante de WhatsApp no tapa la regla del tiempo
      if (visible) {
        hito('ver', { escena });
        if (escena) { window.addEventListener('scroll', onScroll, { passive: true }); mide(); }
        if (auto) arrancaVivo();
      } else {
        window.removeEventListener('scroll', onScroll);
        paraVivo();
      }
    }, { rootMargin: '120px 0px' });

    // Pestaña oculta = nada corriendo; al volver, retoma lo que toque.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { paraVivo(); return; }
      if (auto) arrancaVivo();
    });
    window.addEventListener('resize', () => { alto = sec.offsetHeight; if (escena && visible) onScroll(); }, { passive: true });
    mq.addEventListener('change', aplicaModo);
    qa<HTMLElement>('[data-evento]').forEach((a) => a.addEventListener('click', () => ph(a.dataset.evento || '', { hora: cur })));

    aplicaModo();
    io.observe(sec);
  })();
</script>
