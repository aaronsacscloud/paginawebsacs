---
/**
 * FlujosIA — la intro de la historia "De tu foto a tu reel".
 * Un solo mensaje concreto: AXO no sugiere, TERMINA el flujo completo.
 * El efecto es el flujo mismo: cinco nodos que se encienden en cadena cuando
 * la sección entra en pantalla, la línea se dibuja entre ellos y al final cae
 * el sello "27 min". Sin Three.js: CSS + un IntersectionObserver de 6 líneas.
 * Mismo negro #0E0D0C que las historias: un solo color de fondo, ámbar para el flujo.
 */
const NODOS = [
  { t: 'Foto', s: 'con tu celular' },
  { t: 'Colores', s: '10 en un mensaje' },
  { t: 'Modelo', s: 'la tuya, siempre igual' },
  { t: 'Reel', s: 'camina, la tela cae' },
  { t: 'Venta', s: 'en TikTok Shop' },
];
---
<section class="fx" id="flujos-ia" aria-label="AXO cubre el flujo completo">
  <div class="fx-caja">
    <h2 class="fx-claim"><span class="fx-l fx-l1">Una foto entra.</span><span class="fx-l fx-l2">Una venta sale.</span></h2>
    <p class="fx-lead">AXO no te sugiere qué hacer: hace el flujo completo. Edita, colorea, viste a tu modelo, graba el reel, lo publica y cobra. En medio, nadie captura nada.</p>

    <div class="fx-riel">
    <ol class="fx-flujo" aria-label="El flujo completo">
      {NODOS.map((n, i) => (
        <li class="fx-nodo" style={`--i:${i}`}>
          <i class="fx-punto" aria-hidden="true"></i>
          <b>{n.t}</b><small>{n.s}</small>
        </li>
      ))}
    </ol>
    <span class="fx-sello" aria-label="27 minutos en total"><b>27</b><small>min</small></span>
    </div>

    <p class="fx-otros">Lo mismo pasa con el piso y con el inventario:
      <a href="#recorrido">del live al ticket</a> · <a href="#inventario">del análisis al surtido</a>.
    </p>
    <span class="fx-abajo" aria-hidden="true">Así funciona</span>
  </div>
</section>

<style>
  .fx { position: relative; background: #0E0D0C; color: #fff; padding: clamp(72px, 12vh, 140px) 24px clamp(56px, 9vh, 110px); overflow: hidden; }
  .fx-caja { max-width: 1120px; margin: 0 auto; text-align: center; }
  .fx-kicker { display: inline-block; font-family: var(--font-display); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #fff; border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; padding: 10px 18px; margin-bottom: 30px; }
  .fx-claim { color: #fff; font-family: var(--font-display); font-weight: 700; font-size: clamp(44px, 7.4vw, 112px); line-height: 0.98; letter-spacing: -0.04em; margin: 0; }
  .fx-l { display: block; clip-path: inset(0 0 100% 0); transform: translateY(0.35em); transition: clip-path 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .fx-l1 { color: rgba(255,255,255,0.45); }
  .fx-l2 { transition-delay: 0.18s; }
  .fx.is-in .fx-l { clip-path: inset(0 0 -10% 0); transform: none; }
  .fx-lead { max-width: 760px; margin: 28px auto 0; font-size: clamp(17px, 1.35vw, 21px); line-height: 1.45; color: #B9B8B2; opacity: 0; transform: translateY(10px); transition: opacity 0.7s 0.6s, transform 0.7s 0.6s; }
  .fx.is-in .fx-lead { opacity: 1; transform: none; }

  /* ── el flujo ── */
  .fx-riel { position: relative; max-width: 1120px; margin: clamp(44px, 7vh, 72px) auto 0; }
  .fx-flujo { list-style: none; margin: 0 auto; padding: 0; display: flex; align-items: flex-start; justify-content: center; gap: 0; position: relative; }
  .fx-nodo { position: relative; flex: 1 1 0; max-width: 200px; padding-top: 34px; opacity: 0.6; transition: opacity 0.4s; transition-delay: calc(0.9s + var(--i) * 0.5s); }
  .fx-nodo b { display: block; font-family: var(--font-display); font-size: clamp(18px, 2vw, 28px); letter-spacing: -0.02em; line-height: 1.1; }
  .fx-nodo small { display: block; margin-top: 6px; font-size: clamp(12px, 1vw, 15px); color: #B4B4AE; }
  .fx-punto { position: absolute; top: 0; left: 50%; width: 16px; height: 16px; margin-left: -8px; border-radius: 50%; background: rgba(255,255,255,0.35); box-shadow: 0 0 0 0 rgba(59,91,219,0); transition: background 0.35s, box-shadow 0.9s; transition-delay: calc(0.9s + var(--i) * 0.5s); }
  /* el tramo de línea nace en el punto y crece hacia el siguiente nodo */
  .fx-nodo::after { content: ''; position: absolute; top: 7px; left: calc(50% + 8px); width: calc(100% - 16px); height: 2px; background: var(--color-primary, #3B5BDB); transform: scaleX(0); transform-origin: left center; transition: transform 0.5s linear; transition-delay: calc(1.05s + var(--i) * 0.5s); }
  .fx-nodo:last-child::after { display: none; }
  .fx.is-in .fx-nodo { opacity: 1; }
  .fx.is-in .fx-punto { background: var(--color-primary, #3B5BDB); box-shadow: 0 0 0 10px rgba(59,91,219,0); }
  .fx.is-in .fx-nodo::after { transform: scaleX(1); }
  .fx-sello { position: absolute; right: 0; top: -22px; width: 92px; height: 92px; border-radius: 50%; background: var(--color-primary, #3B5BDB); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; transform: scale(0) rotate(-14deg); transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: 3.5s; }
  .fx-sello b { font-family: var(--font-display); font-size: 34px; line-height: 1; letter-spacing: -0.03em; }
  .fx-sello small { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .fx.is-in .fx-sello { transform: scale(1) rotate(-8deg); }

  .fx-otros { margin: clamp(36px, 6vh, 56px) auto 0; font-size: 15px; color: #9A9A94; opacity: 0; transition: opacity 0.6s 3.8s; }
  .fx-otros a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .fx.is-in .fx-otros { opacity: 1; }
  .fx-abajo { display: block; margin-top: 34px; font-family: var(--font-display); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #9A9A94; }
  .fx-abajo::after { content: ''; display: block; width: 1px; height: 36px; margin: 12px auto 0; background: rgba(255,255,255,0.45); }

  @media (max-width: 767px) {
    .fx { padding: 56px 20px 40px; }
    .fx-l { clip-path: none; transform: none; } .fx-lead { opacity: 1; transform: none; margin-top: 18px; font-size: 16px; }
    .fx-flujo { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 26px; }
    .fx-nodo { flex: 0 0 auto; max-width: none; padding: 8px 12px; border: 1px solid rgba(255,255,255,0.25); border-radius: 999px; opacity: 1; transition: none; }
    .fx-nodo b { font-size: 14px; } .fx-nodo small, .fx-punto, .fx-nodo::after { display: none; }
    .fx-sello { position: static; display: flex; margin: 18px auto 0; width: 72px; height: 72px; transform: scale(1) rotate(-8deg); }
    .fx-sello b { font-size: 26px; }
    .fx-otros { margin-top: 22px; opacity: 1; } .fx-abajo { margin-top: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-l, .fx-lead, .fx-nodo, .fx-punto, .fx-nodo::after, .fx-sello, .fx-otros { transition: none !important; }
    .fx-l { clip-path: none; transform: none; } .fx-lead, .fx-nodo, .fx-otros { opacity: 1; } .fx-punto { background: var(--color-primary, #3B5BDB); } .fx-nodo::after { transform: none; } .fx-sello { transform: scale(1) rotate(-8deg); }
  }
</style>

<script>
  const fx = document.getElementById('flujos-ia');
  if (fx) {
    if (!('IntersectionObserver' in window)) fx.classList.add('is-in');
    else {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { fx.classList.add('is-in'); io.disconnect(); } }, { threshold: 0.12 });
      io.observe(fx);
    }
  }
</script>
