---
/**
 * Operador — el tablero operativo armándose con el scroll.
 *
 * El argumento: Sacs no te da reportes, te da decisiones. Mientras cierras, el
 * operador revisa tiendas, CEDIS y temporada, y a las 3 a.m. deja seis frentes
 * resueltos en tarjetas que se entienden sin abrir un Excel.
 *
 * Por qué está construido en HTML y no con la captura del sistema: la pantalla
 * real es densa y se lee peor de lo que se entiende la idea. Aquí las tarjetas
 * son nodos de verdad, así que se pueden encender una por una con el scroll,
 * abrir al clic y leer con el pulgar. Los textos y los números SÍ son los del
 * tablero real — se cambian ahí, no aquí.
 *
 * Reglas de esta pieza:
 *  · El recorrido va como caja propia DENTRO del riel: un sticky solo viaja
 *    dentro del content box de quien lo contiene.
 *  · Los datos entran de uno en uno: un dato suelto no es una decisión, y la
 *    sección existe para enseñar justamente eso.
 *  · Sin riel (móvil, poco movimiento o pantalla corta) se vuelve una lista
 *    normal con todo abierto, que se lee igual de bien.
 */
const COLORES = {
  terracota: '#B4522F', negro: '#1F1F22', crema: '#E4D8C3', salvia: '#8A9A7B', lila: '#A78BC4',
};

// Cuatro decisiones, no seis: más grandes y sin competir entre ellas. El color
// se usa SOLO para señalar el hueco (rosa) y el vencimiento (ámbar); todo lo
// demás va en tinta. Antes eran seis acentos distintos y la rejilla se leía
// como un semáforo.
const tarjetas = [
  {
    k: 'La curva rota · desde el CEDIS',
    t: 'Polanco vende la <b>24</b> y la <b>25</b>. Las dos están en cero, y el CEDIS las tiene.',
    n: '$186,400',
    l: 'en venta recuperada',
    prenda: 'Vestido slip · 3 colores',
    colores: ['terracota', 'negro', 'crema'],
    tallas: [['22', 6], ['23', 4], ['24', 0], ['25', 0], ['26', 3], ['27', 5]],
    chips: ['La curva queda completa', '3 tiendas'],
    cta: 'Ver el plan',
  },
  {
    k: 'El color que no se mueve · entre tiendas',
    t: 'El <b>denim</b> lleva 46 piezas paradas en Satélite. En Polanco gira 5× más rápido.',
    n: '$58,900',
    l: 'en dinero parado',
    prenda: 'Blusa satín · denim y hueso',
    colores: ['negro', 'crema'],
    tallas: [['S', 12], ['M', 18], ['L', 11], ['XL', 5]],
    chips: ['Satélite → Polanco', 'Sin comprar nada'],
    cta: 'Ver el plan',
  },
  {
    k: 'Se está acabando · compra de lote',
    t: 'A la camisa de cuadros le quedan <b>9 días de vida</b>. Falta la M en las tres tiendas.',
    n: '$74,200',
    l: 'de venta en riesgo',
    prenda: 'Camisa cuadros · 2 colores',
    colores: ['salvia', 'negro'],
    tallas: [['S', 4], ['M', 0], ['L', 2], ['XL', 6]],
    chips: ['Proveedor entrega en 12 días', 'Mejor margen del mes'],
    cta: 'Armar la compra',
  },
  {
    k: 'Rebaja · siguiente escalón',
    t: 'La chamarra acolchada lleva <b>41 días dormida</b>: sobra la XL en las tres tiendas.',
    n: '$32,600',
    l: 'recuperables con rebaja',
    prenda: 'Chamarra acolchada · lila y crema',
    colores: ['lila', 'crema'],
    tallas: [['S', 1], ['M', 2], ['L', 9], ['XL', 21]],
    chips: ['Escalón 2 de 3 · −25%', 'Aún deja 38% de margen'],
    cta: 'Preparar la rebaja',
  },
];

// La corrida: la curva de la misma prenda, tienda por tienda. Es lo que nadie
// alcanza a revisar a mano y donde se ve el hueco de un vistazo.
const TALLAS = ['XS', 'S', 'M', 'L', 'XL'];
const corrida = [
  { tienda: 'Polanco',     v: [3, 5, 0, 0, 4] },
  { tienda: 'Roma Norte',  v: [2, 0, 6, 4, 3] },
  { tienda: 'Guadalajara', v: [4, 3, 5, 0, 2] },
  { tienda: 'Satélite',    v: [1, 2, 3, 7, 18] },
];

// Lo que va contando el panel de la izquierda conforme se arma el tablero.
const etapas = [
  { t: 'Un dato suelto no decide nada.', d: 'Sabes que a Polanco le falta la 24. ¿Y luego? El dato no dice cuántas, ni de qué color, ni de dónde sacarlas sin romper otra tienda.' },
  { t: 'Dos ya son una comparación.', d: 'Ahora hay dinero parado en dos frentes. ¿Cuál primero? Aquí es donde normalmente empieza el Excel.' },
  { t: 'Tres, y aparece la pregunta cara.', d: 'Mover, comprar o rebajar. Cada respuesta cuesta dinero, y cada una necesita tallas, colores y días de vida que viven en reportes distintos.' },
  { t: 'Y la curva, tienda por tienda.', d: 'La misma prenda, sus cinco tallas y tus cuatro tiendas. Donde hay un cero hay venta que no ocurre — y nadie alcanza a revisar esto a mano todas las noches.' },
  { t: 'Tu analista se adelantó.', d: 'A las 3 de la mañana el operador ya recorrió tus tiendas, tu CEDIS y tu temporada. No te deja un reporte: te deja las decisiones tomadas y ordenadas por lo que cuesta no tomarlas.' },
  { t: 'Y cada tarjeta abre el plan, pieza por pieza.', d: 'Falta − lo que ya viene en camino = lo que de verdad se mueve. Nada se duplica, y nada sale de una tienda hasta que tú lo envías.' },
  { t: 'Y cada prenda tiene su vida contada.', d: 'Cuándo llegó, qué día terminó de pagar su lote y qué te dejó limpio desde entonces. Una prenda no es una fila del inventario: es un ciclo, y el ciclo te dice cuándo volver a comprarla y cuándo dejarla ir.' },
];
---

<section class="op" id="operador" data-etapas={etapas.length}>
  <div class="op-riel">
    <div class="op-pegado">
      <div class="op-panel">
        <span class="op-kicker">Operador de inventario · trabaja de noche</span>
        <h2 class="op-titulo">Deja de sacar reportes.<br /><em>Sacs ya te dejó las decisiones.</em></h2>

        <div class="op-etapas">
          {etapas.map((e, i) => (
            <div class:list={['op-etapa', { on: i === 0 }]} data-i={i}>
              <span class="op-etapa-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{e.t}</h3>
                <p>{e.d}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="op-barra" aria-hidden="true"><span></span></div>
      </div>

      <div class="op-lienzo">
        <div class="op-tablero">
          <div class="op-tablero-cab">
            <span class="op-marca">Sacs<i></i>Tablero operativo</span>
            <span class="op-sello">Hoy, 3:00 a.m. — datos frescos</span>
          </div>

          <div class="op-briefing">
            <div class="op-anillo" aria-hidden="true">
              <svg viewBox="0 0 100 100">
                <circle class="op-anillo-base" cx="50" cy="50" r="42" />
                <circle class="op-anillo-val" cx="50" cy="50" r="42" />
              </svg>
              <span class="op-anillo-num">94<i>%</i></span>
              <span class="op-anillo-pie">de tino</span>
            </div>
            <div class="op-briefing-txt">
              <span class="op-briefing-k">Tu analista se adelantó</span>
              <p>
                <b>$186,400 en quiebres</b> se resuelven con lo que ya tienes en el CEDIS ·
                <b>3 traspasos seguros</b> quedaron listos para un clic · La temporada de chamarras
                <b>muere en 10 días</b>: hay 84 piezas que deben salir esta semana.
              </p>
            </div>
          </div>

          <div class="op-rejilla">
            {tarjetas.map((c, i) => (
              <article class="op-tarjeta" data-i={i}>
                <span class="op-tarjeta-k">{c.k}</span>
                <p class="op-tarjeta-t" set:html={c.t} />

                <div class="op-prenda">
                  <span class="op-swatches" aria-hidden="true">
                    {c.colores.map((col) => <i style={`background:${COLORES[col]}`} />)}
                  </span>
                  <span class="op-prenda-txt">{c.prenda}</span>
                </div>

                <div class="op-curvita" aria-hidden="true">
                  {c.tallas.map(([t, v]) => (
                    <span class:list={['op-t', { cero: v === 0, sobra: v >= 18 }]}>
                      <b>{v}</b><i>{t}</i>
                    </span>
                  ))}
                </div>

                <p class="op-tarjeta-n"><b>{c.n}</b><span>{c.l}</span></p>
                <div class="op-chips">
                  {c.chips.map((ch) => <span class="op-chip">{ch}</span>)}
                </div>
                <span class="op-cta">{c.cta} <i>→</i></span>
              </article>
            ))}
          </div>

        </div>

        <!-- La corrida voltea SOBRE el tablero, no debajo: apilada no cabe en
             la pantalla pegada y las tarjetas tendrían que encogerse. -->
        <div class="op-corrida">
            <div class="op-corrida-cab">
              <span class="op-corrida-k">La corrida · vestido slip terracota</span>
              <span class="op-corrida-pie">Donde hay un cero, hay venta que no ocurre</span>
            </div>
            <table class="op-corrida-tabla">
              <thead>
                <tr>
                  <th scope="col"><span class="vo">Tienda</span></th>
                  {TALLAS.map((t) => <th scope="col">{t}</th>)}
                </tr>
              </thead>
              <tbody>
                {corrida.map((f) => (
                  <tr>
                    <th scope="row">{f.tienda}</th>
                    {f.v.map((v) => (
                      <td class:list={[{ cero: v === 0, sobra: v >= 18 }]}>{v}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="op-corrida-txt">
              Cuatro tiendas, cinco tallas, una prenda. <b>Cinco huecos</b> y una talla que sobra
              en Satélite — y todo se resuelve moviendo lo que ya tienes.
            </p>
        </div>

        <!-- La vida del producto: el ciclo completo de una prenda. -->
        <div class="op-vida">
          <div class="op-vida-cab">
            <div>
              <span class="op-vida-k">Día 124 de su ciclo</span>
              <h3>Vestido bordado vino</h3>
              <div class="op-vida-chips">
                <span class="op-estado"><i></i> Maduro — ritmo estable</span>
                <span class="op-pago">★ Ya pagó su lote</span>
              </div>
            </div>
            <div class="op-vida-cifras">
              <span><b>78%</b><i>ya se vendió</i></span>
              <span class="op-vida-limpio"><b>$37,325</b><i>te dejó, limpios</i></span>
            </div>
          </div>

          <div class="op-grafica">
            <svg viewBox="0 0 400 140" preserveAspectRatio="none" aria-hidden="true">
              <path class="op-area" d="M8 128 C40 122 80 104 110 88 C145 70 205 48 250 36 C290 26 315 21 330 18 C355 15 375 13 392 12 L392 132 L8 132 Z" />
              <path class="op-linea" d="M8 128 C40 122 80 104 110 88 C145 70 205 48 250 36 C290 26 315 21 330 18 C355 15 375 13 392 12" />
            </svg>
            <span class="op-hito op-hito--ini" style="left:2%"><i></i></span>
            <span class="op-hito op-hito--lote" style="left:62.5%"><i>★</i></span>
            <span class="op-hito op-hito--pico" style="left:82.5%"><i></i></span>
          </div>

          <div class="op-hitos">
            <div><strong>día 0 · llegó</strong><span>158 piezas · lote de $94,800</span></div>
            <div><strong>día 71 · pagó su lote</strong><span>desde aquí, todo es ganancia</span></div>
            <div><strong>día 87 · su pico</strong><span>34 piezas en una semana</span></div>
          </div>
        </div>

        <!-- El detalle: lo que pasa al abrir una tarjeta. -->
        <div class="op-detalle" aria-hidden="true">
          <div class="op-detalle-cab">
            <div>
              <h3>El plan, pieza por pieza</h3>
              <p>Falta − lo que ya viene en camino = lo que de verdad se mueve. Nada se duplica.</p>
            </div>
            <span class="op-detalle-tag">Traspaso desde el CEDIS</span>
          </div>

          <div class="op-detalle-cuerpo">
            <div class="op-movs">
              <span class="op-movs-k">Movimientos seguros — listos para un clic</span>
              <div class="op-mov"><b>48</b><div><strong>CEDIS → Polanco</strong><span>Sneakers python · se venden 11/semana allá</span></div></div>
              <div class="op-mov"><b>36</b><div><strong>CEDIS → Roma</strong><span>Sneaker rojo/negro · la talla 26 está en cero</span></div></div>
              <div class="op-mov op-mov--ojo"><b>22</b><div><strong>CEDIS → Satélite</strong><span>Bolso denim · evidencia corta</span></div><span class="op-ojo">Con ojo</span></div>
            </div>

            <div class="op-curva">
              <span class="op-movs-k">La curva de tallas en Polanco</span>
              <div class="op-tallas">
                <span class="op-talla"><b>6</b><i>22</i></span>
                <span class="op-talla"><b>4</b><i>23</i></span>
                <span class="op-talla op-talla--cero"><b>0</b><i>24</i></span>
                <span class="op-talla op-talla--cero"><b>0</b><i>25</i></span>
                <span class="op-talla"><b>3</b><i>26</i></span>
                <span class="op-talla"><b>5</b><i>27</i></span>
              </div>
              <p class="op-curva-txt">Las tallas del centro — las que más venden — están en <b>cero</b>. El plan las llena primero: sin curva completa no hay venta.</p>
            </div>
          </div>

          <div class="op-detalle-pie">
            <span class="op-boton">Crear los 3 traspasos seguros</span>
            <p>Nacen “Por enviar”: nada sale de una tienda hasta que alguien los envíe desde Transferencias. Tú siempre tienes la última palabra.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="op-recorrido" aria-hidden="true"></div>
  </div>
</section>

<style>
  .op {
    position: relative;
    background: #F5F3EE;
    color: #1A1A1A;
    scroll-margin-top: 80px;
  }
  .op-riel { position: relative; }
  .op-pegado {
    position: sticky; top: 0; min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-columns: 0.86fr 1.14fr; align-items: center;
    gap: clamp(20px, 3vw, 56px);
    padding: clamp(74px, 9vh, 104px) clamp(20px, 4vw, 64px) clamp(18px, 3vh, 40px);
  }

  /* ── El panel ── */
  .op-kicker {
    display: inline-block; padding: 6px 13px; border-radius: 999px;
    border: 1px solid rgba(15,23,42,.14); background: rgba(255,255,255,.7);
    font-size: 0.6875rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    color: #4A4A4A;
  }
  .op-titulo {
    font-family: var(--font-display); font-size: clamp(1.9rem, 3.4vw, 2.9rem); font-weight: 800;
    line-height: 1.04; letter-spacing: -.035em; margin: 16px 0 0; color: #1A1A1A;
  }
  .op-titulo em { font-style: normal; color: #4A4A4A; }

  .op-etapas { display: grid; gap: 2px; margin-top: clamp(18px, 3vh, 30px); }
  .op-etapa {
    display: grid; grid-template-columns: 30px 1fr; gap: 12px; align-items: start;
    padding: 10px 0; border-top: 1px solid rgba(15,23,42,.1);
    opacity: .3; transition: opacity .4s ease;
  }
  .op-etapa.on { opacity: 1; }
  .op-etapa-n {
    font-family: var(--font-display); font-size: 0.6875rem; font-weight: 800;
    color: #8C8C8C; padding-top: 3px;
  }
  .op-etapa h3 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; margin: 0 0 3px; }
  .op-etapa p { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: #4A4A4A; max-width: 46ch; }
  .op-etapa:not(.on) p { display: none; }

  .op-barra { height: 2px; background: rgba(15,23,42,.12); border-radius: 2px; overflow: hidden; margin-top: 14px; }
  .op-barra span { display: block; height: 100%; width: 16%; background: #1A1A1A; transition: width .35s ease; }

  /* ── El tablero ── */
  .op-lienzo { position: relative; }
  .op-tablero {
    background: #FAFAF8; border: 1px solid rgba(15,23,42,.08); border-radius: 20px;
    padding: clamp(14px, 1.6vw, 22px);
    box-shadow: 0 30px 60px rgba(15,23,42,.10);
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op-tablero-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .op-marca { font-family: var(--font-display); font-weight: 800; font-size: 0.9375rem; letter-spacing: -.02em; }
  .op-marca i { display: inline-block; width: 6px; height: 6px; border-radius: 2px; background: #2AB5A0; margin: 0 6px; }
  .op-sello { font-size: 0.625rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #8C8C8C; }

  /* El briefing entra al final: es la conclusión, no el punto de partida. */
  .op-briefing {
    display: flex; align-items: center; gap: clamp(12px, 1.6vw, 22px);
    background: #1D1D1F; color: #fff; border-radius: 14px;
    padding: clamp(10px, 1.2vw, 14px) clamp(14px, 1.8vw, 20px);
    opacity: 0; transform: translateY(-10px);
    transition: opacity .55s ease, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  .op.brief .op-briefing { opacity: 1; transform: none; }
  .op-anillo { position: relative; width: 66px; height: 66px; flex: none; display: grid; place-items: center; }
  .op-anillo svg { position: absolute; inset: 0; transform: rotate(-90deg); }
  .op-anillo circle { fill: none; stroke-width: 8; }
  .op-anillo-base { stroke: rgba(255,255,255,.14); }
  .op-anillo-val {
    stroke: #2AB5A0; stroke-linecap: round;
    stroke-dasharray: 264; stroke-dashoffset: 264;
    transition: stroke-dashoffset 1.1s cubic-bezier(.4,0,.2,1) .15s;
  }
  .op.brief .op-anillo-val { stroke-dashoffset: 16; }
  .op-anillo-num { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; line-height: 1; }
  .op-anillo-num i { font-style: normal; font-size: .7em; }
  .op-anillo-pie {
    position: absolute; bottom: 12px; font-size: 0.5rem; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55);
  }
  .op-briefing-k {
    display: block; font-size: 0.625rem; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: #2AB5A0; margin-bottom: 4px;
  }
  .op-briefing-txt p { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: rgba(255,255,255,.86); }
  .op-briefing-txt b { color: #fff; }

  .op-rejilla {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(10px, 1.1vw, 16px);
    margin-top: clamp(10px, 1.4vw, 16px);
  }
  .op-tarjeta {
    position: relative; background: #fff; border-radius: 14px; overflow: hidden;
    padding: clamp(13px, 1.1vw, 17px); border: 1px solid rgba(15,23,42,.07);
    box-shadow: 0 6px 18px rgba(15,23,42,.05);
    /* Cada tarjeta entra sola: la sección existe para enseñar que un dato
       suelto no decide nada y seis juntos sí. */
    opacity: 0; transform: translateY(16px) scale(.97);
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op-tarjeta.on { opacity: 1; transform: none; }
  .op-tarjeta-k {
    display: block; font-size: 0.5625rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: #8C8C8C; margin-bottom: 8px;
  }
  .op-tarjeta-t {
    font-family: var(--font-display); font-size: 1rem; font-weight: 700; line-height: 1.26;
    margin: 0 0 10px; color: #1A1A1A; letter-spacing: -.02em;
  }
  /* Lo resaltado es la TALLA o el COLOR del que se habla, no un color de
     categoría: la rejilla dejó de leerse como semáforo. */
  .op-tarjeta-t :global(b) { color: #1A1A1A; box-shadow: inset 0 -.42em 0 rgba(229,75,75,.16); }

  .op-prenda { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
  .op-swatches { display: inline-flex; }
  .op-swatches i {
    width: 15px; height: 15px; border-radius: 50%; display: block;
    border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(15,23,42,.12); margin-right: -5px;
  }
  .op-prenda-txt { font-size: 0.75rem; font-weight: 600; color: #4A4A4A; }

  /* La curva de la prenda dentro de la tarjeta: el hueco se ve sin leer. */
  .op-curvita { display: flex; gap: 4px; margin-bottom: 10px; }
  .op-t {
    flex: 1; text-align: center; padding: 5px 2px; border-radius: 8px;
    background: #F5F3EE; border: 1px solid transparent;
  }
  .op-t b { display: block; font-family: var(--font-display); font-size: 0.9375rem; font-weight: 800; }
  .op-t i { font-style: normal; font-size: 0.5625rem; font-weight: 700; color: #8C8C8C; }
  .op-t.cero { background: #FDF2F2; border-color: #F3C9C9; }
  .op-t.cero b { color: #E54B4B; }
  .op-t.sobra { background: #FDF7EC; border-color: #F0DDB4; }
  .op-t.sobra b { color: #B9781F; }
  .op-tarjeta-n { margin: 0 0 8px; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .op-tarjeta-n b { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; letter-spacing: -.03em; }
  .op-tarjeta-n span {
    font-size: 0.5625rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: #8C8C8C;
  }
  .op-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 9px; }
  .op-chip {
    padding: 3px 8px; border-radius: 999px; background: rgba(15,23,42,.05);
    font-size: 0.5625rem; font-weight: 700; color: #4A4A4A;
  }
  .op-cta {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 999px;
    background: #1A1A1A; color: #fff; font-size: 0.6875rem; font-weight: 800;
  }
  .op-cta i { font-style: normal; }

  /* ── La corrida: la curva en todas las tiendas a la vez ── */
  .op-corrida {
    position: absolute; inset: 0; z-index: 3;
    display: flex; flex-direction: column; justify-content: center;
    background: #fff; border-radius: 20px;
    padding: clamp(20px, 2.4vw, 34px); border: 1px solid rgba(15,23,42,.08);
    box-shadow: 0 40px 80px rgba(15,23,42,.16);
    opacity: 0; transform: translateY(20px) scale(.98); pointer-events: none;
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op.corrida .op-corrida { opacity: 1; transform: none; }
  .op.corrida .op-tablero { opacity: .3; transform: scale(.985); }
  .op-corrida-txt { margin: 14px 0 0; font-size: 0.875rem; line-height: 1.55; color: #4A4A4A; }
  .op-corrida-txt b { color: #E54B4B; }
  .op-corrida-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
  .op-corrida-k {
    font-size: 0.5625rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #4A4A4A;
  }
  .op-corrida-pie { font-size: 0.6875rem; font-weight: 600; color: #E54B4B; }
  .op-corrida-tabla { width: 100%; border-collapse: collapse; }
  .op-corrida-tabla th, .op-corrida-tabla td { padding: clamp(9px, 1.1vh, 14px) 4px; text-align: center; }
  .op-corrida-tabla thead th {
    font-size: 0.5625rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #8C8C8C;
  }
  .op-corrida-tabla tbody th {
    text-align: left; font-size: 0.9375rem; font-weight: 700; color: #1A1A1A; white-space: nowrap;
  }
  .op-corrida-tabla tbody td {
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: #334155;
    font-variant-numeric: tabular-nums;
  }
  .op-corrida-tabla tbody tr { border-top: 1px solid rgba(15,23,42,.07); }
  .op-corrida-tabla td.cero { color: #E54B4B; background: #FDF2F2; border-radius: 8px; }
  .op-corrida-tabla td.sobra { color: #B9781F; background: #FDF7EC; border-radius: 8px; }

  /* ── La vida del producto ── */
  .op-vida {
    position: absolute; inset: 0; z-index: 5;
    display: flex; flex-direction: column; justify-content: center; gap: clamp(12px, 1.6vh, 22px);
    background: #FAFAF8; border-radius: 20px;
    padding: clamp(20px, 2.4vw, 34px); border: 1px solid rgba(26,26,26,.08);
    box-shadow: 0 40px 80px rgba(26,26,26,.16);
    opacity: 0; transform: translateY(20px) scale(.98); pointer-events: none;
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op.vida .op-vida { opacity: 1; transform: none; }
  .op.vida .op-tablero { opacity: .3; transform: scale(.985); }
  .op-vida-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .op-vida-k { font-size: 0.625rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #8C8C8C; }
  .op-vida-cab h3 {
    font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 2.1rem); font-weight: 800;
    letter-spacing: -.035em; margin: 4px 0 10px; color: #1A1A1A;
  }
  .op-vida-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .op-estado, .op-pago {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px;
    font-size: 0.75rem; font-weight: 700;
  }
  .op-estado { background: #E6F6F3; color: #14766A; }
  .op-estado i { width: 7px; height: 7px; border-radius: 50%; background: #2AB5A0; }
  .op-pago { background: #FDF3DE; color: #8A6413; }
  .op-vida-cifras { display: flex; gap: clamp(16px, 2vw, 32px); }
  .op-vida-cifras span { display: flex; flex-direction: column; }
  .op-vida-cifras b { font-family: var(--font-display); font-size: clamp(1.6rem, 2.8vw, 2.4rem); font-weight: 800; letter-spacing: -.035em; color: #1A1A1A; }
  .op-vida-cifras i {
    font-style: normal; font-size: 0.5625rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: #8C8C8C;
  }
  .op-vida-limpio b { color: #2AB5A0; }

  /* La curva se DIBUJA al llegar: el punto de la lámina es ver el ciclo
     avanzar, no un gráfico ya hecho. */
  .op-grafica { position: relative; flex: 1; min-height: clamp(100px, 17vh, 170px); max-height: 30vh; }
  .op-grafica svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .op-area { fill: rgba(42,181,160,.13); opacity: 0; transition: opacity .6s ease .5s; }
  .op-linea {
    fill: none; stroke: #2AB5A0; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 460; stroke-dashoffset: 460;
    transition: stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1) .1s;
  }
  .op.vida .op-linea { stroke-dashoffset: 0; }
  .op.vida .op-area { opacity: 1; }
  .op-hito { position: absolute; bottom: 0; transform: translate(-50%, 0); opacity: 0; transition: opacity .4s ease; }
  .op.vida .op-hito { opacity: 1; }
  .op.vida .op-hito--ini { transition-delay: .3s; }
  .op.vida .op-hito--lote { transition-delay: .9s; }
  .op.vida .op-hito--pico { transition-delay: 1.2s; }
  .op-hito i {
    display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
    font-style: normal; font-size: 11px; color: #fff; box-shadow: 0 0 0 3px #FAFAF8;
  }
  .op-hito--ini { bottom: 6%; }
  .op-hito--ini i { background: #4B7BE5; }
  .op-hito--lote { bottom: 74%; }
  .op-hito--lote i { background: #E8A838; color: #5A4310; }
  .op-hito--pico { bottom: 86%; }
  .op-hito--pico i { background: #2AB5A0; }
  .op-hitos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; }
  .op-hitos strong { display: block; font-size: 0.8125rem; font-weight: 700; color: #1A1A1A; }
  .op-hitos span { font-size: 0.6875rem; color: #4A4A4A; }

  /* ── El detalle: lo que pasa al abrir una tarjeta ── */
  .op-detalle {
    position: absolute; inset: 0; z-index: 4;
    background: #fff; border: 1px solid rgba(15,23,42,.08); border-radius: 20px;
    padding: clamp(16px, 2vw, 26px);
    box-shadow: 0 40px 80px rgba(15,23,42,.18);
    display: flex; flex-direction: column; gap: clamp(10px, 1.4vw, 16px);
    opacity: 0; transform: translateY(24px) scale(.98); pointer-events: none;
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op.abre .op-detalle { opacity: 1; transform: none; }
  .op.abre .op-tablero { opacity: .35; transform: scale(.985); }
  .op-detalle-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .op-detalle-cab h3 { font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-weight: 800; margin: 0 0 4px; letter-spacing: -.03em; }
  .op-detalle-cab p { margin: 0; font-size: 0.8125rem; color: #4A4A4A; }
  .op-detalle-tag {
    flex: none; padding: 6px 12px; border-radius: 999px; background: #EDF2FD;
    color: #4B7BE5; font-size: 0.5625rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase;
  }
  .op-detalle-cuerpo { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(10px, 1.4vw, 16px); flex: 1; min-height: 0; }
  .op-movs, .op-curva { background: #F5F3EE; border-radius: 14px; padding: 14px; }
  .op-movs-k {
    display: block; font-size: 0.5625rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: #4A4A4A; margin-bottom: 10px;
  }
  .op-mov {
    display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 10px;
    padding: 10px 12px; margin-bottom: 7px;
  }
  .op-mov b { font-family: var(--font-display); font-size: 1.125rem; font-weight: 800; color: #4B7BE5; flex: none; }
  .op-mov strong { display: block; font-size: 0.8125rem; font-weight: 700; }
  .op-mov span { font-size: 0.6875rem; color: #4A4A4A; }
  .op-mov--ojo { background: #FDF7EC; border: 1px solid #F0DDB4; }
  .op-ojo {
    margin-left: auto; flex: none; padding: 3px 8px; border-radius: 999px; background: #F0DDB4;
    color: #92400E; font-size: 0.5625rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  }
  .op-tallas { display: flex; gap: 6px; margin-bottom: 10px; }
  .op-talla {
    flex: 1; background: #fff; border-radius: 10px; padding: 10px 4px; text-align: center;
    border: 1px solid transparent;
  }
  .op-talla b { display: block; font-family: var(--font-display); font-size: 1.125rem; font-weight: 800; }
  .op-talla i { font-style: normal; font-size: 0.625rem; color: #8C8C8C; }
  .op-talla--cero { background: #FDF2F2; border-color: #F3C9C9; }
  .op-talla--cero b { color: #E54B4B; }
  .op-curva-txt { margin: 0; font-size: 0.75rem; line-height: 1.5; color: #4A4A4A; }
  .op-curva-txt b { color: #E54B4B; }
  .op-detalle-pie { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .op-boton {
    padding: 12px 22px; border-radius: 999px; background: #4B7BE5; color: #fff;
    font-size: 0.8125rem; font-weight: 800;
  }
  .op-detalle-pie p { margin: 0; font-size: 0.6875rem; line-height: 1.45; color: #4A4A4A; max-width: 42ch; }

  /* El recorrido es caja propia, nunca padding: si no, el sticky no viaja. */
  .op-recorrido { height: 620vh; }

  /* ── Sin riel: móvil, poco movimiento o pantalla corta ── */
  .op.sin-riel .op-pegado { position: static; min-height: 0; grid-template-columns: 1fr; }
  .op.sin-riel .op-recorrido { display: none; }
  .op.sin-riel .op-etapa { opacity: 1; }
  .op.sin-riel .op-etapa p { display: block; }
  .op.sin-riel .op-barra { display: none; }
  .op.sin-riel .op-anillo-val { stroke-dashoffset: 16; }

  /* ── Móvil: la versión corta ──
     Aquí NO se intenta reproducir el tablero. Se probaron el sticky que cambia
     de pantalla y el carrusel: los dos terminan peleando con el pulgar o
     tapando el texto. En el teléfono la sección se RESUME — el titular, lo que
     el operador dejó hecho, las cuatro decisiones en una línea cada una y la
     corrida, que es lo único que de verdad hay que ver. El recorrido completo
     vive en escritorio. */
  @media (max-width: 1100px) {
    .op-pegado { position: static; min-height: 0; display: block; padding: 44px 18px 32px; }
    .op-recorrido { display: none; }
    .op-barra { display: none; }
    .op-titulo { margin-bottom: 14px; }

    /* De las siete etapas queda UNA: la que explica qué es esto. */
    .op-etapas { margin: 0 0 18px; gap: 0; }
    .op-etapa { display: none; }
    .op-etapa[data-i='4'] { display: block; opacity: 1; border: none; padding: 0; }
    .op-etapa[data-i='4'] .op-etapa-n, .op-etapa[data-i='4'] h3 { display: none; }
    .op-etapa[data-i='4'] p { display: block; max-width: none; font-size: 0.875rem; }

    .op-lienzo { margin: 0; }
    .op-tablero { background: none; border: none; box-shadow: none; padding: 0; opacity: 1; transform: none; }
    .op-tablero-cab { display: none; }

    .op-briefing { opacity: 1; transform: none; padding: 12px 14px; gap: 12px; margin-bottom: 14px; }
    .op-briefing-txt p { display: none; }
    .op-briefing-k { margin-bottom: 0; font-size: 0.6875rem; }
    .op-anillo { width: 48px; height: 48px; }
    .op-anillo-num { font-size: 0.875rem; }
    .op-anillo-pie { display: none; }
    .op-anillo-val { stroke-dashoffset: 16; }

    /* Las cuatro decisiones, una línea cada una: kicker, frase, cifra y curva.
       Sin chips ni botón — en el teléfono son ruido. */
    .op-rejilla { display: grid; grid-template-columns: 1fr; gap: 10px; margin: 0; }
    .op-tarjeta {
      position: static; opacity: 1; transform: none; padding: 14px;
      box-shadow: 0 6px 18px rgba(26,26,26,.06);
    }
    .op-tarjeta-t { font-size: 0.9375rem; margin-bottom: 8px; }
    .op-prenda { margin-bottom: 8px; }
    .op-curvita { margin-bottom: 8px; }
    .op-tarjeta-n { margin-bottom: 0; }
    .op-chips, .op-cta { display: none; }

    /* La corrida se queda: es lo que no se puede contar con palabras. */
    .op-corrida {
      position: static; opacity: 1; transform: none; margin-top: 14px; padding: 16px;
      border-radius: 14px; box-shadow: 0 6px 18px rgba(26,26,26,.06);
    }
    .op-corrida-tabla tbody th { font-size: 0.75rem; }
    .op-corrida-tabla tbody td { font-size: 1rem; }
    .op-corrida-txt { font-size: 0.8125rem; }

    /* El plan y la vida del producto son del recorrido de escritorio. */
    .op-detalle, .op-vida { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .op-pegado { position: static; min-height: 0; }
    .op-recorrido { display: none; }
    .op-tarjeta, .op-briefing, .op-detalle { transition: none; }
  }
</style>

<script>
  const sec = document.getElementById('operador');
  if (sec) {
    const etapas = [...sec.querySelectorAll<HTMLElement>('.op-etapa')];
    const tarjetas = [...sec.querySelectorAll<HTMLElement>('.op-tarjeta')];
    const barra = sec.querySelector<HTMLElement>('.op-barra span');
    const riel = sec.querySelector<HTMLElement>('.op-riel');
    const pegado = sec.querySelector<HTMLElement>('.op-pegado');
    const menos = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = etapas.length;
    let actual = -1;

    // Reparto del riel: las cuatro primeras etapas encienden tarjetas (1,2,3 y
    // luego las seis), la quinta trae el briefing y la sexta abre el detalle.
    // Cuántas tarjetas se ven en cada etapa:
    const CUANTAS = [1, 2, 3, 4, 4, 4, 4];

    // En el teléfono el tablero enseña UNA pantalla a la vez; en escritorio las
    // tarjetas se van sumando, que es lo que cuenta la historia ahí.
    const movil = () => window.innerWidth <= 1100;

    const marcar = (k: number) => {
      if (k === actual) return;
      actual = k;
      etapas.forEach((e, i) => e.classList.toggle('on', i === k));
      if (movil()) {
        // pasos 0-2 = una tarjeta cada uno; del 3 en adelante manda la vista
        const suya = k <= 2 ? k : -1;
        tarjetas.forEach((t, i) => t.classList.toggle('on', i === suya));
      } else {
        tarjetas.forEach((t, i) => t.classList.toggle('on', i < (CUANTAS[k] ?? 4)));
      }
      sec.classList.toggle('corrida', k === 3);
      sec.classList.toggle('brief', k >= 4);
      // En móvil el detalle y la vida son pantallas: no se quedan puestas.
      sec.classList.toggle('abre', k === 5);
      sec.classList.toggle('vida', movil() ? k === 6 : k >= 6);
      if (barra) barra.style.width = `${((k + 1) / N) * 100}%`;
    };

    const cabe = () => window.innerHeight >= 640 && window.innerWidth > 1100 && !menos;
    const revisarCabe = () => { sec.classList.toggle('sin-riel', !cabe()); return cabe(); };

    // La mitad de cada tramo se queda quieta: sin esa pausa las tarjetas se
    // encienden de corrido y no da tiempo de leer ninguna.
    const REPOSO = 0.45;
    const suave = (x: number) => x * x * (3 - 2 * x);

    let pidiendo = false;
    const alScroll = () => {
      if (pidiendo) return;
      pidiendo = true;
      requestAnimationFrame(() => {
        pidiendo = false;
        if (sec.classList.contains('sin-riel') || !riel || !pegado) return;
        const total = riel.offsetHeight - pegado.offsetHeight;
        if (total <= 0) return;
        const p = Math.min(1, Math.max(0, -riel.getBoundingClientRect().top / total));
        const tramo = p * (N - 1);
        const i = Math.min(N - 2, Math.floor(tramo));
        const t = Math.min(1, Math.max(0, tramo - i));
        const f = t <= REPOSO ? i : i + suave((t - REPOSO) / (1 - REPOSO));
        marcar(Math.round(f));
      });
    };

    // En móvil no hay riel: el paso activo lo decide el que esté en pantalla,
    // igual que en WhatsApp Commerce. Con el riel, el avance manda.
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (filas) => {
          if (!movil()) return;
          filas.forEach((f) => {
            if (f.isIntersecting) marcar(etapas.indexOf(f.target as HTMLElement));
          });
        },
        { threshold: 0.4, rootMargin: '-24% 0px -30% 0px' },
      );
      etapas.forEach((e) => obs.observe(e));
    }

    revisarCabe();
    marcar(0);
    window.addEventListener('scroll', alScroll, { passive: true });
    window.addEventListener('resize', () => { revisarCabe(); alScroll(); });
    alScroll();
  }
</script>
