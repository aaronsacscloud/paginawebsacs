---
/**
 * Operador — el tablero operativo armándose con el scroll.
 *
 * El argumento: Sacs no te da reportes, te da decisiones. Mientras cierras, el
 * operador revisa tiendas, CEDIS y temporada, y a las 3 a.m. deja seis frentes
 * resueltos en tarjetas que se entienden sin abrir un Excel.
 *
 * Por qué está construido en HTML y no con la captura del sistema: la pantalla
 * real es densa y se lee peor de lo que se entiende la idea. Aquí las tarjetas
 * son nodos de verdad, así que se pueden encender una por una con el scroll,
 * abrir al clic y leer con el pulgar. Los textos y los números SÍ son los del
 * tablero real — se cambian ahí, no aquí.
 *
 * Reglas de esta pieza:
 *  · El recorrido va como caja propia DENTRO del riel: un sticky solo viaja
 *    dentro del content box de quien lo contiene.
 *  · Los datos entran de uno en uno: un dato suelto no es una decisión, y la
 *    sección existe para enseñar justamente eso.
 *  · Sin riel (móvil, poco movimiento o pantalla corta) se vuelve una lista
 *    normal con todo abierto, que se lee igual de bien.
 */
const tarjetas = [
  {
    k: 'Traspaso urgente · desde el CEDIS',
    c: '#8B5CF6',
    t: 'El CEDIS tiene <b>128 pares</b> que tus tiendas están pidiendo a gritos.',
    n: '$186,400',
    l: 'en venta recuperada',
    chips: ['Seguro · la curva queda completa', '3 tiendas'],
    cta: 'Ver el plan',
    nuevo: true,
  },
  {
    k: 'Traspaso entre tiendas',
    c: '#3B82F6',
    t: 'Satélite tiene <b>46 piezas paradas</b> que Polanco vende en 12 días.',
    n: '$58,900',
    l: 'en dinero parado',
    chips: ['Gira 5× más rápido allá', 'Satélite → Polanco'],
    cta: 'Ver el plan',
  },
  {
    k: 'Compra · se está acabando',
    c: '#10B981',
    t: 'A la camisa de cuadros le quedan <b>9 días de vida</b> en tiendas. Es compra de lote.',
    n: '$74,200',
    l: 'de venta en riesgo',
    chips: ['Proveedor entrega en 12 días', 'Mejor margen del mes'],
    cta: 'Armar la compra',
    nuevo: true,
  },
  {
    k: 'Rebaja · siguiente escalón',
    c: '#EC4899',
    t: 'La chamarra acolchada lleva <b>41 días dormida</b>: el −25% la saca en 3 semanas.',
    n: '$32,600',
    l: 'recuperables con rebaja',
    chips: ['Escalón 2 de 3 · −25%', 'aún deja 38% de margen'],
    cta: 'Preparar la rebaja',
  },
  {
    k: 'Liquidación · la temporada se acaba',
    c: '#F97316',
    t: 'La temporada de chamarras <b>muere en 10 días</b>: 84 piezas deben salir ya.',
    n: '$41,300',
    l: 'antes de que sea merma',
    chips: ['Configurable: tú pones las reglas'],
    cta: 'Ver la liquidación',
  },
  {
    k: 'La vida del producto',
    c: '#0F172A',
    t: '2 vidas piden una decisión hoy — su ciclo habla.',
    n: '2',
    l: 'fichas abiertas',
    chips: ['Una ya pagó su lote', 'otra pide su primer escalón'],
    cta: 'Abrir sus fichas',
  },
];

// Lo que va contando el panel de la izquierda conforme se arma el tablero.
const etapas = [
  { t: 'Un dato suelto no decide nada.', d: 'Sabes que el CEDIS tiene 128 pares parados. ¿Y luego? El dato no dice a qué tienda, ni cuánto, ni si vale la pena moverlos.' },
  { t: 'Dos ya son una comparación.', d: 'Ahora hay dinero parado en dos frentes. ¿Cuál primero? Aquí es donde normalmente empieza el Excel.' },
  { t: 'Tres, y aparece la pregunta cara.', d: 'Mover, comprar o esperar. Cada respuesta cuesta dinero y cada una necesita datos que viven en reportes distintos.' },
  { t: 'Seis frentes abiertos a la vez.', d: 'Traspasos, compra, rebaja, liquidación y ciclo de vida. Ninguna tienda tiene a alguien revisando esto todas las noches.' },
  { t: 'Tu analista se adelantó.', d: 'A las 3 de la mañana el operador ya recorrió tus tiendas, tu CEDIS y tu temporada. No te deja un reporte: te deja las decisiones tomadas y ordenadas por lo que cuesta no tomarlas.' },
  { t: 'Y cada tarjeta abre el plan, pieza por pieza.', d: 'Falta − lo que ya viene en camino = lo que de verdad se mueve. Nada se duplica, y nada sale de una tienda hasta que tú lo envías.' },
];
---

<section class="op" id="operador" data-etapas={etapas.length}>
  <div class="op-riel">
    <div class="op-pegado">
      <div class="op-panel">
        <span class="op-kicker">Operador de inventario · trabaja de noche</span>
        <h2 class="op-titulo">Deja de sacar reportes.<br /><em>Sacs ya te dejó las decisiones.</em></h2>

        <div class="op-etapas">
          {etapas.map((e, i) => (
            <div class:list={['op-etapa', { on: i === 0 }]} data-i={i}>
              <span class="op-etapa-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{e.t}</h3>
                <p>{e.d}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="op-barra" aria-hidden="true"><span></span></div>
      </div>

      <div class="op-lienzo">
        <div class="op-tablero">
          <div class="op-tablero-cab">
            <span class="op-marca">Sacs<i></i>Tablero operativo</span>
            <span class="op-sello">Hoy, 3:00 a.m. — datos frescos</span>
          </div>

          <div class="op-briefing">
            <div class="op-anillo" aria-hidden="true">
              <svg viewBox="0 0 100 100">
                <circle class="op-anillo-base" cx="50" cy="50" r="42" />
                <circle class="op-anillo-val" cx="50" cy="50" r="42" />
              </svg>
              <span class="op-anillo-num">94<i>%</i></span>
              <span class="op-anillo-pie">de tino</span>
            </div>
            <div class="op-briefing-txt">
              <span class="op-briefing-k">Tu analista se adelantó</span>
              <p>
                <b>$186,400 en quiebres</b> se resuelven con lo que ya tienes en el CEDIS ·
                <b>3 traspasos seguros</b> quedaron listos para un clic · La temporada de chamarras
                <b>muere en 10 días</b>: hay 84 piezas que deben salir esta semana.
              </p>
            </div>
          </div>

          <div class="op-rejilla">
            {tarjetas.map((c, i) => (
              <article class="op-tarjeta" data-i={i} style={`--c:${c.c}`}>
                <div class="op-tarjeta-cab">
                  <span class="op-tarjeta-k">{c.k}</span>
                  {c.nuevo && <span class="op-nuevo">Nuevo hoy</span>}
                </div>
                <p class="op-tarjeta-t" set:html={c.t} />
                <p class="op-tarjeta-n"><b>{c.n}</b><span>{c.l}</span></p>
                <div class="op-chips">
                  {c.chips.map((ch) => <span class="op-chip">{ch}</span>)}
                </div>
                <span class="op-cta">{c.cta} <i>→</i></span>
              </article>
            ))}
          </div>
        </div>

        <!-- El detalle: lo que pasa al abrir una tarjeta. -->
        <div class="op-detalle" aria-hidden="true">
          <div class="op-detalle-cab">
            <div>
              <h3>El plan, pieza por pieza</h3>
              <p>Falta − lo que ya viene en camino = lo que de verdad se mueve. Nada se duplica.</p>
            </div>
            <span class="op-detalle-tag">Traspaso desde el CEDIS</span>
          </div>

          <div class="op-detalle-cuerpo">
            <div class="op-movs">
              <span class="op-movs-k">Movimientos seguros — listos para un clic</span>
              <div class="op-mov"><b>48</b><div><strong>CEDIS → Polanco</strong><span>Sneakers python · se venden 11/semana allá</span></div></div>
              <div class="op-mov"><b>36</b><div><strong>CEDIS → Roma</strong><span>Sneaker rojo/negro · la talla 26 está en cero</span></div></div>
              <div class="op-mov op-mov--ojo"><b>22</b><div><strong>CEDIS → Satélite</strong><span>Bolso denim · evidencia corta</span></div><span class="op-ojo">Con ojo</span></div>
            </div>

            <div class="op-curva">
              <span class="op-movs-k">La curva de tallas en Polanco</span>
              <div class="op-tallas">
                <span class="op-talla"><b>6</b><i>22</i></span>
                <span class="op-talla"><b>4</b><i>23</i></span>
                <span class="op-talla op-talla--cero"><b>0</b><i>24</i></span>
                <span class="op-talla op-talla--cero"><b>0</b><i>25</i></span>
                <span class="op-talla"><b>3</b><i>26</i></span>
                <span class="op-talla"><b>5</b><i>27</i></span>
              </div>
              <p class="op-curva-txt">Las tallas del centro — las que más venden — están en <b>cero</b>. El plan las llena primero: sin curva completa no hay venta.</p>
            </div>
          </div>

          <div class="op-detalle-pie">
            <span class="op-boton">Crear los 3 traspasos seguros</span>
            <p>Nacen “Por enviar”: nada sale de una tienda hasta que alguien los envíe desde Transferencias. Tú siempre tienes la última palabra.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="op-recorrido" aria-hidden="true"></div>
  </div>
</section>

<style>
  .op {
    position: relative;
    background: #F4F3EF;
    color: #0F172A;
    scroll-margin-top: 80px;
  }
  .op-riel { position: relative; }
  .op-pegado {
    position: sticky; top: 0; min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-columns: 0.86fr 1.14fr; align-items: center;
    gap: clamp(20px, 3vw, 56px);
    padding: clamp(80px, 11vh, 120px) clamp(20px, 4vw, 64px) clamp(28px, 5vh, 64px);
  }

  /* ── El panel ── */
  .op-kicker {
    display: inline-block; padding: 6px 13px; border-radius: 999px;
    border: 1px solid rgba(15,23,42,.14); background: rgba(255,255,255,.7);
    font-size: 0.6875rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    color: #475569;
  }
  .op-titulo {
    font-family: var(--font-display); font-size: clamp(1.9rem, 3.4vw, 2.9rem); font-weight: 800;
    line-height: 1.04; letter-spacing: -.035em; margin: 16px 0 0; color: #0F172A;
  }
  .op-titulo em { font-style: normal; color: #64748B; }

  .op-etapas { display: grid; gap: 2px; margin-top: clamp(18px, 3vh, 30px); }
  .op-etapa {
    display: grid; grid-template-columns: 30px 1fr; gap: 12px; align-items: start;
    padding: 10px 0; border-top: 1px solid rgba(15,23,42,.1);
    opacity: .3; transition: opacity .4s ease;
  }
  .op-etapa.on { opacity: 1; }
  .op-etapa-n {
    font-family: var(--font-display); font-size: 0.6875rem; font-weight: 800;
    color: #94A3B8; padding-top: 3px;
  }
  .op-etapa h3 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; margin: 0 0 3px; }
  .op-etapa p { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: #475569; max-width: 46ch; }
  .op-etapa:not(.on) p { display: none; }

  .op-barra { height: 2px; background: rgba(15,23,42,.12); border-radius: 2px; overflow: hidden; margin-top: 14px; }
  .op-barra span { display: block; height: 100%; width: 16%; background: #0F172A; transition: width .35s ease; }

  /* ── El tablero ── */
  .op-lienzo { position: relative; }
  .op-tablero {
    background: #FBFAF7; border: 1px solid rgba(15,23,42,.08); border-radius: 20px;
    padding: clamp(14px, 1.6vw, 22px);
    box-shadow: 0 30px 60px rgba(15,23,42,.10);
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op-tablero-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .op-marca { font-family: var(--font-display); font-weight: 800; font-size: 0.9375rem; letter-spacing: -.02em; }
  .op-marca i { display: inline-block; width: 6px; height: 6px; border-radius: 2px; background: #10B981; margin: 0 6px; }
  .op-sello { font-size: 0.625rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #94A3B8; }

  /* El briefing entra al final: es la conclusión, no el punto de partida. */
  .op-briefing {
    display: flex; align-items: center; gap: clamp(12px, 1.6vw, 22px);
    background: #0F172A; color: #fff; border-radius: 14px;
    padding: clamp(12px, 1.6vw, 18px) clamp(14px, 1.8vw, 22px);
    opacity: 0; transform: translateY(-10px);
    transition: opacity .55s ease, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  .op.brief .op-briefing { opacity: 1; transform: none; }
  .op-anillo { position: relative; width: 76px; height: 76px; flex: none; display: grid; place-items: center; }
  .op-anillo svg { position: absolute; inset: 0; transform: rotate(-90deg); }
  .op-anillo circle { fill: none; stroke-width: 8; }
  .op-anillo-base { stroke: rgba(255,255,255,.14); }
  .op-anillo-val {
    stroke: #10B981; stroke-linecap: round;
    stroke-dasharray: 264; stroke-dashoffset: 264;
    transition: stroke-dashoffset 1.1s cubic-bezier(.4,0,.2,1) .15s;
  }
  .op.brief .op-anillo-val { stroke-dashoffset: 16; }
  .op-anillo-num { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; line-height: 1; }
  .op-anillo-num i { font-style: normal; font-size: .7em; }
  .op-anillo-pie {
    position: absolute; bottom: 12px; font-size: 0.5rem; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55);
  }
  .op-briefing-k {
    display: block; font-size: 0.625rem; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: #34D399; margin-bottom: 4px;
  }
  .op-briefing-txt p { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: rgba(255,255,255,.86); }
  .op-briefing-txt b { color: #fff; }

  .op-rejilla {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(8px, 1vw, 14px);
    margin-top: clamp(10px, 1.4vw, 16px);
  }
  .op-tarjeta {
    position: relative; background: #fff; border-radius: 14px; overflow: hidden;
    padding: 14px 14px 12px; border: 1px solid rgba(15,23,42,.07);
    box-shadow: 0 6px 18px rgba(15,23,42,.05);
    /* Cada tarjeta entra sola: la sección existe para enseñar que un dato
       suelto no decide nada y seis juntos sí. */
    opacity: 0; transform: translateY(16px) scale(.97);
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op-tarjeta::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--c);
  }
  .op-tarjeta.on { opacity: 1; transform: none; }
  .op-tarjeta-cab { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
  .op-tarjeta-k {
    font-size: 0.5625rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase;
    color: var(--c); line-height: 1.3;
  }
  .op-nuevo {
    margin-left: auto; flex: none; padding: 3px 7px; border-radius: 999px; background: #0F172A;
    color: #fff; font-size: 0.5rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
  }
  .op-tarjeta-t {
    font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; line-height: 1.25;
    margin: 0 0 8px; color: #0F172A; letter-spacing: -.015em;
  }
  .op-tarjeta-t :global(b) { color: var(--c); }
  .op-tarjeta-n { margin: 0 0 8px; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .op-tarjeta-n b { font-family: var(--font-display); font-size: 1.375rem; font-weight: 800; letter-spacing: -.03em; }
  .op-tarjeta-n span {
    font-size: 0.5625rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: #94A3B8;
  }
  .op-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px; }
  .op-chip {
    padding: 3px 8px; border-radius: 999px; background: rgba(15,23,42,.05);
    font-size: 0.5625rem; font-weight: 700; color: #475569;
  }
  .op-cta {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 999px;
    background: #0F172A; color: #fff; font-size: 0.6875rem; font-weight: 800;
  }
  .op-cta i { font-style: normal; }

  /* ── El detalle: lo que pasa al abrir una tarjeta ── */
  .op-detalle {
    position: absolute; inset: 0; z-index: 4;
    background: #fff; border: 1px solid rgba(15,23,42,.08); border-radius: 20px;
    padding: clamp(16px, 2vw, 26px);
    box-shadow: 0 40px 80px rgba(15,23,42,.18);
    display: flex; flex-direction: column; gap: clamp(10px, 1.4vw, 16px);
    opacity: 0; transform: translateY(24px) scale(.98); pointer-events: none;
    transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.3,1);
  }
  .op.abre .op-detalle { opacity: 1; transform: none; }
  .op.abre .op-tablero { opacity: .35; transform: scale(.985); }
  .op-detalle-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .op-detalle-cab h3 { font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-weight: 800; margin: 0 0 4px; letter-spacing: -.03em; }
  .op-detalle-cab p { margin: 0; font-size: 0.8125rem; color: #64748B; }
  .op-detalle-tag {
    flex: none; padding: 6px 12px; border-radius: 999px; background: #F3EEFF;
    color: #7C3AED; font-size: 0.5625rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase;
  }
  .op-detalle-cuerpo { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(10px, 1.4vw, 16px); flex: 1; min-height: 0; }
  .op-movs, .op-curva { background: #F6F5F2; border-radius: 14px; padding: 14px; }
  .op-movs-k {
    display: block; font-size: 0.5625rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: #64748B; margin-bottom: 10px;
  }
  .op-mov {
    display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 10px;
    padding: 10px 12px; margin-bottom: 7px;
  }
  .op-mov b { font-family: var(--font-display); font-size: 1.125rem; font-weight: 800; color: #7C3AED; flex: none; }
  .op-mov strong { display: block; font-size: 0.8125rem; font-weight: 700; }
  .op-mov span { font-size: 0.6875rem; color: #64748B; }
  .op-mov--ojo { background: #FFFBEB; border: 1px solid #FDE68A; }
  .op-ojo {
    margin-left: auto; flex: none; padding: 3px 8px; border-radius: 999px; background: #FDE68A;
    color: #92400E; font-size: 0.5625rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  }
  .op-tallas { display: flex; gap: 6px; margin-bottom: 10px; }
  .op-talla {
    flex: 1; background: #fff; border-radius: 10px; padding: 10px 4px; text-align: center;
    border: 1px solid transparent;
  }
  .op-talla b { display: block; font-family: var(--font-display); font-size: 1.125rem; font-weight: 800; }
  .op-talla i { font-style: normal; font-size: 0.625rem; color: #94A3B8; }
  .op-talla--cero { background: #FFF1F5; border-color: #FBCFE8; }
  .op-talla--cero b { color: #EC4899; }
  .op-curva-txt { margin: 0; font-size: 0.75rem; line-height: 1.5; color: #475569; }
  .op-curva-txt b { color: #EC4899; }
  .op-detalle-pie { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .op-boton {
    padding: 12px 22px; border-radius: 999px; background: #7C3AED; color: #fff;
    font-size: 0.8125rem; font-weight: 800;
  }
  .op-detalle-pie p { margin: 0; font-size: 0.6875rem; line-height: 1.45; color: #64748B; max-width: 42ch; }

  /* El recorrido es caja propia, nunca padding: si no, el sticky no viaja. */
  .op-recorrido { height: 520vh; }

  /* ── Sin riel: móvil, poco movimiento o pantalla corta ── */
  .op.sin-riel .op-pegado { position: static; min-height: 0; grid-template-columns: 1fr; }
  .op.sin-riel .op-recorrido { display: none; }
  .op.sin-riel .op-etapa { opacity: 1; }
  .op.sin-riel .op-etapa p { display: block; }
  .op.sin-riel .op-barra { display: none; }
  .op.sin-riel .op-tarjeta { opacity: 1; transform: none; }
  .op.sin-riel .op-briefing { opacity: 1; transform: none; }
  .op.sin-riel .op-anillo-val { stroke-dashoffset: 16; }
  .op.sin-riel .op-rejilla { grid-template-columns: 1fr; }
  .op.sin-riel .op-detalle {
    position: static; opacity: 1; transform: none; margin-top: 16px;
    box-shadow: 0 12px 30px rgba(15,23,42,.10);
  }
  .op.sin-riel .op-detalle-cuerpo { grid-template-columns: 1fr; }
  .op.sin-riel .op-tablero { opacity: 1; transform: none; }

  @media (max-width: 1100px) {
    .op-pegado { position: static; min-height: 0; grid-template-columns: 1fr; padding: 56px 20px; }
    .op-recorrido { display: none; }
    .op-etapa { opacity: 1; }
    .op-etapa p { display: block; }
    .op-barra { display: none; }
    .op-tarjeta { opacity: 1; transform: none; }
    .op-briefing { opacity: 1; transform: none; }
    .op-anillo-val { stroke-dashoffset: 16; }
    .op-rejilla { grid-template-columns: 1fr; }
    .op-detalle { position: static; opacity: 1; transform: none; margin-top: 16px; box-shadow: 0 12px 30px rgba(15,23,42,.10); }
    .op-detalle-cuerpo { grid-template-columns: 1fr; }
    .op-tablero { opacity: 1; transform: none; }
    .op-detalle-cab { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .op-pegado { position: static; min-height: 0; }
    .op-recorrido { display: none; }
    .op-tarjeta, .op-briefing, .op-detalle { transition: none; }
  }
</style>

<script>
  const sec = document.getElementById('operador');
  if (sec) {
    const etapas = [...sec.querySelectorAll<HTMLElement>('.op-etapa')];
    const tarjetas = [...sec.querySelectorAll<HTMLElement>('.op-tarjeta')];
    const barra = sec.querySelector<HTMLElement>('.op-barra span');
    const riel = sec.querySelector<HTMLElement>('.op-riel');
    const pegado = sec.querySelector<HTMLElement>('.op-pegado');
    const menos = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = etapas.length;
    let actual = -1;

    // Reparto del riel: las cuatro primeras etapas encienden tarjetas (1,2,3 y
    // luego las seis), la quinta trae el briefing y la sexta abre el detalle.
    // Cuántas tarjetas se ven en cada etapa:
    const CUANTAS = [1, 2, 3, 6, 6, 6];

    const marcar = (k: number) => {
      if (k === actual) return;
      actual = k;
      etapas.forEach((e, i) => e.classList.toggle('on', i === k));
      tarjetas.forEach((t, i) => t.classList.toggle('on', i < (CUANTAS[k] ?? 6)));
      sec.classList.toggle('brief', k >= 4);
      sec.classList.toggle('abre', k >= 5);
      if (barra) barra.style.width = `${((k + 1) / N) * 100}%`;
    };

    const cabe = () => window.innerHeight >= 640 && window.innerWidth > 1100 && !menos;
    const revisarCabe = () => { sec.classList.toggle('sin-riel', !cabe()); return cabe(); };

    // La mitad de cada tramo se queda quieta: sin esa pausa las tarjetas se
    // encienden de corrido y no da tiempo de leer ninguna.
    const REPOSO = 0.45;
    const suave = (x: number) => x * x * (3 - 2 * x);

    let pidiendo = false;
    const alScroll = () => {
      if (pidiendo) return;
      pidiendo = true;
      requestAnimationFrame(() => {
        pidiendo = false;
        if (sec.classList.contains('sin-riel') || !riel || !pegado) return;
        const total = riel.offsetHeight - pegado.offsetHeight;
        if (total <= 0) return;
        const p = Math.min(1, Math.max(0, -riel.getBoundingClientRect().top / total));
        const tramo = p * (N - 1);
        const i = Math.min(N - 2, Math.floor(tramo));
        const t = Math.min(1, Math.max(0, tramo - i));
        const f = t <= REPOSO ? i : i + suave((t - REPOSO) / (1 - REPOSO));
        marcar(Math.round(f));
      });
    };

    revisarCabe();
    marcar(0);
    window.addEventListener('scroll', alScroll, { passive: true });
    window.addEventListener('resize', () => { revisarCabe(); alScroll(); });
    alScroll();
  }
</script>
