---
/**
 * Suenos — "Tú naciste para crear": la pieza inspiracional antes del pilar Automatiza.
 * Riel de 380vh con escena pegada: un personaje 3D (ella, luego él) camina hacia la
 * pantalla y crece con el scroll; la palabra grande cambia (crear → construir → diseñar →
 * crecer → imaginar → aportar); accesorios 3D flotan con paralaje; al final entra el
 * mensaje de por qué construimos la IA. Todo con CSS + una variable --p que pone el scroll.
 */
const PALABRAS = ['crear', 'construir', 'diseñar', 'crecer', 'imaginar', 'aportar'];
const ACC = [
  { f: 'bolsa',    x: '10%', y: '22%', w: 120, v: -420, r: -10 },
  { f: 'tacon',    x: '80%', y: '16%', w: 104, v: -560, r: 12 },
  { f: 'lentes',   x: '17%', y: '64%', w: 112, v: -340, r: 6 },
  { f: 'sombrero', x: '72%', y: '56%', w: 136, v: -480, r: -6 },
  { f: 'reloj',    x: '86%', y: '78%', w: 88,  v: -640, r: 8 },
  { f: 'tenis',    x: '6%',  y: '84%', w: 120, v: -300, r: -12 },
];
---
<section class="sn" id="suenos" aria-label="Tú naciste para crear">
  <div class="sn-pegado">
    <div class="sn-glow" aria-hidden="true"></div>

    <div class="sn-txt" aria-hidden="false">
      <span class="sn-l1">Tú naciste para</span>
      <span class="sn-l2">
        {PALABRAS.map((w, i) => <b class:list={['sn-w', { 'is-on': i === 0 }]} data-i={i}>{w}.</b>)}
      </span>
    </div>

    <div class="sn-fig" aria-hidden="true">
      <!-- el video trae el color a la izquierda y la máscara (silueta) a la derecha; el canvas los combina cuadro a cuadro -->
      <canvas class="sn-cv" width="480" height="720"></canvas>
      <video class="sn-v sn-v--ella" muted playsinline webkit-playsinline loop preload="none"></video>
      <video class="sn-v sn-v--el" muted playsinline webkit-playsinline loop preload="none"></video>
    </div>

    <div class="sn-accs" aria-hidden="true">
      {ACC.map((a) => (
        <img class="sn-acc" src={`/images/suenos/acc-${a.f}.png`} alt="" width={a.w} height={a.w} loading="lazy" decoding="async"
          style={`left:${a.x};top:${a.y};width:${a.w}px;--v:${a.v};--r:${a.r}deg;`} />
      ))}
    </div>

    <div class="sn-fin">
      <span class="sn-kicker">Lo que creemos</span>
      <h2 class="sn-h2">
        <span class="sn-ln">No construimos la IA para reemplazarte.</span>
        <span class="sn-ln">La construimos para que logres tu objetivo</span>
        <span class="sn-ln">y crezcas con <em>el sueño de tu vida</em>.</span>
      </h2>
      <span class="sn-firma">Sacs · AXO</span>
    </div>
  </div>
</section>

<style>
  .sn { --p: 0; position: relative; height: 380vh; background: #fff; color: #1D1D1F; }
  .sn-pegado { position: sticky; top: 0; height: 100vh; overflow: hidden; isolation: isolate; }
  .sn-glow { display: none; }

  /* ── texto grande ── */
  .sn-txt { position: absolute; left: 0; right: 0; top: 12vh; text-align: center; z-index: 1; padding: 0 16px; pointer-events: none; }
  .sn-l1 { display: block; font-family: var(--font-display); font-weight: 500; font-size: clamp(22px, 3.2vw, 46px); letter-spacing: -0.02em; line-height: 1; color: #8A8A86; }
  .sn-l2 { display: grid; height: 1.05em; margin-top: 0.12em; font-family: var(--font-display); font-weight: 600; font-size: clamp(54px, 13vw, 200px); letter-spacing: -0.05em; line-height: 1; color: #1D1D1F; overflow: hidden; }
  .sn-w { grid-area: 1 / 1; display: block; opacity: 0; transform: translateY(0.5em); transition: opacity 0.5s cubic-bezier(0.2,0.7,0.2,1), transform 0.6s cubic-bezier(0.2,0.7,0.2,1); will-change: transform, opacity; }
  .sn-w.is-on { opacity: 1; transform: none; }
  .sn-w.is-off { opacity: 0; transform: translateY(-0.5em); }

  /* ── personaje ── */
  .sn-fig { position: absolute; left: 50%; bottom: 0; width: min(52vh, 86vw); aspect-ratio: 2 / 3; transform: translateX(-50%) translateY(calc(12vh - var(--p) * 16vh)) scale(calc(0.56 + var(--p) * 0.62)); transform-origin: 50% 100%; z-index: 6; will-change: transform; }
  .sn-cv { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sn-v { position: absolute; width: 2px; height: 2px; opacity: 0.01; pointer-events: none; }

  /* ── accesorios con paralaje (sobrio) ── */
  .sn-accs { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
  .sn-acc { position: absolute; height: auto; transform: translateY(calc(var(--p) * var(--v) * 1px)) rotate(var(--r)); filter: drop-shadow(0 22px 28px rgba(0,0,0,0.12)); animation: sn-flota 7s ease-in-out infinite; will-change: transform; }
  .sn-acc:nth-child(2n) { animation-duration: 8.5s; animation-delay: -3s; } .sn-acc:nth-child(3n) { animation-delay: -1.5s; }
  @keyframes sn-flota { 50% { margin-top: -10px; } }

  /* ── manifiesto ── */
  .sn-fin { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); z-index: 4; text-align: center; padding: 0 24px; opacity: 0; visibility: hidden; transition: opacity 0.7s, visibility 0.7s; }
  .sn-kicker { display: block; font-family: var(--font-display); font-size: 11px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: #8A8A86; margin-bottom: 26px; }
  .sn-kicker::after { content: ''; display: block; width: 32px; height: 1px; background: #1D1D1F; margin: 18px auto 0; opacity: 0.35; }
  .sn-h2 { max-width: 880px; margin: 0 auto; font-family: var(--font-display); font-weight: 500; font-size: clamp(22px, 2.9vw, 42px); letter-spacing: -0.025em; line-height: 1.22; color: #1D1D1F; }
  .sn-ln { display: block; opacity: 0; transform: translateY(12px); transition: opacity 0.7s, transform 0.7s; }
  .sn-ln:nth-child(2) { transition-delay: 0.18s; } .sn-ln:nth-child(3) { transition-delay: 0.36s; }
  .sn-h2 em { font-style: italic; font-weight: 500; }
  .sn-firma { display: block; margin-top: 34px; font-family: var(--font-display); font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: #8A8A86; opacity: 0; transition: opacity 0.7s 0.6s; }
  .sn.is-fin .sn-fin { opacity: 1; visibility: visible; }
  .sn.is-fin .sn-ln { opacity: 1; transform: none; }
  .sn.is-fin .sn-firma { opacity: 1; }
  .sn.is-fin .sn-txt { opacity: 0; transition: opacity 0.4s; }
  .sn.is-fin .sn-fig { opacity: 0.08; filter: blur(3px); transition: opacity 0.8s, filter 0.8s; }
  .sn.is-fin .sn-accs { opacity: 0.18; transition: opacity 0.8s; }

  @media (max-width: 767px) {
    /* Teléfono: sin riel de scroll. Titular con palabra que rota sola, personaje pequeño y el manifiesto debajo. */
    .sn { height: auto; }
    .sn-pegado { position: relative; height: auto; overflow: visible; padding: 64px 0 56px; }
    .sn-txt { position: static; transform: none; }
    .sn-l2 { font-size: clamp(54px, 17vw, 76px); }
    .sn-fig { position: relative; left: auto; bottom: auto; width: 160px; margin: 14px auto 0; transform: none !important; }
    .sn-accs { display: none; }
    .sn-fin { position: static; transform: none; opacity: 1; visibility: visible; margin-top: 44px; }
    .sn-ln, .sn-firma { opacity: 1; transform: none; }
    .sn-h2 { font-size: clamp(20px, 5.6vw, 26px); text-wrap: balance; max-width: 32ch; } .sn-ln { display: inline; }
    .sn.is-fin .sn-txt, .sn.is-fin .sn-fig { opacity: 1; filter: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sn { height: auto; } .sn-pegado { position: relative; height: auto; min-height: 100vh; padding: 80px 0 60px; }
    .sn-fig { transform: translateX(-50%); position: relative; left: 50%; margin: 30px 0; } .sn-acc { animation: none; transform: rotate(var(--r)); }
    .sn-txt { position: relative; top: auto; transform: none; } .sn-fin { position: relative; top: auto; transform: none; opacity: 1; visibility: visible; margin-top: 30px; } .sn-ln, .sn-firma { opacity: 1; transform: none; }
  }
</style>

<script>
  (() => {
    const sn = document.getElementById('suenos'); if (!sn) return;
    const ws = Array.from(sn.querySelectorAll<HTMLElement>('.sn-w'));
    const vids = Array.from(sn.querySelectorAll<HTMLVideoElement>('.sn-v'));
    const movil = matchMedia('(max-width: 767px)').matches;
    const ph = (ev: string) => { try { (window as any).sacsPH?.(ev); } catch {} };
    let src = false, act = -1, fin = false, raf = 0, hitos = new Set<string>();
    // ── canvas: recorta el blanco del video para que las letras se vean detrás del personaje ──
    const cv = sn.querySelector<HTMLCanvasElement>('.sn-cv')!; const W = movil ? 320 : 480, H = movil ? 480 : 720; cv.width = W; cv.height = H;
    const ctx = cv.getContext('2d')!;
    const off = document.createElement('canvas'); off.width = W * 2; off.height = H; const octx = off.getContext('2d', { willReadFrequently: true })!;
    const out = ctx.createImageData(W, H);
    let pAct = 0, dib = 0, enVista = false;
    const dibuja = () => {
      dib = 0; if (!enVista) return;
      const v = pAct > 0.44 ? vids[1] : vids[0];
      if (v && v.readyState >= 2) {
        octx.drawImage(v, 0, 0, W * 2, H);
        const src = octx.getImageData(0, 0, W * 2, H).data; const d = out.data; const fila = W * 2 * 4;
        for (let y = 0; y < H; y++) { const b = y * fila, m = b + W * 4, o = y * W * 4; for (let x = 0; x < W; x++) { const i = b + x * 4, j = o + x * 4; d[j] = src[i]; d[j + 1] = src[i + 1]; d[j + 2] = src[i + 2]; d[j + 3] = src[m + x * 4]; } }
        ctx.putImageData(out, 0, 0);
      }
      dib = requestAnimationFrame(dibuja);
    };
    const carga = () => { if (src) return; src = true; vids.forEach((v) => { v.src = (movil ? '/tienda/video/m/' : '/tienda/video/') + (v.classList.contains('sn-v--ella') ? 'suenos-ella' : 'suenos-el') + '.mp4?v=5'; v.play().catch(() => {}); }); };
    const mide = () => {
      const r = sn.getBoundingClientRect(); const vh = innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
      sn.style.setProperty('--p', p.toFixed(4)); pAct = p;
      const i = Math.min(ws.length - 1, Math.max(0, Math.floor((p - 0.02) / 0.105)));
      if (i !== act) { ws.forEach((w, k) => { w.classList.toggle('is-on', k === i); w.classList.toggle('is-off', k < i); }); act = i; }
      const f = p > 0.74; if (f !== fin) { sn.classList.toggle('is-fin', f); fin = f; if (f && !hitos.has('fin')) { hitos.add('fin'); ph('suenos_final'); } }
      if (p > 0.5 && !hitos.has('50')) { hitos.add('50'); ph('suenos_50'); }
      raf = 0;
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(mide); };
    // Teléfono: la palabra cambia sola cada 1.4 s y el personaje alterna en cada vuelta
    let rot = 0, vuelta = 0;
    const rota = () => { rot = (rot + 1) % ws.length; if (rot === 0) vuelta++; pAct = vuelta % 2 ? 0.9 : 0.1; ws.forEach((w, k) => { w.classList.toggle('is-on', k === rot); w.classList.toggle('is-off', k < rot); }); };
    let rotT = 0;
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { enVista = true; carga(); vids.forEach((v) => v.play().catch(() => {})); if (movil) { if (!rotT) rotT = window.setInterval(rota, 1400); } else { addEventListener('scroll', onScroll, { passive: true }); mide(); } if (!dib) dib = requestAnimationFrame(dibuja); if (!hitos.has('ver')) { hitos.add('ver'); ph('suenos_ver'); } } else { enVista = false; vids.forEach((v) => v.pause()); removeEventListener('scroll', onScroll); if (rotT) { clearInterval(rotT); rotT = 0; } } });
    }, { rootMargin: '200px 0px' });
    io.observe(sn);
  })();
</script>
