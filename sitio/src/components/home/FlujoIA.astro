---
/**
 * FlujoIA — la función insignia del home: de la foto que TÚ tomas, a tus
 * variantes, a la modelo, al reel.
 *
 * Es una sección a pantalla completa que se recorre con el scroll: el panel se
 * queda fijo y las fotos pasan como una CINTA DE TARJETAS — la que estaba se va
 * hacia abajo y la siguiente entra desde arriba, atada al avance del riel.
 *
 * Antes esto era un lienzo WebGL con transición líquida. Se cambió por
 * transform de CSS: pesa una fracción, se afina sin recompilar un shader y se
 * comporta igual con el dedo que con la rueda. Si alguien quiere devolver el
 * shader, que sepa que este efecto no lo necesita.
 *
 * Reglas de esta pieza, aprendidas del sitio:
 *  · Un solo fondo por paso y un solo acento. Nada de gradientes de colores.
 *  · El riel va como caja propia, nunca como padding: un sticky solo viaja
 *    dentro del content box de quien lo contiene (trampa ya pagada en los giros).
 *  · Se apaga solo en móvil, con prefers-reduced-motion y si el panel no cabe:
 *    ahí se vuelve una lista de pasos, que funciona igual.
 */
// Los logos son los MISMOS SVG que ya usa el Hero para las integraciones. NO
// se le pide a la IA que los dibuje: siempre salen deformados, y un logo ajeno
// mal dibujado sí es un problema de marca. Uso nominativo, como en el resto
// del sitio.
const LOGOS_CANALES = `<svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.75a8.18 8.18 0 004.76 1.52V6.84a4.84 4.84 0 01-1-.15z"/></svg><svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8z"/></svg><svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;

const pasos = [
  {
    n: '01',
    titulo: 'Tu foto. La que ya tienes.',
    texto: 'La que tomaste con el celular en tu tienda, colgada en el gancho, con la luz que había. No necesitas estudio ni sesión.',
    img: '/images/flujo/01-tu-foto.webp', ajuste: 'cover',
    alt: 'Vestido colgado en un gancho fotografiado con celular dentro de una boutique',
    tono: '#1B3A82',
  },
  {
    n: '02',
    titulo: 'Tus colorways, solos.',
    texto: 'La IA genera la misma prenda en todos los colores del drop, con la misma luz y el mismo encuadre. Y escribe la descripción de cada una.',
    img: '/images/flujo/02-variantes.webp', ajuste: 'contain',
    alt: 'La misma prenda repetida en cinco colores distintos con iluminación idéntica',
    tono: '#1B4493',
  },
  {
    n: '03',
    titulo: 'Tu modelo, tuya.',
    texto: 'Eliges la modelo, la pose y el fondo — y queda igual en toda la temporada. Tu marca deja de verse improvisada.',
    img: '/images/flujo/03-modelo.webp', ajuste: 'cover',
    alt: 'Modelo con el vestido en una toma editorial de campaña',
    tono: '#1A4EA3',
  },
  {
    n: '04',
    titulo: 'Y se vuelve reel.',
    texto: 'De ahí sale el video vertical para TikTok, Reels y tu tienda en línea. El contenido de la semana, sin volver a producir nada.',
    img: '/images/flujo/04-reel.webp', ajuste: 'contain',
    alt: 'La misma modelo en movimiento, en formato vertical de video social',
    tono: '#1859AF',
  },
  {
    n: '05',
    titulo: 'Y se publica en todos lados.',
    texto: 'TikTok Shop, Instagram, Facebook, tu tienda en línea y lo que venga después. Subes una vez y sale en todos tus canales, cada uno con su formato.',
    img: '/images/flujo/05-canales.webp', ajuste: 'cover',
    alt: 'Dentro de la tienda, un cliente ve la misma prenda en su teléfono con su precio y el botón de comprar',
    tono: '#1563B7',
  },
  {
    n: '06',
    titulo: 'Y le llega a tus clientes.',
    texto: 'La misma pieza sale por WhatsApp a toda tu base y por correo a quien te compró antes — con su foto, su precio y su liga para comprar. No es un blast a ciegas: es tu catálogo, en el teléfono de tu clienta.',
    img: '/images/flujo/06-clientes.webp', ajuste: 'cover',
    alt: 'Una clienta en un café enseña en su teléfono el mensaje de WhatsApp con la foto de la prenda',
    tono: '#116DBB',
  },
  {
    n: '07',
    titulo: 'Se vende y se descuenta solo.',
    texto: 'En cuanto alguien compra —en línea o en el mostrador— la pieza sale del inventario de ESA sucursal. Tus otras tiendas lo ven al instante y nadie captura nada: un solo inventario para todos tus canales y todas tus sucursales.',
    img: '/images/flujo/07-sucursales.webp', ajuste: 'cover',
    alt: 'Manos envolviendo la prenda vendida, con la prenda en la tablet del mostrador',
    tono: '#0E78B8',
  },
];
---

<section
  class="fl"
  id="flujo"
  data-tonos={JSON.stringify(pasos.map((p) => p.tono))}
>
  <div class="fl-riel">
    <div class="fl-pegado">
      <div class="fl-escena">
        {pasos.map((p, i) => (
          <figure class="fl-carta" data-i={i} style={`--tono:${p.tono}`}>
            <img
              src={p.img}
              alt={p.alt}
              class:list={['fl-foto', p.ajuste]}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              width={p.img.includes('04-') ? 1000 : 1500}
              height={p.img.includes('04-') ? 1500 : 1000}
            />
            <span class="fl-num" aria-hidden="true">{p.n}</span>

            {p.img.includes('05-') && (
              <div class="fl-canales" aria-hidden="true">
                <span class="fl-canales-txt">Publicado en</span>
                <span class="fl-canales-logos" set:html={LOGOS_CANALES} />
                <span class="fl-canales-txt">+ tu tienda en línea</span>
              </div>
            )}

            {p.img.includes('07-') && (
              <div class="fl-matriz">
                <div class="fl-matriz-cab">
                  <strong>Vestido Slip</strong>
                  <span>existencias por sucursal</span>
                </div>
                <table class="fl-tabla">
                  <thead>
                    <tr><th scope="col"><span class="vo">Sucursal</span></th>
                      <th scope="col">Terracota</th><th scope="col">Negro</th><th scope="col">Crema</th></tr>
                  </thead>
                  <tbody>
                    <tr tabindex="0"><th scope="row">Polanco</th>
                      <td class="fl-baja"><span class="fl-antes">3</span><span class="fl-despues">2</span></td>
                      <td>2</td><td>4</td></tr>
                    <tr tabindex="0"><th scope="row">Roma Norte</th><td>2</td><td>5</td><td>1</td></tr>
                    <tr tabindex="0"><th scope="row">Guadalajara</th><td>4</td><td>1</td><td>3</td></tr>
                  </tbody>
                </table>
                <p class="fl-matriz-pie"><span class="fl-chip">−1</span> Punto de venta · Polanco</p>
              </div>
            )}
          </figure>
        ))}
      </div>

      <div class="fl-panel">
        <span class="fl-insignia">Función insignia · solo en Sacs</span>
        <h2 class="fl-titulo">De tu foto<br /><em>a tu reel.</em></h2>
        <div class="fl-pasos">
          {pasos.map((p, i) => (
            <div class:list={['fl-paso', { on: i === 0 }]} data-i={i}>
              <span class="fl-paso-n">{p.n}</span>
              <div class="fl-paso-cuerpo">
                <h3>{p.titulo}</h3>
                <figure class="fl-paso-foto">
                  <img src={p.img} alt={p.alt} loading="lazy" decoding="async"
                       width={p.img.includes('04-') ? 1000 : 1500}
                       height={p.img.includes('04-') ? 1500 : 1000} />
                </figure>
                <p>{p.texto}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="fl-barra" aria-hidden="true"><span id="fl-avance"></span></div>
      </div>
    </div>

    <div class="fl-recorrido" aria-hidden="true"></div>
  </div>
</section>

<style>
  /* El tono se registra como color para que el cambio de paso sea un fundido
     y no un salto. Donde @property no exista, cambia de golpe: se ve igual de
     bien, solo sin la transición. */
  @property --fl-fondo { syntax: '<color>'; inherits: true; initial-value: #1B3A82; }

  .fl {
    position: relative; color: #fff;
    scroll-margin-top: 80px;
    --fl-fondo: #1B3A82;
    background: var(--fl-fondo);
    transition: --fl-fondo 1.1s cubic-bezier(.4,0,.2,1);
  }
  .fl-riel { position: relative; }
  .fl-pegado {
    position: sticky; top: 0; min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-columns: 1.1fr 1fr; align-items: stretch;
  }

  /* ── La cinta de tarjetas ── */
  .fl-escena {
    position: relative; overflow: hidden;
    padding: clamp(84px, 10vh, 120px) clamp(20px, 2.4vw, 40px) clamp(28px, 4vh, 56px);
  }
  .fl-carta {
    position: absolute; margin: 0;
    inset: clamp(84px, 10vh, 120px) clamp(20px, 2.4vw, 40px) clamp(28px, 4vh, 56px);
    border-radius: 22px; overflow: hidden;
    background: color-mix(in srgb, var(--tono) 45%, #05070F);
    box-shadow: 0 30px 70px rgba(3, 8, 22, .45);
    /* el script escribe transform/zIndex; aquí solo el estado de reposo */
    will-change: transform;
    backface-visibility: hidden;
  }
  .fl-foto { width: 100%; height: 100%; display: block; }
  .fl-foto.cover { object-fit: cover; object-position: 50% 45%; }
  .fl-foto.contain { object-fit: contain; }

  .fl-num {
    position: absolute; left: clamp(16px, 2vw, 30px); bottom: clamp(12px, 1.6vw, 24px);
    font-family: var(--font-display); font-size: clamp(3.4rem, 7vw, 6rem); font-weight: 800;
    line-height: .8; letter-spacing: -.06em; color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,.28);
  }

  /* ── La tira de canales (paso 05) ── */
  .fl-canales {
    position: absolute; left: 50%; transform: translateX(-50%);
    top: clamp(14px, 2vw, 24px); z-index: 4;
    display: flex; align-items: center; gap: 12px;
    padding: 9px 16px; border-radius: 999px;
    background: rgba(8, 14, 30, .66); border: 1px solid rgba(255,255,255,.16);
    backdrop-filter: blur(10px); white-space: nowrap;
  }
  .fl-canales-logos { display: inline-flex; align-items: center; gap: 10px; }
  .fl-canales-logos :global(svg) { display: block; }
  .fl-canales-txt {
    font-size: 0.6875rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.72);
  }

  /* ── La matriz de existencias (paso 07) ── */
  .fl-matriz {
    /* Arriba a la derecha: abajo la tapa el widget flotante de WhatsApp. */
    position: absolute; right: clamp(12px, 1.6vw, 22px); top: clamp(14px, 2vw, 24px);
    z-index: 5; width: min(340px, 76%);
    padding: 14px 16px 12px; border-radius: 16px;
    background: rgba(7, 12, 26, .82); border: 1px solid rgba(255,255,255,.16);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 40px rgba(0,0,0,.4);
  }
  .fl-matriz-cab { display: flex; flex-direction: column; gap: 2px; margin-bottom: 10px; }
  .fl-matriz-cab strong { font-size: 0.875rem; font-weight: 800; }
  .fl-matriz-cab span {
    font-size: 0.625rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.55);
  }
  .fl-tabla { width: 100%; border-collapse: collapse; font-size: 0.75rem; }
  .fl-tabla th, .fl-tabla td { padding: 6px 4px; text-align: center; }
  .fl-tabla thead th {
    font-size: 0.5625rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: rgba(255,255,255,.5);
  }
  .fl-tabla tbody th {
    text-align: left; font-weight: 700; color: rgba(255,255,255,.9); white-space: nowrap;
  }
  .fl-tabla tbody td { font-variant-numeric: tabular-nums; color: rgba(255,255,255,.82); }
  .fl-tabla tbody tr { border-top: 1px solid rgba(255,255,255,.09); cursor: default; }
  .fl-tabla tbody tr:hover,
  .fl-tabla tbody tr:focus-visible { background: rgba(255,255,255,.08); outline: none; }

  /* La celda que baja: hasta que el paso entra, se ve el número de antes. */
  .fl-baja { position: relative; }
  .fl-baja .fl-antes,
  .fl-baja .fl-despues { display: inline-block; transition: opacity .3s ease, transform .3s ease; }
  .fl-baja .fl-despues { position: absolute; inset: 0; opacity: 0; transform: translateY(-6px); color: #fff; font-weight: 800; }
  .fl-matriz-pie {
    margin: 10px 0 0; display: flex; align-items: center; gap: 7px;
    font-size: 0.625rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: rgba(255,255,255,.55);
    opacity: 0; transform: translateY(4px); transition: opacity .4s ease .25s, transform .4s ease .25s;
  }
  .fl-chip {
    padding: 2px 7px; border-radius: 999px; background: rgba(255,120,120,.18);
    border: 1px solid rgba(255,140,140,.35); color: #FFB4B4; font-weight: 800;
  }
  .fl.vendido .fl-baja .fl-antes { opacity: 0; transform: translateY(6px); }
  .fl.vendido .fl-baja .fl-despues { opacity: 1; transform: none; }
  .fl.vendido .fl-matriz-pie { opacity: 1; transform: none; }

  /* ── El panel ── */
  .fl-panel {
    display: flex; flex-direction: column; justify-content: center; gap: 20px;
    padding: clamp(40px, 6vw, 88px) clamp(24px, 5vw, 80px);
  }
  .fl-insignia {
    align-self: flex-start; padding: 7px 14px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.05);
    font-size: 0.6875rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
    color: rgba(255,255,255,.72);
  }
  .fl-titulo {
    font-family: var(--font-display); font-size: clamp(2.2rem, 4.6vw, 3.6rem); font-weight: 800;
    line-height: 1; letter-spacing: -.035em; margin: 0; color: #fff;
  }
  .fl-titulo em { font-style: italic; font-weight: 400; color: rgba(255,255,255,.5); }

  .fl-pasos { display: grid; gap: 2px; margin-top: 6px; }
  .fl-paso {
    display: grid; grid-template-columns: 34px 1fr; gap: 14px; align-items: start;
    padding: 11px 0; border-top: 1px solid rgba(255,255,255,.09);
    opacity: .34; transition: opacity .4s ease;
  }
  .fl-paso.on { opacity: 1; }
  .fl-paso-n {
    font-family: var(--font-display); font-size: 0.75rem; font-weight: 800;
    color: rgba(255,255,255,.55); padding-top: 3px;
  }
  .fl-paso h3 { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700; margin: 0 0 3px; color: #fff; }
  .fl-paso p { margin: 0; font-size: 0.875rem; line-height: 1.55; color: rgba(255,255,255,.68); max-width: 44ch; }
  .fl-paso:not(.on) p { display: none; }
  .fl-paso.on p { animation: fl-entra .5s cubic-bezier(.2,.7,.3,1) both; }
  @keyframes fl-entra { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  /* La foto de cada paso solo existe sin riel: con riel manda la cinta. */
  .fl-paso-foto { display: none; margin: 0; }

  .fl-barra { height: 2px; background: rgba(255,255,255,.12); border-radius: 2px; overflow: hidden; margin-top: 10px; }
  .fl-barra span { display: block; height: 100%; width: 14%; background: #fff; transition: width .35s ease; }

  /* El recorrido es caja propia, nunca padding: si no, el sticky no viaja.
     400vh entre 7 pasos ≈ 57vh por paso. Si se agregan pasos hay que subirlo
     o la cinta los pasa de corrido. */
  .fl-recorrido { height: 400vh; }

  .vo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* ── Sin riel: móvil, poco movimiento o panel que no cabe ── */
  .fl.sin-riel .fl-pegado { position: static; min-height: 0; grid-template-columns: 1fr; }
  .fl.sin-riel .fl-recorrido { display: none; }
  .fl.sin-riel .fl-escena { display: none; }
  .fl.sin-riel .fl-insignia { display: none; }
  .fl.sin-riel .fl-barra { display: none; }
  .fl.sin-riel .fl-paso { grid-template-columns: 1fr; gap: 8px; padding: 26px 0 30px; opacity: 1; }
  .fl.sin-riel .fl-paso p { display: block; max-width: none; animation: none; }
  .fl.sin-riel .fl-paso-foto {
    display: block; margin: 12px 0 14px; border-radius: 14px; overflow: hidden;
    background: rgba(0,0,0,.25); box-shadow: 0 12px 34px rgba(0,0,0,.34);
  }
  .fl.sin-riel .fl-paso-foto img { display: block; width: 100%; height: auto; }
  .fl.sin-riel .fl-panel { gap: 14px; padding: clamp(32px, 8vw, 56px) clamp(20px, 6vw, 40px); }

  @media (max-width: 980px) {
    .fl-pegado { position: static; min-height: 0; grid-template-columns: 1fr; }
    .fl-recorrido { display: none; }
    .fl-escena { display: none; }
    .fl-insignia { display: none; }
    .fl-barra { display: none; }
    .fl-paso { grid-template-columns: 1fr; gap: 8px; padding: 26px 0 30px; opacity: 1; }
    .fl-paso p { display: block; max-width: none; animation: none; }
    .fl-paso-foto {
      display: block; margin: 12px 0 14px; border-radius: 14px; overflow: hidden;
      background: rgba(0,0,0,.25); box-shadow: 0 12px 34px rgba(0,0,0,.34);
    }
    .fl-paso-foto img { display: block; width: 100%; height: auto; }
    .fl-panel { gap: 14px; padding: clamp(32px, 8vw, 56px) clamp(20px, 6vw, 40px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fl-pegado { position: static; min-height: 0; }
    .fl-recorrido { display: none; }
    .fl-carta { transition: none !important; }
  }
</style>

<script>
  const sec = document.getElementById('flujo');
  if (sec) {
    const tonos = JSON.parse(sec.dataset.tonos || '[]');
    const cartas = [...sec.querySelectorAll<HTMLElement>('.fl-carta')];
    const pasos = [...sec.querySelectorAll<HTMLElement>('.fl-paso')];
    const avance = document.getElementById('fl-avance');
    const riel = sec.querySelector<HTMLElement>('.fl-riel');
    const pegado = sec.querySelector<HTMLElement>('.fl-pegado');
    const menos = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = cartas.length;
    let actual = -1;

    const marcar = (k: number) => {
      if (k === actual) return;
      actual = k;
      pasos.forEach((p, i) => p.classList.toggle('on', i === k));
      if (tonos[k]) sec.style.setProperty('--fl-fondo', tonos[k]);
      if (avance) avance.style.width = `${((k + 1) / N) * 100}%`;
      // el descuento de inventario solo ocurre al llegar al último paso
      sec.classList.toggle('vendido', k === N - 1);
    };

    // La cinta: la tarjeta que se va baja, la que entra llega desde arriba.
    // La saliente va un poco más lenta (88 vs 100) para que la nueva la cubra
    // al pasar — sin eso las dos se mueven parejo y no se lee como tarjetas.
    const colocar = (f: number) => {
      for (let i = 0; i < N; i++) {
        const d = f - i;
        const fuera = Math.abs(d) > 1.25;
        const c = cartas[i];
        c.style.visibility = fuera ? 'hidden' : 'visible';
        if (fuera) continue;
        const y = (d >= 0 ? d * 88 : d * 100);
        const esc = 1 - Math.min(Math.abs(d), 1) * 0.05;
        c.style.transform = `translate3d(0, ${y.toFixed(2)}%, 0) scale(${esc.toFixed(3)})`;
        c.style.zIndex = String(i + 1);
      }
    };

    const cabe = () => window.innerHeight >= 620 && window.innerWidth > 980 && !menos;
    const revisarCabe = () => { sec.classList.toggle('sin-riel', !cabe()); return cabe(); };

    let pidiendo = false;
    const alScroll = () => {
      if (pidiendo) return;
      pidiendo = true;
      requestAnimationFrame(() => {
        pidiendo = false;
        if (sec.classList.contains('sin-riel') || !riel || !pegado) return;
        const total = riel.offsetHeight - pegado.offsetHeight;
        if (total <= 0) return;
        const p = Math.min(1, Math.max(0, -riel.getBoundingClientRect().top / total));
        const f = p * (N - 1);
        colocar(f);
        marcar(Math.round(f));
      });
    };

    revisarCabe();
    colocar(0);
    marcar(0);
    window.addEventListener('scroll', alScroll, { passive: true });
    window.addEventListener('resize', () => { revisarCabe(); alScroll(); });
    alScroll();
  }
</script>
