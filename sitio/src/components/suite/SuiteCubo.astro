---
/**
 * SuiteCubo — el cubo de inventario en 3D.
 *
 * Es el momento fuerte de la pagina: la retícula talla × color × sucursal
 * flotando y girando mientras el visitante baja. Cada cubo es una casilla real
 * de la blusa satinada (los mismos numeros que la seccion "matriz" del
 * recorrido), y las casillas apagadas son las combinaciones agotadas. El
 * problema del giro se ve antes de leerse.
 *
 * Tres decisiones que importan:
 *
 * 1. Three.js se carga SOLO cuando el bloque se acerca al viewport. Son 590 KB;
 *    cargarlos en el <head> castigaria el LCP de toda la pagina por un adorno
 *    que esta a tres pantallas de distancia.
 * 2. Si no hay WebGL —o si el visitante pidio menos animacion— se muestra la
 *    version plana en HTML, que dice exactamente lo mismo. Nunca queda un hueco.
 * 3. El giro lo manda el SCROLL, no un temporizador: el objeto responde al
 *    visitante en vez de moverse solo. Se puede arrastrar con el dedo.
 */
export interface CuboProps {
  eyebrow?: string;
  titulo?: string;
  resalte?: string;
  sub?: string;
  /** Filas = valores del eje B (colores, presentaciones…), columnas = eje A. */
  matriz?: number[][];
  ejeA?: string[];
  ejeB?: string[];
  /** Cuántas capas de profundidad (sucursales). */
  capas?: number;
  leyendas?: [string, string, string];
}
const {
  eyebrow = 'Una sola prenda',
  titulo = 'Esto es lo que de verdad hay<br /> detrás de',
  resalte = '“una blusa”',
  sub = 'Seis tallas por cuatro colores, en tres sucursales. Setenta y dos casillas, cada una con su propia existencia. Las apagadas son las que ya no tienes — y las que tu clienta justo está pidiendo.',
  matriz = [
    [0, 8, 12, 9, 4, 0],
    [3, 11, 14, 7, 2, 0],
    [2, 5, 6, 3, 1, 0],
    [1, 4, 7, 5, 2, 0],
  ],
  ejeA = ['XS', 'S', 'M', 'L', 'XL', 'XXL'],
  ejeB = ['Negro', 'Blanco', 'Vino', 'Camel'],
  capas = 3,
  leyendas = ['Con existencia', 'Última pieza', 'Agotado'],
} = Astro.props as CuboProps;
---

<section class="cubo-bloque" id="cubo3d" data-matriz={JSON.stringify(matriz)} data-capas={String(capas)}>
  <div class="cubo-pin">
    <canvas id="cuboLienzo" aria-hidden="true"></canvas>
    <div class="cubo-velo" aria-hidden="true"></div>

    <!-- Respaldo: se queda si no hay WebGL. Es la misma matriz, plana. -->
    <div class="cubo-plano" id="cuboPlano">
      <table>
        <tr><th></th>{ejeA.map((t) => <th>{t}</th>)}</tr>
        {ejeB.map((c, fila) => (
          <tr>
            <td class="c">{c}</td>
            {matriz[fila].map((n: number) => (
              <td class:list={['n', n === 0 ? 'cero' : n <= 3 ? 'bajo' : 'ok']}>{n}</td>
            ))}
          </tr>
        ))}
      </table>
    </div>

    <div class="cubo-txt">
      <p class="cubo-eyebrow">{eyebrow}</p>
      <h2><Fragment set:html={titulo} /> <span>{resalte}</span>.</h2>
      <p class="cubo-sub">{sub}</p>
      <ul class="cubo-leyenda">
        <li><i class="ok"></i>{leyendas[0]}</li>
        <li><i class="bajo"></i>{leyendas[1]}</li>
        <li><i class="cero"></i>{leyendas[2]}</li>
      </ul>
    </div>

    <p class="cubo-pista" id="cuboPista">Gira con el scroll · arrástralo si quieres</p>
  </div>
</section>

<style>
  /* Dos pantallas de scroll, no tres. Con tres el visitante siente que la
     página se le atoró: el objeto ya dijo lo que tenía que decir y todavía
     falta media pantalla para salir. */
  .cubo-bloque { height: 140vh; background: #08080A; position: relative; }
  .cubo-pin {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    display: flex; align-items: center;
  }
  #cuboLienzo { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* El objeto vive a la derecha; este velo oscurece la izquierda para que el
     titulo no se lea encima de los cubos. Sin el, ambos pierden. */
  .cubo-velo {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(8,8,10,.92) 0%, rgba(8,8,10,.8) 32%, rgba(8,8,10,.25) 58%, rgba(8,8,10,0) 78%);
  }

  .cubo-txt {
    position: relative; z-index: 2; max-width: 1200px; margin: 0 auto;
    padding: 0 24px; width: 100%;
  }
  .cubo-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #60A5FA; margin: 0 0 18px;
  }
  .cubo-txt h2 {
    font-size: clamp(30px, 5vw, 60px); font-weight: 800; letter-spacing: -2px;
    line-height: 1.04; color: #fff; margin: 0 0 20px; max-width: 15ch;
  }
  .cubo-txt h2 span {
    color: #4B7BE5;
  }
  .cubo-sub {
    font-size: clamp(15px, 1.7vw, 19px); line-height: 1.6; color: #C6C6CE;
    max-width: 44ch; margin: 0 0 28px;
  }
  .cubo-leyenda {
    list-style: none; padding: 0; margin: 0; display: flex; gap: 22px; flex-wrap: wrap;
    font-size: 13px; color: #A1A1AA; font-weight: 600;
  }
  .cubo-leyenda i {
    display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 7px;
  }
  .cubo-leyenda i.ok { background: #34D399; }
  .cubo-leyenda i.bajo { background: #E8A838; }
  .cubo-leyenda i.cero { background: #2A2A33; }

  .cubo-pista {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: #55555F;
    margin: 0; z-index: 2; transition: opacity .4s ease;
  }

  /* Respaldo plano: visible por defecto, el 3D lo oculta al arrancar. Asi, si
     el script no corre, el visitante ve la matriz igual. */
  .cubo-plano {
    position: absolute; right: 6%; top: 50%; transform: translateY(-50%); z-index: 1;
    background: rgba(12,12,16,.86); border: 1px solid rgba(255,255,255,.13);
    border-radius: 18px; padding: 20px 22px;
  }
  .cubo-plano.oculto { display: none; }
  .cubo-plano table { border-collapse: separate; border-spacing: 5px; }
  .cubo-plano th {
    font-size: 11px; color: #8A8A94; font-weight: 700; padding-bottom: 2px;
  }
  .cubo-plano td.c { font-size: 12px; font-weight: 700; color: #E4E4E7; padding-right: 6px; }
  .cubo-plano td.n {
    width: 40px; height: 34px; text-align: center; border-radius: 8px;
    font-size: 13px; font-weight: 800; font-variant-numeric: tabular-nums;
  }
  .cubo-plano td.ok { background: rgba(52,211,153,.7); color: #04241A; }
  .cubo-plano td.bajo { background: rgba(232,168,56,.75); color: #2A1B04; }
  .cubo-plano td.cero { background: rgba(22,22,28,.9); color: #F0A9A9; border: 1px solid rgba(248,113,113,.4); }

  @media (max-width: 900px) {
    /* En movil el objeto va detras del texto y el bloque se acorta: tres
       pantallas de scroll en un telefono se sienten eternas. */
    .cubo-bloque { height: 120vh; }
    /* En movil no hay lugar para poner el objeto al lado: se sube arriba, el
       texto baja y el velo pasa a ser vertical. Antes el titulo se leia encima
       de los cubos claros y no se entendia ninguno de los dos. */
    .cubo-pin { align-items: flex-end; padding-bottom: 92px; }
    /* El lienzo deja libre la mitad de abajo para el texto y no se mete
       debajo del header pegajoso. */
    #cuboLienzo { top: 40px; height: min(44svh, 340px); inset-block-end: auto; }
    .cubo-velo {
      background: linear-gradient(180deg, rgba(8,8,10,.2) 0%, rgba(8,8,10,.62) 38%, rgba(8,8,10,.94) 62%, rgba(8,8,10,.98) 100%);
    }
    .cubo-plano { right: auto; left: 24px; top: auto; bottom: 30px; transform: none; padding: 14px; }
    .cubo-plano td.n { width: 30px; height: 26px; font-size: 11px; }
    .cubo-txt h2 { font-size: clamp(26px, 7vw, 40px); }
    .cubo-pista { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cubo-bloque { height: auto; }
    .cubo-pin { position: relative; height: auto; padding: 90px 0; }
    #cuboLienzo { display: none; }
    .cubo-plano { position: relative; right: auto; top: auto; transform: none; margin: 40px auto 0; width: max-content; max-width: 100%; }
    .cubo-pin { display: block; }
    .cubo-pista { display: none; }
  }
</style>

<script>
  import { cargarThree, hayWebGL } from '../../lib/three-loader';

  {
    const bloque = document.getElementById('cubo3d');
    const lienzo = document.getElementById('cuboLienzo') as HTMLCanvasElement | null;
    const plano = document.getElementById('cuboPlano');
    const menos = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (bloque && lienzo && hayWebGL() && !menos) {
      // Three.js pesa 590 KB: se pide solo cuando el bloque ya viene en camino,
      // y por el cargador compartido —el ensamble del cierre usa el mismo—
      // para que no se baje dos veces.
      new IntersectionObserver((es, obs) => {
        if (!es[0].isIntersecting) return;
        obs.disconnect();
        cargarThree().then(arrancar).catch(() => { /* se queda la matriz plana */ });
      }, { rootMargin: '900px 0px' }).observe(bloque);

      function arrancar(THREE: any) {
        plano?.classList.add('oculto');

        const esc = new THREE.Scene();
        const cam = new THREE.PerspectiveCamera(42, 1, 0.1, 140);
        cam.position.set(0, 2.2, 16);
        cam.lookAt(0, 0, 0);

        const r = new THREE.WebGLRenderer({ canvas: lienzo, antialias: true, alpha: true });
        r.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        // Sin esto los canales saturan y el verde se va al cian: el cubo deja
        // de tener el color de su propia leyenda.
        r.outputColorSpace = THREE.SRGBColorSpace;
        r.toneMapping = THREE.ACESFilmicToneMapping;
        r.toneMappingExposure = 1.15;

        esc.add(new THREE.AmbientLight(0x2b2b33, 1.9));
        const l1 = new THREE.PointLight(0xE6EDFB, 1.05, 90); l1.position.set(-10, 9, 12); esc.add(l1);
        const l2 = new THREE.PointLight(0xC9D6F2, 0.55, 90); l2.position.set(11, -4, 9); esc.add(l2);
        const l3 = new THREE.PointLight(0x9BB6EE, 0.35, 80); l3.position.set(0, 10, -8); esc.add(l3);

        // La misma matriz de la blusa satinada que vive en el recorrido. Al
        // alejarse de la sucursal principal queda menos pieza: por eso el -2.
        const stock: number[][] = JSON.parse(bloque!.dataset.matriz || '[]');
        const capas = Number(bloque!.dataset.capas || 3);
        const filas = stock.length;
        const cols = stock[0]?.length || 0;
        const grupo = new THREE.Group();
        const geo = new THREE.BoxGeometry(0.82, 0.82, 0.82);
        const vivos: any[] = [];

        for (let s = 0; s < capas; s++) {
          for (let c = 0; c < filas; c++) {
            for (let t = 0; t < cols; t++) {
              const n = Math.max(0, stock[c][t] - s * 2);
              const agotado = n === 0;
              const ultima = n > 0 && n <= 3;
              const m = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({
                color: agotado ? 0x24242c : ultima ? 0xE8A838 : 0x34D399,
                metalness: agotado ? 0.1 : 0.12,
                roughness: agotado ? 0.9 : 0.66,
                emissive: agotado ? 0x000000 : ultima ? 0x2a1c04 : 0x062415,
                emissiveIntensity: 0.15,
                transparent: agotado,
                opacity: agotado ? 0.3 : 1,
              }));
              m.position.set((t - (cols - 1) / 2) * 1.25, ((filas - 1) / 2 - c) * 1.25, ((capas - 1) / 2 - s) * 1.25);
              grupo.add(m);
              if (!agotado) vivos.push({ m, base: m.position.y, fase: (t + c + s) * 0.7 });
            }
          }
        }
        grupo.add(new THREE.LineSegments(
          new THREE.EdgesGeometry(new THREE.BoxGeometry(cols * 1.25 + 0.6, filas * 1.25 + 0.6, capas * 1.25 + 0.6)),
          new THREE.LineBasicMaterial({ color: 0x4B7BE5, transparent: true, opacity: 0.26 }),
        ));
        esc.add(grupo);

        const medir = () => {
          const a = lienzo!.clientWidth || window.innerWidth;
          const b = lienzo!.clientHeight || window.innerHeight;
          r.setSize(a, b, false);
          cam.aspect = a / b;
          const angosto = a < 900;
          // La retícula del giro puede ser de seis columnas o de once: con una
          // distancia fija, la de once se salía del encuadre y se cortaba en la
          // orilla. La cámara se aleja en proporción a lo ancha que sea.
          // La cámara es fija por tamaño de pantalla; lo que se ajusta al
          // ancho de la retícula es la escala, y nada más. Con las dos palancas
          // a la vez el objeto se encogía dos veces.
          cam.position.z = angosto ? 20 : (a < 1320 ? 19 : 16);
          cam.lookAt(0, 0, 0);
          const medioAlto = cam.position.z * Math.tan((42 / 2) * Math.PI / 180);
          const medioAncho = medioAlto * cam.aspect;

          // Al girar, lo que puede asomar es la media DIAGONAL de la retícula,
          // no su medio ancho. Ese es el radio que tiene que caber.
          const radio = Math.hypot(cols * 1.25, capas * 1.25) / 2 + 0.6;

          if (angosto) {
            grupo.position.x = 0;
            grupo.position.y = 2.4;
            // Nunca por debajo del 55% del ancho del lienzo: si no, el momento
            // fuerte de la página queda como una estampilla.
            grupo.scale.setScalar(Math.max(medioAncho * 0.55 / radio, Math.min(1, (medioAncho - 0.4) / radio)));
          } else {
            // En escritorio se recuesta contra la orilla derecha y deja libre
            // la mitad izquierda para el texto. Se le da el 46% del ancho
            // visible y se encoge lo necesario para caber ahí entero.
            const disponible = medioAncho * 0.42;
            grupo.position.x = medioAncho - disponible - 0.5;
            grupo.position.y = 0;
            grupo.scale.setScalar(Math.min(1, disponible / radio));
          }
          cam.updateProjectionMatrix();
        };
        medir();
        window.addEventListener('resize', medir);

        // Giro: lo manda el scroll dentro del bloque; el arrastre lo corrige.
        let porScroll = 0, manual = 0, incX = 0.3;
        let ultX = 0, ultY = 0, agarrado = false;
        const abajo = (x: number, y: number) => { agarrado = true; ultX = x; ultY = y; };
        const mueve = (x: number, y: number) => {
          if (!agarrado) return;
          manual += (x - ultX) * 0.008;
          incX = Math.max(-0.85, Math.min(0.85, incX + (y - ultY) * 0.006));
          ultX = x; ultY = y;
        };
        const suelta = () => { agarrado = false; };
        lienzo.addEventListener('mousedown', (e) => abajo(e.clientX, e.clientY));
        window.addEventListener('mousemove', (e) => mueve(e.clientX, e.clientY));
        window.addEventListener('mouseup', suelta);
        lienzo.addEventListener('touchstart', (e) => abajo(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
        lienzo.addEventListener('touchmove', (e) => mueve(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
        lienzo.addEventListener('touchend', suelta);

        const pista = document.getElementById('cuboPista');
        let visible = false;
        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }, { threshold: 0.02 }).observe(bloque!);

        const avance = () => {
          const rect = bloque!.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          return total <= 0 ? 0 : Math.min(1, Math.max(0, -rect.top / total));
        };

        const dibuja = (t: number) => {
          requestAnimationFrame(dibuja);
          if (!visible) return;
          const p = avance();
          porScroll = p * Math.PI * 1.7;
          if (pista) pista.style.opacity = p > 0.12 ? '0' : '1';
          grupo.rotation.y = -0.5 + porScroll + manual;
          grupo.rotation.x = incX * (1 - p * 0.5);
          vivos.forEach((v) => { v.m.position.y = v.base + Math.sin(t * 0.0011 + v.fase) * 0.07; });
          r.render(esc, cam);
        };
        requestAnimationFrame(dibuja);
      }
    }
  }
</script>
