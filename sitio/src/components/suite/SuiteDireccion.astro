---
/**
 * SuiteDireccion — el bloque para quien firma, no para quien cobra.
 *
 * Toda la pagina esta contada desde el mostrador, y el dueño de una cadena no
 * opera la caja. Sus dos preguntas son otras: "¿que pasa en mis tiendas si no
 * estoy?" y "¿por donde se me va el dinero?".
 *
 * Sobre la direccion de arte: la primera version era una tabla oscura de cinco
 * columnas con barritas — el tablero generico de cualquier landing de software.
 * Esta version toma el lenguaje que ya usa el home, las tarjetas que se
 * expanden y revelan (.xpand-card), y lo convierte en algo que ademas MIDE: la
 * sucursal es una columna cuya altura llena ES su venta. Se comparan de un
 * vistazo, sin leer un solo numero, y al pasar el cursor cada una suelta su
 * detalle.
 *
 * La que va mal no espera al hover: viene abierta desde el principio, porque es
 * justo lo que el dueño necesita ver sin buscar.
 *
 * Los candados no son tarjetas: son REGLAS, escritas como se configuran en el
 * sistema —si pasa esto, entonces esto—. Es la forma que ya tiene el producto,
 * no una decoracion.
 *
 * Va en claro y no en oscuro a proposito. Un tablero de direccion se lee mejor
 * sobre blanco —es donde vive un reporte— y ademas parte en dos la seccion
 * oscura de la pagina justo cuando cambia el interlocutor: hasta aqui hablabamos
 * con el mostrador; de aqui en adelante, con quien firma.
 */
interface Sucursal {
  nombre: string;
  venta: string;
  /** Proporcion de la venta, 0-100: es la altura que llena la columna. */
  llena: number;
  ticket: string;
  margen: string;
  delta: string;
  alerta?: boolean;
  /** Meses de inventario: en calzado es lo que quita el sueño, no la venta. */
  inventario?: string;
  nota?: string;
}

export interface DirReglas { si: string; entonces: string; detalle: string; }
interface Props {
  titulo?: string;
  resalte?: string;
  sub?: string;
  rotulo?: string;
  sucursales: Sucursal[];
  reglas: DirReglas[];
  tituloReglas?: string;
}
const {
  titulo = 'Lo que ves tú,',
  resalte = 'aunque no estés',
  sub = 'Tus tiendas abren sin ti. La pregunta no es si venden — es cuál se está cayendo, cuál se está comiendo el inventario de las otras y por dónde se te va el dinero.',
  rotulo = 'Comparativo de sucursales',
  sucursales,
  reglas,
  tituloReglas = 'Por dónde se va el dinero cuando no estás',
} = Astro.props;
---

<section class="dir">
  <div class="dir-inner">

    <header class="dir-head">
      <p class="dir-eyebrow">Para quien firma</p>
      <h2>{titulo} <span>{resalte}</span>.</h2>
      <p class="dir-sub">{sub}</p>
    </header>

    <!-- Comparativo: la altura ES la venta -->
    <div class="dir-torre-rot">
      <span>{rotulo}</span>
      <span>Este mes · al corte de ayer</span>
    </div>

    <div class="dir-torres">
      {sucursales.map((s) => (
        <article class:list={['dir-torre', { mal: s.alerta }]} tabindex="0">
          <div class="dir-nivel" style={`height:${s.llena}%`}></div>

          <div class="dir-torre-arriba">
            <b>{s.nombre}</b>
            <span class:list={['dir-delta', s.alerta ? 'baja' : 'sube']}>{s.delta}</span>
          </div>

          <div class="dir-torre-abajo">
            <span class="dir-venta">{s.venta}</span>

            <div class="dir-detalle">
              <p><i>Ticket promedio</i><b>{s.ticket}</b></p>
              <p><i>Margen</i><b>{s.margen}</b></p>
              {s.inventario && <p><i>Meses de inventario</i><b>{s.inventario}</b></p>}
              {s.nota && <p class="dir-nota">{s.nota}</p>}
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="dir-pista">Pasa el cursor por cada sucursal para ver su detalle</p>

    <!-- Candados: escritos como reglas del sistema -->
    <div class="dir-reglas">
      <h3>{tituloReglas}</h3>

      {reglas.map((r) => (
        <div class="dir-regla">
          <p class="dir-condicion">
            <span class="dir-kw">Si</span>{r.si}
            <span class="dir-flecha" aria-hidden="true">→</span>
            <span class="dir-kw dir-kw-2">entonces</span><b>{r.entonces}</b>
          </p>
          <p class="dir-regla-detalle">{r.detalle}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Tono claro, mucho aire y sombras cortas: es donde vive un reporte. */
  .dir { background: #FAFAF8; color: #1A1A1A; padding: 112px 24px 120px; }
  .dir-inner { max-width: 1200px; margin: 0 auto; }

  .dir-head { max-width: 760px; margin-bottom: 56px; }
  .dir-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #4B7BE5; margin: 0 0 18px;
  }
  .dir-head h2 {
    font-size: clamp(30px, 4.6vw, 54px); font-weight: 800; letter-spacing: -1.9px;
    line-height: 1.04; color: #1A1A1A; margin: 0 0 18px;
  }
  .dir-head h2 span { color: #4B7BE5; }
  .dir-sub { color: #4A4A4A; font-size: clamp(16px, 1.8vw, 19px); margin: 0; line-height: 1.65; }

  .dir-torre-rot {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,.09); margin-bottom: 20px;
  }
  .dir-torre-rot span:first-child { font-size: 15.5px; font-weight: 700; color: #1A1A1A; }
  .dir-torre-rot span:last-child { font-size: 13px; color: #8C8C8C; font-weight: 600; }

  /* ── Las torres ──
     Cada sucursal es una columna y su relleno es la venta. La comparacion se
     hace con el ojo, antes de leer una cifra. */
  .dir-torres { display: flex; gap: 14px; height: 450px; }
  .dir-torre {
    position: relative; flex: 1; overflow: hidden; cursor: default;
    background: #fff; border: 1px solid rgba(0,0,0,.08); border-radius: 20px;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 24px 24px 26px;
    transition: flex .5s cubic-bezier(.25,.46,.45,.94), box-shadow .3s ease, border-color .3s ease;
  }
  .dir-torre:hover, .dir-torre:focus-visible {
    flex: 1.9; outline: none;
    border-color: rgba(75,123,229,.35); box-shadow: 0 12px 34px rgba(15,23,42,.10);
  }
  /* La que va mal viene abierta: es lo que hay que ver sin buscar. */
  .dir-torre.mal { flex: 1.9; border-color: rgba(229,75,75,.35); }

  .dir-nivel {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, #D8E4FA, #EDF3FD);
    border-top: 3px solid #4B7BE5;
    transition: height .6s cubic-bezier(.25,.46,.45,.94);
  }
  .dir-torre.mal .dir-nivel {
    background: linear-gradient(180deg, #FADCDC, #FDF0F0);
    border-top-color: #E54B4B;
  }

  .dir-torre-arriba, .dir-torre-abajo { position: relative; z-index: 1; }
  .dir-torre-arriba { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .dir-torre-arriba b { font-size: 17px; font-weight: 700; color: #1A1A1A; letter-spacing: -.2px; }
  .dir-delta { font-size: 13.5px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .dir-delta.sube { color: #128B77; }
  .dir-delta.baja { color: #D13B3B; }

  .dir-venta {
    display: block; font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; color: #1A1A1A;
    letter-spacing: -1.2px; font-variant-numeric: tabular-nums;
  }

  /* El detalle vive plegado y sale al expandirse. */
  .dir-detalle {
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height .5s ease, opacity .35s ease, margin-top .5s ease;
  }
  .dir-torre:hover .dir-detalle,
  .dir-torre:focus-visible .dir-detalle,
  .dir-torre.mal .dir-detalle { max-height: 300px; opacity: 1; margin-top: 16px; }

  .dir-detalle p {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    margin: 0 0 9px; font-size: 14px;
  }
  .dir-detalle i { font-style: normal; color: #8C8C8C; }
  .dir-detalle b { color: #1A1A1A; font-weight: 700; font-variant-numeric: tabular-nums; }
  .dir-nota {
    display: block !important; margin: 14px 0 0 !important; padding-top: 14px;
    border-top: 1px solid rgba(229,75,75,.25); font-size: 13.5px; line-height: 1.55; color: #A93636;
  }

  .dir-pista { margin: 16px 0 76px; font-size: 13px; color: #A0A0A0; font-weight: 600; }

  /* ── Reglas ── */
  .dir-reglas h3 {
    font-size: clamp(21px, 2.8vw, 30px); font-weight: 700; color: #1A1A1A; margin: 0 0 30px;
    letter-spacing: -.7px;
  }
  .dir-regla { padding: 24px 0; border-top: 1px solid rgba(0,0,0,.09); }
  .dir-regla:last-child { border-bottom: 1px solid rgba(0,0,0,.09); }
  .dir-condicion {
    margin: 0 0 10px; font-size: clamp(17px, 2vw, 21px); color: #1A1A1A; line-height: 1.5;
    display: flex; align-items: baseline; gap: 11px; flex-wrap: wrap;
  }
  /* Las palabras de la regla van en monoespaciada: se lee como una condicion
     configurada, que es exactamente lo que es. */
  .dir-kw {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #A0A0A0;
  }
  .dir-kw-2 { color: #4B7BE5; }
  .dir-flecha { color: #C9C9C9; font-size: 18px; }
  .dir-condicion b { color: #1A1A1A; font-weight: 800; }
  .dir-regla-detalle { margin: 0; font-size: 15px; line-height: 1.65; color: #4A4A4A; max-width: 78ch; }

  @media (max-width: 900px) {
    .dir { padding: 76px 18px 84px; }

    /* En vertical la torre no cabe: cada sucursal pasa a ser una fila y el
       relleno se vuelve horizontal. Sigue midiendo lo mismo. */
    .dir-torres { flex-direction: column; height: auto; gap: 12px; }
    .dir-torre { flex: none !important; padding: 18px 18px 26px; }
    .dir-torre { border-left: 3px solid #4B7BE5; }
    .dir-torre.mal { border-left-color: #E54B4B; }
    .dir-nivel {
      top: auto; bottom: 0; left: 0; right: auto;
      width: var(--ancho, 100%); height: 6px !important;
      background: #4B7BE5; border-top: none; border-radius: 0 3px 3px 0;
    }
    .dir-torre.mal .dir-nivel { background: #E54B4B; }
    .dir-torre-abajo { margin-top: 12px; }
    .dir-detalle { max-height: 300px; opacity: 1; margin-top: 14px; }
    .dir-pista { display: none; }
    .dir-condicion { font-size: 17px; gap: 8px; }
  }
</style>

<script>
  {
    /* En móvil el relleno es horizontal: la altura en % que trae el marcado no
       sirve, y el ancho se calcula del mismo dato. Se hace aquí y no en el
       marcado para no duplicar el número en dos atributos. */
    const aplicar = () => {
      const angosto = window.matchMedia('(max-width: 900px)').matches;
      document.querySelectorAll<HTMLElement>('.dir-nivel').forEach((n) => {
        const pct = n.style.height || n.dataset.pct || '';
        if (!n.dataset.pct && pct) n.dataset.pct = pct;
        n.style.setProperty('--ancho', angosto ? (n.dataset.pct || '100%') : '100%');
      });
    };
    aplicar();
    window.addEventListener('resize', aplicar);
  }
</script>
