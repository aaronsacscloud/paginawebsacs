---
/**
 * SuiteCierre — el remate de la página de giro, a pantalla completa.
 *
 * Sustituye al FinalCTA generico en las paginas de suite. Motivo: quien llego
 * hasta abajo se leyo once bloques de producto y merece un final con la misma
 * fuerza de la portada, no el pie compartido con los otros quince giros.
 *
 * La promesa es concreta y verificable ("tu catalogo cargado, en 30 minutos").
 * Una promesa vaga aqui abajo desperdicia toda la lectura anterior.
 */
interface Props {
  foto: string;
  alt: string;
  titulo: string;
  sub: string;
  encuadre?: string;
}
const { foto, alt, titulo, sub, encuadre = '60% 35%' } = Astro.props;
---

<section class="cierre">
  <img src={foto} alt={alt} loading="lazy" decoding="async" style={`object-position:${encuadre}`} />
  <div class="cierre-velo"></div>
  <div class="cierre-inner">
    <h2 set:html={titulo} />
    <p>{sub}</p>
    <div class="cierre-cta">
      <a href="/contacto" class="cierre-pri">Agenda una demo</a>
      <a href="/prueba-gratis" class="cierre-sec">Prueba 7 días gratis</a>
    </div>
    <p class="cierre-pie">Sin tarjeta · Migramos tu catálogo contigo · Soporte en español</p>
  </div>
</section>

<style>
  .cierre {
    position: relative; min-height: 620px; display: flex; align-items: center;
    overflow: hidden; background: #08080A;
  }
  .cierre img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cierre-velo {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(8,8,10,.95) 0%, rgba(8,8,10,.8) 42%, rgba(8,8,10,.28) 78%, rgba(8,8,10,.1) 100%),
      linear-gradient(180deg, rgba(8,8,10,.5) 0%, rgba(8,8,10,0) 30%, rgba(8,8,10,.55) 100%);
  }
  .cierre-inner {
    position: relative; max-width: 1200px; margin: 0 auto; width: 100%; padding: 90px 24px;
  }
  .cierre-inner h2 {
    font-size: clamp(32px, 5.4vw, 62px); font-weight: 800; letter-spacing: -2.4px;
    line-height: 1.03; color: #fff; margin: 0 0 20px; max-width: 16ch;
  }
  .cierre-inner h2 :global(span) {
    color: #4B7BE5;
  }
  .cierre-inner > p {
    font-size: clamp(16px, 1.9vw, 20px); color: #C6C6CE; max-width: 48ch; margin: 0 0 34px; line-height: 1.6;
  }
  .cierre-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 26px; }
  .cierre-pri, .cierre-sec {
    display: inline-flex; align-items: center; justify-content: center; height: 56px;
    padding: 0 32px; border-radius: 12px; font-size: 16px; font-weight: 700;
    text-decoration: none; transition: transform .16s ease, background .16s ease;
  }
  .cierre-pri { background: #2563EB; color: #fff; box-shadow: 0 8px 26px rgba(37,99,235,.45); }
  .cierre-pri:hover { background: #1D4ED8; transform: translateY(-1px); text-decoration: none; }
  .cierre-sec { background: rgba(255,255,255,.1); color: #fff; border: 1.5px solid rgba(255,255,255,.26); }
  .cierre-sec:hover { background: rgba(255,255,255,.17); text-decoration: none; }
  .cierre-pie { font-size: 13px; color: #71717A; margin: 0; font-weight: 600; }

  @media (max-width: 760px) {
    .cierre { min-height: 540px; }
    .cierre-inner { padding: 64px 18px; }
    .cierre-pri, .cierre-sec { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cierre-pri, .cierre-sec { transition: none; }
  }
</style>
