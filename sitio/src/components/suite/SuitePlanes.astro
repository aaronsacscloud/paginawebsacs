---
import { plans, type PlanPrice } from '../../data/plans';
/**
 * SuitePlanes — cómo se paga la Suite del giro, y qué trae cada plan.
 *
 * Dos trabajos. El primero: dejar claro que Sacs está hecho de principio a fin
 * para el giro de la página (no un ERP generico con una etiqueta de moda
 * encima) — ese es el diferenciador, y el sitio entero ya es Fashion Commerce
 * asi que no hace falta aclarar que "la Suite no se paga aparte". El segundo:
 * que el visitante entienda de verdad que incluye cada escalon, porque de eso
 * depende que sepa cual pedir en la llamada.
 *
 * Sobre la direccion de arte: la primera version eran cuatro tarjetas de precio
 * con esquinas redondeadas, pastilla de "Mas popular" y borde azul en la
 * destacada. Es el bloque de pricing de cualquier SaaS y encima obligaba a
 * resumir cada plan en tres viñetas, que era justo lo contrario de dar
 * claridad.
 *
 * Esta version es una ESCALERA en filas: cada plan ocupa el ancho completo, con
 * su numero de escalon, su precio y el detalle real de lo que suma agrupado por
 * area. Los planes son acumulativos y el texto lo dice en cada peldaño ("todo
 * lo de Controla, mas"). Sin tarjetas, sin sombras, sin gradientes: reglas
 * finas y tipografia, que es lo que usa una tabla de precios impresa.
 *
 * Contenido y precios salen de src/data/plans.ts. Si cambian alli, cambian
 * aqui: se copian a proposito porque esta pagina cuenta los planes con el
 * lenguaje del giro y no la comparativa completa.
 */
interface Props {
  suite?: string;
  /** 'incluida' = viene dentro del plan desde Fideliza. 'complemento' = se
      cotiza aparte, como la Suite Joyería. Decirlo mal es prometer de más. */
  comoSeVende?: 'incluida' | 'complemento';
  /** El artículo que le toca al nombre del complemento: 'la' o 'las'. */
  articulo?: string;
  /** Nota extra bajo el sub cuando la suite viene incluida PERO la página
      vendió además un complemento puntual (p.ej. Suite de Consignación):
      sin ella, este bloque promete de más por omisión. */
  notaComplemento?: string;
  /** Por qué se cotiza aparte, en las palabras del giro. */
  porQue?: string;
  /** El giro en plural y como habla la gente del ramo en México
      ("zapaterías", "joyerías", "boutiques multimarca", "casas de novias"…).
      Nombra al giro de la página en el encabezado y el párrafo de esta
      sección: es lo que demuestra que Sacs está hecho para ESE giro y no es
      un sistema genérico. Sin ella, el texto cae a "tu giro" — nunca un
      hueco ni un "undefined". */
  giroPlural?: string;
  /** La moneda de los precios: la llave de PlanPrice en data/plans.ts
      (mxn, cop, clp, usd…). Las páginas por país (giros/novias-y-fiesta/<pais>)
      la mandan; sin ella, los precios en pesos mexicanos de siempre. */
  moneda?: keyof PlanPrice;
}
const {
  suite = 'Suite de Moda',
  comoSeVende = 'incluida',
  articulo = 'la',
  porQue = 'no es un módulo estándar sino una forma completa de costear',
  notaComplemento,
  giroPlural = 'tu giro',
  moneda = 'mxn',
  /** Frase de Fideliza. */
  paraFideliza = 'Para que tu cliente regrese',
} = Astro.props;

// El precio en la moneda pedida, con el mismo símbolo que /planes. Los
// planes de esta lista van en el mismo orden que `plans` (Vende, Controla,
// Fideliza y Multiplica, Automatiza): se leen por posición.
const ETIQUETA: Record<string, string> = { mxn: 'MXN', usd: 'USD', eur: 'EUR', gbp: 'GBP', brl: 'BRL', cop: 'COP', ars: 'ARS', clp: 'CLP', pen: 'PEN' };
const formatoMoneda = (v: number) => {
  const simbolo = moneda === 'eur' ? '€' : moneda === 'gbp' ? '£' : moneda === 'pen' ? 'S/' : moneda === 'brl' ? 'R$' : '$';
  return `${simbolo}${v.toLocaleString('es-MX')}${moneda === 'mxn' ? '' : ` ${ETIQUETA[moneda] || String(moneda).toUpperCase()}`}`;
};
const precioEn = (i: number, cual: 'monthly' | 'annual' | 'annualTotal') => {
  const v = plans[i]?.[cual]?.[moneda];
  if (v == null) return '';
  return formatoMoneda(v);
};
// 22-sep-2026: el dueño pidió quitar toda referencia mensual del precio anual
// con descuento. El "sin descuento" se calcula (mensual × 12) — nunca a mano —
// para que cuadre si cambian los precios o la moneda, y NUNCA se llama "antes":
// nunca se cobró ese precio, es la lista sin el trato anual.
const sinDescuentoEn = (i: number) => {
  const v = plans[i]?.monthly?.[moneda];
  if (v == null) return '';
  return formatoMoneda(v * 12);
};

const planes = [
  {
    n: '01',
    nombre: 'Vende',
    para: 'Para tu primera tienda',
    precio: precioEn(0, 'monthly') || '$810',
    anual: precioEn(0, 'annual') || '$527',
    anualTotal: precioEn(0, 'annualTotal') || '$6,318',
    sinDescuento: sinDescuentoEn(0) || '$9,720',
    hereda: '',
    areas: [
      { a: 'Venta en tienda', i: 'Punto de venta con y sin internet · Cortes de caja y arqueos · Cambios, devoluciones y cancelaciones · Apartados y pedidos · Cotizaciones · Ventas a crédito · Listas de precios' },
      { a: 'Venta en línea', i: 'Tienda en línea con el mismo inventario · Facebook, Instagram y WhatsApp · TikTok Shop · Productos visibles en ChatGPT' },
      { a: 'Productos', i: 'Productos con variantes · Kits y compuestos · Etiquetas con código de barras' },
      { a: 'Facturación', i: '20 folios incluidos' },
    ],
    servicio: '1 sucursal · Soporte 9 a 5 por chat y WhatsApp · Tickets en 30–90 min',
    suite: false,
  },
  {
    n: '02',
    nombre: 'Controla',
    para: 'Para varias sucursales con orden',
    precio: precioEn(1, 'monthly') || '$1,215',
    anual: precioEn(1, 'annual') || '$790',
    anualTotal: precioEn(1, 'annualTotal') || '$9,477',
    sinDescuento: sinDescuentoEn(1) || '$14,580',
    hereda: 'Vende',
    areas: [
      { a: 'Inventario multisucursal', i: 'Existencias en tiempo real · Gestión de CEDIS · Traspasos entre tiendas · Reabasto sugerido · Alertas de stock bajo o exceso' },
      { a: 'Conteos y trazabilidad', i: 'Conteo físico desde el celular · Conteos cíclicos programados · Kardex y trazabilidad · Control de mermas' },
      { a: 'Compras y gastos', i: 'Órdenes de compra y cuentas por pagar · Recepción contra orden · Control de gastos · Complementos de pago y notas de crédito' },
      { a: 'Clientes y equipo', i: 'Directorio con historial de compras · Metas y comisiones por vendedor · Permisos por usuario y sucursal' },
      { a: 'Reportes y auditoría', i: '50+ reportes y 20+ KPIs · ABC, sell-through y rotación · Costeo y utilidad por producto · Auditoría de movimientos' },
    ],
    servicio: 'Multisucursal · Reunión de introducción · Migración gratis (3 días)',
    suite: false,
  },
  {
    n: '03',
    nombre: 'Fideliza y Multiplica',
    para: paraFideliza,
    precio: precioEn(2, 'monthly') || '$1,890',
    anual: precioEn(2, 'annual') || '$1,229',
    anualTotal: precioEn(2, 'annualTotal') || '$14,742',
    sinDescuento: sinDescuentoEn(2) || '$22,680',
    hereda: 'Controla',
    areas: [
      { a: 'Clientes y CRM', i: 'Perfil 360° con historial omnicanal · Segmentación por comportamiento de compra · Notas y seguimientos' },
      { a: 'Programa de lealtad', i: 'Monedero electrónico y puntos · Niveles y recompensas · Redención en tienda y en línea' },
      { a: 'Portal y tarjetas de regalo', i: 'Portal de clientes con tu marca · Portal de autofacturación · Tarjetas de regalo físicas y digitales' },
      { a: 'Marketing', i: 'Campañas de correo segmentadas (1,000 contactos) · Notificaciones y campañas por WhatsApp (200 activos)' },
      { a: 'Membresías', i: 'Planes recurrentes · Cobro automático y renovación · Beneficios por nivel' },
    ],
    servicio: 'Reunión mensual · Tickets en 15–30 min · Migración gratis (1 día)',
    suite: true,
    popular: true,
  },
  {
    n: '04',
    nombre: 'Automatiza',
    para: 'Para que la operación corra sola',
    precio: precioEn(3, 'monthly') || '$3,780',
    anual: precioEn(3, 'annual') || '$2,457',
    anualTotal: precioEn(3, 'annualTotal') || '$29,484',
    sinDescuento: sinDescuentoEn(3) || '$45,360',
    hereda: 'Fideliza',
    areas: [
      { a: 'Especialista de IA', i: 'Una persona real que diseña tus automatizaciones contigo · Sesión mensual de optimización · Onboarding completo' },
      { a: 'AXO · copiloto', i: 'Le preguntas lo que sea de tu negocio y actúa · Detecta problemas antes de que pasen · Aprende de tu operación' },
      { a: 'Workflows y alertas', i: 'Reglas de disparo → acción · Stock bajo genera la orden de compra sola · Avisos de anomalías y productos estancados' },
      { a: 'Agentes y predicción', i: 'Orquesta Claude, GPT y Gemini · Agentes para reabasto, precios y campañas · Predicción de demanda' },
      { a: 'Integraciones', i: 'Conecta con +600 apps: ERP, contabilidad, logística · API abierta' },
      { a: 'Créditos de IA', i: '1,000 créditos incluidos cada mes · Lo que se consuma de más se cobra aparte, y lo ves antes de gastarlo' },
    ],
    servicio: 'Soporte 24/7 · Tickets en menos de 2 min · Migración gratis · Acceso anticipado a nuevas funciones',
    suite: true,
  },
];
---

<section class="pl">
  <div class="pl-inner">

    <header class="pl-head">
      <p class="pl-eyebrow">Y lo que cuesta</p>
      <!-- h3 a propósito: los bloques de trámite no compiten por el mismo
           nivel que los que nombran el problema del giro. -->
      <h3 class="pl-h">{comoSeVende === 'incluida'
        ? `Sacs: software especializado para ${giroPlural}, de principio a fin.`
        : `Sacs, de principio a fin para ${giroPlural} — y dónde entra${articulo === 'las' ? 'n' : ''} ${articulo} ${suite}.`}</h3>
      {comoSeVende === 'incluida' ? (
        <Fragment>
          <p class="pl-sub">
            No es un sistema genérico con una etiqueta de moda encima: el catálogo con variantes
            de talla y color, el punto de venta, el inventario multisucursal y los reportes de
            rotación están pensados para cómo se compra y se vende en {giroPlural}. Los planes son
            acumulativos —cada uno trae todo el anterior— y a partir del tercero, Fideliza y
            Multiplica, <b>ya tienes completa</b> la parte pensada para {giroPlural}, sin plan
            aparte que pedir. Lo que corre con IA —agentes, predicción de demanda y
            planificador— vive en el cuarto, y se dice en cada punto donde aparece.
          </p>
          {notaComplemento && <p class="pl-sub pl-sub-nota"><b>La excepción:</b> {notaComplemento}</p>}
        </Fragment>
      ) : (
        <p class="pl-sub">
          Los planes son acumulativos: cada uno trae todo el anterior, y ya vienen pensados para
          {' '}{giroPlural} de punta a punta, del punto de venta al reporte. {articulo === 'las' ? 'Las' : 'La'} <b>{suite}</b> {articulo === 'las' ? 'son' : 'es'}
          distint{articulo === 'las' ? 'as' : 'a'} — se cotiza{articulo === 'las' ? 'n' : ''} como complemento sobre los dos planes que
          {articulo === 'las' ? ' las' : ' la'} soportan, porque {porQue}. Te {articulo === 'las' ? 'las' : 'la'} cotizamos con tu catálogo en la mesa, no después.
        </p>
      )}
    </header>

    <ol class="pl-escalera">
      {planes.map((p) => (
        <li class:list={['pl-peldano', { con: p.suite }]}>
          {p.suite && <span class="pl-cinta" aria-hidden="true"></span>}

          <div class="pl-id">
            <span class="pl-n">{p.n}</span>
            <h3>{p.nombre}</h3>
            <p class="pl-para">{p.para}</p>

            {/* 22-sep-2026: el dueño pidió quitar toda referencia mensual de
                donde se muestra el precio anual con descuento. En grande va
                el TOTAL DEL AÑO ya con el 35% aplicado — el mismo número que
                el estado "Anual" de /planes — con el total sin descuento
                tachado arriba. Nunca "antes": ese precio nunca se cobró, es
                la lista sin el trato anual, y "sin descuento" dice lo mismo
                sin mentir. Ambos se calculan en el frontmatter desde
                plans.ts, nunca a mano. */}
            <p class="pl-precio">
              <span class="pl-precio-tachado">{p.sinDescuento} sin descuento</span>
              <b>{p.anualTotal}</b><span>al año por sucursal</span>
            </p>

            {p.popular && comoSeVende === 'incluida' && <p class="pl-popular">El primero que trae la suite completa</p>}
            {p.suite && <p class="pl-suite">{comoSeVende === 'incluida' ? `${suite} incluida` : `Base para ${articulo} ${suite}`}</p>}
          </div>

          <div class="pl-que">
            {p.hereda
              ? <p class="pl-hereda">Todo lo de <b>{p.hereda}</b>, y además:</p>
              : <p class="pl-hereda">Con lo que se abre una tienda y se vende desde el primer día:</p>}

            <dl class="pl-areas">
              {p.areas.map((x) => (
                <div>
                  <dt>{x.a}</dt>
                  <dd>{x.i}</dd>
                </div>
              ))}
            </dl>

            <p class="pl-servicio">{p.servicio}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="pl-pie">
      <p><b>Usuarios ilimitados</b> en todos los planes · <b>Sin contrato forzoso</b> · La migración la hacemos nosotros</p>
      <a class="pl-link" href="/planes">Ver el comparativo completo →</a>
    </div>

  </div>
</section>

<style>
  .pl { background: var(--color-bg-dark, #1A1A1A); padding: 100px 24px 110px; }
  .pl-inner { max-width: 1180px; margin: 0 auto; }

  .pl-head { max-width: 720px; margin-bottom: 12px; }
  .pl-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: var(--color-primary-claro, #7FA3F0); margin: 0 0 16px;
  }
  .pl-head .pl-h {
    font-size: clamp(28px, 4.2vw, 48px); font-weight: 800; letter-spacing: -1.7px;
    line-height: 1.06; color: #fff; margin: 0 0 16px;
  }
  .pl-sub { margin: 0 0 44px; font-size: clamp(15px, 1.7vw, 18px); line-height: 1.65; color: var(--claro-apunte); }
  .pl-sub b { color: var(--claro-texto); font-weight: 700; }
  .pl-sub-nota { margin-top: -28px; }

  /* ── La escalera ──
     Filas, no tarjetas: cada plan ocupa el ancho y cabe el detalle real. La
     separacion es una regla fina, como en una tabla impresa. */
  .pl-escalera { list-style: none; margin: 0; padding: 0; border-top: 1px solid #26262E; }
  .pl-peldano {
    position: relative;
    display: grid; grid-template-columns: 300px 1fr; gap: 56px;
    padding: 38px 0 40px; border-bottom: 1px solid #1C1C24;
  }
  /* Los dos escalones con suite quedan cosidos por una cinta continua: se ve
     que la suite empieza en uno y sigue hacia abajo, no que son dos casos
     sueltos. */
  .pl-peldano.con { padding-left: 26px; }
  .pl-cinta {
    position: absolute; left: 0; top: -1px; bottom: -1px; width: 3px; background: #4B7BE5;
  }
  .pl-peldano.con:first-of-type .pl-cinta { border-radius: 2px 2px 0 0; }

  .pl-n {
    display: block; font-size: 12px; font-weight: 800; letter-spacing: .16em; color: var(--claro-apunte);
    margin-bottom: 12px; font-variant-numeric: tabular-nums;
  }
  .pl-id h3 {
    font-size: clamp(21px, 2.4vw, 27px); font-weight: 700; color: #fff; margin: 0 0 6px;
    letter-spacing: -.5px; line-height: 1.15;
  }
  .pl-para { margin: 0 0 22px; font-size: 14px; color: var(--claro-apunte); }

  .pl-precio { margin: 0 0 4px; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .pl-precio b {
    font-size: clamp(34px, 3.6vw, 44px); font-weight: 800; color: #fff; letter-spacing: -1.8px;
    font-variant-numeric: tabular-nums; line-height: 1;
  }
  .pl-precio span { font-size: 12.5px; color: var(--claro-apunte); font-weight: 600; }
  .pl-precio-tachado {
    flex-basis: 100%; font-size: 13px; color: var(--claro-apunte); font-weight: 600;
    text-decoration: line-through; text-decoration-thickness: 1.5px;
  }

  .pl-popular {
    margin: 18px 0 0; font-size: 12px; font-weight: 700; color: var(--claro-apunte);
    border-left: 2px solid #3A3A46; padding-left: 11px;
  }
  .pl-suite {
    margin: 18px 0 0; font-size: 13px; font-weight: 800; color: var(--color-primary-claro, #7FA3F0);
    letter-spacing: .02em; border-left: 2px solid #4B7BE5; padding-left: 11px;
  }

  /* ── Lo que suma ── */
  .pl-hereda { margin: 0 0 20px; font-size: 14.5px; color: var(--claro-apunte); }
  .pl-hereda b { color: var(--claro-texto); font-weight: 700; }

  .pl-areas { margin: 0; display: grid; gap: 14px; }
  .pl-areas > div {
    display: grid; grid-template-columns: 200px 1fr; gap: 24px; align-items: baseline;
  }
  .pl-areas dt {
    font-size: 13px; font-weight: 700; color: var(--claro-texto); letter-spacing: -.1px;
  }
  /* Un respiro a la derecha: sin el, la linea larga termina pegada al borde
     del bloque y se lee apretada. */
  .pl-areas dd { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--claro-apunte); padding-right: 12px; }

  .pl-servicio {
    margin: 22px 0 0; padding-top: 16px; border-top: 1px dashed #24242C;
    font-size: 13px; color: var(--claro-apunte); font-weight: 600;
  }

  .pl-pie {
    margin-top: 34px; display: flex; justify-content: space-between; align-items: baseline;
    gap: 24px; flex-wrap: wrap;
  }
  .pl-pie p { margin: 0; font-size: 14.5px; color: var(--claro-apunte); }
  .pl-pie b { color: var(--claro-texto); font-weight: 700; }
  .pl-link {
    font-size: 15px; font-weight: 700; color: #fff; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 -2px 0 rgba(255,255,255,.3); padding-bottom: 2px;
  }
  .pl-link:hover { color: var(--color-primary-claro, #7FA3F0); box-shadow: inset 0 -2px 0 #4B7BE5; text-decoration: none; }

  @media (max-width: 1000px) {
    .pl-peldano { grid-template-columns: 1fr; gap: 26px; }
    .pl-areas > div { grid-template-columns: 1fr; gap: 5px; }
    .pl-areas dt { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-primary-claro, #7FA3F0); }
  }
  @media (max-width: 620px) {
    .pl { padding: 70px 18px 78px; }
    .pl-peldano { padding: 30px 0 32px; }
    .pl-peldano.con { padding-left: 18px; }
    .pl-areas dd { font-size: 14px; }
    .pl-pie { flex-direction: column; gap: 16px; }
    .pl-link { white-space: normal; }
  }
</style>
