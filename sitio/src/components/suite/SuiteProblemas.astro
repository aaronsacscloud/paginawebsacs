---
/**
 * SuiteProblemas — "ya lo intentaste de las dos formas".
 *
 * Desactiva la objecion que el visitante trae ANTES de que le enseñemos nada:
 * "yo ya tengo sistema" o "a mi me lo hicieron a la medida".
 *
 * Sobre la direccion de arte: la primera version eran tarjetas oscuras con
 * acento azul, viñetas y una tabla comparativa de tres columnas — la plantilla
 * exacta de cualquier pagina de software, indistinguible de cien mas. Esta
 * version se construye con el material del giro: papeleria. Los dos caminos son
 * DOCUMENTOS —una hoja de inventario impresa y una cotizacion de desarrollo—
 * con sus sellos, sus anotaciones al margen y su tinta corrida. Es un inserto
 * de papel dentro de una pagina oscura, y por eso corta el ritmo sin parecerse
 * a nada mas del sitio.
 *
 * Nada de gradientes, sombras difusas ni esquinas redondeadas: el papel no hace
 * eso. Serif para el titular, monoespaciada para los datos, y el color solo
 * donde habria tinta de sello.
 *
 * Regla de tono: no se habla mal de nadie. El generico funciona —para
 * abarrotes—, y quien pago un desarrollo hizo lo que pudo con lo que habia.
 */
interface Fila {
  que: string;
  generico: string;
  medida: string;
  sacs: string;
}
export interface DocLinea { a: string; b: string; c?: string; tachado?: boolean; tenue?: boolean; }
interface Props {
  filas?: Fila[];
  titulo?: string;
  entrada?: string;
  /** Documento 1: el reporte del sistema genérico. */
  doc1?: { membrete: string; sub: string; cab: string[]; lineas: DocLinea[]; margen: string[]; sello: string; notas: string[] };
  /** Documento 2: la cotización del desarrollo a la medida. */
  doc2?: { membrete: string; sub: string; cab: string[]; lineas: DocLinea[]; margen: string[]; sello: string; notas: string[] };
}

const {
  filas = [
    { que: 'Matriz de tallas × colores', generico: 'No existe', medida: 'Si la pagaste', sacs: 'Incluida' },
    { que: 'Curva de compra por sucursal', generico: 'No existe', medida: 'Casi nunca', sacs: 'Incluida' },
    { que: 'Consignación a departamentales', generico: 'No existe', medida: 'A veces', sacs: 'Incluida' },
    { que: 'Un inventario para piso, línea y WhatsApp', generico: 'A medias', medida: 'Rara vez', sacs: 'Uno solo' },
    { que: 'Agentes de IA que tú programas', generico: 'No existe', medida: 'No existe', sacs: 'Incluidos' },
    { que: 'Tiempo para arrancar', generico: 'Días', medida: '4 a 9 meses', sacs: 'Días' },
    { que: 'Quién lo mantiene', generico: 'Su proveedor', medida: 'Tú, si lo encuentras', sacs: 'Nosotros, a diario' },
  ],
  titulo = 'Ya lo intentaste<br />de las dos formas.',
  entrada = 'Casi toda marca de ropa que llega con nosotros trae uno de estos dos documentos en el cajón. Ninguno de los dos fue una tontería. Los dos fallan — por motivos distintos.',
  doc1 = {
    membrete: 'Sistema genérico', sub: 'Reporte de inventario',
    cab: ['CÓDIGO', 'DESCRIPCIÓN', 'EXIST.'],
    lineas: [
      { a: 'SKU-0041', b: 'BLUSA SATINADA', c: '18' },
      { a: '—', b: '—', c: '—', tenue: true },
      { a: '—', b: '—', c: '—', tenue: true },
    ],
    margen: ['¿y las tallas?', '¿el negro M?'],
    sello: 'NO APLICA<br />A MODA',
    notas: [
      'Te pide <b>un solo código</b>. Tus 24 combinaciones se vuelven esa fila.',
      'Para saber si queda la M abres un <b>Excel aparte</b> que alguien mantiene a mano.',
      'Te dice cuánto vendiste, <b>no qué talla dejaste de tener</b>.',
      'Abres la segunda tienda y empiezas de cero.',
    ],
  },
  doc2 = {
    membrete: 'Desarrollo a la medida', sub: 'Propuesta · rev. 4',
    cab: ['CONCEPTO', 'PLAZO'],
    lineas: [
      { a: 'ENTREGA COMPROMETIDA', b: '3 MESES' },
      { a: 'ENTREGA REAL', b: '9 MESES', tachado: true },
      { a: 'SOPORTE VIGENTE', b: 'NO' },
    ],
    margen: ['+ 3 adendas', 'no contesta'],
    sello: 'SIN<br />SOPORTE',
    notas: [
      'Costó <b>más de lo cotizado</b> y llegó meses tarde.',
      'Funciona… mientras <b>quien lo hizo conteste el teléfono</b>.',
      'Cada cambio chico es <b>una cotización nueva</b>.',
      'No trae app, ni tienda en línea, ni quién lo actualice. El día que falla, <b>para la tienda</b>.',
    ],
  },
} = Astro.props;

/* Los dos documentos comparten forma; se recorren en vez de escribirse dos
   veces, que es lo que obligaba a tocar el marcado para cada giro. */
const documentos = [doc1, doc2];
---

<section class="pp">
  <div class="pp-inner">

    <header class="pp-head">
      <p class="pp-kicker">Expediente</p>
      <h2 set:html={titulo} />
      <p class="pp-entrada">{entrada}</p>
    </header>

    <div class="pp-hojas">
      {documentos.map((d, k) => (
        <article class="pp-hoja">
          <div class="pp-membrete">
            <span>{d.membrete}</span>
            <span>{d.sub}</span>
          </div>

          <div class:list={['pp-cuerpo', { 'pp-cuerpo-ancho': k === 1 }]}>
            <p class="pp-linea-doc">{d.cab.map((c, i) => <i class={i === d.cab.length - 1 ? 'der' : ''}>{c}</i>)}</p>
            {d.lineas.map((l) => (
              <p class:list={['pp-linea-doc', { 'pp-dato': !l.tenue, 'pp-vacio': l.tenue, 'pp-tachado': l.tachado }]}>
                <i>{l.a}</i><i>{l.b}</i>{l.c !== undefined && <i class="der">{l.c}</i>}
              </p>
            ))}

            <p class:list={['pp-margen', { 'pp-margen-2': k === 1 }]}>
              {d.margen.map((m, i) => <Fragment>{i > 0 && <br />}{m}</Fragment>)}
            </p>

            <div class:list={['pp-sello', k === 1 ? 'pp-sello-ocre' : 'pp-sello-rojo']}>
              <span set:html={d.sello} />
            </div>
          </div>

          <ol class="pp-notas">
            {d.notas.map((n) => <li set:html={n} />)}
          </ol>
        </article>
      ))}
    </div>

    <!-- Cuadro comparativo, impreso -->
    <div class="pp-cuadro">
      <p class="pp-cuadro-rot">Lo que tu giro necesita · los tres caminos</p>

      <div class="pp-cab">
        <span class="pp-cab-que">Necesidad</span>
        <span>Genérico</span>
        <span>A la medida</span>
        <span class="pp-cab-sacs">SACS</span>
      </div>

      {filas.map((f) => (
        <div class="pp-reng">
          <span class="pp-que">{f.que}</span>
          <span class="pp-val" data-col="Genérico">{f.generico}</span>
          <span class="pp-val" data-col="A la medida">{f.medida}</span>
          <span class="pp-val pp-val-sacs" data-col="SACS">{f.sacs}</span>
        </div>
      ))}

      <p class="pp-pie">
        No es que seamos más listos. Es que <b>esa pieza ya está construida</b> para tu giro y se
        mantiene todos los días — y no la pagas tú sola: la pagan las más de 3,000 marcas que ya
        la usan.
      </p>
    </div>

  </div>
</section>

<style>
  /* Papel dentro de una página oscura: el bloque entero es un inserto. */
  .pp {
    background: #E8E2D6;
    color: #1A1815;
    padding: 96px 24px 104px;
    /* Grano: dos capas de rayas casi invisibles. Sin esto el crema se ve como
       un fondo plano de plantilla. */
    background-image:
      repeating-linear-gradient(0deg, rgba(26,24,21,.035) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(26,24,21,.02) 0 1px, transparent 1px 4px);
  }
  .pp-inner { max-width: 1180px; margin: 0 auto; }

  /* ── Encabezado editorial ── */
  .pp-head {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: end;
    padding-bottom: 30px; margin-bottom: 46px;
    border-bottom: 2px solid #1A1815;
  }
  .pp-kicker {
    grid-column: 1 / -1; margin: 0 0 16px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11.5px; letter-spacing: .28em; text-transform: uppercase; color: #8A8071;
  }
  .pp-head h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 5.4vw, 62px); font-weight: 400; line-height: 1.02;
    letter-spacing: -.02em;
  }
  .pp-entrada { margin: 0; font-size: 16px; line-height: 1.65; color: #4A443B; max-width: 46ch; }

  /* ── Los dos documentos ── */
  .pp-hojas { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 76px; }

  .pp-membrete {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #6B6459;
    border-bottom: 1px solid #1A1815; padding-bottom: 9px;
  }
  .pp-membrete span:first-child { color: #1A1815; font-weight: 700; }

  /* La hoja: blanco de impresión sobre el crema. */
  .pp-cuerpo {
    position: relative; background: #FBF9F4; border: 1px solid #CFC7B8; border-top: none;
    /* La franja de abajo se reserva para el sello y la anotacion: son tinta
       encima del documento y no deben caer sobre los renglones. */
    padding: 22px 22px 104px; overflow: hidden;
    box-shadow: 3px 3px 0 rgba(26,24,21,.07);
    /* Las dos hojas miden lo mismo aunque una traiga un renglon menos: si no,
       las notas de cada columna arrancan a distinta altura y el bloque se ve
       desalineado. */
    min-height: 232px;
  }
  .pp-linea-doc {
    display: flex; gap: 14px; margin: 0 0 9px; padding-bottom: 8px;
    border-bottom: 1px dotted #D6CEC0;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px; letter-spacing: .04em; color: #8A8071;
  }
  .pp-linea-doc i { font-style: normal; flex: 1; }
  .pp-linea-doc i:first-child { flex: 0 0 96px; }
  /* El segundo documento tiene conceptos largos: su primera columna es ancha
     para que el plazo no se parta en dos renglones. */
  .pp-cuerpo-ancho .pp-linea-doc i:first-child { flex: 1 1 auto; }
  .pp-cuerpo-ancho .pp-linea-doc i.der { flex: 0 0 86px; }
  .pp-linea-doc i.der { flex: 0 0 62px; text-align: right; }
  .pp-dato { color: #1A1815; font-size: 12.5px; font-weight: 600; }
  .pp-vacio { color: #C9C0B0; }
  .pp-tachado i { text-decoration: line-through; text-decoration-color: #B23A2E; }

  /* Anotación al margen, a mano sobre el documento. */
  .pp-margen {
    position: absolute; right: 18px; top: 78px; margin: 0;
    font-family: "Bradley Hand", "Segoe Script", "Comic Sans MS", cursive;
    font-size: 16px; line-height: 1.45; color: #2E5FA8; transform: rotate(-6deg);
    text-align: right;
  }
  /* En la cotizacion la anotacion baja: arriba chocaba con el renglon tachado
     y las dos tintas se leian encimadas. */
  .pp-margen-2 { top: auto; bottom: 24px; right: 18px; color: #B23A2E; transform: rotate(-4deg); }

  /* Sello de tinta: borde grueso, rotado, tinta un poco comida. */
  .pp-sello {
    position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%) rotate(-9deg);
    border: 3px solid currentColor; padding: 7px 16px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 15px; font-weight: 700; letter-spacing: .1em; line-height: 1.15;
    text-align: center; opacity: .72;
  }
  .pp-sello-rojo { color: #B23A2E; }
  .pp-sello-ocre { color: #A6702A; }

  .pp-notas { list-style: none; margin: 22px 0 0; padding: 0; counter-reset: n; }
  .pp-notas li {
    counter-increment: n; position: relative; padding-left: 30px; margin-bottom: 14px;
    font-size: 15px; line-height: 1.6; color: #4A443B;
  }
  .pp-notas li::before {
    content: counter(n, decimal-leading-zero);
    position: absolute; left: 0; top: 2px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px; color: #A39781; letter-spacing: .06em;
  }
  .pp-notas b { color: #1A1815; font-weight: 700; }

  /* ── Cuadro comparativo impreso ── */
  .pp-cuadro { border-top: 2px solid #1A1815; padding-top: 30px; }
  .pp-cuadro-rot {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11.5px; letter-spacing: .22em; text-transform: uppercase; color: #8A8071;
    margin: 0 0 22px;
  }

  .pp-cab, .pp-reng {
    display: grid; grid-template-columns: 2.1fr 1fr 1fr 1.15fr; gap: 18px; align-items: center;
  }
  .pp-cab {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #8A8071;
    padding-bottom: 12px; border-bottom: 1px solid #1A1815;
  }
  .pp-cab span:not(.pp-cab-que) { text-align: center; }
  .pp-cab-sacs { color: #1A1815; font-weight: 700; }

  .pp-reng { padding: 14px 0; border-bottom: 1px solid #D6CEC0; }
  .pp-que { font-size: 15px; color: #1A1815; }
  .pp-val {
    text-align: center; font-size: 13.5px; color: #7C7466;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  /* La columna nuestra se marca como se marcaría en papel: en negro y subrayada
     con tinta, sin fondos de color. */
  .pp-val-sacs {
    color: #1A1815; font-weight: 700; font-family: inherit; font-size: 15px;
    box-shadow: inset 0 -7px 0 rgba(47,107,79,.22);
  }

  .pp-pie {
    margin: 26px 0 0; font-size: 15.5px; line-height: 1.65; color: #4A443B; max-width: 74ch;
  }
  .pp-pie b { color: #1A1815; font-weight: 700; }

  @media (max-width: 900px) {
    .pp { padding: 66px 18px 74px; }
    .pp-head { grid-template-columns: 1fr; gap: 20px; align-items: start; }
    .pp-hojas { grid-template-columns: 1fr; gap: 44px; margin-bottom: 56px; }
    .pp-margen { font-size: 14px; top: 74px; right: 12px; }
    /* La regla de arriba tambien alcanzaba a la segunda anotacion y la subia
       encima del renglon tachado: aqui recupera su sitio en la franja de tinta. */
    .pp-margen-2 { top: auto; bottom: 20px; right: 12px; }

    /* El cuadro deja de ser rejilla: cada necesidad es un renglón con sus tres
       lecturas debajo. Cuatro columnas en un teléfono se leen de lado. */
    .pp-cab { display: none; }
    .pp-reng { display: block; padding: 16px 0; }
    .pp-que { display: block; font-weight: 700; margin-bottom: 10px; font-size: 15.5px; }
    .pp-val {
      display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
      text-align: right; padding: 5px 0; font-size: 13px;
    }
    .pp-val::before {
      content: attr(data-col);
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: #A39781;
    }
    .pp-val-sacs { font-size: 14.5px; box-shadow: inset 0 -8px 0 rgba(47,107,79,.22); }
  }
</style>
