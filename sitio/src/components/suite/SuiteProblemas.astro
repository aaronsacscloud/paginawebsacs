---
/**
 * SuiteProblemas — "ya lo intentaste de las dos formas".
 *
 * Desactiva la objecion que el visitante trae ANTES de que le enseñemos nada:
 * "yo ya tengo sistema" o "a mi me lo hicieron a la medida".
 *
 * Sobre la direccion de arte: hubo dos versiones antes de esta. La primera
 * eran tarjetas oscuras con acento azul y una tabla de tres columnas — la
 * plantilla de cualquier pagina de software. La segunda se disfrazo de
 * expediente de papel: crema con grano, serif, monoespaciada, manuscrita y
 * sellos de goma. Resolvia el problema de la primera y creaba otro: era el
 * unico bloque del sitio con su propia tipografia y su propia paleta, y se
 * leia como pegado de otra pagina.
 *
 * Esta version usa los componentes y los tokens del sitio —los mismos de la
 * portada y de producto/[slug]— y deja que el argumento haga el trabajo: dos
 * documentos reales, uno al lado del otro, con lo que cada uno NO dice. El
 * sello de goma pasa a ser una etiqueta de estado, que es como el sistema
 * marca las cosas en todas partes.
 *
 * Regla de tono: no se habla mal de nadie. El generico funciona —para
 * abarrotes—, y quien pago un desarrollo hizo lo que pudo con lo que habia.
 */
interface Fila {
  que: string;
  generico: string;
  medida: string;
  sacs: string;
}
export interface DocLinea { a: string; b: string; c?: string; tachado?: boolean; tenue?: boolean; }
interface Props {
  filas?: Fila[];
  titulo?: string;
  entrada?: string;
  /** Documento 1: el reporte del sistema genérico. */
  doc1?: { membrete: string; sub: string; cab: string[]; lineas: DocLinea[]; margen: string[]; sello: string; notas: string[] };
  /** Documento 2: la cotización del desarrollo a la medida. */
  doc2?: { membrete: string; sub: string; cab: string[]; lineas: DocLinea[]; margen: string[]; sello: string; notas: string[] };
}

const {
  filas = [
    { que: 'Matriz de tallas × colores', generico: 'No existe', medida: 'Si la pagaste', sacs: 'Incluida' },
    { que: 'Curva de compra por sucursal', generico: 'No existe', medida: 'Casi nunca', sacs: 'Incluida' },
    { que: 'Consignación a departamentales', generico: 'No existe', medida: 'A veces', sacs: 'Incluida' },
    { que: 'Un inventario para piso, línea y WhatsApp', generico: 'A medias', medida: 'Rara vez', sacs: 'Uno solo' },
    { que: 'Agentes de IA que tú programas', generico: 'No existe', medida: 'No existe', sacs: 'Incluidos' },
    { que: 'Tiempo para arrancar', generico: 'Días', medida: '4 a 9 meses', sacs: 'Días' },
    { que: 'Quién lo mantiene', generico: 'Su proveedor', medida: 'Tú, si lo encuentras', sacs: 'Nosotros, a diario' },
  ],
  titulo = 'Ya lo intentaste<br />de las dos formas.',
  entrada = 'Casi toda marca de ropa que llega con nosotros trae uno de estos dos documentos en el cajón. Ninguno de los dos fue una tontería. Los dos fallan — por motivos distintos.',
  doc1 = {
    membrete: 'Sistema genérico', sub: 'Reporte de inventario',
    cab: ['CÓDIGO', 'DESCRIPCIÓN', 'EXIST.'],
    lineas: [
      { a: 'SKU-0041', b: 'BLUSA SATINADA', c: '18' },
      { a: '—', b: '—', c: '—', tenue: true },
      { a: '—', b: '—', c: '—', tenue: true },
    ],
    margen: ['¿y las tallas?', '¿el negro M?'],
    sello: 'NO APLICA<br />A MODA',
    notas: [
      'Te pide <b>un solo código</b>. Tus 24 combinaciones se vuelven esa fila.',
      'Para saber si queda la M abres un <b>Excel aparte</b> que alguien mantiene a mano.',
      'Te dice cuánto vendiste, <b>no qué talla dejaste de tener</b>.',
      'Abres la segunda tienda y empiezas de cero.',
    ],
  },
  doc2 = {
    membrete: 'Desarrollo a la medida', sub: 'Propuesta · rev. 4',
    cab: ['CONCEPTO', 'PLAZO'],
    lineas: [
      { a: 'ENTREGA COMPROMETIDA', b: '3 MESES' },
      { a: 'ENTREGA REAL', b: '9 MESES', tachado: true },
      { a: 'SOPORTE VIGENTE', b: 'NO' },
    ],
    margen: ['+ 3 adendas', 'no contesta'],
    sello: 'SIN<br />SOPORTE',
    notas: [
      'Costó <b>más de lo cotizado</b> y llegó meses tarde.',
      'Funciona… mientras <b>quien lo hizo conteste el teléfono</b>.',
      'Cada cambio chico es <b>una cotización nueva</b>.',
      'No trae app, ni tienda en línea, ni quién lo actualice. El día que falla, <b>para la tienda</b>.',
    ],
  },
} = Astro.props;

/* Los dos documentos comparten forma; se recorren en vez de escribirse dos
   veces, que es lo que obligaba a tocar el marcado para cada giro. */
const documentos = [doc1, doc2];
---

<section class="pp">
  <div class="pp-inner">

    <header class="pp-head">
      <p class="pp-kicker">Los dos caminos de siempre</p>
      <h2 set:html={titulo} />
      <p class="pp-entrada">{entrada}</p>
    </header>

    <div class="pp-hojas">
      {documentos.map((d, k) => (
        <article class="pp-hoja">
          <div class="pp-membrete">
            <div>
              <b>{d.membrete}</b>
              <span>{d.sub}</span>
            </div>
            <span class:list={['pp-estado', k === 1 ? 'pp-estado-ambar' : 'pp-estado-rojo']}>
              <Fragment set:html={d.sello.replace(/<br\s*\/?>/g, ' ')} />
            </span>
          </div>

          <div class="pp-cuerpo">
            <div class="pp-tabla">
              <div class="pp-fila pp-fila-cab">
                {d.cab.map((c, i) => <span class={i === d.cab.length - 1 ? 'der' : ''}>{c}</span>)}
              </div>
              {d.lineas.map((l) => (
                <div class:list={['pp-fila', { 'pp-vacio': l.tenue, 'pp-tachado': l.tachado }]}>
                  <span>{l.a}</span><span>{l.b}</span>{l.c !== undefined && <span class="der">{l.c}</span>}
                </div>
              ))}
            </div>

            <p class="pp-pregunta">
              {d.margen.map((m, i) => <Fragment>{i > 0 && ' · '}{m}</Fragment>)}
            </p>
          </div>

          <ul class="pp-notas">
            {d.notas.map((n) => (
              <li>
                <span class="pp-notas-icono" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </span>
                <span set:html={n} />
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="pp-cuadro">
      <p class="pp-cuadro-rot">Lo que tu giro necesita · los tres caminos</p>

      <div class="pp-cab">
        <span class="pp-cab-que">Necesidad</span>
        <span>Genérico</span>
        <span>A la medida</span>
        <span class="pp-cab-sacs">SACS</span>
      </div>

      {filas.map((f) => (
        <div class="pp-reng">
          <span class="pp-que">{f.que}</span>
          <span class="pp-val" data-col="Genérico">{f.generico}</span>
          <span class="pp-val" data-col="A la medida">{f.medida}</span>
          <span class="pp-val pp-val-sacs" data-col="SACS">{f.sacs}</span>
        </div>
      ))}

      <p class="pp-pie">
        No es que seamos más listos. Es que <b>esa pieza ya está construida</b> para tu giro y se
        mantiene todos los días — y no la pagas tú sola: la pagan las más de 3,000 marcas que ya
        la usan.
      </p>
    </div>

  </div>
</section>

<style>
  /* Los tokens del sitio, nada propio: la línea es la de la portada y la de
     las páginas de producto. */
  .pp { background: #fff; padding: clamp(20px, 3vw, 32px) clamp(16px, 2vw, 32px); }
  .pp-inner {
    max-width: 1280px; margin: 0 auto; background: #f2f2f2; border-radius: 24px;
    padding: clamp(48px, 6vw, 76px) clamp(24px, 4vw, 56px);
  }

  .pp-head { max-width: 680px; margin-bottom: clamp(40px, 5vw, 56px); }
  .pp-kicker {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: var(--color-primary, #4B7BE5); margin: 0 0 16px;
  }
  .pp-head h2 {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; letter-spacing: -.03em;
    line-height: 1.1; margin: 0 0 16px; color: var(--color-text-primary, #1a1a2e);
  }
  .pp-entrada {
    margin: 0; font-size: 0.9375rem; line-height: 1.65;
    color: var(--color-text-secondary, #4A4A4A);
  }

  /* ── Los dos documentos ── */
  .pp-hojas { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 56px; }
  .pp-hoja {
    background: #fff; border-radius: 16px; padding: 24px 26px 26px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 12px 32px rgba(15,23,42,.07);
    display: flex; flex-direction: column;
  }
  .pp-membrete {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 14px;
    padding-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,.07); margin-bottom: 18px;
  }
  .pp-membrete div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pp-membrete b {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 1.0625rem; font-weight: 700; letter-spacing: -.02em;
    color: var(--color-text-primary, #1a1a2e);
  }
  .pp-membrete span { font-size: 12.5px; color: var(--color-text-tertiary, #8C8C8C); font-weight: 600; }

  /* El sello de goma pasa a ser una etiqueta de estado, que es como el sistema
     marca las cosas en el resto del sitio. */
  .pp-estado {
    flex-shrink: 0; font-size: 10.5px; font-weight: 800; letter-spacing: .04em;
    border-radius: 999px; padding: 5px 12px; white-space: nowrap; text-transform: uppercase;
  }
  .pp-estado-rojo { background: var(--alerta-fondo); color: var(--alerta-texto); border: 1px solid var(--alerta-borde); }
  .pp-estado-ambar { background: var(--aviso-fondo); color: var(--aviso-texto); border: 1px solid var(--aviso-borde); }

  .pp-cuerpo { margin-bottom: 20px; }
  .pp-tabla { border: 1px solid rgba(0,0,0,.07); border-radius: 8px; overflow: hidden; }
  .pp-fila {
    display: grid; grid-template-columns: 1fr 1.5fr auto; gap: 12px;
    padding: 10px 14px; font-size: 13px; align-items: baseline;
    color: var(--color-text-primary, #1a1a2e); font-variant-numeric: tabular-nums;
  }
  .pp-fila + .pp-fila { border-top: 1px solid rgba(0,0,0,.05); }
  .pp-fila .der { text-align: right; font-weight: 700; }
  .pp-fila-cab {
    background: #F8FAFC; font-size: 10.5px; font-weight: 800; letter-spacing: .08em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C);
  }
  .pp-vacio { color: #D4D4D4; }
  .pp-tachado { color: var(--alerta-texto); }
  .pp-tachado span:last-child { text-decoration: line-through; }

  /* Lo que el documento NO contesta. Antes iba manuscrito al margen; ahora es
     una pregunta al pie, que es la misma idea sin el disfraz. */
  .pp-pregunta {
    margin: 14px 0 0; font-size: 13px; font-weight: 700; font-style: italic;
    color: var(--color-primary, #4B7BE5);
  }

  .pp-notas { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; margin-top: auto; }
  .pp-notas li {
    display: flex; align-items: flex-start; gap: 11px;
    font-size: 0.875rem; line-height: 1.55; color: var(--color-text-secondary, #4A4A4A);
  }
  .pp-notas li :global(b) { color: var(--color-text-primary, #1a1a2e); font-weight: 700; }
  .pp-notas-icono {
    flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%;
    background: rgba(229,75,75,.1); color: var(--alerta-texto);
    display: inline-flex; align-items: center; justify-content: center; margin-top: 1px;
  }

  /* ── El cuadro de los tres caminos ── */
  .pp-cuadro { padding-top: 40px; border-top: 1px solid rgba(0,0,0,.09); }
  .pp-cuadro-rot {
    margin: 0 0 20px; font-size: 12px; font-weight: 800; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C);
  }
  .pp-cab, .pp-reng {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 16px; align-items: center;
  }
  .pp-cab {
    padding-bottom: 12px; border-bottom: 1px solid rgba(0,0,0,.1);
    font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .pp-cab span { text-align: center; }
  .pp-cab-que { text-align: left !important; }
  .pp-cab-sacs { color: var(--color-primary, #4B7BE5) !important; }
  .pp-reng { padding: 14px 0; border-bottom: 1px solid rgba(0,0,0,.06); }
  .pp-que { font-size: 0.9375rem; font-weight: 600; color: var(--color-text-primary, #1a1a2e); }
  .pp-val { text-align: center; font-size: 0.875rem; color: var(--color-text-secondary, #4A4A4A); }
  .pp-val-sacs { font-weight: 800; color: var(--color-primary, #4B7BE5); }

  .pp-pie {
    margin: 28px 0 0; font-size: 0.9375rem; line-height: 1.7;
    color: var(--color-text-secondary, #4A4A4A); max-width: 76ch;
  }
  .pp-pie b { color: var(--color-text-primary, #1a1a2e); }

  @media (max-width: 900px) {
    .pp-inner { padding: 44px 20px 48px; border-radius: var(--radius-lg); }
    .pp-hojas { grid-template-columns: 1fr; gap: 18px; }
    .pp-cab { display: none; }
    .pp-reng { grid-template-columns: 1fr; gap: 6px; padding: 16px 0; }
    /* En vertical cada valor dice de qué columna es: sin encabezado, tres
       valores sueltos no significan nada. */
    .pp-val { text-align: left; display: flex; justify-content: space-between; gap: 14px; }
    .pp-val::before {
      content: attr(data-col); font-size: 11.5px; font-weight: 700;
      color: var(--color-text-tertiary, #8C8C8C);
    }
  }
</style>
