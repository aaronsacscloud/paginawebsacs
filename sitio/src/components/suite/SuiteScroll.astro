---
/**
 * SuiteScroll — recorrido de funcionalidades con panel PEGAJOSO.
 *
 * El patron: la columna izquierda se queda fija mientras la derecha se
 * desplaza; al entrar cada seccion, el panel cambia. Es el formato que usa
 * Square para explicar producto: una sola pagina, sin pestañas que tocar, y el
 * usuario entiende el alcance mientras baja.
 *
 * Por que IntersectionObserver y no calcular scroll a mano: el calculo por
 * offsets se rompe con imagenes que cargan tarde, barras que aparecen y zoom
 * del navegador. El observer no.
 *
 * Accesibilidad: si el visitante pidio menos animacion
 * (prefers-reduced-motion), no se anima nada — solo cambia el contenido.
 */
export interface SuiteSeccion {
  id: string;
  tag: string;
  titulo: string;
  texto: string;
  bullets?: string[];
  /** Mock de UI en HTML (se pinta dentro del panel). */
  visual: string;
  /** Testimonial que acompaña a ESTA funcionalidad (opcional). */
  testimonio?: { cita: string; autor: string };
}

interface Props {
  eyebrow: string;
  titulo: string;
  intro?: string;
  secciones: SuiteSeccion[];
}
const { eyebrow, titulo, intro, secciones } = Astro.props;
---

<!-- Sub-nav de la suite: misma jerarquia que las paginas de producto
     (pestañas arriba), pero las pestañas son las funcionalidades del giro.
     Se marca sola conforme el visitante baja. -->
<nav class="suite-nav" aria-label="Funcionalidades">
  <div class="suite-nav-inner">
    <span class="suite-nav-label">{eyebrow}</span>
    <div class="suite-nav-tabs">
      {secciones.map((s, i) => (
        <a href={`#${s.id}`} class:list={['suite-tab', { on: i === 0 }]} data-tab={s.id}>{s.tag}</a>
      ))}
    </div>
  </div>
</nav>

<section class="suite" id="suite">
  <div class="suite-head">
    <p class="suite-eyebrow">{eyebrow}</p>
    <h2 class="suite-title">{titulo}</h2>
    {intro && <p class="suite-intro">{intro}</p>}
  </div>

  <div class="suite-grid">
    <!-- Panel pegajoso -->
    <div class="suite-sticky">
      <div class="suite-escenario">
      <div class="suite-panel">
        <div class="suite-panel-bar">
          <span></span><span></span><span></span>
          <em class="suite-panel-url">app.sacscloud.com</em>
        </div>
        <div class="suite-panel-body">
          {secciones.map((s, i) => (
            <div class:list={['suite-visual', { on: i === 0 }]} data-visual={s.id} set:html={s.visual} />
          ))}
        </div>
      </div>
      </div>
      <ol class="suite-dots" aria-hidden="true">
        {secciones.map((s, i) => (
          <li class:list={['suite-dot', { on: i === 0 }]} data-dot={s.id}></li>
        ))}
      </ol>
    </div>

    <!-- Pasos -->
    <div class="suite-steps">
      {secciones.map((s, i) => (
        <article class="suite-step" data-step={s.id} id={s.id}>
          <span class="suite-num">{String(i + 1).padStart(2, '0')}</span>
          <p class="suite-tag">{s.tag}</p>
          <h3 class="suite-step-title">{s.titulo}</h3>
          <p class="suite-text">{s.texto}</p>
          {s.bullets && (
            <ul class="suite-bullets">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.testimonio && (
            <figure class="suite-quote">
              <blockquote>{s.testimonio.cita}</blockquote>
              <figcaption>{s.testimonio.autor}</figcaption>
            </figure>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .suite-nav {
    position: sticky; top: 71px; z-index: 90; background: #fff;
    transition: opacity .25s ease, transform .25s ease;
    border-top: 1px solid rgba(0,0,0,.06); border-bottom: 1px solid rgba(0,0,0,.06);
    box-shadow: 0 1px 4px rgba(0,0,0,.03);
  }
  /* Fuera del recorrido la barra estorba: tapaba el titulo del cierre. */
  .suite-nav.fuera { opacity: 0; transform: translateY(-100%); pointer-events: none; }
  .suite-nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 60px;
    display: flex; align-items: center; gap: 22px;
  }
  .suite-nav-label {
    font-size: 14.5px; font-weight: 800; color: #0F172A; flex-shrink: 0;
  }
  .suite-nav-tabs {
    display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none;
    /* El fundido del filo derecho avisa que hay más pestañas. Sin él, la
       última se corta a media palabra y se lee como un defecto. */
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 34px), transparent 100%);
    mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 34px), transparent 100%);
    scroll-padding-inline: 24px;
  }
  .suite-nav-tabs::-webkit-scrollbar { display: none; }
  .suite-tab {
    flex-shrink: 0; padding: 8px 13px; border-radius: 8px; font-size: 13.5px;
    font-weight: 600; color: #64748B; text-decoration: none; white-space: nowrap;
    transition: all .15s ease;
  }
  .suite-tab:hover { background: #F8FAFC; color: #0F172A; }
  .suite-tab.on { background: #EFF6FF; color: #2563EB; font-weight: 700; }

  .suite {
    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 24px 40px;
  }
  .suite-head { max-width: 720px; margin-bottom: 56px; }
  .suite-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #2563EB; margin: 0 0 12px;
  }
  .suite-title {
    font-size: clamp(30px, 4.6vw, 52px); font-weight: 800; letter-spacing: -1.4px;
    line-height: 1.06; margin: 0 0 16px; color: #0F172A;
  }
  .suite-intro { font-size: 18px; line-height: 1.6; color: #64748B; margin: 0; max-width: 62ch; }

  .suite-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }

  /* ── panel pegajoso ── */
  .suite-sticky { position: sticky; top: 148px; }
  /* Escenario: la pantalla estaba suelta sobre blanco y se veia liviana, como
     un recorte. Ahora se apoya en un plano con su propio halo, que le da peso y
     la separa del fondo de la pagina. */
  .suite-escenario {
    position: relative; padding: 30px 26px 34px; border-radius: 26px;
    background:
      radial-gradient(120% 100% at 50% 0%, rgba(75,123,229,.13) 0%, rgba(75,123,229,0) 58%),
      linear-gradient(160deg, #F3F5FA 0%, #E9EDF6 100%);
    border: 1px solid rgba(15,23,42,.06);
  }
  /* Reflejo bajo la pantalla: la asienta sobre el plano en vez de dejarla
     flotando. */
  .suite-escenario::after {
    content: ""; position: absolute; left: 12%; right: 12%; bottom: 16px; height: 22px;
    background: radial-gradient(60% 100% at 50% 0%, rgba(15,23,42,.16) 0%, rgba(15,23,42,0) 72%);
    filter: blur(3px); pointer-events: none;
  }
  .suite-panel {
    position: relative; z-index: 1;
    background: #fff; border: 1px solid #E5E7EB; border-radius: 16px; overflow: hidden;
    box-shadow: 0 26px 60px rgba(15, 23, 42, .18), 0 3px 10px rgba(15,23,42,.06);
  }
  .suite-panel-bar {
    height: 34px; background: #F8FAFC; border-bottom: 1px solid #EEF1F5;
    display: flex; align-items: center; gap: 6px; padding: 0 12px;
  }
  .suite-panel-bar span { width: 9px; height: 9px; border-radius: 50%; background: #E2E8F0; }
  .suite-panel-url {
    margin-left: 10px; font-style: normal; font-size: 10.5px; font-weight: 600; color: #94A3B8;
  }
  /* Alto suficiente para el mock mas grande. Con menos, el ultimo renglon del
     look y el total quedaban recortados por el overflow del panel. */
  .suite-panel-body { position: relative; min-height: 430px; }
  .suite-visual {
    position: absolute; inset: 0; padding: 18px;
    opacity: 0; transform: translateY(10px); pointer-events: none;
    transition: opacity .38s ease, transform .38s ease;
  }
  .suite-visual.on { opacity: 1; transform: none; pointer-events: auto; }

  .suite-dots { display: flex; gap: 7px; justify-content: center; margin: 18px 0 0; padding: 0; list-style: none; }
  .suite-dot { width: 6px; height: 6px; border-radius: 50%; background: #E2E8F0; transition: all .3s ease; }
  .suite-dot.on { background: #2563EB; width: 20px; border-radius: 3px; }

  /* ── pasos ── */
  .suite-step {
    scroll-margin-top: 148px;
    /* Bajó de 78vh: con diez secciones eran nueve mil píxeles de recorrido. */
    min-height: 62vh; display: flex; flex-direction: column; justify-content: center;
    padding: 24px 0; opacity: .38; transition: opacity .4s ease;
  }
  .suite-step.on { opacity: 1; }
  .suite-num {
    font-size: 12px; font-weight: 800; color: #CBD5E1; letter-spacing: .08em; margin-bottom: 10px;
  }
  .suite-tag {
    font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #2563EB; margin: 0 0 8px;
  }
  .suite-step-title {
    font-size: clamp(23px, 2.7vw, 32px); font-weight: 800; letter-spacing: -.7px;
    line-height: 1.15; margin: 0 0 14px; color: #0F172A;
  }
  .suite-text { font-size: 16.5px; line-height: 1.65; color: #475569; margin: 0 0 16px; max-width: 52ch; }
  .suite-bullets { margin: 0; padding: 0; list-style: none; display: grid; gap: 9px; }
  .suite-bullets li {
    position: relative; padding-left: 22px; font-size: 14.5px; color: #334155; line-height: 1.5;
  }
  .suite-quote {
    margin: 26px 0 0; border-left: 3px solid #2563EB; background: #F8FAFC;
    border-radius: 0 14px 14px 0; padding: 18px 22px;
  }
  .suite-quote blockquote {
    margin: 0 0 10px; font-size: 15.5px; line-height: 1.6; color: #0F172A; font-weight: 500;
  }
  .suite-quote figcaption { font-size: 12.5px; color: #94A3B8; font-weight: 600; }

  .suite-bullets li::before {
    content: ''; position: absolute; left: 0; top: 8px; width: 7px; height: 7px;
    border-radius: 50%; background: #2563EB;
  }

  @media (max-width: 900px) {
    .suite { padding: 64px 18px 24px; }
    .suite-grid { grid-template-columns: 1fr; gap: 0; }
    .suite-sticky { position: sticky; top: 120px; z-index: 2; margin-bottom: 22px; }
    /* En movil el panel es lo primero que se ve de cada paso: si corta el mock,
       el paso pierde justo la parte que lo explica. */
    .suite-panel-body { min-height: 420px; }
    .suite-escenario { padding: 16px 14px 20px; border-radius: 20px; }
    .suite-step { min-height: auto; padding: 30px 0; opacity: 1; }
    .suite-dots { margin-top: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .suite-visual { transition: none; }
    .suite-step { transition: none; opacity: 1; }
  }
</style>

<!-- Animaciones de los mocks del panel.
     Va en un <style is:global> a proposito: los mocks entran por set:html y no
     reciben el atributo de ambito de Astro, asi que un <style> normal no los
     alcanzaria. Todo cuelga de .suite-visual.on, de modo que la animacion se
     dispara cada vez que la seccion se vuelve la activa. -->
<style is:global>
  /* ── Perchero que corre de lado (Colecciones) ── */
  .mk-rack { position: relative; overflow: hidden; height: 250px; }
  .mk-tubo { position: absolute; top: 26px; left: -20px; right: -20px; height: 3px;
    background: linear-gradient(90deg, #C9CDD6, #8A8F9C, #C9CDD6); border-radius: 2px; }
  .mk-prendas { display: flex; gap: 18px; padding-top: 8px; transform: translateX(0); }
  .suite-visual.on .mk-prendas { animation: mkRack 22s linear infinite; }
  @keyframes mkRack { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .mk-prenda { width: 104px; flex-shrink: 0; text-align: center; }
  .mk-gancho { width: 22px; height: 22px; border: 2.5px solid #A8AEBB; border-bottom: none;
    border-radius: 50% 50% 0 0; margin: 0 auto -2px; }
  .mk-tela { height: 128px; border-radius: 5px 5px 14px 14px; box-shadow: inset 0 -24px 30px rgba(0,0,0,.22); }
  .mk-ficha { margin-top: 9px; font-size: 10px; color: #94A3B8; font-weight: 600; }
  .mk-ficha b { display: block; font-size: 11.5px; color: #0F172A; margin-bottom: 2px; }

  /* ── Cursor fantasma sobre el buscador (Matriz) ── */
  .mk-cursor { position: absolute; width: 17px; height: 17px; z-index: 4; opacity: 0;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,.35)); pointer-events: none; }
  .suite-visual.on .mk-cursor { animation: mkRuta 8s cubic-bezier(.4,0,.2,1) infinite; }
  @keyframes mkRuta {
    0%   { opacity: 0; left: 62%; top: 84%; }
    6%   { opacity: 1; }
    20%  { left: 16%; top: 12%; }
    40%  { left: 16%; top: 12%; }
    54%  { left: 26%; top: 25%; }
    68%  { left: 44%; top: 25%; }
    88%  { left: 52%; top: 62%; opacity: 1; }
    100% { left: 52%; top: 62%; opacity: 0; }
  }
  .mk-chip { transition: background .3s ease, border-color .3s ease, color .3s ease; }
  .suite-visual.on .mk-chip-1 { animation: mkPrende .1s 2.9s forwards; }
  .suite-visual.on .mk-chip-2 { animation: mkPrende .1s 3.3s forwards; }
  .suite-visual.on .mk-chip-3 { animation: mkPrende .1s 3.7s forwards; }
  @keyframes mkPrende { to { background: #EFF6FF; border-color: #93B4F5; color: #1D4ED8; } }

  /* ── Traspaso trazándose en el mapa (Multisucursal) ── */
  .mk-mapa { position: relative; height: 234px; }
  .mk-mapa svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .mk-linea { stroke: #2563EB; stroke-width: 2; fill: none; stroke-dasharray: 340; stroke-dashoffset: 340; }
  .suite-visual.on .mk-linea { animation: mkTrazo 1.6s ease forwards .4s; }
  @keyframes mkTrazo { to { stroke-dashoffset: 0; } }
  .mk-pin { position: absolute; transform: translate(-50%, -50%); text-align: center; }
  .mk-pin i { display: block; width: 11px; height: 11px; border-radius: 50%; margin: 0 auto 6px; background: #CBD5E1; }
  .mk-pin.viva i { background: #10B981; }
  .mk-pin.aqui i { background: #2563EB; }
  .suite-visual.on .mk-pin.viva i,
  .suite-visual.on .mk-pin.aqui i { animation: mkLatido 2.6s ease-out infinite; }
  @keyframes mkLatido {
    0%   { box-shadow: 0 0 0 0 rgba(37,99,235,.45); }
    70%  { box-shadow: 0 0 0 14px rgba(37,99,235,0); }
    100% { box-shadow: 0 0 0 0 rgba(37,99,235,0); }
  }
  .mk-pin b { display: block; font-size: 11.5px; font-weight: 700; color: #0F172A; }
  .mk-pin small { font-size: 10px; color: #94A3B8; font-weight: 600; }

  /* ── La colección que se apaga (Temporadas) ── */
  .mk-env { display: flex; gap: 10px; margin-bottom: 16px; }
  .mk-env-p { flex: 1; text-align: center; }
  .mk-env-tela { height: 96px; border-radius: 5px 5px 12px 12px; transition: filter 1.4s ease, opacity 1.4s ease; }
  .mk-env-p small { display: block; margin-top: 7px; font-size: 9.5px; color: #94A3B8; font-weight: 700; }
  .suite-visual.on .mk-env-p:nth-child(2) .mk-env-tela { filter: grayscale(.5); }
  .suite-visual.on .mk-env-p:nth-child(3) .mk-env-tela { filter: grayscale(.85); opacity: .78; }
  .suite-visual.on .mk-env-p:nth-child(4) .mk-env-tela { filter: grayscale(1); opacity: .5; }
  .mk-env-barra { height: 6px; background: #F1F5F9; border-radius: 3px; overflow: hidden; margin-bottom: 10px; }
  .mk-env-barra i { display: block; height: 100%; width: 0;
    background: linear-gradient(90deg, #10B981, #F59E0B, #EF4444); transition: width 2.2s ease; }
  .suite-visual.on .mk-env-barra i { width: 100%; }

  /* ── El agente escribiendo (Agentes de IA) ── */
  .mk-chat { display: flex; flex-direction: column; gap: 9px; }
  .mk-burb { max-width: 82%; border-radius: 13px; padding: 10px 13px; font-size: 12.5px; line-height: 1.5; }
  .mk-burb-cli { background: #F1F5F9; color: #0F172A; border-bottom-left-radius: 4px; }
  .mk-burb-ia { background: #EFF6FF; border: 1px solid #C7DAFB; color: #0F172A;
    align-self: flex-end; border-bottom-right-radius: 4px; }
  .mk-rot { font-size: 9px; letter-spacing: .1em; text-transform: uppercase; font-weight: 800;
    color: #94A3B8; margin-bottom: 5px; }
  .mk-burb-ia .mk-rot { color: #2563EB; }
  .mk-teclea { display: inline-block; width: 7px; height: 13px; background: #2563EB;
    vertical-align: -2px; margin-left: 1px; }
  .suite-visual.on .mk-teclea { animation: mkParpadeo 1s steps(2) infinite; }
  @keyframes mkParpadeo { 50% { opacity: 0; } }
  .mk-accion { border: 1px solid #A7F3D0; background: #F0FDF9; border-radius: 10px;
    padding: 10px 13px; opacity: 0; transform: translateY(6px); }
  .suite-visual.on .mk-accion { animation: mkSube .5s ease 3.4s forwards; }
  @keyframes mkSube { to { opacity: 1; transform: none; } }
  .mk-accion b { display: block; font-size: 9.5px; letter-spacing: .1em; color: #047857; margin-bottom: 3px; }
  .mk-accion span { font-size: 11.5px; color: #065F46; }

  @media (prefers-reduced-motion: reduce) {
    .suite-visual.on .mk-prendas,
    .suite-visual.on .mk-cursor,
    .suite-visual.on .mk-pin.viva i,
    .suite-visual.on .mk-pin.aqui i,
    .suite-visual.on .mk-teclea { animation: none; }
    .mk-cursor { opacity: 1; left: 52%; top: 62%; }
    .mk-linea { stroke-dashoffset: 0; }
    .mk-accion { opacity: 1; transform: none; animation: none; }
    .mk-chip-1, .mk-chip-2, .mk-chip-3 { background: #EFF6FF; border-color: #93B4F5; color: #1D4ED8; }
  }
</style>

<script>
  {
    const pasos = document.querySelectorAll<HTMLElement>('.suite-step[data-step]');
    const visuales = document.querySelectorAll<HTMLElement>('.suite-visual[data-visual]');
    const puntos = document.querySelectorAll<HTMLElement>('.suite-dot[data-dot]');

    if (pasos.length) {
      const tabs = document.querySelectorAll<HTMLElement>('.suite-tab[data-tab]');
      const activar = (id: string) => {
        tabs.forEach((t) => t.classList.toggle('on', t.dataset.tab === id));
        pasos.forEach((p) => p.classList.toggle('on', p.dataset.step === id));
        visuales.forEach((v) => v.classList.toggle('on', v.dataset.visual === id));
        puntos.forEach((d) => d.classList.toggle('on', d.dataset.dot === id));
      };

      // Se activa el paso cuyo centro esta mas cerca del centro de la pantalla.
      // Una sola franja estrecha fallaba en pasos cortos y al llegar al final de
      // la pagina: el ultimo nunca se activaba.
      const obs = new IntersectionObserver(
        () => {
          const medio = window.innerHeight / 2;
          let mejor: HTMLElement | null = null;
          let dist = Infinity;
          pasos.forEach((p) => {
            const r = p.getBoundingClientRect();
            const d = Math.abs(r.top + r.height / 2 - medio);
            if (d < dist) { dist = d; mejor = p; }
          });
          if (mejor && mejor.dataset.step) activar(mejor.dataset.step);
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1], rootMargin: '-10% 0px -10% 0px' },
      );
      pasos.forEach((p) => obs.observe(p));

      activar(pasos[0].dataset.step || '');

      // La barra solo existe mientras el recorrido esta en pantalla.
      const suite = document.getElementById('suite');
      const barra = document.querySelector<HTMLElement>('.suite-nav');
      if (suite && barra) {
        new IntersectionObserver(
          ([e]) => barra.classList.toggle('fuera', !e.isIntersecting),
          { rootMargin: '-71px 0px 0px 0px' },
        ).observe(suite);
      }
    }
  }
</script>
