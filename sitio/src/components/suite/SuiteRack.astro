---
/**
 * SuiteRack — el perchero que corre de lado con el scroll.
 *
 * Es un respiro entre bloques y, sobre todo, es el argumento del giro dicho con
 * la aritmetica en la mano: un modelo colgado NO es un producto, son sus tallas
 * por sus colores. La version anterior mostraba diez modelos distintos como
 * rectangulos de color, lo cual enseñaba variedad de catalogo — que es otra
 * cosa — y ademas no se entendia que colgaba de ahi.
 *
 * Ahora cada percha trae la prenda de verdad y su cuenta: "6 tallas × 4 colores
 * = 24 piezas". Al final de la tira va el total, que es el remate: seis modelos
 * en la percha son ciento siete piezas que alguien tiene que contar.
 *
 * Va contra el scroll de la pagina, NO lo secuestra: el visitante nunca pierde
 * el control de su rueda.
 */
export interface RackPieza {
  n: string;
  img: string;
  /** Los dos ejes que multiplican: en moda tallas × colores; en otro giro, lo que aplique. */
  tallas: number;
  colores: number;
}
interface Props {
  eyebrow?: string;
  titulo?: string;
  /** Palabra destacada del título. */
  resalte?: string;
  piezas: RackPieza[];
  /** Cómo se nombra cada eje: "5 tallas × 3 colores". */
  ejeA?: string;
  ejeB?: string;
  unidad?: string;
  /** Texto del remate: "107 piezas en la percha". */
  remate?: string;
}
const {
  eyebrow = 'Un modelo no es un producto',
  titulo = 'Cada prenda que cuelgas son',
  resalte = 'ocho, doce, veinticuatro',
  piezas,
  ejeA = 'tallas',
  ejeB = 'colores',
  unidad = 'piezas',
  remate = 'piezas en la percha',
} = Astro.props;

const prendas = piezas;

/* La tira se recorre dos veces: con seis prendas no hay recorrido suficiente
   para que el movimiento lateral se note en una pantalla ancha. */
const tira = [...prendas, ...prendas];
const totalPiezas = prendas.reduce((a, p) => a + p.tallas * p.colores, 0);
---


<section class="rack-bloque" id="rackBloque">
  <div class="rack-head">
    <p class="rack-eyebrow">{eyebrow}</p>
    <h2>{titulo} <span>{resalte}</span> {unidad} distintas.</h2>
  </div>

  <div class="rack">
    <div class="rack-prendas" id="rackPrendas">
      {tira.map((p, i) => (
        <div class="rack-prenda">
          <img src={p.img} alt={p.n} loading="lazy" decoding="async" width="220" height="330" />
          <div class="rack-ficha">
            <b>{p.n}</b>
            <span class="rack-cuenta">{p.tallas} {ejeA} × {p.colores} {ejeB}</span>
            <span class="rack-piezas">{p.tallas * p.colores} {unidad}</span>
          </div>
        </div>
      ))}

      <!-- Remate de la tira: la suma es el argumento. -->
      <div class="rack-prenda rack-total">
        <div class="rack-total-caja">
          <b>{totalPiezas}</b>
          <span>{remate}</span>
          <em>de solo {prendas.length} modelos</em>
        </div>
      </div>
    </div>
  </div>

  <div class="rack-pista"><i id="rackPista"></i></div>
</section>

<style>
  .rack-bloque { background: #0C0C10; padding: 90px 0 70px; overflow: hidden; }
  .rack-head { max-width: 1200px; margin: 0 auto 46px; padding: 0 24px; }
  .rack-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #60A5FA; margin: 0 0 16px;
  }
  .rack-head h2 {
    font-size: clamp(26px, 4vw, 46px); font-weight: 800; letter-spacing: -1.8px;
    line-height: 1.06; color: #fff; margin: 0; max-width: 22ch;
  }
  .rack-head h2 span {
    color: #4B7BE5;
  }

  .rack { position: relative; height: 440px; }
  .rack-prendas { display: flex; gap: 34px; padding: 0 40px; will-change: transform; align-items: flex-start; }
  .rack-prenda { width: 210px; flex-shrink: 0; text-align: center; }
  .rack-prenda img {
    display: block; width: 100%; height: 280px; object-fit: cover; object-position: center;
    border-radius: 4px;
    /* La foto viene sobre fondo claro de estudio: sobre el negro del bloque hay
       que apagarla un poco o parece un recorte pegado. */
    filter: brightness(.94) contrast(1.04);
  }
  .rack-ficha { margin-top: 15px; }
  .rack-ficha b { display: block; font-size: 14px; color: #E4E4E7; font-weight: 600; margin-bottom: 5px; }
  .rack-cuenta { display: block; font-size: 11.5px; color: #71717A; font-weight: 600; }
  /* El numero es el argumento: se lee antes que el nombre del modelo. */
  .rack-piezas {
    display: inline-block; margin-top: 8px; font-size: 12px; font-weight: 800;
    color: #A8C4FA; border: 1px solid rgba(75,123,229,.4); border-radius: 999px;
    padding: 4px 11px; letter-spacing: .02em;
  }

  .rack-total { display: flex; align-items: center; justify-content: center; height: 280px; }
  .rack-total-caja {
    border-left: 1px solid #26262E; padding-left: 30px; text-align: left;
  }
  .rack-total-caja b {
    display: block; font-size: 62px; font-weight: 800; color: #fff; line-height: 1;
    letter-spacing: -2.5px; font-variant-numeric: tabular-nums;
  }
  .rack-total-caja span { display: block; font-size: 15px; color: #A1A1AA; margin-top: 8px; font-weight: 600; }
  .rack-total-caja em { display: block; font-style: normal; font-size: 13px; color: #6A6A76; margin-top: 4px; }

  .rack-pista {
    max-width: 1200px; margin: 34px auto 0; padding: 0 24px; height: 3px;
  }
  .rack-pista i {
    display: block; height: 3px; width: 14%; background: #2563EB; border-radius: 2px;
    transition: width .1s linear;
  }

  @media (max-width: 760px) {
    .rack-bloque { padding: 64px 0 52px; }
    .rack { height: 366px; }
    .rack-prenda { width: 148px; }
    .rack-prenda img { height: 196px; }
    .rack-prendas { gap: 20px; padding: 0 18px; }
    .rack-ficha b { font-size: 12.5px; }
    .rack-cuenta { font-size: 10.5px; }
    .rack-piezas { font-size: 11px; padding: 3px 9px; }
    .rack-total { height: 196px; }
    .rack-total-caja { padding-left: 20px; }
    .rack-total-caja b { font-size: 42px; }
    .rack-total-caja span { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Sin movimiento el rack se navega a mano, como una galería normal. */
    .rack { overflow-x: auto; }
    .rack-prendas { transform: none !important; }
    .rack-pista { display: none; }
  }
</style>

<script>
  {
    const bloque = document.getElementById('rackBloque');
    const tira = document.getElementById('rackPrendas');
    const pista = document.getElementById('rackPista');
    const menos = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (bloque && tira && !menos) {
      let pendiente = false;

      const mover = () => {
        pendiente = false;
        const r = bloque.getBoundingClientRect();
        // Avance del bloque por la pantalla: 0 cuando asoma por abajo, 1 cuando
        // termina de salir por arriba.
        const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
        const max = Math.max(0, tira.scrollWidth - bloque.clientWidth + 80);
        tira.style.transform = `translateX(${-p * max}px)`;
        if (pista) pista.style.width = Math.max(14, p * 100) + '%';
      };

      // El scroll dispara muchisimo; se pinta una vez por cuadro y no por evento.
      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(mover);
      };

      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', alScroll);
      mover();
    }
  }
</script>
