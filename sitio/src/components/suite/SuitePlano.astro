---
/**
 * SuitePlano — la operación completa, contada como el plano de la tienda.
 *
 * Sustituye al círculo de las cuatro etapas. El problema del círculo no era
 * el contenido: era que seguía siendo una lista de funciones agrupada, y una
 * lista de cuarenta funciones se hojea y se olvida.
 *
 * Un plano se recorre. El dueño reconoce su propia tienda, va a la zona que le
 * duele, y la cobertura completa se percibe sin tener que enumerarla. Cada zona
 * abre con la pregunta que él ya se hizo —«es sábado, hay fila y se cayó el
 * internet»— así la función llega como respuesta y no como característica.
 *
 * Se dibuja con las convenciones de un plano de verdad —muro con poché, giro
 * de puerta, mobiliario en símbolos, cotas, escala gráfica y clave numerada—
 * porque el lenguaje del oficio es lo que separa un diagrama de una lámina.
 * Y cada zona lleva su fotografía: el plano da la estructura, la foto da la
 * aspiración.
 *
 * Tres reglas que no hay que romper:
 *
 * · Lo que se cobra aparte se marca aparte, en la misma lista y no escondido.
 *   Si el cliente lo descubre en la llamada, la llamada se enfría.
 * · La lista completa vive ABAJO y siempre visible. El panel de la zona invita
 *   a explorar; la lámina de abajo es la que prueba que la suite está entera.
 * · El plano cambia con el giro; la estructura no. En una zapatería las zonas
 *   son mostrador, probador con su banco, bodega de cajas y trastienda; en una
 *   joyería, vitrina, mostrador, taller y caja fuerte.
 */
export interface ZonaPlano {
  id: string;
  /** El nombre de la zona, como se le dice en el piso. */
  nombre: string;
  /** Dentro o fuera del muro de la tienda. */
  fuera?: boolean;
  /** Cómo se nombra dónde está, si "En piso" no aplica. */
  ambito?: string;
  /** La pregunta que el dueño ya se hizo. */
  pregunta: string;
  /** Rectángulo dentro del plano, en el sistema de 660 × 430. */
  caja: { x: number; y: number; w: number; h: number };
  /** Qué mobiliario se dibuja dentro. */
  simbolo?: 'rieles' | 'probadores' | 'anaqueles' | 'mostrador' | 'paquetes' | 'exhibidores' | 'bancas' | 'vitrinas' | 'banco';
  /** La fotografía de la zona. */
  foto?: string;
  alt?: string;
  /** Pie de foto: qué se está viendo. */
  pie?: string;
  /** Cada función, con su escalón: incluido, desde un plan, o complemento. */
  items: { t: string; plan?: string; extra?: boolean; suite?: boolean }[];
}
interface Props {
  eyebrow?: string;
  titulo: string;
  sub?: string;
  /** Rótulo del cajetín, como en una lámina real. */
  proyecto?: string;
  zonas: ZonaPlano[];
  todoRot?: string;
  /** Pie de la lámina de abajo; cámbialo si la suite se vende aparte. */
  leyenda?: string;
}
const {
  eyebrow = 'Toda la operación, en un solo lugar',
  titulo,
  sub,
  proyecto = 'Tu tienda — planta baja',
  zonas,
  todoRot = 'Todo lo que incluye, zona por zona',
  leyenda = 'Todo lo de arriba viene incluido en tu plan, salvo lo que diga otra cosa.',
} = Astro.props;

/** El mobiliario, dibujado en símbolos sobre la caja de cada zona. */
function mobiliario(z: ZonaPlano): string {
  const { x, y, w, h } = z.caja;
  const L = (a: number, b: number, c: number, d: number, k = 'pn-mob') =>
    `<line class="${k}" x1="${a}" y1="${b}" x2="${c}" y2="${d}"/>`;
  const R = (a: number, b: number, c: number, d: number, k = 'pn-mob-f') =>
    `<rect class="${k}" x="${a}" y="${b}" width="${c}" height="${d}" rx="1.5"/>`;

  switch (z.simbolo) {
    case 'rieles': {
      // Dos rieles largos con sus ganchos, una mesa de doblado y una banca.
      let s = '';
      [0.44, 0.68].forEach((f) => {
        const yy = y + h * f;
        s += `<rect class="pn-mob-f" x="${x + 14}" y="${yy - 2}" width="${w - 76}" height="4" rx="2"/>`;
        for (let i = x + 22; i < x + w - 66; i += 11) s += L(i, yy - 6, i, yy + 6);
      });
      s += R(x + w - 56, y + h * 0.38, 42, 32);             // mesa de doblado
      s += `<circle class="pn-mob-f" cx="${x + w - 35}" cy="${y + h - 34}" r="17"/>`; // mesa redonda
      s += R(x + 16, y + h - 28, 46, 12);                    // banca
      return s;
    }
    case 'vitrinas': {
      // La línea de vitrinas en U, con sus charolas y los banquitos del cliente.
      let s = '';
      s += `<rect class="pn-mob-f" x="${x + 16}" y="${y + 34}" width="${w - 32}" height="18" rx="2"/>`;
      s += `<rect class="pn-mob-f" x="${x + 16}" y="${y + 34}" width="18" height="${h - 70}" rx="2"/>`;
      s += `<rect class="pn-mob-f" x="${x + w - 34}" y="${y + 34}" width="18" height="${h - 70}" rx="2"/>`;
      for (let i = x + 44; i < x + w - 44; i += 22) s += L(i, y + 34, i, y + 52);
      for (let i = 0; i < 3; i++) s += `<circle class="pn-mob" cx="${x + 52 + i * 40}" cy="${y + h - 26}" r="9" fill="none"/>`;
      return s;
    }
    case 'banco': {
      // El banco de joyero con su media luna, la pulidora contra el muro y el
      // banquito. Nada de <path> aquí: el compilador de Astro se atraganta.
      const med = Math.round(w * 0.42);
      let s = R(x + 18, y + 40, w - 60, 28);
      s += `<circle class="pn-mob" cx="${x + med}" cy="${y + 68}" r="15" fill="none" opacity=".5"/>`;
      s += `<circle class="pn-mob" cx="${x + 34}" cy="${y + 92}" r="8" fill="none"/>`;
      s += `<rect class="pn-mob-t" x="${x + w - 30}" y="${y + 36}" width="14" height="${h - 62}"/>`;
      s += R(x + 62, y + h - 32, 40, 18);
      return s;
    }
    case 'exhibidores': {
      // El calzado se exhibe en muro: repisas corridas con una muestra por
      // modelo, y un par de podios al centro.
      let s = '';
      [0.30, 0.46, 0.62].forEach((f) => {
        s += `<rect class="pn-mob-t" x="${x + 14}" y="${y + h * f}" width="${w - 92}" height="9"/>`;
      });
      s += R(x + w - 68, y + h * 0.30, 52, 30);
      s += `<circle class="pn-mob-f" cx="${x + w - 42}" cy="${y + h * 0.70}" r="18"/>`;
      s += R(x + 16, y + h - 26, 44, 12);
      return s;
    }
    case 'bancas': {
      // Las bancas del probador, enfrentadas, con el espejo bajo en el muro.
      let s = '';
      for (let i = 0; i < 2; i++) {
        s += R(x + 18, y + 34 + i * 34, w - 76, 16);
      }
      s += `<rect class="pn-mob-t" x="${x + w - 26}" y="${y + 30}" width="10" height="${h - 56}"/>`;
      for (let i = 0; i < 3; i++) s += R(x + 20 + i * 26, y + h - 34, 20, 14);
      return s;
    }
    case 'probadores': {
      // Tres cabinas con su cortina y su banco.
      let s = '';
      const cw = (w - 20) / 3;
      for (let i = 0; i < 3; i++) {
        const cx = x + 10 + i * cw;
        s += L(cx, y + 26, cx, y + h - 10);
        s += `<path class="pn-mob" d="M${cx + 4} ${y + 26} A ${cw - 8} ${cw - 8} 0 0 1 ${cx + cw - 4} ${y + 26 + (cw - 8) * 0.34}" opacity=".5"/>`;
        s += R(cx + 6, y + h - 26, cw - 14, 9);
      }
      s += L(x + 10 + 3 * cw, y + 26, x + 10 + 3 * cw, y + h - 10);
      return s;
    }
    case 'anaqueles': {
      // Anaquelería en dos muros y el escritorio.
      let s = '';
      s += `<rect class="pn-mob-t" x="${x + 10}" y="${y + 26}" width="${w - 20}" height="13"/>`;
      s += `<rect class="pn-mob-t" x="${x + w - 23}" y="${y + 44}" width="13" height="${h - 60}"/>`;
      s += R(x + 12, y + h - 42, 44, 26);
      s += `<circle class="pn-mob" cx="${x + 66}" cy="${y + h - 29}" r="6" fill="none"/>`;
      return s;
    }
    case 'mostrador': {
      // Mostrador en L, con la anaquelería de respaldo sobre el muro.
      let s = `<rect class="pn-mob-t" x="${x + 12}" y="${y + 42}" width="13" height="${h - 60}"/>`;
      s += `<rect class="pn-mob-f" x="${x + 46}" y="${y + h - 46}" width="${w - 104}" height="16" rx="2"/>`;
      s += `<rect class="pn-mob-f" x="${x + 46}" y="${y + h - 84}" width="16" height="38" rx="2"/>`;
      s += R(x + w - 52, y + h - 44, 34, 24);              // caja y terminal
      s += R(x + w - 128, y + 30, 62, 28);                 // mesa de novedades
      return s;
    }
    case 'paquetes': {
      // Mesa de empaque, los paquetes listos y el anaquel del material.
      let s = R(x + 18, y + 42, w - 36, 36);                // mesa de empaque
      for (let i = 0; i < 4; i++) s += R(x + 22 + i * 32, y + 92, 26, 26);  // paquetes listos
      s += `<rect class="pn-mob-t" x="${x + 18}" y="${y + h - 36}" width="${w - 36}" height="16"/>`;
      return s;
    }
    default:
      return '';
  }
}

/** El rótulo tiene que caber en su zona; si no cabe, se achica. */
function cuerpo(z: ZonaPlano): number {
  const disponible = z.caja.w - 42;
  return Math.max(7.5, Math.min(11, disponible / (z.nombre.length * 0.70)));
}

const dentro = zonas.filter((z) => !z.fuera);
const fuera = zonas.filter((z) => z.fuera);
const clave = zonas.map((z, i) => ({ ...z, n: String(i + 1).padStart(2, '0') }));
const primera = clave[0];
---

<section class="pn">
  <div class="pn-inner">

    <header class="pn-head">
      <p class="pn-eyebrow">{eyebrow}</p>
      <h2>{titulo}</h2>
      {sub && <p class="pn-sub">{sub}</p>}
    </header>

    <div class="pn-riel" style={`--pasos:${zonas.length}`}>
      <div class="pn-pegado">

      <!-- El indicador: sin esto no se entiende que el plano se toca -->
      <div class="pn-guia">
        <p class="pn-guia-t">Recorre las {zonas.length} zonas — baja o toca la que te interese</p>
        <ol class="pn-pasos">
          {clave.map((z) => (
            <li>
              <button type="button" data-ir={z.id} class:list={{ on: z.id === primera.id }}>
                <b>{z.n}</b><span>{z.nombre}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div class="pn-maq">

      <!-- ── La lámina ── -->
      <figure class="pn-lamina">
        <svg viewBox="0 0 660 430" role="img" aria-label={`Plano de la tienda con ${zonas.length} zonas: ${zonas.map((z) => z.nombre).join(', ')}`}>
          <defs>
            <pattern id="pnPoche" width="4" height="4" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="0" y2="4" stroke="#1a1a2e" stroke-width="2.2" opacity=".32"></line>
            </pattern>
            <pattern id="pnTrama" width="7" height="7" patternUnits="userSpaceOnUse">
              <line x1="0" y1="7" x2="7" y2="0" stroke="#1a1a2e" stroke-width=".6" opacity=".45"></line>
            </pattern>
            <pattern id="pnRetic" width="26" height="26" patternUnits="userSpaceOnUse">
              <path d="M26 0 H0 V26" fill="none" stroke="#1a1a2e" stroke-width=".5" opacity=".07"></path>
            </pattern>
          </defs>

          <rect x="0" y="0" width="660" height="430" fill="url(#pnRetic)"></rect>

          <!-- Muro perimetral con espesor -->
          <path class="pn-poche" d="M46 58 H448 V392 H46 Z M58 70 H436 V380 H58 Z" fill-rule="evenodd"></path>
          <rect class="pn-muro" x="46" y="58" width="402" height="334"></rect>
          <rect class="pn-muro" x="58" y="70" width="378" height="310"></rect>

          <!-- Vano y giro de puerta -->
          <rect class="pn-vano" x="320" y="378" width="72" height="16"></rect>
          <path class="pn-giro" d="M392 380 A 72 72 0 0 0 320 308"></path>
          <line class="pn-muro-fino" x1="320" y1="380" x2="320" y2="308"></line>
          <text class="pn-rot" x="330" y="412">Acceso</text>

          <!-- Cotas -->
          <g class="pn-cota">
            <line x1="46" y1="40" x2="448" y2="40"></line>
            <path d="M46 35 V45 M448 35 V45"></path>
            <text x="247" y="32" text-anchor="middle">12.40 m</text>
            <line x1="26" y1="58" x2="26" y2="392"></line>
            <path d="M21 58 H31 M21 392 H31"></path>
            <text x="18" y="225" text-anchor="middle" transform="rotate(-90 18 225)">10.30 m</text>
          </g>

          <!-- Zonas -->
          {clave.map((z) => (
            <g class:list={['pn-z', { on: z.id === primera.id }]} data-zona={z.id} tabindex="0" role="button" aria-label={z.nombre}>
              <rect class="pn-sup" x={z.caja.x} y={z.caja.y} width={z.caja.w} height={z.caja.h} rx="2"></rect>
              <g class="pn-mobs"><Fragment set:html={mobiliario(z)} /></g>
              <circle class="pn-num-b" cx={z.caja.x + 15} cy={z.caja.y + 15} r="10"></circle>
              <text class="pn-num-t" x={z.caja.x + 15} y={z.caja.y + 18.5} text-anchor="middle">{z.n}</text>
              <text class="pn-z-t" x={z.caja.x + 31} y={z.caja.y + 19} style={`font-size:${cuerpo(z)}px`}>{z.nombre.toUpperCase()}</text>
            </g>
          ))}

          {fuera.length > 0 && (
            <>
              <path class="pn-liga" d="M448 226 H 480"></path>
              <text class="pn-rot" x="559" y="136" text-anchor="middle">Fuera del muro</text>
            </>
          )}

          <!-- Escala gráfica -->
          <g class="pn-escala">
            <rect x="46" y="406" width="32" height="5"></rect>
            <rect class="alt" x="78" y="406" width="32" height="5"></rect>
            <rect x="110" y="406" width="32" height="5"></rect>
            <text x="150" y="414">3 m</text>
          </g>
        </svg>

        <ul class="pn-simb">
          <li>
            <svg viewBox="0 0 18 12" aria-hidden="true"><rect x="1" y="1" width="16" height="10" fill="url(#pnPoche)" stroke="#1a1a2e" stroke-width="1"></rect></svg>
            Muro
          </li>
          <li>
            <svg viewBox="0 0 18 12" aria-hidden="true"><rect x="1" y="2.5" width="16" height="7" fill="none" stroke="#1a1a2e" stroke-width="1" opacity=".5"></rect></svg>
            Mobiliario
          </li>
          <li>
            <svg viewBox="0 0 18 12" aria-hidden="true"><rect x="1" y="2.5" width="16" height="7" fill="url(#pnTrama)" stroke="#1a1a2e" stroke-width=".8" opacity=".6"></rect></svg>
            Anaquelería
          </li>
          <li>
            <svg viewBox="0 0 18 12" aria-hidden="true"><line x1="1" y1="6" x2="17" y2="6" stroke="#4B7BE5" stroke-width="1.4" stroke-dasharray="4 3"></line></svg>
            Mismo inventario
          </li>
        </ul>

        <figcaption class="pn-cajetin">
          <span class="pn-cj-p">{proyecto}</span>
          <span class="pn-cj-e">Esc. 1:100</span>
          <span class="pn-cj-n">{dentro.length} zonas en piso · {fuera.length} fuera del muro</span>
        </figcaption>
      </figure>

      <!-- ── La zona seleccionada, en foto ── -->
      <div class="pn-vista">
        {clave.map((z) => (
          <article class:list={['pn-hoja', { on: z.id === primera.id }]} data-hoja={z.id}>
            {z.foto && (
              <div class="pn-foto">
                <img src={z.foto} alt={z.alt || z.nombre} loading={z.id === primera.id ? 'eager' : 'lazy'} decoding="async" />
                <span class="pn-foto-n">{z.n}</span>
                {z.pie && <span class="pn-foto-p">{z.pie}</span>}
              </div>
            )}
            <div class="pn-hoja-txt">
              <p class="pn-det-et">{z.ambito || (z.fuera ? 'Fuera de la tienda' : 'En piso')}</p>
              <h3>{z.nombre}</h3>
              <p class="pn-q">{z.pregunta}</p>
              <p class="pn-cuenta">
                <b>{z.items.length}</b> funciones de SACS trabajan en esta zona
                <span>Las tienes enlistadas abajo</span>
              </p>
            </div>
          </article>
        ))}
      </div>
      </div>
      </div>
      <div class="pn-recorrido" aria-hidden="true"></div>
    </div>

    <!-- ── La lámina de abajo: todo lo que incluye, sin esconder nada ── -->
    <div class="pn-todo">
      <p class="pn-todo-rot">{todoRot}</p>
      <div class="pn-todo-g">
        {clave.map((z) => (
          <article class:list={['pn-col', { on: z.id === primera.id }]} data-col={z.id} data-ir={z.id}>
            <header>
              <b class="pn-col-n">{z.n}</b>
              <h4>{z.nombre}</h4>
            </header>
            <ul>
              {z.items.map((it) => (
                <li class:list={{ extra: it.extra, suite: it.suite }}>
                  <i></i>
                  <span>
                    {it.t}
                    {(it.extra || it.suite || it.plan) && <em>{it.extra ? 'Se cotiza aparte' : it.suite ? 'De la Suite Joyería' : `Desde el plan ${it.plan}`}</em>}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="pn-leyenda">{leyenda}</p>
    </div>

  </div>
</section>

<style>
  .pn {
    background: var(--color-bg-primary, #FAFAF8);
    color: var(--color-text-primary, #1a1a2e);
    padding: clamp(72px, 9vw, 112px) 0;
  }
  .pn-inner { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

  .pn-head { max-width: 720px; margin-bottom: clamp(34px, 4vw, 48px); }
  .pn-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: var(--color-primary, #4B7BE5); margin: 0 0 16px;
  }
  .pn-head h2 {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; letter-spacing: -.03em;
    line-height: 1.1; margin: 0 0 16px; color: var(--color-text-primary, #1a1a2e);
  }
  .pn-sub { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-secondary, #4A4A4A); }

  /* El plano se queda pegado y va cambiando de zona conforme se baja. Así se
     recorre entero sin que nadie tenga que adivinar que es clicable, y al
     terminar suelta y la página sigue. */
  /* El recorrido va como caja propia y no como padding: un sticky sólo puede
     viajar dentro del content box de quien lo contiene, y con padding-bottom
     el panel se quedaba clavado arriba sin pegarse nunca. */
  .pn-recorrido { height: calc((var(--pasos) - 1) * 52vh); }
  .pn-pegado { position: sticky; top: var(--pn-tope, 96px); }
  .pn.sin-riel .pn-recorrido { display: none; }
  .pn.sin-riel .pn-pegado { position: static; }

  .pn-guia { margin-bottom: 18px; }
  .pn-guia-t {
    margin: 0 0 12px; font-size: 12.5px; font-weight: 700;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .pn-pasos {
    list-style: none; display: flex; gap: 8px; margin: 0; padding: 0;
  }
  .pn-pasos li { flex: 1 1 0; min-width: 0; }
  .pn-pasos button {
    width: 100%; display: flex; align-items: center; gap: 9px; cursor: pointer;
    background: none; border: none; border-top: 2px solid rgba(0,0,0,.12);
    padding: 11px 2px 0; text-align: left; font: inherit;
    transition: border-color .3s ease;
  }
  .pn-pasos button b {
    width: 20px; height: 20px; border-radius: 50%; flex: none; display: grid; place-items: center;
    background: var(--color-bg-secondary, #F5F3EE); color: var(--color-text-tertiary, #8C8C8C);
    font-size: 9.5px; font-weight: 800;
    transition: background .3s ease, color .3s ease;
  }
  .pn-pasos button span {
    font-size: 13px; font-weight: 600; color: var(--color-text-tertiary, #8C8C8C);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: color .3s ease;
  }
  .pn-pasos button:hover span { color: var(--color-text-secondary, #4A4A4A); }
  .pn-pasos button.on { border-top-color: var(--color-primary, #4B7BE5); }
  .pn-pasos button.on b { background: var(--color-primary, #4B7BE5); color: #fff; }
  .pn-pasos button.on span { color: var(--color-text-primary, #1a1a2e); font-weight: 700; }
  .pn-pasos button:focus-visible { outline: 2px solid var(--color-primary, #4B7BE5); outline-offset: 3px; }

  .pn-maq { display: grid; grid-template-columns: 1.28fr 1fr; gap: 22px; align-items: stretch; }

  /* ── La lámina ── */
  .pn-lamina {
    margin: 0; background: var(--color-bg-card, #fff); border: 1px solid rgba(0,0,0,.08);
    border-radius: var(--radius-2xl, 24px); padding: 20px 20px 0; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .pn-lamina > svg { width: 100%; height: auto; display: block; flex: none; margin: auto 0 0; }

  .pn-poche { fill: url(#pnPoche); }
  .pn-muro { fill: none; stroke: var(--color-text-primary, #1a1a2e); stroke-width: 1.6; opacity: .85; }
  .pn-muro-fino { stroke: var(--color-text-primary, #1a1a2e); stroke-width: 1.4; opacity: .7; }
  .pn-vano { fill: var(--color-bg-card, #fff); }
  .pn-giro { fill: none; stroke: var(--color-text-primary, #1a1a2e); stroke-width: 1; opacity: .35; stroke-dasharray: 3 3; }

  .pn-cota line, .pn-cota path { stroke: var(--color-text-tertiary, #8C8C8C); stroke-width: .9; }
  .pn-cota text, .pn-rot, .pn-escala text {
    font-family: var(--font-body), system-ui, sans-serif; font-size: 9px; font-weight: 600;
    letter-spacing: .1em; fill: var(--color-text-tertiary, #8C8C8C); text-transform: uppercase;
  }
  .pn-escala rect { fill: none; stroke: var(--color-text-tertiary, #8C8C8C); stroke-width: .9; }
  .pn-escala rect.alt { fill: var(--color-text-tertiary, #8C8C8C); }

  .pn-liga { stroke: var(--color-primary, #4B7BE5); stroke-width: 1.4; stroke-dasharray: 4 4; fill: none; opacity: .6; }

  .pn-z { cursor: pointer; }
  .pn-z:focus-visible { outline: 2px solid var(--color-primary, #4B7BE5); outline-offset: 3px; border-radius: 4px; }
  .pn-sup {
    fill: #fff; stroke: rgba(26,26,46,.28); stroke-width: 1;
    transition: fill .25s ease, stroke .25s ease;
  }
  .pn-z:hover .pn-sup { fill: var(--azul-fondo); }
  .pn-z.on .pn-sup { fill: var(--azul-fondo); stroke: var(--color-primary, #4B7BE5); stroke-width: 1.8; }

  .pn-num-b { fill: var(--color-text-primary, #1a1a2e); transition: fill .25s ease; }
  .pn-z.on .pn-num-b { fill: var(--color-primary, #4B7BE5); }
  .pn-num-t {
    font-family: var(--font-body), system-ui, sans-serif; font-size: 9.5px; font-weight: 800;
    fill: #fff; pointer-events: none;
  }
  .pn-z-t {
    font-family: var(--font-body), system-ui, sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: .07em; fill: var(--color-text-secondary, #4A4A4A); pointer-events: none;
    transition: fill .25s ease;
  }
  .pn-z.on .pn-z-t { fill: var(--azul-texto); }

  /* La leyenda de símbolos: la lleva cualquier lámina y aquí además cierra el
     aire que deja el plano contra la altura de la foto. */
  .pn-simb {
    list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 10px 0 0; padding: 0;
    font-size: 11px; font-weight: 600; color: var(--color-text-tertiary, #8C8C8C);
  }
  .pn-simb li { display: inline-flex; align-items: center; gap: 7px; }
  .pn-simb svg { width: 20px; height: 13px; display: block; flex: none; }

  .pn-cajetin {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px;
    border-top: 1px solid rgba(0,0,0,.1); margin: 16px -20px 0; padding: 13px 20px;
    font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .pn-cj-p { color: var(--color-text-primary, #1a1a2e); }
  .pn-cj-n { margin-left: auto; font-weight: 600; letter-spacing: .06em; text-transform: none; }

  /* ── La zona en foto ── */
  .pn-vista {
    background: var(--color-bg-card, #fff); border: 1px solid rgba(0,0,0,.08);
    border-radius: var(--radius-2xl, 24px); overflow: hidden; display: flex; flex-direction: column;
  }
  .pn-hoja { display: none; }
  .pn-hoja.on { display: flex; flex-direction: column; flex: 1; }
  .pn-foto { position: relative; aspect-ratio: 3 / 2; background: var(--color-bg-secondary, #F5F3EE); }
  .pn-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pn-foto-n {
    position: absolute; top: 16px; left: 16px; width: 30px; height: 30px; border-radius: 50%;
    background: var(--color-bg-dark, #1A1A1A); color: #fff; display: grid; place-items: center;
    font-size: 12px; font-weight: 800; letter-spacing: .02em;
  }
  .pn-foto-p {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 34px 18px 14px; color: #fff;
    font-size: 12.5px; font-weight: 600; line-height: 1.4;
    background: linear-gradient(180deg, rgba(26,26,26,0) 0%, rgba(26,26,26,.82) 72%, rgba(26,26,26,.92) 100%);
  }
  .pn-hoja-txt { padding: 22px 24px 26px; flex: 1; display: flex; flex-direction: column; }
  .pn-det-et {
    margin: 0 0 9px; font-size: 11px; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C);
  }
  .pn-vista h3 {
    font-family: var(--font-display, 'Sora', sans-serif);
    margin: 0 0 12px; font-size: clamp(1.25rem, 2.2vw, 1.625rem); font-weight: 700; letter-spacing: -.02em;
  }
  .pn-q {
    margin: 0; padding-left: 13px; border-left: 3px solid var(--color-primary, #4B7BE5);
    font-size: 0.9375rem; line-height: 1.6; color: var(--color-text-secondary, #4A4A4A);
  }

  .pn-cuenta {
    margin: auto 0 0; padding-top: 20px; font-size: 13.5px;
    color: var(--color-text-secondary, #4A4A4A);
  }
  .pn-cuenta b { font-weight: 800; color: var(--color-text-primary, #1a1a2e); }
  .pn-cuenta span {
    display: block; margin-top: 3px; font-size: 11.5px; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C);
  }

  /* ── Todo lo que incluye ── */
  .pn-todo { margin-top: 30px; }
  .pn-todo-rot {
    margin: 0 0 16px; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .pn-todo-g { display: grid; grid-template-columns: repeat(auto-fit, minmax(196px, 1fr)); gap: 14px; }
  .pn-col {
    background: var(--color-bg-card, #fff); border: 1px solid rgba(0,0,0,.08);
    border-radius: var(--radius-lg, 16px); padding: 18px 18px 6px; cursor: pointer;
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .pn-col:hover { border-color: rgba(75,123,229,.4); }
  .pn-col.on { border-color: var(--color-primary, #4B7BE5); box-shadow: 0 4px 18px rgba(75,123,229,.13); }
  .pn-col header { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }
  .pn-col-n {
    width: 22px; height: 22px; border-radius: 50%; flex: none;
    background: var(--color-bg-secondary, #F5F3EE); color: var(--color-text-tertiary, #8C8C8C);
    display: grid; place-items: center; font-size: 10px; font-weight: 800;
    transition: background .25s ease, color .25s ease;
  }
  .pn-col.on .pn-col-n { background: var(--color-primary, #4B7BE5); color: #fff; }
  .pn-col h4 {
    margin: 0; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 15px; font-weight: 700; letter-spacing: -.01em;
  }
  .pn-col ul { list-style: none; margin: 0; padding: 0; }
  .pn-col li {
    display: grid; grid-template-columns: auto 1fr; gap: 9px; align-items: start;
    padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,.06); font-size: 13.5px; line-height: 1.45;
  }
  .pn-col li:last-child { border-bottom: none; }
  .pn-col li i {
    width: 5px; height: 5px; border-radius: 50%; margin-top: 7px;
    background: var(--color-text-tertiary, #8C8C8C); opacity: .55;
  }
  .pn-col li em {
    display: block; margin-top: 3px; font-style: normal; font-size: 11.5px; font-weight: 700;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .pn-col li.extra em { color: var(--aviso-texto); }
  .pn-col li.suite em { color: var(--azul-texto); }

  .pn-leyenda { margin: 16px 0 0; font-size: 12.5px; color: var(--color-text-tertiary, #8C8C8C); }

  @media (max-width: 980px) {
    /* Apilado el bloque no cabe en una pantalla: el riel se apaga y queda
       sólo el toque, con el indicador desplazable. */
    .pn-recorrido { display: none; }
    .pn-pegado { position: static; }
    .pn-pasos { overflow-x: auto; scrollbar-width: none; }
    .pn-pasos::-webkit-scrollbar { display: none; }
    .pn-pasos li { flex: 0 0 128px; }
    .pn-maq { grid-template-columns: 1fr; }
    .pn-cj-n { margin-left: 0; width: 100%; }
  }
  /* En celular la lámina mide la mitad: la tipografía del plano tiene que
     crecer o el rótulo de la zona deja de leerse. */
  @media (max-width: 640px) {
    .pn-lamina { padding: 14px 14px 0; }
    .pn-z-t { display: none; }
    .pn-num-t { font-size: 12.5px; }
    .pn-num-b { r: 13px; }
    .pn-cota text, .pn-rot, .pn-escala text { font-size: 11.5px; }
    .pn-cajetin { margin: 14px -14px 0; padding: 12px 14px; font-size: 10px; }
    .pn-simb { gap: 7px 16px; font-size: 10.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pn-sup, .pn-num-b, .pn-col, .pn-col-n, .pn-z-t { transition: none; }
  }
</style>

<style is:global>
  /* El mobiliario entra por set:html y queda fuera del scope de Astro. */
  .pn .pn-mobs { pointer-events: none; }
  .pn .pn-mob { stroke: #1a1a2e; stroke-width: 1; opacity: .34; fill: none; }
  .pn .pn-mob-f { fill: none; stroke: #1a1a2e; stroke-width: 1; opacity: .42; }
  .pn .pn-mob-t { fill: url(#pnTrama); stroke: #1a1a2e; stroke-width: .8; opacity: .5; }
  .pn .pn-z.on .pn-mob, .pn .pn-z.on .pn-mob-f { stroke: #2A5FD4; opacity: .75; }
  .pn .pn-z.on .pn-mob-t { stroke: #2A5FD4; opacity: .6; }
</style>

<script>
  {
    const bloque = document.querySelector<HTMLElement>('.pn');
    const riel = bloque?.querySelector<HTMLElement>('.pn-riel');
    const pegado = bloque?.querySelector<HTMLElement>('.pn-pegado');

    if (bloque && riel && pegado) {
      const zonas = Array.from(bloque.querySelectorAll<HTMLElement>('[data-zona]'));
      const hojas = Array.from(bloque.querySelectorAll<HTMLElement>('[data-hoja]'));
      const cols = Array.from(bloque.querySelectorAll<HTMLElement>('[data-col]'));
      const pasos = Array.from(bloque.querySelectorAll<HTMLElement>('[data-ir]'));
      const orden = zonas.map((z) => z.dataset.zona || '');
      let actual = orden[0];

      const abrir = (id: string) => {
        if (!id || id === actual) return;
        actual = id;
        zonas.forEach((z) => z.classList.toggle('on', z.dataset.zona === id));
        hojas.forEach((h) => h.classList.toggle('on', h.dataset.hoja === id));
        cols.forEach((c) => c.classList.toggle('on', c.dataset.col === id));
        pasos.forEach((p) => p.classList.toggle('on', p.dataset.ir === id));
      };

      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* El riel sólo tiene sentido si el panel cabe entero en la pantalla; si
         no, el visitante se quedaría viendo un bloque cortado que además le
         secuestra el scroll. */
      let conRiel = false;
      const medir = () => {
        const tope = parseFloat(getComputedStyle(pegado).top) || 0;
        conRiel =
          window.innerWidth > 980 &&
          !quieto.matches &&
          window.innerHeight >= pegado.offsetHeight + tope + 24;
        bloque.classList.toggle('sin-riel', !conRiel);
        return tope;
      };

      let pendiente = false;
      const alScroll = () => {
        if (!conRiel || pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          pendiente = false;
          const tope = parseFloat(getComputedStyle(pegado).top) || 0;
          const recorrido = riel.offsetHeight - pegado.offsetHeight;
          if (recorrido <= 0) return;
          const avance = (tope - riel.getBoundingClientRect().top) / recorrido;
          const i = Math.min(orden.length - 1, Math.max(0, Math.floor(avance * orden.length)));
          abrir(orden[i]);
        });
      };

      /* Al tocar una zona no basta con cambiarla: si el riel está activo hay
         que llevar el scroll a su tramo, o el siguiente movimiento del dedo la
         revertiría. */
      const irA = (id: string) => {
        const i = orden.indexOf(id);
        if (i < 0) return;
        if (!conRiel) { abrir(id); return; }
        const recorrido = riel.offsetHeight - pegado.offsetHeight;
        const y = window.scrollY + riel.getBoundingClientRect().top
          - (parseFloat(getComputedStyle(pegado).top) || 0)
          + recorrido * ((i + 0.5) / orden.length);
        window.scrollTo({ top: y, behavior: quieto.matches ? 'auto' : 'smooth' });
        abrir(id);
      };

      zonas.forEach((z) => {
        z.addEventListener('click', () => irA(z.dataset.zona || ''));
        z.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); irA(z.dataset.zona || ''); }
        });
      });
      cols.forEach((c) => c.addEventListener('click', () => irA(c.dataset.col || '')));
      pasos.forEach((p) => p.addEventListener('click', () => irA(p.dataset.ir || '')));

      medir();
      alScroll();
      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', () => { medir(); alScroll(); });
    }
  }
</script>
