---
/**
 * SuiteCortina — el antes y el después, con una línea que el visitante arrastra.
 *
 * Por que arrastrable y no dos columnas: la comparacion la HACE el visitante
 * con su propia mano, y eso se recuerda mucho mas que leerla.
 *
 * Lo que de verdad cierra el argumento no son los datos, son las dos caras: a
 * la izquierda la vendedora agobiada con su libreta; a la derecha la misma
 * escena resuelta. El dueño de la boutique no se reconoce en una tabla, se
 * reconoce en la cara de su colaboradora un sabado a las dos de la tarde.
 *
 * Regla de tono: la libreta no esta ridiculizada. Funciona — hasta que abres la
 * segunda tienda. Si el visitante siente que se burlan de como trabaja hoy,
 * deja de leer.
 */
export interface CortFila { que: string; donde: string; dato: string; }
interface Props {
  eyebrow?: string;
  titulo?: string;
  sub?: string;
  fotoAntes: string;
  fotoDespues: string;
  altAntes?: string;
  altDespues?: string;
  /** Renglones manuscritos del "hoy". */
  libreta?: string[];
  pieAntes?: string;
  filas: CortFila[];
  pieDespues?: string;
}
const {
  eyebrow = 'La misma pregunta, dos veces',
  titulo = '“¿Tendrás esta en chica?”',
  sub = 'Arrastra la línea. A la izquierda, cómo se responde hoy. A la derecha, en tres segundos.',
  fotoAntes,
  fotoDespues,
  altAntes = 'Cómo se resuelve hoy',
  altDespues = 'Cómo se resuelve con SACS',
  libreta = ['Blusa negra M — ¿quedan?', 'Vestido S … ¿en Satélite?'],
  pieAntes = 'Dos llamadas<br />y la clienta esperando.',
  filas,
  pieDespues = 'Tres segundos, sin llamarle a nadie.',
} = Astro.props;
---

<section class="cort-bloque">
  <div class="cort-head">
    <p class="cort-eyebrow">{eyebrow}</p>
    <h2>{titulo}</h2>
    <p class="cort-sub">
      Arrastra la línea. A la izquierda, cómo se responde hoy. A la derecha, en tres segundos.
    </p>
  </div>

  <div class="cort" id="cort">
    <!-- HOY -->
    <div class="cort-capa cort-antes">
      <img src={fotoAntes} alt={altAntes} loading="lazy" decoding="async" />
      <div class="cort-velo cort-velo-a"></div>
      <span class="cort-etq cort-etq-a">Hoy</span>
      <div class="cort-panel cort-panel-a">
        <div class="cort-libreta" aria-hidden="true">
          {libreta.map((l, k) => <Fragment>{k > 0 && <br />}{l}</Fragment>)}
        </div>
        <p class="cort-pie cort-pie-a"><Fragment set:html={pieAntes} /></p>
      </div>
    </div>

    <!-- CON SACS -->
    <div class="cort-capa cort-despues" id="cortDespues">
      <img src={fotoDespues} alt={altDespues} loading="lazy" decoding="async" />
      <div class="cort-velo cort-velo-d"></div>
      <span class="cort-etq cort-etq-d">Con SACS</span>
      <div class="cort-panel cort-panel-d">
        <div class="cort-pos">
          {filas.map((f) => (
            <div class="cort-fila"><b>{f.que}</b><i>{f.donde}</i><u>{f.dato}</u></div>
          ))}
        </div>
        <p class="cort-pie cort-pie-d">{pieDespues}</p>
      </div>
    </div>

    <div
      class="cort-tirador"
      id="cortTirador"
      role="slider"
      tabindex="0"
      aria-label="Comparar antes y después"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
    ></div>
  </div>
</section>

<style>
  .cort-bloque { background: #0A0A0B; padding: 96px 24px 110px; }
  .cort-head { max-width: 1200px; margin: 0 auto 40px; }
  .cort-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #60A5FA; margin: 0 0 16px;
  }
  .cort-head h2 {
    font-size: clamp(28px, 4.4vw, 50px); font-weight: 800; letter-spacing: -1.8px;
    color: #fff; margin: 0 0 14px; line-height: 1.05;
  }
  .cort-sub { color: #A1A1AA; font-size: clamp(15px, 1.7vw, 18px); margin: 0; max-width: 56ch; }

  .cort {
    position: relative; max-width: 1200px; margin: 0 auto; height: 660px;
    border-radius: 22px; overflow: hidden; border: 1px solid #23232B;
    user-select: none; touch-action: pan-y; background: #0D0D11;
  }
  .cort-capa { position: absolute; inset: 0; }
  /* La foto NO se recorta con la cortina: cada capa la trae completa y es el
     clip el que decide cuanta se ve. Asi la escena no se deforma al arrastrar. */
  .cort-capa img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cort-despues { clip-path: inset(0 0 0 50%); }

  .cort-velo { position: absolute; inset: 0; }
  /* Cada velo empuja hacia SU lado: el de "hoy" oscurece la izquierda, donde va
     la libreta; el de "con SACS" oscurece la derecha, donde va el ticket. */
  /* Velo VERTICAL en los dos lados: la cara tiene que verse, y el texto vive
     abajo. Un velo horizontal apagaba justo a la persona, que es lo que hace
     funcionar la comparacion. */
  .cort-velo-a {
    background: linear-gradient(180deg, rgba(10,9,7,.25) 0%, rgba(10,9,7,.1) 30%, rgba(10,9,7,.72) 68%, rgba(10,9,7,.94) 100%);
  }
  .cort-velo-d {
    background: linear-gradient(180deg, rgba(6,9,14,.25) 0%, rgba(6,9,14,.08) 30%, rgba(6,9,14,.7) 66%, rgba(6,9,14,.93) 100%);
  }

  .cort-etq {
    position: absolute; top: 22px; z-index: 2; font-size: 11px; letter-spacing: .16em;
    text-transform: uppercase; font-weight: 800; padding: 7px 15px; border-radius: 999px;
  }
  /* Fondo solido, no translucido: del lado "con SACS" la foto es clara y una
     pastilla transparente se perdia por completo. */
  .cort-etq-a {
    left: 24px; background: rgba(28,20,6,.86); color: #F0B84C;
    border: 1px solid rgba(232,168,56,.45); backdrop-filter: blur(6px);
  }
  .cort-etq-d {
    right: 24px; background: rgba(8,14,28,.86); color: #A8C4FA;
    border: 1px solid rgba(120,160,240,.5); backdrop-filter: blur(6px);
  }

  /* Los paneles se pegan a la orilla de su lado para que sigan visibles con la
     cortina en cualquier posicion. */
  .cort-panel { position: absolute; bottom: 7%; z-index: 2; }
  .cort-panel-a { left: 5%; max-width: 40%; }
  .cort-panel-d { right: 4%; width: min(430px, 42%); }

  .cort-libreta {
    font-family: "Bradley Hand", "Segoe Script", "Comic Sans MS", cursive;
    color: #D8C49A; font-size: clamp(15px, 1.7vw, 20px); line-height: 1.9;
    transform: rotate(-1.6deg);
    text-shadow: 0 2px 12px rgba(0,0,0,.7);
  }
  .cort-libreta s { color: #8A7857; }

  .cort-fila {
    display: flex; align-items: center; gap: 12px; background: rgba(18,24,36,.9);
    border: 1px solid #2B3A54; border-radius: 12px; padding: 12px 15px; margin-bottom: 8px;
    backdrop-filter: blur(4px);
  }
  .cort-fila b { font-size: 14.5px; font-weight: 600; color: #fff; flex: 1; }
  .cort-fila i { font-style: normal; font-size: 12.5px; color: #7A8296; }
  .cort-fila u {
    text-decoration: none; font-size: 12px; color: #04241A; background: #34D399;
    border-radius: 6px; padding: 4px 10px; font-weight: 800;
  }

  .cort-pie {
    margin: 16px 0 0; font-size: 13.5px; font-weight: 700; line-height: 1.45; letter-spacing: .01em;
    text-shadow: 0 2px 10px rgba(0,0,0,.7);
  }
  .cort-pie-a { color: #E8A838; }
  .cort-pie-d { color: #34D399; }

  .cort-tirador {
    position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; background: #fff;
    cursor: ew-resize; z-index: 4;
  }
  .cort-tirador::after {
    content: ""; position: absolute; top: 50%; left: 50%;
    width: 52px; height: 52px; margin: -26px 0 0 -26px; border-radius: 50%;
    background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,.5);
  }
  .cort-tirador::before {
    content: "⟷"; position: absolute; top: 50%; left: 50%; z-index: 1;
    transform: translate(-50%, -50%); color: #0A0A0B; font-size: 19px; font-weight: 700;
  }
  .cort-tirador:focus-visible { outline: 3px solid #60A5FA; outline-offset: 3px; }

  @media (max-width: 900px) {
    .cort-bloque { padding: 64px 18px 76px; }
    .cort { height: 560px; }
    .cort-panel-a { left: 5%; max-width: 44%; bottom: 5%; }
    .cort-panel-d { right: 4%; width: 46%; bottom: 5%; }
    .cort-fila { padding: 10px 12px; gap: 8px; }
    .cort-fila b { font-size: 12px; }
    .cort-fila i { display: none; }
    .cort-pie { font-size: 12px; }
  }

  /* En un telefono cada mitad mide ~180 px: la libreta y el ticket de tres
     renglones quedaban encimados e ilegibles, y encima tapaban las dos caras,
     que es lo unico que de verdad tiene que verse aqui. Se quedan las caras,
     las etiquetas y una frase por lado. */
  @media (max-width: 640px) {
    .cort { height: 480px; }
    .cort-libreta, .cort-pos { display: none; }
    .cort-panel { bottom: 6%; }
    .cort-panel-a { max-width: 42%; }
    .cort-panel-d { width: 42%; }
    .cort-pie { margin: 0; font-size: 12.5px; line-height: 1.4; }
    .cort-etq { top: 16px; font-size: 9.5px; padding: 6px 11px; letter-spacing: .12em; }
    .cort-etq-a { left: 14px; }
    .cort-etq-d { right: 14px; }
  }
</style>

<script>
  {
    const caja = document.getElementById('cort');
    const tir = document.getElementById('cortTirador');
    const desp = document.getElementById('cortDespues');

    if (caja && tir && desp) {
      let arrastrando = false;

      const poner = (pct: number) => {
        const p = Math.min(94, Math.max(6, pct));
        tir.style.left = p + '%';
        desp.style.clipPath = `inset(0 0 0 ${p}%)`;
        tir.setAttribute('aria-valuenow', String(Math.round(p)));
      };
      const desdeX = (x: number) => {
        const r = caja.getBoundingClientRect();
        poner(((x - r.left) / r.width) * 100);
      };

      tir.addEventListener('mousedown', (e) => { arrastrando = true; e.preventDefault(); });
      tir.addEventListener('touchstart', () => { arrastrando = true; }, { passive: true });
      window.addEventListener('mousemove', (e) => { if (arrastrando) desdeX(e.clientX); });
      window.addEventListener('touchmove', (e) => { if (arrastrando) desdeX(e.touches[0].clientX); }, { passive: true });
      window.addEventListener('mouseup', () => { arrastrando = false; });
      window.addEventListener('touchend', () => { arrastrando = false; });

      // Un clic en cualquier parte del bloque también mueve la línea: es lo que
      // la gente intenta antes de descubrir que se arrastra.
      caja.addEventListener('click', (e) => { if (e.target !== tir) desdeX((e as MouseEvent).clientX); });

      // Teclado: el bloque es un control, no una imagen.
      tir.addEventListener('keydown', (e) => {
        const actual = parseFloat(tir.style.left) || 50;
        if (e.key === 'ArrowLeft') { poner(actual - 4); e.preventDefault(); }
        if (e.key === 'ArrowRight') { poner(actual + 4); e.preventDefault(); }
      });
    }
  }
</script>
