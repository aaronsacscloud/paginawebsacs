---
/**
 * MerchPico — la hora pico del evento, en números.
 *
 * El bloque propio del merch en vivo: solo en este giro el 80% de la venta
 * pasa en unas horas y la pregunta operativa es "¿cuántos puntos de cobro necesito
 * para no dejar la fila sin cobrar?". Una tienda normal no tiene hora pico
 * que valga la nómina de la noche.
 *
 * Los siete puntos del oficio:
 * · Cuándo se decide: semanas antes, al armar los módulos de la fecha.
 * · Quién decide: producción — y lo paga si se queda corto.
 * · Qué se mueve primero: la capacidad de cobro; el inventario sobra si la
 *   fila no avanza.
 * · Cuánto cuesta: cada venta que la fila no alcanza a cobrar se va por la
 *   puerta; no hay mañana.
 * · El criterio: ritmo pico (ventas/minuto) contra 4 ventas/minuto por punto
 *   — el ritmo real medido en giras operadas con SACS.
 * · El dato que remata: el módulo que falta se paga solo la primera noche.
 * · La cuenta honesta: el supuesto editable es cuánta gente compra y a qué
 *   ticket; se enseña y se mueve, no se esconde.
 */
import BloqueProducto from '../BloqueProducto.astro';

const defaults = { asistentes: 30000, pct: 8, ticket: 850, pico: 60, enPico: 60 };
---

<BloqueProducto
  encabezado="La cuenta de la noche."
  titulo="El merch no se vende en un mes. Se vende en dos horas."
  descripcion="Mueve los números de tu fecha — asistentes, cuánta gente compra y el ticket promedio — y mira el ritmo que tu fila tiene que aguantar y cuántos puntos de cobro necesitas para cobrarla completa."
  vinetas={[
    { label: 'El ritmo manda', detail: 'Un punto de cobro con SACS hace hasta 4 ventas por minuto: escanear, cobrar, entregar. Es el ritmo medido en giras reales operadas con el sistema — y un módulo puede tener varios puntos.' },
    { label: 'La capacidad se decide antes', detail: 'Los módulos se arman semanas antes de la fecha. Esta cuenta es la que produce esa decisión — no la corazonada.' },
    { label: 'Los supuestos se mueven', detail: 'Cuánta gente compra y a qué ticket cambia por artista y por plaza. Por eso los sliders: es tu fecha, no un promedio.' },
  ]}
>
  <div class="mk" id="mk" data-def={JSON.stringify(defaults)}>
    <div class="mk-controles">
      <label>
        <span>Asistentes de la fecha</span>
        <input type="range" id="mkAsis" class="mk-rango" min="2000" max="80000" step="1000" value={defaults.asistentes} />
        <b id="mkAsisV">30,000</b>
      </label>
      <label>
        <span>Compra merch</span>
        <input type="range" id="mkPct" class="mk-rango" min="3" max="15" step="1" value={defaults.pct} />
        <b id="mkPctV">{defaults.pct}%</b>
      </label>
      <label>
        <span>Ticket promedio</span>
        <input type="range" id="mkTicket" class="mk-rango" min="300" max="2000" step="50" value={defaults.ticket} />
        <b id="mkTicketV">${defaults.ticket}</b>
      </label>
      <label>
        <span>Cae en la hora pico</span>
        <input type="range" id="mkEnPico" class="mk-rango" min="40" max="80" step="5" value={defaults.enPico} />
        <b id="mkEnPicoV">{defaults.enPico}%</b>
      </label>
      <label>
        <span>Minutos de hora pico</span>
        <input type="range" id="mkPico" class="mk-rango" min="30" max="150" step="15" value={defaults.pico} />
        <b id="mkPicoV">{defaults.pico} min</b>
      </label>
    </div>

    <div class="mk-datos">
      <div class="mk-dato">
        <span class="mk-rot">Venta de la noche</span>
        <b class="mk-n" id="mkVenta">$0</b>
        <span class="mk-sub" id="mkVentaSub"></span>
      </div>
      <div class="mk-dato mk-dato-pico">
        <span class="mk-rot">Ritmo en la hora pico</span>
        <b class="mk-n" id="mkRitmo">0/min</b>
        <span class="mk-sub">según el porcentaje del pico que pongas arriba</span>
      </div>
      <div class="mk-dato mk-dato-modulos">
        <span class="mk-rot">Puntos de cobro que necesitas</span>
        <b class="mk-n" id="mkModulos">0</b>
        <span class="mk-sub">a 4 ventas por minuto por punto — un módulo puede tener varios</span>
      </div>
    </div>

    <p class="mk-fea" id="mkFea" aria-live="polite"></p>
    <a class="mk-cta" href="/contacto?estimado=2040000&de=merch#demo" id="mkCta">Cotizar la operación de mi fecha</a>
  </div>
</BloqueProducto>

<style>
  .mk {
    background: #fff; border-radius: 16px; padding: 26px 26px 22px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 12px 32px rgba(15,23,42,.07);
  }
  .mk-controles { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 22px; margin-bottom: 22px; }
  .mk-controles label { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 10px; }
  .mk-controles span { grid-column: 1 / -1; font-size: 12px; font-weight: 700; color: var(--color-text-secondary, #4A4A4A); }
  .mk-controles b { font-size: 13px; font-weight: 800; min-width: 6ch; text-align: right; font-variant-numeric: tabular-nums; }
  .mk-rango {
    -webkit-appearance: none; appearance: none; width: 100%; height: 3px; border-radius: 2px;
    background: #E2E8F0; outline: none; cursor: pointer;
  }
  .mk-rango::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 17px; height: 17px; border-radius: 50%;
    background: #4B7BE5; border: 3px solid #fff; cursor: grab; box-shadow: 0 1px 4px rgba(15,23,42,.3);
  }
  .mk-rango::-moz-range-thumb {
    width: 17px; height: 17px; border-radius: 50%; background: #4B7BE5; border: 3px solid #fff;
    cursor: grab; box-shadow: 0 1px 4px rgba(15,23,42,.3);
  }
  .mk-rango:focus-visible { outline: 2px solid #4B7BE5; outline-offset: 4px; }

  .mk-datos { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; padding-top: 18px; border-top: 1px solid rgba(0,0,0,.07); }
  .mk-dato { border: 1px solid rgba(0,0,0,.08); border-radius: 12px; padding: 16px 18px; display: grid; gap: 4px; align-content: start; }
  .mk-dato-modulos { border-color: #4B7BE5; background: rgba(75,123,229,.04); }
  .mk-rot { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C); }
  .mk-n { font-size: 28px; font-weight: 800; line-height: 1.05; letter-spacing: -1px; color: var(--color-text-primary, #1a1a2e); font-variant-numeric: tabular-nums; }
  .mk-dato-modulos .mk-n { color: #3D6BD4; }
  .mk-sub { font-size: 11.5px; color: var(--color-text-secondary, #4A4A4A); }

  .mk-fea { margin: 16px 0 14px; font-size: 12.5px; color: var(--aviso-texto, #8C6D1F); font-weight: 600; max-width: 62ch; }
  .mk-cta {
    display: inline-block; padding: 12px 22px; background: #4B7BE5; color: #fff;
    border-radius: 9px; font-size: 14px; font-weight: 700; text-decoration: none;
    transition: background .15s ease;
  }
  .mk-cta:hover { background: #3D6BD4; }
  @media (max-width: 760px) { .mk-controles, .mk-datos { grid-template-columns: 1fr; } }
</style>

<script>
  const raiz = document.getElementById('mk');
  if (raiz) {
    const fmt = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');
    const fmtN = (n: number) => Math.round(n).toLocaleString('es-MX');
    const el = (id: string) => document.getElementById(id)!;
    function pintar() {
      const asis = Number((el('mkAsis') as HTMLInputElement).value);
      const pct = Number((el('mkPct') as HTMLInputElement).value);
      const ticket = Number((el('mkTicket') as HTMLInputElement).value);
      const pico = Number((el('mkPico') as HTMLInputElement).value);
      const enPico = Number((el('mkEnPico') as HTMLInputElement).value) / 100;
      el('mkAsisV').textContent = fmtN(asis);
      el('mkPctV').textContent = pct + '%';
      el('mkTicketV').textContent = fmt(ticket);
      el('mkPicoV').textContent = pico + ' min';
      el('mkEnPicoV').textContent = Math.round(enPico * 100) + '%';

      const trans = asis * pct / 100;
      const venta = trans * ticket;
      const ritmo = (trans * enPico) / pico;           // el % del pico lo mueve el visitante
      const modulos = Math.max(1, Math.ceil(ritmo / 4)); // 4 ventas/min por módulo

      el('mkVenta').textContent = fmt(venta);
      el('mkVentaSub').textContent = `${fmtN(trans)} ventas en la fecha`;
      el('mkRitmo').textContent = `${ritmo < 10 ? ritmo.toFixed(1) : Math.round(ritmo)}/min`;
      el('mkModulos').textContent = String(modulos);

      // La cuenta honesta: qué pasa si te falta un módulo.
      const fea = el('mkFea');
      if (modulos > 1) {
        const sinCobrar = Math.max(0, trans * enPico - (modulos - 1) * 4 * pico);
        fea.textContent = sinCobrar > 0
          ? `Con un punto de cobro menos, ~${fmtN(sinCobrar)} ventas del pico no alcanzan a cobrarse: ${fmt(sinCobrar * ticket)} que se van por la puerta.`
          : '';
      } else {
        fea.textContent = 'Una fecha chica se opera con un solo punto de cobro — el sistema es el mismo del pop-up que del estadio.';
      }

      const cta = el('mkCta') as HTMLAnchorElement;
      const u = new URL(cta.getAttribute('href')!.split('#')[0], location.origin);
      if (venta > 0) { u.searchParams.set('estimado', String(Math.round(venta))); u.searchParams.set('de', 'merch'); }
      else { u.searchParams.delete('estimado'); u.searchParams.delete('de'); }
      cta.setAttribute('href', u.pathname + u.search + '#demo');
    }
    ['mkAsis','mkPct','mkTicket','mkPico','mkEnPico'].forEach((id) => el(id).addEventListener('input', pintar));
    pintar();
  }
</script>
