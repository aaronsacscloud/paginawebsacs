---
/**
 * ActiveSet — el set que se rompe.
 *
 * El bloque propio del activewear: solo aquí el producto estrella son DOS
 * piezas que se venden juntas o sueltas — y cuando una se adelanta, la otra
 * queda viuda. La zapatería tiene la corrida; el activewear tiene el set roto.
 *
 * Los siete puntos del oficio:
 * · Cuándo se decide: al pedir el lote — ahí se fija cuántos tops y cuántos
 *   leggings de cada talla, y ya no se corrige hasta el siguiente.
 * · Quién decide: la dueña, con el drop anterior en la mano (o de memoria,
 *   que es como se rompe).
 * · Qué se mueve primero: el top — casi siempre se adelanta al legging.
 * · Cuánto cuesta: cada legging viudo es costo parado que acaba en la venta
 *   nocturna con descuento.
 * · El criterio: piezas vendidas por talla, top contra legging, del drop real.
 * · El paso a paso: ver el descase → empujar el kit → corregir el lote.
 * · El dato que remata: el descase no se ve colgado en el rack — se ve en el
 *   reporte, porque el rack siempre se ve lleno.
 * · La cuenta honesta: el dinero se cuenta a COSTO, y el viudo no se
 *   recupera entero: parte se vende suelto y parte se remata.
 */
import BloqueProducto from '../BloqueProducto.astro';

const defaults = { piezas: 60, tops: 48, leggings: 31, costo: 240 };
---

<BloqueProducto
  encabezado="El pleito de cada drop."
  titulo="El top vuela. El legging se queda viudo."
  descripcion="Un colorway casi siempre sale parejo — mismos tops que leggings — y justo así se rompe. Mueve cuántos se vendieron de cada uno, con tus números del último drop, y mira cuántas piezas quedan sin pareja y cuánto dinero es."
  vinetas={[
    { label: 'El descase no se ve en el rack', detail: 'El rack se ve lleno aunque el set esté roto. El descase se ve en el reporte por pieza y por talla — por eso existe este bloque.' },
    { label: 'El kit empuja al set', detail: 'El set con precio de set y la pieza suelta con el suyo: así la clienta se lleva el conjunto y las dos piezas caminan parejas.' },
    { label: 'La cuenta va a costo', detail: 'Lo viudo se cuenta a lo que te costó, no a etiqueta. Y no se recupera entero: parte se vende suelto y parte se remata en la venta nocturna.' },
  ]}
>
  <div class="as" id="as">
    <div class="as-controles">
      <label>
        <span>Piezas por colorway (tops = leggings)</span>
        <input type="range" id="asPiezas" class="as-rango" min="20" max="200" step="10" value={defaults.piezas} />
        <b id="asPiezasV">{defaults.piezas} y {defaults.piezas}</b>
      </label>
      <label>
        <span>Tops vendidos</span>
        <input type="range" id="asTops" class="as-rango" min="0" max="60" step="1" value={defaults.tops} />
        <b id="asTopsV">{defaults.tops}</b>
      </label>
      <label>
        <span>Leggings vendidos</span>
        <input type="range" id="asLeggings" class="as-rango" min="0" max="60" step="1" value={defaults.leggings} />
        <b id="asLeggingsV">{defaults.leggings}</b>
      </label>
      <label>
        <span>Costo promedio por pieza</span>
        <input type="range" id="asCosto" class="as-rango" min="100" max="600" step="20" value={defaults.costo} />
        <b id="asCostoV">${defaults.costo}</b>
      </label>
    </div>

    <div class="as-datos">
      <div class="as-dato">
        <span class="as-rot">Sets completos que te quedan</span>
        <b class="as-n" id="asSets">0</b>
        <span class="as-sub">pares top + legging que aún puedes vender como set</span>
      </div>
      <div class="as-dato as-dato-viudo">
        <span class="as-rot">Piezas viudas</span>
        <b class="as-n" id="asViudas">0</b>
        <span class="as-sub" id="asViudasSub"></span>
      </div>
      <div class="as-dato">
        <span class="as-rot">Dinero parado en viudas, a costo</span>
        <b class="as-n as-n-rojo" id="asDinero">$0</b>
        <span class="as-sub">no se recupera entero: parte se vende suelto y parte se remata</span>
      </div>
    </div>

    <p class="as-fea" id="asFea" aria-live="polite"></p>
    <a class="as-cta" href="/contacto?estimado=4080&de=activewear#demo" id="asCta">Ver mi descase con mis drops reales</a>
  </div>
</BloqueProducto>

<style>
  .as {
    background: #fff; border-radius: 16px; padding: 26px 26px 22px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 12px 32px rgba(15,23,42,.07);
  }
  .as-controles { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 22px; margin-bottom: 22px; }
  .as-controles label { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 10px; }
  .as-controles span { grid-column: 1 / -1; font-size: 12px; font-weight: 700; color: var(--color-text-secondary, #4A4A4A); }
  .as-controles b { font-size: 13px; font-weight: 800; min-width: 6ch; text-align: right; font-variant-numeric: tabular-nums; }
  .as-rango {
    -webkit-appearance: none; appearance: none; width: 100%; height: 3px; border-radius: 2px;
    background: #E2E8F0; outline: none; cursor: pointer;
  }
  .as-rango::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 17px; height: 17px; border-radius: 50%;
    background: #4B7BE5; border: 3px solid #fff; cursor: grab; box-shadow: 0 1px 4px rgba(15,23,42,.3);
  }
  .as-rango::-moz-range-thumb {
    width: 17px; height: 17px; border-radius: 50%; background: #4B7BE5; border: 3px solid #fff;
    cursor: grab; box-shadow: 0 1px 4px rgba(15,23,42,.3);
  }
  .as-rango:focus-visible { outline: 2px solid #4B7BE5; outline-offset: 4px; }

  .as-datos { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; padding-top: 18px; border-top: 1px solid rgba(0,0,0,.07); }
  .as-dato { border: 1px solid rgba(0,0,0,.08); border-radius: 12px; padding: 16px 18px; display: grid; gap: 4px; align-content: start; }
  .as-dato-viudo { border-color: #4B7BE5; background: rgba(75,123,229,.04); }
  .as-rot { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C); }
  .as-n { font-size: 28px; font-weight: 800; line-height: 1.05; letter-spacing: -1px; color: var(--color-text-primary, #1a1a2e); font-variant-numeric: tabular-nums; }
  .as-dato-viudo .as-n { color: #3D6BD4; }
  .as-n-rojo { color: #E54B4B; }
  .as-sub { font-size: 11.5px; color: var(--color-text-secondary, #4A4A4A); }

  .as-fea { margin: 16px 0 14px; font-size: 12.5px; color: var(--aviso-texto, #8C6D1F); font-weight: 600; max-width: 62ch; }
  .as-cta {
    display: inline-block; padding: 12px 22px; background: #4B7BE5; color: #fff;
    border-radius: 9px; font-size: 14px; font-weight: 700; text-decoration: none;
    transition: background .15s ease;
  }
  .as-cta:hover { background: #3D6BD4; }
  @media (max-width: 760px) { .as-controles, .as-datos { grid-template-columns: 1fr; } }
</style>

<script>
  const raiz = document.getElementById('as');
  if (raiz) {
    const fmt = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');
    const el = (id: string) => document.getElementById(id)!;
    function pintar() {
      const piezas = Number((el('asPiezas') as HTMLInputElement).value);
      // Los vendidos no pueden superar el lote: los sliders se recortan al lote.
      (el('asTops') as HTMLInputElement).max = String(piezas);
      (el('asLeggings') as HTMLInputElement).max = String(piezas);
      const tops = Math.min(Number((el('asTops') as HTMLInputElement).value), piezas);
      const leggings = Math.min(Number((el('asLeggings') as HTMLInputElement).value), piezas);
      const costo = Number((el('asCosto') as HTMLInputElement).value);
      el('asPiezasV').textContent = `${piezas} y ${piezas}`;
      el('asTopsV').textContent = String(tops);
      el('asLeggingsV').textContent = String(leggings);
      el('asCostoV').textContent = fmt(costo);

      const topsRestan = piezas - tops;
      const legRestan = piezas - leggings;
      const sets = Math.min(topsRestan, legRestan);
      const viudas = Math.abs(topsRestan - legRestan);
      const pieza = topsRestan > legRestan ? 'tops' : 'leggings';
      const dinero = viudas * costo;

      el('asSets').textContent = String(sets);
      el('asViudas').textContent = String(viudas);
      el('asViudasSub').textContent = viudas > 0
        ? `${pieza} sin su pareja — el rack se ve lleno, pero el set ya está roto`
        : 'el colorway camina parejo — así se ve un lote bien pedido';
      el('asDinero').textContent = fmt(dinero);

      const fea = el('asFea');
      const rapidaAgotada = topsRestan === 0 || legRestan === 0;
      fea.textContent = viudas > 0
        ? (rapidaAgotada
            ? `Del siguiente lote: pide ${viudas} ${pieza === 'tops' ? 'leggings' : 'tops'} más — la pieza rápida se agotó y dejó ${viudas} ${pieza} viudos.`
            : `Del siguiente lote: pide ${viudas} ${pieza} menos — ninguna pieza se agotó todavía, y el kit puede emparejar lo que queda.`)
        : '';

      const cta = el('asCta') as HTMLAnchorElement;
      const u = new URL(cta.getAttribute('href')!.split('#')[0], location.origin);
      // El estimado es el dinero parado en viudas; nunca estimado=0.
      if (dinero > 0) { u.searchParams.set('estimado', String(Math.round(dinero))); u.searchParams.set('de', 'activewear'); }
      else { u.searchParams.delete('estimado'); u.searchParams.delete('de'); }
      cta.setAttribute('href', u.pathname + u.search + '#demo');
    }
    ['asPiezas','asTops','asLeggings','asCosto'].forEach((id) => el(id).addEventListener('input', pintar));
    pintar();
  }
</script>
