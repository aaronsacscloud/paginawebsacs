---
/**
 * ZapNivelacion — la remesa del lunes.
 *
 * Es el bloque que hace que un dueño de cadena de calzado levante el teléfono,
 * porque es exactamente lo que lleva años haciendo en un cuaderno el lunes por
 * la mañana, contra el corte del fin de semana.
 *
 * El tablero comparativo de sucursales deja la pregunta —cuál se está
 * vaciando— y este la contesta: qué número sale de qué tienda, a cuál va, por
 * qué, y qué corrida queda cerrada después.
 *
 * Lo que hay que respetar si se toca (viene del oficio, no del diseño):
 *
 * · Se mueve el par que SOBRA, no el número que falta. Igualar existencias
 *   —que es lo que hace un sistema genérico— reparte la corrida rota entre las
 *   cuatro tiendas y deja cuatro modelos muertos en lugar de uno.
 * · Un cero en un número que esa tienda NO vende no es hueco: es limpieza. Por
 *   eso la matriz pinta en rojo solo los ceros de números con venta.
 * · La tienda que envía nunca decide qué envía: el par que sale de su piso es
 *   comisión que su gerente no va a cobrar. Por eso "Se autoriza" es un paso.
 * · El par sale del origen y queda EN TRÁNSITO; no entra al destino hasta que
 *   se recibe. Si entra antes, el destino vende algo que va en la camioneta.
 * · El dinero se cuenta contra el saldero y a costo, con el supuesto a la
 *   vista y editable — y al lado, del mismo tamaño, lo que ya no se salva.
 */

interface Props {
  datos: {
    modelo: string;
    semanas: number;
    precio: number;
    costo: number;
    flete: number;
    numeros: string[];
    tiendas: { nombre: string; venta: number[]; existencia: number[] }[];
    traspasos: { de: string; a: string; remesa: string; motivo: string; items: { n: string; pares: number }[]; nota: string }[];
    saldo: { pares: number; detalle: string };
    comprar: { pares: number; detalle: string; nota: string };
    pasos: string[];
  };
}
const { datos } = Astro.props;
const { modelo, numeros, tiendas, traspasos, saldo, comprar, pasos } = datos;

/* Cada paso con quién lo toca: sin esto la rejilla es una lista de verbos. */
const PASOS_DETALLE = [
  'El sistema arma la lista el lunes a las siete, ordenada por prioridad y agrupada por ruta.',
  'El dueño o el gerente de operaciones. La tienda que envía nunca decide qué envía: el par que sale de su piso es comisión que su gerente no va a cobrar.',
  'La tienda que envía, con lista de surtido por número y par escaneado. Sale de su inventario y queda en tránsito.',
  'Con su documento y su caja rotulada. En tránsito el par no se vende, no se aparta y no aparece en tu tienda en línea.',
  'La tienda que recibe, contra el documento y par por par. Lo que falta o llegó cambiado se marca ahí, no después.',
  'Disponible en el mostrador, en línea y en WhatsApp, con el precio de la tienda destino. Y a las cuatro semanas el sistema mide cuántos de esos pares se vendieron allá.',
];

const paresDe = (t: { items: { pares: number }[] }) => t.items.reduce((a, i) => a + i.pares, 0);
const totalMovido = traspasos.reduce((a, t) => a + paresDe(t), 0);

/* El bloque abre con la remesa ya aplicada, así que el número tiene que estar
   en el marcado: si el script no corre, decía "0 pares · $0" — la regla del
   manual rota en la pieza que más se ve. Se calcula igual que en el script. */
const meses = datos.semanas / 4;
const idxTienda = (n: string) => tiendas.findIndex((t) => t.nombre === n);
const rescatadosIniciales = traspasos.reduce((acc, t) => {
  const o = idxTienda(t.de), d = idxTienda(t.a);
  return acc + t.items.reduce((a, it) => {
    const c = numeros.indexOf(it.n);
    const sobraba = Math.max(0, tiendas[o].existencia[c] - tiendas[o].venta[c] * meses);
    const cabe = Math.max(0, tiendas[d].venta[c] * meses - tiendas[d].existencia[c]);
    return a + Math.min(it.pares, sobraba, cabe);
  }, 0);
}, 0);
const margenPrecio = datos.precio - datos.costo;
const margenSaldo = datos.precio * 0.5 - datos.costo;
const dineroInicial =
  '$' + Math.round(rescatadosIniciales * (margenPrecio - margenSaldo - datos.flete)).toLocaleString('es-MX');
const totalExistencia = tiendas.reduce((a, t) => a + t.existencia.reduce((x, y) => x + y, 0), 0);
---

<section class="nv" data-nivelacion={JSON.stringify(datos)}>
  <div class="nv-inner">

    <div class="nv-hero">
      <div class="nv-hero-txt">
        <span class="nv-eyebrow">El lunes por la mañana</span>
        <h2 class="nv-titulo">La remesa que hoy armas en un cuaderno.</h2>
        <p class="nv-desc">
          Contra el corte del fin de semana, que es cuando se rompe la corrida. Esto es
          {modelo.toLowerCase()} en tus cuatro tiendas: {totalExistencia} pares, los mismos antes
          y después. Aplica los traspasos uno por uno y mira qué corrida se cierra.
        </p>
      </div>

      <div class="nv-hero-vis">
    <!-- ── La matriz: número × tienda ── -->
    <div class="nv-matriz">
      <div class="nv-matriz-cab">
        <span class="nv-modelo">{modelo}</span>
        <span class="nv-estado" id="nvEstado">Como está hoy</span>
      </div>

      <div class="nv-tabla-envoltura">
        <table class="nv-tabla">
          <thead>
            <tr>
              <th class="nv-th-tienda"></th>
              {numeros.map((n) => <th>{n}</th>)}
              <th class="nv-th-total">Total</th>
            </tr>
          </thead>
          <tbody>
            {tiendas.map((t, fila) => (
              <tr data-tienda={t.nombre}>
                <th class="nv-th-tienda">{t.nombre}</th>
                {numeros.map((n, col) => (
                  <td class="nv-celda" data-fila={String(fila)} data-col={String(col)}>
                    <b>{t.existencia[col]}</b>
                  </td>
                ))}
                <td class="nv-total" data-total={String(fila)}>{t.existencia.reduce((a, b) => a + b, 0)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="nv-clave">
        <li><i class="hueco"></i>Hueco: cero en un número que esa tienda sí vende</li>
        <li><i class="limpio"></i>Cero en un número que ahí no sale — eso no es hueco</li>
        <li><i class="bajo"></i>Le queda menos de un mes de venta</li>
        <li><i class="mov"></i>Se movió en este paso</li>
      </ul>
    </div>

      </div>
    </div>

    <!-- ── Los traspasos, uno por uno ── -->
    <div class="nv-cuerpo">
      <div class="nv-lista">
        <p class="nv-lista-rot">
          Lo que propone el sistema · {traspasos.length} traspasos, {totalMovido} pares
          <em>en Automatiza</em>
        </p>

        {traspasos.map((t, i) => (
          <article class="nv-tr" data-tr={String(i)}>
            <div class="nv-tr-cab">
              <span class="nv-ruta"><b>{t.de}</b> → <b>{t.a}</b></span>
              <span class="nv-motivo" data-motivo={t.motivo}>{t.motivo}</span>
            </div>
            <p class="nv-remesa">{t.remesa} · {paresDe(t)} pares</p>
            <p class="nv-items">{t.items.map((it) => `${it.n} ×${it.pares}`).join('  ·  ')}</p>
            <p class="nv-nota">{t.nota}</p>
            <button type="button" class="nv-aplicar" data-aplica={String(i)} disabled={i !== 0}>
              {i === 0 ? 'Autorizar y surtir' : 'Espera su turno'}
            </button>
          </article>
        ))}

        <button type="button" class="nv-reiniciar" id="nvReiniciar" hidden>Volver a como está hoy</button>
      </div>

      <!-- ── El resultado ── -->
      <aside class="nv-resultado">
        <div class="nv-cifra">
          <p class="nv-cifra-rot">Pares que hoy no se venderían donde están</p>
          <p class="nv-cifra-n" id="nvPares">{rescatadosIniciales}</p>
          <p class="nv-cifra-pie">de {totalMovido} que propone mover</p>
        </div>

        <div class="nv-dinero">
          <p class="nv-dinero-rot">Margen que deja de irse al saldero</p>
          <p class="nv-dinero-n" id="nvDinero" aria-live="polite">{dineroInicial}</p>

          <label class="nv-supuesto">
            <span>¿A cuánto sacas tu saldo?</span>
            <select id="nvSaldo">
              <option value="0.5" selected>A la mitad de lista</option>
              <option value="0.465">A costo</option>
              <option value="0.4">Al 40% — por debajo de costo</option>
            </select>
          </label>
          <p class="nv-dinero-pie">
            Calculado con la venta por número de la tienda que recibe. Solo cuentan los pares que
            esa tienda alcanza a vender antes del rebaje, a su ritmo de hoy, y ya se descontó el
            flete.
          </p>
        </div>

        <!-- La columna fea va del mismo tamaño que la bonita, o el bloque miente -->
        <div class="nv-feo">
          <div>
            <b>Otros {saldo.pares} pares</b>
            <span>ya no tienen rescate: ninguna tienda los alcanza a vender. {saldo.detalle}. Eso es saldo, y sale ahora — no en enero.</span>
          </div>
          <div>
            <b>{comprar.pares} pares</b>
            <span>hay que comprarlos: {comprar.detalle}. {comprar.nota}</span>
          </div>
        </div>

        <a class="nv-cta" href="/contacto" id="nvCta">Ver mi remesa con mis tiendas</a>
      </aside>
    </div>

    <!-- ── De la sugerencia al piso: la rejilla de la portada ── -->
    <div class="nv-pasos">
      <p class="nv-pasos-rot">Y así llega el par a piso</p>
      <div class="nv-rejilla">
        {pasos.map((paso, i) => (
          <div class="nv-tarjeta">
            <span class="nv-tarjeta-n">{i + 1}</span>
            <h3>{paso}</h3>
            <p>{PASOS_DETALLE[i]}</p>
          </div>
        ))}
      </div>
      <p class="nv-pasos-pie">
        El par sale del origen y queda <b>en tránsito</b>: no se vende, no se aparta y no aparece
        en tu tienda en línea hasta que la otra tienda lo recibe contra el documento. Si entrara
        antes, alguien vendería un par que va en la camioneta.
        <br /><br />
        El traspaso completo —autorizar, surtir, tránsito y recepción contra documento— viene
        <b>desde el plan Controla</b>. Lo que agrega <b>Automatiza</b> es que la lista se arme
        sola cada lunes, ordenada por prioridad y con el tope de lo que cada tienda alcanza a
        vender ya calculado.
      </p>
    </div>

  </div>
</section>

<style>
  /* Mismo patrón que la sección de inventario inteligente de la portada:
     texto a la izquierda, la pieza a la derecha, y las tarjetas debajo. */
  .nv {
    background: var(--color-bg-primary, #FAFAF8);
    color: var(--color-text-primary, #1a1a2e);
    padding: clamp(72px, 9vw, 120px) 0 clamp(40px, 5vw, 64px);
  }
  .nv-inner { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

  .nv-hero {
    display: flex; flex-direction: column; gap: clamp(32px, 5vw, 56px);
    margin-bottom: clamp(44px, 6vw, 72px);
  }
  @media (min-width: 1100px) { .nv-hero { flex-direction: row; align-items: center; } }
  .nv-hero-txt { flex: 1; min-width: 0; }
  .nv-hero-vis { flex: 1.35; min-width: 0; }

  .nv-eyebrow {
    display: inline-block; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    color: var(--color-text-tertiary, #8C8C8C); margin-bottom: 16px;
  }
  .nv-titulo {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 800; line-height: 1.05;
    letter-spacing: -.04em; color: var(--color-text-primary, #1a1a2e);
    margin: 0 0 20px; max-width: 520px;
  }
  .nv-desc {
    font-size: clamp(1rem, 1.3vw, 1.125rem); line-height: 1.65;
    color: var(--color-text-secondary, #4A4A4A); max-width: 480px; margin: 0;
  }

  .nv-head { margin-bottom: clamp(40px, 5vw, 60px); }
  .nv-head h2, .nv-head .nv-sub { max-width: 760px; }
  .nv-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #4B7BE5; margin: 0 0 16px;
  }
  .nv-head h2 {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; letter-spacing: -.03em;
    line-height: 1.1; margin: 0 0 16px; color: var(--color-text-primary, #1a1a2e);
  }
  .nv-sub { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-secondary, #4A4A4A); max-width: 62ch; }

  /* ── La matriz ── */
  .nv-matriz {
    background: #fff; border-radius: var(--radius-lg); padding: 22px 24px 20px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 18px 44px rgba(15,23,42,.1);
  }
  .nv-matriz-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .nv-modelo { font-size: 14px; font-weight: 800; letter-spacing: -.2px; color: var(--color-text-primary, #1a1a2e); }
  .nv-estado { font-size: 12px; font-weight: 700; color: #4B7BE5; }

  .nv-tabla-envoltura { overflow-x: auto; }
  .nv-tabla { width: 100%; border-collapse: separate; border-spacing: 4px; min-width: 540px; }
  .nv-tabla th {
    font-size: 11px; font-weight: 800; color: var(--color-text-tertiary, #8C8C8C);
    padding-bottom: 4px; text-align: center;
  }
  .nv-th-tienda { text-align: left !important; font-size: 12px !important; color: var(--color-text-primary, #1a1a2e) !important; white-space: nowrap; padding-right: 10px; }
  .nv-th-total { color: var(--color-text-tertiary, #8C8C8C) !important; }
  .nv-celda {
    width: 36px; height: 34px; text-align: center; border-radius: 8px;
    background: var(--ok-fondo); border: 1px solid var(--ok-borde);
    transition: background .45s ease, border-color .45s ease, transform .45s ease;
  }
  .nv-celda b { font-size: 12.5px; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--ok-texto); }
  /* Cero en un número que esa tienda SÍ vende: eso es el hueco que duele. */
  .nv-celda.hueco { background: var(--alerta-fondo); border-color: var(--alerta-borde); }
  .nv-celda.hueco b { color: var(--alerta-texto); }
  /* Cero en un número que ahí no sale: no es hueco, es limpieza. */
  .nv-celda.limpio { background: #F8FAFC; border-color: #EDF1F5; }
  .nv-celda.limpio b { color: #D4D4D4; }
  .nv-celda.bajo { background: var(--aviso-fondo); border-color: var(--aviso-borde); }
  .nv-celda.bajo b { color: var(--aviso-texto); }
  .nv-celda.mov { transform: scale(1.09); box-shadow: 0 0 0 2px #4B7BE5; }
  .nv-total { text-align: center; font-size: 12.5px; font-weight: 800; color: var(--color-text-tertiary, #8C8C8C); font-variant-numeric: tabular-nums; }

  .nv-clave {
    list-style: none; margin: 16px 0 0; padding: 0; display: flex; gap: 20px; flex-wrap: wrap;
    font-size: 11.5px; color: var(--color-text-secondary, #4A4A4A); font-weight: 600;
  }
  .nv-clave i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 7px; }
  .nv-clave i.hueco { background: var(--alerta-fondo); border: 1px solid #E54B4B; }
  .nv-clave i.limpio { background: #F8FAFC; border: 1px solid #DDE3EA; }
  .nv-clave i.bajo { background: var(--aviso-fondo); border: 1px solid #E8A838; }
  .nv-clave i.mov { background: #4B7BE5; }

  /* ── Los traspasos ── */
  .nv-cuerpo { display: grid; grid-template-columns: 1.25fr 1fr; gap: 30px; align-items: start; }
  .nv-lista-rot {
    margin: 0 0 14px; font-size: 12px; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C);
  }
  .nv-lista-rot em {
    font-style: normal; margin-left: 8px; padding: 3px 9px; border-radius: 999px;
    background: var(--azul-fondo); color: var(--azul-texto); letter-spacing: .06em;
  }
  .nv-tr {
    background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: var(--radius-lg);
    padding: 18px 20px; margin-bottom: 12px; box-shadow: 0 1px 3px rgba(15,23,42,.05);
    transition: opacity .3s ease;
  }
  .nv-tr.hecho { opacity: .5; }
  .nv-tr-cab { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
  .nv-ruta { font-size: 15px; font-weight: 600; color: var(--color-text-secondary, #4A4A4A); }
  .nv-ruta b { color: var(--color-text-primary, #1a1a2e); font-weight: 800; }
  .nv-motivo {
    font-size: 10.5px; font-weight: 800; border-radius: 999px; padding: 4px 11px; white-space: nowrap;
    background: var(--azul-fondo); color: var(--azul-texto); border: 1px solid var(--azul-borde);
  }
  .nv-motivo[data-motivo="Quiebre inminente"] { background: var(--alerta-fondo); color: var(--alerta-texto); border-color: var(--alerta-borde); }
  .nv-motivo[data-motivo="Excedente muerto"] { background: var(--aviso-fondo); color: var(--aviso-texto); border-color: var(--aviso-borde); }
  .nv-remesa { margin: 0 0 10px; font-size: 12px; color: var(--color-text-tertiary, #8C8C8C); font-weight: 700; }
  .nv-items {
    margin: 0 0 10px; font-size: 14px; font-weight: 800; color: var(--color-text-primary, #1a1a2e);
    font-variant-numeric: tabular-nums; letter-spacing: -.2px;
  }
  .nv-nota { margin: 0 0 14px; font-size: 13.5px; line-height: 1.6; color: var(--color-text-secondary, #4A4A4A); max-width: 54ch; }
  .nv-aplicar {
    background: #4B7BE5; color: #fff; border: none; border-radius: var(--radius-full);
    padding: 10px 20px; font-family: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer;
    transition: transform .2s ease;
  }
  .nv-aplicar:hover { transform: scale(1.03); }
  .nv-aplicar:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .nv-tr.hecho .nv-aplicar { background: #E2E8F0; color: #8C8C8C; pointer-events: none; }
  /* Los traspasos van en orden: el segundo no se puede autorizar antes que el
     primero, porque el primero es el que le deja los pares al segundo. */
  .nv-aplicar[disabled] { background: #E2E8F0; color: var(--color-text-tertiary, #8C8C8C); cursor: default; }
  .nv-reiniciar {
    background: none; border: 1px solid rgba(0,0,0,.16); color: var(--color-text-secondary, #4A4A4A); border-radius: var(--radius-full);
    padding: 9px 18px; font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
  }

  /* ── El resultado ──
     Era un panel oscuro con cuatro colores saturados peleando: azul en los
     pares, verde en el dinero y rojo en las dos cifras de abajo, sobre negro.
     Cinco superficies en un bloque que ya era claro. Ahora es una tarjeta más,
     con el mismo blanco de las de traspaso, y el color se gasta en un solo
     lugar: la cifra de dinero, que es el remate. Todo lo demás en tinta. */
  .nv-resultado {
    background: var(--color-bg-card, #fff); border: 1px solid rgba(0,0,0,.07);
    border-radius: var(--radius-lg); padding: 26px 28px 28px;
    box-shadow: 0 1px 3px rgba(15,23,42,.05);
  }
  .nv-cifra-rot, .nv-dinero-rot {
    margin: 0 0 8px; font-size: 11.5px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C);
  }
  .nv-cifra-n {
    margin: 0; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 44px; font-weight: 800; line-height: 1; letter-spacing: -.04em;
    color: var(--color-text-primary, #1A1A1A); font-variant-numeric: tabular-nums;
  }
  .nv-cifra-pie { margin: 8px 0 24px; font-size: 12.5px; color: var(--color-text-tertiary, #8C8C8C); }

  .nv-dinero { padding-top: 22px; border-top: 1px solid rgba(0,0,0,.07); }
  /* El único color del panel. */
  .nv-dinero-n {
    margin: 0 0 18px; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 40px; font-weight: 800; line-height: 1; letter-spacing: -.04em;
    color: var(--color-primary, #4B7BE5); font-variant-numeric: tabular-nums;
  }
  .nv-supuesto { display: flex; flex-direction: column; gap: 7px; margin-bottom: 14px; }
  .nv-supuesto span { font-size: 12px; font-weight: 700; color: var(--color-text-secondary, #4A4A4A); }
  .nv-supuesto select {
    background: var(--color-bg-primary, #FAFAF8); color: var(--color-text-primary, #1A1A1A);
    border: 1px solid rgba(0,0,0,.14); border-radius: var(--radius-sm);
    padding: 10px 12px; font-family: inherit; font-size: 13.5px; font-weight: 600;
  }
  .nv-dinero-pie {
    margin: 0; font-size: 11.5px; line-height: 1.55; color: var(--color-text-tertiary, #8C8C8C);
  }

  /* La columna fea pesa lo mismo que la bonita, pero no compite por color: la
     marca es una regla al costado, no un titular rojo. */
  .nv-feo { margin-top: 24px; padding-top: 22px; border-top: 1px solid rgba(0,0,0,.07); display: grid; gap: 18px; }
  .nv-feo > div { padding-left: 14px; border-left: 2px solid var(--alerta-borde); }
  .nv-feo b {
    display: block; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 17px; font-weight: 700; letter-spacing: -.02em;
    color: var(--color-text-primary, #1A1A1A);
  }
  .nv-feo span {
    display: block; margin-top: 4px; font-size: 12.5px; line-height: 1.55;
    color: var(--color-text-secondary, #4A4A4A);
  }

  .nv-cta {
    display: block; margin-top: 26px; text-align: center;
    background: var(--color-primary, #4B7BE5); color: #fff; text-decoration: none;
    border-radius: var(--radius-full); padding: 14px 22px;
    font-size: 14.5px; font-weight: 700; transition: transform .2s ease;
  }
  .nv-cta:hover { transform: scale(1.02); text-decoration: none; }

  /* ── De la sugerencia al piso ── */
  .nv-pasos { margin-top: clamp(48px, 6vw, 72px); }
  .nv-pasos-rot {
    margin: 0 0 4px; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .nv-rejilla {
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(0,0,0,.08); margin-top: 20px;
  }
  .nv-tarjeta {
    padding: clamp(26px, 3vw, 36px) clamp(18px, 2.5vw, 28px);
    border-bottom: 1px solid rgba(0,0,0,.08); border-right: 1px solid rgba(0,0,0,.08);
  }
  .nv-tarjeta:nth-child(3n) { border-right: none; }
  .nv-tarjeta:nth-child(n+4) { border-bottom: none; }
  .nv-tarjeta-n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%; margin-bottom: 18px;
    background: var(--azul-fondo); color: var(--azul-texto); font-size: 12px; font-weight: 800;
  }
  .nv-tarjeta h3 {
    font-family: var(--font-display, 'Sora', sans-serif);
    margin: 0 0 8px; font-size: 1.0625rem; font-weight: 700; letter-spacing: -.02em;
    color: var(--color-text-primary, #1a1a2e);
  }
  .nv-tarjeta p {
    margin: 0; font-size: 0.875rem; line-height: 1.6;
    color: var(--color-text-secondary, #4A4A4A);
  }
  .nv-pasos-pie {
    margin: clamp(28px, 3vw, 40px) 0 0; font-size: 0.9375rem; line-height: 1.7;
    color: var(--color-text-secondary, #4A4A4A); max-width: 82ch;
  }
  .nv-pasos-pie b { color: var(--color-text-primary, #1a1a2e); }

  @media (max-width: 1023px) {
    .nv-rejilla { grid-template-columns: repeat(2, 1fr); }
    .nv-tarjeta:nth-child(3n) { border-right: 1px solid rgba(0,0,0,.08); }
    .nv-tarjeta:nth-child(2n) { border-right: none; }
    .nv-tarjeta:nth-child(n+4) { border-bottom: 1px solid rgba(0,0,0,.08); }
    .nv-tarjeta:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) {
    .nv-rejilla { grid-template-columns: 1fr; }
    .nv-tarjeta { border-right: none; border-bottom: 1px solid rgba(0,0,0,.08); }
    .nv-tarjeta:last-child { border-bottom: none; }
  }

  @media (max-width: 980px) {
    .nv-cuerpo { grid-template-columns: 1fr; gap: 24px; }
    .nv-matriz { padding: 18px 16px 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nv-celda, .nv-tr, .nv-aplicar, .nv-cta { transition: none; }
  }
</style>

<script>
  {
    const bloque = document.querySelector<HTMLElement>('.nv');
    if (bloque) {
      const datos = JSON.parse(bloque.dataset.nivelacion || '{}');
      const { numeros, tiendas, traspasos, precio, costo, flete, semanas } = datos;

      const idx = (nombre: string) => tiendas.findIndex((t: any) => t.nombre === nombre);
      const meses = semanas / 4;

      // Estado vivo: se parte de la existencia de hoy y cada traspaso la mueve.
      let stock: number[][] = tiendas.map((t: any) => [...t.existencia]);
      let aplicados = 0;
      let arrancoNivelada = false;

      const celda = (f: number, c: number) =>
        bloque.querySelector<HTMLElement>(`[data-fila="${f}"][data-col="${c}"]`);

      const pintar = (movidas: string[] = []) => {
        tiendas.forEach((t: any, f: number) => {
          let total = 0;
          numeros.forEach((_: string, c: number) => {
            const n = stock[f][c];
            total += n;
            const el = celda(f, c);
            if (!el) return;
            const vende = t.venta[c] > 0;
            // Un cero en un número que esa tienda no vende NO es un hueco.
            el.className = 'nv-celda'
              + (n === 0 ? (vende ? ' hueco' : ' limpio') : (vende && n <= t.venta[c] ? ' bajo' : ''))
              + (movidas.includes(`${f}-${c}`) ? ' mov' : '');
            const b = el.querySelector('b');
            if (b) b.textContent = String(n);
          });
          const elTotal = bloque.querySelector<HTMLElement>(`[data-total="${f}"]`);
          if (elTotal) elTotal.textContent = String(total);
        });
      };

      const dinero = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');

      const recalcular = () => {
        // Un par cuenta como rescatado solo si de verdad sobraba en el origen y
        // además cabe en el destino a su ritmo probado. Si el origen lo iba a
        // vender, no es rescate: es venta trasladada.
        let rescatados = 0;
        for (let k = 0; k < aplicados; k++) {
          const t = traspasos[k];
          const o = idx(t.de), d = idx(t.a);
          t.items.forEach((it: any) => {
            const c = numeros.indexOf(it.n);
            const sobraba = Math.max(0, tiendas[o].existencia[c] - tiendas[o].venta[c] * meses);
            const cabe = Math.max(0, tiendas[d].venta[c] * meses - tiendas[d].existencia[c]);
            rescatados += Math.min(it.pares, sobraba, cabe);
          });
        }

        const pct = Number((document.getElementById('nvSaldo') as HTMLSelectElement)?.value || 0.5);
        // La diferencia entre los dos caminos, no una ganancia inventada:
        // venderlo a precio contra rematarlo, menos lo que cuesta moverlo.
        const margenPrecio = precio - costo;
        const margenSaldo = precio * pct - costo;
        const total = rescatados * (margenPrecio - margenSaldo - flete);

        const elPares = document.getElementById('nvPares');
        const elDinero = document.getElementById('nvDinero');
        if (elPares) elPares.textContent = String(rescatados);
        if (elDinero) elDinero.textContent = dinero(Math.max(0, total));

        const cta = document.getElementById('nvCta') as HTMLAnchorElement | null;
        if (cta) {
          const u = new URL('/contacto', location.origin);
          // Sin remesa aplicada no hay estimado que mandar: un ?estimado=0 le
          // llega a la llamada como si el cliente no tuviera nada que ganar.
          if (total > 0) u.searchParams.set('estimado', String(Math.round(total)));
          cta.href = u.pathname + u.search;
        }
      };

      const aplicar = (i: number) => {
        if (i !== aplicados) return;
        const t = traspasos[i];
        const o = idx(t.de), d = idx(t.a);
        const movidas: string[] = [];
        t.items.forEach((it: any) => {
          const c = numeros.indexOf(it.n);
          stock[o][c] -= it.pares;
          stock[d][c] += it.pares;
          movidas.push(`${o}-${c}`, `${d}-${c}`);
        });
        aplicados++;
        bloque.querySelector(`[data-tr="${i}"]`)?.classList.add('hecho');
        const siguiente = bloque.querySelector<HTMLButtonElement>(`[data-aplica="${i + 1}"]`);
        if (siguiente) { siguiente.disabled = false; siguiente.textContent = 'Autorizar y surtir'; }
        pintar(movidas);
        recalcular();

        const estado = document.getElementById('nvEstado');
        if (estado) {
          estado.textContent = aplicados === traspasos.length
            ? 'Después de la remesa · tres corridas cerradas de cuatro'
            : `Después de ${aplicados} de ${traspasos.length} traspasos`;
        }
        const reiniciar = document.getElementById('nvReiniciar');
        if (reiniciar) reiniciar.hidden = false;

        // La marca del movimiento es un pulso, no un estado.
        if (arrancoNivelada) setTimeout(() => pintar(), 1400);
        else pintar();
      };

      bloque.querySelectorAll<HTMLElement>('[data-aplica]').forEach((b) => {
        b.addEventListener('click', () => aplicar(Number(b.dataset.aplica)));
      });

      document.getElementById('nvReiniciar')?.addEventListener('click', () => {
        stock = tiendas.map((t: any) => [...t.existencia]);
        aplicados = 0;
        bloque.querySelectorAll('.nv-tr').forEach((el) => el.classList.remove('hecho'));
        bloque.querySelectorAll<HTMLButtonElement>('[data-aplica]').forEach((b, k) => {
          b.disabled = k !== 0;
          b.textContent = k === 0 ? 'Autorizar y surtir' : 'Espera su turno';
        });
        const estado = document.getElementById('nvEstado');
        if (estado) estado.textContent = 'Como está hoy';
        const reiniciar = document.getElementById('nvReiniciar');
        if (reiniciar) reiniciar.hidden = true;
        pintar();
        recalcular();
      });

      document.getElementById('nvSaldo')?.addEventListener('change', recalcular);

      // El bloque arranca con la remesa ya aplicada: el número tiene que estar
      // ahí para quien solo pasa de largo. Quien quiera ver el antes, lo
      // desarma con "Volver a como está hoy".
      traspasos.forEach((_: any, i: number) => aplicar(i));
      arrancoNivelada = true;

      pintar();
      recalcular();
    }
  }
</script>
