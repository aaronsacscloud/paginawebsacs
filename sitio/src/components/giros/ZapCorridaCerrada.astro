---
/**
 * ZapCorridaCerrada — la docena del fabricante contra la venta real.
 *
 * El bloque propio de zapatería: solo en calzado el proveedor te obliga a
 * comprar una curva fija (1-2-3-3-2-1) que ninguna tienda vende así.
 *
 * Va dentro de `BloqueProducto`, que es el formato de las páginas de producto
 * del sitio: texto y viñetas a un lado, la pieza a otro, sobre gris claro.
 * Antes vivía en una sección negra propia y se veía como de otro sitio.
 *
 * Reglas del oficio que sostienen los números y que no hay que romper:
 * · La fila del visitante reparte UNA docena. Sin tope se pueden poner treinta
 *   y seis pares vendidos de una caja de doce y la comparación deja de decir
 *   nada: lo que se compara es la curva, no el volumen.
 * · La escala sale del máximo real. Con un tope fijo las barras se aplastan.
 * · El sobrante se APILA sobre la venta. Dibujado desde el piso, tapa la barra
 *   que debía complementar y el bloque termina diciendo lo contrario.
 * · El dinero se cuenta a COSTO. A precio de lista se infla al doble y el
 *   primer zapatero que lo vea deja de creerle a la página.
 */
import BloqueProducto from '../BloqueProducto.astro';

interface Props {
  numeros?: string[];
  /** La docena del fabricante. Debe sumar 12. */
  caja?: number[];
  /** Punto de partida de la venta del visitante, en la misma escala. */
  venta?: number[];
}
const {
  numeros = ['22½', '23', '23½', '24', '24½', '25'],
  caja = [1, 2, 3, 3, 2, 1],
  venta = [1, 2, 4, 4, 1, 0],
} = Astro.props;

const escalaInicial = Math.max(4, ...caja, ...venta);
---

<BloqueProducto
  encabezado="El pleito de cada temporada."
  titulo="La corrida cerrada contra lo que tú vendes."
  descripcion={`El fabricante arma la docena ${caja.join('-')} y te la manda igual que a todas las tiendas del país. Mueve tu venta real por número y mira cuántos pares de cada docena nacen muertos.`}
  vinetas={[
    { label: 'Tu curva, no la del proveedor', detail: 'Con tu venta por número a la mano, la pelea por surtido libre se da con datos y no de memoria.' },
    { label: 'Y sí, el surtido libre se paga', detail: 'Con sobreprecio por par o con un mínimo más alto de docenas. Por eso hay que saber cuánto te conviene pagar y en qué números pedirlo.' },
    { label: 'La cuenta va a costo', detail: 'Lo que ves es el dinero que ya pusiste y está parado, no el precio al que esperabas venderlo.' },
  ]}
>
  <div class="cc" data-caja={JSON.stringify(caja)}>

    <div class="cc-tabla">
      <ul class="cc-clave" aria-hidden="true">
        <li><i class="v"></i>Lo que vendes</li>
        <li><i class="r"></i>Lo que te sobra</li>
        <li><i class="c"></i>Lo que te mandan</li>
      </ul>

      <!-- Fila del fabricante: fija -->
      <div class="cc-fila">
        <span class="cc-rot">La docena que te mandan</span>
        <div class="cc-barras">
          {caja.map((n, i) => (
            <div class="cc-col">
              <div class="cc-wrap">
                <div class="cc-barra cc-barra-caja" id={`bc-${i}`} style={`height:${(n / escalaInicial) * 100}%`}>
                  <b>{n}</b>
                </div>
              </div>
              <span class="cc-num">{numeros[i]}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Fila del visitante: se mueve -->
      <div class="cc-fila">
        <span class="cc-rot">Tu venta real por número</span>
        <div class="cc-barras">
          {venta.map((n, i) => (
            <div class="cc-col">
              <div class="cc-wrap">
                <div class="cc-barra cc-barra-venta" id={`bv-${i}`} style={`height:${(n / escalaInicial) * 100}%`}>
                  <b id={`bt-${i}`}>{n}</b>
                </div>
                <div class="cc-sobra" id={`bs-${i}`}></div>
              </div>
              <input
                type="range" class="cc-rango" id={`cc-${i}`}
                min="0" max="6" step="1" value={n} data-i={i}
                aria-label={`Pares del número ${numeros[i]} que vendes de cada docena`}
              />
              <span class="cc-num">{numeros[i]}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="cc-pie">
      <p class="cc-dato"><b id="ccPares">0</b><span>pares de cada docena que no vas a vender</span></p>

      <div class="cc-controles">
        <label>
          <span>Docenas al año</span>
          <input type="range" id="ccDocenas" class="cc-rango cc-rango-ancho" min="10" max="600" step="10" value="180" />
          <b id="ccDocenasVal">180</b>
        </label>
        <label>
          <span>Costo del par</span>
          <input type="range" id="ccPrecio" class="cc-rango cc-rango-ancho" min="150" max="2000" step="25" value="600" />
          <b id="ccPrecioVal">$600</b>
        </label>
      </div>

      <div class="cc-dinero">
        <span class="cc-dinero-rot">Tu dinero parado, a costo</span>
        <b class="cc-dinero-n" id="ccDinero" aria-live="polite">$0</b>
        <a class="cc-cta" href="/contacto" id="ccCta">Ver mi curva real con mis ventas</a>
      </div>
    </div>

  </div>
</BloqueProducto>

<style>
  .cc {
    background: #fff; border-radius: 16px; padding: 26px 26px 22px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 12px 32px rgba(15,23,42,.07);
  }

  .cc-clave {
    list-style: none; margin: 0 0 20px; padding: 0; display: flex; gap: 18px; flex-wrap: wrap;
    font-size: 12px; font-weight: 600; color: var(--color-text-secondary, #4A4A4A);
  }
  .cc-clave i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 7px; }
  .cc-clave i.v { background: #2AB5A0; }
  .cc-clave i.r { background: repeating-linear-gradient(45deg, #E54B4B 0 3px, #F8B4B4 3px 6px); }
  .cc-clave i.c { background: #C3D2EE; }

  .cc-fila + .cc-fila { margin-top: 22px; padding-top: 20px; border-top: 1px solid rgba(0,0,0,.07); }
  .cc-rot {
    display: block; font-size: 11px; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C); margin-bottom: 14px;
  }
  .cc-barras { display: flex; gap: 10px; align-items: flex-end; }
  .cc-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 7px; }
  .cc-wrap { position: relative; width: 100%; height: 104px; display: flex; align-items: flex-end; }
  .cc-barra {
    position: relative; width: 100%; border-radius: 6px 6px 0 0; min-height: 3px;
    transition: height .3s cubic-bezier(.25,.46,.45,.94);
  }
  .cc-barra b {
    position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 5px;
    font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums;
    color: var(--color-text-primary, #1a1a2e);
  }
  .cc-barra-caja { background: #C3D2EE; }
  .cc-barra-venta { background: #2AB5A0; }
  /* El sobrante se apila ENCIMA de la venta: el script pone su `bottom`. */
  .cc-sobra {
    position: absolute; left: 0; right: 0; bottom: 0; border-radius: 6px 6px 0 0;
    background: repeating-linear-gradient(45deg, rgba(229,75,75,.55) 0 5px, rgba(229,75,75,.2) 5px 10px);
    border-top: 2px solid #E54B4B; pointer-events: none;
    transition: height .3s cubic-bezier(.25,.46,.45,.94), bottom .3s cubic-bezier(.25,.46,.45,.94);
  }
  .cc-num {
    font-size: 12px; font-weight: 700; color: var(--color-text-secondary, #4A4A4A);
    font-variant-numeric: tabular-nums;
  }

  .cc-rango {
    -webkit-appearance: none; appearance: none; width: 100%; height: 3px; border-radius: 2px;
    background: #E2E8F0; outline: none; cursor: pointer;
  }
  .cc-rango::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 18px; height: 18px; border-radius: 50%;
    background: #4B7BE5; border: 3px solid #fff; cursor: grab;
    box-shadow: 0 1px 4px rgba(15,23,42,.3);
  }
  .cc-rango::-moz-range-thumb {
    width: 18px; height: 18px; border-radius: 50%; background: #4B7BE5; border: 3px solid #fff;
    cursor: grab; box-shadow: 0 1px 4px rgba(15,23,42,.3);
  }
  .cc-rango:focus-visible { outline: 2px solid #4B7BE5; outline-offset: 4px; }

  .cc-pie { margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(0,0,0,.07); }
  .cc-dato { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin: 0 0 18px; }
  .cc-dato b {
    font-size: 38px; font-weight: 800; color: #E54B4B; line-height: 1; letter-spacing: -1.4px;
    font-variant-numeric: tabular-nums;
  }
  .cc-dato span { font-size: 14px; color: var(--color-text-secondary, #4A4A4A); font-weight: 600; }

  .cc-controles { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 20px; }
  .cc-controles label { display: grid; gap: 6px; }
  .cc-controles span {
    font-size: 12px; font-weight: 700; color: var(--color-text-secondary, #4A4A4A);
  }
  .cc-controles b {
    font-size: 15px; font-weight: 800; color: var(--color-text-primary, #1a1a2e);
    font-variant-numeric: tabular-nums;
  }

  .cc-dinero {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    background: #F8FAFC; border: 1px solid rgba(0,0,0,.06); border-radius: var(--radio-chico, 8px); padding: 16px 18px;
  }
  .cc-dinero-rot {
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    color: var(--color-text-tertiary, #8C8C8C);
  }
  .cc-dinero-n {
    font-size: 26px; font-weight: 800; color: var(--color-text-primary, #1a1a2e);
    letter-spacing: -1px; font-variant-numeric: tabular-nums; margin-right: auto;
  }
  .cc-cta {
    background: #4B7BE5; color: #fff; text-decoration: none; border-radius: var(--radio-pildora, 999px);
    padding: 11px 22px; font-size: 14px; font-weight: 700; white-space: nowrap;
    box-shadow: 0 4px 14px rgba(75,123,229,.3); transition: transform .2s ease;
  }
  .cc-cta:hover { transform: scale(1.03); text-decoration: none; }

  @media (max-width: 700px) {
    .cc { padding: 20px 18px 18px; }
    .cc-controles { grid-template-columns: 1fr; }
    .cc-wrap { height: 88px; }
    .cc-dinero-n { margin-right: 0; }
    .cc-cta { width: 100%; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-barra, .cc-sobra, .cc-cta { transition: none; }
  }
</style>

<script>
  {
    const sec = document.querySelector<HTMLElement>('.cc');
    if (sec) {
      const caja: number[] = JSON.parse(sec.dataset.caja || '[]');
      const rangos = Array.from(sec.querySelectorAll<HTMLInputElement>('.cc-rango[data-i]'));
      const docenas = document.getElementById('ccDocenas') as HTMLInputElement;
      const precio = document.getElementById('ccPrecio') as HTMLInputElement;
      const elPares = document.getElementById('ccPares');
      const elDinero = document.getElementById('ccDinero');
      const cta = document.getElementById('ccCta') as HTMLAnchorElement;

      const dinero = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');

      const pintar = () => {
        let sobran = 0;
        const valores = rangos.map((r) => Number(r.value));
        // La escala sale del valor más alto que hay en pantalla, no de un tope
        // fijo: con un tope alto las barras se aplastan contra el piso.
        const escala = Math.max(4, ...caja, ...valores);

        rangos.forEach((r) => {
          const i = Number(r.dataset.i);
          const v = Number(r.value);
          const excedente = Math.max(0, caja[i] - v);
          sobran += excedente;

          const barra = document.getElementById('bv-' + i);
          const barraCaja = document.getElementById('bc-' + i);
          const texto = document.getElementById('bt-' + i);
          const sobra = document.getElementById('bs-' + i);

          if (barraCaja) barraCaja.style.height = (caja[i] / escala) * 100 + '%';
          if (barra) barra.style.height = (v / escala) * 100 + '%';
          if (texto) texto.textContent = String(v);
          if (sobra) {
            sobra.style.height = (excedente / escala) * 100 + '%';
            sobra.style.bottom = (v / escala) * 100 + '%';
            sobra.style.display = excedente > 0 ? 'block' : 'none';
            // La etiqueta salta por encima del rayado: dentro del rojo no se lee.
            if (texto) {
              const alto = sobra.parentElement?.clientHeight || 0;
              texto.style.marginBottom = ((excedente / escala) * alto + 5) + 'px';
            }
          }
        });

        const nDoc = Number(docenas.value);
        const nPre = Number(precio.value);
        const total = sobran * nDoc * nPre;

        if (elPares) elPares.textContent = String(sobran);
        if (elDinero) elDinero.textContent = dinero(total);
        const dv = document.getElementById('ccDocenasVal');
        const pv = document.getElementById('ccPrecioVal');
        if (dv) dv.textContent = nDoc.toLocaleString('es-MX');
        if (pv) pv.textContent = '$' + nPre.toLocaleString('es-MX');

        if (cta) {
          const u = new URL(cta.getAttribute('href') || '/contacto', location.origin);
          u.searchParams.set('estimado', String(Math.round(total)));
          cta.href = u.pathname + u.search;
        }
      };

      // La fila del visitante reparte UNA docena: sin tope se pueden poner 36
      // pares vendidos de una caja de 12 y la comparación deja de decir nada.
      const TOPE = caja.reduce((a, b) => a + b, 0);
      const topar = (r: HTMLInputElement) => {
        const otros = rangos.filter((x) => x !== r).reduce((a, x) => a + Number(x.value), 0);
        if (otros + Number(r.value) > TOPE) r.value = String(Math.max(0, TOPE - otros));
      };
      rangos.forEach((r) => r.addEventListener('input', () => topar(r)));

      [...rangos, docenas, precio].forEach((r) => {
        r.addEventListener('input', pintar);
        r.addEventListener('change', pintar);
      });
      pintar();
    }
  }
</script>
