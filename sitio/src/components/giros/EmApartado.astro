---
/**
 * EmApartado — «"Te lo aparto": la pieza que se muere en el chat», el bloque propio del giro de
 * emprendedoras que venden en digital (17-sep-2026).
 *
 * Esto solo pasa aquí, y por eso no se pisa con ningún otro giro del sitio: en una tienda con
 * local, la clienta que aparta está parada enfrente, deja un anticipo y firma un papel. Aquí el
 * apartado es una frase escrita a las once de la noche, sin dinero, sin fecha y sin testigo. La
 * pieza se congela dentro de una conversación y ahí se queda hasta que alguien se acuerde. No hay
 * caja que cierre la venta: hay un chat que se queda en visto.
 *
 * Y el costo no es la venta que no se hizo. Es la venta que SÍ se iba a hacer y que ella rechazó
 * al decirle a la segunda clienta «ya está apartada». Por eso, debajo de cada pieza muerta, se
 * dibuja la clienta que se dio la vuelta.
 *
 * La cuenta la puede correr con sus propios datos: cambia el precio y el costo de la pieza en los
 * dos campos de abajo y el número deja de ser el del ejemplo.
 */
import BloqueProducto from '../BloqueProducto.astro';
---
<BloqueProducto
  encabezado="No hay caja. Hay un chat que se queda en visto."
  titulo="¿Cuánto se te quedó en el chat este mes?"
  descripcion="«Te lo aparto» son tres segundos y ninguna pantalla de por medio. La pieza se congela dentro de la conversación y ahí se queda. Mueve tus números y mira lo que de verdad cuesta, que no es la venta que no se hizo: es la que sí ibas a hacer y rechazaste."
  vinetas={[
    { label: 'El apartado con fecha, no con buena fe', detail: 'La pieza se guarda las horas que tú digas y se libera sola. Nadie tiene que acordarse, y a la que sigue en la lista le llega el aviso.' },
    { label: 'La segunda clienta no se pierde', detail: 'Mientras una piensa, la otra queda anotada. Si la primera no deposita, la pieza pasa sola a la que sí quería pagar.' },
    { label: 'Una sola existencia para todos tus canales', detail: 'La misma blusa publicada en tres lados descuenta del mismo inventario. Se acaba vender dos veces lo que tenías una vez.' },
  ]}
  suelta
>
  <div class="em" id="em-apartado">
    <div class="em-ctrl">
      <span class="em-k">De cada 10 que te dicen «apártamelo», ¿cuántas te pagan? <b id="em-p">5</b></span>
      <input type="range" id="em-pagan" min="1" max="10" step="1" value="5" aria-label="Cuántas de cada diez te pagan" />
      <span class="em-k em-k--sep">¿Cuántos días se la guardas?</span>
      <div class="em-ops" id="em-dias">
        <button type="button" data-d="1">24 horas</button>
        <button type="button" class="is-on" data-d="3">3 días</button>
        <button type="button" data-d="7">Una semana</button>
      </div>
      <ul class="em-blusas" id="em-blusas"></ul>
      <div class="em-mios">
        <label><span>Precio de tu pieza</span><input type="number" id="em-precio" value="450" min="50" step="10" /></label>
        <label><span>Lo que te cuesta</span><input type="number" id="em-costo" value="180" min="10" step="10" /></label>
      </div>
    </div>
    <div class="em-res">
      <span class="em-k">Se te quedaron en el chat</span>
      <b class="em-num" id="em-num">$4,050</b>
      <p class="em-horas" id="em-horas">y <b>4 horas y media</b> al mes contestando «¿ya depositaste?».</p>
      <p class="em-expl" id="em-expl">Por cada pieza que se muere en visto hay una clienta que sí iba a pagar y se dio la vuelta cuando le dijiste que ya estaba apartada.</p>
      <button type="button" class="em-btn" id="em-btn">¿Y si se la guardo 24 horas?</button>
      <p class="em-cierre" id="em-cierre" hidden></p>
      <a class="em-cta" href="/contacto">Quiero que se libere sola</a>
    </div>
  </div>
</BloqueProducto>

<style>
  .em { background: #fff; border: 1px solid var(--color-border, #E6E8ED); border-radius: var(--radius-xl, 20px); padding: 20px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 22px; }
  .em-k { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: 8px; }
  .em-k b { font-family: var(--font-display); font-size: 18px; letter-spacing: -0.02em; color: var(--color-text-primary); text-transform: none; }
  .em-k--sep { margin-top: 16px; }
  .em input[type=range] { width: 100%; accent-color: var(--color-text-primary, #0E0D0C); }
  .em-ops { display: flex; gap: 6px; flex-wrap: wrap; }
  .em-ops button { padding: 9px 14px; border-radius: 999px; border: 1px solid var(--color-border, #E6E8ED); background: #fff; font: inherit; font-size: 13px; font-weight: 600; color: var(--color-text-secondary); cursor: pointer; }
  .em-ops button.is-on { background: var(--color-text-primary, #0E0D0C); border-color: var(--color-text-primary, #0E0D0C); color: #fff; }
  .em-blusas { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(10, 1fr); gap: 6px; }
  .em-blusas :global(li) { position: relative; }
  .em-blusas :global(li i) { display: block; height: 42px; border-radius: 5px; background: #E2E2DE; transition: background 0.3s; }
  .em-blusas :global(li.pago i) { background: #1C7C54; }
  .em-blusas :global(li.espera i) { background: #E0B23C; }
  .em-blusas :global(li.muerta i) { background: #B42318; }
  .em-blusas :global(li em) { display: block; height: 14px; margin-top: 3px; font-style: normal; font-size: 12px; line-height: 1; text-align: center; color: #B42318; }
  .em-mios { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--color-border, #E6E8ED); }
  .em-mios label span { display: block; font-size: 11.5px; color: var(--color-text-tertiary); margin-bottom: 4px; }
  .em-mios input { width: 100%; padding: 9px 10px; border: 1px solid var(--color-border, #E6E8ED); border-radius: var(--radius-sm, 8px); font: inherit; font-size: 14px; color: var(--color-text-primary); }
  .em-res { background: var(--color-bg-primary, #F7F7F5); border-radius: var(--radius-lg, 16px); padding: 18px; display: flex; flex-direction: column; }
  .em-res .em-k { display: block; }
  .em-num { font-family: var(--font-display); font-size: clamp(40px, 5.6vw, 64px); letter-spacing: -0.04em; line-height: 1; color: var(--color-text-primary); }
  .em-horas { margin: 10px 0 0; font-size: 15px; color: var(--color-text-primary); }
  .em-expl { margin: 12px 0 0; padding-top: 12px; border-top: 1px solid #E3E3DF; font-size: 13.5px; line-height: 1.45; color: var(--color-text-secondary); }
  .em-btn { margin-top: 14px; padding: 11px 16px; border-radius: 999px; border: 1px solid var(--color-border, #E6E8ED); background: #fff; font: inherit; font-size: 13.5px; font-weight: 700; color: var(--color-text-primary); cursor: pointer; }
  .em-cierre { margin: 12px 0 0; padding: 11px 13px; border-radius: var(--radius-sm, 8px); background: #E9F5EF; color: #14603F; font-size: 14px; line-height: 1.45; }
  .em-cta { display: inline-flex; align-self: flex-start; margin-top: 14px; padding: 12px 18px; border-radius: var(--radius-sm, 8px); background: var(--color-text-primary, #0E0D0C); color: #fff; font-weight: 700; font-size: 14px; text-decoration: none; }
  @media (max-width: 767px) { .em { grid-template-columns: 1fr; padding: 14px; } .em-blusas { grid-template-columns: repeat(5, 1fr); } .em-cta { width: 100%; justify-content: center; } }
</style>

<script>
  (() => {
    const el = document.getElementById('em-apartado'); if (!el) return;
    const $ = (id: string) => document.getElementById(id)!;
    const pesos = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');
    const APARTADOS = 100; // al mes, el ejemplo de la ficha; el resto se escala con sus números
    let dias = 3;
    const pinta = () => {
      const pagan = Number(($('em-pagan') as HTMLInputElement).value);
      const precio = Math.max(50, Number(($('em-precio') as HTMLInputElement).value) || 450);
      const costo = Math.max(10, Number(($('em-costo') as HTMLInputElement).value) || 180);
      const margen = Math.max(0, precio - costo);
      // De las que no pagan, unas se caen con otra clienta detrás esperando y otras no. Mientras
      // más días la guardes, más veces le dices «ya está apartada» a alguien que sí iba a pagar.
      const mueren = 10 - pagan;
      // Cuántas de las que se murieron traían otra clienta detrás. Crece con los días: si la
      // guardas una semana, le dices «ya está apartada» a más gente. Con 5 de 10 y 3 días da las
      // 15 piezas del ejemplo de la ficha.
      const conFila = dias === 1 ? 0.25 : dias === 3 ? 0.3 : 0.38;
      const perdidas = Math.round((mueren / 10) * APARTADOS * conFila);
      $('em-p').textContent = String(pagan);
      $('em-num').textContent = pesos(perdidas * margen);
      // Cuatro recordatorios de minuto y medio por cada apartado que no cerró.
      const horas = ((mueren / 10) * APARTADOS * 4 * 1.5) / 60;
      const ent = Math.round(horas), mins = Math.round((horas % 1) * 60);
      const textoH = horas < 1 ? `${Math.round(horas * 60)} minutos`
        : Math.abs(horas - ent) < 0.1 ? (ent === 1 ? 'una hora' : `${ent} horas`)
        : `${Math.floor(horas)} ${Math.floor(horas) === 1 ? 'hora' : 'horas'} y ${mins} minutos`;
      $('em-horas').innerHTML = `y <b>${textoH}</b> al mes contestando «¿ya depositaste?».`;
      $('em-blusas').innerHTML = Array.from({ length: 10 }, (_, i) => {
        const cls = i < pagan ? 'pago' : i === pagan && pagan < 10 ? 'espera' : 'muerta';
        return `<li class="${cls}"><i></i><em>${cls === 'muerta' ? '↩' : ''}</em></li>`;
      }).join('');
      (window as any).sacsPH?.('giro_em_apartado', { pagan, dias });
      return { perdidas, margen };
    };
    $('em-dias').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      $('em-dias').querySelectorAll('button').forEach((x) => x.classList.toggle('is-on', x === b));
      dias = Number(b.dataset.d); pinta();
    });
    ['em-pagan', 'em-precio', 'em-costo'].forEach((id) => $(id).addEventListener('input', pinta));
    $('em-btn').addEventListener('click', () => {
      const antes = pinta()!;
      // Con la regla de 24 horas y un anticipo chico, la mayoría de las que sí iban a pagar pagan.
      // Con vencimiento de 24 horas y un anticipo chico, 9 de cada 10 apartados terminan pagados.
      ($('em-pagan') as HTMLInputElement).value = '9';
      $('em-dias').querySelectorAll<HTMLButtonElement>('button').forEach((x) => x.classList.toggle('is-on', x.dataset.d === '1'));
      dias = 1;
      const desp = pinta()!;
      const gana = (antes.perdidas - desp.perdidas) * antes.margen;
      const c = $('em-cierre') as HTMLElement;
      c.hidden = false;
      c.innerHTML = `<b>${pesos(gana)} más este mes.</b> ${pesos(gana * 12)} al año, sin comprar una pieza más.`;
    });
    pinta();
  })();
</script>
