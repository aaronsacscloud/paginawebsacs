---
/**
 * WsConjunto — "Arma el conjunto", el bloque propio del western (17-sep-2026, con el dictamen
 * del referee de oficio: la corrida ya la cuenta zapatería; lo que solo existe aquí es el conjunto).
 *
 * Ninguna otra tienda de moda vende en un mismo ticket cinco piezas con cinco tallas distintas
 * para la misma persona: bota por número (27, horma ancha), texana por talla (7 1/8 o "un 57"),
 * cinto por medida (36), camisa por talla (L) y pantalón por cintura y largo (34x32). La zapatería
 * vende un par; el western viste al señor completo para el baile, la boda, la graduación, el
 * jaripeo o el regreso del paisano. Si falta una pieza, el ticket se encoge o el cliente se lleva
 * el par y va a buscar la texana enfrente.
 *
 * Los siete puntos del oficio:
 * · Cuándo se decide: en los diez minutos que el cliente está calzado frente al espejo con la
 *   texana puesta; y antes, en la compra, cuando texana y cinto se surten para que casen con la bota.
 * · Quién autoriza y ejecuta: lo arma el vendedor (comisión por conjunto, no solo por par); el
 *   encargado autoriza el traspaso o el apartado de la pieza que falta; compras define la
 *   combinación por temporada.
 * · Qué se mueve primero: la bota es el ancla; la texana la venta emocional (se horma ahí mismo);
 *   cinto y hebilla, la venta de mostrador; camisa y pantalón rellenan. Las que más tumban el
 *   conjunto: texana 7 1/8 y 7 1/4, cinto 36 a 38.
 * · Cuánto cuesta: conjunto de baile $6,500 a $12,000; cada conjunto que se queda en par suelto
 *   deja $3,000 a $5,000 en la mesa. (Precios de tienda de plaza media; el sistema mide los tuyos.)
 * · Criterios: la talla del cliente en las tres matrices → existencia aquí, en otra tienda o sobre
 *   pedido → la combinación que sí se vende junta → la ocasión → cómo paga.
 * · Paso a paso: escanear el par → abrir la ficha con sus tallas → ver lo que casa y dónde hay →
 *   traspaso o apartado de lo que falta → hormado al ticket → un solo ticket → comisión por conjunto
 *   → el CRM avisa antes del Día del Padre y de diciembre.
 * · El dato honesto: piezas por ticket (par suelto = 1; conjunto = 3 a 5) y tickets de conjunto.
 *   Es un conteo, no una promesa: el sistema saca el de cada tienda y cada vendedor.
 */
import BloqueProducto from '../BloqueProducto.astro';

type Estado = 'aqui' | 'otra' | 'pedido';
interface Pieza { k: string; n: string; talla: string; p: number; estado: Estado; nota: string }
const clientes: Record<string, { rot: string; piezas: Pieza[] }> = {
  graduado: { rot: 'El graduado', piezas: [
    { k: 'bota', n: 'Bota picuda avestruz', talla: '27', p: 5900, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'texana', n: 'Texana 20X gris', talla: '7 1/8', p: 1800, estado: 'otra', nota: 'En la del Centro · llega el jueves' },
    { k: 'cinto', n: 'Cinto piteado', talla: '36', p: 2500, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'camisa', n: 'Camisa a cuadros', talla: 'L', p: 750, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'pantalon', n: 'Pantalón vaquero', talla: '34 × 32', p: 850, estado: 'otra', nota: 'En la del Mercado · llega el jueves' },
  ] },
  novio: { rot: 'El novio', piezas: [
    { k: 'bota', n: 'Bota rodeo cocodrilo', talla: '28 ancha', p: 9800, estado: 'pedido', nota: 'Sobre pedido al taller · 4 semanas' },
    { k: 'texana', n: 'Texana 100X castor plata', talla: '7 1/4', p: 6800, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'cinto', n: 'Cinto piteado fino', talla: '38', p: 3200, estado: 'otra', nota: 'En la del Centro · llega mañana' },
    { k: 'camisa', n: 'Camisa blanca', talla: 'XL', p: 890, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'pantalon', n: 'Pantalón de vestir', talla: '36 × 32', p: 1100, estado: 'aqui', nota: 'Hay aquí' },
  ] },
  paisano: { rot: 'El paisano', piezas: [
    { k: 'bota', n: 'Bota rodeo res chocolate', talla: '“un 8” = 26', p: 2200, estado: 'otra', nota: 'En la del Mercado · llega hoy' },
    { k: 'texana', n: 'Texana 6X negra', talla: '7', p: 850, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'cinto', n: 'Cinto liso con hebilla', talla: '34', p: 900, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'camisa', n: 'Camisa de manga larga', talla: 'M', p: 650, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'pantalon', n: 'Pantalón vaquero', talla: '32 × 30', p: 850, estado: 'otra', nota: 'En la del Centro · llega hoy' },
  ] },
  ganadero: { rot: 'El ganadero', piezas: [
    { k: 'bota', n: 'Bota de trabajo toro', talla: '29', p: 2600, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'texana', n: 'Sombrero de palma', talla: '58', p: 450, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'cinto', n: 'Cinto de piel gruesa', talla: '40', p: 700, estado: 'otra', nota: 'En la del Mercado · llega el jueves' },
    { k: 'camisa', n: 'Camisa de mezclilla', talla: 'XL', p: 700, estado: 'aqui', nota: 'Hay aquí' },
    { k: 'pantalon', n: 'Pantalón de trabajo', talla: '38 × 32', p: 800, estado: 'aqui', nota: 'Hay aquí' },
  ] },
};
const fmt = (n: number) => '$' + n.toLocaleString('es-MX');
---
<BloqueProducto
  encabezado="El conjunto."
  titulo="Cinco tallas en un solo ticket."
  descripcion="Solo aquí se viste al señor completo: la bota por número, la texana por talla, el cinto por medida, la camisa por talla y el pantalón por cintura y largo. Elige al cliente y mira qué hay aquí, qué hay en otra tienda y qué se va a la tienda de enfrente si no lo completas."
  vinetas={[
    { label: 'La bota es el ancla; la texana, la venta emocional', detail: 'A eso vino. La texana se horma ahí mismo y sale con “su” texana. El cinto y la hebilla se venden mientras cobras. Camisa y pantalón rellenan.' },
    { label: 'Lo que más tumba el conjunto es una talla', detail: 'La 7 1/8 y la 7 1/4 de texana y el 36 a 38 de cinto se acaban primero. Si no hay aquí, el sistema dice en qué tienda está y cuándo llega, o lo aparta.' },
    { label: 'Se mide en piezas por ticket', detail: 'Par suelto es 1. Conjunto es de 3 a 5. Una tienda que vende par por par anda en 1.3; la que completa con la existencia de las demás tiendas pasa de 2. Es un conteo, no una promesa.' },
  ]}
  suelta
>
  <div class="wc" id="ws-conjunto" data-clientes={JSON.stringify(clientes)}>
    <div class="wc-tabs" role="radiogroup" aria-label="Quién es el cliente">
      {Object.entries(clientes).map(([k, c], i) => <button type="button" class:list={['wc-tab', { 'is-on': i === 0 }]} data-c={k} aria-pressed={i === 0 ? 'true' : 'false'}>{c.rot}</button>)}
    </div>
    <div class="wc-grid">
      <ol class="wc-fichas" id="wc-fichas"></ol>
      <div class="wc-ticket">
        <span class="wc-k">Ticket</span>
        <ul id="wc-lineas"></ul>
        <div class="wc-total"><span>Total</span><b id="wc-total">$0</b></div>
        <p class="wc-piezas"><b id="wc-n">1</b> piezas en el ticket · <span id="wc-fuga"></span></p>
        <button type="button" class="wc-btn" id="wc-completar">Completar con traspaso</button>
        <p class="wc-nota" id="wc-nota"></p>
      </div>
    </div>
  </div>
</BloqueProducto>

<style>
  .wc { background: #fff; border: 1px solid var(--color-border, #E6E8ED); border-radius: 18px; padding: 20px; }
  .wc-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 16px; }
  .wc-tab { padding: 11px 12px; border-radius: 12px; border: 1px solid var(--color-border, #E6E8ED); background: #fff; font: inherit; font-weight: 700; font-size: 14px; cursor: pointer; color: var(--color-text-primary); }
  .wc-tab.is-on { background: var(--color-text-primary, #0E0D0C); border-color: var(--color-text-primary, #0E0D0C); color: #fff; }
  .wc-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 18px; }
  .wc-fichas { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .wc-fichas :global(.wc-f) { display: grid; grid-template-columns: 10px 1fr auto; gap: 12px; align-items: center; padding: 11px 14px; border-radius: 12px; border: 1px solid var(--color-border, #E6E8ED); background: #fff; transition: background 0.3s, border-color 0.3s; }
  .wc-fichas :global(.wc-f i) { width: 10px; height: 10px; border-radius: 50%; background: #BDBDB9; }
  .wc-fichas :global(.wc-f b) { display: block; font-size: 14px; color: var(--color-text-primary); }
  .wc-fichas :global(.wc-f small) { display: block; font-size: 12px; color: var(--color-text-secondary); margin-top: 2px; }
  .wc-fichas :global(.wc-f em) { font-style: normal; font-family: var(--font-display); font-size: 15px; font-variant-numeric: tabular-nums; color: var(--color-text-primary); }
  .wc-fichas :global(.wc-f.is-aqui) { background: var(--ok-fondo, #E6F7F3); border-color: transparent; } .wc-fichas :global(.wc-f.is-aqui i) { background: var(--ok-texto, #1B6B3A); }
  .wc-fichas :global(.wc-f.is-otra) { background: var(--aviso-fondo, #FDF3DF); border-color: transparent; } .wc-fichas :global(.wc-f.is-otra i) { background: #B7791F; }
  .wc-fichas :global(.wc-f.is-pedido) { background: #FBE9E4; border-color: transparent; } .wc-fichas :global(.wc-f.is-pedido i) { background: #B4432E; }
  .wc-fichas :global(.wc-f.is-pedido) em, .wc-fichas :global(.wc-f.is-otra em) { opacity: 0.45; text-decoration: line-through; }
  .wc-fichas :global(.wc-f.is-listo) { background: var(--ok-fondo, #E6F7F3); } .wc-fichas :global(.wc-f.is-listo i) { background: var(--ok-texto, #1B6B3A); } .wc-fichas :global(.wc-f.is-listo em) { opacity: 1; text-decoration: none; }
  .wc-ticket { background: var(--color-bg-primary, #F7F7F5); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; }
  .wc-k { font-size: 10.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: 8px; }
  .wc-ticket ul { list-style: none; margin: 0; padding: 0; min-height: 120px; }
  .wc-ticket :global(li) { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px dashed #E3E3DF; font-size: 13px; animation: wc-in 0.35s ease; }
  .wc-ticket :global(li b) { font-variant-numeric: tabular-nums; }
  @keyframes wc-in { from { opacity: 0; transform: translateY(4px); } }
  .wc-total { display: flex; justify-content: space-between; padding: 12px 0 4px; font-family: var(--font-display); font-size: 20px; }
  .wc-piezas { margin: 4px 0 12px; font-size: 12.5px; color: var(--color-text-secondary); }
  .wc-piezas b { font-family: var(--font-display); font-size: 16px; color: var(--color-text-primary); }
  .wc-btn { padding: 12px 16px; border: 0; border-radius: 10px; background: var(--color-text-primary, #0E0D0C); color: #fff; font: inherit; font-weight: 700; font-size: 14px; cursor: pointer; }
  .wc-btn[disabled] { opacity: 0.35; cursor: default; }
  .wc-nota { margin: 12px 0 0; font-size: 12.5px; line-height: 1.45; color: var(--color-text-secondary); }
  @media (max-width: 767px) { .wc { padding: 14px; } .wc-tabs { grid-template-columns: 1fr 1fr; } .wc-grid { grid-template-columns: 1fr; } }</style>

<script>
  (() => {
    const el = document.getElementById('ws-conjunto'); if (!el) return;
    const clientes = JSON.parse(el.dataset.clientes!); let actual = Object.keys(clientes)[0]; let completo = false;
    const fmt = (n: number) => '$' + n.toLocaleString('es-MX');
    const fichas = document.getElementById('wc-fichas')!, lineas = document.getElementById('wc-lineas')!, btn = document.getElementById('wc-completar') as HTMLButtonElement;
    const pinta = () => {
      const c = clientes[actual]; let total = 0, n = 0, fuga = 0, html = '', tk = '';
      c.piezas.forEach((p: any) => {
        const listo = p.estado === 'aqui' || (completo && p.estado === 'otra');
        html += `<li class="wc-f is-${p.estado}${listo ? ' is-listo' : ''}"><i></i><div><b>${p.n} · ${p.talla}</b><small>${completo && p.estado === 'otra' ? 'Traspaso pedido · ' + p.nota.split('·')[1].trim() : p.nota}</small></div><em>${fmt(p.p)}</em></li>`;
        if (listo) { total += p.p; n++; tk += `<li><span>${p.n} · ${p.talla}</span><b>${fmt(p.p)}</b></li>`; } else fuga += p.p;
      });
      fichas.innerHTML = html; lineas.innerHTML = tk; document.getElementById('wc-total')!.textContent = fmt(total); document.getElementById('wc-n')!.textContent = String(n); document.getElementById('wc-n')!.nextSibling!.textContent = n === 1 ? ' pieza en el ticket · ' : ' piezas en el ticket · ';
      const otras = c.piezas.filter((p: any) => p.estado === 'otra').length, pedidos = c.piezas.filter((p: any) => p.estado === 'pedido').length;
      document.getElementById('wc-fuga')!.textContent = fuga ? `${fmt(fuga)} se van a la tienda de enfrente` : 'nada se va a la tienda de enfrente';
      btn.disabled = completo || otras === 0; btn.textContent = completo ? 'Conjunto completado' : otras ? `Completar con traspaso (${otras})` : 'Nada que traspasar';
      document.getElementById('wc-nota')!.textContent = pedidos && completo ? 'El cinto ya va en traspaso con fecha. La bota de cocodrilo sigue como pedido especial al taller con 50 % de anticipo: se cobra hoy y se le avisa por WhatsApp cuando esté lista.' : pedidos ? 'La bota de cocodrilo se levanta como pedido especial al taller con 50 % de anticipo; el resto se cobra hoy y se le avisa por WhatsApp cuando esté lista.' : completo ? 'Las piezas que estaban en otra tienda ya van en traspaso con fecha. El ticket salió completo y la comisión del vendedor es por conjunto.' : 'Lo verde hay aquí. Lo amarillo está en otra tienda: si no lo pides, el cliente se lleva el par y busca lo demás enfrente.';
    };
    el.querySelectorAll<HTMLButtonElement>('.wc-tab').forEach((t) => t.addEventListener('click', () => { el.querySelectorAll('.wc-tab').forEach((x) => { x.classList.remove('is-on'); x.setAttribute('aria-pressed', 'false'); }); t.classList.add('is-on'); t.setAttribute('aria-pressed', 'true'); actual = t.dataset.c!; completo = false; pinta(); (window as any).sacsPH?.('giro_ws_conjunto', { cliente: actual }); }));
    btn.addEventListener('click', () => { completo = true; pinta(); (window as any).sacsPH?.('giro_ws_conjunto_completar', { cliente: actual }); });
    pinta();
  })();
</script>
