---
/**
 * PapLista — la lista escolar, como la arma un papá en el mostrador.
 *
 * Es el bloque propio del giro y fuera de una papelería no significa nada: la
 * unidad de trabajo aquí no es el producto, es el RENGLÓN — texto que escribió
 * el colegio, "1 cuaderno profesional cuadro chico 100 h cosido", que puede
 * surtirse con dos o tres artículos distintos.
 *
 * Y hay un candado legal que manda sobre el diseño, no una función bonita:
 * Profeco es explícita en que ninguna escuela puede exigir MARCA determinada ni
 * obligar a comprar con un proveedor. Por eso el kit tiene que ser opcional,
 * desglosable y con equivalencias — es lo que hace legal el convenio.
 *
 * El visitante hace tres cosas y ve las tres consecuencias:
 *   · elige la equivalencia de un renglón → cambia el precio
 *   · quita lo que ya tiene            → baja el precio Y sale del armado
 *   · topa con el renglón sin existencia → aparece la otra tienda
 *
 * Reglas que no hay que romper:
 * · El bloque abre con la lista COMPLETA y su precio puesto. Un contador en
 *   cero en el HTML publica "$0" si el script no corre.
 * · Lo que se quita no se surte: tiene que verse en el armado, no sólo en el
 *   precio. Ese es el argumento, no el descuento.
 * · Nunca "la lista obligatoria del colegio". Nunca una marca de tercero.
 */
export interface RenglonLista {
  /** El texto tal como lo escribió el colegio. */
  texto: string;
  /** Las equivalencias: mismo renglón, distinta marca o calidad. */
  ops: { nombre: string; detalle: string; precio: number }[];
  /** Cuál viene elegida de fábrica. */
  elegida?: number;
  /** Si no hay existencia aquí: dónde sí. */
  faltante?: { donde: string; piezas: number };
}
interface Props {
  eyebrow?: string;
  titulo?: string;
  sub?: string;
  colegio?: string;
  grado?: string;
  alumna?: string;
  renglones: RenglonLista[];
  cta?: string;
}
const {
  eyebrow = 'El bloque que sólo existe aquí',
  titulo = 'La lista, como la arma un papá.',
  sub = 'Ocho renglones tal como los escribió el colegio. Cambia la marca de uno, quita lo que ya tienes en casa y mira qué pasa con el precio, con el armado y con lo que le vas a comprar al proveedor.',
  colegio = 'Colegio del Valle',
  grado = 'Secundaria 1º',
  alumna = 'Sofía',
  renglones,
  cta = 'Ver mi lista con mis colegios',
} = Astro.props;

/* El bloque abre con la lista entera puesta: si el script no corre, lo que se
   publica tiene que ser el precio de verdad, no un cero. */
const elegidas = renglones.map((r) => r.elegida ?? 1);
const totalInicial = renglones.reduce((a, r, i) => a + r.ops[elegidas[i]].precio, 0);
const pesos = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');
---

<section class="pl2" data-total={totalInicial}>
  <div class="pl2-inner">

    <header class="pl2-head">
      <p class="pl2-eyebrow">{eyebrow}</p>
      <h2>{titulo}</h2>
      <p class="pl2-sub">{sub}</p>
    </header>

    <div class="pl2-maq">

      <!-- ── La lista ── -->
      <div class="pl2-hoja">
        <div class="pl2-hoja-cab">
          <div>
            <b>{colegio}</b>
            <span>{grado} · lista de {alumna}</span>
          </div>
          <span class="pl2-sello">Como la escribió el colegio</span>
        </div>

        <ul class="pl2-renglones">
          {renglones.map((r, i) => (
            <li class="pl2-r" data-r={i} data-precios={r.ops.map((o) => o.precio).join(',')}>
              <div class="pl2-r-cab">
                <p class="pl2-r-texto">«{r.texto}»</p>
                <button type="button" class="pl2-quitar" data-quitar={i} aria-pressed="false">
                  <span class="pl2-quitar-si">Ya la tengo</span>
                  <span class="pl2-quitar-no">Devolver a la lista</span>
                </button>
              </div>

              <div class="pl2-ops" role="group" aria-label={`Equivalencias para: ${r.texto}`}>
                {r.ops.map((o, j) => (
                  <button
                    type="button"
                    class:list={['pl2-op', { on: j === (r.elegida ?? 1) }]}
                    data-op={`${i}-${j}`}
                    data-precio={o.precio}
                  >
                    <b>{o.nombre}</b>
                    <span>{o.detalle}</span>
                    <u>{pesos(o.precio)}</u>
                  </button>
                ))}
              </div>

              {r.faltante && (
                <p class="pl2-faltante">
                  Aquí no hay. <b>{r.faltante.piezas}</b> en {r.faltante.donde} — se traspasa hoy y se entrega mañana.
                </p>
              )}
            </li>
          ))}
        </ul>

        <p class="pl2-legal">
          Las tres opciones cumplen el mismo renglón; lo único que cambia es la marca o la
          calidad. <b>Ninguna escuela puede exigir marca ni obligarte a comprar en un lugar</b> —
          por eso el kit se desglosa.
        </p>
      </div>

      <!-- ── Lo que pasa detrás ── -->
      <aside class="pl2-panel">
        <div class="pl2-total">
          <span>Se lleva</span>
          <b id="plTotal">{pesos(totalInicial)}</b>
          <em id="plAhorro">La lista completa</em>
        </div>

        <div class="pl2-efectos">
          <div class="pl2-efecto">
            <b id="plSurtir">{renglones.length}</b>
            <span>renglones por surtir</span>
            <em>Es lo que se empaca en la mesa de armado</em>
          </div>
          <div class="pl2-efecto">
            <b id="plFuera">0</b>
            <span>fuera del armado</span>
            <em>Lo que quitó no se empaca — ni se le compra al proveedor</em>
          </div>
        </div>

        <p class="pl2-nota">
          Cada cambio de aquí baja al mismo lugar: al paquete que se arma en junio y a la orden
          de compra que sale de las listas, no del histórico.
        </p>

        <a class="pl2-cta" href="/contacto" id="plCta">{cta}</a>
      </aside>
    </div>
  </div>
</section>

<style>
  .pl2 { background: var(--color-bg-secondary, #F5F3EE); padding: clamp(72px, 9vw, 112px) 0; }
  .pl2-inner { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

  .pl2-head { max-width: 760px; margin-bottom: clamp(34px, 4vw, 48px); }
  .pl2-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: var(--color-primary, #4B7BE5); margin: 0 0 16px;
  }
  .pl2-head h2 {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; letter-spacing: -.03em;
    line-height: 1.1; margin: 0 0 16px; color: var(--color-text-primary, #1a1a2e);
  }
  .pl2-sub { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-secondary, #4A4A4A); }

  .pl2-maq { display: grid; grid-template-columns: 1.45fr 1fr; gap: 22px; align-items: start; }

  /* ── La hoja ── */
  .pl2-hoja {
    background: var(--color-bg-card, #fff); border: 1px solid rgba(0,0,0,.08);
    border-radius: var(--radius-2xl, 24px); padding: 22px 24px 24px;
  }
  .pl2-hoja-cab {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 14px;
    padding-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,.09); margin-bottom: 6px;
  }
  .pl2-hoja-cab b {
    display: block; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 16px; font-weight: 700; letter-spacing: -.02em; color: var(--color-text-primary, #1a1a2e);
  }
  .pl2-hoja-cab span { font-size: 12.5px; color: var(--color-text-tertiary, #8C8C8C); font-weight: 600; }
  .pl2-sello {
    flex: none; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: var(--color-text-tertiary, #8C8C8C); border: 1px dashed rgba(0,0,0,.2);
    border-radius: var(--radius-full, 50px); padding: 5px 11px;
  }

  .pl2-renglones { list-style: none; margin: 0; padding: 0; }
  .pl2-r { padding: 16px 0; border-bottom: 1px solid rgba(0,0,0,.06); transition: opacity .25s ease; }
  .pl2-r:last-of-type { border-bottom: none; }
  .pl2-r.fuera { opacity: .45; }
  .pl2-r.fuera .pl2-r-texto { text-decoration: line-through; }
  .pl2-r.fuera .pl2-ops { display: none; }
  .pl2-r.fuera .pl2-faltante { display: none; }

  .pl2-r-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .pl2-r-texto {
    margin: 0 0 10px; font-size: 0.9375rem; line-height: 1.5;
    color: var(--color-text-primary, #1a1a2e); font-weight: 600;
  }
  .pl2-quitar {
    flex: none; background: none; border: none; cursor: pointer; font: inherit;
    font-size: 11.5px; font-weight: 700; color: var(--color-text-tertiary, #8C8C8C);
    padding: 2px 0; border-bottom: 1px solid rgba(0,0,0,.18);
  }
  .pl2-quitar:hover { color: var(--color-text-primary, #1a1a2e); }
  .pl2-quitar:focus-visible { outline: 2px solid var(--color-primary, #4B7BE5); outline-offset: 3px; }
  .pl2-quitar .pl2-quitar-no { display: none; }
  .pl2-r.fuera .pl2-quitar .pl2-quitar-si { display: none; }
  .pl2-r.fuera .pl2-quitar .pl2-quitar-no { display: inline; }

  .pl2-ops { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .pl2-op {
    display: block; text-align: left; cursor: pointer; font: inherit;
    background: var(--color-bg-primary, #FAFAF8); border: 1.5px solid rgba(0,0,0,.08);
    border-radius: var(--radius-lg, 16px); padding: 10px 12px;
    transition: border-color .2s ease, background .2s ease;
  }
  .pl2-op:hover { border-color: rgba(75,123,229,.45); }
  .pl2-op.on { border-color: var(--color-primary, #4B7BE5); background: var(--azul-fondo); }
  .pl2-op:focus-visible { outline: 2px solid var(--color-primary, #4B7BE5); outline-offset: 2px; }
  .pl2-op b {
    display: block; font-size: 12px; font-weight: 800; letter-spacing: .04em;
    text-transform: uppercase; color: var(--color-text-tertiary, #8C8C8C); margin-bottom: 3px;
  }
  .pl2-op.on b { color: var(--azul-texto); }
  .pl2-op span { display: block; font-size: 12px; color: var(--color-text-secondary, #4A4A4A); line-height: 1.4; }
  .pl2-op u {
    display: block; margin-top: 6px; text-decoration: none; font-size: 14px; font-weight: 800;
    color: var(--color-text-primary, #1a1a2e); font-variant-numeric: tabular-nums;
  }

  .pl2-faltante {
    margin: 10px 0 0; font-size: 12.5px; color: var(--alerta-texto);
    background: var(--alerta-fondo); border: 1px solid var(--alerta-borde);
    border-radius: var(--radius-md, 12px); padding: 8px 11px;
  }
  .pl2-faltante b { font-variant-numeric: tabular-nums; }

  .pl2-legal {
    margin: 18px 0 0; padding-top: 16px; border-top: 1px dashed rgba(0,0,0,.14);
    font-size: 12.5px; line-height: 1.6; color: var(--color-text-tertiary, #8C8C8C);
  }
  .pl2-legal b { color: var(--color-text-secondary, #4A4A4A); }

  /* ── El panel ── */
  .pl2-panel { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 14px; }
  .pl2-total {
    background: var(--color-bg-dark, #1A1A1A); color: #fff;
    border-radius: var(--radius-2xl, 24px); padding: 24px 26px;
  }
  .pl2-total span {
    display: block; font-size: 11.5px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: #A1A1AA; margin-bottom: 8px;
  }
  .pl2-total b {
    display: block; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; letter-spacing: -.03em;
    line-height: 1; font-variant-numeric: tabular-nums;
  }
  .pl2-total em {
    display: block; margin-top: 10px; font-style: normal; font-size: 12.5px;
    font-weight: 600; color: #A1A1AA;
  }

  .pl2-efectos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pl2-efecto {
    background: var(--color-bg-card, #fff); border: 1px solid rgba(0,0,0,.08);
    border-radius: var(--radius-lg, 16px); padding: 16px 18px;
  }
  .pl2-efecto b {
    display: block; font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 26px; font-weight: 800; letter-spacing: -.02em; line-height: 1;
    color: var(--color-text-primary, #1a1a2e); font-variant-numeric: tabular-nums;
  }
  .pl2-efecto span {
    display: block; margin-top: 5px; font-size: 12.5px; font-weight: 700;
    color: var(--color-text-primary, #1a1a2e);
  }
  .pl2-efecto em {
    display: block; margin-top: 6px; font-style: normal; font-size: 11.5px; line-height: 1.45;
    color: var(--color-text-tertiary, #8C8C8C);
  }

  .pl2-nota { margin: 0; font-size: 12.5px; line-height: 1.6; color: var(--color-text-tertiary, #8C8C8C); }

  .pl2-cta {
    display: inline-block; text-align: center; background: var(--color-primary, #4B7BE5);
    color: #fff; text-decoration: none; font-weight: 700; font-size: 15px;
    padding: 15px 28px; border-radius: var(--radius-full, 50px);
    transition: transform .2s ease;
  }
  .pl2-cta:hover { transform: scale(1.02); }

  @media (max-width: 980px) {
    .pl2-maq { grid-template-columns: 1fr; }
    .pl2-panel { position: static; }
    .pl2-ops { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pl2-r, .pl2-op, .pl2-cta { transition: none; }
  }
</style>

<script>
  {
    const bloque = document.querySelector<HTMLElement>('.pl2');
    if (bloque) {
      const renglones = Array.from(bloque.querySelectorAll<HTMLElement>('.pl2-r'));
      const elTotal = document.getElementById('plTotal');
      const elAhorro = document.getElementById('plAhorro');
      const elSurtir = document.getElementById('plSurtir');
      const elFuera = document.getElementById('plFuera');
      const cta = document.getElementById('plCta') as HTMLAnchorElement | null;
      const completo = Number(bloque.dataset.total) || 0;
      const pesos = (n: number) => '$' + Math.round(n).toLocaleString('es-MX');

      const pintar = () => {
        let total = 0;
        let fuera = 0;
        renglones.forEach((r) => {
          if (r.classList.contains('fuera')) { fuera++; return; }
          const on = r.querySelector<HTMLElement>('.pl2-op.on');
          total += Number(on?.dataset.precio) || 0;
        });
        if (elTotal) elTotal.textContent = pesos(total);
        if (elSurtir) elSurtir.textContent = String(renglones.length - fuera);
        if (elFuera) elFuera.textContent = String(fuera);
        if (elAhorro) {
          const dif = completo - total;
          elAhorro.textContent = dif === 0
            ? 'La lista completa'
            : dif > 0
              ? `${pesos(dif)} menos que la lista completa`
              : `${pesos(-dif)} más que la lista completa`;
        }
        // Lo que se lleva es lo que se cotiza en la llamada, no el kit de lista.
        if (cta) {
          const u = new URL(cta.href, location.origin);
          u.searchParams.set('estimado', String(Math.round(total)));
          u.searchParams.set('de', 'lista');
          cta.href = u.pathname + u.search;
        }
      };

      bloque.querySelectorAll<HTMLElement>('[data-op]').forEach((b) => {
        b.addEventListener('click', () => {
          const fila = b.closest('.pl2-r');
          fila?.querySelectorAll('.pl2-op').forEach((o) => o.classList.remove('on'));
          b.classList.add('on');
          pintar();
        });
      });

      bloque.querySelectorAll<HTMLElement>('[data-quitar]').forEach((b) => {
        b.addEventListener('click', () => {
          const fila = b.closest('.pl2-r');
          if (!fila) return;
          const fuera = fila.classList.toggle('fuera');
          b.setAttribute('aria-pressed', String(fuera));
          pintar();
        });
      });

      pintar();
    }
  }
</script>
