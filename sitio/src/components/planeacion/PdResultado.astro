---
/**
 * Acto 4 · Resultado de la temporada y lo que aprendió (lunes 2 de agosto de 2027). v3 «color» (2-oct-2026): marino
 * con líneas de neón, como el paso «Automatiza» del home; seis indicadores con solo su número y la comparación que
 * importa (sin explicación por indicador), dos aciertos, dos errores (sin esconderlos) y lo que aprendió con la
 * exactitud del pronóstico, que se aplica con tu visto bueno; y el ciclo que vuelve a empezar. Todo esto está EN
 * CONSTRUCCIÓN en el motor: se muestra como ejemplo, sin fecha (asterisco en el encabezado y nota al pie).
 * Lo reproduce src/scripts/planeacion/consola.ts.
 */
import { RESULTADO, OBRA_NOTA } from '../../data/planeacion-demo';

const PALABRA = Array.from({ length: 3 }, () => 'RESULTADO').join(' · ');
---
<section class="pda res pd-marino" id="pd-resultado" data-acto="resultado" aria-labelledby="pd-resultado-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <header class="pda-cab">
    <p class="pda-k">04 · Resultado<span class="pd-ast"><span aria-hidden="true">*</span><span class="sr-only"> (en construcción)</span></span></p>
    <h2 class="pda-h" id="pd-resultado-h">La temporada, en números.</h2>
    <p class="pda-fecha">Lunes 2 de agosto de 2027 · ejemplo</p>
  </header>

  <ul class="res-kpis" data-paso="0">
    {RESULTADO.kpis.map((k, i) => (
      <li class:list={[{ 'is-meta': k.meta }]} style={`--i:${i}`}>
        <p class="res-k">{k.k}</p>
        <p class="res-v" data-kpi={k.v}>{k.v}</p>
        {k.s && <p class="res-s">{k.s}</p>}
      </li>
    ))}
  </ul>

  <div class="res-tres">
    <section class="res-c res-c--ok" data-paso="1" aria-labelledby="res-ok-h">
      <h3 class="res-h3" id="res-ok-h">Aciertos</h3>
      <ul>{RESULTADO.aciertos.map((a) => <li>{a}</li>)}</ul>
    </section>
    <section class="res-c res-c--mal" data-paso="2" aria-labelledby="res-mal-h">
      <h3 class="res-h3" id="res-mal-h">Errores</h3>
      <ul>{RESULTADO.errores.map((e) => <li>{e}</li>)}</ul>
    </section>
    <section class="res-c res-c--aprende pd-hoja" data-paso="3" aria-labelledby="res-ap-h">
      <h3 class="res-h3" id="res-ap-h">Lo que Sacs aprendió</h3>
      <p class="res-exact"><b data-kpi={RESULTADO.exactitud.v}>{RESULTADO.exactitud.v}</b><span>{RESULTADO.exactitud.s}</span></p>
      <ul>{RESULTADO.aprendio.map((a) => <li>{a}</li>)}</ul>
      <button type="button" class="res-btn" data-aplicar>{RESULTADO.boton}</button>
      <p class="res-nota">{RESULTADO.nota}</p>
      <p class="res-hecho" data-aplicar-hecho><span class="res-hecho-pre">Al aplicarlo: </span>{RESULTADO.hecho}</p>
    </section>
  </div>

  <figure class="res-ciclo" data-paso="4">
    <ol aria-label="El ciclo de cada temporada">
      {RESULTADO.ciclo.map((c, i) => <li style={`--i:${i}`}>{c}</li>)}
    </ol>
    <figcaption>{RESULTADO.cicloFin}</figcaption>
  </figure>

  <p class="pda-nota"><span aria-hidden="true">*</span> {OBRA_NOTA}</p>
</section>

<style>
  .res-kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin: 56px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--pd-linea); }
  .res-kpis li { display: grid; align-content: start; gap: 6px; padding: 24px 14px 26px 0; border-bottom: 1px solid var(--pd-linea); min-width: 0; }
  .res-kpis li:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--pd-linea); }
  .res-kpis p { margin: 0; }
  .res-k { font: 500 13.5px/1.3 var(--font-body); color: var(--pd-tenue); }
  .res-v { font: 700 clamp(40px, 5vw, 72px)/0.95 var(--pd-clash); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: #fff; }
  .res-s { font: 600 13px/1.3 var(--font-display); color: var(--pd-tenue); }
  .res-kpis li.is-meta .res-s { color: var(--pd-ok-t); }

  .res-h3 { margin: 0 0 14px; font: 700 16px/1.3 var(--font-display); letter-spacing: -0.01em; color: var(--pd-texto); }
  .res-tres { display: grid; gap: 20px; margin-top: 48px; }
  .res-c { padding: 24px; border-radius: var(--pd-radio); background: var(--pd-tarjeta); }
  .res-c ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .res-c li { position: relative; padding-left: 24px; font: 400 15px/1.5 var(--font-body); color: var(--pd-texto); }
  .res-c--ok li::before { content: '✓'; position: absolute; left: 0; top: 0; font-weight: 700; color: #6FD3A3; }
  .res-c--mal li::before { content: '✕'; position: absolute; left: 0; top: 0; font-weight: 700; color: #FF9BB8; }
  .res-c--aprende { background: #fff; }
  .res-c--aprende li::before { content: '→'; position: absolute; left: 0; top: 0; font-weight: 700; color: #2F55C4; }
  .res-exact { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 18px; }
  .res-exact b { font: 700 clamp(52px, 5vw, 68px)/0.9 var(--pd-clash); letter-spacing: -0.01em; color: #0A1648; font-variant-numeric: tabular-nums; }
  .res-exact span { font: 600 14px/1.3 var(--font-display); color: #1A1A1A; }
  .res-nota { margin: 10px 0 0; font: 400 13.5px/1.5 var(--font-body); color: #4A4A4A; }
  .res-btn { width: 100%; min-height: 52px; margin-top: 18px; padding: 12px 20px; border: 0; border-radius: 99px; background: #0A1648; color: #fff; font: 700 15.5px/1 var(--font-display); cursor: pointer; transition: transform 0.2s; }
  .res-btn:hover { transform: translateY(-1px); }
  .res-btn:focus-visible { outline: 2px solid var(--pd-azul); outline-offset: 3px; }
  .res-btn[disabled] { cursor: default; background: #E2E2DE; color: #1A1A1A; }
  .res-hecho { margin: 10px 0 0; font: 400 13.5px/1.45 var(--font-body); color: #6E6E6D; }
  :global(.pd-js) .res-hecho { display: none; }
  :global(.pd-js) .res.is-aplicado .res-hecho { display: block; padding: 12px 14px; border-radius: 12px; border-left: 3px solid var(--pd-ok); background: #F5F5F3; color: #1A1A1A; font-weight: 600; }
  :global(.pd-js) .res-hecho-pre { display: none; }

  .res-ciclo { margin: 72px 0 0; text-align: center; }
  .res-ciclo ol { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 4px; margin: 0; padding: 0; list-style: none; }
  .res-ciclo li { display: inline-flex; align-items: center; gap: 4px; font: 600 15px/1.3 var(--font-display); color: var(--pd-tenue); }
  .res-ciclo li:not(:last-child)::after { content: '→'; margin: 0 6px; color: var(--pd-apagado); }
  .res-ciclo li:last-child { color: #fff; }
  .res-ciclo figcaption { margin: 18px auto 0; max-width: 16ch; font: 700 clamp(36px, 5vw, 72px)/0.95 var(--pd-clash); letter-spacing: -0.01em; color: #fff; text-wrap: balance; }
  .res .pda-nota { text-align: center; }

  /* ── Con JS: cada bloque entra en su momento ── */
  .res.is-js [data-paso]:not(.is-on) { opacity: 0; transform: translateY(10px); }
  .res.is-js [data-paso] { transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .res.is-js .res-kpis li { opacity: 0; transform: translateY(8px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.12s); }
  .res.is-js .res-kpis.is-on li { opacity: 1; transform: none; }
  .res.is-js .res-kpis:not(.is-on) { opacity: 1; transform: none; }
  .res.is-js .res-ciclo li { opacity: 0.35; transition: opacity 0.4s ease; transition-delay: calc(var(--i) * 0.35s); }
  .res.is-js .res-ciclo.is-on li { opacity: 1; }

  @media (min-width: 768px) {
    .res-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .res-kpis li, .res-kpis li:nth-child(even) { padding: 28px 20px 30px 0; border-left: 0; }
    .res-kpis li:not(:nth-child(3n + 1)) { padding-left: 22px; border-left: 1px solid var(--pd-linea); }
  }
  @media (min-width: 1024px) {
    .res-tres { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .res * { animation: none !important; transition: none !important; }
  }
</style>
