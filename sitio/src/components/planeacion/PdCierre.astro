---
/**
 * Acto 3 · Después del evento: rebajas y lo que quedó (21 jun – 1 ago 2027). v3 «color» (2-oct-2026): fucsia, como el
 * paso «Fideliza» del home. La escalera de rebajas va en grande sobre el color, bajando como escalones (−20 %, −40 %
 * a los 30 días, outlet); los protegidos con candado, en una línea; «lo que quedó» y la vida de un modelo, directo
 * sobre el fucsia con su folio (v3.1 «editorial»: sin tarjetas); y «Armar la rebaja» (Sacs arma la lista y las etiquetas; el precio lo confirmas tú).
 * «Consolidar» salió de la pantalla en el v3 (su plan automático sigue en construcción). Lo reproduce
 * src/scripts/planeacion/consola.ts.
 */
import { CIERRE, OBRA_NOTA } from '../../data/planeacion-demo';
import { miles } from '../../lib/planeacion-graficas';

const q = CIERRE.quedo;
const PALABRA = Array.from({ length: 4 }, () => 'REBAJAS').join(' · ');
---
<section class="pda cie pd-fucsia" id="pd-cierre" data-acto="cierre" aria-labelledby="pd-cierre-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <header class="pda-cab">
    <p class="pda-k">03 · Cierre</p>
    <h2 class="pda-h" id="pd-cierre-h">Ahora, las rebajas.</h2>
    <p class="pda-fecha">Del 21 de junio al 1 de agosto · ejemplo</p>
  </header>

  <ol class="cie-escalera" data-paso="0" aria-label="La escalera de rebajas, que Sacs arma sola">
    {CIERRE.escalones.map((e, k) => (
      <li style={`--k:${k}`}><b>{e.pct}</b><em>{e.f}</em><span>{e.t}</span></li>
    ))}
  </ol>

  <p class="cie-candado" data-paso="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{CIERRE.candado}</p>

  <div class="cie-grid">
    <section class="cie-b cie-quedo" data-paso="2" aria-labelledby="cie-quedo-h">
      <h3 class="cie-k pd-folio" id="cie-quedo-h"><span>Lo que quedó<span class="pd-ast"><span aria-hidden="true">*</span><span class="sr-only"> (en construcción)</span></span></span><span>{q.pct} de lo que llegó</span></h3>
      <p class="cie-gran"><b data-cuenta={q.total}>{miles(q.total)}</b><span>piezas</span></p>
      <div class="cie-split" aria-hidden="true">
        <span class="is-b" style={`--w:${((q.basicos / q.total) * 100).toFixed(1)}%`}></span>
        <span class="is-o" style={`--w:${((q.outlet / q.total) * 100).toFixed(1)}%`}></span>
      </div>
      <p class="cie-split-l"><span><b>{miles(q.basicos)}</b>básicos que pasan a la siguiente temporada</span><span><b>{miles(q.outlet)}</b>al outlet</span></p>
    </section>

    <section class="cie-b cie-bio" data-paso="3" aria-labelledby="cie-bio-h">
      <h3 class="cie-k pd-folio" id="cie-bio-h"><span>La vida de un modelo</span><span>{CIERRE.bio.modelo}</span></h3>
      <div class="cie-bio-cab">
        <img src={`/images/planeacion/prod/${CIERRE.bio.foto}.webp`} width="480" height="480" alt={CIERRE.bio.modelo} loading="lazy" decoding="async" />
        <p><span>Dejó</span><b>{CIERRE.bio.margen}</b></p>
      </div>
      <ol class="cie-vida">
        {CIERRE.bio.hitos.map((h, k) => <li style={`--k:${k}`}><i aria-hidden="true"></i><b>{h.t}</b><span>{h.f}</span></li>)}
      </ol>
    </section>
  </div>

  <div class="cie-accion" data-paso="4">
    <button type="button" class="cie-btn" data-rebaja>{CIERRE.boton}</button>
    <p class="cie-nota">{CIERRE.nota}</p>
    <p class="cie-hecho" data-rebaja-hecho><span class="cie-hecho-pre">Al armarla: </span>{CIERRE.hecho}</p>
  </div>

  <p class="pda-nota"><span aria-hidden="true">*</span> {OBRA_NOTA}</p>

  <a class="pda-sigue" href="#pd-resultado">Sigue: el resultado de la temporada
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<style>
  /* la escalera de rebajas: grande, en blanco sobre el fucsia; en escritorio baja como escalones (la escalera del
     home, al revés: aquí lo que baja es el precio) */
  .cie-escalera { display: grid; gap: 0; margin: 56px auto 0; padding: 0; list-style: none; }
  .cie-escalera li { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr); grid-template-areas: 'pct f' 'pct t'; align-items: center; column-gap: 20px; padding: 18px 0; border-top: 2px solid #fff; }
  .cie-escalera b { grid-area: pct; font: 700 clamp(56px, 13vw, 76px)/0.9 var(--pd-clash); letter-spacing: -0.02em; color: #fff; white-space: nowrap; }
  .cie-escalera em { grid-area: f; align-self: end; font: 700 15px/1.3 var(--font-display); font-style: normal; color: #fff; }
  .cie-escalera span { grid-area: t; align-self: start; font: 500 15px/1.45 var(--font-body); color: #fff; }

  .cie-candado { display: flex; align-items: center; gap: 12px; margin-top: 28px; font: 600 16px/1.45 var(--font-display); color: #fff; }
  .cie-candado svg { flex-shrink: 0; width: 20px; height: 20px; max-width: none; }

  /* v3.1 «editorial»: lo que quedó y la vida de un modelo, directo sobre el fucsia (sin tarjetas) */
  .cie-grid { display: grid; gap: 48px; margin-top: 64px; }
  .cie-b { margin: 0; padding: 0; min-width: 0; }
  .cie-k { margin: 0 0 20px; }

  .cie-gran { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin: 0; }
  .cie-gran b { font: 700 clamp(64px, 8vw, 120px)/0.88 var(--pd-clash); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: #fff; }
  .cie-gran span { font: 600 18px/1.3 var(--font-display); color: #fff; }
  .cie-split { display: flex; height: 10px; margin-top: 24px; background: rgba(255, 255, 255, 0.25); overflow: hidden; }
  .cie-split span { display: block; width: var(--w); height: 100%; }
  .cie-split .is-b { background: #fff; }
  .cie-split .is-o { background: rgba(255, 255, 255, 0.45); }
  .cie-split-l { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 14px 0 0; font: 500 14px/1.4 var(--font-body); color: #fff; }
  .cie-split-l span + span { padding-left: 16px; border-left: 1px solid var(--pd-filete); }
  .cie-split-l b { display: block; margin-bottom: 4px; font: 700 26px/1 var(--pd-clash); color: #fff; font-variant-numeric: tabular-nums; }

  .cie-bio-cab { display: flex; align-items: center; gap: 18px; }
  .cie-bio-cab img { width: 76px; height: 76px; border-radius: 3px; background: #fff; object-fit: contain; padding: 4px; }
  .cie-bio-cab p { display: grid; gap: 4px; margin: 0; }
  .cie-bio-cab span { font: 600 11px/1.2 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #fff; }
  .cie-bio-cab b { font: 700 clamp(30px, 3.2vw, 44px)/1 var(--pd-clash); color: #fff; }
  .cie-vida { position: relative; display: grid; gap: 0; margin: 24px 0 0; padding: 0 0 0 22px; list-style: none; }
  .cie-vida::before { content: ''; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: rgba(255, 255, 255, 0.5); }
  .cie-vida li { position: relative; display: grid; gap: 2px; padding: 6px 0; }
  .cie-vida li i { position: absolute; left: -22px; top: 10px; width: 12px; height: 12px; border-radius: 50%; background: #D03A70; box-shadow: inset 0 0 0 2px #fff; }
  .cie-vida li:last-child i { background: #fff; }
  .cie-vida li b { font: 600 14.5px/1.3 var(--font-display); color: #fff; }
  .cie-vida li span { font: 400 13px/1.3 var(--font-body); color: #fff; }

  .cie-accion { display: grid; gap: 10px; margin-top: 28px; }
  .cie-btn { width: 100%; min-height: 54px; padding: 12px 22px; border: 0; border-radius: 99px; background: var(--pd-boton); color: var(--pd-boton-t); font: 700 16px/1 var(--font-display); cursor: pointer; transition: transform 0.2s; }
  .cie-btn:hover { transform: translateY(-1px); }
  .cie-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .cie-btn[disabled] { cursor: default; background: rgba(255, 255, 255, 0.2); color: #fff; }
  .cie-nota { margin: 0; font: 500 14px/1.5 var(--font-body); color: #fff; }
  .cie-hecho { margin: 0; font: 400 14px/1.45 var(--font-body); color: #fff; }
  :global(.pd-js) .cie-hecho { display: none; }
  :global(.pd-js) .cie.is-rebaja .cie-hecho { display: block; padding: 12px 14px; border-radius: 12px; border-left: 3px solid #fff; background: var(--pd-tarjeta); font-weight: 600; }
  :global(.pd-js) .cie-hecho-pre { display: none; }

  /* ── Con JS: cada bloque entra en su momento ── */
  .cie.is-js [data-paso]:not(.is-on) { opacity: 0; transform: translateY(10px); }
  .cie.is-js [data-paso] { transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .cie.is-js .cie-escalera:not(.is-on) { opacity: 1; transform: none; }
  .cie.is-js .cie-escalera li { opacity: 0; transform: translateY(-12px); transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(0.2s + var(--k) * 0.45s); }
  .cie.is-js .cie-escalera.is-on li { opacity: 1; transform: none; }
  .cie.is-js .cie-split span { transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s; }
  .cie.is-js .cie-split .is-o { transition-delay: 0.6s; }
  .cie.is-js .cie-quedo.is-on .cie-split span { transform: none; }
  .cie.is-js .cie-vida li { opacity: 0; transition: opacity 0.4s ease; transition-delay: calc(0.2s + var(--k) * 0.3s); }
  .cie.is-js .cie-bio.is-on .cie-vida li { opacity: 1; }

  @media (min-width: 640px) {
    .cie-vida { grid-template-columns: repeat(6, minmax(0, 1fr)); padding: 24px 0 0; gap: 10px; }
    .cie-vida::before { left: 6px; right: 6px; top: 6px; bottom: auto; width: auto; height: 2px; }
    .cie-vida li { padding: 0; }
    .cie-vida li i { left: 0; top: -24px; }
  }
  @media (min-width: 900px) {
    .cie-escalera { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; align-items: start; }
    .cie-escalera li { grid-template-columns: 1fr; grid-template-areas: 'pct' 'f' 't'; row-gap: 8px; margin-top: calc(var(--k) * 56px); padding: 22px 28px 0 0; }
    /* el tramo que baja de un escalón al siguiente */
    .cie-escalera li + li { border-left: 2px solid #fff; padding-left: 24px; margin-left: -2px; }
    .cie-escalera b { font-size: clamp(64px, 7.4vw, 112px); margin-bottom: 6px; }
    .cie-escalera em { align-self: auto; }
  }
  @media (min-width: 1024px) {
    .cie-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 0; align-items: start; }
    .cie-bio { padding-left: 48px; margin-left: 48px; border-left: 1px solid var(--pd-filete); }
    .cie-accion { grid-template-columns: minmax(0, 340px) minmax(0, 1fr); align-items: center; column-gap: 24px; }
    .cie-btn { grid-row: 1; }
    .cie-hecho { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cie * { animation: none !important; transition: none !important; }
  }
</style>
