---
/**
 * Acto 2 · La temporada en vivo (3 may – 20 jun 2027). v3 «color» (2-oct-2026): negro con rayas de cebra, como el
 * paso «Controla» del home, y menos cosas en pantalla: sin el ticker de ventas, sin el selector de modo (se elige en
 * la ficha del acto 0), sin pastillas ni burbujas. El calendario corre con su marcador «hoy», tres contadores, la
 * curva plan contra real que se corrige sola, la rejilla de las 100 tiendas por región pintada por estado y las
 * tarjetas que van saliendo (se abren: qué mover, por qué y un botón).
 * El HTML trae el estado final (póster y SEO); src/scripts/planeacion/consola.ts lo reproduce en vivo.
 */
import { SEMANAS, PLAN_27, REAL_27, REPRONOSTICO_27, TARJETAS_VIVO, REGIONES, AVISO_SEMANA_6, RUTINA, OBRA_NOTA } from '../../data/planeacion-demo';
import { serie, suave } from '../../lib/planeacion-graficas';
import PdTarjeta from './PdTarjeta.astro';
import PdDetalle from './PdDetalle.astro';

const W = 640, H = 230, M = 12, MAX = 7000;
const plan = serie(PLAN_27, { w: W, h: H, m: M, max: MAX });
const real7 = serie(REAL_27, { w: W, h: H, m: M, max: MAX });
const realHasta = suave(real7.pts.slice(0, 7));
const repro = suave(serie(REPRONOSTICO_27, { w: W, h: H, m: M, max: MAX }).pts.slice(5));
const xEv = plan.x(6), anchoSem = plan.x(1) - plan.x(0);
const SEM7 = SEMANAS.slice(0, 7);

// El estado final de la rejilla (póster): casi todo en verde, con lo que quedó pendiente pintado.
const FINAL: Record<string, string> = { 'Monterrey': 'ok', 'Saltillo': 'ok', 'Querétaro': 'ok', 'Zapopan': 'ok', 'Guadalajara Sur': 'ok', 'Mérida': 'ok' };
let n = 0;
const regiones = REGIONES.map((r) => ({
  ...r,
  celdas: r.ciudades.flatMap(([c, k]) => Array.from({ length: k as number }, (_, j) => {
    const i = n++;
    const nombre = j === 0 ? (c as string) : `${c} ${j + 1}`;
    const est = FINAL[nombre] || (i % 17 === 5 ? 'pronto' : i % 23 === 7 ? 'sobra' : 'ok');
    return { i, nombre, ciudad: c as string, est };
  })),
}));
const total = regiones.reduce((a, r) => a + r.celdas.length, 0);
const PALABRA = Array.from({ length: 3 }, () => 'TEMPORADA').join(' · ');
---
<section class="pda vivo pd-negro" id="pd-vivo" data-acto="vivo" aria-labelledby="pd-vivo-h">
  <div class="pda-fondo" aria-hidden="true"><span>{PALABRA}</span><span>{PALABRA}</span></div>
  <header class="pda-cab">
    <p class="pda-k">02 · Temporada en vivo</p>
    <h2 class="pda-h" id="pd-vivo-h">La venta, tienda por tienda.</h2>
    <p class="pda-fecha">Del 3 de mayo al 20 de junio · ejemplo</p>
  </header>

  <div class="vivo-consola">
    <div class="vivo-cal" aria-label="Semanas de la temporada hasta el Día del Padre">
      <ol>
        {SEM7.map((s) => <li class:list={[{ 'is-ev': s.evento }]}><b>Sem {s.n}</b><span>{s.ini} – {s.fin}</span></li>)}
      </ol>
      <span class="vivo-hoy" style="--p:1"><i aria-hidden="true"></i><b data-hoy>hoy · dom 20 jun</b></span>
    </div>

    <dl class="vivo-conts">
      <div><dt>Venta acumulada</dt><dd><b data-cont="acum">$15.4 M</b><small data-cont-s="acum" class="is-arriba">+13 % arriba</small></dd></div>
      <div><dt>Vendido</dt><dd><b data-cont="vendido">67.9 %</b></dd></div>
      <div><dt>Agotados evitados</dt><dd><b data-cont="agotados">173</b></dd></div>
    </dl>

    <div class="vivo-main">
      <figure class="vivo-graf">
        <figcaption class="vivo-cap">Plan contra real<span class="pd-ast"><span aria-hidden="true">*</span><span class="sr-only"> (en construcción)</span></span></figcaption>
        <div class="vivo-svg">
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Piezas por semana: el plan en línea punteada y la venta real encima. A la semana 6 la venta va 12 por ciento arriba y el pronóstico de la semana pico sube de 5,800 a 6,500 piezas; la semana del Día del Padre vendió 6,600.">
            <rect class="vivo-evt" x={xEv - anchoSem / 2} y="4" width={anchoSem} height={H - 8} rx="6" />
            <path class="vivo-plan" d={plan.d} />
            <path class="vivo-repro" d={repro} />
            <path class="vivo-real" d={realHasta} data-real />
            <circle class="vivo-punta" cx={real7.pts[6][0]} cy={real7.pts[6][1]} r="5" data-punta />
          </svg>
          <p class="vivo-aviso"><b>{AVISO_SEMANA_6.t}</b>{AVISO_SEMANA_6.s}</p>
        </div>
        <p class="vivo-leyenda"><span class="p">Plan</span><span class="r">Real</span><span class="n">Pronóstico corregido</span></p>
      </figure>

      <figure class="vivo-red" data-red>
        <figcaption class="vivo-cap">Tus 100 tiendas</figcaption>
        <p class="vivo-nodos"><span class="vivo-nodo" data-nodo="CEDIS"><b>CEDIS</b><span data-cedis>6,436</span> piezas</span><span class="vivo-nodo vivo-nodo--prov" data-nodo="Proveedor"><b>Proveedor</b>playeras</span></p>
        <div class="vivo-regs">
          {regiones.map((r) => (
            <div class="vivo-reg" data-reg={r.id}>
              <p><b>{r.r}</b><span>{r.celdas.length}</span></p>
              <ul class="vivo-celdas" aria-hidden="true">
                {r.celdas.map((c) => <li class={`is-${c.est}`} data-i={c.i} data-t={c.nombre} data-c={c.ciudad} title={c.nombre}></li>)}
              </ul>
            </div>
          ))}
        </div>
        <ul class="vivo-ley">
          <li class="is-ok"><i></i>Va bien</li><li class="is-pronto"><i></i>Se acaba pronto</li><li class="is-falta"><i></i>Le falta una talla</li><li class="is-sobra"><i></i>Le sobra</li>
        </ul>
        <p class="vivo-resumen sr-only" data-resumen>{total} tiendas: casi todas van bien al cierre del Día del Padre.</p>
        <div class="vivo-viajes" aria-hidden="true"></div>
      </figure>
    </div>

    <div class="vivo-tarjetas">
      <div class="vivo-tar-cab">
        <p class="pda-tarjetas-k">Acciones de hoy</p>
        <button type="button" class="vivo-rutina" data-rutina-btn data-total={RUTINA.total} data-traspasos={RUTINA.traspasos}><span data-rutina-t>Mandar las {RUTINA.total} de rutina</span></button>
      </div>
      <ul class="pda-lista vivo-lista">{TARJETAS_VIVO.map((t) => <PdTarjeta t={t} />)}</ul>
    </div>
  </div>

  <p class="pda-nota"><span aria-hidden="true">*</span> {OBRA_NOTA}</p>

  <div class="pd-detalles" data-detalles="vivo">
    <h3 class="pd-detalles-h">El detalle de cada tarjeta</h3>
    {TARJETAS_VIVO.map((t) => <PdDetalle t={t} />)}
  </div>

  <a class="pda-sigue" href="#pd-cierre">Sigue: después del evento
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<style>
  .vivo-consola { display: grid; gap: 18px; margin-top: 48px; }

  /* calendario: una línea con siete semanas y el marcador «hoy» (texto, sin pastilla) */
  .vivo-cal { position: relative; padding: 0 0 28px; }
  .vivo-cal ol { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; margin: 0; padding: 0; list-style: none; }
  .vivo-cal li { display: grid; gap: 2px; padding: 10px 0 0; border-top: 3px solid rgba(255, 255, 255, 0.16); font: 400 12px/1.25 var(--font-body); color: var(--pd-apagado); min-width: 0; }
  .vivo-cal li b { font: 600 12.5px/1.2 var(--font-display); color: var(--pd-tenue); }
  .vivo-cal li span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vivo-cal li.is-ev b::after { content: ' · Día del Padre'; color: #fff; }
  .vivo-cal li.is-pasada { border-top-color: rgba(255, 255, 255, 0.55); }
  .vivo-cal li.is-actual { border-top-color: #fff; }
  .vivo-cal li.is-actual b { color: #fff; }
  .vivo-hoy { position: absolute; left: calc(100% * var(--p, 1)); top: -6px; bottom: 4px; width: 0; white-space: nowrap; }
  .vivo-hoy i { position: absolute; left: -1px; top: 0; width: 2px; height: 15px; background: #fff; }
  .vivo-hoy b { position: absolute; left: 0; bottom: 0; font: 700 12.5px/1.3 var(--font-display); color: #fff; transform: translateX(calc(var(--p, 1) * -100%)); }

  /* contadores: tres números grandes, separados por una línea */
  .vivo-conts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 0; border-top: 1px solid var(--pd-linea); border-bottom: 1px solid var(--pd-linea); }
  .vivo-conts > div { padding: 18px 12px 18px 0; min-width: 0; }
  .vivo-conts > div + div { padding-left: 16px; border-left: 1px solid var(--pd-linea); }
  .vivo-conts dt { font: 500 13px/1.3 var(--font-body); color: var(--pd-apagado); }
  .vivo-conts dd { margin: 8px 0 0; }
  .vivo-conts dd b { display: block; font: 700 clamp(28px, 3.6vw, 50px)/1 var(--pd-clash); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: #fff; }
  .vivo-conts dd small { display: block; margin-top: 6px; font: 600 13px/1.3 var(--font-body); color: var(--pd-tenue); }
  .vivo-conts dd small.is-arriba { color: var(--pd-ok-t); }

  /* plan contra real y la red de tiendas */
  .vivo-main { display: grid; gap: 16px; min-width: 0; }
  .vivo-graf, .vivo-red { position: relative; margin: 0; padding: 22px; border-radius: var(--pd-radio); background: var(--pd-tarjeta); min-width: 0; }
  .vivo-cap { display: flex; align-items: baseline; gap: 2px; margin: 0 0 14px; font: 700 16px/1.3 var(--font-display); color: #fff; }
  .vivo-svg { position: relative; }
  .vivo-svg svg { display: block; width: 100%; height: auto; max-width: none; overflow: visible; }
  .vivo-evt { fill: rgba(255, 255, 255, 0.06); }
  .vivo-plan, .vivo-repro, .vivo-real { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .vivo-plan { stroke: rgba(255, 255, 255, 0.4); stroke-width: 1.8; stroke-dasharray: 5 6; }
  .vivo-repro { stroke: #9DB8F5; stroke-width: 2.2; stroke-dasharray: 2 5; }
  .vivo-real { stroke: #fff; stroke-width: 3.5; }
  .vivo-punta { fill: #18181A; stroke: #fff; stroke-width: 3; }
  /* el aviso: texto suelto arriba a la izquierda de la gráfica, sin burbuja */
  .vivo-aviso { position: absolute; left: 0; top: 0; margin: 0; max-width: 250px; font: 400 13px/1.45 var(--font-body); color: var(--pd-tenue); }
  .vivo-aviso b { display: block; font: 700 14px/1.3 var(--font-display); color: #fff; }
  .vivo-leyenda { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 12px 0 0; font: 400 12.5px/1.2 var(--font-body); color: var(--pd-tenue); }
  .vivo-leyenda span::before { content: ''; display: inline-block; width: 14px; height: 2px; margin-right: 6px; vertical-align: middle; border-radius: 2px; }
  .vivo-leyenda .p::before { background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.6) 0 4px, transparent 4px 7px); }
  .vivo-leyenda .r::before { background: #fff; height: 3px; }
  .vivo-leyenda .n::before { background: repeating-linear-gradient(90deg, #9DB8F5 0 2px, transparent 2px 5px); }

  .vivo-nodos { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 0 0 14px; font: 400 13px/1.3 var(--font-body); color: var(--pd-tenue); }
  .vivo-nodo { display: inline-flex; align-items: baseline; gap: 6px; }
  .vivo-nodo b { font: 600 13px var(--font-display); color: #fff; }
  .vivo-nodo span { font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; }
  .vivo-regs { display: grid; gap: 10px; }
  .vivo-reg { display: grid; gap: 6px; }
  .vivo-reg p { display: flex; align-items: baseline; gap: 6px; margin: 0; font: 600 13px/1.2 var(--font-display); color: #fff; }
  .vivo-reg p span { font: 400 12px/1.2 var(--font-body); color: var(--pd-apagado); }
  /* la misma rejilla para todas las regiones: 15 columnas en el teléfono, 30 en escritorio */
  .vivo-celdas { display: grid; grid-template-columns: repeat(15, minmax(0, 1fr)); gap: 4px; margin: 0; padding: 0; list-style: none; }
  .vivo-celdas li { aspect-ratio: 1; border-radius: 3px; background: var(--pd-ok); transition: background 0.5s ease, transform 0.3s ease; }
  .vivo-celdas li.is-pronto { background: var(--pd-pronto); }
  .vivo-celdas li.is-falta { background: var(--pd-falta); }
  .vivo-celdas li.is-sobra { background: var(--pd-sobra); }
  .vivo-celdas li.is-evento { background: #A970D6; }
  .vivo-celdas li.is-marca { transform: scale(1.35); box-shadow: 0 0 0 2px #fff; z-index: 1; }
  .vivo-ley { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 14px 0 0; padding: 0; list-style: none; font: 400 12.5px/1.2 var(--font-body); color: var(--pd-tenue); }
  .vivo-ley li { display: inline-flex; align-items: center; gap: 6px; }
  .vivo-ley i { width: 10px; height: 10px; border-radius: 3px; background: var(--pd-ok); }
  .vivo-ley .is-pronto i { background: var(--pd-pronto); }
  .vivo-ley .is-falta i { background: var(--pd-falta); }
  .vivo-ley .is-sobra i { background: var(--pd-sobra); }
  .vivo-viajes { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .vivo-viajes :global(i) { position: absolute; left: 0; top: 0; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: #fff; transition: transform 0.9s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.3s ease; }

  /* las tarjetas */
  .vivo-tarjetas { min-width: 0; }
  .vivo-tar-cab { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin-bottom: 14px; }
  .vivo-tar-cab .pda-tarjetas-k { margin: 0; }
  .vivo-rutina { min-height: 44px; padding: 10px 18px; border-radius: 12px; border: 1.5px solid rgba(255, 255, 255, 0.5); background: none; color: #fff; font: 700 14px/1.2 var(--font-display); cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .vivo-rutina:hover { border-color: #fff; background: rgba(255, 255, 255, 0.06); }
  .vivo-rutina:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .vivo-rutina[disabled] { cursor: default; border-color: transparent; padding-left: 0; padding-right: 0; color: var(--pd-ok-t); }
  .vivo-lista { gap: 10px; }

  /* ── Con JS: lo que todavía no pasa no se ve ── */
  .vivo.is-js .vivo-lista .pdt:not(.is-on) { display: none; }
  .vivo.is-js .vivo-aviso { opacity: 0; transform: translateY(6px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .vivo.is-js.is-aviso .vivo-aviso { opacity: 1; transform: none; }
  .vivo.is-js .vivo-repro { opacity: 0; transition: opacity 0.8s ease; }
  .vivo.is-js.is-aviso .vivo-repro { opacity: 1; }
  .vivo.is-js .vivo-nodo--prov { opacity: 0.6; }
  .vivo.is-js .vivo-nodo--prov.is-activo { opacity: 1; }
  .vivo.is-js .vivo-lista:empty::before { content: 'Todavía nada que hacer: las tiendas van bien.'; display: block; padding: 16px; border-radius: 14px; border: 1px dashed var(--pd-linea); font: 400 14px/1.4 var(--font-body); color: var(--pd-tenue); }

  /* teléfono: el calendario solo con el número de semana y el aviso debajo de la gráfica */
  @media (max-width: 639px) {
    .vivo-cal li span { display: none; }
    .vivo-cal li.is-ev b::after { content: ' ★'; }
    .vivo-conts > div { padding-right: 8px; }
    .vivo-conts > div + div { padding-left: 10px; }
    .vivo-conts dt { font-size: 12px; }
    .vivo-conts dd b { font-size: 25px; white-space: nowrap; }
    .vivo-aviso { position: static; max-width: none; margin-top: 12px; }
  }
  @media (min-width: 1024px) {
    .vivo-consola { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); grid-template-areas: 'cal cal' 'conts conts' 'main tarjetas'; gap: 26px 32px; align-items: start; }
    .vivo-cal { grid-area: cal; }
    .vivo-conts { grid-area: conts; }
    .vivo-main { grid-area: main; }
    .vivo-tarjetas { grid-area: tarjetas; }
    .vivo-reg { grid-template-columns: 82px minmax(0, 1fr); align-items: center; gap: 10px; }
    .vivo-reg p { flex-direction: column; gap: 2px; }
    .vivo-celdas { grid-template-columns: repeat(30, minmax(0, 1fr)); gap: 3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vivo *, .vivo-viajes :global(i) { animation: none !important; transition: none !important; }
  }
</style>
