---
/**
 * Una tarjeta de acción de la temporada simulada (pretemporada o en vivo). Sin JS es un enlace a su detalle en el
 * póster; con JS abre el detalle en un diálogo (panel lateral en escritorio, hoja desde abajo en el teléfono).
 */
import type { Tarjeta } from '../../data/planeacion-demo';
import { OBRA } from '../../data/planeacion-demo';

interface Props { t: Tarjeta; }
const { t } = Astro.props;
const CLASE: Record<string, string> = {
  'Traspaso entre tiendas': 'traspaso', 'Resurtido del CEDIS': 'resurtido', 'Compra extra': 'compra', 'Orden de compra': 'compra',
  'Esperar': 'esperar', 'Talla rota': 'talla', '¿Evento o demanda real?': 'evento', 'Primer reparto': 'reparto',
};
---
<li class:list={['pdt', `pdt--${CLASE[t.tipo] || 'otro'}`]} data-tarjeta={t.id} data-rutina={t.rutina ? '1' : undefined} data-auto={t.auto ? '1' : undefined} data-grande={t.grande ? '1' : undefined}>
  <a class="pdt-b" href={`#det-${t.id}`} data-abre={t.id}>
    <span class="pdt-cab"><span class="pdt-tipo">{t.tipo}</span><span class="pdt-hora">{t.hora}</span></span>
    <span class="pdt-t">{t.titulo}</span>
    <span class="pdt-pie">
      <span class="pdt-donde">{t.tienda}</span>
      {t.obra && <span class="pd-obra">{OBRA}</span>}
      <span class="pdt-estado" data-estado>Por revisar</span>
    </span>
    {t.foto && <img class="pdt-foto" src={`/images/planeacion/prod/${t.foto}.webp`} width="480" height="480" alt="" loading="lazy" decoding="async" />}
    <span class="pdt-abreme" aria-hidden="true">Ábreme</span>
  </a>
</li>

<style>
  .pdt { position: relative; list-style: none; }
  .pdt-b { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 64px; grid-template-rows: auto auto auto; column-gap: 12px; row-gap: 6px; min-height: 48px; padding: 12px 12px 12px 14px; border-radius: 14px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--pd-linea); border-left: 3px solid var(--pdt-c, var(--pd-azul-c)); color: #fff; text-decoration: none; transition: background 0.2s, border-color 0.2s, transform 0.2s; }
  .pdt-b:hover { background: rgba(143, 176, 243, 0.12); color: #fff; text-decoration: none; transform: translateY(-1px); }
  .pdt-b:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .pdt-cab { grid-column: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font: 600 10.5px/1.2 var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; }
  .pdt-tipo { color: var(--pdt-c, var(--pd-azul-c)); }
  .pdt-hora { color: var(--pd-apagado); letter-spacing: 0.02em; text-transform: none; font-weight: 500; }
  .pdt-t { grid-column: 1; font: 600 14px/1.3 var(--font-display); letter-spacing: -0.01em; color: #fff; }
  .pdt-pie { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font: 500 12px/1.3 var(--font-display); color: var(--pd-tenue); }
  .pdt-donde { margin-right: auto; }
  .pdt-estado { padding: 3px 9px; border-radius: 99px; background: rgba(255, 255, 255, 0.08); color: var(--pd-tenue); font-weight: 600; white-space: nowrap; }
  .pdt-foto { grid-column: 2; grid-row: 1 / 3; width: 64px; height: 64px; border-radius: 10px; background: #E9EEF9; object-fit: contain; padding: 4px; }
  .pdt-abreme { position: absolute; right: -6px; top: -10px; padding: 4px 10px; border-radius: 99px; background: var(--pd-rosa); color: #fff; font: 700 11px/1.2 var(--font-display); opacity: 0; transform: scale(0.8); pointer-events: none; transition: opacity 0.3s, transform 0.3s; }

  .pdt--traspaso { --pdt-c: var(--pd-azul-c); }
  .pdt--resurtido { --pdt-c: var(--pd-verde); }
  .pdt--compra { --pdt-c: var(--pd-ambar); }
  .pdt--esperar { --pdt-c: #B9C3DC; }
  .pdt--talla { --pdt-c: var(--pd-rojo); }
  .pdt--evento { --pdt-c: var(--pd-rosa-c); }
  .pdt--reparto { --pdt-c: var(--pd-azul-c); }

  /* estados (los pone el script) */
  .pdt.is-hecho .pdt-b { background: rgba(61, 220, 132, 0.08); border-color: rgba(61, 220, 132, 0.35); border-left-color: var(--pd-verde); }
  .pdt.is-hecho .pdt-estado { background: rgba(61, 220, 132, 0.18); color: #9BF0C0; }
  .pdt.is-auto .pdt-estado { background: rgba(143, 176, 243, 0.2); color: #fff; }
  .pdt.is-abreme .pdt-abreme { opacity: 1; transform: none; animation: pdtLate 1s ease-in-out infinite alternate; }
  .pdt.is-abreme .pdt-b { border-color: var(--pd-rosa); }
  .pdt.is-nueva { animation: pdtEntra 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes pdtLate { to { transform: scale(1.08); } }
  @keyframes pdtEntra { from { opacity: 0; transform: translateY(-10px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pdt.is-abreme .pdt-abreme, .pdt.is-nueva { animation: none; } }
</style>
