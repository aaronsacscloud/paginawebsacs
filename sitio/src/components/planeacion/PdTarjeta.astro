---
/**
 * Una tarjeta de acción de la temporada simulada (pretemporada o en vivo). Sin JS es un enlace a su detalle en el
 * póster; con JS abre el detalle en un diálogo (panel lateral en escritorio, hoja desde abajo en el teléfono).
 */
import type { Tarjeta } from '../../data/planeacion-demo';
import { OBRA } from '../../data/planeacion-demo';

interface Props { t: Tarjeta; }
const { t } = Astro.props;
const CLASE: Record<string, string> = {
  'Traspaso entre tiendas': 'traspaso', 'Resurtido del CEDIS': 'resurtido', 'Compra extra': 'compra', 'Orden de compra': 'compra',
  'Esperar': 'esperar', 'Talla rota': 'talla', '¿Evento o demanda real?': 'evento', 'Primer reparto': 'reparto',
};
---
<li class:list={['pdt', `pdt--${CLASE[t.tipo] || 'otro'}`]} data-tarjeta={t.id} data-rutina={t.rutina ? '1' : undefined} data-auto={t.auto ? '1' : undefined} data-grande={t.grande ? '1' : undefined}>
  <a class="pdt-b" href={`#det-${t.id}`} data-abre={t.id}>
    <span class="pdt-cab"><span class="pdt-tipo">{t.tipo}</span><span class="pdt-hora">{t.hora}</span></span>
    <span class="pdt-t">{t.titulo}</span>
    <span class="pdt-pie">
      <span class="pdt-donde">{t.tienda}</span>
      {t.obra && <span class="pd-obra">{OBRA}</span>}
      <span class="pdt-estado" data-estado>Por revisar</span>
    </span>
    {t.foto && <img class="pdt-foto" src={`/images/planeacion/prod/${t.foto}.webp`} width="480" height="480" alt="" loading="lazy" decoding="async" />}
    <span class="pdt-abreme" aria-hidden="true">Ábreme</span>
  </a>
</li>

<style>
  .pdt { position: relative; list-style: none; }
  .pdt-b { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 60px; grid-template-rows: auto auto auto; column-gap: 14px; row-gap: 6px; min-height: 48px; padding: 14px 14px 14px 16px; border-radius: 16px; background: var(--pd-tarjeta); border: 1px solid transparent; color: var(--pd-texto); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .pdt-b:hover { border-color: var(--pd-apagado); color: var(--pd-texto); text-decoration: none; transform: translateY(-1px); }
  .pdt-b:focus-visible { outline: 2px solid var(--pd-azul); outline-offset: 2px; }
  .pdt-cab { grid-column: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font: 600 12.5px/1.3 var(--font-display); }
  .pdt-tipo { display: inline-flex; align-items: center; gap: 7px; color: var(--pd-texto); }
  .pdt-tipo::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--pdt-c, var(--pd-azul)); }
  .pdt-hora { color: var(--pd-apagado); font-weight: 500; }
  .pdt-t { grid-column: 1; font: 600 15px/1.35 var(--font-display); letter-spacing: -0.01em; color: var(--pd-texto); }
  .pdt-pie { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font: 400 13px/1.35 var(--font-body); color: var(--pd-tenue); }
  .pdt-donde { margin-right: auto; }
  .pdt-estado { font: 600 12.5px/1.3 var(--font-display); color: var(--pd-apagado); white-space: nowrap; }
  .pdt-foto { grid-column: 2; grid-row: 1 / 3; width: 60px; height: 60px; border-radius: 12px; background: #fff; object-fit: contain; padding: 4px; }
  .pdt-abreme { position: absolute; right: -6px; top: -10px; padding: 4px 10px; border-radius: 99px; background: var(--pd-boton); color: var(--pd-boton-t); font: 700 11.5px/1.2 var(--font-display); opacity: 0; transform: scale(0.8); pointer-events: none; transition: opacity 0.3s, transform 0.3s; }

  .pdt--traspaso { --pdt-c: #4B7BE5; }
  .pdt--resurtido { --pdt-c: #1F9D63; }
  .pdt--compra { --pdt-c: #E09B2D; }
  .pdt--esperar { --pdt-c: #9A9A96; }
  .pdt--talla { --pdt-c: #D64545; }
  .pdt--evento { --pdt-c: #A970D6; }
  .pdt--reparto { --pdt-c: #4B7BE5; }

  /* estados (los pone el script) */
  .pdt.is-hecho .pdt-estado { color: var(--pd-ok); }
  .pdt.is-hecho .pdt-b { opacity: 0.86; }
  .pdt.is-abreme .pdt-abreme { opacity: 1; transform: none; animation: pdtLate 1s ease-in-out infinite alternate; }
  .pdt.is-abreme .pdt-b { border-color: var(--pd-texto); }
  .pdt.is-nueva { animation: pdtEntra 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes pdtLate { to { transform: scale(1.06); } }
  @keyframes pdtEntra { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pdt.is-abreme .pdt-abreme, .pdt.is-nueva { animation: none; } }
</style>
