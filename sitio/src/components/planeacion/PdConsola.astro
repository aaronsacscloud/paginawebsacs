---
/**
 * La consola de la temporada simulada (actos 1–4) de /producto/planeacion-de-demanda. Una barra pegada arriba con
 * las fases (Instrucción · Pretemporada · Temporada · Cierre · Resultado), pausa, ×2, «Saltar» y «Otra vez»; cada
 * acto se reproduce solo al entrar en pantalla (src/scripts/planeacion/consola.ts) y abrir una tarjeta lo pausa.
 * El detalle de cada tarjeta se abre en un <dialog> (panel lateral en escritorio, hoja desde abajo en el teléfono).
 * «Reducir movimiento» o sin JS: póster con cada acto completo y estático.
 */
import { FASES } from '../../data/planeacion-demo';
import PdPretemporada from './PdPretemporada.astro';
import PdTemporada from './PdTemporada.astro';
import PdCierre from './PdCierre.astro';
import PdResultado from './PdResultado.astro';
---
<div class="pdc" id="pd-consola">
  <div class="pdc-barra">
    <nav class="pdc-fases" aria-label="Fases de la temporada">
      <ol>
        {FASES.map((f, i) => (
          <li data-fase={f.id}>
            <a href={`#${f.ancla}`} data-evento={`planeacion_fase_click_${f.id}`}><span class="pdc-n">{i}</span><span class="pdc-t">{f.t}</span></a>
            <span class="pdc-avance" aria-hidden="true"><i></i></span>
          </li>
        ))}
      </ol>
    </nav>
    <div class="pdc-ctl" role="group" aria-label="Reproducción de la simulación">
      <button type="button" class="pdc-b" data-ctl="pausa" aria-pressed="false" aria-label="Pausa">
        <svg class="pdc-i-pausa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="pdc-i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
      </button>
      <button type="button" class="pdc-b pdc-b--txt" data-ctl="vel" aria-pressed="false" aria-label="×2 · velocidad doble">×2</button>
      <button type="button" class="pdc-b pdc-b--txt" data-ctl="saltar" aria-label="Saltar al final del acto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 5 7 7-7 7M13 5l7 7-7 7"/></svg><span>Saltar</span></button>
      <button type="button" class="pdc-b pdc-b--txt" data-ctl="otra" aria-label="Otra vez: repetir el acto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg><span>Otra vez</span></button>
    </div>
  </div>

  <PdPretemporada />
  <PdTemporada />
  <PdCierre />
  <PdResultado />

  <p class="sr-only" aria-live="polite" data-anuncio></p>

  <dialog class="pdd pd-claro" id="pd-dialogo">
    <div class="pdd-in">
      <button type="button" class="pdd-cierra" aria-label="Cerrar el detalle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <div class="pdd-cuerpo"></div>
      <p class="pdd-vivo sr-only" aria-live="polite"></p>
    </div>
  </dialog>
</div>

<style>
  .pdc { position: relative; }

  /* ── la barra de la consola: blanca, fina, con las fases como pestañas ── */
  .pdc-barra { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 12px; background: rgba(255, 255, 255, 0.97); border-bottom: 1px solid #E7E7E4; color: #1A1A1A; }
  .pdc-fases { min-width: 0; flex: 1; }
  .pdc-fases ol { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .pdc-fases li { position: relative; flex: 1; min-width: 0; }
  .pdc-fases a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 4px 6px; border-radius: 10px; font: 600 13px/1.1 var(--font-display); color: #6E6E6D; text-decoration: none; white-space: nowrap; }
  .pdc-fases a:hover { color: #1A1A1A; background: #F5F5F3; text-decoration: none; }
  .pdc-fases a:focus-visible { outline: 2px solid #4B7BE5; outline-offset: 1px; }
  .pdc-n { display: grid; place-items: center; flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 1px solid #D5D5D1; font: 600 11px/1 var(--font-display); }
  .pdc-t { display: none; overflow: hidden; text-overflow: ellipsis; }
  .pdc-fases li.is-actual a { color: #1A1A1A; }
  .pdc-fases li.is-actual .pdc-n { background: #1A1A1A; border-color: #1A1A1A; color: #fff; }
  .pdc-fases li.is-actual .pdc-t { display: inline; }
  .pdc-fases li.is-hecha .pdc-n { background: #fff; border-color: #1A1A1A; color: #1A1A1A; }
  .pdc-avance { position: absolute; left: 10px; right: 10px; bottom: 0; height: 2px; border-radius: 2px; background: #EDEDEA; overflow: hidden; opacity: 0; }
  .pdc-avance i { display: block; width: 100%; height: 100%; background: #1A1A1A; transform-origin: 0 50%; transform: scaleX(var(--a, 0)); }
  .pdc-fases li.is-actual .pdc-avance { opacity: 1; }

  .pdc-ctl { display: flex; flex-shrink: 0; gap: 4px; }
  .pdc-b { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 42px; min-height: 42px; padding: 0 10px; border: 1px solid #E0E0DC; border-radius: 99px; background: #fff; color: #1A1A1A; font: 600 13px/1 var(--font-display); cursor: pointer; transition: background 0.2s, border-color 0.2s; }
  .pdc-b svg { width: 15px; height: 15px; max-width: none; flex-shrink: 0; }
  .pdc-b span { display: none; }
  .pdc-b:hover { border-color: #1A1A1A; }
  .pdc-b:focus-visible { outline: 2px solid #4B7BE5; outline-offset: 2px; }
  .pdc-b[aria-pressed="true"] { background: #1A1A1A; color: #fff; border-color: #1A1A1A; }
  .pdc-i-play { display: none; }
  .pdc-b[data-ctl="pausa"][aria-pressed="true"] .pdc-i-pausa { display: none; }
  .pdc-b[data-ctl="pausa"][aria-pressed="true"] .pdc-i-play { display: block; }
  .pdc:not(.is-js) .pdc-ctl, .pdc.is-quieta .pdc-ctl { display: none; }

  /* teléfono: solo el número de cada fase (el acto ya dice su nombre) y botones grandes */
  @media (max-width: 767px) {
    .pdc-barra { gap: 6px; padding: 6px 10px; }
    .pdc-fases ol { gap: 3px; }
    .pdc-fases li { flex: 0 0 28px; }
    .pdc-fases a { min-height: 44px; padding: 0; }
    .pdc-fases li.is-actual .pdc-t { display: none; }
    .pdc-ctl { gap: 4px; }
    .pdc-b { min-width: 48px; min-height: 44px; padding: 0; }
  }
  @media (min-width: 768px) {
    .pdc-barra { padding: 8px 5vw; }
    .pdc-t { display: inline; }
    .pdc-b span { display: inline; }
  }

  /* ── el diálogo: panel blanco a la derecha en escritorio, hoja desde abajo en el teléfono ── */
  .pdd { position: fixed; inset: auto 0 0 0; width: 100%; max-width: none; max-height: 90svh; height: auto; margin: 0; padding: 0; border: 0; border-radius: 22px 22px 0 0; background: #fff; color: #1A1A1A; box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.18); overflow: hidden; }
  .pdd::backdrop { background: rgba(17, 17, 17, 0.45); }
  .pdd[open] { display: flex; flex-direction: column; animation: pddSube 0.38s cubic-bezier(0.16, 1, 0.3, 1); }
  .pdd-in { position: relative; overflow: auto; overscroll-behavior: contain; padding: 26px 20px calc(24px + env(safe-area-inset-bottom)); }
  .pdd-cierra { position: absolute; right: 14px; top: 14px; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid #E0E0DC; border-radius: 50%; background: #fff; color: #1A1A1A; cursor: pointer; }
  .pdd-cierra svg { width: 18px; height: 18px; max-width: none; }
  .pdd-cierra:focus-visible { outline: 2px solid #4B7BE5; outline-offset: 2px; }
  @keyframes pddSube { from { transform: translateY(40px); opacity: 0.4; } to { transform: none; opacity: 1; } }
  @keyframes pddEntra { from { transform: translateX(40px); opacity: 0.4; } to { transform: none; opacity: 1; } }
  @media (min-width: 900px) {
    .pdd { inset: 0 0 0 auto; width: min(560px, 94vw); height: 100vh; max-height: none; border-radius: 0; box-shadow: -12px 0 30px rgba(0, 0, 0, 0.16); }
    .pdd[open] { animation-name: pddEntra; }
    .pdd-in { height: 100%; padding: 30px 30px 34px; }
  }
  @media (prefers-reduced-motion: reduce) { .pdd[open] { animation: none; } }
</style>

<script>
  import '../../scripts/planeacion/consola';
</script>
