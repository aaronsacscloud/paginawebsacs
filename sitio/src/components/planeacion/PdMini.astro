---
/**
 * Mini gráfica de cada «por qué» de una tarjeta (/producto/planeacion-de-demanda). SVG/HTML calculado en el build.
 *  linea  · venta diaria o existencia (con un punto rosa en el evento, si hay `e`)
 *  barras · cantidades con su etiqueta (las negativas restan)
 *  dias   · cuántos días le alcanza a una tienda contra otra
 *  camino · de cuándo a cuándo (pides → llega)
 *  curva  · qué tallas hay (✓) y cuál falta (✕)
 */
import type { Razon } from '../../data/planeacion-demo';
import { serie, area, miles } from '../../lib/planeacion-graficas';

interface Props { g: NonNullable<Razon['g']>; }
const { g } = Astro.props;

const W = 220, H = 56;
let linea: { d: string; a: string; px?: number; py?: number } | null = null;
if (g.tipo === 'linea' && g.v) {
  const max = Math.max(...g.v) * 1.1;
  const s = serie(g.v, { w: W, h: H, m: 4, max });
  linea = { d: s.d, a: area(s.pts, H - 4) };
  if (g.e !== undefined) { linea.px = s.pts[g.e][0]; linea.py = s.pts[g.e][1]; }
}
const maxBarra = g.tipo === 'barras' && g.v ? Math.max(...g.v.map((n) => Math.abs(n))) : 1;
const maxDias = g.tipo === 'dias' ? Math.max(g.va ?? 0, g.vb ?? 0, 1) : 1;
---
{linea && (
  <svg class="pdm pdm--linea" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mini gráfica de la tendencia">
    <path class="pdm-area" d={linea.a} />
    <path class="pdm-l" d={linea.d} />
    {linea.px !== undefined && <circle class="pdm-ev" cx={linea.px} cy={linea.py} r="4.5" />}
  </svg>
)}
{g.tipo === 'barras' && g.v && (
  <ul class="pdm pdm--barras" aria-label="Mini gráfica de cantidades">
    {g.v.map((n, i) => (
      <li class:list={[{ 'is-resta': n < 0 }]} style={`--w:${Math.max(4, Math.round((Math.abs(n) / maxBarra) * 100))}%`}>
        <span>{g.et?.[i]}</span><i></i><b>{n < 0 ? '−' : ''}{miles(Math.abs(n))}{g.u ? ` ${g.u}` : ''}</b>
      </li>
    ))}
  </ul>
)}
{g.tipo === 'dias' && (
  <ul class="pdm pdm--dias" aria-label="Días que le alcanzan">
    <li style={`--w:${Math.max(3, Math.round(((g.va ?? 0) / maxDias) * 100))}%`}><span>{g.a}</span><i></i><b>{`${g.va} días`}</b></li>
    <li class="is-poco" style={`--w:${Math.max(3, Math.round(((g.vb ?? 0) / maxDias) * 100))}%`}><span>{g.b}</span><i></i><b>{`${g.vb} ${g.vb === 1 ? 'día' : 'días'}`}</b></li>
  </ul>
)}
{g.tipo === 'camino' && (
  <div class="pdm pdm--camino" aria-label={`De ${g.a} a ${g.b}`}>
    <span class="pdm-c-a"><i></i><b>{g.a}</b><small>{g.et?.[0]}</small></span>
    <span class="pdm-c-l" aria-hidden="true"></span>
    <span class="pdm-c-b"><i></i><b>{g.b}</b><small>{g.et?.[1]}</small></span>
  </div>
)}
{g.tipo === 'curva' && g.ok && (
  <ul class="pdm pdm--curva" aria-label="Tallas disponibles">
    {g.ok.map((ok, i) => <li class:list={[{ 'is-falta': !ok }]}><b>{g.et?.[i]}</b><span>{ok ? '✓' : '✕'}</span></li>)}
  </ul>
)}

<style>
  .pdm { display: block; margin: 10px 0 0; }
  svg.pdm { width: 100%; max-width: 260px; height: auto; overflow: visible; }
  .pdm-area { fill: rgba(75, 123, 229, 0.12); }
  .pdm-l { fill: none; stroke: var(--pd-azul); stroke-width: 2.2; stroke-linecap: round; }
  .pdm-ev { fill: var(--pd-falta); stroke: var(--pd-fondo); stroke-width: 2; }

  .pdm--barras, .pdm--dias, .pdm--curva { list-style: none; padding: 0; }
  .pdm--barras li, .pdm--dias li { display: grid; grid-template-columns: 104px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 3px 0; font: 400 13px/1.3 var(--font-body); color: var(--pd-tenue); }
  .pdm--barras i, .pdm--dias i { display: block; height: 8px; width: var(--w); border-radius: 4px; background: var(--pd-azul); }
  .pdm--barras li.is-resta i { background: repeating-linear-gradient(135deg, var(--pd-apagado) 0 3px, transparent 3px 6px); }
  .pdm--barras b, .pdm--dias b { font: 600 13px/1.3 var(--font-display); color: var(--pd-texto); font-variant-numeric: tabular-nums; }
  .pdm--dias li.is-poco i { background: var(--pd-falta); }

  .pdm--camino { display: grid; grid-template-columns: auto minmax(30px, 1fr) auto; align-items: start; gap: 10px; max-width: 320px; }
  .pdm--camino > span:not(.pdm-c-l) { display: grid; justify-items: start; gap: 2px; font: 400 12.5px/1.3 var(--font-body); color: var(--pd-tenue); }
  .pdm--camino i { width: 10px; height: 10px; border-radius: 50%; background: var(--pd-azul); }
  .pdm-c-b i { background: var(--pd-ok); }
  .pdm--camino b { font: 600 14px/1.3 var(--font-display); color: var(--pd-texto); }
  .pdm-c-l { height: 1.5px; margin-top: 5px; background: repeating-linear-gradient(90deg, var(--pd-apagado) 0 5px, transparent 5px 9px); }

  .pdm--curva { display: flex; gap: 6px; }
  .pdm--curva li { display: grid; justify-items: center; gap: 3px; min-width: 40px; padding: 7px 4px; border-radius: 10px; background: var(--pd-tarjeta); font: 600 12.5px/1 var(--font-display); color: var(--pd-texto); }
  .pdm--curva li span { color: var(--pd-ok); }
  .pdm--curva li.is-falta { box-shadow: inset 0 0 0 1.5px var(--pd-falta); }
  .pdm--curva li.is-falta span { color: var(--pd-falta); }
</style>
