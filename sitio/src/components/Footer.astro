---
import { footerLinks } from '../data/navigation';
import { t, getLocalizedUrl } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props { locale?: Locale; }
const { locale = 'es' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={getLocalizedUrl('/', locale)} class="footer-logo" aria-label="SACS">
        <svg width="72" height="30" viewBox="0 0 72 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <text x="0" y="23" font-family="'Clash Display', sans-serif" font-size="24" font-weight="700" fill="#fff">Sacs</text>
        </svg>
      </a>
      <p class="footer-tagline">{t('footer.tagline', locale)}</p>
    </div>

    <details class="footer-col" open>
      <summary class="footer-heading">{t('footer.platform', locale)}</summary>
      <ul class="footer-list">
        {footerLinks.vende.map((link) => (
          <li><a href={getLocalizedUrl(link.href, locale)}>{link.label}</a></li>
        ))}
        {footerLinks.controla.map((link) => (
          <li><a href={getLocalizedUrl(link.href, locale)}>{link.label}</a></li>
        ))}
      </ul>
    </details>

    <details class="footer-col" open>
      <summary class="footer-heading">{t('footer.company', locale)}</summary>
      <ul class="footer-list">
        {footerLinks.empresa.map((link) => (
          <li><a href={getLocalizedUrl(link.href, locale)}>{link.label}</a></li>
        ))}
      </ul>
    </details>

    <details class="footer-col" open>
      <summary class="footer-heading">{t('footer.resources', locale)}</summary>
      <ul class="footer-list">
        {footerLinks.recursos.map((link) => (
          <li><a href={getLocalizedUrl(link.href, locale)}>{link.label}</a></li>
        ))}
      </ul>
    </details>
  </div>

  <div class="container">
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {currentYear} Sacs. {t('footer.copyright', locale)}</p>
      <p class="footer-impact">{t('footer.impact', locale)}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark-muted);
    padding-block: var(--space-24);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8) var(--space-6);
  }
  .footer-brand { grid-column: 1 / -1; }
  .footer-heading { list-style: none; cursor: default; }
  .footer-heading::-webkit-details-marker { display: none; }
  @media (max-width: 767px) {
    .footer-grid { grid-template-columns: 1fr; gap: 0; }
    .footer-brand { margin-bottom: 20px; }
    .footer-col { border-top: 1px solid rgba(255,255,255,0.12); }
    .footer-heading { cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 16px 0; margin: 0; }
    .footer-heading::after { content: '+'; font-size: 18px; opacity: 0.7; }
    .footer-col[open] .footer-heading::after { content: '–'; }
    .footer-list { padding-bottom: 12px; }
  }
  @media (max-width: 767px) { .footer-list a { font-size: 0.875rem; } .footer { padding-block: 28px 24px; } .footer-heading { padding: 14px 0 !important; margin: 0 !important; line-height: 1.2; } .footer-col { margin: 0 !important; } .footer-list { padding-bottom: 10px; margin: 0; } }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-on-dark-subtle);
    max-width: 280px;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-5);
    letter-spacing: 0;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-list a {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-on-dark-subtle);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .footer-list a:hover {
    color: var(--color-text-on-dark);
    text-decoration: none;
  }

  .footer-divider {
    height: 1px;
    background: var(--color-border-on-dark);
    margin-top: var(--space-16);
    margin-bottom: var(--space-6);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-size: 0.75rem;
    color: var(--color-text-on-dark-faint);
  }

  .footer-impact {
    font-size: 0.75rem;
    color: var(--color-secondary);
    font-weight: 500;
  }
  .footer-impact { color: var(--color-primary, #4B7BE5) !important; }
</style>
<script>
  // En teléfono los grupos del footer empiezan cerrados
  if (matchMedia('(max-width: 767px)').matches) document.querySelectorAll<HTMLDetailsElement>('details.footer-col').forEach((d) => { d.open = false; });
</script>
