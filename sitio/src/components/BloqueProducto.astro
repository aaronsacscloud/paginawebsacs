---
/**
 * BloqueProducto — el bloque de las páginas de producto, hecho componente.
 *
 * Es literalmente el `sq-block` que vive dentro de `producto/[slug].astro`:
 * texto y viñetas a un lado, la pieza visual al otro, sobre gris claro. Se
 * sacó a un componente porque las páginas de giro estaban inventando su propio
 * formato para lo mismo, y el sitio terminaba con dos maneras de decir la
 * misma cosa.
 *
 * La pieza visual entra por slot: puede ser una foto, una captura o —lo que
 * hacía falta aquí— un mock interactivo. El envoltorio no opina sobre eso.
 *
 * Si algún día cambia el diseño de las páginas de producto, este archivo se
 * actualiza con ellas: la fuente de verdad de este patrón es esa página.
 */
export interface ViñetaBloque {
  label: string;
  detail: string;
}
interface Props {
  titulo: string;
  descripcion?: string;
  vinetas?: ViñetaBloque[];
  /** La visual a la izquierda en lugar de a la derecha. */
  flip?: boolean;
  /** Deja la visual sin caja ni fondo (para mocks que traen el suyo). */
  suelta?: boolean;
  /** Encabezado grande que abre el grupo de bloques. */
  encabezado?: string;
  /** Cierra el envoltorio gris; ponlo en el último bloque del grupo. */
  fondo?: boolean;
  enlace?: { label: string; href: string };
}
const {
  titulo,
  descripcion,
  vinetas,
  flip = false,
  suelta = false,
  encabezado,
  fondo = true,
  enlace,
} = Astro.props;
---

<div class:list={['bp-wrap', { 'bp-wrap--plano': !fondo }]}>
  <section class="bp-showcase">
    {encabezado && (
      <div class="bp-showcase-inner container">
        <h2 class="bp-showcase-heading">{encabezado}</h2>
      </div>
    )}

    <div class:list={['bp-block', { 'bp-block--flip': flip }]}>
      <div class="bp-block-inner container">
        <div class="bp-block-text">
          <h3 class="bp-block-title">{titulo}</h3>
          {descripcion && <p class="bp-block-desc">{descripcion}</p>}
          {vinetas && (
            <ul class="bp-block-bullets">
              {vinetas.map((v) => (
                <li class="bp-block-bullet">
                  <span class="bp-block-bullet-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                  </span>
                  <span class="bp-block-bullet-text">
                    <strong class="bp-block-bullet-label">{v.label}</strong>
                    <span class="bp-block-bullet-detail">{v.detail}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}
          {enlace && (
            <a href={enlace.href} class="bp-block-link">
              {enlace.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </a>
          )}
        </div>

        <div class:list={['bp-block-media', { 'bp-block-media--suelta': suelta }]}>
          <slot />
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .bp-wrap { background: #fff; padding: clamp(20px, 3vw, 32px) clamp(16px, 2vw, 32px); }
  .bp-wrap--plano { padding: 0; }
  .bp-showcase { padding: clamp(48px, 6vw, 76px) 0; background: #f2f2f2; border-radius: 24px; }
  .bp-wrap--plano .bp-showcase { background: transparent; border-radius: 0; }

  .bp-showcase-heading {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-text-primary, #1a1a2e);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 clamp(40px, 5vw, 64px);
    max-width: 640px;
  }

  .bp-block { padding: clamp(24px, 3vw, 40px) 0; }
  .bp-block-inner { display: flex; flex-direction: column; gap: var(--space-8, 32px); }

  @media (min-width: 900px) {
    .bp-block-inner {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: clamp(48px, 5vw, 80px);
      align-items: center;
    }
    .bp-block--flip .bp-block-inner { grid-template-columns: 1.5fr 1fr; }
    .bp-block--flip .bp-block-text { order: 2; }
    .bp-block--flip .bp-block-media { order: 1; }
  }

  .bp-block-title {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: var(--color-text-primary, #1a1a2e);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--space-4, 16px);
  }
  .bp-block-desc {
    font-size: 0.9375rem; line-height: 1.65;
    color: var(--color-text-secondary, #4A4A4A); margin: 0;
  }

  .bp-block-bullets {
    list-style: none; padding: 0; margin: var(--space-5, 20px) 0 0;
    display: flex; flex-direction: column; gap: 14px;
  }
  .bp-block-bullet { display: flex; align-items: flex-start; gap: 12px; }
  .bp-block-bullet-icon {
    flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%;
    background: rgba(37, 99, 235, 0.1); color: #2563EB;
    display: inline-flex; align-items: center; justify-content: center; margin-top: 1px;
  }
  .bp-block-bullet-text { display: flex; flex-direction: column; gap: 2px; }
  .bp-block-bullet-label {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 0.9375rem; font-weight: 700;
    color: var(--color-text-primary, #1a1a2e); line-height: 1.3;
  }
  .bp-block-bullet-detail {
    font-size: 0.875rem; line-height: 1.55; color: var(--color-text-secondary, #4A4A4A);
  }

  .bp-block-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 0.875rem; font-weight: 700;
    color: var(--color-text-primary, #1a1a2e); text-decoration: none;
    margin-top: var(--space-5, 20px); transition: gap 0.2s ease;
  }
  .bp-block-link:hover { gap: 10px; text-decoration: none; }

  .bp-block-media {
    border-radius: var(--radio-chico, 8px); overflow: hidden;
    background: var(--color-bg-secondary, #F5F3EE);
  }
  .bp-block-media--suelta { background: transparent; overflow: visible; }
  .bp-block-media :global(img) { width: 100%; height: auto; display: block; border-radius: var(--radio-chico, 8px); }

  @media (prefers-reduced-motion: reduce) { .bp-block-link { transition: none; } }
</style>
