---
import { getCollection } from 'astro:content';
import { SITIO, ENTIDAD_ID } from '../data/entidad';
import { breadcrumbList } from '../lib/breadcrumb';
import BaseLayout from './BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  image?: string;
  imageAlt?: string;
  tags?: string[];
}

const { title, seoTitle, description, pubDate, author = 'Equipo Sacs', image, imageAlt, tags = [] } = Astro.props;

// El slug sale de la URL en vez de que `blog/[...slug].astro` tenga que
// pasarlo como prop: así esta plantilla puede ir a buscar `updatedDate`
// directo en la colección sin que la página intermedia cambie.
const slug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const posts = await getCollection('blog');
const entry = posts.find((p) => p.id === slug);
const updatedDate = entry?.data.updatedDate;

// «SACS» como autor por defecto era una Person que en realidad es un equipo.
// Regla: un nombre de persona real → Person; «Equipo Sacs» (o el genérico
// «SACS») → Organization, referenciada por @id — la MISMA entidad que
// `organizacion()` ya declara en todas las páginas, nunca una segunda
// Organization inline (era el bug: dos fichas de Sacs distintas en el sitio).
const esEquipo = /^(equipo sacs|sacs)$/i.test(author.trim());
const authorSchema = esEquipo ? { '@id': ENTIDAD_ID } : { '@type': 'Person', name: author };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${SITIO}${Astro.url.pathname}#articulo`,
  mainEntityOfPage: `${SITIO}${Astro.url.pathname}`,
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: authorSchema,
  publisher: { '@id': ENTIDAD_ID },
  ...(image && { image: `${SITIO}${image}` }),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};

const breadcrumbSchema = breadcrumbList([
  { name: 'Inicio', url: `${SITIO}/` },
  { name: 'Blog', url: `${SITIO}/blog` },
  { name: title },
]);
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  image={image}
  type="article"
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <article class="blog-article section">
    <div class="container blog-container">
      <header class="blog-header">
        <div class="blog-meta">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('es-MX', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {tags.length > 0 && (
            <div class="blog-tags">
              {tags.map((tag) => (
                <span class="badge badge-blue">{tag}</span>
              ))}
            </div>
          )}
        </div>
        <h1>{title}</h1>
        <p class="body-large blog-description">{description}</p>
        {image && (
          <img src={image} alt={imageAlt ?? title} class="blog-hero-img" width="720" height="400" loading="eager" />
        )}
      </header>

      <div class="blog-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-container {
    max-width: 720px;
  }

  .blog-header {
    margin-bottom: var(--space-12);
    padding-top: var(--space-16);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    color: var(--color-text-tertiary);
    font-size: 0.875rem;
  }

  .blog-tags {
    display: flex;
    gap: var(--space-2);
  }

  .blog-description {
    color: var(--color-text-secondary);
    margin-top: var(--space-4);
  }

  .blog-content :global(h2) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .blog-content :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .blog-content :global(p) {
    margin-bottom: var(--space-5);
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .blog-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .blog-content :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-5);
    margin-block: var(--space-6);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .blog-content :global(pre) {
    background: var(--color-bg-dark);
    color: #fff;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-5);
  }

  .blog-content :global(code) {
    font-size: 0.875em;
  }

  .blog-hero-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    margin-top: var(--space-8);
    object-fit: cover;
  }

  .blog-content :global(img) {
    border-radius: var(--radius-lg);
    margin-block: var(--space-6);
  }
</style>
