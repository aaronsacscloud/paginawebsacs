---
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PageTracker from '../components/PageTracker.astro';
import '../styles/global.css';
import { getLangFromUrl, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

import { SCHEMA_BASE } from '../data/entidad';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
  preloadImage?: string;
  /** Cuando true, omite Nav/Footer/WhatsApp/PageTracker — para experiencias enfocadas
      (cotizaciones, invitaciones, acuses, etc.) sin chrome de marketing. */
  bareLayout?: boolean;
  /** Path al manifest PWA. Si presente, agrega los meta tags necesarios para install. */
  manifestUrl?: string;
  /** Color del theme PWA (status bar). Default azul SACS. */
  themeColor?: string;
}

const { title, description, image, type, noindex, structuredData, preloadImage, bareLayout = false, manifestUrl, themeColor = '#4B7BE5' } = Astro.props;
const locale = Astro.props.locale || getLangFromUrl(Astro.url);
// `hreflangLinks`/`getHreflangLinks` se quitó (18-sep-2026): no existe ni una
// sola página en /en/, /fr/, /it/, /pt/ (ver el comentario del selector de
// idioma en Nav.astro), así que emitir hoy `<link rel="alternate" hreflang>`
// apuntaría a 404s. El día que existan esas páginas de verdad, se vuelve a
// calcular aquí y se imprime en el <head> junto al resto de SEO.

/* La identidad de Sacs vive en un solo archivo (src/data/entidad.ts). Antes se
   escribía aquí a mano y apuntaba a `sacs.com.mx`, un dominio que no responde:
   cada página del sitio le decía a Google y a los rastreadores de IA que Sacs
   vive en una dirección muerta, con un logo que daba 404. */
const schemasBase = SCHEMA_BASE();

const allSchemas = structuredData
  ? Array.isArray(structuredData)
    ? [...schemasBase, ...structuredData]
    : [...schemasBase, structuredData]
  : schemasBase;

import { POSTHOG_KEY, POSTHOG_HOST } from '../lib/posthog';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Sora-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ClashDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- La foto de portada YA lleva fetchpriority en su etiqueta. Aquí solo se
         precarga cuando la página declara una propia, porque en el inicio el
         elemento más grande es el título y la fuente tiene que ganar la carrera. -->
    {preloadImage && <link rel="preload" href={preloadImage} as="image" type="image/webp" fetchpriority="high" />}

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />

    <StructuredData data={allSchemas} />

    <!-- LA COMPUERTA DE MARKETING (17-sep-2026, auditoría de PageSpeed;
         retocada 19-sep-2026, auditoría de /planes — ver los dos bloques de
         comentarios abajo, son dos arreglos distintos sobre la misma idea).
         Los cuatro scripts de medición —Clarity, TikTok, OpenAI y PostHog— se
         cargaban en el primer instante y costaban caro: un segundo entero de
         evaluación de JavaScript en el hilo principal, 250 KB de descarga y 13
         cookies de terceros. Eso hundía la nota de rendimiento y la de buenas
         prácticas, y lo pagaba el visitante en el tiempo que tarda la página en
         responder al primer toque.

         Ahora se cargan cuando de verdad hacen falta, SIN perder un solo evento:

         · Si la visita viene de una campaña (trae utm, ttclid, gclid o fbclid),
           se cargan en el acto: a esa persona hay que medirla desde el primer
           segundo, que para eso se pagó el clic.
         · Si no, esperan al primer gesto —mover el dedo, hacer clic, teclear o
           empezar a bajar— y ahí cargan. Nadie que valga la pena medir llega sin
           hacer ninguna de esas cuatro cosas.
         · Y si alguien se queda quieto, entran solas a los 20 segundos.

         Mientras tanto las colas ya existen, así que un clic en WhatsApp hecho
         en el segundo uno se guarda y se manda en cuanto el pixel despierta.

         ARREGLO 1 — el "gesto" falso de /planes (causa real de que esa página
         sacara 74 de rendimiento en móvil, la peor del sitio, cuando el resto
         va en 93-100 con la MISMA compuerta): el carrusel de precios de
         planes.astro hace un `scrollIntoView()` al cargar, en viewport de
         móvil, para centrar la tarjeta destacada. Eso dispara un evento
         "scroll" nativo del navegador, y el listener de abajo —a propósito en
         `capture: true` para detectar el scroll de CUALQUIER contenedor, no
         solo el de window— lo veía igual que si el visitante hubiera movido
         el dedo. Resultado medido: la compuerta se abría a los ~400ms de
         cargar, SIEMPRE, sin campaña y sin visitante real, exactamente el
         comportamiento que se quería evitar. Lighthouse hace lo mismo que
         cualquier móvil real (viewport angosto), así que la auditoría
         reproducía el bug en cada corrida. El contador `sacsIgnorarScrollAuto`
         deja que planes.astro avise "el siguiente scroll es layout mío, no un
         gesto" justo antes de reposicionar el carrusel.

         ARREGLO 2 — el respaldo de 20s (y el gesto real) ya no disparan los
         cuatro scripts en la misma tarea del hilo principal: eso es
         precisamente lo que mide el Total Blocking Time. `escalona()` los
         reparte uno por uno en tiempo ocioso (`requestIdleCallback`, con
         `setTimeout` de respaldo donde no exista). El trabajo total es el
         mismo; ya no se paga junto. Solo la campaña real sigue siendo
         inmediata y sin escalonar: ahí la prioridad es la atribución, no el
         TBT. -->
    <script is:inline>
    (function () {
      var listo = false;

      // Reparte una lista de funciones en tiempo ocioso, una por tarea, para
      // que el navegador pueda pintar/responder entre una y otra.
      function escalona(tareas, i) {
        i = i || 0;
        if (i >= tareas.length) return;
        var siguiente = function () { tareas[i](); escalona(tareas, i + 1); };
        if (window.requestIdleCallback) window.requestIdleCallback(siguiente, { timeout: 1500 });
        else setTimeout(siguiente, 100);
      }

      function cargaClarity() {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "wad8td38cy");
      }
      function cargaTikTok() {
        if (window.ttq && window.ttq.load) { window.ttq.load('CUT9GN3C77UAVCG32N00'); window.ttq.page(); }
      }
      function cargaOpenAI() {
        if (window.sacsOaiCarga) window.sacsOaiCarga();
      }
      function cargaPostHog() {
        // ARREGLO 4 (19-sep-2026, mismo hallazgo que el 3): el script de
        // PostHog más abajo trae un `import`, así que Astro lo compila a
        // `<script type="module" src="...">` — se ejecuta DESPUÉS de bajar
        // ese archivo por red, no en el momento en que el parser lo
        // encuentra como los demás bloques `is:inline`. En una visita de
        // campaña, para cuando ese módulo por fin registraba su listener de
        // 'sacs:marketing', el evento YA se había disparado al vacío: PostHog
        // nunca despertaba en un anuncio pagado. Por eso, además del evento
        // (que sigue sirviendo para el caso normal, cuando el módulo ya
        // cargó), se deja una bandera que el módulo revisa al registrarse:
        // si ya está en true, no hace falta esperar el evento.
        window.__sacsMarketingAbierta = true;
        window.dispatchEvent(new Event('sacs:marketing'));
      }

      function arranca(urgente) {
        if (listo) return; listo = true;
        quita();
        var tareas = [cargaClarity, cargaTikTok, cargaOpenAI, cargaPostHog];
        if (urgente) {
          // Campaña real (o una conversión explícita vía sacsMarketingYa):
          // sin escalonar, se mide desde el primer instante.
          tareas.forEach(function (fn) { fn(); });
        } else {
          escalona(tareas);
        }
      }

      // Ver ARREGLO 1 arriba: silencia "scroll"/"wheel" por una VENTANA de
      // tiempo (no por cuenta de eventos) mientras el layout propio del sitio
      // se reacomoda (el carrusel de /planes), para no confundirlo con un
      // gesto real. Hace falta que sea por tiempo y no por cantidad: un solo
      // `scrollIntoView` con scroll-behavior heredado puede disparar DOCENAS
      // de eventos "scroll" (uno por frame de la animación), y un contador
      // que solo perdona el primero deja pasar el segundo como si fuera un
      // gesto de verdad. planes.astro ya fuerza `behavior:'instant'` para
      // evitar esa animación, pero esta ventana queda como red de seguridad.
      var silenciarScrollHasta = 0;
      window.sacsIgnorarScrollAuto = function (ms) {
        silenciarScrollHasta = Date.now() + (ms || 500);
      };

      var gestos = ['pointerdown', 'keydown', 'touchstart', 'scroll', 'wheel'];
      function onGesto(e) {
        if ((e.type === 'scroll' || e.type === 'wheel') && Date.now() < silenciarScrollHasta) {
          return;
        }
        arranca(false);
      }
      function quita() { gestos.forEach(function (g) { window.removeEventListener(g, onGesto, { capture: true }); }); }
      gestos.forEach(function (g) { window.addEventListener(g, onGesto, { capture: true, passive: true }); });
      var deCampana = /[?&](utm_|ttclid|gclid|fbclid|msclkid)/i.test(location.search);
      if (deCampana) {
        // ARREGLO 3 (19-sep-2026, hallado midiendo esta misma tarea, NO es un
        // efecto secundario del arreglo de rendimiento): en una visita de
        // campaña, `arranca(true)` se llamaba EN EL ACTO, en el instante en
        // que corre este primer <script> del <head> — antes de que se
        // ejecuten los bloques de abajo que definen `window.ttq`
        // (TikTok Pixel), `window.sacsOaiCarga` (OpenAI) y el listener de
        // `sacs:marketing` (PostHog). Resultado, verificado con Playwright
        // contra una visita con ttclid real: SOLO Clarity llegaba a cargar.
        // TikTok, OpenAI y PostHog nunca se ejecutaban en un anuncio pagado —
        // exactamente el caso que esta compuerta existe para proteger. Un
        // `setTimeout(…, 0)` alcanza: para cuando corre, el navegador ya
        // terminó de parsear/ejecutar los <script> síncronos que siguen en
        // este <head>, así que las tres quedan definidas. Sigue siendo
        // "en el acto" para cualquier propósito práctico (menos de 1ms de
        // diferencia) y YA NO se pierde la mitad de la medición.
        setTimeout(function () { arranca(true); }, 0);
      } else {
        setTimeout(function () { arranca(false); }, 20000);
      }
      // Safety net para conversiones explícitas (ver sacsPH en el bloque de
      // PostHog, más abajo): si alguien dispara un evento antes de que la
      // compuerta abra sola, se abre YA y sin escalonar — es una señal de
      // negocio, no hay que ahorrarle milisegundos al TBT a costa de perderla.
      window.sacsMarketingYa = function () { arranca(true); };
    })();
    </script>


    <!-- TikTok Pixel -->
    <script is:inline>
    !function (w, d, t) {
      w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};var a=document.createElement("script");a.type="text/javascript",a.async=!0,a.src=r+"?sdkid="+e+"&lib="+t;var s=document.getElementsByTagName("script")[0];s.parentNode.insertBefore(a,s)};
      /* ttq.load() y ttq.page() los dispara la compuerta de marketing (arriba):
         la cola de métodos ya está viva, así que nada se pierde mientras tanto. */
      // Enhanced matching: if visitor has email from previous session
      try {
        var v = localStorage.getItem('sacs_visitor_email');
        if (v) ttq.identify({ email: v });
      } catch(e) {}
    }(window, document, 'ttq');
    </script>

    <!-- OpenAI Pixel (oaiq) — atribución de campañas de marketing con OpenAI.
         Va en el <head> de TODAS las páginas porque este layout es la base.
         El evento de conversión NO va aquí: vive donde la accion ocurre
         (ver registro.astro), como pide la propia documentación de OpenAI. -->
    <script is:inline>
    /* La cola se crea ya para no perder eventos; el archivo del pixel lo baja la
   compuerta de marketing cuando la visita da su primer gesto. */
!function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;
  w.sacsOaiCarga=function(){if(w.__oaiCargado)return;w.__oaiCargado=1;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f);};
}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
    oaiq("init",{pixelId:"4qhBC3DP4VjKjFCHqmYbsS",debug:false});

    /* Envoltorio unico para medir con OpenAI desde cualquier pagina o isla de
       React. Evita repetir el try/catch y la guarda de existencia en cada
       llamada: si el SDK no cargo (bloqueador, sin red), no rompe nada. */
    window.sacsOai = function (evento, datos, extra) {
      try {
        if (typeof window.oaiq !== "undefined") {
          if (extra) window.oaiq("measure", evento, datos || {}, extra);
          else window.oaiq("measure", evento, datos || {});
        }
      } catch (e) {}
    };

    /* Clic a WhatsApp, medido en UN SOLO lugar.
       Antes vivia dentro de WhatsAppButton, asi que los OTROS enlaces a
       WhatsApp del sitio (el del menu, el de implementacion, el de prueba
       gratis) NO se median: el lead entraba por un anuncio, escribia desde el
       menu, y la conversion nunca llegaba a OpenAI.
       Con delegacion en document cualquier <a> que apunte a wa.me queda
       cubierto, incluidos los que se agreguen en el futuro. */
    document.addEventListener("click", function (e) {
      var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
      if (!a) return;
      var h = a.getAttribute("href") || "";
      if (h.indexOf("wa.me") === -1 && h.indexOf("api.whatsapp.com") === -1) return;
      /* Los CTA que traen data-giro los mide su propio manejador, que ademas
         sabe de que giro salio el clic. Si los midieramos aqui tambien,
         contarian doble en los dos pixeles. */
      if (a.dataset && a.dataset.giro) return;
      window.sacsOai("custom", { type: "custom" }, { custom_event_name: "mandowhatsapp" });
      /* TikTok no tenia esta delegacion: solo media el WhatsApp del nav, el de
         la barra de chat y el de los CTA de giro. Los del cierre de las paginas
         de giro (SuiteEnsamble), /prueba-gratis, implementacion y /contacto
         llegaban a OpenAI y nunca a TikTok. */
      if (typeof ttq !== "undefined") {
        ttq.track("Contact", { content_id: "whatsapp", content_name: "wa-" + location.pathname, content_type: "product" });
      }
    }, true);
    </script>

    <!-- PostHog — analitica de producto: por donde entran, hasta donde llegan y
         donde se caen. Complementa a los pixeles de campaña, que solo cuentan
         llegadas.

         Se instala como paquete y NO con el fragmento de CDN: con el loader
         remoto la instancia quedaba a medias —capture() salia sin enviar y no
         llegaba un solo evento al proyecto— y ademas el bundle dependia de un
         host externo. Importado por Astro queda una sola instancia, verificada.

         Tres decisiones de configuracion que importan:

         · person_profiles "identified_only": no se crea perfil por cada visita
           anonima. Un perfil por curioso multiplica el costo sin decir nada
           nuevo; la persona empieza a existir cuando deja su correo.
         · maskAllInputs: si algun dia se enciende la grabacion de sesion, lo
           que la gente teclea NO se graba. Es informacion de personas reales.
         · respect_dnt: si el navegador pide no ser rastreado, se respeta. -->
    <script>
      import { POSTHOG_KEY, POSTHOG_HOST } from '../lib/posthog';

      /* PostHog entra por la misma compuerta que los pixeles: su archivo pesa y
         se evalúa en el hilo principal, y hasta el primer gesto de la visita no
         hay nada que contar. Lo que SÍ vive desde el segundo cero es la cola:
         cualquier `sacsPH(...)` que ocurra antes se guarda y se manda entero
         cuando el SDK despierta. Así no se pierde ni el clic más temprano.

         19-sep-2026 (auditoría /planes): el chunk de posthog-js pesa 84 KB y
         su init tarda ~850ms de scripting — es el costo individual más caro
         de los cuatro scripts de marketing, más que TikTok o Clarity. Antes
         corría entero dentro del mismo evento 'sacs:marketing' que dispara la
         compuerta, así que competía por el mismo frame que Clarity/TikTok/
         OpenAI. Ahora ese trabajo pesado se manda a su PROPIO
         requestIdleCallback: la compuerta ya reparte cuándo se dispara el
         evento (ver BaseLayout, escalona()), y aquí se reparte OTRA VEZ el
         propio import()+init() para que no se junte con nada más. */
      let ph: any = null;
      const cola: Array<[string, Record<string, unknown>]> = [];
      let cargando = false;

      async function cargaYArranca() {
        if (ph || cargando) return;
        cargando = true;
        const mod = await import('posthog-js');
        ph = mod.default;
        ph.init(POSTHOG_KEY, {
          api_host: POSTHOG_HOST,
          person_profiles: 'identified_only',
          respect_dnt: true,
          session_recording: { maskAllInputs: true },
        });
        for (const [ev, props] of cola.splice(0)) { try { ph.capture(ev, props); } catch (e) {} }
      }
      function despierta() {
        const w = window as any;
        if (w.requestIdleCallback) w.requestIdleCallback(cargaYArranca, { timeout: 1500 });
        else setTimeout(cargaYArranca, 0);
      }
      /* ARREGLO 4 (ver el comentario en cargaPostHog(), en la Compuerta de
         Marketing arriba en este mismo archivo): este script es un `type=
         "module"` — Astro lo compila así por el `import` de arriba — y se
         ejecuta DESPUÉS de bajarlo por red, no en el momento en que el
         parser lo encuentra. En una visita de campaña la compuerta dispara
         'sacs:marketing' de inmediato, y ese módulo bien puede seguir sin
         llegar: el evento se perdía y PostHog nunca despertaba en un anuncio
         pagado (medido con Playwright). Por eso primero se revisa la bandera
         `__sacsMarketingAbierta` — si la compuerta ya abrió, se arranca
         directo sin esperar un evento que ya pasó. */
      const w = window as any;
      if (w.__sacsMarketingAbierta) despierta();
      else window.addEventListener('sacs:marketing', despierta, { once: true });

      /* Envoltorio unico, igual que sacsOai: si el SDK no cargo (bloqueador,
         sin red), nada de lo que sigue truena. */
      const captura = (evento: string, props?: Record<string, unknown>) => {
        if (ph) { try { ph.capture(evento, props || {}); } catch (e) {} }
        else { cola.push([evento, props || {}]); (window as any).sacsMarketingYa?.(); }
      };
      (window as any).sacsPH = captura;

      /* Los tres momentos que definen el embudo del sitio, medidos en un solo
         lugar por delegacion: sirve para los enlaces que ya existen y para los
         que se agreguen despues. */
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement)?.closest?.('a[href]');
        if (!a) return;
        const h = a.getAttribute('href') || '';
        const comun = {
          destino: h,
          texto: (a.textContent || '').trim().slice(0, 60),
          pagina: location.pathname,
        };

        if (h.includes('wa.me') || h.includes('api.whatsapp.com')) {
          captura('whatsapp_click', comun);
        } else if (h.includes('/contacto')) {
          captura('demo_click', comun);
        } else if (h.includes('/prueba-gratis') || h.includes('/registro')) {
          captura('prueba_click', comun);
        }
      }, true);
    </script>

    <!-- Partner attribution strip hydration -->
    <script is:inline>
    (function() {
      try {
        // Lee cookie sacs_ref_name (formato: encoded "Nombre|Tipo")
        var m = document.cookie.match(/(?:^|;\s*)sacs_ref_name=([^;]+)/);
        if (!m) return;
        var val = decodeURIComponent(m[1]);
        var parts = val.split('|');
        var name = parts[0] || '';
        var tipo = parts[1] || 'Partner SACS';
        if (!name) return;

        // El strip se muestra UNA SOLA VEZ por device + nombre de partner.
        // Si ya se mostró (cualquier dismiss o vista completa), no vuelve a aparecer.
        var storageKey = 'sacs_strip_seen_' + name.replace(/\s+/g, '_').toLowerCase();
        try {
          if (localStorage.getItem(storageKey) === '1') return;
        } catch (e) { /* localStorage bloqueado, mostrar de todas formas */ }

        function markSeen() {
          try { localStorage.setItem(storageKey, '1'); } catch (e) {}
        }

        function init() {
          var strip = document.getElementById('partner-strip');
          if (!strip) return;
          var nameEl = document.getElementById('partner-strip-name');
          var tipoEl = document.getElementById('partner-strip-tipo');
          var closeBtn = document.getElementById('partner-strip-close');
          if (nameEl) nameEl.textContent = name;
          if (tipoEl) tipoEl.textContent = ' · ' + tipo + ' oficial';
          strip.hidden = false;
          document.body.classList.add('has-partner-strip');

          // Auto-marcar como visto a los 12s (asume que el usuario lo leyó)
          var autoTimer = setTimeout(markSeen, 12000);

          if (closeBtn) {
            closeBtn.addEventListener('click', function() {
              clearTimeout(autoTimer);
              markSeen();
              strip.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
              strip.style.transform = 'translateX(-50%) translateY(120%)';
              strip.style.opacity = '0';
              setTimeout(function() {
                strip.hidden = true;
                document.body.classList.remove('has-partner-strip');
              }, 260);
            });
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      } catch (e) { /* ignore */ }
    })();
    </script>

