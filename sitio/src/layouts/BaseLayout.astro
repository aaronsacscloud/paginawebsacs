---
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PageTracker from '../components/PageTracker.astro';
import '../styles/global.css';
import { getLangFromUrl, getHreflangLinks, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
  preloadImage?: string;
  /** Cuando true, omite Nav/Footer/WhatsApp/PageTracker — para experiencias enfocadas
      (cotizaciones, invitaciones, acuses, etc.) sin chrome de marketing. */
  bareLayout?: boolean;
  /** Path al manifest PWA. Si presente, agrega los meta tags necesarios para install. */
  manifestUrl?: string;
  /** Color del theme PWA (status bar). Default azul SACS. */
  themeColor?: string;
}

const { title, description, image, type, noindex, structuredData, preloadImage, bareLayout = false, manifestUrl, themeColor = '#4B7BE5' } = Astro.props;
const locale = Astro.props.locale || getLangFromUrl(Astro.url);
const hreflangLinks = getHreflangLinks(Astro.url.pathname);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SACS',
  url: 'https://sacs.com.mx',
  logo: 'https://sacs.com.mx/logo.png',
  description: 'Sistema operativo empresarial para retailers conscientes en México.',
  areaServed: {
    '@type': 'Country',
    name: 'MX',
  },
  sameAs: [],
};

const allSchemas = structuredData
  ? Array.isArray(structuredData)
    ? [orgSchema, ...structuredData]
    : [orgSchema, structuredData]
  : [orgSchema];

import { POSTHOG_KEY, POSTHOG_HOST } from '../lib/posthog';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Sora-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Preload hero image (above-fold, LCP element) -->
    <link rel="preload" href={preloadImage || '/images/hero-sacs-store.webp'} as="image" type="image/webp" />

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />

    <StructuredData data={allSchemas} />

    <!-- Microsoft Clarity -->
    <script is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wad8td38cy");
    </script>

    <!-- TikTok Pixel -->
    <script is:inline>
    !function (w, d, t) {
      w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};var a=document.createElement("script");a.type="text/javascript",a.async=!0,a.src=r+"?sdkid="+e+"&lib="+t;var s=document.getElementsByTagName("script")[0];s.parentNode.insertBefore(a,s)};
      ttq.load('CUT9GN3C77UAVCG32N00');
      ttq.page();
      // Enhanced matching: if visitor has email from previous session
      try {
        var v = localStorage.getItem('sacs_visitor_email');
        if (v) ttq.identify({ email: v });
      } catch(e) {}
    }(window, document, 'ttq');
    </script>

    <!-- OpenAI Pixel (oaiq) — atribución de campañas de marketing con OpenAI.
         Va en el <head> de TODAS las páginas porque este layout es la base.
         El evento de conversión NO va aquí: vive donde la accion ocurre
         (ver registro.astro), como pide la propia documentación de OpenAI. -->
    <script is:inline>
    !function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
    oaiq("init",{pixelId:"4qhBC3DP4VjKjFCHqmYbsS",debug:false});

    /* Envoltorio unico para medir con OpenAI desde cualquier pagina o isla de
       React. Evita repetir el try/catch y la guarda de existencia en cada
       llamada: si el SDK no cargo (bloqueador, sin red), no rompe nada. */
    window.sacsOai = function (evento, datos, extra) {
      try {
        if (typeof window.oaiq !== "undefined") {
          if (extra) window.oaiq("measure", evento, datos || {}, extra);
          else window.oaiq("measure", evento, datos || {});
        }
      } catch (e) {}
    };

    /* Clic a WhatsApp, medido en UN SOLO lugar.
       Antes vivia dentro de WhatsAppButton, asi que los OTROS enlaces a
       WhatsApp del sitio (el del menu, el de implementacion, el de prueba
       gratis) NO se median: el lead entraba por un anuncio, escribia desde el
       menu, y la conversion nunca llegaba a OpenAI.
       Con delegacion en document cualquier <a> que apunte a wa.me queda
       cubierto, incluidos los que se agreguen en el futuro. */
    document.addEventListener("click", function (e) {
      var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
      if (!a) return;
      var h = a.getAttribute("href") || "";
      if (h.indexOf("wa.me") === -1 && h.indexOf("api.whatsapp.com") === -1) return;
      window.sacsOai("custom", { type: "custom" }, { custom_event_name: "mandowhatsapp" });
    }, true);
    </script>

    <!-- PostHog — analitica de producto: por donde entran, hasta donde llegan y
         donde se caen. Complementa a los pixeles de campaña, que solo cuentan
         llegadas.

         Se instala como paquete y NO con el fragmento de CDN: con el loader
         remoto la instancia quedaba a medias —capture() salia sin enviar y no
         llegaba un solo evento al proyecto— y ademas el bundle dependia de un
         host externo. Importado por Astro queda una sola instancia, verificada.

         Tres decisiones de configuracion que importan:

         · person_profiles "identified_only": no se crea perfil por cada visita
           anonima. Un perfil por curioso multiplica el costo sin decir nada
           nuevo; la persona empieza a existir cuando deja su correo.
         · maskAllInputs: si algun dia se enciende la grabacion de sesion, lo
           que la gente teclea NO se graba. Es informacion de personas reales.
         · respect_dnt: si el navegador pide no ser rastreado, se respeta. -->
    <script>
      import posthog from 'posthog-js';
      import { POSTHOG_KEY, POSTHOG_HOST } from '../lib/posthog';

      posthog.init(POSTHOG_KEY, {
        api_host: POSTHOG_HOST,
        person_profiles: 'identified_only',
        respect_dnt: true,
        session_recording: { maskAllInputs: true },
      });

      /* Envoltorio unico, igual que sacsOai: si el SDK no cargo (bloqueador,
         sin red), nada de lo que sigue truena. */
      (window as any).sacsPH = function (evento: string, props?: Record<string, unknown>) {
        try { posthog.capture(evento, props || {}); } catch (e) {}
      };

      /* Los tres momentos que definen el embudo del sitio, medidos en un solo
         lugar por delegacion: sirve para los enlaces que ya existen y para los
         que se agreguen despues. */
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement)?.closest?.('a[href]');
        if (!a) return;
        const h = a.getAttribute('href') || '';
        const comun = {
          destino: h,
          texto: (a.textContent || '').trim().slice(0, 60),
          pagina: location.pathname,
        };

        if (h.includes('wa.me') || h.includes('api.whatsapp.com')) {
          posthog.capture('whatsapp_click', comun);
        } else if (h.includes('/contacto')) {
          posthog.capture('demo_click', comun);
        } else if (h.includes('/prueba-gratis') || h.includes('/registro')) {
          posthog.capture('prueba_click', comun);
        }
      }, true);
    </script>

    <!-- Partner attribution strip hydration -->
    <script is:inline>
    (function() {
      try {
        // Lee cookie sacs_ref_name (formato: encoded "Nombre|Tipo")
        var m = document.cookie.match(/(?:^|;\s*)sacs_ref_name=([^;]+)/);
        if (!m) return;
        var val = decodeURIComponent(m[1]);
        var parts = val.split('|');
        var name = parts[0] || '';
        var tipo = parts[1] || 'Partner SACS';
        if (!name) return;

        // El strip se muestra UNA SOLA VEZ por device + nombre de partner.
        // Si ya se mostró (cualquier dismiss o vista completa), no vuelve a aparecer.
        var storageKey = 'sacs_strip_seen_' + name.replace(/\s+/g, '_').toLowerCase();
        try {
          if (localStorage.getItem(storageKey) === '1') return;
        } catch (e) { /* localStorage bloqueado, mostrar de todas formas */ }

        function markSeen() {
          try { localStorage.setItem(storageKey, '1'); } catch (e) {}
        }

        function init() {
          var strip = document.getElementById('partner-strip');
          if (!strip) return;
          var nameEl = document.getElementById('partner-strip-name');
          var tipoEl = document.getElementById('partner-strip-tipo');
          var closeBtn = document.getElementById('partner-strip-close');
          if (nameEl) nameEl.textContent = name;
          if (tipoEl) tipoEl.textContent = ' · ' + tipo + ' oficial';
          strip.hidden = false;
          document.body.classList.add('has-partner-strip');

          // Auto-marcar como visto a los 12s (asume que el usuario lo leyó)
          var autoTimer = setTimeout(markSeen, 12000);

          if (closeBtn) {
            closeBtn.addEventListener('click', function() {
              clearTimeout(autoTimer);
              markSeen();
              strip.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
              strip.style.transform = 'translateX(-50%) translateY(120%)';
              strip.style.opacity = '0';
              setTimeout(function() {
                strip.hidden = true;
                document.body.classList.remove('has-partner-strip');
              }, 260);
            });
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      } catch (e) { /* ignore */ }
    })();
    </script>

    <!-- Font face declarations -->
    <style is:inline>
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/PlusJakartaSans-Light.woff2') format('woff2');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/PlusJakartaSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/PlusJakartaSans-Medium.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/PlusJakartaSans-SemiBold.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/PlusJakartaSans-Bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/PlusJakartaSans-ExtraBold.woff2') format('woff2');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
      }
      /* Sora */
      @font-face {
        font-family: 'Sora';
        src: url('/fonts/Sora-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sora';
        src: url('/fonts/Sora-Medium.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sora';
        src: url('/fonts/Sora-SemiBold.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sora';
        src: url('/fonts/Sora-Bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sora';
        src: url('/fonts/Sora-ExtraBold.woff2') format('woff2');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
      }
      /* Clash Display (wordmark) */
      @font-face {
        font-family: 'Clash Display';
        src: url('/fonts/ClashDisplay-Bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      /* Critical: hide nav dropdowns & mobile menu before component CSS loads */
      .mega-dropdown { visibility: hidden; opacity: 0; position: absolute; }
      .mega-backdrop { display: none; }
      .mega-backdrop.active { display: block; }
      .mobile-menu { display: none; }
      .mobile-menu.open { display: block; }
      .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; height: 71px; background: #fff; }
      .nav-inner { display: flex; align-items: center; height: 100%; }
      .wa-bar { opacity: 0; pointer-events: none; }
    </style>

    {manifestUrl && (
      <>
        <link rel="manifest" href={manifestUrl} />
        <meta name="theme-color" content={themeColor} />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
        <meta name="apple-mobile-web-app-title" content="SACS Partner" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
      </>
    )}
  </head>
  <body class={bareLayout ? 'is-bare' : undefined}>
    {!bareLayout && (
      <a href="#main-content" class="skip-link">{t('common.skipToContent', locale)}</a>
    )}

    {/* Partner attribution toast · bottom-center · se hidrata client-side desde cookie sacs_ref_name */}
    {!bareLayout && (
      <div id="partner-strip" class="partner-strip" hidden>
        <div class="partner-strip-inner">
          <span class="partner-strip-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <div class="partner-strip-text">
            <div class="partner-strip-text-line">Te recomendó</div>
            <strong id="partner-strip-name"></strong>
            <span class="partner-strip-text-sub" id="partner-strip-tipo"></span>
          </div>
          <button id="partner-strip-close" class="partner-strip-close" aria-label="Cerrar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    )}

    {!bareLayout && <Nav locale={locale} />}
    <main id="main-content">
      <slot />
    </main>
    {!bareLayout && <Footer locale={locale} />}
    {!bareLayout && <WhatsAppButton locale={locale} />}
    {!bareLayout && <PageTracker />}

    <!-- Coming soon modal -->
    <div class="cs-modal-overlay" id="cs-modal" aria-hidden="true">
      <div class="cs-modal">
        <button class="cs-modal-close" id="cs-modal-close" aria-label={t('modal.close', locale)}>&times;</button>
        <div class="cs-modal-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h2 class="cs-modal-title">{t('modal.title', locale)}</h2>
        <p class="cs-modal-subtitle">{t('modal.subtitle', locale)}</p>
        <p class="cs-modal-desc">{t('modal.desc', locale)}</p>
        <a href="/contacto" class="cs-modal-btn">{t('modal.cta', locale)}</a>
      </div>
    </div>

    <style>
      /* Partner attribution toast — bottom-center, no intrusivo */
      .partner-strip {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%);
        z-index: 1001;
        background: #fff;
        color: #1a1a1a;
        padding: 14px 16px 14px 18px;
        font-family: var(--font-body, system-ui);
        font-size: 0.8125rem;
        font-weight: 500;
        line-height: 1.4;
        border-radius: 14px;
        box-shadow: 0 20px 50px -10px rgba(0,0,0,0.18), 0 8px 16px -6px rgba(0,0,0,0.06);
        border: 1px solid rgba(75,123,229,0.18);
        max-width: calc(100vw - 32px);
        animation: pstrip-slide-up 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        letter-spacing: -0.005em;
      }
      .partner-strip[hidden] { display: none !important; }
      @keyframes pstrip-slide-up {
        from { transform: translate(-50%, calc(100% + 24px)); opacity: 0; }
        to   { transform: translate(-50%, 0); opacity: 1; }
      }
      .partner-strip-inner {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .partner-strip-icon {
        flex-shrink: 0;
        width: 36px; height: 36px;
        border-radius: 50%;
        background: rgba(75,123,229,0.10);
        color: #4B7BE5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .partner-strip-text {
        flex: 1;
        min-width: 0;
      }
      .partner-strip-text-line {
        font-size: 11px;
        color: #737373;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 2px;
      }
      .partner-strip-text strong {
        font-weight: 700;
        color: #1a1a1a;
        font-size: 13px;
      }
      .partner-strip-text-sub {
        font-size: 12px;
        color: #737373;
      }
      .partner-strip-close {
        flex-shrink: 0;
        background: transparent;
        border: none;
        color: #a3a3a3;
        line-height: 1;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s, background 0.15s;
      }
      .partner-strip-close:hover {
        background: #f5f5f3;
        color: #1a1a1a;
      }
      @media (max-width: 640px) {
        .partner-strip {
          bottom: 16px;
          padding: 12px 12px 12px 14px;
          font-size: 12px;
        }
        .partner-strip-icon { width: 32px; height: 32px; }
      }

      .cs-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 10000;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
        padding: 24px;
      }
      .cs-modal-overlay.is-open {
        opacity: 1;
        visibility: visible;
      }
      .cs-modal {
        background: #fff;
        border-radius: 20px;
        padding: 48px 40px;
        max-width: 420px;
        width: 100%;
        text-align: center;
        position: relative;
        transform: scale(0.95) translateY(10px);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .cs-modal-overlay.is-open .cs-modal {
        transform: scale(1) translateY(0);
      }
      .cs-modal-close {
        position: absolute;
        top: 16px;
        right: 20px;
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--color-text-tertiary);
        cursor: pointer;
        line-height: 1;
        padding: 4px;
      }
      .cs-modal-close:hover {
        color: var(--color-text-primary);
      }
      .cs-modal-icon {
        margin-bottom: 16px;
      }
      .cs-modal-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--color-text-primary);
        letter-spacing: -0.03em;
        margin: 0 0 4px;
      }
      .cs-modal-subtitle {
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-primary);
        margin: 0 0 16px;
      }
      .cs-modal-desc {
        font-family: var(--font-body);
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin: 0 0 24px;
      }
      .cs-modal-btn {
        display: inline-block;
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 700;
        color: #fff;
        background: var(--color-primary);
        padding: 12px 28px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.2s ease;
      }
      .cs-modal-btn:hover {
        background: var(--color-primary-hover);
        text-decoration: none;
      }
      @media (max-width: 480px) {
        .cs-modal {
          padding: 36px 28px;
        }
      }
    </style>

    <script>
      {
        const modal = document.getElementById('cs-modal');
        const closeBtn = document.getElementById('cs-modal-close');

        // Links that should trigger the modal
        const comingSoonSelectors = [
          'a[href="#"]',
          'a[href="/nosotros"]',
          'a[href="/manifiesto"]',
          'a[href="/componentes"]',
        ];

        const links = document.querySelectorAll(comingSoonSelectors.join(','));

        links.forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            if (modal) modal.classList.add('is-open');
          });
        });

        if (closeBtn && modal) {
          closeBtn.addEventListener('click', () => modal.classList.remove('is-open'));
          modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.classList.remove('is-open');
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') modal.classList.remove('is-open');
          });
        }
      }
    </script>

    <!-- Atribución de marketing (cookie sacs_attr) + tracking de CTAs -->
    <script is:inline>
    (function () {
      // De dónde venía quien está leyendo esto. Se guarda en COOKIE, no en
      // sessionStorage: el que ve el anuncio hoy y agenda mañana llegaba al
      // CRM como "tráfico directo" y la campaña que lo pagó se perdía.
      // El servidor lo lee en src/lib/atribucion-marketing.ts.
      var COOKIE = 'sacs_attr', DIAS = 90, MAX = 200;
      var CLICK_IDS = ['gclid', 'fbclid', 'ttclid', 'msclkid'];
      var UTM = { utm_source: 's', utm_medium: 'm', utm_campaign: 'c', utm_content: 'co', utm_term: 't' };

      function corta(v) { return v ? String(v).slice(0, MAX) : ''; }

      function leer() {
        try {
          var m = document.cookie.match(/(?:^|;\s*)sacs_attr=([^;]+)/);
          return m ? JSON.parse(decodeURIComponent(m[1])) : null;
        } catch (e) { return null; }
      }

      function guardar(a) {
        try {
          var exp = new Date(Date.now() + DIAS * 86400000).toUTCString();
          document.cookie = COOKIE + '=' + encodeURIComponent(JSON.stringify(a)) +
            ';Path=/;Expires=' + exp + ';SameSite=Lax' +
            (location.protocol === 'https:' ? ';Secure' : '');
        } catch (e) {}
      }

      var params = new URLSearchParams(window.location.search);
      var landing = location.pathname + location.search;
      var ref = document.referrer || '';

      // El agendador vive dentro de un <iframe> en /contacto y ahí la query
      // string del padre NO llega. El referrer del iframe SÍ es la URL del
      // padre completa, con sus utm: de ahí se recupera.
      if (window.top !== window.self && ref.indexOf(location.origin) === 0) {
        try {
          var padre = new URL(ref);
          params = padre.searchParams;
          landing = padre.pathname + padre.search;
          ref = '';
        } catch (e) {}
      }

      var externo = (ref && ref.indexOf(location.origin) !== 0) ? ref : '';
      var toque = {}, identificable = false;

      for (var k in UTM) {
        var v = params.get(k);
        if (v) { toque[UTM[k]] = corta(v); identificable = true; }
      }
      var cl = {};
      for (var i = 0; i < CLICK_IDS.length; i++) {
        var cv = params.get(CLICK_IDS[i]);
        if (cv) { cl[CLICK_IDS[i]] = corta(cv); identificable = true; }
      }
      if (Object.keys(cl).length) toque.cl = cl;
      if (externo) { toque.rf = corta(externo); identificable = true; }
      toque.lp = corta(landing);
      toque.ts = Date.now();

      // Se valida el TIPO, no solo que haya algo. `leer()` solo se protege de
      // JSON inválido; una cookie con JSON VÁLIDO pero no-objeto (`"x"`, `5`,
      // `[]`) pasaba el `||` y, como este script es `is:inline` (modo sloppy),
      // `a.vid = …` y `a.n = …` eran no-ops SILENCIOSOS y `guardar(a)` reescribía
      // la misma basura con otros 90 días de vida: ese navegador no volvía a
      // atribuir nada nunca, sin error y sin auto-repararse.
      var a = leer();
      if (!a || typeof a !== 'object' || Array.isArray(a)) a = { v: 1 };
      if (!a.vid) a.vid = Math.random().toString(36).slice(2) + Date.now().toString(36);
      // Las páginas vistas NO se cuentan dentro de un iframe: el agendador de
      // /contacto usa este mismo layout, así que el script corre en el padre y
      // otra vez en el iframe y cada visita a /contacto sumaba 2. El contador
      // salía inflado justo en la página que más pesa para calificar al lead.
      if (window.top === window.self) a.n = (a.n || 0) + 1;
      // El PRIMER toque no se pisa nunca: es cómo nos conoció.
      if (!a.p) a.p = toque;
      if (identificable || !a.u) a.u = toque;
      guardar(a);

      // Compatibilidad: /prueba-gratis y /registro siguen leyendo sessionStorage.
      try {
        var o = a.u || a.p || {};
        var ss = { utm_source: o.s, utm_medium: o.m, utm_campaign: o.c, utm_content: o.co, utm_term: o.t, ttclid: (o.cl || {}).ttclid };
        for (var sk in ss) if (ss[sk]) sessionStorage.setItem(sk, ss[sk]);
      } catch (e) {}

      // ─── Tracking de CTAs + UTMs en los links de conversión ───
      var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'ttclid'];
      document.addEventListener('click', function (e) {
        var el = e.target;
        while (el && el !== document) {
          if (el.tagName === 'A' && el.href) {
            if (el.href.indexOf('/prueba-gratis') > -1) {
              if (typeof ttq !== 'undefined') {
                ttq.track('ClickButton', { content_id: 'prueba-gratis', content_name: 'cta-prueba-7-dias', content_type: 'product' });
              }
              var stored = new URLSearchParams();
              utmKeys.forEach(function (k) {
                var sv = sessionStorage.getItem(k);
                if (sv) stored.set(k, sv);
              });
              var qs = stored.toString();
              if (qs && el.href.indexOf('utm_') === -1) {
                el.href = el.href + (el.href.indexOf('?') > -1 ? '&' : '?') + qs;
              }
            }
            if (el.href.indexOf('/contacto') > -1) {
              if (typeof ttq !== 'undefined') {
                ttq.track('ClickButton', { content_id: 'agenda-demo', content_name: 'agenda-demo', content_type: 'product' });
              }
            }
            // ─── CTA de demo por WhatsApp (menú de giros, /giros, fichas) ───
            // El link va DIRECTO a wa.me: la conversión nunca depende de que
            // esta telemetría funcione. data-giro lo pone quien pinta el CTA.
            if (el.dataset && el.dataset.giro) {
              var giro = el.dataset.giro;
              if (typeof ttq !== 'undefined') {
                ttq.track('Contact', { content_id: 'whatsapp-giro', content_name: 'demo-giro-' + giro, content_type: 'product' });
              }
              if (window.sacsOai) window.sacsOai('custom', { type: 'custom' }, { custom_event_name: 'mandowhatsapp' });
              try {
                var payload = JSON.stringify({ giro: giro, contexto: el.dataset.giroContexto || '' });
                var enviado = navigator.sendBeacon && navigator.sendBeacon('/api/wa-intento', new Blob([payload], { type: 'application/json' }));
                if (!enviado) {
                  fetch('/api/wa-intento', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(function () {});
                }
              } catch (err) {}
            }
            break;
          }
          el = el.parentElement;
        }
      });
    })();
    </script>
  </body>
</html>
