---
/**
 * /en/apparel-pos — targets "apparel POS" / "point of sale for boutique".
 *
 * Paired in hreflang with /producto/punto-de-venta (src/i18n/utils.ts).
 * Features listed here are pulled from the real comparison table in
 * src/data/plans.ts (comparisonCategories, "Cobrar en el piso de venta" and
 * "Apartados, abonos y pedidos") — translated and reworded, not invented.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnHeader from '../../components/en/EnHeader.astro';
import EnFooter from '../../components/en/EnFooter.astro';
import EnClose from '../../components/en/EnClose.astro';
import { SITIO, PRODUCTO_ID } from '../../data/entidad';
import { breadcrumbList } from '../../lib/breadcrumb';

const features = [
  { title: 'Sells with or without internet', desc: 'The register keeps ringing up sales if the connection drops, and syncs the moment it comes back — no "sorry, the system is down" at the counter.' },
  { title: 'Holds a sale mid-fitting', desc: 'A customer tries on another size or color: the sale pauses instead of forcing a cancel-and-restart, and picks back up where it left off.' },
  { title: 'Retail and wholesale price lists, same register', desc: 'A customer buying one piece and a buyer ordering a dozen check out on the same POS, at the price list that applies to each.' },
  { title: 'Exchanges and returns from the counter', desc: 'A size or color exchange, a return to the original payment method, or an exchange started in one store and finished in another.' },
  { title: 'Deposits and layaway', desc: 'Take a deposit against a hold or a special order, with partial payments tracked until it is paid off.' },
  { title: 'WhatsApp receipts', desc: 'Send the ticket by WhatsApp instead of only printing it — useful at a trade show booth or a pop-up with no receipt printer.' },
  { title: 'Multiple sellers ringing up sales at once', desc: 'More than one person can check customers out at the same time on busy days, without waiting on a single register.' },
  { title: 'Cash drawer counts and close-outs', desc: 'Standard cash reconciliation (arqueos) and end-of-shift close-outs (cortes de caja), built in.' },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITIO}/en/apparel-pos#app`,
  name: 'Sacs Apparel POS',
  description: 'A point of sale built around size and color for apparel and footwear stores: holds sales, layaway, exchanges, wholesale price lists, and offline selling.',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Point of Sale Software',
  operatingSystem: 'Web',
  isPartOf: { '@id': PRODUCTO_ID },
  inLanguage: 'en-US',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Boutiques, apparel and footwear stores, and fashion brands with a physical counter',
  },
  featureList: features.map((f) => f.title),
};

const faqs = [
  {
    q: 'Does an apparel POS need to be different from a generic retail POS?',
    a: "For a fashion store, yes. A generic POS rings up a flat product; a fashion counter needs to pause a sale mid-fitting, exchange a size at a different store than the sale happened, and check out a wholesale buyer at a different price list than a retail customer — on the same register.",
  },
  {
    q: 'Can I keep selling if the internet goes down?',
    a: 'Yes. The point of sale keeps taking sales offline and syncs stock and tickets automatically once the connection is back.',
  },
  {
    q: 'Does it handle both retail and wholesale checkout?',
    a: 'Yes — retail, mid-wholesale and wholesale price lists live on the same inventory and the same register, applied by customer type or order quantity.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const breadcrumb = breadcrumbList([
  { name: 'Home', url: `${SITIO}/en` },
  { name: 'Apparel POS' },
]);

const structuredData = [softwareSchema, faqSchema, breadcrumb];
---

<BaseLayout
  title="Apparel POS software for fashion stores — Sacs"
  description="A point of sale built for fashion, not a generic register: size and colour, layaway, wholesale and retail price lists, offline selling and WhatsApp receipts."
  locale="en"
  structuredData={structuredData}
  bareLayout
>
  <EnHeader />

  <section class="en-hero">
    <div class="en-container">
      <span class="en-eyebrow">Apparel POS</span>
      <h1 class="en-h1">A point of sale that understands size, color and a fitting room</h1>
      <p class="en-sub">
        A generic register rings up a flat product and calls it done. A
        fashion counter needs more: a sale that pauses while a customer tries
        another size, a wholesale buyer checking out at a different price
        list than a walk-in, and a register that keeps working when the
        internet doesn't.
      </p>
      <div class="en-ctas">
        <a href="/prueba-gratis" class="en-btn en-btn-primary">Try 7 days free</a>
        <a href="/producto/punto-de-venta" class="en-btn en-btn-outline">Full feature list (ES)</a>
      </div>
    </div>
  </section>

  <section class="en-features">
    <div class="en-container">
      <div class="en-header-block">
        <span class="en-eyebrow">On the counter, today</span>
        <h2 class="en-h2">What a fashion store's POS needs that a generic one skips</h2>
      </div>
      <div class="en-features-grid">
        {features.map((f) => (
          <div class="en-feature">
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="en-next">
    <div class="en-container en-next-inner">
      <div>
        <span class="en-eyebrow">Related</span>
        <h2 class="en-h2">The POS is one piece of the catalog</h2>
      </div>
      <div class="en-next-grid">
        <a href="/en/size-and-color-inventory" class="en-next-card">Size &amp; color inventory — what feeds the register</a>
        <a href="/en/fashion-erp" class="en-next-card">Fashion ERP — distribution across stores</a>
        <a href="/en/wholesale-apparel-software" class="en-next-card">Wholesale — the same register, a buyer's price list</a>
        <a href="/en/pricing" class="en-next-card">Pricing — plans and what's included</a>
      </div>
    </div>
  </section>

  <EnClose />
  <EnFooter />

  <style>
    .en-container { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
    .en-eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-primary-texto); display: block; margin-bottom: 14px; }
    .en-h1 { font-family: var(--font-display); font-size: clamp(2rem, 4.2vw, 2.9rem); font-weight: 700; color: var(--color-text-primary); max-width: 820px; margin: 0 auto; letter-spacing: -0.02em; }
    .en-h2 { font-family: var(--font-display); font-size: clamp(1.5rem, 2.8vw, 2.125rem); font-weight: 700; color: var(--color-text-primary); }
    .en-sub { margin: 18px auto 0; max-width: 680px; font-size: clamp(1rem, 1.6vw, 1.125rem); line-height: 1.65; color: var(--color-text-secondary); }
    .en-hero { padding: clamp(56px, 9vw, 100px) 0 clamp(48px, 7vw, 80px); background: var(--color-bg-secondary); text-align: center; }
    .en-ctas { margin-top: 28px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .en-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 10px; font-weight: 700; font-size: 0.9375rem; text-decoration: none; transition: background 0.15s ease, transform 0.15s ease; }
    .en-btn-primary { background: var(--color-primary-btn, #4470D8); color: #fff; }
    .en-btn-primary:hover { background: var(--color-primary-hover); transform: translateY(-1px); }
    .en-btn-outline { border: 1.5px solid var(--color-border); color: var(--color-text-primary); background: #fff; }
    .en-btn-outline:hover { border-color: var(--color-primary-texto); color: var(--color-primary-texto); }

    .en-features { padding: clamp(64px, 9vw, 110px) 0; background: #fff; }
    .en-header-block { text-align: center; margin-bottom: 44px; }
    .en-features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .en-feature { padding: 24px 24px; background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: 14px; }
    .en-feature h3 { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); margin: 0 0 8px; }
    .en-feature p { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-secondary); margin: 0; }

    .en-next { padding: clamp(56px, 8vw, 100px) 0; background: var(--color-bg-secondary); }
    .en-next-inner { display: flex; flex-direction: column; gap: 28px; }
    .en-next-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .en-next-card { display: block; padding: 20px 22px; background: #fff; border: 1px solid var(--color-border-light); border-radius: 12px; font-weight: 700; font-size: 0.9375rem; color: var(--color-text-primary); text-decoration: none; transition: border-color 0.15s ease; }
    .en-next-card:hover { border-color: var(--color-primary-texto); color: var(--color-primary-texto); }

    @media (max-width: 760px) {
      .en-features-grid, .en-next-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
