---
/**
 * /en/fashion-erp — targets "fashion ERP" / "apparel ERP" search intent.
 *
 * Paired in hreflang with /enterprise (src/i18n/utils.ts,
 * HREFLANG_PARES_ES_EN): that's the closest real page in Spanish — same
 * audience (brands and manufacturers with a warehouse, several stores,
 * wholesale and ecommerce), not a literal translation. Content below is
 * grounded in what /enterprise and plans.ts actually list as live
 * capabilities (Control and Automate plans) — nothing here is roadmap
 * described as shipped.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnHeader from '../../components/en/EnHeader.astro';
import EnFooter from '../../components/en/EnFooter.astro';
import EnClose from '../../components/en/EnClose.astro';
import { SITIO, PRODUCTO_ID } from '../../data/entidad';
import { breadcrumbList } from '../../lib/breadcrumb';

const capabilities = [
  {
    title: 'The size-and-color grid is the base unit',
    desc: "A generic ERP treats a product as one SKU with a quantity. A style isn't one SKU — it's a size run across colors, and the count that matters is per size, per color, per store. Sacs builds inventory around that grid from the start, not as a workaround bolted onto a flat product table.",
  },
  {
    title: 'Distribution from your warehouse (CEDIS)',
    desc: 'The first shipment of the season gets allocated to each store from your distribution center, with receiving done by scanning cases in — not a spreadsheet reconciled after the fact.',
  },
  {
    title: 'Sell-through, ABC and rotation, by store',
    desc: 'How each style is moving by week of life, what is about to sell out, and what is turning into markdown stock — read weekly across every location, not once a season.',
  },
  {
    title: 'AI-assisted stock leveling',
    desc: "A size that isn't moving in one store and is running out in another gets proposed as a transfer by the system; your team approves it. This is on the Automate plan — it's live today, not on a roadmap.",
  },
  {
    title: 'Wholesale and retail on one catalog',
    desc: 'Retail, mid-wholesale and wholesale price lists on the same inventory — one style, one stock count, different prices by customer type and order quantity.',
  },
  {
    title: 'Ecommerce and social channels on the same stock',
    desc: 'Online store, Facebook, Instagram and TikTok Shop pull from the same inventory as your physical stores. Nothing gets re-published or re-counted per channel.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITIO}/en/fashion-erp#app`,
  name: 'Sacs Fashion ERP',
  description: 'The operational core a fashion ERP needs: size and color inventory, warehouse distribution, sell-through reporting, wholesale + retail on one catalog, and AI-assisted stock leveling.',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Retail Management Software',
  operatingSystem: 'Web',
  isPartOf: { '@id': PRODUCTO_ID },
  inLanguage: 'en-US',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Fashion brands and manufacturers with a warehouse, multiple stores, wholesale and ecommerce',
  },
  featureList: capabilities.map((c) => c.title),
};

const faqs = [
  {
    q: 'Is Sacs a full accounting ERP?',
    a: "No, and it isn't trying to replace one. Sacs is the layer that runs stores, inventory, distribution and ecommerce for a fashion business. If your corporate office already runs an accounting ERP, Sacs connects to it by API and your books stay where they are.",
  },
  {
    q: "What makes a fashion ERP different from a generic one?",
    a: 'The base unit. A generic ERP counts a flat SKU; a fashion business needs the count per size and color, the health of the size curve, sell-through by week of life, and a season structure (temporada, colección, drop) instead of a static product catalog.',
  },
  {
    q: 'Does this work for a brand that also sells wholesale?',
    a: 'Yes — retail and wholesale price lists live on the same inventory, so a style sold at wholesale and at retail is one stock count, not two systems that have to be reconciled.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const breadcrumb = breadcrumbList([
  { name: 'Home', url: `${SITIO}/en` },
  { name: 'Fashion ERP' },
]);

const structuredData = [softwareSchema, faqSchema, breadcrumb];
---

<BaseLayout
  title="Fashion ERP for apparel brands and retailers — Sacs"
  description="What a fashion ERP needs that a generic one doesn't: size and color grids, warehouse distribution, sell-through by store, wholesale + retail on one catalog, and AI-assisted stock leveling."
  locale="en"
  structuredData={structuredData}
  bareLayout
>
  <EnHeader />

  <section class="en-hero">
    <div class="en-container">
      <span class="en-eyebrow">Fashion ERP</span>
      <h1 class="en-h1">A fashion ERP needs a different base unit than a generic one</h1>
      <p class="en-sub">
        Accounting software treats a product as a SKU with a quantity. A
        fashion business sells a size run across colors, and the number that
        actually matters is the count per size, per color, per store — that
        is the unit Sacs is built around, not an add-on to a flat catalog.
      </p>
      <div class="en-ctas">
        <a href="/contacto" class="en-btn en-btn-primary">Book an operations walkthrough</a>
        <a href="/enterprise" class="en-btn en-btn-outline">See Sacs Enterprise (ES)</a>
      </div>
    </div>
  </section>

  <section class="en-caps">
    <div class="en-container">
      <div class="en-header-block">
        <span class="en-eyebrow">Live today</span>
        <h2 class="en-h2">The season, covered from receiving to markdown</h2>
        <p class="en-header-sub">Every item below is a shipped feature, not a roadmap promise.</p>
      </div>
      <div class="en-caps-grid">
        {capabilities.map((c) => (
          <div class="en-cap">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="en-next">
    <div class="en-container en-next-inner">
      <div>
        <span class="en-eyebrow">Related</span>
        <h2 class="en-h2">If you're evaluating a specific piece</h2>
      </div>
      <div class="en-next-grid">
        <a href="/en/apparel-pos" class="en-next-card">Apparel POS — the counter and the floor</a>
        <a href="/en/wholesale-apparel-software" class="en-next-card">Wholesale software — one catalog, retail + B2B</a>
        <a href="/en/size-and-color-inventory" class="en-next-card">Size &amp; color inventory — the grid itself</a>
        <a href="/en/pricing" class="en-next-card">Pricing — plans and what's included</a>
      </div>
    </div>
  </section>

  <EnClose
    title="Want to see it against your own catalog?"
    demoDesc="Bring a real style with its size run and we'll show how the inventory, distribution and sell-through modules actually behave with it."
  />
  <EnFooter />

  <style>
    .en-container { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
    .en-eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-primary-texto); display: block; margin-bottom: 14px; }
    .en-h1 { font-family: var(--font-display); font-size: clamp(2rem, 4.2vw, 2.9rem); font-weight: 700; color: var(--color-text-primary); max-width: 820px; margin: 0 auto; letter-spacing: -0.02em; }
    .en-h2 { font-family: var(--font-display); font-size: clamp(1.5rem, 2.8vw, 2.125rem); font-weight: 700; color: var(--color-text-primary); }
    .en-sub { margin: 18px auto 0; max-width: 680px; font-size: clamp(1rem, 1.6vw, 1.125rem); line-height: 1.65; color: var(--color-text-secondary); }
    .en-hero { padding: clamp(56px, 9vw, 100px) 0 clamp(48px, 7vw, 80px); background: var(--color-bg-secondary); text-align: center; }
    .en-ctas { margin-top: 28px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .en-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 10px; font-weight: 700; font-size: 0.9375rem; text-decoration: none; transition: background 0.15s ease, transform 0.15s ease; }
    .en-btn-primary { background: var(--color-primary-btn, #4470D8); color: #fff; }
    .en-btn-primary:hover { background: var(--color-primary-hover); transform: translateY(-1px); }
    .en-btn-outline { border: 1.5px solid var(--color-border); color: var(--color-text-primary); background: #fff; }
    .en-btn-outline:hover { border-color: var(--color-primary-texto); color: var(--color-primary-texto); }

    .en-caps { padding: clamp(64px, 9vw, 110px) 0; background: #fff; }
    .en-header-block { text-align: center; margin-bottom: 44px; }
    .en-header-sub { margin: 10px auto 0; max-width: 560px; font-size: 0.9375rem; color: var(--color-text-tertiary); }
    .en-caps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .en-cap { padding: 26px 24px; background: var(--color-bg-card); border: 1px solid var(--color-border-light); border-radius: 14px; }
    .en-cap h3 { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); margin: 0 0 10px; }
    .en-cap p { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-secondary); margin: 0; }

    .en-next { padding: clamp(56px, 8vw, 100px) 0; background: var(--color-bg-secondary); }
    .en-next-inner { display: flex; flex-direction: column; gap: 28px; }
    .en-next-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .en-next-card { display: block; padding: 20px 22px; background: #fff; border: 1px solid var(--color-border-light); border-radius: 12px; font-weight: 700; font-size: 0.9375rem; color: var(--color-text-primary); text-decoration: none; transition: border-color 0.15s ease; }
    .en-next-card:hover { border-color: var(--color-primary-texto); color: var(--color-primary-texto); }

    @media (max-width: 900px) {
      .en-caps-grid, .en-next-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
