<style>
/* ═══════════════════════════════════════
   FREE TRIAL BANNER
   ═══════════════════════════════════════ */
.pricing-hero-btn {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
  background: var(--color-text-primary);
  padding: 16px 40px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  margin-bottom: var(--space-12);
  transition: background 0.2s ease, transform 0.2s ease;
}
.pricing-hero-btn:hover {
  background: #333;
  transform: translateY(-2px);
  text-decoration: none;
}

/* ═══════════════════════════════════════
   PRICING HERO
   ═══════════════════════════════════════ */
.pricing-hero {
  padding: calc(71px + var(--space-16)) 0 var(--space-16);
  text-align: center;
}

@media (min-width: 768px) {
  .pricing-hero { padding-top: calc(71px + var(--space-20)); }
}

@media (min-width: 1024px) {
  .pricing-hero { padding-top: calc(71px + var(--space-24)); }
}

.pricing-hero-inner {
  max-width: 1100px;
  margin: 0 auto;
}

.pricing-eyebrow {
  display: inline-block;
  font-family: var(--font-body);
  font-size: clamp(0.75rem, 1vw, 0.8125rem);
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-secondary-texto);
  margin-bottom: var(--space-5);
}

.pricing-headline {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--color-text-primary);
  margin: 0 0 var(--space-8);
}

.pricing-subtitle {
  font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin: 0 auto var(--space-10);
  max-width: 700px;
}

/* ─── Toggles ─── */
.pricing-toggles {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.currency-selector {
  position: relative;
}
.currency-select {
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text-primary);
  background: #fff;
  border: 1.5px solid var(--color-border-light);
  border-radius: var(--radius-full);
  padding: 8px 36px 8px 14px;
  cursor: pointer;
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%238C8C8C' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 14px center;
  transition: border-color 0.2s ease;
  min-width: 200px;
}
.currency-select:hover {
  border-color: var(--color-border);
}
.currency-select:focus {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
  border-color: var(--color-primary-texto);
}

.toggle-group {
  display: inline-flex;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-full);
  padding: 3px;
  gap: 2px;
}

.toggle-btn {
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 600;
  padding: 8px 18px;
  border: none;
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--color-text-tertiary);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-default);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.toggle-btn.active {
  background: var(--color-primary-btn, #4470D8);
  color: #fff;
  box-shadow: var(--shadow-sm);
}

.toggle-savings {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-secondary-texto);
  background: rgba(42, 181, 160, 0.12);
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.toggle-btn.active .toggle-savings {
  color: #fff;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.55);
}

/* ═══════════════════════════════════════
   PRICE DISPLAY TOGGLE (CSS-driven)
   ═══════════════════════════════════════ */
/* Price display is now JS-driven via .price-dynamic elements */
.price-dynamic {
  font-variant-numeric: tabular-nums;
}

/* ═══════════════════════════════════════
   PLAN CARDS
   ═══════════════════════════════════════ */
.pricing-cards-section {
  padding: 0 0 var(--space-16);
}

/* Mobile price strip */
.price-strip {
  display: flex;
  justify-content: center;
  gap: 2px;
  margin-bottom: var(--space-4);
  background: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  padding: 4px;
}

.price-strip-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 10px 4px;
  border: none;
  border-radius: var(--radius-md);
  background: transparent;
  cursor: pointer;
  transition: background var(--duration-fast) var(--ease-default);
}

.price-strip-item.active {
  background: #fff;
  box-shadow: var(--shadow-sm);
}

.price-strip-name {
  font-family: var(--font-display);
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-text-secondary);
  letter-spacing: -0.01em;
}

.price-strip-price {
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 800;
  color: var(--color-text-primary);
}

@media (min-width: 768px) {
  .price-strip { display: none; }
  .carousel-dots { display: none !important; }
}

/* Móvil con más aire (29-sep-2026: «se ve muy pegado todo»): separación entre moneda y periodo, franja de
   precios con más respiro y espacio arriba del carrusel para que «Más popular» no se corte. */
@media (max-width: 767px) {
  .pricing-hero { padding-bottom: var(--space-12); }
  .pricing-subtitle { margin-bottom: var(--space-8); }
  .pricing-toggles { flex-direction: column; gap: var(--space-4); }
  .price-strip { gap: 4px; padding: 6px; margin-bottom: var(--space-8); }
  .price-strip-item { padding: 12px 6px; gap: 4px; }
  .price-strip-name, .price-strip-price { line-height: 1.3; text-align: center; }
  .price-strip-price { white-space: nowrap; font-size: 0.75rem; }
}

/* Cards grid */
.pricing-cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

@media (min-width: 768px) {
  .pricing-cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .pricing-cards {
    grid-template-columns: repeat(3, 1fr);
    max-width: 1120px;
    margin: 0 auto;
  }
}

/* Mobile: horizontal carousel */
@media (max-width: 767px) {
  .pricing-cards {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: var(--space-4);
    /* arriba deja lugar a la etiqueta «Más popular» (sale 12 px por encima de la tarjeta y el carrusel la cortaba) */
    padding: var(--space-5) var(--space-5) 0;
    margin: 0 calc(-1 * var(--space-5));
  }

  .pricing-cards::-webkit-scrollbar { display: none; }

  .plan-card {
    flex: 0 0 calc(100vw - 56px);
    scroll-snap-align: center;
  }
}

/* Card base */
.plan-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--duration-base) var(--ease-default), transform var(--duration-base) var(--ease-default);
  position: relative;
  display: flex;
  flex-direction: column;
}

@media (min-width: 768px) {
  .plan-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
}

.plan-card.highlighted {
  border: 2px solid var(--color-primary);
  box-shadow: var(--shadow-md);
}

@media (min-width: 768px) {
  .plan-card.highlighted:hover {
    box-shadow: var(--shadow-xl);
  }
}

/* Badge */
.plan-badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #fff;
  background: var(--color-primary-btn, #4470D8);
  padding: 5px 16px;
  border-radius: var(--radius-full);
  white-space: nowrap;
  z-index: 1;
}

/* Plan name */
.plan-name {
  font-family: var(--font-display);
  font-size: clamp(1rem, 1.3vw, 1.1875rem);
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-2);
  white-space: nowrap;
}

/* Plan description */
.plan-desc {
  font-size: 0.8125rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin: 0 0 var(--space-6);
  min-height: 2.5rem;
}

@media (min-width: 1024px) {
  .plan-desc {
    min-height: 3.75rem; /* 3 lines at 13px × 1.5 = ~60px, ensures alignment across 4 cols */
  }
}

/* Price */
.plan-price {
  margin-bottom: var(--space-6);
}

.plan-price-amount {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 2.5vw, 2.25rem);
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: -0.04em;
  line-height: 1;
  white-space: nowrap;
}

.plan-price-currency {
  font-size: 0.5em;
  font-weight: 700;
  letter-spacing: 0.02em;
  vertical-align: baseline;
  color: var(--color-text-tertiary);
}

.plan-price-period {
  display: block;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-text-tertiary);
  margin-top: var(--space-1);
}

.plan-price-strike {
  display: block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text-tertiary);
  text-decoration: line-through;
  text-decoration-thickness: 1.5px;
  margin-bottom: 4px;
}

/* CTA */
.plan-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 14px 24px;
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: 600;
  text-decoration: none;
  transition: all var(--duration-fast) var(--ease-default);
  cursor: pointer;
  line-height: 1;
}

.plan-cta.btn-primary {
  background: var(--color-primary-btn, #4470D8);
  color: #fff;
  border: none;
}

.plan-cta.btn-primary:hover {
  background: var(--color-primary-hover);
  transform: scale(1.03);
}

.plan-cta.btn-secondary {
  background: transparent;
  color: var(--color-text-primary);
  border: 1.5px solid var(--color-text-primary);
}

.plan-cta.btn-secondary:hover {
  background: var(--color-text-primary);
  color: #fff;
}

/* Divider */
.plan-divider {
  height: 1px;
  background: var(--color-border-light);
  margin: var(--space-6) 0;
}

.plan-divider-light {
  margin: var(--space-4) 0;
}

/* Inherits from */
.plan-inherits {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text-tertiary);
  margin: 0 0 var(--space-4);
}

/* Tarjetas parejas: lo esencial a la vista y el resto plegado (18-oct-2026) */
.plan-features-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-5);
}
.plan-mas {
  margin-top: var(--space-2);
}
.plan-mas summary {
  list-style: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-primary-texto);
  padding: 6px 0;
}
.plan-mas summary::-webkit-details-marker { display: none; }
.plan-mas summary::after {
  content: '';
  width: 7px;
  height: 7px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg) translateY(-2px);
  transition: transform var(--duration-fast) var(--ease-default);
}
.plan-mas[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
.plan-mas .plan-mas-cerrar { display: none; }
.plan-mas[open] .plan-mas-abrir { display: none; }
.plan-mas[open] .plan-mas-cerrar { display: inline; }
.plan-features--mas { margin-top: var(--space-3); flex: none; }

/* ═══ AXO Free (incluido en todos los planes) ═══ */
.axo-section {
  padding: var(--space-16) 0 var(--space-20);
  background: var(--color-bg-secondary);
}
.axo-banner {
  position: relative;
  display: grid;
  grid-template-columns: 300px 1fr;
  align-items: center;
  gap: var(--space-8);
  padding: var(--space-10) var(--space-12) var(--space-10) var(--space-8);
  border-radius: 28px;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 30%, rgba(244, 143, 177, 0.35), transparent 45%),
    radial-gradient(circle at 90% 10%, rgba(142, 180, 230, 0.45), transparent 50%),
    radial-gradient(circle at 75% 100%, rgba(107, 184, 165, 0.30), transparent 55%),
    linear-gradient(135deg, #fdf4f8 0%, #f1f6fd 55%, #eef8f5 100%);
  border: 1px solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
}
.axo-banner-fig { display: flex; justify-content: center; align-self: end; margin-bottom: calc(var(--space-10) * -1); }
.axo-banner-fig img {
  width: 100%;
  max-width: 280px;
  height: auto;
  filter: drop-shadow(0 18px 30px rgba(30, 41, 59, 0.18));
}
.axo-kicker {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-primary-texto);
  background: rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-full);
  padding: 6px 14px;
}
.axo-title {
  font-family: var(--font-display);
  font-size: clamp(1.875rem, 3.4vw, 2.75rem);
  line-height: 1.1;
  margin: var(--space-4) 0 var(--space-3);
  color: var(--color-text-primary);
}
.axo-title span {
  background: linear-gradient(90deg, #e2558f, #5b8fd6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.axo-sub {
  max-width: 600px;
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}
.axo-destacados {
  list-style: none;
  padding: 0;
  margin: var(--space-6) 0 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}
.axo-destacados li {
  display: flex;
  gap: var(--space-3);
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-xs);
}
.axo-destacados b { display: block; font-size: 0.9375rem; color: var(--color-text-primary); }
.axo-destacados span { display: block; font-size: 0.8125rem; line-height: 1.45; color: var(--color-text-secondary); margin-top: 2px; }

.axo-limites {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  margin-top: var(--space-8);
}
.axo-lim {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
}
.axo-lim h3 { font-size: 1rem; margin: 0; color: var(--color-text-primary); }
.axo-lim-nota { font-size: 0.75rem; color: var(--color-text-tertiary); margin: 4px 0 var(--space-3); }
.axo-lim ul { list-style: none; padding: 0; margin: 0; }
.axo-lim li {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-3);
  padding: 8px 0;
  border-top: 1px dashed var(--color-border-light);
  font-size: 0.875rem;
  color: var(--color-text-secondary);
}
.axo-lim li small { display: block; font-size: 0.75rem; color: var(--color-text-tertiary); }
.axo-lim li b { color: var(--color-primary-texto); white-space: nowrap; font-family: var(--font-mono, inherit); }
.axo-lim li.axo-lim-no b { color: var(--color-text-tertiary); font-weight: 600; }

@media (max-width: 1024px) {
  .axo-banner { grid-template-columns: 200px 1fr; gap: var(--space-6); padding: var(--space-8) var(--space-6) var(--space-8) var(--space-4); }
  .axo-banner-fig { margin-bottom: calc(var(--space-8) * -1); }
  .axo-destacados { grid-template-columns: 1fr; }
  .axo-limites { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .axo-limites { grid-template-columns: 1fr; }
}

/* Feature list */
.plan-features {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.plan-feature-group {
  list-style: none;
}
.feature-group-title {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 8px;
  margin-top: 4px;
}
.plan-feature-group:first-child .feature-group-title {
  margin-top: 0;
}
.feature-group-items {
  list-style: none;
  padding: 0;
  margin: 0 0 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.plan-feature--sub {
  font-size: 0.8125rem;
}
.feature-check--sub {
  opacity: 0.6;
}

.plan-feature {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.feature-check {
  flex-shrink: 0;
  color: var(--color-secondary-texto);
  margin-top: 1px;
}

/* Services */
.plan-services {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.plan-services-label {
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 4px;
}

.plan-service {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.plan-service::before {
  content: '';
  flex-shrink: 0;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.5;
}

/* Carousel dots */
.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: var(--space-4);
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
  transition: all var(--duration-fast) var(--ease-default);
}

.dot.active {
  width: 20px;
  border-radius: 3px;
  background: var(--color-text-primary);
}

/* ═══════════════════════════════════════
   INCLUIDO EN TODOS LOS PLANES (gráfico, misma colorimetría del home:
   fondo crema, tarjetas blancas, negro grueso y un solo azul de acento)
   ═══════════════════════════════════════ */
.universal-section { background: var(--color-bg-secondary); padding: var(--space-16) 0; }
@media (min-width: 768px) { .universal-section { padding: var(--space-24) 0; } }
.uni-head { text-align: center; max-width: 820px; margin: 0 auto; }
.uni-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-primary-texto); }
.uni-eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--color-primary); }
.uni-title { font-family: var(--font-display); font-size: clamp(2.25rem, 4.6vw, 3.75rem); font-weight: 800; line-height: 1.02; letter-spacing: -0.035em; color: var(--color-text-primary); margin: var(--space-4) 0 var(--space-4); }
.uni-title span { color: var(--color-primary); }
.uni-sub { font-size: clamp(1rem, 1.6vw, 1.1875rem); line-height: 1.55; color: var(--color-text-secondary); margin: 0; }

.uni-promesas { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-8) 0 var(--space-12); }
.uni-promesa { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--color-border-light); border-radius: var(--radius-full); padding: 8px 20px 8px 8px; font-weight: 600; color: var(--color-text-primary); }
.uni-promesa-num { display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 38px; padding: 0 8px; border-radius: var(--radius-full); background: var(--color-text-primary); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 1rem; }

.uni-ilimitados { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-4); }
.uni-ili { background: #fff; border: 1px solid var(--color-border-light); border-radius: 20px; padding: 26px 22px 24px; display: flex; flex-direction: column; min-height: 190px; }
.uni-ili-n { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-tertiary); }
.uni-ili-num { font-family: var(--font-display); font-size: clamp(3.25rem, 5vw, 4.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--color-primary); margin: auto 0 10px; }
.uni-ili-label { font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; line-height: 1.2; color: var(--color-text-primary); }
.uni-ili-nota { margin-top: 4px; font-size: 0.8125rem; line-height: 1.4; color: var(--color-text-secondary); }

.uni-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-4); }
.uni-card { display: flex; gap: var(--space-4); align-items: flex-start; background: #fff; border: 1px solid var(--color-border-light); border-radius: 20px; padding: 22px; }
.uni-ico { flex-shrink: 0; width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: var(--color-bg-secondary); color: var(--color-primary-texto); }
.uni-card-t { font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; margin: 2px 0 4px; color: var(--color-text-primary); }
.uni-card-d { font-size: 0.9375rem; line-height: 1.5; color: var(--color-text-secondary); margin: 0; }

.universal-pronto { max-width: 760px; margin: var(--space-8) auto 0; text-align: center; font-size: 14px; line-height: 1.6; color: var(--color-text-secondary, #4A4A4A); }
.universal-pronto b { color: var(--color-text-primary, #1A1A1A); font-weight: 700; }

@media (max-width: 1024px) {
  .uni-ilimitados { grid-template-columns: repeat(3, 1fr); }
  .uni-grid { grid-template-columns: repeat(2, 1fr); }
}

/* ═══════════════════════════════════════
   COMPARISON TABLE
   ═══════════════════════════════════════ */
.comparison-section {
  padding: var(--space-16) 0;
  content-visibility: auto;
  contain-intrinsic-size: 0 600px;
}

@media (min-width: 768px) {
  .comparison-section { padding: var(--space-20) 0; }
}

@media (min-width: 1024px) {
  .comparison-section { padding: var(--space-24) 0; }
}

.comparison-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 800;
  color: var(--color-text-primary);
  text-align: center;
  margin: 0 0 var(--space-3);
  letter-spacing: -0.03em;
}

.comparison-subtitle {
  font-size: 1rem;
  color: var(--color-text-tertiary);
  text-align: center;
  margin: 0 0 var(--space-10);
}

/* Desktop table header */
.comparison-header {
  display: none;
}

@media (min-width: 768px) {
  .comparison-header {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    /* Pegajoso SOLO mientras hay una categoría abierta (si todo está plegado, flotaba entre filas)
       y sigue al header: 101 px arriba del todo, 71 con scroll, 0 cuando el header se esconde. */
    position: static;
    z-index: 10;
    transition: top 0.35s ease;
  }
  .comparison-section.has-open .comparison-header { position: sticky; top: 101px; }
  :global(body:has(#nav.scrolled)) .comparison-section.has-open .comparison-header { top: 71px; }
  :global(body:has(#nav.nav-oculto)) .comparison-section.has-open .comparison-header { top: 0; }
}

.comparison-header-feature {
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.comparison-header-plan {
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
}

.comparison-header-plan.highlighted {
  color: var(--color-primary-texto);
}

/* Accordion category */
.comparison-category {
  border-top: 1px solid var(--color-border-light);
}

.comparison-category:last-child {
  border-bottom: 1px solid var(--color-border-light);
}

.comparison-category-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  width: 100%;
  padding: var(--space-5) 0;
  border: none;
  background: transparent;
  cursor: pointer;
  text-align: left;
}

@media (min-width: 768px) {
  .comparison-category-header {
    padding: var(--space-5);
  }
}

.comparison-category-name {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-text-primary);
  flex: 1;
}

.comparison-category-count {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--color-text-tertiary);
}

.comparison-category-chevron {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  color: var(--color-text-tertiary);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.comparison-category.open .comparison-category-chevron {
  transform: rotate(180deg);
}

.comparison-category.open .comparison-category-name {
  color: var(--color-primary-texto);
}

/* Category body */
.comparison-category-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.comparison-category.open .comparison-category-body {
  max-height: 2000px;
}

/* Comparison row */
.comparison-row {
  padding: var(--space-3) 0;
  border-top: 1px solid rgba(0, 0, 0, 0.04);
}

.comparison-row.alt {
  background: var(--color-bg-primary);
}

@media (min-width: 768px) {
  .comparison-row {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    align-items: center;
    gap: 0;
    padding: var(--space-3) var(--space-5);
  }
}

.comparison-feature-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

@media (min-width: 768px) {
  .comparison-feature-name {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
}

/* Values grid (mobile: 2x2, desktop: inline) */
.comparison-values {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px var(--space-3);
}

@media (min-width: 768px) {
  .comparison-values {
    display: contents;
  }
}

.comparison-cell {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 0;
}

@media (min-width: 768px) {
  .comparison-cell {
    justify-content: center;
  }

  .comparison-cell-label { display: none; }
}

.comparison-cell-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-text-tertiary);
  min-width: 55px;
}

.cell-check {
  color: var(--color-secondary-texto);
  display: flex;
}

.cell-x {
  color: var(--color-border);
  display: flex;
}

.cell-text {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ═══════════════════════════════════════
   ADD-ONS
   ═══════════════════════════════════════ */
.addons-section {
  padding: var(--space-16) 0;
  background: var(--color-bg-secondary);
}

@media (min-width: 768px) {
  .addons-section { padding: var(--space-20) 0; }
}

@media (min-width: 1024px) {
  .addons-section { padding: var(--space-24) 0; }
}

.addons-eyebrow {
  display: block;
  text-align: center;
  font-family: var(--font-body);
  font-size: clamp(0.75rem, 1vw, 0.8125rem);
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-secondary-texto);
  margin-bottom: var(--space-4);
}

.addons-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 800;
  color: var(--color-text-primary);
  text-align: center;
  margin: 0 0 var(--space-3);
  letter-spacing: -0.03em;
}

.addons-subtitle {
  font-size: 1rem;
  color: var(--color-text-tertiary);
  text-align: center;
  margin: 0 0 var(--space-10);
}

/* Conector de IA: tarjeta destacada a lo ancho */
.addon-card--ia { grid-column: 1 / -1; background: linear-gradient(135deg, #0E0D0C 0%, #15203a 100%); min-height: 0; }
.addon-ia-kicker { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #8FB0FF; margin-bottom: 12px; }
.addon-card--ia .addon-plugin-name { font-size: clamp(28px, 3.2vw, 44px); max-width: 22ch; }
.addon-card--ia .addon-desc { max-width: 70ch; }
.addon-ia-plataformas { display: flex; flex-wrap: wrap; gap: 10px; margin: 18px 0 6px; }
.addon-ia-plataformas span { padding: 10px 18px; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 16px; }
.addon-points--2col { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; }
@media (max-width: 767px) { .addon-points--2col { grid-template-columns: 1fr; } .addon-ia-plataformas span { font-size: 14px; padding: 8px 14px; } }

.addons-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

@media (min-width: 768px) {
  .addons-grid { grid-template-columns: repeat(2, 1fr); }
}

/* Plan Automatiza: bloque destacado del MCP de Sacscloud (arriba de sus funciones) */
.plan-destacado { background: linear-gradient(135deg, #0E0D0C 0%, #15203a 100%); color: #fff; border-radius: var(--radius-md, 12px); padding: var(--space-5); margin: 0 0 var(--space-6); }
.plan-destacado-kicker { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #8FB0FF; margin-bottom: 8px; }
.plan-destacado-titulo { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; margin: 0 0 8px; color: #fff; }
.plan-destacado-texto { font-size: 0.8125rem; line-height: 1.55; color: rgba(255,255,255,0.78); margin: 0 0 12px; }
.plan-destacado-plataformas { display: flex; flex-wrap: wrap; gap: 6px; }
.plan-destacado-plataformas span { font-size: 11.5px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: #fff; }

/* Integraciones e-commerce: sección aparte de los módulos */
.integraciones-section { background: var(--color-bg-card, #fff); }
.integraciones-section .addons-subtitle { max-width: 640px; margin-left: auto; margin-right: auto; line-height: 1.6; }
.addon-int-kicker { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #8FB0FF; margin-bottom: 12px; }
.addons-subtitle a { color: var(--color-primary-texto, #3A5FC4); text-decoration: underline; text-underline-offset: 3px; }
/* Móvil: la tarjeta mide lo que su contenido (con 380 px de alto fijo quedaba un hueco negro debajo de la lista) */
@media (max-width: 767px) { .addon-card { min-height: 0; } .addon-card .addon-btn { margin-top: var(--space-6); } }

/* Addon card — colored hero style */
.addon-card {
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 380px;
  position: relative;
  transition: transform var(--duration-base) var(--ease-default), box-shadow var(--duration-base) var(--ease-default);
}

@media (min-width: 768px) {
  .addon-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }
}

/* All cards — dark */
.addon-card { background: var(--color-bg-dark); }

/* Light variant — white bg */
.addon-card.addon-card--light {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-light);
}

.addon-card--light .addon-plugin-name { color: var(--color-text-primary); }
.addon-card--light .addon-desc { color: var(--color-text-secondary); }
.addon-card--light .addon-points li { color: var(--color-text-secondary); }
.addon-card--light .addon-points li::before { color: var(--color-primary-texto); }
.addon-card--light .addon-btn {
  background: var(--color-primary-btn, #4470D8);
  color: #fff;
}
.addon-card--light .addon-btn:hover {
  background: var(--color-primary-hover);
}

.addon-card-content {
  padding: var(--space-8) var(--space-8) var(--space-5);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.addon-plugin-name {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin: 0 0 var(--space-3);
}

.addon-plan {
  font-size: 0.8125rem;
  font-weight: 600;
  color: #7BA0F0;
  margin: 0 0 var(--space-3);
}
.addon-card--light .addon-plan { color: var(--color-primary-texto); }

.addon-desc {
  font-size: 0.875rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
  margin: 0 0 var(--space-5);
}

.addon-points {
  list-style: none;
  padding: 0;
  margin: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.addon-points li {
  font-size: 0.875rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
  padding-left: 22px;
  position: relative;
}

.addon-points li::before {
  content: '✓';
  position: absolute;
  left: 0;
  font-weight: 700;
  color: #fff;
}

.addon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-6);
  padding: 12px 28px;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: var(--radius-full);
  text-decoration: none;
  transition: background var(--duration-fast) var(--ease-default);
  width: fit-content;
}

.addon-btn:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* ═══════════════════════════════════════
   CREDIBILITY
   ═══════════════════════════════════════ */
.credibility-section {
  padding: var(--space-16) 0;
}

@media (min-width: 768px) {
  .credibility-section { padding: var(--space-20) 0; }
}

@media (min-width: 1024px) {
  .credibility-section { padding: var(--space-24) 0; }
}

/* Trust badges — integrated with dark reels */
.trust-badges {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-10);
  flex-wrap: wrap;
  margin-top: var(--space-10);
  padding: var(--space-6) var(--space-8);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-xl);
  background: var(--color-bg-primary);
}

@media (max-width: 767px) {
  .trust-badges {
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
  }
}

.trust-badge {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.trust-badge-icon {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
}

.trust-badge-value {
  display: block;
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.trust-badge-label {
  display: block;
  font-size: 0.6875rem;
  font-weight: 500;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}

.trust-badge-divider {
  width: 1px;
  height: 32px;
  background: var(--color-border-light);
}

@media (max-width: 767px) {
  .trust-badge-divider { display: none; }
  .trust-badges {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
}

/* Reels — same styles as homepage Hero */
.reels-header {
  max-width: 1200px;
  margin: 0 auto clamp(40px, 5vw, 64px);
  padding: 0 var(--space-6);
  text-align: center;
}
.reels-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 4vw, 3rem);
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -0.04em;
  line-height: 1.1;
  margin: 0;
}
.reels-title-logo {
  font-family: var(--font-logo, 'Clash Display', sans-serif);
}
.reels-subtitle {
  font-size: clamp(0.9375rem, 1.5vw, 1.125rem);
  color: rgba(0,0,0,0.45);
  margin: var(--space-4) auto 0;
  max-width: 560px;
  line-height: 1.5;
}
/* ═══ Plugins en carrusel ═══ */
.plg-section .addons-subtitle { max-width: 640px; margin-left: auto; margin-right: auto; }
.plg-section .reels-carrusel { margin-top: var(--space-8); }
.plg-card {
  flex-shrink: 0;
  width: clamp(320px, 46vw, 640px);
  scroll-snap-align: center;
  border-radius: 24px;
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--color-border-light);
  box-shadow: 0 6px 30px rgba(15, 23, 42, 0.08);
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
}
.plg-card:hover { transform: translateY(-6px); box-shadow: 0 22px 60px rgba(15, 23, 42, 0.16); text-decoration: none; }
.plg-foto { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
.plg-foto img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
.plg-card:hover .plg-foto img { transform: scale(1.05); }
.plg-plan {
  position: absolute; top: 16px; left: 16px;
  font-size: 0.75rem; font-weight: 700;
  background: rgba(255,255,255,0.92); color: var(--color-primary-texto);
  border-radius: var(--radius-full); padding: 6px 12px;
  backdrop-filter: blur(6px);
}
.plg-info { padding: 22px 26px 26px; display: flex; flex-direction: column; flex: 1; }
.plg-kicker { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-primary-texto); }
.plg-name { font-family: var(--font-display); font-size: clamp(1.375rem, 2.2vw, 1.75rem); line-height: 1.15; margin: 6px 0 8px; color: var(--color-text-primary); }
.plg-desc { font-size: 0.9375rem; line-height: 1.55; color: var(--color-text-secondary); margin: 0; }
.plg-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.plg-chips span { font-size: 0.8125rem; font-weight: 700; padding: 6px 12px; border-radius: var(--radius-full); background: var(--color-bg-secondary); color: var(--color-text-primary); }
.plg-mas { margin-top: auto; padding-top: 16px; font-size: 0.875rem; font-weight: 700; color: var(--color-primary-texto); }

/* ═══ Integraciones con logos ═══ */
.int-section {
  background:
    radial-gradient(circle at 10% 0%, rgba(142, 180, 230, 0.22), transparent 40%),
    radial-gradient(circle at 95% 100%, rgba(232, 200, 74, 0.18), transparent 45%),
    var(--color-bg-card, #fff);
  text-align: center;
}
.int-eyebrow { display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-primary-texto); margin-bottom: var(--space-3); }
.int-section .addons-subtitle { max-width: 640px; margin-left: auto; margin-right: auto; line-height: 1.6; }
.int-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  margin-top: var(--space-10);
  text-align: left;
}
.int-card {
  position: relative;
  background: #fff;
  border: 1px solid var(--color-border-light);
  border-radius: 20px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  text-decoration: none;
  color: inherit;
}
.int-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(15, 23, 42, 0.10); text-decoration: none; }
.int-logo { height: 84px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: var(--color-bg-secondary); margin-bottom: 16px; padding: 0 16px; }
.int-logo img { max-width: 100%; width: auto; height: auto; display: block; }
.int-card--pronto .int-logo img { filter: saturate(0.85); }
.int-name { font-size: 1.0625rem; margin: 0 0 4px; color: var(--color-text-primary); }
.int-desc { font-size: 0.875rem; line-height: 1.5; color: var(--color-text-secondary); margin: 0; }
.int-estado { position: absolute; top: 12px; right: 12px; font-size: 0.6875rem; font-weight: 700; border-radius: var(--radius-full); padding: 4px 10px; z-index: 1; }
.int-estado--ok { background: #dcfce7; color: #166534; }
.int-estado--pronto { background: #fef3c7; color: #92400e; }
.int-card--api { background: linear-gradient(135deg, #0E0D0C 0%, #15203a 100%); border-color: transparent; }
.int-card--api .int-name { color: #fff; margin-top: 8px; }
.int-card--api .int-desc { color: rgba(255,255,255,0.7); }
.int-card--api .plg-mas { color: #8FB0FF; }
.int-api-ico { width: 84px; height: 84px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); color: #8FB0FF; font-family: var(--font-mono, monospace); font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; }
@media (max-width: 1024px) { .int-grid { grid-template-columns: repeat(2, 1fr); } }

.reels-carrusel { position: relative; }
.reels-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1px solid var(--color-border-light);
  background: rgba(255,255,255,0.95);
  box-shadow: var(--shadow-sm);
  font-size: 1.75rem;
  line-height: 1;
  color: var(--color-text-primary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 4px;
}
.reels-nav:hover { background: #fff; }
.reels-nav[disabled] { opacity: 0.35; cursor: default; }
.reels-nav--prev { left: clamp(8px, 3vw, 40px); }
.reels-nav--next { right: clamp(8px, 3vw, 40px); }
.reels-ver-todos { text-align: center; margin: var(--space-4) 0 0; }
.reels-ver-todos a { font-weight: 600; color: var(--color-primary-texto); text-decoration: none; }
.reels-ver-todos a:hover { text-decoration: underline; }
.reels-track-wrapper {
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.reels-track-wrapper::-webkit-scrollbar { display: none; }
/* Plugins con el scroll (18-oct-2026, dueño): en escritorio la sección se queda pegada y, al bajar, el carrusel
   avanza hacia la derecha hasta enseñar el último plugin; luego la página sigue. Ver el script «plugins con el scroll». */
.plg-section.is-scrub .plg-pin { position: sticky; }
.plg-section.is-scrub .reels-track-wrapper { scroll-snap-type: none; }
/* pegada tiene que caber en la pantalla: la foto se acorta y la tarjeta se angosta un poco */
.plg-section.is-scrub .plg-foto { aspect-ratio: auto; height: clamp(200px, calc(100vh - 520px), 400px); }
.plg-section.is-scrub .plg-card { width: clamp(320px, 38vw, 560px); }
.reels-track {
  display: flex;
  gap: clamp(16px, 2vw, 24px);
  padding: 16px clamp(24px, 5vw, calc((100vw - 1200px) / 2 + 24px));
  width: max-content;
}
.reel-card {
  position: relative;
  width: clamp(340px, 42vw, 520px);
  aspect-ratio: 3 / 4;
  border-radius: 20px;
  overflow: hidden;
  flex-shrink: 0;
  scroll-snap-align: center;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  cursor: pointer;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
}
.reel-card:hover {
  transform: translateY(-6px) scale(1.02);
  box-shadow: 0 20px 60px rgba(0,0,0,0.18);
}
.reel-card--highlight {
  scroll-snap-align: center;
  display: flex;
  flex-direction: column;
  background: #1A1A1A;
  aspect-ratio: auto;
  text-decoration: none;
  color: inherit;
}
.reel-card--highlight:hover {
  text-decoration: none;
}
.reel-hl-photo {
  overflow: hidden;
  min-height: 0;
  position: relative;
  height: 420px;
  max-height: 420px;
}
.reel-hl-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center bottom;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.reel-card:hover .reel-hl-photo img {
  transform: scale(1.06);
}
.reel-hl-info {
  padding: 18px 20px 20px;
  color: #fff;
  flex-shrink: 0;
  background: #1A1A1A;
  position: relative;
  z-index: 1;
}
.reel-hl-stats {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 16px;
}
.reel-hl-stat {
  display: flex;
  flex-direction: column;
}
.reel-hl-stat-num {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1;
  color: #fff;
}
.reel-hl-stat-label {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
  margin-top: 4px;
}
.reel-hl-stat-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.15);
  flex-shrink: 0;
}
.reel-tag {
  display: inline-flex;
  align-self: flex-start;
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.15);
  border-radius: 100px;
  padding: 4px 12px;
}
.reel-brand {
  font-family: var(--font-display);
  font-size: clamp(1rem, 1.4vw, 1.25rem);
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0;
}
@media (max-width: 1024px) {
  .reels-header { margin-bottom: 20px; }
  .reels-title { font-size: 1.4rem; }
  .reels-subtitle { font-size: 0.85rem; }
  .reels-track { gap: 12px; padding: 8px 16px; }
  .reel-card {
    width: 65vw;
    max-width: 280px;
    aspect-ratio: 9 / 16;
    border-radius: 16px;
  }
  .reel-card--highlight {
    aspect-ratio: 9 / 16;
    position: relative;
  }
  .reel-hl-photo {
    position: absolute;
    inset: 0;
    max-height: none;
    height: auto;
  }
  .reel-hl-photo img { width: 100%; height: 100%; object-fit: cover; }
  .reel-hl-info {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 40px 14px 14px;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.5) 60%, transparent 100%);
    z-index: 1;
  }
  .reel-hl-stat-num { font-size: 1.3rem; }
  .reel-hl-stat-label { font-size: 10px; }
  .reel-hl-stats { gap: 10px; margin-top: 8px; }
  .reel-hl-stat-divider { height: 28px; }
}
@media (prefers-reduced-motion: reduce) {
  .reel-card { transition: box-shadow 0.3s ease; }
  .reel-hl-photo img { transition: none; }
}

/* ═══════════════════════════════════════
   MIGRACIÓN (misma colorimetría del home)
   ═══════════════════════════════════════ */
.mig-section { background: var(--color-bg-primary); padding: var(--space-16) 0; }
@media (min-width: 768px) { .mig-section { padding: var(--space-24) 0; } }
.mig-head { text-align: center; max-width: 860px; margin: 0 auto; }
.mig-title { font-family: var(--font-display); font-size: clamp(2.25rem, 4.4vw, 3.5rem); font-weight: 800; line-height: 1.04; letter-spacing: -0.035em; color: var(--color-text-primary); margin: var(--space-4) 0 var(--space-4); }
.mig-title span { color: var(--color-primary); }
.mig-sub { font-size: clamp(1rem, 1.6vw, 1.1875rem); line-height: 1.55; color: var(--color-text-secondary); margin: 0 auto; max-width: 680px; }
.mig-visual { position: relative; margin: var(--space-10) auto 0; max-width: 1120px; border-radius: 28px; overflow: hidden; background: #F5F3EE; container-type: inline-size; }
.mig-visual img { display: block; width: 100%; height: auto; }
.mig-logo { position: absolute; left: 80.2%; top: 46.4%; transform: translate(-50%, -50%); font-family: 'Clash Display', var(--font-display); font-weight: 700; font-size: 6.4cqw; line-height: 1; letter-spacing: -0.01em; color: var(--color-text-primary); }
.mig-datos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); max-width: 1120px; margin: var(--space-6) auto 0; }
.mig-dato { background: var(--color-bg-secondary); border-radius: 20px; padding: 24px; text-align: center; }
.mig-dato-num { display: block; font-family: var(--font-display); font-size: clamp(2.25rem, 4vw, 3.25rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--color-primary); }
.mig-dato-label { display: block; margin-top: 8px; font-size: 0.9375rem; font-weight: 600; color: var(--color-text-primary); }
.mig-que { list-style: none; padding: 0; margin: var(--space-6) auto 0; max-width: 1120px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.mig-que li { display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--color-border-light); border-radius: var(--radius-full); padding: 9px 16px; font-size: 0.9375rem; font-weight: 600; color: var(--color-text-primary); }
.mig-que li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--color-primary); }
.mig-riesgo { text-align: center; margin: var(--space-6) 0 0; font-size: 0.9375rem; color: var(--color-text-secondary); }
.mig-riesgo b { color: var(--color-text-primary); }

/* ═══════════════════════════════════════
