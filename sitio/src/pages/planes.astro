---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { planesPublicos as plans, comparisonCategories, pricingFaqs } from '../data/plans';
import { PRODUCTO_ID, SITIO } from '../data/entidad';

const checkIcon = `<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 9.5l3.5 3.5L14 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const xIcon = `<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M5 5l8 8M13 5l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
const chevronIcon = `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// La página comercial más importante del sitio no emitía NADA propio: solo el
// Organization + un único Offer genérico de SCHEMA_BASE(). Los precios salen
// SIEMPRE de `plans` (src/data/plans.ts) — la misma tabla que ve la persona
// en esta página — nunca de la ficha que usa el agente comercial
// (src/lib/crm/ti/conocimiento/planes.ts): son dos fuentes distintas y
// mezclarlas es como el `Offer` global le dice a Google/una IA un precio
// mientras la página le dice otro.
const preciosAnuales = plans.map((p) => p.annual.mxn);
const aggregateOfferSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': PRODUCTO_ID,
  name: 'Sacs',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'MXN',
    lowPrice: Math.min(...preciosAnuales),
    highPrice: Math.max(...preciosAnuales),
    offerCount: plans.length,
    url: `${SITIO}/planes`,
  },
};

// Las 6 preguntas son las mismas que se recorren más abajo en
// "SECTION 6: FAQ" (`pricingFaqs.map(...)`) — ninguna se escribe de nuevo aquí.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const planesStructuredData = [aggregateOfferSchema, faqSchema];

// Ids de las columnas de la comparativa = los planes que se venden hoy (sin los retirados).
const idsComparativa = plans.map((p) => p.id) as ('vende' | 'controla' | 'fideliza' | 'automatiza')[];

// 18-oct-2026 (dueño): las tarjetas eran «un chorizo» de distinto largo con mucho blanco.
// Cada tarjeta enseña lo esencial —los primeros 3 bloques, 3 funciones por bloque— y el
// resto se pliega en «Ver todo lo que incluye». El detalle completo sigue en la comparativa.
type Bloque = string | { category: string; items: string[] };
function partirFunciones(features: Bloque[], maxBloques = 3, maxPorBloque = 3) {
  const visibles: Bloque[] = [];
  const ocultas: Bloque[] = [];
  let nOcultas = 0;
  features.forEach((f, i) => {
    if (typeof f === 'string') {
      if (i < maxBloques) visibles.push(f); else { ocultas.push(f); nOcultas++; }
      return;
    }
    const enVista = i < maxBloques ? f.items.slice(0, maxPorBloque) : [];
    const resto = f.items.slice(enVista.length);
    if (enVista.length) visibles.push({ category: f.category, items: enVista });
    if (resto.length) { ocultas.push({ category: f.category, items: resto }); nOcultas += resto.length; }
  });
  return { visibles, ocultas, nOcultas };
}

// Casos del carrusel: los mismos que hoy tiene /casos-de-exito (con sus datos de ahí).
const casosCarrusel = [
  { href: '/casos-de-exito/liveshow', brand: 'Live Shows Merchandising', tag: 'Moda · Merch oficial', color: 'rgba(236,72,153,0.92)',
    img: '/images/ls-guts-fans.webp', alt: 'Fan con la sudadera oficial del GUTS World Tour frente a la pared de playeras',
    stats: [{ num: '100+', label: 'puntos de venta a la vez' }, { num: '8', label: 'países con oficina' }] },
  { href: '/casos-de-exito#sthela', brand: 'Sthela & Co.', tag: 'Moda femenina · Mayorista', color: 'rgba(168,85,247,0.92)',
    img: '/images/casos-carrusel/sthela.webp', alt: 'Clienta con vestido de noche negro frente al espejo de una boutique', pos: 'center 30%',
    stats: [{ num: '2', label: 'boutiques propias en Jalisco' }, { num: 'Intermoda', label: 'fabricante y mayorista' }] },
  { href: '/casos-de-exito/vende-tu-closet', brand: 'Vende Tu Clóset', tag: 'Lujo pre-loved · Consignación', color: 'rgba(22,163,74,0.92)',
    img: '/images/vtc-bolsas.webp', alt: 'Bolsas de lujo Dior y Fendi en el showroom de Vende Tu Clóset', pos: 'center 40%',
    stats: [{ num: '4', label: 'ciudades' }, { num: '100%', label: 'piezas autenticadas' }] },
  { href: '/casos-de-exito/las-alazanas', brand: 'Talabartería Las Alazanas', tag: 'Ropa vaquera · Talabartería', color: 'rgba(180,83,9,0.92)',
    img: '/images/casos-carrusel/alazanas.webp', alt: 'Artesano repujando a mano un cinturón de piel, con sillas y sombreros vaqueros al fondo', pos: 'center 45%',
    stats: [{ num: '4', label: 'sucursales' }, { num: 'Taller', label: 'propio, hecho a mano' }] },
  { href: '/casos-de-exito/mits', brand: 'Mexico Is The Shit', tag: 'Moda mexicana · Hecho en México', color: 'rgba(251,146,60,0.92)',
    img: '/images/mits-poncho.webp', alt: 'Mujer con el poncho «Mexico Is The Shit»', pos: 'center 30%',
    stats: [{ num: '7', label: 'colecciones' }, { num: '100%', label: 'hecho en México' }] },
];
import PlanesEnterprise from '../components/planes/PlanesEnterprise.astro';

// Plugins del carrusel (fotos de la misma serie que usan las páginas de cada plugin).
const plugins = [
  // 18-oct-2026 (dueño): Planeación de demanda también va como plugin, la primera del carrusel.
  { href: '/planeacion-de-demanda', kicker: 'Planeación', name: 'Planeación de demanda',
    desc: 'Pronóstico por temporada, modelo, talla y tienda: qué comprar, cuánto y cuándo, cómo repartirlo y cuándo resurtir.',
    img: '/images/automatiza/forecast-1536.webp', alt: 'Directora de una marca de moda revisando el pronóstico de la temporada', pos: 'center 40%' },
  { href: '/producto/api-e-integraciones', kicker: 'Conector de datos', name: 'Opera Sacs desde tu IA',
    desc: 'Conecta tu cuenta a ChatGPT, Claude, Grok o Muse y pídele en tus palabras: qué talla se acaba, cuánto vendió la colección, que arme el traspaso.',
    chips: ['ChatGPT', 'Claude', 'Grok', 'Muse'], img: '/images/axo-copiloto-ia-hero.webp', alt: 'Encargada de boutique consultando Sacs desde su tableta', pos: 'center 35%' },
  { href: '/plugins/administracion', kicker: 'Finanzas', name: 'Administración', plan: 'Desde el plan Controla',
    desc: 'Bancos, cuentas por pagar y flujo de caja en el mismo sistema donde vendes. Le tomas foto al recibo y el gasto se captura solo.',
    img: '/images/plugins/administracion/portada-1536.webp', alt: 'Dueña de boutique revisando las finanzas en su laptop', pos: 'center 40%' },
  { href: '/contacto', kicker: 'Equipo', name: 'Nómina', plan: 'Desde el plan Controla',
    desc: 'Nómina completa con IMSS, ISR y recibos timbrados, ligada a la asistencia y a las comisiones de cada venta.',
    img: '/images/plugins/staff/kiosco-1536.webp', alt: 'Vendedor checando su entrada en el kiosco de la tienda', pos: 'center 35%' },
  { href: '/contacto', kicker: 'Equipo', name: 'Staff',
    desc: 'Turnos y horarios por sucursal, cambios de turno desde el punto de venta y control de asistencia.',
    img: '/images/plugins/staff/equipo-1280.webp', alt: 'Equipo de una boutique organizando el turno', pos: 'center 40%' },
  { href: '/contacto', kicker: 'Clientes', name: 'Marketing Suite',
    desc: 'Campañas por correo y WhatsApp a los clientes correctos, con segmentos y flujos que se mandan solos.',
    img: '/images/plugins/carrusel/marketing.webp', alt: 'Clienta recibiendo una campaña por WhatsApp en la calle', pos: 'center 50%' },
];

// Integraciones: «lista» = ya existe en sacs_api (Shopify, WooCommerce, Tienda Nube). Las demás, «Próximamente».
const integraciones = [
  { name: 'Shopify', logo: '/images/integraciones/shopify.svg', lista: true, alto: 52, desc: 'Inventario, pedidos y clientes sincronizados en tiempo real.' },
  { name: 'WooCommerce', logo: '/images/integraciones/woocommerce.svg', lista: true, alto: 34, desc: 'Tu tienda en WordPress con stock y precios al día.' },
  { name: 'Tienda Nube', logo: '/images/integraciones/tiendanube.svg', lista: true, alto: 30, desc: 'Productos, pedidos y clientes conectados con tus sucursales.' },
  { name: 'Mercado Libre', logo: '/images/integraciones/mercadolibre.webp', lista: false, alto: 44, desc: 'Publica tu catálogo y descuenta el stock con cada venta.' },
  { name: 'Amazon', logo: '/images/integraciones/amazon.svg', lista: false, alto: 34, desc: 'Tu inventario disponible en el marketplace más grande.' },
  { name: 'Liverpool', logo: '/images/integraciones/liverpool.svg', lista: false, alto: 38, desc: 'Vende en el marketplace de Liverpool sin capturar dos veces.' },
  { name: 'SHEIN', logo: '/images/integraciones/shein.svg', lista: false, alto: 24, desc: 'Lleva tu marca a millones de compradoras de moda.' },
];

// «Incluido en todos los planes», versión gráfica. Mismo contenido que `universalFeatures`
// (data/plans.ts, que sigue usando /en/pricing), agrupado: lo ilimitado en grande y lo demás con icono.
const ilimitados = [
  { num: '∞', label: 'Usuarios' },
  { num: '∞', label: 'Dispositivos' },
  { num: '∞', label: 'Modelos, tallas y colores' },
  { num: '∞', label: 'Fotos de tus prendas' },
  { num: '3', label: 'Cajas cobrando a la vez', nota: 'y si necesitas más, no se cobra por caja' },
];
const ico = (d) => `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const incluidos = [
  { t: 'Punto de venta', d: 'Cobra en tienda, con y sin internet.', icon: ico('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>') },
  { t: 'Tienda en línea', d: 'Tu catálogo a la venta las 24 horas.', icon: ico('<path d="M3 9l1.5-5h15L21 9"/><path d="M4 9v11h16V9"/><path d="M3 9h18"/><path d="M9 20v-6h6v6"/>') },
  { t: 'Facebook, Instagram y TikTok Shop', d: 'Vende en redes con el mismo inventario.', icon: ico('<path d="M7 17l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2z"/><path d="M8 9h8M8 13h5"/>') },
  { t: 'Google, ChatGPT y Gemini', d: 'Tus prendas aparecen cuando alguien las busca.', icon: ico('<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>') },
  { t: 'Soporte 24/7', d: 'Por chat de Sacs y WhatsApp, a cualquier hora.', icon: ico('<path d="M4 14v-3a8 8 0 0 1 16 0v3"/><rect x="2.5" y="13" width="4" height="6" rx="1.5"/><rect x="17.5" y="13" width="4" height="6" rx="1.5"/>') },
  { t: 'Actualizaciones cada mes', d: 'Funciones nuevas sin pagar de más.', icon: ico('<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/>') },
];
---

<BaseLayout
  title="Planes y precios — Sacs para moda"
  description="Planes de Sacs para marcas y tiendas de moda: tallas y colores, traspasos entre tiendas y sell-through. Desde $810/mes por tienda, sin contratos."
  structuredData={planesStructuredData}
>

<!-- ═══ SECTION 1: Hero ═══ -->
<section class="pricing-hero">
  <div class="container pricing-hero-inner">
    <h1 class="pricing-headline">Lleva tu marca de moda<br/>al siguiente nivel.</h1>
    <p class="pricing-subtitle">Empieza con lo básico: punto de venta e inventario por talla y color. Y conforme tu negocio crece, vas sumando tienda en línea, WhatsApp, más sucursales y la IA, paso a paso y sin cambiar de sistema. Prueba 7 días gratis, sin tarjeta.</p>

    <div class="pricing-toggles" id="pricing-toggles">
      <!-- Currency toggle -->
      <div class="currency-selector">
        <select class="currency-select" id="currency-select" aria-label="Moneda">
          <option value="mxn" selected>&#x1F1F2;&#x1F1FD; MXN — Peso mexicano ($)</option>
          <option value="usd">&#x1F1FA;&#x1F1F8; USD — US Dollar ($)</option>
          <option value="eur">&#x1F1EA;&#x1F1FA; EUR — Euro (&euro;)</option>
          <option value="gbp">&#x1F1EC;&#x1F1E7; GBP — British Pound (&pound;)</option>
          <option value="brl">&#x1F1E7;&#x1F1F7; BRL — Real brasileiro (R$)</option>
          <option value="cop">&#x1F1E8;&#x1F1F4; COP — Peso colombiano ($)</option>
          <option value="ars">&#x1F1E6;&#x1F1F7; ARS — Peso argentino ($)</option>
          <option value="clp">&#x1F1E8;&#x1F1F1; CLP — Peso chileno ($)</option>
          <option value="pen">&#x1F1F5;&#x1F1EA; PEN — Sol peruano (S/)</option>
        </select>
      </div>

      <!-- Billing toggle -->
      <div class="toggle-group" role="group" aria-label="Periodo de facturación">
        <!-- Mensual por defecto al entrar (dueño, 29-sep-2026); Anual queda a un toque con su descuento. -->
        <button class="toggle-btn active" data-billing="monthly" aria-pressed="true">Mensual</button>
        <button class="toggle-btn" data-billing="annual" aria-pressed="false">
          Anual
          <span class="toggle-savings">35% de descuento</span>
        </button>
      </div>
    </div>

  </div>
</section>

<!-- ═══ SECTION 2: Plan Cards ═══ -->
<section class="pricing-cards-section" id="pricing-root" data-billing="monthly" data-currency="mxn">
  <div class="container">

    <!-- Mobile price strip -->
    <div class="price-strip" id="price-strip" aria-hidden="true">
      {plans.map((plan, i) => (
        <button
          class:list={['price-strip-item', { active: plan.highlighted }]}
          data-index={i}
        >
          <span class="price-strip-name">{plan.name}</span>
          <span class="price-strip-price price-dynamic"
            data-monthly={JSON.stringify(plan.monthly)}
            data-annual={JSON.stringify(plan.annual)}
            data-annual-total={JSON.stringify(plan.annualTotal)}
          ></span>
        </button>
      ))}
    </div>

    <!-- Cards grid / carousel -->
    <h2 class="solo-lectores">Planes y precios</h2>
    <div class="pricing-cards" id="pricing-cards">
      {plans.map((plan) => (
        <article class:list={['plan-card', { highlighted: plan.highlighted }]} data-plan={plan.id}>
          {plan.badge && <span class="plan-badge">{plan.badge}</span>}

          <h3 class="plan-name">{plan.name}</h3>
          <p class="plan-desc">{plan.description}</p>

          <div class="plan-price" aria-live="polite">
            {/* 22-sep-2026: el dueño pidió quitar toda referencia mensual del
                estado anual. Ya no se muestra el precio dividido entre 12:
                en anual, el número grande es el TOTAL DEL AÑO con el 35% de
                descuento aplicado, con el total SIN descuento tachado arriba
                (nunca "antes": nunca se cobró ese precio, es la lista sin el
                trato anual). En mensual, sigue exactamente como antes. Todo
                se calcula en updatePrices() desde plan.monthly/annualTotal
                — nunca a mano — para que cuadre si cambian precios o moneda. */}
            <span class="plan-price-strike price-strike-dynamic" style="display:none;"></span>
            <span class="plan-price-amount price-dynamic"
              data-monthly={JSON.stringify(plan.monthly)}
              data-annual={JSON.stringify(plan.annual)}
              data-annual-total={JSON.stringify(plan.annualTotal)}
            ></span>
            <span class="plan-price-period price-period-dynamic">/mes por sucursal</span>
          </div>

          <a
            class:list={['plan-cta', plan.cta.variant === 'primary' ? 'btn-primary' : 'btn-secondary']}
            href={plan.cta.href}
          >
            {plan.cta.label}
          </a>

          <div class="plan-divider"></div>

          {plan.destacado && (
            <div class="plan-destacado">
              <span class="plan-destacado-kicker">{plan.destacado.kicker}</span>
              <p class="plan-destacado-titulo">{plan.destacado.titulo}</p>
              <p class="plan-destacado-texto">{plan.destacado.texto}</p>
              <div class="plan-destacado-plataformas" role="list" aria-label="Plataformas compatibles">
                {plan.destacado.plataformas.map((p) => <span role="listitem">{p}</span>)}
              </div>
            </div>
          )}

          {plan.inheritsFrom && (
            <p class="plan-inherits">Todo en {plan.inheritsFrom}, más:</p>
          )}

          {(() => {
            const { visibles, ocultas, nOcultas } = partirFunciones(plan.features);
            const pinta = (lista: Bloque[]) => lista.map((feature) => (
              typeof feature === 'string' ? (
                <li class="plan-feature">
                  <span class="feature-check" set:html={checkIcon} />
                  <span>{feature}</span>
                </li>
              ) : (
                <li class="plan-feature-group">
                  <span class="feature-group-title">{feature.category}</span>
                  <ul class="feature-group-items">
                    {feature.items.map((item) => (
                      <li class="plan-feature plan-feature--sub">
                        <span class="feature-check feature-check--sub" set:html={checkIcon} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              )
            ));
            return (
              <div class="plan-features-wrap">
                <ul class="plan-features">{pinta(visibles)}</ul>
                {nOcultas > 0 && (
                  <details class="plan-mas">
                    <summary>
                      <span class="plan-mas-abrir">Ver todo lo que incluye (+{nOcultas})</span>
                      <span class="plan-mas-cerrar">Ver menos</span>
                    </summary>
                    <ul class="plan-features plan-features--mas">{pinta(ocultas)}</ul>
                  </details>
                )}
              </div>
            );
          })()}

          <div class="plan-divider plan-divider-light"></div>

          <div class="plan-services">
            <span class="plan-services-label">Servicios incluidos</span>
            {plan.services.map((service) => (
              <span class="plan-service">{service}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Carousel dots (mobile) -->
    <div class="carousel-dots" id="carousel-dots" aria-hidden="true">
      {plans.map((_, i) => (
        <span class:list={['dot', { active: i === 2 }]} data-index={i}></span>
      ))}
    </div>
  </div>
</section>

<!-- ═══ SECTION: AXO Free — viene incluido en todos los planes ═══ -->
<section class="axo-section" id="axo">
  <div class="container">
    <div class="axo-banner">
      <div class="axo-banner-fig">
        <img src="/images/axo/axo-mascota.webp" alt="AXO, el asistente de inteligencia artificial de Sacs" width="560" height="860" loading="lazy" decoding="async" />
      </div>

      <div class="axo-banner-body">
        <span class="axo-kicker">Incluido en todos los planes</span>
        <h2 class="axo-title">Tu plan ya trae a <span>AXO Free</span></h2>
        <p class="axo-sub">
          AXO es la inteligencia artificial que trabaja dentro de Sacs: responde tus dudas, revisa tus números
          y hace tareas por ti. Viene con cualquier plan, sin costo extra.
        </p>

        <ul class="axo-destacados">
          <li>
            <div><b>Crea tu tienda en línea</b><span>y la opera por ti de forma autónoma</span></div>
          </li>
          <li>
            <div><b>Soporte 24/7</b><span>a cualquier hora, todos los días</span></div>
          </li>
          <li>
            <div><b>Onboarding 1 a 1 con AXO</b><span>por el chat y guiándote dentro del sistema</span></div>
          </li>
        </ul>
      </div>
    </div>

    <div class="axo-limites">
      <div class="axo-lim">
        <h3>Cada día</h3>
        <p class="axo-lim-nota">Se renueva 24 h después del último uso</p>
        <ul>
          <li><span>Preguntas de uso</span><b>3</b></li>
          <li><span>Análisis de tus números</span><b>2</b></li>
          <li><span>AXO por WhatsApp</span><b>1</b></li>
        </ul>
      </div>
      <div class="axo-lim">
        <h3>Cada semana</h3>
        <p class="axo-lim-nota">Se renueva 7 días después</p>
        <ul>
          <li><span>Acciones dentro de Sacs <small>(1 por caso completo)</small></span><b>3</b></li>
          <li><span>Reportes nuevos</span><b>1</b></li>
          <li><span>Importación de datos</span><b>1</b></li>
          <li><span>Notas de voz</span><b>3</b></li>
        </ul>
      </div>
      <div class="axo-lim">
        <h3>Cada mes</h3>
        <p class="axo-lim-nota">Se renueva cada mes</p>
        <ul>
          <li><span>Leer imágenes</span><b>3</b></li>
          <li><span>Leer archivos <small>(PDF, XML, estados financieros)</small></span><b>3</b></li>
          <li><span>Análisis con datos externos</span><b>1</b></li>
        </ul>
      </div>
      <div class="axo-lim">
        <h3>Además</h3>
        <p class="axo-lim-nota">Sin renovación</p>
        <ul>
          <li><span>Automatización activa</span><b>1 a la vez</b></li>
          <li><span>Capacitación completa</span><b>1 vez</b></li>
          <li class="axo-lim-no"><span>Llamadas con AXO</span><b>No incluidas</b></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTION: Migración (18-oct-2026: punto a favor debajo de AXO; el dueño fijó «en 24 horas») ═══ -->
<section class="mig-section" id="migracion">
  <div class="container">
    <div class="mig-head">
      <span class="uni-eyebrow">Migración incluida</span>
      <h2 class="mig-title">Nos traemos todo tu sistema anterior a Sacs.<br /><span>En 24 horas.</span></h2>
      <p class="mig-sub">Sean 1,000 o 1 millón de datos. Inventario, ventas, clientes, todo. Tú no capturas nada y no pierdes un día de venta.</p>
