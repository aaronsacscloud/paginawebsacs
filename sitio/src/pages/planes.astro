<script>
  // Carruseles (casos y plugins): flechas que recorren las tarjetas (el scroll-snap las centra).
  document.querySelectorAll('[data-carrusel]').forEach((caja) => {
    const wrap = caja.querySelector('[data-carrusel-pista]');
    if (!wrap) return;
    const btns = caja.querySelectorAll('[data-dir]');
    const paso = () => {
      const card = wrap.querySelector('.reel-card, .plg-card');
      return card ? card.getBoundingClientRect().width + 24 : 400;
    };
    const actualizar = () => {
      const max = wrap.scrollWidth - wrap.clientWidth - 4;
      btns.forEach((b) => {
        const dir = Number(b.getAttribute('data-dir'));
        b.toggleAttribute('disabled', dir < 0 ? wrap.scrollLeft <= 4 : wrap.scrollLeft >= max);
      });
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      wrap.scrollBy({ left: Number(b.getAttribute('data-dir')) * paso(), behavior: 'smooth' });
    }));
    wrap.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  });
</script>

<script>
  // Plugins con el scroll: la sección se pega y bajar = avanzar el carrusel a la derecha (solo escritorio y si no se
  // pidió reducir movimiento; en el teléfono sigue siendo un carrusel que se desliza con el dedo).
  document.querySelectorAll<HTMLElement>('[data-plg]').forEach((sec) => {
    const riel = sec.querySelector<HTMLElement>('[data-plg-riel]')!;
    const pin = sec.querySelector<HTMLElement>('[data-plg-pin]')!;
    const wrap = pin.querySelector<HTMLElement>('[data-carrusel-pista]')!;
    const mq = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    let extra = 0;
    const medir = () => {
      riel.style.height = ''; pin.style.top = '';
      if (!mq.matches) { sec.classList.remove('is-scrub'); return; }
      sec.classList.add('is-scrub');                       // se mide ya con las tarjetas del modo pegado
      extra = wrap.scrollWidth - wrap.clientWidth;
      if (extra < 40) { sec.classList.remove('is-scrub'); return; }
      riel.style.height = `${pin.offsetHeight + extra}px`;
      pin.style.top = `${Math.max(64, (window.innerHeight - pin.offsetHeight) / 2)}px`;
      mueve();
    };
    const mueve = () => {
      if (!sec.classList.contains('is-scrub')) return;
      const top = parseFloat(pin.style.top) || 0;
      const p = Math.min(1, Math.max(0, (top - riel.getBoundingClientRect().top) / extra));
      wrap.scrollLeft = p * extra;
    };
    // con la sección pegada, las flechas bajan o suben la página lo que mide una tarjeta
    pin.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-dir]');
      if (!b || !sec.classList.contains('is-scrub')) return;
      e.stopImmediatePropagation();
      const card = wrap.querySelector('.plg-card');
      window.scrollBy({ top: Number(b.dataset.dir) * (card ? card.getBoundingClientRect().width + 24 : 400), behavior: 'smooth' });
    }, true);
    window.addEventListener('scroll', mueve, { passive: true });
    window.addEventListener('resize', medir);
    mq.addEventListener('change', medir);
    if (document.readyState === 'complete') medir(); else window.addEventListener('load', medir);
  });
</script>

<script>
  // TikTok: user viewed pricing page
  try {
    if (typeof ttq !== 'undefined') {
      ttq.track('ViewContent', { content_id: 'planes', content_name: 'planes', content_type: 'product' });
      // AddToCart when clicking "Inicia ahora"
      document.querySelectorAll('.plan-cta').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('[data-plan]') as HTMLElement;
          const planId = card?.dataset.plan || 'unknown';
          const prices: Record<string, number> = { vende: 600, controla: 900, fideliza: 1400, automatiza: 2800 };
          ttq.track('AddToCart', {
            contents: [{ content_id: planId, content_name: planId }],
            content_type: 'product',
            value: prices[planId] || 0,
            currency: 'MXN',
          });
        });
      });
    }
  } catch {}

  // ─── Toggle state management ───
  const root = document.getElementById('pricing-root');
  const toggles = document.getElementById('pricing-toggles');

  // Currency symbols for formatting
  const currencyLabels: Record<string, string> = {
    mxn: 'MXN', usd: 'USD', eur: 'EUR', gbp: 'GBP',
    brl: 'BRL', cop: 'COP', ars: 'ARS', clp: 'CLP', pen: 'PEN'
  };

  function formatAmount(amount: number, currency: string): string {
    if (amount >= 10000) return amount.toLocaleString('es-MX');
    return amount.toLocaleString('es-MX');
  }

  function updatePrices() {
    if (!root) return;
    const billing = root.dataset.billing || 'monthly';
    const currency = root.dataset.currency || 'mxn';
    const label = currencyLabels[currency] || currency.toUpperCase();

    document.querySelectorAll('.price-dynamic').forEach(el => {
      const monthlyData = el.getAttribute('data-monthly');
      const annualTotalData = el.getAttribute('data-annual-total');
      const priceBlock = el.closest('.plan-price');
      const strikeEl = priceBlock?.querySelector('.price-strike-dynamic') as HTMLElement | null;
      const periodEl = priceBlock?.querySelector('.price-period-dynamic') as HTMLElement | null;

      if (billing === 'monthly' && monthlyData) {
        // Mensual: exactamente como siempre — el precio mensual real, "/mes por sucursal".
        const prices = JSON.parse(monthlyData);
        const amount = prices[currency] ?? prices['usd'];
        el.textContent = `${formatAmount(amount, currency)} ${label}`;
        if (strikeEl) strikeEl.style.display = 'none';
        if (periodEl) {
          periodEl.textContent = '/mes por sucursal';
          periodEl.style.display = 'block';
        }
      } else if (billing === 'annual' && annualTotalData) {
        // Anual: el número grande es el TOTAL DEL AÑO con el 35% de descuento
        // ya aplicado (plan.annualTotal). Nada de precio mensual ni de "/mes".
        const totalPrices = JSON.parse(annualTotalData);
        const totalAmount = totalPrices[currency] ?? totalPrices['usd'];
        el.textContent = `${formatAmount(totalAmount, currency)} ${label}`;

        // El total SIN descuento se calcula (mensual × 12), nunca a mano,
        // para que siga cuadrando si cambian los precios o la moneda.
        if (strikeEl && monthlyData) {
          const monthlyPrices = JSON.parse(monthlyData);
          const monthlyAmount = monthlyPrices[currency] ?? monthlyPrices['usd'];
          const sinDescuento = monthlyAmount * 12;
          strikeEl.textContent = `${formatAmount(sinDescuento, currency)} ${label} sin descuento`;
          strikeEl.style.display = 'block';
        }
        if (periodEl) {
          periodEl.textContent = 'al año por sucursal';
          periodEl.style.display = 'block';
        }
      }
    });
  }

  // Billing toggle (monthly/annual buttons)
  if (toggles && root) {
    toggles.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.toggle-btn') as HTMLButtonElement;
      if (!btn) return;
      const billing = btn.dataset.billing;
      if (billing) {
        root.dataset.billing = billing;
        const group = btn.closest('.toggle-group');
        group?.querySelectorAll('.toggle-btn').forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        updatePrices();
      }
    });
  }

  // Currency selector (dropdown)
  const currencySelect = document.getElementById('currency-select') as HTMLSelectElement;
  if (currencySelect && root) {
    currencySelect.addEventListener('change', () => {
      root.dataset.currency = currencySelect.value;
      updatePrices();
    });
  }

  // Initial render
  updatePrices();

  // ─── Comparison table accordion ───
  const compAccordion = document.getElementById('comparison-accordion');
  compAccordion?.addEventListener('click', (e) => {
    const header = (e.target as HTMLElement).closest('.comparison-category-header') as HTMLButtonElement;
    if (!header) return;

    const category = header.closest('.comparison-category');
    if (!category) return;

    const isOpen = category.classList.contains('open');
    category.classList.toggle('open');
    header.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    header.closest('.comparison-section')?.classList.toggle('has-open', !!document.querySelector('.comparison-category.open'));
  });

  // El encabezado de la tabla solo se pega si hay una categoría abierta (estado inicial incluido)
  compAccordion?.closest('.comparison-section')?.classList.toggle('has-open', !!compAccordion.querySelector('.comparison-category.open'));

  // ─── Pricing FAQ accordion ───
  const pricingFaqAccordion = document.getElementById('pricing-faq-accordion');
  const pricingFaqItems = pricingFaqAccordion?.querySelectorAll('.faq-item');

  pricingFaqItems?.forEach((item) => {
    item.addEventListener('click', () => {
      const isActive = item.classList.contains('active');

      pricingFaqItems.forEach((it) => {
        it.classList.remove('active');
        it.setAttribute('aria-expanded', 'false');
      });

      if (!isActive) {
        item.classList.add('active');
        item.setAttribute('aria-expanded', 'true');
      }
    });

    item.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        (item as HTMLElement).click();
      }
    });
  });

  // ─── Mobile carousel sync ───
  const cardsContainer = document.getElementById('pricing-cards');
  const dots = document.querySelectorAll('#carousel-dots .dot');
  const stripItems = document.querySelectorAll('#price-strip .price-strip-item');
  let scrollTicking = false;

  function updateCarouselState(index: number) {
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
    stripItems.forEach((item, i) => {
      item.classList.toggle('active', i === index);
    });
  }

  if (cardsContainer && window.innerWidth < 768) {
    // Scroll to Fideliza (index 2) on load
    //
    // 19-sep-2026 (auditoría de rendimiento): este scrollIntoView() dispara
    // un evento "scroll" nativo del navegador, y ese evento es indistinguible
    // de que el visitante haya movido el dedo — la Compuerta de Marketing de
    // BaseLayout.astro escucha "scroll" en window (a propósito, con capture,
    // para detectar el gesto en cualquier contenedor) como señal de que ya
    // hay que medir. Sin este aviso, CADA carga de /planes en móvil abría la
    // compuerta a los ~400ms, sin campaña y sin visitante real: era la causa
    // de que esta página, sola, sacara 74 de rendimiento en Lighthouse móvil
    // mientras el resto del sitio va en 93-100 con la MISMA compuerta.
    // `sacsIgnorarScrollAuto()` le avisa "el siguiente scroll es layout mío,
    // no un gesto" justo antes de reposicionar el carrusel. NO QUITAR sin
    // volver a medir /planes en Lighthouse móvil.
    requestAnimationFrame(() => {
      const cards = cardsContainer.querySelectorAll('.plan-card');
      if (cards[2]) {
        (window as any).sacsIgnorarScrollAuto?.();
        // `behavior: 'instant'` es lo que de verdad arregla esto: sin él, el
        // scroll heredaba `scroll-behavior: smooth` de global.css (declarado
        // en <html>, y por defecto se hereda a cualquier contenedor) y el
        // navegador animaba el centrado en ~30 eventos "scroll" repartidos en
        // medio segundo — de sobra para agotar el aviso de arriba y para que
        // el listener de la sincronía de puntos (abajo) recalculara posición
        // en cada uno de esos frames. 'instant' hace el salto en un solo
        // evento y de paso ahorra ese trabajo de layout.
        (cards[2] as HTMLElement).scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' as ScrollBehavior });
        updateCarouselState(2);
      }
    });

    cardsContainer.addEventListener('scroll', () => {
      if (!scrollTicking) {
        requestAnimationFrame(() => {
          const cards = cardsContainer.querySelectorAll('.plan-card');
          const containerRect = cardsContainer.getBoundingClientRect();
          const containerCenter = containerRect.left + containerRect.width / 2;
          let closestIndex = 0;
          let closestDistance = Infinity;

          cards.forEach((card, i) => {
            const cardRect = card.getBoundingClientRect();
            const cardCenter = cardRect.left + cardRect.width / 2;
            const distance = Math.abs(cardCenter - containerCenter);
            if (distance < closestDistance) {
              closestDistance = distance;
              closestIndex = i;
            }
          });

          updateCarouselState(closestIndex);
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    }, { passive: true });

    // Strip click → scroll to card
    stripItems.forEach((item) => {
      item.addEventListener('click', () => {
        const index = parseInt((item as HTMLElement).dataset.index || '0');
        const cards = cardsContainer.querySelectorAll('.plan-card');
        if (cards[index]) {
          (cards[index] as HTMLElement).scrollIntoView({
            behavior: 'smooth',
            inline: 'center',
            block: 'nearest',
          });
        }
      });
    });
  }
</script>
