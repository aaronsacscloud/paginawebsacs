---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmDashboard from '../../components/admin/CrmDashboard';
import { requireFounder } from '../../lib/auth/requireFounder';

export const prerender = false;

// Solo equipo interno (founder/cs). Partner o anónimo → login/portal.
const gate = await requireFounder(Astro);
if (gate) return gate;
---

<BaseLayout title="CRM — Sacs" description="CRM interno de Sacs" noindex={true}>
<script is:inline>
// viewport-fit=cover SOLO en el CRM: habilita env(safe-area-inset-*) en iPhone
// con notch (los toasts/bottom-nav lo usan). BaseLayout queda intacto.
(function () {
  var v = document.querySelector('meta[name="viewport"]');
  if (v) v.setAttribute('content', 'width=device-width, initial-scale=1, viewport-fit=cover');
  // ── M7 · PWA instalable ──
  // El manifest y los metas de app se inyectan SOLO aquí (BaseLayout intacto):
  // "Agregar a inicio" da una app standalone morada; el wrapper nativo futuro
  // hereda iconos, splash y safe-areas de esto mismo.
  var head = document.head;
  var mk = function (tag, attrs) { var e = document.createElement(tag); for (var k in attrs) e.setAttribute(k, attrs[k]); head.appendChild(e); };
  mk('link', { rel: 'manifest', href: '/crm-manifest.json' });
  mk('meta', { name: 'theme-color', content: '#5B4BD6' });
  mk('meta', { name: 'apple-mobile-web-app-capable', content: 'yes' });
  mk('meta', { name: 'apple-mobile-web-app-status-bar-style', content: 'default' });
  mk('meta', { name: 'apple-mobile-web-app-title', content: 'SACS CRM' });
  mk('link', { rel: 'apple-touch-icon', href: '/crm-icon-192.png' });
  // Multi-plataforma: notch/safe-areas (iPhone y Android con cámara) y color
  // de la barra del sistema acorde al tema del CRM.
  document.querySelector('meta[name="viewport"]')?.setAttribute('content', 'width=device-width, initial-scale=1.0, viewport-fit=cover');
  mk('meta', { name: 'theme-color', content: '#ffffff', media: '(prefers-color-scheme: light)' });
  mk('meta', { name: 'theme-color', content: '#131318', media: '(prefers-color-scheme: dark)' });
  // ══ REGLA DE VELOCIDAD: Service Worker — assets inmutables sin red y HTML
  // con fallback; la visita repetida (y la PWA) arranca local.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw-crm.js').catch(() => {});
    // El HTML se sirve del caché para que arranque al instante, así que tras
    // un despliegue el teléfono sigue viendo la versión de ayer. Cuando el
    // service worker detecta una versión nueva, se refresca en cuanto sea
    // seguro: nunca con algo escrito a medias ni con un panel abierto.
    /* ── RED DE SEGURIDAD: UN CHUNK QUE YA NO EXISTE ────────────────────
       El CRM carga cada pantalla por separado (import dinámico). Si el HTML
       cacheado es de ayer y el servidor ya no tiene ese archivo, el import
       falla con un 404 y esa pantalla NO SE DIBUJA: se queda el velo del panel
       y ningún panel. Desde fuera es «toco y no pasa nada» — y no hay error
       visible en ningún lado, porque el fallo es de red, no de código.
       Aquí se detecta ese caso concreto y se repara solo: se tiran los cachés
       y se recarga UNA vez. El candado en sessionStorage es lo que evita el
       bucle si el fallo fuera de verdad del servidor y no del caché. */
    const recuperarDeChunkMuerto = async (motivo) => {
      if (sessionStorage.getItem('crm-recarga-chunk')) return;   // ya se intentó
      sessionStorage.setItem('crm-recarga-chunk', String(Date.now()));
      try { for (const k of await caches.keys()) await caches.delete(k); } catch (_) {}
      console.warn('[crm] recargando: no se pudo cargar una pantalla —', motivo);
      location.reload();
    };
    window.addEventListener('error', (e) => {
      const m = String(e?.message || '');
      if (/dynamically imported module|Importing a module script failed|ChunkLoadError/i.test(m)) recuperarDeChunkMuerto(m);
    });
    window.addEventListener('unhandledrejection', (e) => {
      const m = String(e?.reason?.message || e?.reason || '');
      if (/dynamically imported module|Importing a module script failed|ChunkLoadError/i.test(m)) recuperarDeChunkMuerto(m);
    });

    let avisado = false;
    navigator.serviceWorker.addEventListener('message', (ev) => {
      if (ev.data?.tipo !== 'crm-version-nueva' || avisado) return;
      avisado = true;
      // ── Cuándo NO se puede recargar ──────────────────────────────────
      // Esta comprobación solo miraba [role="dialog"] y .vr-sheet, y se le
      // escapaban las hojas de acciones —que usan role="menu"— y la hoja de
      // confirmar. Resultado, reportado por el usuario dos veces: tocaba las
      // tres rayas, la hoja abría, y 1.5 s después la página se recargaba y se
      // la llevaba. Desde fuera se ve como "toco y no pasa nada", o como "abre
      // un menú blanco, lo cierra y se recarga". No era el menú: era el
      // refresco pasándole por encima.
      //
      // Se agrega también aria-modal, que es lo que marca cualquier cosa que
      // secuestra la pantalla, para que la próxima hoja que alguien escriba
      // quede cubierta sin tener que acordarse de esta lista.
      const ABIERTO = '[role="dialog"], [role="menu"], [aria-modal="true"], .vr-sheet, .cfm-fondo';
      let ultimoToque = 0;
      ['pointerdown', 'touchstart', 'keydown'].forEach(ev =>
        document.addEventListener(ev, () => { ultimoToque = Date.now(); }, true));
      const ocupado = () => {
        const a = document.activeElement;
        if (a && /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName)) return true;
        if (document.querySelector(ABIERTO)) return true;
        // Y tampoco se recarga encima de alguien que acaba de tocar: el gesto
        // puede estar a medias (un deslizamiento, un menú abriéndose).
        return Date.now() - ultimoToque < 3000;
      };
      const refrescar = () => { if (!ocupado()) location.reload(); else setTimeout(refrescar, 4000); };
      setTimeout(refrescar, 1500);
    });
  }
})();
</script>
<script is:inline>
// ══ REGLA DE VELOCIDAD: PRIME de datos. Mientras baja el bundle, las APIs
// del tab activo ya viajan en paralelo y aterrizan en la MISMA clave que usa
// swrGet — al hidratar, la pantalla pinta con datos sin esperar otra vuelta.
(() => {
  const tab = new URLSearchParams(location.search).get('tab') || 'dashboard';
  const hoy = new Date(); const y = hoy.getFullYear(), m = hoy.getMonth();
  const d1 = new Date(y, m, 1).toISOString().slice(0, 10);
  const d2 = new Date(y, m + 1, 0).toISOString().slice(0, 10);
  const h = hoy.toISOString().slice(0, 10);
  const APIS = {
    dashboard: [`/api/crm/reports/tablero?desde=${d1}&hasta=${d2}`, '/api/crm/cobranza', '/api/crm/soporte/dashboard?dias=14', `/api/scheduling/reuniones?from=${h}&to=${h}`],
    pipeline: ['/api/crm/contacts?limit=500&con_etapa=1'],
    clientes: ['/api/crm/arr/clientes'],
    cotizaciones: ['/api/revenue/quotes/kpis', '/api/revenue/quotes'],
    pagos: ['/api/crm/arr/summary'],
    soporte: ['/api/crm/soporte/bandeja'],
  };
  // El inbox guarda su snapshot con clave y forma propias
  if (tab === 'whatsapp' && !sessionStorage.getItem('swr:inbox-lista')) {
    fetch('/api/crm/whatsapp/inbox?filtro=todas&estado=abierta&orden=recientes&limit=50')
      .then(r => r.ok ? r.json() : null).then(j => {
        if (j) try { sessionStorage.setItem('swr:inbox-lista', JSON.stringify({ conversaciones: j.conversaciones || [], counts: j.counts || {} })); } catch (e) {}
      }).catch(() => {});
  }
  for (const u of APIS[tab] || []) {
    try {
      if (sessionStorage.getItem('swr:' + u)) continue; // ya hay caché: no gastar
      fetch(u).then(r => r.ok ? r.json() : null).then(j => {
        if (j != null) try { sessionStorage.setItem('swr:' + u, JSON.stringify(j)); } catch (e) {}
      }).catch(() => {});
    } catch (e) { /* nada */ }
  }
})();
</script>
<CrmDashboard client:only="react" />
</BaseLayout>

<style is:global>
/* Esconde el cromo del sitio público dentro del CRM.
   OJO con `header` a secas: el del sitio es <header class="nav" id="nav">, así
   que `.nav` ya lo cubre. Tenerlo suelto en la lista tumbaba TODO <header> de
   la página, incluido el de la ficha del contacto —que quedaba de 0×0 con su
   nombre y su botón de cerrar adentro—: se entraba a un contacto y no había
   forma de regresar sin salirse del CRM. */
/* ⚠️ Sin `nav` a secas: la MISMA trampa que ya pasó con `header` — tumbaba el
   BottomNav del CRM (que es <nav>) y el CRM móvil quedaba sin barra inferior.
   El nav del sitio es <header class="nav"> y `.nav` lo cubre. */
.nav, footer, .wa-bar, .final-cta, #partner-strip, .mega-dropdown, .mega-backdrop, #mobile-menu {
  display: none !important;
}
main { padding: 0 !important; margin: 0 !important; }
</style>
