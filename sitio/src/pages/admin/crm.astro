---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmDashboard from '../../components/admin/CrmDashboard';
import { requireFounder } from '../../lib/auth/requireFounder';

export const prerender = false;

// Solo equipo interno (founder/cs). Partner o anónimo → login/portal.
const gate = await requireFounder(Astro);
if (gate) return gate;
---

<BaseLayout title="CRM — Sacs" description="CRM interno de Sacs" noindex={true}>
<script is:inline>
// viewport-fit=cover SOLO en el CRM: habilita env(safe-area-inset-*) en iPhone
// con notch (los toasts/bottom-nav lo usan). BaseLayout queda intacto.
(function () {
  var v = document.querySelector('meta[name="viewport"]');
  if (v) v.setAttribute('content', 'width=device-width, initial-scale=1, viewport-fit=cover');
})();
</script>
<CrmDashboard client:only="react" />
</BaseLayout>

<style is:global>
nav, .nav, header, footer, .wa-bar, .final-cta {
  display: none !important;
}
main { padding: 0 !important; margin: 0 !important; }
</style>
