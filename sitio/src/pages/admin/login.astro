---
// Login de ADMINISTRADOR (founder/cs) del CRM. Reusa /api/auth/login.
// Si ya hay sesión de admin, salta directo a donde iba (?next) o al CRM.
//
// La puerta de entrada llevaba la paleta azul del sitio público sobre un fondo
// negro: nada que ver con el CRM que abre detrás. Ahora es lo primero que se
// ve del mismo lenguaje —el degradado de la cinta, la firma en rosa— y trae un
// saludo, porque a esta pantalla se entra todas las mañanas.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSessionFromRequest } from '../../lib/auth/session';

export const prerender = false;

const user = await getSessionFromRequest(Astro.request);
const nextParam = Astro.url.searchParams.get('next') || '';
const safeNext = nextParam.startsWith('/admin') ? nextParam : '/admin/crm';
if (user) {
  // partner no entra al admin; el equipo interno sí
  return Astro.redirect(user.role === 'partner' ? '/partner/portal' : safeNext);
}
---
<BaseLayout title="Acceso administrador — SACS" description="Panel interno de SACS" noindex={true} bareLayout={true}>
  <div class="auth-wrap">
    <!-- El lienzo del vuelo cuelga del contenedor, no del panel: las semillas
         tienen que poder cruzar la frontera hacia el lado del formulario. -->
    <canvas id="vuelo"></canvas>

    <!-- Panel de marca: el mensaje del día y quién firma esto. -->
    <aside class="auth-marca">

      <div class="auth-brand">
        <svg class="auth-chispa" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z" fill="#fff"/></svg>
        <span>
          <span class="auth-brand-nm">Sacs <b>CRM</b></span>
          <span class="auth-brand-fm">by Andy Araujo</span>
        </span>
      </div>

      <div class="auth-msg">
        <p class="auth-saludo" id="saludo">Hola</p>
        <h2 class="auth-frase">El match perfecto para construir un presente de éxito</h2>
        <ul class="auth-pilares">
          <li>Análisis</li><li>Tecnología</li><li>IA</li><li>Conexión estratégica</li>
        </ul>
        <p class="auth-cita">“Nadie crece solo: cada persona a la que ayudas a avanzar termina abriéndote el camino.”</p>
      </div>

      <p class="auth-pie">Panel interno · Solo el equipo de SACS</p>
    </aside>

    <!-- Formulario -->
    <main class="auth-lado">
      <form id="login-form" class="auth-card">
        <div class="auth-eyebrow">Acceso</div>
        <h1 class="auth-title">Entra a tu CRM</h1>
        <p class="auth-sub">Solo el equipo de SACS. Los partners entran en <a href="/partner/login">su portal</a>.</p>

        <label class="auth-label" for="email">Correo</label>
        <input id="email" type="email" autocomplete="username" required class="auth-input" placeholder="tu@correo.com" />

        <label class="auth-label" for="password">Contraseña</label>
        <input id="password" type="password" autocomplete="current-password" required class="auth-input" placeholder="••••••••" />

        <div id="error-msg" class="auth-error" role="alert" hidden></div>

        <button id="submit-btn" type="submit" class="auth-btn">Entrar</button>
        <div class="auth-foot"><a href="/partner/forgot-password">¿Olvidaste tu contraseña?</a></div>
        <span class="auth-firma">Sacs CRM · by Andy Araujo</span>
      </form>
    </main>
  </div>

  <style>
    /* El papel: lila clarito, como el menú del CRM. El negro de antes hacía
       que la pantalla siguiente pareciera de otro producto. */
    .auth-wrap {
      position: relative;
      min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr;
      background: linear-gradient(180deg, #FBFAFF 0%, #F6F3FE 55%, #F4EFFC 100%);
      font-family: 'DM Sans', system-ui, sans-serif;
    }

    /* ── Panel de marca ── */
    .auth-marca {
      position: relative; overflow: hidden;
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 44px 46px;
      color: #fff;
      background: linear-gradient(140deg, #6F5DE8 0%, #7C8FF3 46%, #D9538E 118%);
    }
    /* Dos halos: le dan profundidad al degradado sin meter una imagen que
       cargar en la pantalla de entrada. */
    .auth-marca::before, .auth-marca::after {
      content: ''; position: absolute; border-radius: 50%; pointer-events: none;
    }
    .auth-marca::before { width: 520px; height: 520px; top: -190px; right: -160px; background: radial-gradient(circle, rgba(255,255,255,.30), transparent 62%); }
    .auth-marca::after { width: 420px; height: 420px; bottom: -170px; left: -120px; background: radial-gradient(circle, rgba(255,255,255,.16), transparent 65%); }
    /* El diente de león en vuelo, sobre TODA la pantalla. La máscara hace dos
       trabajos: deja limpio el tercio izquierdo, donde va el texto, y apaga las
       semillas conforme cruzan al papel claro de la derecha. */
    #vuelo {
      position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2;
      -webkit-mask-image: linear-gradient(101deg, transparent 5%, rgba(0,0,0,.4) 17%, #000 30%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.22) 72%, transparent 88%);
      mask-image: linear-gradient(101deg, transparent 5%, rgba(0,0,0,.4) 17%, #000 30%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.22) 72%, transparent 88%);
    }
    .auth-marca { z-index: 0; }
    .auth-marca > * { position: relative; z-index: 1; }

    .auth-brand { display: flex; align-items: center; gap: 11px; }
    /* La chispa de la marca. Antes era un círculo con nada adentro: ocupaba
       el lugar de un logo sin serlo. */
    .auth-chispa { display: block; flex-shrink: 0; filter: drop-shadow(0 2px 10px rgba(0,0,0,.18)); }
    .auth-brand-nm { display: block; font-size: 1.12rem; font-weight: 800; letter-spacing: -.01em; line-height: 1.1; }
    .auth-brand-nm b { font-size: .52rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; background: rgba(255,255,255,.22); padding: 3px 6px; border-radius: 5px; vertical-align: middle; }
    .auth-brand-fm { display: block; font-size: .56rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #FBD3E5; margin-top: 3px; }

    .auth-saludo { font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.78); margin: 0 0 12px; }
    /* El color va explícito: la hoja global le pone tinta oscura a todos los
       h2, y una regla directa le gana a heredar el blanco del panel. */
    /* Un tercio más chico y sin caja alta: a 2 rem en mayúsculas el titular
       le ganaba a todo lo demás del panel, incluida la tarjeta de acceso. */
    .auth-frase { font-size: 1.62rem; line-height: 1.2; font-weight: 800; letter-spacing: -.02em; margin: 0; color: #fff; max-width: 17ch; }
    .auth-pilares { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
    .auth-pilares li { font-size: .66rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 11px; border-radius: 20px; background: rgba(255,255,255,.17); border: 1px solid rgba(255,255,255,.22); }
    .auth-cita { margin: 20px 0 0; padding-left: 14px; border-left: 2px solid rgba(255,255,255,.45); font-size: .92rem; line-height: 1.55; color: rgba(255,255,255,.9); font-style: italic; max-width: 34ch; }
    .auth-pie { font-size: .68rem; color: rgba(255,255,255,.66); margin: 0; letter-spacing: .02em; }

    /* ── Formulario ── */
    /* El lado derecho ya no es una hoja blanca aparte: el color de la izquierda
       se escurre sobre él y unas semillas lo cruzan. */
    .auth-lado { position: relative; z-index: 3; display: flex; align-items: center; justify-content: center; padding: 40px 24px; }
    .auth-lado::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(105% 120% at -18% 45%, rgba(140,120,250,.42), rgba(155,140,250,.14) 42%, transparent 66%),
        radial-gradient(75% 65% at 112% 92%, rgba(217,83,142,.20), transparent 62%);
    }
    .auth-card {
      position: relative; overflow: hidden;
      width: 100%; max-width: 372px; background: #fff; border-radius: 16px; padding: 32px 30px;
      box-shadow: 0 1px 3px rgba(40,20,90,.06), 0 18px 44px rgba(40,20,90,.12);
    }
    /* La cinta de la marca, de canto sobre la tarjeta: la misma que encabeza la
       cotización y la minuta. Es lo que la ata al resto de los documentos. */
    .auth-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg,#9B8CFA 0%,#7DA6F5 55%,rgba(244,168,205,.9) 100%);
    }
    .auth-firma {
      display: block; margin-top: 20px; padding-top: 15px; border-top: 1px solid #f0edfa;
      text-align: center; font-size: .56rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
      background: linear-gradient(100deg,#7C6BF0 0%,#8E7DEF 35%,#D9538E 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .auth-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #9c3d70; }
    .auth-title { font-size: 25px; font-weight: 800; letter-spacing: -.02em; margin: 6px 0 4px; color: #241d43; }
    .auth-sub { font-size: 13px; color: #6b7280; margin: 0 0 22px; line-height: 1.5; }
    .auth-sub a { color: #5B4BD6; text-decoration: none; font-weight: 700; }
    .auth-label { display: block; font-size: 12px; font-weight: 700; color: #4b4560; margin: 14px 0 6px; }
    .auth-input { width: 100%; box-sizing: border-box; padding: 11px 13px; font-size: 14px; border: 1px solid #eae4f8; border-radius: 10px; background: #FBFAFF; outline: none; font-family: inherit; color: #241d43; transition: border-color .15s ease, background .15s ease; }
    .auth-input:focus { border-color: #9B8CFA; background: #fff; box-shadow: 0 0 0 3px rgba(155,140,250,.16); }
    .auth-error { margin-top: 12px; padding: 10px 13px; background: #FEF0EF; border: 1px solid #F6D6D3; border-radius: 9px; font-size: 13px; color: #C0554E; }
    /* El botón que abre: morado sólido, el mismo de "aceptar" en la cotización. */
    .auth-btn { width: 100%; margin-top: 20px; padding: 12px; font-size: 14px; font-weight: 800; color: #fff; background: #9B8CFA; border: none; border-radius: 10px; cursor: pointer; font-family: inherit; transition: background .15s ease; }
    .auth-btn:hover:not(:disabled) { background: #7C6BF0; }
    .auth-btn:disabled { opacity: .6; cursor: default; }
    .auth-foot { text-align: center; margin-top: 16px; font-size: 13px; }
    .auth-foot a { color: #8e88a8; text-decoration: none; }

    /* En el teléfono el panel se vuelve una cinta arriba: el mensaje se lee
       igual y el formulario no queda debajo del fold. */
    @media (max-width: 900px) {
      /* En el teléfono el texto ocupa todo el ancho: el vuelo se desvanece
         hacia abajo en vez de hacia la izquierda y se queda en la franja de
         arriba. Con la máscara diagonal, la flor le pasaba por encima al
         titular. */
      #vuelo {
        -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.55) 34%, rgba(0,0,0,.18) 52%, transparent 66%);
        mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.55) 34%, rgba(0,0,0,.18) 52%, transparent 66%);
      }
      /* Apilado, el color se derrama hacia abajo desde la cinta de arriba. */
      .auth-lado::before {
        background: radial-gradient(120% 70% at 50% -12%, rgba(140,120,250,.34), rgba(155,140,250,.10) 46%, transparent 70%);
      }
      .auth-wrap { grid-template-columns: 1fr; }
      .auth-marca { padding: 26px 24px 30px; gap: 20px; min-height: 62vh; }
      .auth-frase { font-size: 1.3rem; max-width: none; }
      .auth-cita { font-size: .82rem; }
      .auth-pie { display: none; }
      .auth-lado { padding: 26px 20px 44px; align-items: flex-start; }
      .auth-card { box-shadow: 0 1px 3px rgba(40,20,90,.06), 0 10px 26px rgba(40,20,90,.10); }
    }
  </style>

  <script define:vars={{ safeNext }}>
    // El saludo se arma en el navegador: el servidor corre en UTC y a las 9 de
    // la noche de México habría dicho "buenos días".
    const h = new Date().getHours();
    const saludoEl = document.getElementById('saludo');
    if (saludoEl) saludoEl.textContent = h < 12 ? 'Buenos días' : h < 19 ? 'Buenas tardes' : 'Buenas noches';

    // ── El campo de destellos ───────────────────────────────────────────────
    // La expansión y la luz, dibujadas: un cielo de chispas que sube despacio y
    // titila. Reemplaza al diente de león porque la chispa ya es la marca —el
    // logo, el cargador— y repetirla aquí es lo que hace que una identidad se
    // reconozca.
    //
    // Se dibuja la SILUETA EXACTA del logo con Path2D, no una estrella
    // aproximada con curvas a mano: esa salía romboide y se leía como una
    // figura blanca, no como un destello.
    //
    // Tres capas con distinta densidad, tamaño y velocidad. Eso es lo que da
    // profundidad sin tocar 3D: lo grande y brillante se siente cerca, lo chico
    // y tenue lejos. Sin librerías — un motor de partículas son cientos de
    // kilobytes en la primera pantalla del día.
    (function campoDeDestellos() {
      const cv = document.getElementById('vuelo');
      if (!cv || !cv.getContext) return;
      const ctx = cv.getContext('2d');
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const FORMA = new Path2D('M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z');
      let W = 0, H = 0, DPR = 1, capas = [];

      // [reparto de la densidad, peso (opacidad y tamaño), velocidad]
      const CAPAS = [[.52, .28, 4], [.33, .55, 8], [.15, .9, 13]];

      function armar() {
        /* La cantidad y el tamaño salen del ÁREA del panel, no de un número
           fijo. Con 67 chispas fijas el panel real —el doble de grande que
           cualquier maqueta— quedaba con destellos diminutos y dispersos: se
           veía vacío. Una cada ~9,000 px² mantiene el cielo igual de poblado
           en cualquier pantalla. */
        const total = Math.round((W * H) / 9000);
        const escala = Math.max(1, Math.min(2, Math.sqrt((W * H) / 420000)));
        capas = CAPAS.map(([parte, peso, vel]) => {
          const arr = [];
          for (let i = 0, n = Math.round(total * parte); i < n; i++) arr.push({
            x: Math.random() * W,
            y: Math.random() * H,
            r: (1.1 + Math.random() * peso * 6) * escala,
            f: Math.random() * 6.3,          // desfase del titileo
            v: peso * vel * 0.05,
            op: peso,
          });
          return arr;
        });
      }

      // La ruta mide 24 y su centro está en (12, 11.4): hay que recentrarla
      // antes de escalar o las chispas orbitan alrededor de la esquina.
      function chispa(x, y, r, alpha, giro, brillo) {
        const k = r / 11;
        ctx.save();
        ctx.translate(x, y); ctx.rotate(giro); ctx.scale(k, k); ctx.translate(-12, -11.4);
        ctx.globalAlpha = alpha; ctx.fillStyle = '#fff';
        // El halo se dibuja solo en las grandes: `shadowBlur` es de lo más caro
        // del canvas y en las diminutas no se nota.
        if (brillo > 0) { ctx.shadowColor = 'rgba(255,255,255,.85)'; ctx.shadowBlur = brillo; }
        ctx.fill(FORMA);
        ctx.restore();
      }

      function pintar(t, dt) {
        ctx.clearRect(0, 0, W, H);
        for (const capa of capas) for (const p of capa) {
          // Suben despacio; al salir por arriba vuelven a nacer abajo.
          p.y -= p.v * dt * 10;
          if (p.y < -14) { p.y = H + 14; p.x = Math.random() * W; }
          const tit = 0.4 + 0.6 * Math.sin(t * 1.15 + p.f);
          chispa(p.x, p.y, p.r * (0.9 + tit * 0.25), p.op * tit, p.f + t * 0.12, p.r > 2.6 ? 5 + tit * 6 : 0);
        }
      }

      let prev = 0;
      function cuadro(now) {
        const t = now / 1000;
        const dt = Math.min(0.05, prev ? (now - prev) / 1000 : 0.016);
        prev = now;
        pintar(t, dt);
        requestAnimationFrame(cuadro);
      }

      function medir() {
        DPR = Math.min(window.devicePixelRatio || 1, 2);
        W = cv.clientWidth; H = cv.clientHeight;
        if (!W || !H) return;
        cv.width = W * DPR; cv.height = H * DPR;
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        armar();
        // Con movimiento reducido se pinta UN cuadro y ahí se queda: el cielo
        // sigue estando, solo que quieto.
        if (quieto) pintar(0, 0);
      }

      window.addEventListener('resize', medir);
      medir();
      if (!quieto) requestAnimationFrame(cuadro);
    })();

    const form = document.getElementById('login-form');
    const btn = document.getElementById('submit-btn');
    const err = document.getElementById('error-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      btn.disabled = true; btn.textContent = 'Verificando…';
      try {
        const res = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }) });
        const data = await res.json();
        if (!res.ok) {
          err.textContent = data.error || 'No se pudo iniciar sesión';
          err.hidden = false; btn.disabled = false; btn.textContent = 'Entrar';
          return;
        }
        // partner no debe caer en admin
        if (data.role === 'partner') { window.location.href = '/partner/portal'; return; }
        window.location.href = safeNext || data.redirect || '/admin/crm';
      } catch (e) {
        err.textContent = 'Error de conexión. Intenta de nuevo.';
        err.hidden = false; btn.disabled = false; btn.textContent = 'Entrar';
      }
    });
  </script>
</BaseLayout>
