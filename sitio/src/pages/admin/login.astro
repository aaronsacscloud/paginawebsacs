---
// Login de ADMINISTRADOR (founder/cs) del CRM. Reusa /api/auth/login.
// Si ya hay sesión de admin, salta directo a donde iba (?next) o al CRM.
//
// La puerta de entrada llevaba la paleta azul del sitio público sobre un fondo
// negro: nada que ver con el CRM que abre detrás. Ahora es lo primero que se
// ve del mismo lenguaje —el degradado de la cinta, la firma en rosa— y trae un
// saludo, porque a esta pantalla se entra todas las mañanas.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSessionFromRequest } from '../../lib/auth/session';

export const prerender = false;

const user = await getSessionFromRequest(Astro.request);
const nextParam = Astro.url.searchParams.get('next') || '';
const safeNext = nextParam.startsWith('/admin') ? nextParam : '/admin/crm';
if (user) {
  // partner no entra al admin; el equipo interno sí
  return Astro.redirect(user.role === 'partner' ? '/partner/portal' : safeNext);
}
---
<BaseLayout title="Acceso administrador — SACS" description="Panel interno de SACS" noindex={true} bareLayout={true}>
  <div class="auth-wrap">
    <!-- Panel de marca: el mensaje del día y quién firma esto. -->
    <aside class="auth-marca">
      <!-- El cielo vive DENTRO del panel: las constelaciones se colocan en
           fracciones de este ancho, y fuera del morado no se ven. La cola del
           cometa es la que sí cruza, y va en su propio lienzo. -->
      <canvas id="vuelo"></canvas>

      <div class="auth-brand">
        <svg class="auth-chispa" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z" fill="#fff"/></svg>
        <span>
          <span class="auth-brand-nm">Sacs <b>CRM</b></span>
          <span class="auth-brand-fm">by Andy Araujo</span>
        </span>
      </div>

      <div class="auth-msg">
        <p class="auth-saludo" id="saludo">Hola</p>
        <h2 class="auth-frase">El match perfecto para construir un presente de éxito</h2>
        <ul class="auth-pilares">
          <li>Análisis</li><li>Tecnología</li><li>IA</li><li>Conexión estratégica</li>
        </ul>
        <p class="auth-cita">“Nadie crece solo: cada persona a la que ayudas a avanzar termina abriéndote el camino.”</p>
      </div>

      <!-- El cierre del panel: la frase del cielo, sola. Antes aquí decía
           «Panel interno · Solo el equipo de SACS», que no le dice nada a
           quien ya está entrando y le quitaba el lugar a la frase. -->
      <p class="auth-susurro" id="susurro">
        <span class="auth-susurro-lz"></span>
        <svg width="11" height="11" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z" fill="#FBD3E5"/></svg>
        <span>Conectando estrellas, creando constelaciones.</span>
      </p>
    </aside>

    <!-- Formulario -->
    <main class="auth-lado">
      <form id="login-form" class="auth-card">
        <div class="auth-eyebrow">Acceso</div>
        <h1 class="auth-title">Entra a tu CRM</h1>
        <p class="auth-sub">Solo el equipo de SACS. Los partners entran en <a href="/partner/login">su portal</a>.</p>

        <label class="auth-label" for="email">Correo</label>
        <input id="email" type="email" autocomplete="username" required class="auth-input" placeholder="tu@correo.com" />

        <label class="auth-label" for="password">Contraseña</label>
        <input id="password" type="password" autocomplete="current-password" required class="auth-input" placeholder="••••••••" />

        <div id="error-msg" class="auth-error" role="alert" hidden></div>

        <button id="submit-btn" type="submit" class="auth-btn">Entrar</button>
        <div class="auth-foot"><a href="/partner/forgot-password">¿Olvidaste tu contraseña?</a></div>
        <span class="auth-firma">Sacs CRM · by Andy Araujo</span>
      </form>
    </main>

    <!-- La cola del cometa, encima de TODO y en toda la ventana: cruza del
         panel al formulario sin cortarse. No intercepta el cursor, así que los
         campos y el botón siguen funcionando igual. -->
    <canvas id="fugaz"></canvas>
  </div>

  <style>
    /* El papel: lila clarito, como el menú del CRM. El negro de antes hacía
       que la pantalla siguiente pareciera de otro producto. */
    .auth-wrap {
      position: relative;
      min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr;
      background: linear-gradient(180deg, #FBFAFF 0%, #F6F3FE 55%, #F4EFFC 100%);
      font-family: 'DM Sans', system-ui, sans-serif;
    }

    /* ── Panel de marca ── */
    .auth-marca {
      position: relative; overflow: hidden;
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 44px 46px;
      color: #fff;
      background: linear-gradient(140deg, #6F5DE8 0%, #7C8FF3 46%, #D9538E 118%);
    }
    /* Dos halos: le dan profundidad al degradado sin meter una imagen que
       cargar en la pantalla de entrada. */
    .auth-marca::before, .auth-marca::after {
      content: ''; position: absolute; border-radius: 50%; pointer-events: none;
    }
    .auth-marca::before { width: 520px; height: 520px; top: -190px; right: -160px; background: radial-gradient(circle, rgba(255,255,255,.30), transparent 62%); }
    .auth-marca::after { width: 420px; height: 420px; bottom: -170px; left: -120px; background: radial-gradient(circle, rgba(255,255,255,.16), transparent 65%); }
    /* El cielo del panel. La máscara hace dos trabajos: deja limpio el borde
       izquierdo, donde arranca el texto, y apaga el cielo conforme se acerca al
       papel claro de la derecha, para que no haya una línea de corte. */
    #vuelo {
      position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0;
      -webkit-mask-image: linear-gradient(101deg, transparent 1%, rgba(0,0,0,.62) 11%, #000 30%, rgba(0,0,0,.80) 58%, rgba(0,0,0,.42) 80%, transparent 96%);
      mask-image: linear-gradient(101deg, transparent 1%, rgba(0,0,0,.62) 11%, #000 30%, rgba(0,0,0,.80) 58%, rgba(0,0,0,.42) 80%, transparent 96%);
    }
    /* La cola del cometa NO lleva máscara ni se queda en el panel: es la única
       capa que cruza los dos lados de la pantalla. */
    #fugaz { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 90; }
    @media (prefers-reduced-motion: reduce) { #fugaz { display: none; } }
    .auth-marca { z-index: 0; }
    .auth-marca > * { position: relative; z-index: 1; }

    .auth-brand { display: flex; align-items: center; gap: 11px; }
    /* La chispa de la marca. Antes era un círculo con nada adentro: ocupaba
       el lugar de un logo sin serlo. */
    .auth-chispa { display: block; flex-shrink: 0; filter: drop-shadow(0 2px 10px rgba(0,0,0,.18)); }
    .auth-brand-nm { display: block; font-size: 1.12rem; font-weight: 800; letter-spacing: -.01em; line-height: 1.1; }
    .auth-brand-nm b { font-size: .52rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; background: rgba(255,255,255,.22); padding: 3px 6px; border-radius: 5px; vertical-align: middle; }
    .auth-brand-fm { display: block; font-size: .56rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #FBD3E5; margin-top: 3px; }

    .auth-saludo { font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.78); margin: 0 0 12px; }
    /* El color va explícito: la hoja global le pone tinta oscura a todos los
       h2, y una regla directa le gana a heredar el blanco del panel. */
    /* Sin caja alta: en mayúsculas el titular le ganaba a todo el panel,
       incluida la tarjeta de acceso. La sombra es para que no se pierda cuando
       una estrella del fondo le pasa por detrás. */
    .auth-frase { font-size: 2rem; line-height: 1.16; font-weight: 800; letter-spacing: -.025em; margin: 0; color: #fff; max-width: 16ch; text-shadow: 0 2px 22px rgba(40,20,90,.22); }
    .auth-pilares { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
    .auth-pilares li { font-size: .66rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 11px; border-radius: 20px; background: rgba(255,255,255,.17); border: 1px solid rgba(255,255,255,.22); }
    .auth-cita { margin: 20px 0 0; padding-left: 14px; border-left: 2px solid rgba(255,255,255,.45); font-size: .92rem; line-height: 1.55; color: rgba(255,255,255,.9); font-style: italic; max-width: 34ch; }
    /* El susurro: la frase del cielo. Chiquita y en cursiva, sin caja, para que
       no compita con la cita de arriba. RESPIRA con el dibujo —se aclara
       mientras las estrellas se están uniendo y se recuesta cuando la
       constelación ya quedó—, que es lo que hace que se sienta dicha por el
       cielo y no pegada encima. */
    .auth-susurro {
      display: flex; align-items: center; gap: 9px; margin: 0;
      font-size: .82rem; font-style: italic; line-height: 1.4; color: rgba(255,255,255,.6);
      opacity: 0; transform: translateY(6px);
      transition: opacity 1.2s ease, transform 1.2s ease, color 1.6s ease;
    }
    .auth-susurro.on { opacity: 1; transform: none; }
    .auth-susurro.viva { color: rgba(255,255,255,.95); }
    .auth-susurro-lz { flex: none; width: 26px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.6)); }
    .auth-susurro svg { flex: none; opacity: .55; transition: opacity 1.6s ease; }
    .auth-susurro.viva svg { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .auth-susurro { opacity: 1; transform: none; color: rgba(255,255,255,.8); } }


    /* ── Formulario ── */
    /* El lado derecho ya no es una hoja blanca aparte: el color de la izquierda
       se escurre sobre él y unas semillas lo cruzan. */
    .auth-lado { position: relative; z-index: 3; display: flex; align-items: center; justify-content: center; padding: 40px 24px; }
    .auth-lado::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(105% 120% at -18% 45%, rgba(140,120,250,.42), rgba(155,140,250,.14) 42%, transparent 66%),
        radial-gradient(75% 65% at 112% 92%, rgba(217,83,142,.20), transparent 62%);
    }
    .auth-card {
      position: relative; overflow: hidden;
      width: 100%; max-width: 372px; background: #fff; border-radius: 16px; padding: 32px 30px;
      box-shadow: 0 1px 3px rgba(40,20,90,.06), 0 18px 44px rgba(40,20,90,.12);
    }
    /* La cinta de la marca, de canto sobre la tarjeta: la misma que encabeza la
       cotización y la minuta. Es lo que la ata al resto de los documentos. */
    .auth-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg,#9B8CFA 0%,#7DA6F5 55%,rgba(244,168,205,.9) 100%);
    }
    .auth-firma {
      display: block; margin-top: 20px; padding-top: 15px; border-top: 1px solid #f0edfa;
      text-align: center; font-size: .56rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
      background: linear-gradient(100deg,#7C6BF0 0%,#8E7DEF 35%,#D9538E 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .auth-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #9c3d70; }
    .auth-title { font-size: 25px; font-weight: 800; letter-spacing: -.02em; margin: 6px 0 4px; color: #241d43; }
    .auth-sub { font-size: 13px; color: #6b7280; margin: 0 0 22px; line-height: 1.5; }
    .auth-sub a { color: #5B4BD6; text-decoration: none; font-weight: 700; }
    .auth-label { display: block; font-size: 12px; font-weight: 700; color: #4b4560; margin: 14px 0 6px; }
    .auth-input { width: 100%; box-sizing: border-box; padding: 11px 13px; font-size: 14px; border: 1px solid #eae4f8; border-radius: 10px; background: #FBFAFF; outline: none; font-family: inherit; color: #241d43; transition: border-color .15s ease, background .15s ease; }
    .auth-input:focus { border-color: #9B8CFA; background: #fff; box-shadow: 0 0 0 3px rgba(155,140,250,.16); }
    .auth-error { margin-top: 12px; padding: 10px 13px; background: #FEF0EF; border: 1px solid #F6D6D3; border-radius: 9px; font-size: 13px; color: #C0554E; }
    /* El botón que abre: morado sólido, el mismo de "aceptar" en la cotización. */
    .auth-btn { width: 100%; margin-top: 20px; padding: 12px; font-size: 14px; font-weight: 800; color: #fff; background: #9B8CFA; border: none; border-radius: 10px; cursor: pointer; font-family: inherit; transition: background .15s ease; }
    .auth-btn:hover:not(:disabled) { background: #7C6BF0; }
    .auth-btn:disabled { opacity: .6; cursor: default; }
    .auth-foot { text-align: center; margin-top: 16px; font-size: 13px; }
    .auth-foot a { color: #8e88a8; text-decoration: none; }

    /* En el teléfono el panel se vuelve una cinta arriba: el mensaje se lee
       igual y el formulario no queda debajo del fold. */
    @media (max-width: 900px) {
      /* En el teléfono el texto ocupa todo el ancho: el vuelo se desvanece
         hacia abajo en vez de hacia la izquierda y se queda en la franja de
         arriba. Con la máscara diagonal, la flor le pasaba por encima al
         titular. */
      #vuelo {
        -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.55) 34%, rgba(0,0,0,.18) 52%, transparent 66%);
        mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.55) 34%, rgba(0,0,0,.18) 52%, transparent 66%);
      }
      /* Apilado, el color se derrama hacia abajo desde la cinta de arriba. */
      .auth-lado::before {
        background: radial-gradient(120% 70% at 50% -12%, rgba(140,120,250,.34), rgba(155,140,250,.10) 46%, transparent 70%);
      }
      .auth-wrap { grid-template-columns: 1fr; }
      .auth-marca { padding: 26px 24px 30px; gap: 20px; min-height: 62vh; }
      .auth-frase { font-size: 1.5rem; max-width: none; }
      .auth-cita { font-size: .82rem; }
      .auth-susurro { font-size: .74rem; }
      .auth-lado { padding: 26px 20px 44px; align-items: flex-start; }
      .auth-card { box-shadow: 0 1px 3px rgba(40,20,90,.06), 0 10px 26px rgba(40,20,90,.10); }
    }
  </style>

  <script define:vars={{ safeNext }}>
    // El saludo se arma en el navegador: el servidor corre en UTC y a las 9 de
    // la noche de México habría dicho "buenos días".
    const h = new Date().getHours();
    const saludoEl = document.getElementById('saludo');
    if (saludoEl) saludoEl.textContent = h < 12 ? 'Buenos días' : h < 19 ? 'Buenas tardes' : 'Buenas noches';

    // ── El cielo de la entrada ──────────────────────────────────────────────
    // Tres constelaciones que se dibujan solas, una tras otra: ANDRÓMEDA —con
    // sus coordenadas reales—, EL CORAZÓN y LA CHISPA de la marca. Debajo,
    // cuatro capas de estrellas que suben y titilan. Y encima de todo, el
    // cursor convertido en cometa, con una cola que cruza del panel al
    // formulario.
    //
    // Es la idea del CRM dibujada: conectar estrellas hasta que se vea la
    // figura. Sin librerías —un motor de partículas son cientos de kilobytes
    // en la primera pantalla del día— y con la SILUETA EXACTA del logo en un
    // Path2D, no una estrella aproximada a mano: esa sale romboide.
    (function cieloDeLaEntrada() {
      const cv = document.getElementById('vuelo');
      const fz = document.getElementById('fugaz');
      if (!cv || !cv.getContext) return;
      const ctx = cv.getContext('2d');
      const fx = fz && fz.getContext ? fz.getContext('2d') : null;
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const FORMA = new Path2D('M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z');

      /* ANDRÓMEDA, de verdad: ascensión recta en horas, declinación en grados y
         magnitud aparente — nada inventado. Por eso Mirach (2.05) y Almach
         (2.10) salen como las dos más brillantes: es como se ven en el cielo.
         Las otras dos son nuestras y se dibujan en una retícula de 0..1 que se
         escala al panel. `caja` es [x, y, ancho, alto] en fracciones del panel:
         las tres viven en zonas sin texto. */
      const ANDROMEDA = {
        real: true, caja: [0.09, 0.11, 0.44, 0.20],
        estrellas: [
          { id: 'alpheratz', ra: 0.139, dec: 29.09, mag: 2.06 },
          { id: 'delta',     ra: 0.655, dec: 30.86, mag: 3.27 },
          { id: 'pi',        ra: 0.611, dec: 33.72, mag: 4.34 },
          { id: 'mirach',    ra: 1.162, dec: 35.62, mag: 2.05 },
          { id: 'mu',        ra: 0.947, dec: 38.50, mag: 3.86 },
          { id: 'nu',        ra: 0.831, dec: 41.08, mag: 4.53 },
          { id: 'upsilon',   ra: 1.613, dec: 41.41, mag: 4.09 },
          { id: 'almach',    ra: 2.065, dec: 42.33, mag: 2.10 },
        ],
        trazos: [['alpheratz','delta'], ['delta','mirach'], ['delta','pi'],
                 ['mirach','mu'], ['mu','nu'], ['mirach','upsilon'], ['upsilon','almach']],
      };

      const CORAZON = {
        caja: [0.56, 0.07, 0.29, 0.25],
        estrellas: [
          { id: 'p0', x: 0.50, y: 0.26, b: 1.6 }, { id: 'l1', x: 0.30, y: 0.08, b: 2.4 },
          { id: 'l2', x: 0.08, y: 0.20, b: 1.5 }, { id: 'l3', x: 0.06, y: 0.46, b: 1.5 },
          { id: 'l4', x: 0.26, y: 0.72, b: 1.4 }, { id: 'b',  x: 0.50, y: 1.00, b: 2.2 },
          { id: 'r4', x: 0.74, y: 0.72, b: 1.4 }, { id: 'r3', x: 0.94, y: 0.46, b: 1.5 },
          { id: 'r2', x: 0.92, y: 0.20, b: 1.5 }, { id: 'r1', x: 0.70, y: 0.08, b: 2.4 },
        ],
        trazos: [['p0','l1'],['l1','l2'],['l2','l3'],['l3','l4'],['l4','b'],
                 ['b','r4'],['r4','r3'],['r3','r2'],['r2','r1'],['r1','p0']],
      };

      /* La Chispa: la marca dibujada en el cielo. Cuatro puntas desde un núcleo
         y los cuatro puntos intermedios que le dan la cintura cóncava del logo
         — sin ellos sale un rombo, no un destello. */
      const CHISPA = {
        /* Abajo a la derecha, sobre el rosa. Medido: en la franja azul clara de
           en medio el trazo blanco casi no se ve. */
        caja: [0.55, 0.56, 0.27, 0.27],
        estrellas: [
          { id: 'c', x: 0.50, y: 0.50, b: 2.8 },
          { id: 'n', x: 0.50, y: 0.00, b: 2.2 }, { id: 's', x: 0.50, y: 1.00, b: 2.2 },
          { id: 'e', x: 1.00, y: 0.50, b: 2.2 }, { id: 'o', x: 0.00, y: 0.50, b: 2.2 },
          { id: 'ne', x: 0.66, y: 0.34, b: 1.1 }, { id: 'no', x: 0.34, y: 0.34, b: 1.1 },
          { id: 'se', x: 0.66, y: 0.66, b: 1.1 }, { id: 'so', x: 0.34, y: 0.66, b: 1.1 },
        ],
        trazos: [['n','ne'],['ne','e'],['e','se'],['se','s'],['s','so'],['so','o'],['o','no'],['no','n'],
                 ['c','n'],['c','e'],['c','s'],['c','o']],
      };

      const FIGURAS = [ANDROMEDA, CORAZON, CHISPA];
      const CICLO = 10;                 // segundos por constelación
      // [reparto de la densidad, peso (opacidad y tamaño), velocidad]
      const CAPAS = [[.40, .18, 1.4], [.30, .32, 4], [.20, .58, 8], [.10, .92, 13]];
      let W = 0, H = 0, capas = [];

      function armar() {
        /* La cantidad y el tamaño salen del ÁREA del panel, no de un número
           fijo: con un número fijo, el panel real —más grande que cualquier
           maqueta— queda con destellos diminutos y dispersos. */
        const total = Math.round((W * H) / 3800);
        const escala = Math.max(1, Math.min(2, Math.sqrt((W * H) / 420000)));
        capas = CAPAS.map(([parte, peso, vel]) => {
          const arr = [];
          for (let i = 0, n = Math.round(total * parte); i < n; i++) arr.push({
            x: Math.random() * W, y: Math.random() * H,
            r: (0.9 + Math.random() * peso * 6) * escala,
            f: Math.random() * 6.3,            // desfase del titileo
            v: peso * vel * 0.05, op: peso,
          });
          return arr;
        });
        for (const F of FIGURAS) colocar(F, escala);
      }

      /* Cada figura conserva su proporción: estirarla para llenar su caja la
         dejaría de parecerse a sí misma. En Andrómeda, una hora de ascensión
         recta son 15 grados, y por eso se divide la declinación. */
      function colocar(F, escala) {
        const [cx, cy, cw0, ch0] = F.caja;
        const x0 = W * cx, y0 = H * cy, cw = W * cw0, ch = H * ch0;
        F.pos = {};
        if (F.real) {
          let raMin = 99, raMax = -99, dcMin = 99, dcMax = -99;
          for (const s of F.estrellas) {
            raMin = Math.min(raMin, s.ra); raMax = Math.max(raMax, s.ra);
            dcMin = Math.min(dcMin, s.dec); dcMax = Math.max(dcMax, s.dec);
          }
          const k = Math.min(cw / (raMax - raMin), ch / ((dcMax - dcMin) / 15));
          for (const s of F.estrellas) F.pos[s.id] = {
            x: x0 + (s.ra - raMin) * k,
            y: y0 + ch - (s.dec - dcMin) / 15 * k,
            // Magnitud → radio: cuanto MENOR la magnitud, más brilla.
            r: (5.4 - (s.mag - 2) * 0.72) * escala * 0.86,
            f: Math.random() * 6.3,
          };
        } else {
          for (const s of F.estrellas) F.pos[s.id] = {
            x: x0 + s.x * cw, y: y0 + s.y * ch,
            r: (1.9 + s.b) * escala * 0.92, f: Math.random() * 6.3,
          };
        }
      }

      // La ruta mide 24 y su centro está en (12, 11.4): hay que recentrarla
      // antes de escalar o las chispas orbitan alrededor de la esquina.
      function chispa(c2, x, y, r, alpha, giro, brillo, color) {
        const k = r / 11;
        c2.save();
        c2.translate(x, y); c2.rotate(giro); c2.scale(k, k); c2.translate(-12, -11.4);
        c2.globalAlpha = alpha; c2.fillStyle = color || '#fff';
        // El halo se dibuja solo en las grandes: `shadowBlur` es de lo más caro
        // del canvas y en las diminutas no se nota.
        if (brillo > 0) { c2.shadowColor = color || 'rgba(255,255,255,.85)'; c2.shadowBlur = brillo; }
        c2.fill(FORMA);
        c2.restore();
      }

      /* Se dibuja sola: las líneas se trazan una tras otra, cada estrella
         aparece justo antes de que la línea llegue a ella, la figura se sostiene
         un momento y se desvanece para dejar entrar a la siguiente. */
      function pintarFigura(F, fase, t) {
        const salida = fase > 0.80 ? Math.max(0, 1 - (fase - 0.80) / 0.20) : 1;
        if (salida <= 0) return;
        ctx.lineCap = 'round';
        for (let i = 0; i < F.trazos.length; i++) {
          const A = F.pos[F.trazos[i][0]], B = F.pos[F.trazos[i][1]];
          if (!A || !B) continue;
          const ini = i / F.trazos.length * 0.58, dur = 0.58 / F.trazos.length * 1.7;
          const k = Math.max(0, Math.min(1, (fase - ini) / dur)) * salida;
          if (k <= 0) continue;
          ctx.strokeStyle = 'rgba(255,255,255,' + (0.40 * salida) + ')'; ctx.lineWidth = 1.4;
          ctx.beginPath(); ctx.moveTo(A.x, A.y);
          ctx.lineTo(A.x + (B.x - A.x) * k, A.y + (B.y - A.y) * k); ctx.stroke();
        }
        let j = 0; const n = F.estrellas.length;
        for (const id in F.pos) {
          const p = F.pos[id];
          const vis = Math.max(0, Math.min(1, (fase - j / n * 0.58) / 0.08)) * salida;
          if (vis > 0) {
            const tit = 0.72 + 0.28 * Math.sin(t * 0.9 + p.f);
            chispa(ctx, p.x, p.y, p.r * (0.94 + tit * 0.12), vis * Math.min(1, tit + .2), p.f + t * 0.05, 12 + tit * 9);
          }
          j++;
        }
      }

      // ── El cometa, en TODA la ventana ─────────────────────────────────────
      let FW = 0, FH = 0, estela = [], cola = [], mouse = null, dentro = false;
      /* Dónde termina el panel morado: es lo que decide el color de la cola.
         Se mide del DOM y no se asume la mitad —el panel es 1.05fr contra 1fr—.
         En el teléfono el panel es una cinta de arriba, así que también hace
         falta saber dónde termina hacia abajo. */
      let corte = 0, corteY = 0;
      const sobreMorado = (x, y) => x < corte && y < corteY;
      // Sobre el morado la cola tiene que ser MÁS luminosa que su cielo o
      // desaparece; sobre el papel claro pasa exactamente lo contrario.
      const paleta = (x, y) => (sobreMorado(x, y) ? ['#ffffff', '#FFE9F3'] : ['#9B8CFA', '#D9538E']);

      function moverA(x, y) {
        if (mouse) {
          const dx = x - mouse.x, dy = y - mouse.y, d = Math.hypot(dx, dy);
          const n = Math.min(4, Math.round(d / 4));
          for (let i = 0; i < n; i++) {
            const k = i / Math.max(1, n), px = mouse.x + dx * k, py = mouse.y + dy * k;
            const pal = paleta(px, py);
            estela.push({
              x: px + (Math.random() - .5) * 6, y: py + (Math.random() - .5) * 6,
              vx: dx * 0.02 + (Math.random() - .5) * 0.5, vy: dy * 0.02 + (Math.random() - .5) * 0.5,
              vida: 1, r: 1.8 + Math.random() * 3.2,
              c: pal[(Math.random() * pal.length) | 0], f: Math.random() * 6.3,
            });
          }
        }
        mouse = { x, y }; dentro = true;
        cola.push({ x, y, vida: 1 });
        if (cola.length > 40) cola.shift();
      }

      function pintarCometa(t, dt) {
        if (!fx) return;
        fx.clearRect(0, 0, FW, FH);
        for (let c = cola.length - 1; c >= 0; c--) {
          cola[c].vida -= dt * 1.2;
          if (cola[c].vida <= 0) cola.splice(c, 1);
        }
        if (cola.length > 1) {
          fx.save(); fx.lineCap = 'round'; fx.lineJoin = 'round';
          for (let i = 1; i < cola.length; i++) {
            const A = cola[i - 1], B = cola[i];
            // Un salto grande es el mouse que se fue y volvió: no se une.
            if (Math.hypot(B.x - A.x, B.y - A.y) > 150) continue;
            const k = i / cola.length;
            const rgb = sobreMorado(B.x, B.y) ? [255, 255, 255] : [124, 107, 240];
            fx.strokeStyle = 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + (0.42 * k * B.vida) + ')';
            fx.lineWidth = 0.8 + 7 * k * B.vida;      // la cola se afila hacia atrás
            fx.shadowColor = 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + (0.7 * k) + ')';
            fx.shadowBlur = 22 * k;
            fx.beginPath(); fx.moveTo(A.x, A.y); fx.lineTo(B.x, B.y); fx.stroke();
          }
          fx.restore();
        }
        for (let j = estela.length - 1; j >= 0; j--) {
          const p = estela[j];
          p.vida -= dt * 0.7;
          if (p.vida <= 0) { estela.splice(j, 1); continue; }
          p.x += p.vx; p.y += p.vy; p.vx *= 0.965; p.vy *= 0.965;
          chispa(fx, p.x, p.y, p.r * (0.5 + p.vida * 1.1), p.vida * 0.95, p.f + t * 0.6, 14 * p.vida, p.c);
        }
        if (dentro && mouse) {
          const claro = sobreMorado(mouse.x, mouse.y);
          chispa(fx, mouse.x, mouse.y, 7.4, 0.55, -t * 0.5, 30, claro ? '#FFE9F3' : '#EFA6CA');
          chispa(fx, mouse.x, mouse.y, 12, 1, t * 0.8, 26, claro ? '#fff' : '#7C6BF0');
        }
      }

      /* El susurro respira con el dibujo: se aclara mientras las estrellas se
         están uniendo —la primera parte del ciclo es cuando se trazan las
         líneas— y se recuesta cuando la figura ya quedó. */
      const sus = document.getElementById('susurro');
      let susViva = null;
      function respirar(t) {
        if (!sus) return;
        const viva = ((t % CICLO) / CICLO) < 0.62;
        if (viva !== susViva) { susViva = viva; sus.classList.toggle('viva', viva); }
      }

      function pintar(t, dt) {
        ctx.clearRect(0, 0, W, H);
        for (const capa of capas) for (const p of capa) {
          // Suben despacio; al salir por arriba vuelven a nacer abajo.
          p.y -= p.v * dt * 10;
          if (p.y < -14) { p.y = H + 14; p.x = Math.random() * W; }
          const tit = 0.4 + 0.6 * Math.sin(t * 1.15 + p.f);
          chispa(ctx, p.x, p.y, p.r * (0.9 + tit * 0.25), p.op * tit * 0.8, p.f + t * 0.12, p.r > 2.6 ? 5 + tit * 6 : 0);
        }
        pintarFigura(FIGURAS[Math.floor(t / CICLO) % 3], (t % CICLO) / CICLO, t);
        respirar(t);
        pintarCometa(t, dt);
      }

      let prev = 0;
      function cuadro(now) {
        const t = now / 1000;
        const dt = Math.min(0.05, prev ? (now - prev) / 1000 : 0.016);
        prev = now;
        pintar(t, dt);
        requestAnimationFrame(cuadro);
      }

      function medir() {
        const DPR = Math.min(window.devicePixelRatio || 1, 2);
        W = cv.clientWidth; H = cv.clientHeight;
        FW = window.innerWidth; FH = window.innerHeight;
        const caja = cv.getBoundingClientRect();
        corte = caja.right; corteY = caja.bottom;
        if (!W || !H) return;
        cv.width = W * DPR; cv.height = H * DPR;
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        if (fx) { fz.width = FW * DPR; fz.height = FH * DPR; fx.setTransform(DPR, 0, 0, DPR, 0, 0); }
        armar();
        /* Con movimiento reducido se pinta UN cuadro y ahí se queda. Se usa el
           instante en que la figura YA está completa —no el 0, que la dejaría
           sin dibujar— para que Andrómeda se vea entera. */
        if (quieto) pintar(CICLO * 0.7, 0);
      }

      if (!quieto) {
        window.addEventListener('mousemove', (e) => moverA(e.clientX, e.clientY));
        document.addEventListener('mouseleave', () => { dentro = false; mouse = null; });
      }
      window.addEventListener('resize', medir);
      medir();
      if (!quieto) requestAnimationFrame(cuadro);

      /* La frase entra como entra una estrella, no como un letrero que ya
         estaba: un momento después de cargar. */
      if (sus) {
        if (quieto) sus.classList.add('on');
        else setTimeout(() => sus.classList.add('on'), 700);
      }
    })();

    const form = document.getElementById('login-form');
    const btn = document.getElementById('submit-btn');
    const err = document.getElementById('error-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      btn.disabled = true; btn.textContent = 'Verificando…';
      try {
        const res = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }) });
        const data = await res.json();
        if (!res.ok) {
          err.textContent = data.error || 'No se pudo iniciar sesión';
          err.hidden = false; btn.disabled = false; btn.textContent = 'Entrar';
          return;
        }
        // partner no debe caer en admin
        if (data.role === 'partner') { window.location.href = '/partner/portal'; return; }
        window.location.href = safeNext || data.redirect || '/admin/crm';
      } catch (e) {
        err.textContent = 'Error de conexión. Intenta de nuevo.';
        err.hidden = false; btn.disabled = false; btn.textContent = 'Entrar';
      }
    });
  </script>
</BaseLayout>
