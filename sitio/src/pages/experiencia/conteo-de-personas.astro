---
/**
 * /experiencia/conteo-de-personas — «Cuántas entran y cuántas compran», la Experiencia 04 (3-oct-2026).
 *
 * Recorrido: portada (la entrada con su sensor y la tarjeta de visitantes) → bajó la venta, ¿por qué? (las dos causas)
 * → tu sábado hora por hora (el tablero con el scroll) → horas pico y tu equipo → tus tiendas por conversión → lo que
 * resuelve → preguntas → cierre. Se presenta como disponible (decisión del dueño, 3-oct-2026: ver
 * src/data/experiencia-conteo.ts); los números son de ejemplo.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpHero from '../../components/experiencia/ExpHero.astro';
import ExpLista from '../../components/experiencia/ExpLista.astro';
import ConHeroCapa from '../../components/experiencia/conteo/ConHeroCapa.astro';
import ConCausa from '../../components/experiencia/conteo/ConCausa.astro';
import ConDia from '../../components/experiencia/conteo/ConDia.astro';
import ConSemana from '../../components/experiencia/conteo/ConSemana.astro';
import ConTiendas from '../../components/experiencia/conteo/ConTiendas.astro';
import GiroFAQ from '../../components/giros/GiroFAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import StructuredData from '../../components/StructuredData.astro';
import { CONTEO, CON_RESUELVE, PREGUNTAS_CONTEO } from '../../data/experiencia-conteo';
import { experiencias } from '../../data/experiencias';
import { SITIO } from '../../data/entidad';
import { breadcrumbList } from '../../lib/breadcrumb';
import '../../styles/planeacion.css';

const exp = experiencias.find((e) => e.slug === 'conteo-de-personas')!;
const title = 'Conteo de personas y conversión para tiendas de moda | Sacs';
const description = 'Conteo de personas con IA para tiendas de moda: cuántas personas entran y cuántas compran, hora por hora, tus horas pico y tus tiendas comparadas por conversión, junto a tu venta de Sacs.';

const pagina = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${SITIO}${exp.href}#pagina`, name: exp.titulo, description, url: `${SITIO}${exp.href}`, inLanguage: 'es-MX' };
const migas = breadcrumbList([{ name: 'Inicio', url: `${SITIO}/` }, { name: 'Experiencia', url: `${SITIO}/experiencia` }, { name: exp.titulo }]);
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: PREGUNTAS_CONTEO.map((p) => ({ '@type': 'Question', name: p.question, acceptedAnswer: { '@type': 'Answer', text: p.answer } })) };
---
<BaseLayout
  title={title}
  description={description}
  image="/images/experiencia/conteo-og.jpg"
  preloadImage="/images/experiencia/conteo-vertical-1024.webp"
  preloadMedia="(max-width: 767px)"
  structuredData={[pagina, migas]}
  navSoloArriba
>
  <StructuredData data={faqSchema} />

  <div class="pd exp">
    <ExpHero
      folio={CONTEO.folio}
      etiqueta={CONTEO.etiqueta}
      titulo={CONTEO.titulo}
      bajada={CONTEO.bajada}
      ancha={{ s1280: '/images/experiencia/conteo-portada-1280.webp', s1920: '/images/experiencia/conteo-portada-1536.webp', alto1920: 1280 }}
      vertical={{ src: '/images/experiencia/conteo-vertical-1024.webp', ancho: 1024, alto: 1536 }}
      alt="Una pareja entra desde la calle a una boutique luminosa; sobre la puerta, un sensor discreto"
      ancla="con-causa"
    >
      <ConHeroCapa />
    </ExpHero>
    <ConCausa />
    <ConDia />
    <ConSemana />
    <ConTiendas />
    <ExpLista id="con-resuelve" tema="pd-azul" palabra="LO QUE RESUELVE" folio={CON_RESUELVE.folio} titulo={CON_RESUELVE.titulo} puntos={CON_RESUELVE.puntos} />
  </div>

  <GiroFAQ title="Preguntas frecuentes sobre el conteo de personas" faqs={PREGUNTAS_CONTEO} />
  <FinalCTA />
</BaseLayout>

<script>
  import { iniciaEscenas } from '../../scripts/experiencia/escenas';
  iniciaEscenas();

  // Los renglones de las listas entran al verse (sin JS se ven completos).
  (() => {
    const rv = Array.from(document.querySelectorAll<HTMLElement>('.exp .rv'));
    if (!rv.length || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('js-rv');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    rv.forEach((el) => io.observe(el));
  })();

  const ph = (evento: string, props?: Record<string, unknown>) => { try { (window as any).sacsPH?.(evento, props); } catch { /* sin medición */ } };
  document.querySelectorAll<HTMLElement>('.exp [data-evento]').forEach((a) => a.addEventListener('click', () => ph(a.dataset.evento!, { experiencia: 'conteo-de-personas' })));
  document.querySelector('.final-cta-btn')?.addEventListener('click', () => ph('experiencia_cta_prueba', { experiencia: 'conteo-de-personas' }));
</script>
