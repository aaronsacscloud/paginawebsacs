---
/**
 * /mcp — «Pregúntale.» El MCP de Sacscloud contado con la línea editorial de la portada Fashion OS
 * (marfil, tinta, azul Sacs; Clash Display gigante detrás de la foto; folio de revista; bloque azul
 * con la respuesta). Estructura inspirada en mcp.roivolution.com, con lo que solo Sacs trae:
 * talla × color, días agotado, motor de nivelación, WhatsApp y producto por foto.
 *
 * La dirección MCP de la cuenta se entrega al iniciar sesión en Sacs; aquí solo se publica la de las
 * herramientas gratuitas (/api/mcp), que no piden cuenta.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITIO } from '../data/entidad';

const AGENTES_IA = ['Claude', 'ChatGPT', 'Perplexity', 'Grok'];

const GARANTIAS = [
  { t: 'Los mismos datos de Sacs', p: 'Exactamente lo que ves en el sistema. No es otra fuente ni una copia que se queda atrás.' },
  { t: 'Con todas las garantías', p: 'Entras con tu usuario de Sacs y tu información queda tan protegida como dentro del sistema.' },
  { t: 'La IA más avanzada', p: 'Le preguntas como a un colega que conoce tu marca, y la respuesta llega al instante.' },
  { t: 'Un conector, cualquier IA', p: 'Todas se conectan con tu misma dirección. Si mañana cambias de IA, no rehaces nada.' },
  { t: 'Nada que instalar', p: 'Sin archivos que preparar ni reportes que mover. El servidor ya está arriba.' },
  { t: 'Donde estés', p: 'En la tienda, en la bodega o en una feria: preguntas desde tu celular.' },
];

const MOMENTOS = [
  {
    id: 'temporada', nombre: 'En temporada', foto: 'h16', alt: 'Gerente de tienda revisa el inventario en una tableta mientras su equipo acomoda la mercancía',
    preguntas: [
      { q: '¿Qué tallas y colores se me están agotando esta semana porque se aceleró la venta, y cuánta venta llevo perdida?', t: 'Inventario talla × color · días agotado' },
      { q: '¿Qué traspasos entre sucursales me recomiendas para no reordenar a proveedor? Créalos.', t: 'Nivelación · crea los traspasos' },
      { q: '¿Dónde tengo sobreinventario? Dame las 20 prendas y sucursales más arriba de su cobertura ideal.', t: 'Cobertura' },
      { q: '¿Cómo va cada tienda contra su meta del mes y qué vendedora va arriba en ticket promedio?', t: 'Metas y comisiones' },
    ],
  },
  {
    id: 'compra', nombre: 'Antes de comprar', foto: 'paso-controla-ancha', alt: 'Encargada revisa su celular en una bodega ordenada por color',
    preguntas: [
      { q: 'Con lo que vendí la temporada pasada, ¿qué curva de tallas pido para la próxima colección, corrigiendo los días que cada talla estuvo agotada?', t: 'Curva de tallas' },
      { q: '¿Cómo voy de presupuesto de compra por familia, planeado contra real?', t: 'Compras' },
      { q: '¿Qué proveedor me entregó tarde o incompleto en los últimos seis meses y cuánto me costó?', t: 'Proveedores · recepción' },
      { q: 'Reparte la compra de la nueva colección entre mis sucursales y por talla, y arma la orden.', t: 'Distribución · arma la orden' },
    ],
  },
  {
    id: 'rebajas', nombre: 'Rebajas y saldos', foto: 'h19', alt: 'Mano que revisa la etiqueta de precio de una blusa en el perchero',
    preguntas: [
      { q: '¿Qué estilos ya no se van a vender a precio completo antes de fin de temporada? Dame su sell-through.', t: 'Sell-through' },
      { q: 'Si bajo 20% los estilos con menos de 30% vendido, ¿cuánto margen pierdo y cuánto inventario libero?', t: 'Promociones' },
      { q: 'Sube 8% la marca Nike en las dos tiendas del centro, sin tocar lo que ya está en promoción.', t: 'Precios · aplicado y registrado' },
      { q: '¿Qué tengo en consignación en tiendas de terceros, qué se vendió y qué recojo este mes?', t: 'Consignación' },
    ],
  },
  {
    id: 'clientes', nombre: 'Clientes y WhatsApp', foto: 'h13', alt: 'Clienta sonríe al ver un mensaje en su celular en un café, con su bolsa de compra',
    preguntas: [
      { q: '¿Qué clientas compraron vestidos la temporada pasada y no han vuelto? Escríbeles por WhatsApp con la colección nueva en su talla.', t: 'Clientes · WhatsApp' },
      { q: '¿Qué apartados vencen esta semana y cuánto dinero tengo comprometido en ellos?', t: 'Apartados' },
      { q: '¿Qué preguntaron más por WhatsApp esta semana que no teníamos en existencia?', t: 'Demanda no atendida' },
      { q: '¿A qué clientas se les vencen puntos este mes y a quién conviene avisarle hoy?', t: 'Lealtad' },
    ],
  },
  {
    id: 'catalogo', nombre: 'Catálogo y contenido', foto: 'h07', alt: 'Encargada acomoda prendas nuevas en una tienda luminosa por la mañana',
    preguntas: [
      { q: 'Llegó la colección de otoño. Da de alta estas 12 prendas desde las fotos, con sus tallas y colores.', t: 'Producto por foto' },
      { q: 'Genera la foto con modelo de las prendas nuevas y déjalas listas para la tienda en línea.', t: 'Fotografía con IA' },
      { q: '¿Qué prendas tienen fotos o descripción incompleta en la tienda en línea?', t: 'Catálogo' },
      { q: '¿Qué se vende más en TikTok Shop que en tienda física, y en qué tallas?', t: 'Canales' },
    ],
  },
];

const SOLO_SACS = [
  { t: 'Talla × color desde el origen', p: 'Cada prenda vive como variante con su existencia por sucursal. La IA no ve «Vestido Lino: 40 piezas»; ve qué talla y qué color faltan, y dónde.', tira: 'matriz' },
  { t: 'Los días agotado, registrados solos', p: 'Sacs sabe desde qué momento cada talla estuvo en cero. La curva de compra no confunde «no se vendió» con «no estuvo».', tira: 'M · Polanco · 5 días agotada · 9 piezas perdidas' },
  { t: 'Un motor que ya recomienda', p: 'Nivelación, mínimos y máximos y reposición viven dentro de Sacs. La IA lee lo que el motor calcula; no inventa sus cuentas.', tira: '40 piezas · 4 traspasos · 0 a proveedor' },
  { t: 'De la respuesta a la acción', p: 'Traspasos, apartados, precios y órdenes de compra, con los mismos permisos de la pantalla y cada movimiento en el Kardex.', tira: 'Traspaso T-2291 · creado desde Claude' },
  { t: 'WhatsApp, también es dato', p: 'Lo que te piden por el Inbox de Sacs se cruza con tu inventario: qué no tenías y a quién darle seguimiento.', tira: '«¿Lo tienen en M?» · 23 veces esta semana' },
  { t: 'Del producto que llega a la venta', p: 'Le tomas foto a la prenda y Sacs la da de alta con tallas y colores, genera la foto con modelo y la publica en tus canales.', tira: 'Foto · alta · modelo · tienda en línea' },
];

const IMAGINA = [
  { t: 'Gráficas que puedes mover', p: 'Venta por talla en barras, líneas o dispersión. Las ajustas y te las llevas.' },
  { t: 'Tableros en la conversación', p: 'Un panel vivo con filtros, o una página pequeña que tu equipo puede abrir.' },
  { t: 'Reportes listos para mandar', p: 'Excel, PowerPoint, Word o PDF desde la respuesta. El reporte del lunes deja de ser una mañana.' },
  { t: 'Tareas que corren solas', p: '«Cada lunes a las 8, dime qué tallas se van a agotar.» Lo pides una vez y te avisa.' },
  { t: 'Rutinas guardadas', p: 'El cruce que repites cada semana se guarda como proyecto o skill, y todo tu equipo lo reusa.' },
  { t: 'Con tus otras herramientas', p: 'Tu IA mezcla Sacs con tu correo, tu calendario y tus documentos, y deja el resultado donde va.' },
];

const SEGURIDAD = [
  { t: 'Tus permisos, sin excepción', p: 'Cada persona entra con su usuario. Lo que su grupo de permisos no ve en Sacs, tampoco lo ve desde la IA.' },
  { t: 'Por sucursal', p: 'Un gerente pregunta por su tienda y recibe solo su tienda, igual que en el punto de venta.' },
  { t: 'Lo sensible no sale', p: 'Llaves del SAT, tokens y datos protegidos quedan fuera del alcance de la IA. Los costos, solo para quien puede verlos.' },
  { t: 'Todo queda registrado', p: 'Cada cambio lleva nombre y hora, y el inventario solo se mueve por el Kardex. Tus datos no se comparten ni se reutilizan.' },
];

const PLATAFORMAS = [
  { id: 'claude', nombre: 'Claude', nota: 'Todos los planes',
    reqs: ['Disponible en todos los planes de Claude.', 'Necesitas una cuenta de Sacs con acceso a la empresa que quieres consultar.'],
    pasos: ['Inicia sesión en Sacs y copia tu dirección MCP.', 'En Claude, entra a Ajustes › Conectores.', 'Elige «Agregar conector personalizado».', 'Nómbralo Sacscloud, pega tu dirección y haz clic en Conectar.'] },
  { id: 'chatgpt', nombre: 'ChatGPT', nota: 'Plan de pago',
    reqs: ['Requiere un plan de pago. En Business y Enterprise, el administrador debe permitir el modo desarrollador.', 'Se configura en la computadora; después lo usas también en el celular.'],
    pasos: ['Inicia sesión en Sacs y copia tu dirección MCP.', 'En ChatGPT, activa el modo desarrollador en Ajustes.', 'Ve a Conectores y crea uno nuevo.', 'Nombre: Sacscloud · Dirección: tu dirección MCP · Autenticación: OAuth.', 'Acepta el aviso y crea la conexión.'] },
  { id: 'perplexity', nombre: 'Perplexity', nota: 'Pro o más',
    reqs: ['Requiere Pro, Max o Enterprise.', 'Se configura en la computadora; después lo usas en el celular.'],
    pasos: ['Inicia sesión en Sacs y copia tu dirección MCP.', 'Ve a Ajustes › Conectores › Conector personalizado (remoto).', 'Nombre: Sacscloud · Dirección: tu dirección MCP.', 'En Avanzado: Autenticación OAuth · Transporte Streamable HTTP.'] },
  { id: 'grok', nombre: 'Grok', nota: 'Plan de pago',
    reqs: ['Requiere una cuenta de pago de Grok.'],
    pasos: ['Inicia sesión en Sacs y copia tu dirección MCP.', 'Abre Ajustes › Conectores en Grok.', 'Nuevo conector › Personalizado.', 'Nombre: Sacscloud · pega tu dirección y confirma.'] },
  { id: 'gemini', nombre: 'Gemini', nota: 'Pronto',
    reqs: ['La app de Gemini todavía no permite agregar conectores MCP propios.', 'En cuanto lo permita, tu misma dirección de Sacs es todo lo que necesitas.'],
    pasos: [] },
];

const GRATIS = [
  { n: 'Auditor de curva de tallas', p: 'Qué proporción de cada talla comprar, corrigiendo por días agotado.' },
  { n: 'Qué mover entre tus tiendas', p: 'Qué piezas mover y a dónde para reparar corridas rotas.' },
  { n: '¿Sacas este estilo a tiempo?', p: 'Si el estilo sale antes de fin de temporada y cuántas piezas sobran.' },
  { n: 'Margen y markup para moda', p: 'Hasta qué descuento rematas sin vender bajo costo.' },
  { n: 'Punto de reorden por talla', p: 'Cuándo volver a pedir cada talla, y cuánto.' },
  { n: 'Costo de maquila por prenda', p: 'Costo real por prenda y precio mínimo de venta.' },
];

const FAQ = [
  { q: '¿Con qué IA funciona?', a: 'Con Claude, ChatGPT, Perplexity, Grok y cualquier cliente compatible con MCP. Todas usan tu misma dirección de Sacs. La app de Gemini todavía no permite conectores propios; en cuanto lo haga, funcionará igual.' },
  { q: '¿Qué información ve la IA?', a: 'La misma que ves en Sacs, y solo la parte que tu usuario tiene permitida. Lo que no puedes ver dentro del sistema tampoco lo ves desde la IA.' },
  { q: '¿Solo consulta o también opera?', a: 'Opera. Crea traspasos, ajusta precios, aparta prendas y da de alta productos, siempre con tus permisos y con el registro de cada cambio.' },
  { q: '¿Qué necesito para empezar?', a: 'Iniciar sesión en Sacs, copiar tu dirección MCP y pegarla en los ajustes de tu IA. No hay nada que instalar.' },
  { q: '¿Cada cuánto se actualiza?', a: 'Al mismo ritmo que Sacs: cada venta, recepción o traspaso se ve en cuanto ocurre. No hay una copia aparte que se quede atrás.' },
  { q: '¿De dónde salen las cifras?', a: 'De Sacs. Son las mismas del sistema y salen del mismo motor; la IA las lee, no las recalcula. Si una cifra te sorprende, pídele que te explique de dónde sale.' },
  { q: '¿En qué plan viene?', a: 'El MCP de tu cuenta viene incluido en el plan Automatiza. Las seis herramientas de cálculo para moda son gratuitas y no piden cuenta.' },
];

const foto = (n: string) => n.startsWith('h')
  ? { src: `/images/fashion-os/${n}.webp`, srcset: `/images/fashion-os/${n}-480.webp 480w, /images/fashion-os/${n}-960.webp 960w, /images/fashion-os/${n}.webp 1536w` }
  : { src: `/images/fashion-os/${n}.webp`, srcset: `/images/fashion-os/${n}-960.webp 960w, /images/fashion-os/${n}.webp 1536w` };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'MCP de Sacscloud',
  description: 'Conecta tu negocio de moda a Claude, ChatGPT o cualquier IA con el MCP de Sacscloud.',
  url: `${SITIO}/mcp`,
  inLanguage: 'es-MX',
  publisher: { '@type': 'Organization', name: 'Sacs', url: SITIO },
};
---
<BaseLayout
  title="MCP de Sacscloud · Tu marca de moda, en la IA que ya usas"
  description="Pregúntale a Claude, ChatGPT o cualquier IA por tus ventas, tu inventario por talla y color, tus sucursales y tus clientas. El MCP de Sacscloud conecta tu operación de moda a tu IA."
  structuredData={schema}
  preloadImage="/images/fashion-os/orden-ella.webp"
>
<main class="mx">

  <!-- 01 · La pregunta -->
  <section class="mx-hero" aria-labelledby="mx-h1">
    <p class="mx-folio" aria-hidden="true">
      <span>Fashion OS</span><span class="mx-folio-c">N.º 02 — El conector</span><span>21:30 · Ciudad de México</span>
    </p>
    <div class="mx-escena">
      <p class="mx-gigante" aria-hidden="true">Pregúntale</p>
      <img class="mx-ella" src="/images/fashion-os/orden-ella.webp"
        srcset="/images/fashion-os/orden-ella-640.webp 640w, /images/fashion-os/orden-ella.webp 1024w"
        sizes="(min-width: 1024px) 56vh, 70vw" width="1024" height="1536"
        alt="La dueña de una marca de moda, de traje azul, le pregunta a su IA por su negocio desde el celular"
        loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="mx-voz">
      <p class="mx-kicker"><i aria-hidden="true"></i>Pregunta a Claude · conectado a Sacscloud</p>
      <h1 class="mx-frase" id="mx-h1">«¿Qué tengo que <em>reponer hoy</em> <span>en mis tiendas, y me alcanza con la bodega?»</span></h1>
      <p class="mx-lead">El MCP de Sacscloud conecta tu marca a la IA que ya usas. Le preguntas en español por tus ventas, tu inventario por talla y color, tus sucursales y tus clientas, y te contesta con tus datos reales.</p>
      <div class="mx-ctas">
        <a class="mx-btn" href="#conectar">Conectar ahora</a>
        <a class="mx-link" href="#casos">Ver qué puedes preguntar</a>
      </div>
      <p class="mx-ias"><span>Funciona con</span>{AGENTES_IA.map((a) => <b>{a}</b>)}</p>
    </div>
  </section>

  <!-- 02 · La respuesta (bloque azul) -->
  <section class="mx-azul" aria-labelledby="mx-resp">
    <div class="mx-in">
      <p class="mx-de"><b>Claude</b> respondió · 21:31 · con datos de Sacs</p>
      <h2 class="mx-resp-h" id="mx-resp">40 piezas.</h2>
      <p class="mx-resp-p">Cuatro prendas bajan de una semana y media de cobertura. La bodega alcanza para todas. El vestido Lino Arena en M lleva cinco días agotado en Polanco: ahí estás perdiendo venta hoy.</p>
      <div class="mx-tabla-w">
        <table class="mx-tabla">
          <thead><tr><th>Prenda · talla</th><th>Sucursal</th><th class="n">Cobertura</th><th class="n">Reponer</th></tr></thead>
          <tbody>
            <tr><td>Vestido Lino Arena · M</td><td>Polanco</td><td class="n">0.6 sem</td><td class="n">14</td></tr>
            <tr><td>Jeans Recto Índigo · 28</td><td>Andares</td><td class="n">0.9 sem</td><td class="n">11</td></tr>
            <tr><td>Blusa Seda Marfil · CH</td><td>Valle</td><td class="n">1.1 sem</td><td class="n">9</td></tr>
            <tr><td>Saco Tweed Negro · G</td><td>Antea</td><td class="n">1.4 sem</td><td class="n">6</td></tr>
          </tbody>
        </table>
      </div>
      <ul class="mx-acciones" aria-label="Lo que puedes pedir después">
        <li class="si"><i aria-hidden="true"></i>Crear los traspasos</li>
        <li><i aria-hidden="true"></i>Verlo por color</li>
        <li><i aria-hidden="true"></i>Mandarlo al gerente por WhatsApp</li>
      </ul>
      <p class="mx-nota">Conversación de ejemplo con una marca ficticia. Las respuestas salen de los datos de tu propia cuenta de Sacs.</p>
    </div>
  </section>

  <!-- 03 · Qué es -->
  <section class="mx-sec mx-que">
    <div class="mx-in mx-que-g">
      <div>
        <p class="mx-eyebrow">Un conector para cualquier IA</p>
        <h2 class="mx-h2">Sacs habla el idioma de las IA.</h2>
        <p class="mx-p">MCP (Model Context Protocol) es el estándar con el que Claude, ChatGPT, Grok y otras IA se conectan a los sistemas de una empresa. El MCP de Sacscloud le da a tu IA acceso seguro y ordenado a tu operación de moda: entiende tus prendas, tallas, colores, sucursales y clientas, y te contesta en lenguaje natural.</p>
        <ol class="mx-flujo" aria-label="Cómo funciona">
          <li><b>Tú</b><span>preguntas desde tu IA, en la compu o en el celular.</span></li>
          <li><b>Tu llave</b><span>entras con tu usuario y tus permisos de Sacs.</span></li>
          <li><b>Sacs</b><span>contesta con tus datos y lo que su motor recomienda.</span></li>
        </ol>
      </div>
      <ul class="mx-garantias">
        {GARANTIAS.map((g) => <li><h3>{g.t}</h3><p>{g.p}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- 04 · Habla con tu negocio -->
  <section class="mx-sec mx-casos" id="casos" aria-labelledby="mx-casos-h">
    <div class="mx-in">
      <p class="mx-folio mx-folio-sec" aria-hidden="true"><span>Habla con tu negocio</span><span>Una temporada, cinco momentos</span></p>
      <h2 class="mx-h2 mx-casos-h" id="mx-casos-h">Toda tu marca, en una conversación.</h2>
      <div class="mx-tabs" role="tablist" aria-label="Momento de la temporada">
        {MOMENTOS.map((m, k) => (
          <button type="button" class="mx-tab" role="tab" id={`mx-tab-${m.id}`} aria-controls={`mx-pan-${m.id}`} aria-selected={k === 0 ? 'true' : 'false'} data-tab={m.id}>{m.nombre}</button>
        ))}
      </div>
      {MOMENTOS.map((m, k) => {
        const f = foto(m.foto);
        return (
          <div class="mx-panel" role="tabpanel" id={`mx-pan-${m.id}`} aria-labelledby={`mx-tab-${m.id}`} hidden={k !== 0}>
            <figure class="mx-panel-foto">
              <img src={f.src} srcset={f.srcset} sizes="(min-width: 1024px) 38vw, 92vw" width="1536" height="1024" alt={m.alt} loading="lazy" decoding="async" />
            </figure>
            <ol class="mx-preguntas">
              {m.preguntas.map((p) => <li><q>{p.q}</q><span>{p.t}</span></li>)}
            </ol>
          </div>
        );
      })}
      <p class="mx-cierre">La conversación no termina en la primera respuesta. Pide el desglose por talla, cambia el periodo, compara otra sucursal o pregunta por qué Sacs recomienda lo que recomienda.</p>
    </div>
  </section>

  <!-- 05 · Lo que solo Sacs -->
  <section class="mx-sec mx-tinta" aria-labelledby="mx-solo-h">
    <div class="mx-in">
      <p class="mx-eyebrow">Lo que solo Sacs pone en la conversación</p>
      <h2 class="mx-h2 mx-solo-h" id="mx-solo-h">Una IA genérica sabe de datos. <span>Sacs sabe de moda.</span></h2>
      <ul class="mx-solo">
        {SOLO_SACS.map((s) => (
          <li>
            <h3>{s.t}</h3>
            <p>{s.p}</p>
            {s.tira === 'matriz' ? (
              <div class="mx-matriz" aria-label="Ejemplo: existencia por talla en dos sucursales">
                <span></span><span>XCH</span><span>CH</span><span>M</span><span>G</span><span>XG</span>
                <span>Polanco</span><b>2</b><b>6</b><b class="cero">0</b><b>5</b><b>1</b>
                <span>Andares</span><b>4</b><b>8</b><b>9</b><b>2</b><b class="cero">0</b>
              </div>
            ) : <p class="mx-tira">{s.tira}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 · Hasta donde llegue tu imaginación -->
  <section class="mx-imagina" aria-labelledby="mx-imag-h">
    <figure class="mx-imagina-foto">
      <img src="/images/fashion-os/paso-automatiza-ancha.webp" srcset="/images/fashion-os/paso-automatiza-ancha-960.webp 960w, /images/fashion-os/paso-automatiza-ancha.webp 1536w" sizes="100vw" width="1536" height="1024" alt="La dueña de la marca camina por la calle revisando en su celular lo que su IA preparó" loading="lazy" decoding="async" />
      <figcaption>
        <p class="mx-eyebrow">Hasta donde llegue tu imaginación</p>
        <h2 class="mx-h2" id="mx-imag-h">Más que una respuesta escrita.</h2>
      </figcaption>
    </figure>
    <div class="mx-in">
      <ul class="mx-imag">
        {IMAGINA.map((i) => <li><h3>{i.t}</h3><p>{i.p}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- 07 · Excel -->
  <section class="mx-sec mx-excel">
    <div class="mx-in mx-excel-g">
      <div>
        <p class="mx-eyebrow">Claude para Excel</p>
        <h2 class="mx-h2">Y dentro de tu propia hoja.</h2>
        <p class="mx-p">El complemento de Claude para Excel ve el mismo conector. Tu plantilla se llena con cifras vivas de Sacs, con tus fórmulas intactas y sin exportar nada.</p>
        <ul class="mx-citas">
          <li><q>Trae a esta hoja las tallas que se van a agotar esta semana, con su cobertura y las piezas sugeridas.</q></li>
          <li><q>Llena la columna de venta real con las últimas 13 semanas por sucursal, sin tocar las fórmulas.</q></li>
          <li><q>Compara el plan de compra de esta hoja contra lo recibido en Sacs y marca las diferencias.</q></li>
        </ul>
        <p class="mx-req">Requiere el complemento de Claude de Microsoft AppSource y un plan Pro, Max, Team o Enterprise. Funciona en Excel web, Windows y Mac.</p>
      </div>
