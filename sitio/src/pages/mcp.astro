<script>
  (() => {
    // pestañas: momentos de la temporada y plataformas (los paneles ya vienen en el HTML; solo se alternan)
    const enlaza = (sel: string, attr: string, panel: (id: string) => string) => {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(sel));
      tabs.forEach((t) => t.addEventListener('click', () => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', on ? 'true' : 'false');
          const p = document.getElementById(panel(x.dataset[attr] || ''));
          if (p) p.hidden = !on;
        });
      }));
    };
    enlaza('.mx-tab', 'tab', (id) => `mx-pan-${id}`);
    enlaza('.mx-plat', 'plat', (id) => `mx-pp-${id}`);

    const btn = document.getElementById('mx-copiar');
    const code = document.getElementById('mx-url');
    btn?.addEventListener('click', () => {
      const ok = () => { btn.textContent = 'Copiada'; setTimeout(() => { btn.textContent = 'Copiar'; }, 1600); };
      const sel = () => { const r = document.createRange(); r.selectNodeContents(code!); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); };
      if (navigator.clipboard) navigator.clipboard.writeText(code?.textContent || '').then(ok, sel); else sel();
    });
  })();
</script>
