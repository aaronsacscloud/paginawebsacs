  .pt-mani-lineas { max-width: 860px; margin: 0 auto; display: grid; gap: 22px; }
  .pt-mani-lineas p { font-family: var(--font-display); font-weight: 500; font-size: clamp(20px, 2.2vw, 30px); letter-spacing: -0.02em; line-height: 1.25; margin: 0; opacity: 0; transform: translateY(12px); transition: opacity 0.7s, transform 0.7s; }
  .pt-manifiesto.is-in .pt-mani-lineas p { opacity: 1; transform: none; }
  .pt-mani-lineas p:nth-child(2) { transition-delay: 0.15s; } .pt-mani-lineas p:nth-child(3) { transition-delay: 0.3s; } .pt-mani-lineas p:nth-child(4) { transition-delay: 0.45s; } .pt-mani-lineas p:nth-child(5) { transition-delay: 0.6s; }
  .pt-firma { display: block; margin-top: 34px; font-family: var(--font-display); font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: #6E6E6D; }

  /* ── Cómo empezar: línea de tiempo + dos opciones ── */
  .pt-inicio { padding: clamp(72px, 9vw, 120px) 0; background: #F7F7F5; color: #0E0D0C; }
  .pt-linea { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; position: relative; }
  .pt-linea::before { content: ''; position: absolute; left: 6%; right: 6%; top: 17px; height: 1px; background: #D8D8D3; }
  .pt-linea li { position: relative; padding-top: 0; }
  .pt-paso-n { position: relative; z-index: 1; display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #0E0D0C; color: #fff; font-weight: 700; margin-bottom: 16px; }
  .pt-linea h3 { font-family: var(--font-display); font-size: 18px; margin: 0 0 6px; color: inherit; }
