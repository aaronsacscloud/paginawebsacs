  .pt-opcion:hover { transform: translateY(-3px); box-shadow: 0 24px 60px -30px rgba(0,0,0,0.3); border-color: #0E0D0C; }
  .pt-opcion-k { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #6B6B68; }
