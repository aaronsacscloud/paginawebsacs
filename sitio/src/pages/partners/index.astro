<script>
  (() => {
    // Manifiesto: entra al verse
    const m = document.querySelector('.pt-manifiesto');
    if (m) { const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { m.classList.add('is-in'); io.disconnect(); } }, { threshold: 0.25 }); io.observe(m); }
    // Modal de agenda (evento "alianzas"); los botones con data-tipo pasan el tipo de alianza a la cita
    const modal = document.getElementById('pt-modal'); const iframe = document.getElementById('pt-modal-iframe') as HTMLIFrameElement | null;
    const abre = (tipo?: string) => { if (!modal || !iframe) return; const u = new URL('/agendar/alianzas', location.origin); if (tipo) u.searchParams.set('tipo', tipo); if (iframe.src !== u.href) iframe.src = u.href; modal.hidden = false; document.body.style.overflow = 'hidden'; (window as any).sacsPH?.('partners_agenda_abrir', { tipo }); };
    const cierra = () => { if (!modal) return; modal.hidden = true; document.body.style.overflow = ''; };
    document.getElementById('pt-abrir-agenda')?.addEventListener('click', () => abre());
    document.addEventListener('pt:agenda', (e) => abre((e as CustomEvent).detail?.tipo));
    document.querySelectorAll<HTMLAnchorElement>('a[href="#agenda"][data-tipo]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); abre(a.dataset.tipo); }));
    modal?.querySelectorAll('[data-cerrar]').forEach((el) => el.addEventListener('click', cierra));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal && !modal.hidden) cierra(); });
    document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me"]').forEach((a) => a.addEventListener('click', () => (window as any).sacsPH?.('partners_whatsapp')));
  })();
</script>
