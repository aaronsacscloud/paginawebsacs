---
/**
 * /partners — el programa de alianzas de Sacs, enfocado 100 % en fashion retail (15-sep-2026).
 * Cuatro tipos de partner: Orquestador (va primero: la jerarquía la da el orden, no una etiqueta), Consultores y
 * especialistas, Referidos (40 % de por vida) y Proveedores de tecnología (API y MCP).
 * Cierra con manifiesto, "es global", cómo empezar, y dos vías: WhatsApp o cita "Alianzas
 * comerciales" (evento del agendador, slug `alianzas`) en un modal.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartnersIntro from '../../components/partners/PartnersIntro.astro';
import Globo from '../../components/partners/Globo.astro';
import PartnersCalc from '../../components/partners/PartnersCalc.astro';
import PartnersCert from '../../components/partners/PartnersCert.astro';
import PartnersDias from '../../components/partners/PartnersDias.astro';
import PartnersPortal from '../../components/partners/PartnersPortal.astro';
import PartnersNiveles from '../../components/partners/PartnersNiveles.astro';
import { waLink } from '../../lib/whatsapp';

const wa = (tipo: string) => waLink(`Hola, quiero ser partner de Sacs como ${tipo}. ¿Me cuentan cómo empezamos?`);
const waGeneral = waLink('Hola, quiero ser partner de Sacs. ¿Me cuentan cómo empezamos?');

const tipos = [
  {
    id: 'orquestador', destacado: true, eyebrow: 'Tipo de alianza', perfil: 'Partner orquestador', titulo: 'Un negocio propio sobre Sacs, para emprendedores',
    desc: 'No necesitas venir de la tecnología. Si eres emprendedor, agencia o consultor senior y quieres un negocio propio, nosotros te certificamos: te enseñamos a vender, implementar y operar Sacs con IA, te acompañamos en tus primeras tiendas y creces con ingresos recurrentes por cada fashion retailer que opera contigo.',
    gana: 'Ingreso recurrente por cada retailer que operas, de por vida',
    cert: 'La da Sacs: capacitación en producto e IA, examen y tus primeras implementaciones acompañadas.',
    para: 'Emprendedores, agencias, integradores y consultores senior que quieren un negocio propio sobre Sacs.',
    puntos: ['Certificación oficial de Sacs en implementación e IA', 'Herramientas para implementar una tienda en días, no meses', 'Gestión completa de tus clientes: onboarding, operación y crecimiento', 'Territorio abierto: tu ciudad, tu país o varios', 'Soporte y producto de Sacs detrás de ti'],
    img: '/images/partners/orquestador.webp', cta: 'Quiero certificarme', waTipo: 'partner orquestador',
  },
  {
    id: 'consultores', eyebrow: 'Tipo de alianza', perfil: 'Consultores y especialistas', titulo: 'Integra Sacs en tu oferta',
    desc: 'Firmas de consultoría de retail, diseñadores de experiencia en tienda y expertos en operación: sumas Sacs a tus servicios y entregas un proceso integral, tu estrategia más el sistema que la ejecuta. Ganas por la licencia y expandes tu servicio con implementación, capacitación y seguimiento.',
    gana: 'Comisión por licencia más tus propios servicios',
    para: 'Consultoras de retail, diseñadores de experiencia, visual merchandisers, expertos en inventario y compras.',
    puntos: ['Más resultados: tu método con datos reales del sistema', 'Nuevas líneas de ingreso: implementación y acompañamiento', 'Material, capacitación y acceso a producto'],
    img: '/images/partners/consultores.webp', cta: 'Quiero integrar Sacs', waTipo: 'consultor o especialista',
  },
  {
    id: 'referidos', eyebrow: 'Tipo de alianza', perfil: 'Referidos', titulo: 'Tú refieres, nosotros vendemos. El 40 % de esa cuenta, de por vida.',
    desc: 'Nos presentas a una marca o tienda de moda. Nosotros hacemos la presentación de venta, la visitamos en físico o hacemos la reunión digital, y cerramos. Cuando la venta se genera, tú ganas el 40 % de ese negocio mientras sea cliente.',
    gana: '40 % de por vida de cada negocio referido',
    para: 'Influencers y creadores de contenido de moda, contadores, agencias, proveedores de la industria y cualquiera con red en el sector.',
    puntos: ['Sin vender ni implementar: solo presentas', 'Seguimiento transparente de cada referido', 'Pago mensual mientras el cliente opere con Sacs'],
    img: '/images/partners/referidos.webp', cta: 'Quiero referir', waTipo: 'referidor',
  },
  {
    id: 'tecnologia', eyebrow: 'Tipo de alianza', perfil: 'Proveedores de tecnología', titulo: 'Conecta tu tecnología con Sacs por API y MCP',
    desc: 'Pasarelas, logística, e-commerce, IA, hardware de tienda, analítica: si tu tecnología ayuda al fashion retail, es bienvenida. Integras con nuestra API y nuestro MCP y llegas a todas las marcas que operan con Sacs.',
    gana: 'Distribución en la base de clientes de Sacs',
    para: 'Empresas de software, pagos, logística, hardware y modelos de IA.',
    puntos: ['API documentada y MCP para agentes de IA', 'Listado en el catálogo de integraciones', 'Equipo técnico de Sacs para la integración'],
    img: '/images/partners/tecnologia.webp', cta: 'Quiero integrar mi tecnología', waTipo: 'proveedor de tecnología',
  },
];

// Cinco alianzas más, para todo el ecosistema de la moda (Aaron, 15-sep-2026)
const mas = [
  { id: 'mayoristas', perfil: 'Mayoristas y fabricantes', frase: 'Tus clientes venden más con Sacs, y tu catálogo entra directo a su sistema.', gana: 'Comisión por cada boutique cliente que activa Sacs, más pedidos que llegan sin captura', para: 'Fabricantes y mayoristas de Villa Hidalgo, SAPICA, Intermoda, Zapotlanejo, Moroleón y del resto del país', img: '/images/partners/mayoristas.webp', waTipo: 'mayorista o fabricante', grande: true },
  { id: 'escuelas', perfil: 'Escuelas de moda y diseño', frase: 'Certifica a tus alumnos en Sacs: salen listos para operar una marca o para implementarla.', gana: 'Programa académico sin costo, certificación oficial para tus alumnos y licencias para las marcas que nacen en tu escuela', para: 'Universidades, escuelas de diseño de moda, incubadoras y programas de emprendimiento', img: '/images/partners/escuelas.webp', waTipo: 'escuela de moda o diseño', grande: true },
  { id: 'camaras', perfil: 'Cámaras, ferias y asociaciones', frase: 'Precio de afiliado para tus miembros y certificación de partners en tu evento.', gana: 'Beneficio real para tus agremiados y un ingreso por cada afiliado que activa Sacs', para: 'Cámaras del vestido y del calzado, ferias, clústeres y asociaciones de comerciantes', img: '/images/partners/camaras.webp', waTipo: 'cámara, feria o asociación' },
  { id: 'hardware', perfil: 'Distribuidores de hardware', frase: 'Ya estás en la tienda el día que abre. Súmale el sistema y cobra la licencia.', gana: 'Comisión por licencia en cada terminal, impresora o cajón que instalas con Sacs', para: 'Distribuidores e instaladores de terminales, impresoras, cajones, lectores y pantallas', img: '/images/partners/hardware.webp', waTipo: 'distribuidor de hardware' },
  { id: 'financiamiento', perfil: 'Financiamiento', frase: 'Crédito a boutiques con las ventas reales de Sacs como respaldo.', gana: 'Acceso a marcas con historial de ventas verificable y originación directa desde el sistema', para: 'Fintech, bancos, sofomes y fondos que prestan a comercios', img: '/images/partners/financiamiento.webp', waTipo: 'financiamiento' },
];

const pasos = [
  { t: 'Cuéntanos quién eres', d: 'Por WhatsApp o en una cita de 45 minutos: tu perfil, tu red y el tipo de alianza que te interesa.' },
  { t: 'Definimos el modelo', d: 'Uno de los nueve tipos de alianza, o una combinación. Firmamos el acuerdo y activamos tus accesos.' },
  { t: 'Certificación y arranque', d: 'Capacitación en producto e IA, material comercial y tu primer retailer acompañado por Sacs.' },
  { t: 'Creces con recurrencia', d: 'Cada tienda que opera contigo paga cada mes. Tú creces con ella, en tu ciudad o en varios países.' },
];
---

<BaseLayout title="Partners — Sacs Fashion Commerce" description="Programa de alianzas de Sacs para fashion retail: orquestadores certificados, consultores y especialistas, referidos con 40 % de por vida y proveedores de tecnología con API y MCP.">
  <PartnersIntro />

  <!-- ═══ Orquestador: el partner principal ═══ -->
  <section class="pt-orq" id="orquestador">
    <div class="pt-inner pt-orq-grid">
      <div class="pt-orq-txt">
        <span class="pt-eyebrow">01 · {tipos[0].eyebrow}</span>
        <h2 class="pt-h2">{tipos[0].perfil}</h2>
        <p class="pt-frase">{tipos[0].titulo}</p>
        <p class="pt-p">{tipos[0].desc}</p>
        <ul class="pt-lista">{tipos[0].puntos.map((x) => <li>{x}</li>)}</ul>
        <dl class="pt-datos">
          <div><dt>Cómo ganas</dt><dd>{tipos[0].gana}</dd></div>
          <div><dt>Quién te certifica</dt><dd>{tipos[0].cert}</dd></div>
        </dl>
        <div class="pt-ctas">
          <a href="#agenda" class="pt-btn pt-btn--blanco" data-tipo="Partner orquestador">{tipos[0].cta}</a>
          <a href={wa(tipos[0].waTipo)} class="pt-link pt-link--claro" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp →</a>
        </div>
      </div>
      <div class="pt-orq-vis" aria-hidden="true">
        <img class="pt-orq-foto" src={tipos[0].img} alt="" width="1536" height="1024" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ═══ La certificación como objeto ═══ -->
  <PartnersCert />

  <!-- ═══ Calculadora de ingresos ═══ -->
  <PartnersCalc />

  <!-- ═══ Las otras tres alianzas, como los pilares del home ═══ -->
  <section class="pt-tipos" id="alianzas">
    <div class="pt-inner">
      <div class="pt-tipos-head">
        <span class="pt-eyebrow">Toda alianza tiene lugar</span>
        <h2 class="pt-h2">Tres perfiles que crecen con Sacs</h2>
        <p class="pt-p">Encuentra tu perfil. Todas trabajan sobre el mismo sistema y el mismo segmento: el retail de moda.</p>
      </div>
      {tipos.slice(1).map((t, i) => (
        <article class:list={['pt-fila', { 'pt-fila--inv': i % 2 === 1 }]} id={`tipo-${t.id}`}>
          <div class="pt-fila-media"><img src={t.img} alt="" loading="lazy" width="1200" height="800" /></div>
          <div class="pt-fila-txt">
            <span class="pt-eyebrow">0{i + 2} · {t.eyebrow}</span>
            <h3>{t.perfil}</h3>
            <p class="pt-frase">{t.titulo}</p>
            <p class="pt-p">{t.desc}</p>
            <ul class="pt-lista">{t.puntos.map((x) => <li>{x}</li>)}</ul>
            <dl class="pt-datos">
              <div><dt>Cómo ganas</dt><dd>{t.gana}</dd></div>
              <div><dt>Para quién</dt><dd>{t.para}</dd></div>
            </dl>
            <div class="pt-ctas">
              <a href="#agenda" class="pt-btn" data-tipo={t.titulo}>{t.cta}</a>
              <a href={wa(t.waTipo)} class="pt-link" target="_blank" rel="noopener noreferrer">WhatsApp →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══ Más alianzas: cinco perfiles del ecosistema, en mosaico ═══ -->
  <section class="pt-mas" id="ecosistema">
    <div class="pt-inner">
      <div class="pt-tipos-head">
        <span class="pt-eyebrow">Todo el ecosistema de la moda</span>
        <h2 class="pt-h2">Cinco alianzas más, para quien ya está cerca de la tienda</h2>
        <p class="pt-p">Mayoristas, escuelas, cámaras, hardware y financiamiento: cada uno ya toca a la boutique. Con Sacs, ese contacto se vuelve un ingreso.</p>
      </div>
      <div class="pt-mosaico">
        {mas.map((m, i) => (
          <article class:list={['pt-mos', { 'pt-mos--g': m.grande }]} id={`tipo-${m.id}`}>
            <img src={m.img} alt="" loading="lazy" width="1400" height="933" />
            <div class="pt-mos-velo"></div>
            <div class="pt-mos-txt">
              <span class="pt-mos-n">0{i + 5}</span>
              <h3>{m.perfil}</h3>
              <p class="pt-mos-frase">{m.frase}</p>
              <div class="pt-mos-mas"><div>
                <dl class="pt-datos pt-datos--claro">
                  <div><dt>Cómo ganas</dt><dd>{m.gana}</dd></div>
                  <div><dt>Para quién</dt><dd>{m.para}</dd></div>
                </dl>
                <div class="pt-ctas">
                  <a href="#agenda" class="pt-btn pt-btn--blanco" data-tipo={m.perfil}>Agendar una cita</a>
                  <a href={wa(m.waTipo)} class="pt-link pt-link--claro" target="_blank" rel="noopener noreferrer">WhatsApp →</a>
                </div>
              </div></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Tu primera tienda en cinco días ═══ -->
  <PartnersDias />

  <!-- ═══ El portal real del partner ═══ -->
  <PartnersPortal />

  <!-- ═══ Es global: el globo ═══ -->
  <Globo />

  <!-- ═══ Niveles y Partner Day ═══ -->
  <PartnersNiveles />

  <!-- ═══ El negocio del futuro ═══ -->
  <section class="pt-futuro-sec">
    <div class="pt-inner pt-futuro-grid">
      <div>
        <span class="pt-eyebrow">El negocio del futuro</span>
        <h2 class="pt-h2">Implementar el retail de moda completo, con IA, y cobrar cada mes</h2>
      </div>
      <div>
        <p class="pt-p">Antes un integrador vendía un software y se iba. Hoy un partner de Sacs implementa punto de venta, inventario por talla, tienda en línea, WhatsApp, finanzas y la IA que mueve el inventario, y sigue cobrando mientras la marca crece. Es integral, es recurrente y no depende de una sola ciudad.</p>
        <ul class="pt-lista">
          <li>Un solo sistema para toda la operación: no armas nada con piezas</li>
          <li>La IA hace el trabajo pesado: implementas en días</li>
          <li>Recurrencia: cada tienda paga cada mes, contigo</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ Manifiesto ═══ -->
  <section class="pt-manifiesto">
    <div class="pt-inner">
      <span class="pt-eyebrow">Lo que creemos</span>
      <div class="pt-mani-lineas">
        <p>El retail de moda no necesita más software. Necesita que alguien lo implemente completo y lo opere bien.</p>
        <p>Creemos en partners que se quedan: que abren la tienda, la ven crecer y cobran con ella.</p>
        <p>Creemos que la IA no reemplaza al partner: lo hace diez veces más grande.</p>
        <p>Creemos que una marca de Guadalajara y una de Barcelona merecen el mismo sistema, y que un partner puede llevárselo a las dos.</p>
        <p>Y creemos que la mejor alianza es la que gana cada mes, no una sola vez.</p>
      </div>
      <span class="pt-firma">Sacs · Fashion Commerce</span>
    </div>
  </section>

  <!-- ═══ Cómo empezar + cita ═══ -->
  <section class="pt-inicio" id="agenda">
    <div class="pt-inner">
      <span class="pt-eyebrow">Cómo empezar</span>
      <h2 class="pt-h2">De la primera plática a tu primer retailer</h2>
      <ol class="pt-linea">
        {pasos.map((p, i) => (<li><span class="pt-paso-n">{i + 1}</span><h3>{p.t}</h3><p>{p.d}</p></li>))}
      </ol>
      <div class="pt-cierre">
        <div class="pt-cierre-txt">
          <span class="pt-eyebrow">Hablemos de tu alianza</span>
          <h3>Elige cómo prefieres empezar</h3>
        </div>
        <div class="pt-opciones">
          <button type="button" class="pt-opcion" id="pt-abrir-agenda">
            <span class="pt-opcion-k">Cita de alianzas comerciales</span>
            <b>45 minutos con nuestra directora comercial</b>
            <span class="pt-opcion-l">Elegir día y hora →</span>
          </button>
          <a href={waGeneral} class="pt-opcion" target="_blank" rel="noopener noreferrer">
            <span class="pt-opcion-k">WhatsApp</span>
            <b>Directo, sin cita, respuesta el mismo día</b>
            <span class="pt-opcion-l">Escribirnos →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal de agenda (evento "Alianzas comerciales") -->
  <div class="pt-modal" id="pt-modal" role="dialog" aria-modal="true" aria-label="Agenda una cita de alianzas" hidden>
    <div class="pt-modal-fondo" data-cerrar></div>
    <div class="pt-modal-caja">
      <button type="button" class="pt-modal-x" data-cerrar aria-label="Cerrar">×</button>
      <div class="pt-modal-head"><span class="pt-eyebrow">Alianzas comerciales · 45 min</span><h3>Elige día y hora</h3></div>
      <iframe id="pt-modal-iframe" title="Agendar cita de alianzas" loading="lazy"></iframe>
    </div>
  </div>
</BaseLayout>

<style>
  /* Sistema: negro / blanco / grises; azul solo en eyebrows y enlaces. Sin cajas de color. */
  .pt-inner { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
  .pt-eyebrow { display: block; font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-primary-texto, #3A62C4); margin-bottom: 16px; }
  .pt-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 4vw, 56px); letter-spacing: -0.035em; line-height: 1.02; margin: 0 0 16px; color: inherit; }
  .pt-frase { font-family: var(--font-display); font-size: clamp(18px, 1.6vw, 24px); font-weight: 500; line-height: 1.3; margin: 0 0 14px; color: inherit; }
  .pt-p { font-size: clamp(16px, 1.2vw, 18px); line-height: 1.55; margin: 0; opacity: 0.75; }
  .pt-lista { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
  .pt-lista li { position: relative; padding-left: 26px; font-size: 16px; line-height: 1.45; }
  .pt-lista li::before { content: ''; position: absolute; left: 0; top: 9px; width: 12px; height: 2px; background: currentColor; opacity: 0.5; }
  .pt-datos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 26px 0 0; padding-top: 20px; border-top: 1px solid currentColor; }
  .pt-datos div { display: flex; flex-direction: column; gap: 6px; }
  .pt-datos dt { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.75; }
  .pt-datos dd { margin: 0; font-size: 15px; line-height: 1.45; }
  .pt-datos div:first-child dd { font-family: var(--font-display); font-weight: 600; font-size: 17px; }
  .pt-ctas { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; margin-top: 28px; }
  .pt-btn { display: inline-flex; align-items: center; justify-content: center; padding: 15px 26px; border-radius: 12px; background: #0E0D0C; color: #fff; font-weight: 700; font-size: 15px; text-decoration: none; border: 0; cursor: pointer; transition: transform 0.2s, opacity 0.2s; }
  .pt-btn:hover { transform: translateY(-1px); opacity: 0.92; }
  .pt-btn--blanco { background: #fff; color: #0E0D0C; }
  .pt-link { font-weight: 600; color: var(--color-primary-texto, #3A62C4); text-decoration: none; }
  .pt-link--claro { color: #fff; opacity: 0.85; }

  /* ── Orquestador ── */
  .pt-orq { background: #0E0D0C; color: #fff; padding: clamp(80px, 11vw, 150px) 0; overflow: hidden; }
  .pt-orq-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .pt-orq .pt-eyebrow { color: #8FB0FF; }
  .pt-orq .pt-datos { border-color: rgba(255,255,255,0.18); }
  .pt-orq-vis { position: relative; }
  .pt-orq-foto { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 22px; }
  /* ── Filas de alianza (formato pilar del home) ── */
  .pt-tipos { background: #fff; color: #0E0D0C; padding: clamp(72px, 9vw, 120px) 0 0; }
  .pt-tipos-head { max-width: 760px; margin-bottom: clamp(40px, 6vw, 72px); }
  .pt-fila { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; padding: clamp(48px, 7vw, 96px) 0; border-top: 1px solid #ECECE9; }
  .pt-fila--inv .pt-fila-media { order: 2; }
  .pt-fila-media img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 22px; display: block; }
  .pt-fila h3 { font-family: var(--font-display); font-size: clamp(28px, 3vw, 44px); letter-spacing: -0.03em; line-height: 1.05; margin: 0 0 12px; color: inherit; }
  .pt-fila .pt-datos { border-color: #ECECE9; }

  /* ── Mosaico de las cinco alianzas del ecosistema ── */
  .pt-mas { background: #fff; color: #0E0D0C; padding: clamp(72px, 9vw, 120px) 0; }
  .pt-mosaico { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .pt-mos { position: relative; grid-column: span 2; aspect-ratio: 4 / 5; border-radius: 22px; overflow: hidden; background: #0E0D0C; color: #fff; isolation: isolate; }
  .pt-mos--g { grid-column: span 3; aspect-ratio: 3 / 2; }
  .pt-mos img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.2,0.7,0.2,1); }
  .pt-mos:hover img { transform: scale(1.05); }
  .pt-mos-velo { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,13,12,0) 30%, rgba(14,13,12,0.55) 62%, rgba(14,13,12,0.92) 100%); transition: background 0.5s; }
  .pt-mos:hover .pt-mos-velo, .pt-mos:focus-within .pt-mos-velo { background: linear-gradient(180deg, rgba(14,13,12,0.15) 0%, rgba(14,13,12,0.7) 45%, rgba(14,13,12,0.95) 100%); }
  .pt-mos-txt { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(20px, 2.4vw, 32px); display: flex; flex-direction: column; gap: 8px; }
  .pt-mos-n { font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; color: #8FB0FF; }
  .pt-mos h3 { font-family: var(--font-display); font-size: clamp(22px, 2.2vw, 32px); letter-spacing: -0.03em; line-height: 1.05; margin: 0; color: #fff; }
  .pt-mos-frase { margin: 0; font-size: 15px; line-height: 1.45; color: rgba(255,255,255,0.85); }
  .pt-mos-mas { display: grid; grid-template-rows: 0fr; overflow: hidden; transition: grid-template-rows 0.55s cubic-bezier(0.2,0.7,0.2,1); }
  .pt-mos-mas > * { min-height: 0; }
  .pt-mos:hover .pt-mos-mas, .pt-mos:focus-within .pt-mos-mas { grid-template-rows: 1fr; }
