---
// El registro del visitante en el stand: la liga del QR.
//
// Página sola, sin el sitio alrededor: en una feria la red es mala y el visitante tiene
// 20 segundos de paciencia. Todo inline, nada que descargar, y si el envío falla se
// guarda en el teléfono y se reintenta cuando vuelva la señal.
export const prerender = false;
import { supabase } from '../../lib/supabase';

const token = String(Astro.params.token || '').replace(/[^a-z0-9]/g, '').slice(0, 20);
let ed: any = null;
if (token.length >= 8) {
  const { data } = await supabase.from('ev_ediciones').select('id, nombre, inicio, fin, ciudad, ev_eventos(nombre)').eq('token_publico', token).maybeSingle();
  ed = data;
}
const evento = ed?.ev_eventos?.nombre || '';
// Abre 45 días antes (para probar el QR impreso y para quien recibe la liga por adelantado)
// y cierra 30 después: pasado eso, quien llegue es un lead de web, no de feria.
const antes = !!ed && Date.now() < Date.parse(ed.inicio) - 45 * 864e5;
const abreEl = ed ? new Date(Date.parse(ed.inicio) - 45 * 864e5).toISOString().slice(0, 10) : '';
const abierto = !!ed && !antes && Date.now() <= Date.parse(ed.fin || ed.inicio) + 30 * 864e5;
const fechaLarga = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
// Mismas claves que el formulario del CRM (ui.tsx → GIROS): contacts.giro no puede
// quedar en dos idiomas según por qué puerta entró la persona.
const GIROS: [string, string][] = [['boutiques', 'Boutique'], ['zapaterias', 'Zapatería'], ['fabricantes', 'Marca / fabricante'], ['distribuidores', 'Distribuidor / mayoreo'], ['novias', 'Novias y XV'], ['renta', 'Renta de vestidos'], ['joyeria', 'Joyería o relojería'], ['western', 'Botas western'], ['scrubs', 'Uniformes'], ['tallas', 'Tallas extra / maternidad / bebé'], ['opticas', 'Óptica'], ['telas', 'Telas y mercería'], ['otro', 'Otro']];
---
<!doctype html>
<html lang="es-MX">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title>{evento ? `Registro · ${evento}` : 'Registro'} — Sacscloud</title>
<style>
  :root { --azul:#4B7BE5; --tinta:#1b1a24; --gris:#6b6a75; --linea:#e6e5ee; --fondo:#f6f6fa; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--fondo); color:var(--tinta); font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif; -webkit-font-smoothing:antialiased; }
  .caja { max-width:480px; margin:0 auto; padding:22px 18px 40px; }
  .marca { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
  .marca img { height:22px; width:auto; }
  .marca span { font-size:.72rem; color:var(--gris); font-weight:600; letter-spacing:.06em; text-transform:uppercase; }
  h1 { font-size:1.35rem; line-height:1.25; margin:0 0 6px; letter-spacing:-.01em; }
  .sub { color:var(--gris); margin:0 0 20px; font-size:.95rem; line-height:1.45; }
  form { background:#fff; border:1px solid var(--linea); border-radius:16px; padding:18px 16px; display:grid; gap:14px; }
  label { display:grid; gap:6px; font-size:.82rem; font-weight:700; color:#3a3946; }
  input, select, textarea { font:inherit; font-size:16px; padding:12px 13px; border:1.5px solid var(--linea); border-radius:11px; background:#fff; color:var(--tinta); width:100%; }
  input:focus, select:focus, textarea:focus { outline:none; border-color:var(--azul); box-shadow:0 0 0 3px rgba(75,123,229,.15); }
  .fila { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .check { display:flex; gap:10px; align-items:flex-start; font-size:.86rem; font-weight:500; color:#3a3946; line-height:1.4; }
  .check input { width:20px; height:20px; margin:1px 0 0; flex:none; }
  .check a { color:var(--azul); }
  button { font:inherit; font-weight:800; font-size:1.05rem; padding:15px; border:0; border-radius:999px; background:var(--azul); color:#fff; cursor:pointer; margin-top:4px; }
  button[disabled] { opacity:.6; }
  .aviso { font-size:.8rem; color:var(--gris); text-align:center; margin-top:14px; line-height:1.4; }
  .listo { background:#fff; border:1px solid var(--linea); border-radius:16px; padding:26px 20px; text-align:center; }
  .listo h2 { margin:0 0 8px; font-size:1.3rem; }
  .listo p { color:var(--gris); margin:0 0 18px; line-height:1.5; }
  .listo a { display:inline-block; background:#25D366; color:#fff; text-decoration:none; font-weight:800; padding:13px 22px; border-radius:999px; }
  .error { background:#FEF0EF; color:#C0554E; padding:10px 12px; border-radius:10px; font-size:.86rem; font-weight:600; display:none; }
  .cola { background:#FFF4E5; color:#9a6a10; padding:10px 12px; border-radius:10px; font-size:.86rem; font-weight:600; display:none; }
  .cerrado { text-align:center; padding:40px 10px; color:var(--gris); }
</style>
</head>
<body>
<div class="caja">
  <div class="marca"><img src="/images/sacs-wordmark.png" alt="Sacs"><span>Sistema para marcas de moda</span></div>
  {!ed || !abierto ? (
    <div class="cerrado">
      <h1>{!ed ? 'Esta liga no existe' : antes ? `El registro para ${evento} abre el ${fechaLarga(abreEl)}` : 'El registro de este evento ya cerró'}</h1>
      <p>Escríbenos por WhatsApp y te atendemos: <a href="https://wa.me/5215536634392">+52 1 55 3663 4392</a></p>
    </div>
  ) : (
    <>
      <h1>Nos dio gusto conocerte en {evento}</h1>
      <p class="sub">Déjanos tus datos y te escribimos por WhatsApp desde nuestro número oficial (+52 1 55 3663 4392) con el diagnóstico gratuito de tu negocio. Toma 20 segundos.</p>
      <form id="f" autocomplete="on">
        <label>Tu nombre <input name="nombre" required placeholder="Nombre y apellido" autocomplete="name"></label>
        <label>Tu negocio o marca <input name="empresa" required placeholder="Cómo se llama tu tienda" autocomplete="organization"></label>
        <input name="sitio_web" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
        <label>WhatsApp <input name="whatsapp" type="tel" inputmode="numeric" required placeholder="10 dígitos" pattern="[0-9 ]{10,14}" autocomplete="tel"></label>
        <label>Correo <span style="font-weight:500;color:#8a8994">(opcional)</span> <input name="email" type="email" placeholder="tu@correo.com" autocomplete="email"></label>
        <div class="fila">
          <label>Giro <select name="giro"><option value="">Elige…</option>{GIROS.map(([k, g]) => <option value={k}>{g}</option>)}</select></label>
          <label>Tiendas <input name="sucursales" type="number" inputmode="numeric" min="0" max="999" placeholder="1"></label>
        </div>
        <label class="check"><input type="checkbox" name="quiere_demo" value="1"> Quiero una demo de 20 minutos con mi propio negocio</label>
        <label class="check"><input type="checkbox" name="consentimiento" value="1" required oninvalid="this.setCustomValidity('Necesitamos tu permiso para escribirte')" onchange="this.setCustomValidity('')"> Acepto que Sacscloud use estos datos para escribirme por WhatsApp y correo sobre su sistema. Puedo pedir que dejen de hacerlo cuando quiera. <a href="/privacidad" target="_blank" rel="noopener">Aviso de privacidad</a></label>
        <div class="error" id="err"></div>
        <div class="cola" id="cola">Sin señal por ahora. Tu registro quedó guardado en este teléfono: deja esta página abierta y se envía solo en cuanto haya red. Si la cierras, vuelve a abrir el QR más tarde y se enviará entonces.</div>
        <button type="submit" id="btn">Registrarme</button>
        <div class="aviso">Sin costo y sin compromiso. Solo te escribimos si nos dices que sí.</div>
      </form>
      <div class="listo" id="ok" style="display:none">
        <h2>Listo, ya quedaste</h2>
        <p>Te escribimos por WhatsApp desde el +52 1 55 3663 4392 (guárdalo para reconocernos). Si quieres adelantarte:</p>
        <a href="https://wa.me/5215536634392?text=Hola,%20me%20registré%20en%20el%20stand%20de%20Sacscloud">Abrir WhatsApp</a>
      </div>
    </>
  )}
</div>
<script is:inline define:vars={{ token }}>
  (function () {
    var f = document.getElementById('f'); if (!f) return;
    var err = document.getElementById('err'), cola = document.getElementById('cola'), btn = document.getElementById('btn'), ok = document.getElementById('ok');
    var K = 'ev-registro-pendiente';
    function leerCola() { try { return JSON.parse(localStorage.getItem(K) || '[]'); } catch (e) { return []; } }
    function guardarCola(l) { try { localStorage.setItem(K, JSON.stringify(l)); } catch (e) {} }
    function enviar(d) {
      return fetch('/api/eventos/registro', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
        .then(function (r) { return r.json().then(function (j) { return { status: r.status, j: j }; }); });
    }
    var mandando = false;
    function reintentar() {
      var l = leerCola(); if (!l.length || mandando) return;
      mandando = true;
      var d = l[0];
      enviar(d).then(function (r) {
        mandando = false;
        if (r.status === 200 || r.status === 400 || r.status === 404 || r.status === 410) {
          l.shift(); guardarCola(l);
          // Lo que estaba esperando ya se fue: se lo decimos, para que no se quede
          // cuidando la página sin necesidad.
          if (r.status === 200 && cola.style.display === 'block') { cola.textContent = 'Volvió la señal: tu registro ya se envió. Ya puedes cerrar esta página.'; cola.style.background = '#EAF8F2'; cola.style.color = '#1E8A63'; }
          if (l.length) reintentar();
        }
      }).catch(function () { mandando = false; });
    }
    // «online» no siempre se dispara en una feria con señal que va y viene: además se
    // intenta cada 20 s mientras la página siga abierta y haya algo en la cola.
    window.addEventListener('online', reintentar); reintentar(); setInterval(reintentar, 20000);
    f.addEventListener('submit', function (e) {
      e.preventDefault(); err.style.display = 'none'; cola.style.display = 'none';
      var fd = new FormData(f), d = { token: token, cliente_local_id: 'q' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7) };
      fd.forEach(function (v, k) { d[k] = v; });
      d.quiere_demo = !!fd.get('quiere_demo'); d.consentimiento = !!fd.get('consentimiento');
      if (String(d.whatsapp || '').replace(/\D/g, '').length < 10) { err.textContent = 'Revisa el WhatsApp: son 10 dígitos.'; err.style.display = 'block'; return; }
      btn.disabled = true; btn.textContent = 'Enviando…';
      enviar(d).then(function (r) {
        if (r.status === 200) { f.style.display = 'none'; ok.style.display = 'block'; window.scrollTo(0, 0); return; }
        btn.disabled = false; btn.textContent = 'Registrarme';
        if (r.status === 429) { var l = leerCola(); l.push(d); guardarCola(l); cola.style.display = 'block'; return; }
        err.textContent = (r.j && r.j.error) || 'No se pudo registrar. Intenta de nuevo.'; err.style.display = 'block';
      }).catch(function () {
        var l = leerCola(); l.push(d); guardarCola(l);
        btn.disabled = false; btn.textContent = 'Registrarme';
        f.style.display = 'none'; ok.style.display = 'block'; cola.style.display = 'block'; ok.insertBefore(cola, ok.firstChild);
      });
    });
  })();
</script>
</body>
</html>
