---
// Apartar cita en el stand antes de la feria: la liga de la invitación (punto 3).
//
// Misma filosofía que /e/[token]: página sola, todo inline, sin el sitio alrededor.
// Elige día y hora libre, deja sus datos, y la confirmación le llega por WhatsApp.
export const prerender = false;
import { supabase } from '../../../lib/supabase';
import { GIROS } from '../../../lib/crm/eventos-catalogos';

const token = String(Astro.params.token || '').replace(/[^a-z0-9]/g, '').slice(0, 20);
let ed: any = null;
if (token.length >= 8) {
  const { data } = await supabase.from('ev_ediciones').select('id, nombre, inicio, fin, ciudad, sede, stand_numero, participacion, ev_eventos(nombre)').eq('token_publico', token).maybeSingle();
  ed = data;
}
const evento = ed?.ev_eventos?.nombre || '';
const abierto = !!ed && ed.participacion === 'vamos' && Date.now() <= Date.parse(ed.fin || ed.inicio) + 864e5 && Date.now() >= Date.parse(ed.inicio) - 120 * 864e5;
const fechaLarga = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });
const stand = ed?.stand_numero ? `Stand ${ed.stand_numero}` : '';
const lugar = [stand, ed?.sede, ed?.ciudad].filter(Boolean).join(' · ');
const dias: string[] = [];
if (ed) for (let d = new Date(ed.inicio + 'T12:00:00Z'); d.toISOString().slice(0, 10) <= (ed.fin || ed.inicio) && dias.length < 14; d.setUTCDate(d.getUTCDate() + 1)) dias.push(d.toISOString().slice(0, 10));
const giros = Object.entries(GIROS);
---
<!doctype html>
<html lang="es-MX">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title>{evento ? `Cita en el stand · ${evento}` : 'Cita en el stand'} — Sacscloud</title>
<style is:global>
  :root { --azul:#4B7BE5; --tinta:#1b1a24; --gris:#6b6a75; --linea:#e6e5ee; --fondo:#f6f6fa; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--fondo); color:var(--tinta); font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif; -webkit-font-smoothing:antialiased; }
  .caja { max-width:480px; margin:0 auto; padding:22px 18px 40px; }
  .marca { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
  .marca img { height:22px; width:auto; }
  .marca span { font-size:.72rem; color:var(--gris); font-weight:600; letter-spacing:.06em; text-transform:uppercase; }
  h1 { font-size:1.35rem; line-height:1.25; margin:0 0 6px; letter-spacing:-.01em; }
  .sub { color:var(--gris); margin:0 0 18px; font-size:.95rem; line-height:1.45; }
  .lugar { font-size:.85rem; color:#3a3946; font-weight:600; margin:0 0 18px; }
  form { background:#fff; border:1px solid var(--linea); border-radius:16px; padding:18px 16px; display:grid; gap:14px; }
  label { display:grid; gap:6px; font-size:.82rem; font-weight:700; color:#3a3946; }
  input, select, textarea { font:inherit; font-size:16px; padding:12px 13px; border:1.5px solid var(--linea); border-radius:11px; background:#fff; color:var(--tinta); width:100%; }
  input:focus, select:focus, textarea:focus { outline:none; border-color:var(--azul); box-shadow:0 0 0 3px rgba(75,123,229,.15); }
  .dias { display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; }
  .dias button, .horas button { font:inherit; font-size:.85rem; font-weight:700; padding:10px 12px; border:1.5px solid var(--linea); border-radius:11px; background:#fff; color:#3a3946; cursor:pointer; white-space:nowrap; }
  .dias button.on, .horas button.on { background:var(--azul); border-color:var(--azul); color:#fff; }
  .horas { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
  .horas button[disabled] { opacity:.35; cursor:default; text-decoration:line-through; }
  .horas .vacio { grid-column:1/-1; color:var(--gris); font-size:.85rem; font-weight:500; }
  .fila { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .btn { font:inherit; font-weight:800; font-size:1.05rem; padding:15px; border:0; border-radius:999px; background:var(--azul); color:#fff; cursor:pointer; margin-top:4px; }
  .btn[disabled] { opacity:.6; }
  .aviso { font-size:.8rem; color:var(--gris); text-align:center; margin-top:14px; line-height:1.4; }
  .listo { background:#fff; border:1px solid var(--linea); border-radius:16px; padding:26px 20px; text-align:center; }
  .listo h2 { margin:0 0 8px; font-size:1.3rem; }
  .listo p { color:var(--gris); margin:0 0 18px; line-height:1.5; }
  .listo a { display:inline-block; background:#25D366; color:#fff; text-decoration:none; font-weight:800; padding:13px 22px; border-radius:999px; }
  .error { background:#FEF0EF; color:#C0554E; padding:10px 12px; border-radius:10px; font-size:.86rem; font-weight:600; display:none; }
  .cerrado { text-align:center; padding:40px 10px; color:var(--gris); }
</style>
</head>
<body>
<div class="caja">
  <div class="marca"><img src="/images/sacs-wordmark.png" alt="Sacs"><span>Sistema para marcas de moda</span></div>
  {!ed || !abierto ? (
    <div class="cerrado">
      <h1>{!ed ? 'Esta liga no existe' : 'Las citas para este evento ya cerraron'}</h1>
      <p>Escríbenos por WhatsApp y te atendemos: <a href="https://wa.me/525593027234">+52 55 9302 7234</a></p>
    </div>
  ) : (
    <>
      <h1>Aparta tu cita en el stand de Sacscloud en {evento}</h1>
      <p class="sub">15 minutos con tu propio negocio: te enseñamos cómo se vería tu inventario, tus ventas y tus tiendas en el sistema. Sin costo.</p>
      {lugar && <p class="lugar">{lugar}</p>}
      <form id="f" autocomplete="on">
        <label>Día
          <div class="dias" id="dias">{dias.map((d, i) => <button type="button" data-dia={d} class={i === 0 ? 'on' : ''}>{fechaLarga(d)}</button>)}</div>
        </label>
        <label>Hora
          <div class="horas" id="horas"><span class="vacio">Cargando horarios…</span></div>
        </label>
        <label>Tu nombre <input name="nombre" required placeholder="Nombre y apellido" autocomplete="name"></label>
        <label>Tu negocio o marca <input name="empresa" required placeholder="Cómo se llama tu tienda" autocomplete="organization"></label>
        <input name="sitio_web" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
        <label>WhatsApp <input name="whatsapp" type="tel" inputmode="numeric" required placeholder="10 dígitos" pattern="[0-9 ]{10,14}" autocomplete="tel"></label>
        <div class="fila">
          <label>Correo <span style="font-weight:500;color:#8a8994">(opcional)</span> <input name="email" type="email" placeholder="tu@correo.com" autocomplete="email"></label>
          <label>Giro <select name="giro"><option value="">Elige…</option>{giros.map(([k, g]) => <option value={k}>{g}</option>)}</select></label>
        </div>
        <label>Qué te gustaría ver <span style="font-weight:500;color:#8a8994">(opcional)</span> <textarea name="nota" rows="2" maxlength="300" placeholder="Inventario entre tiendas, punto de venta, tienda en línea…"></textarea></label>
        <div class="error" id="err"></div>
        <button type="submit" class="btn" id="btn">Apartar mi cita</button>
        <div class="aviso">Te confirmamos por WhatsApp desde el +52 55 9302 7234. Puedes cancelar cuando quieras desde ese mismo mensaje.</div>
      </form>
      <div class="listo" id="ok" style="display:none">
        <h2>Listo, te esperamos</h2>
        <p id="okTxt"></p>
        <a href="https://wa.me/525593027234?text=Hola,%20apart%C3%A9%20cita%20en%20el%20stand%20de%20Sacscloud">Abrir WhatsApp</a>
      </div>
    </>
  )}
</div>
<script is:inline define:vars={{ token, lugar }}>
  (function () {
    var f = document.getElementById('f'); if (!f) return;
    var err = document.getElementById('err'), btn = document.getElementById('btn'), ok = document.getElementById('ok'), okTxt = document.getElementById('okTxt');
    var dias = document.getElementById('dias'), horas = document.getElementById('horas');
    var dia = (dias.querySelector('.on') || {}).dataset ? dias.querySelector('.on').dataset.dia : '', hora = '';
    function cargar() {
      horas.innerHTML = '<span class="vacio">Cargando horarios…</span>'; hora = '';
      fetch('/api/eventos/cita?token=' + encodeURIComponent(token) + '&dia=' + encodeURIComponent(dia)).then(function (r) { return r.json(); }).then(function (j) {
        var l = (j && j.huecos) || []; horas.innerHTML = '';
        if (!l.length) { horas.innerHTML = '<span class="vacio">Ese día ya no hay horarios. Prueba otro.</span>'; return; }
        l.forEach(function (h) {
          var b = document.createElement('button'); b.type = 'button'; b.textContent = h.hora; b.disabled = !h.libre; b.dataset.hora = h.hora;
          b.addEventListener('click', function () { hora = h.hora; horas.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); }); });
          horas.appendChild(b);
        });
      }).catch(function () { horas.innerHTML = '<span class="vacio">No se pudieron cargar los horarios. Recarga la página.</span>'; });
    }
    dias.querySelectorAll('button').forEach(function (b) {
      b.addEventListener('click', function () { dia = b.dataset.dia; dias.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); }); cargar(); });
    });
    cargar();
    f.addEventListener('submit', function (e) {
      e.preventDefault(); err.style.display = 'none';
      if (!hora) { err.textContent = 'Elige una hora.'; err.style.display = 'block'; return; }
      var fd = new FormData(f), d = { token: token, dia: dia, hora: hora };
      fd.forEach(function (v, k) { d[k] = v; });
      if (String(d.whatsapp || '').replace(/\D/g, '').length < 10) { err.textContent = 'Revisa el WhatsApp: son 10 dígitos.'; err.style.display = 'block'; return; }
      btn.disabled = true; btn.textContent = 'Apartando…';
      fetch('/api/eventos/cita', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
        .then(function (r) { return r.json().then(function (j) { return { status: r.status, j: j }; }); })
        .then(function (r) {
          if (r.status === 200) {
            f.style.display = 'none'; ok.style.display = 'block'; window.scrollTo(0, 0);
            var db = dias.querySelector('.on'); okTxt.textContent = 'Tu cita quedó el ' + (db ? db.textContent : dia) + ' a las ' + hora + (lugar ? ' en ' + lugar : '') + '. Te mandamos la confirmación por WhatsApp.';
            return;
          }
          btn.disabled = false; btn.textContent = 'Apartar mi cita';
          err.textContent = (r.j && r.j.error) || 'No se pudo apartar. Intenta de nuevo.'; err.style.display = 'block';
          if (r.status === 400 && /hora/i.test(err.textContent)) cargar();
        }).catch(function () { btn.disabled = false; btn.textContent = 'Apartar mi cita'; err.textContent = 'Sin señal. Intenta de nuevo.'; err.style.display = 'block'; });
    });
  })();
</script>
</body>
</html>
