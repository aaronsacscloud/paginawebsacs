---
/**
 * Landing LENCERÍA Y ROPA INTERIOR (17-sep-2026). Misma estructura que marcas-de-ropa.astro; el
 * contenido vive en src/data/giros/lenceria.ts y el bloque propio es LeHermana ("La pared que se
 * rompe por el centro").
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GiroBanner from '../../../components/giros/GiroBanner.astro';
import SuiteManifiesto from '../../../components/suite/SuiteManifiesto.astro';
import SuiteVariantes from '../../../components/suite/SuiteVariantes.astro';
import SuiteCortina from '../../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../../components/suite/SuiteProblemas.astro';
import SuiteSalida from '../../../components/suite/SuiteSalida.astro';
import SuiteCifras from '../../../components/suite/SuiteCifras.astro';
import SuiteCasos from '../../../components/suite/SuiteCasos.astro';
import SuiteScroll from '../../../components/suite/SuiteScroll.astro';
import SuitePlano from '../../../components/suite/SuitePlano.astro';
import SuiteProceso from '../../../components/suite/SuiteProceso.astro';
import SuitePlanes from '../../../components/suite/SuitePlanes.astro';
import CtaDudas from '../../../components/CtaDudas.astro';
import LeHermana from '../../../components/giros/LeHermana.astro';
import GiroEscala from '../../../components/giros/GiroEscala.astro';
import { bannerLE, manifiestoLE, variantesLE, cortinaLE, casosLE, seccionesLE, planoLE, pasosLE, ticketLE, escalaLE, problemasLE, cifrasLE } from '../../../data/giros/lenceria';
---
<BaseLayout
  title="Sistema para tiendas de lencería y ropa interior — Sacs"
  description="Punto de venta e inventario para lencería: la pared por número y copa, la talla hermana en la caja, la talla de cada clienta en su ficha, vendedoras de catálogo con cartera y campaña, tripacks que no se abren y la regla de higiene en el ticket."
>
  <GiroBanner eyebrow={bannerLE.eyebrow} titulo={bannerLE.titulo} resalte={bannerLE.resalte} sub={bannerLE.sub} foto={bannerLE.foto} fotoAlt={bannerLE.fotoAlt} avisos={bannerLE.avisos} selloMarcas="negocios de moda y lencería en México y Latam" />

  <SuiteManifiesto intro={manifiestoLE.intro} frases={manifiestoLE.frases} cierre={manifiestoLE.cierre} />

  <SuiteVariantes eyebrow={variantesLE.eyebrow} titulo={variantesLE.titulo} resalte={variantesLE.resalte} sub={variantesLE.sub} ejeA={variantesLE.ejeA} filas={variantesLE.filas} matriz={variantesLE.matriz} unidad={variantesLE.unidad} genero={variantesLE.genero} umbralBajo={variantesLE.umbralBajo} leyendas={variantesLE.leyendas} remate={variantesLE.remate} />

  <SuiteCortina titulo="¿Hay 34C del negro?" fotoAntes={cortinaLE.fotoAntes} fotoDespues={cortinaLE.fotoDespues} altAntes={cortinaLE.altAntes} altDespues={cortinaLE.altDespues} libreta={cortinaLE.libreta} filas={cortinaLE.filas} pieDespues={cortinaLE.pieDespues} />

  <SuiteProblemas colGenerico="Sistema de ropa" entrada={problemasLE.entrada} quienes={problemasLE.quienes} doc1={problemasLE.doc1} doc2={problemasLE.doc2} filas={problemasLE.filas} />

  <SuiteSalida frase="Si ya probaste un sistema de ropa y un desarrollo a la medida, la tercera conversación es distinta: esta ya sabe que la talla son dos números." />

  <SuiteCifras foto={cifrasLE.foto} alt={cifrasLE.alt} frase={cifrasLE.frase} encuadre={cifrasLE.encuadre} datos={[
    { n: 3000, pre: '+', rotulo: 'NEGOCIOS DE MODA Y LENCERÍA ACTIVOS' },
    { n: 7600, pre: '+$', rotulo: 'MILLONES TRANSACCIONADOS' },
    { n: 20, pos: '+', rotulo: 'PERSONAS DE SOPORTE, EN MÉXICO' },
    { n: 1, pre: '#', rotulo: 'EN RETAIL ESPECIALIZADO' },
  ]} />

  <SuiteCasos eyebrow="Cuatro momentos del año" titulo="Dónde te sirve, en concreto" sub="Los cuatro momentos del año en que una tienda de lencería gana o pierde el dinero. Toca cada uno." casos={casosLE} />

  <SuiteScroll eyebrow="Lencería y ropa interior" titulo="La pared, el catálogo y el WhatsApp, con el mismo inventario" intro="Baja para ver cada pieza. Todos los ejemplos son de una corsetería real: la cuadrícula de número y copa, la talla hermana, la ficha de la clienta y la campaña de catálogo." secciones={seccionesLE} />

  <LeHermana />

  <GiroEscala encabezado="Tu tamaño" titulo="De la corsetería del barrio a la cadena nacional con catálogo." descripcion="El negocio cambia con cada tamaño: quién mide a la clienta, cómo se rompe la pared en cada tienda, cuántas vendedoras y qué mira la dirección. Elige el tuyo." niveles={escalaLE} />

  <SuitePlano titulo="Tu tienda, por dentro." sub="Entra la clienta, pide su talla en la pared, se mide en el rincón del probador, paga y se va. Detrás está la bodega donde se arman las bolsas de campaña y la mesa donde las vendedoras recogen sus pedidos. Toca cada zona y mira qué hace Sacs ahí." proyecto="Tu corsetería — planta baja" zonas={planoLE} todoRot="Lencería y ropa interior" />

  <SuiteProceso titulo="Cambiar de sistema" resalte="sin cerrar la tienda." sub="Tienes el 10 de mayo o el 14 de febrero encima y no puedes parar una semana. Así se hace, y lo hacemos nosotros: no te dejamos un manual y suerte." pasos={pasosLE} lineas={ticketLE.lineas} total={ticketLE.total} remate="<b>Tu histórico no se tira.</b> Se migra lo que sirve: clientas con su número y copa, modelos con su cuadrícula, la cartera de las vendedoras y los apartados vivos. Nunca te pedimos empezar de cero antes de una campaña." />

  <SuitePlanes suite="Suite de Moda" />

  <SuiteSalida frase="Ya viste el precio. Lo que sigue es ver tu propia pared, por número y copa, en pantalla." cta="Agenda una demo" />

  <CtaDudas demoDesc="Te mostramos Sacs con tus modelos, tu pared por número y copa y tu campaña real. 30 min, sin compromiso." />
</BaseLayout>
