---
/**
 * Landing TELAS Y MERCERÍA (17-sep-2026). Misma estructura que marcas-de-ropa.astro; el contenido vive en
 * src/data/giros/telas-y-merceria.ts y el bloque propio es TmPieza ("En telas las existencias no
 * se suman").
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GiroBanner from '../../../components/giros/GiroBanner.astro';
import SuiteManifiesto from '../../../components/suite/SuiteManifiesto.astro';
import SuiteVariantes from '../../../components/suite/SuiteVariantes.astro';
import SuiteCortina from '../../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../../components/suite/SuiteProblemas.astro';
import SuiteSalida from '../../../components/suite/SuiteSalida.astro';
import SuiteCifras from '../../../components/suite/SuiteCifras.astro';
import SuiteCasos from '../../../components/suite/SuiteCasos.astro';
import SuiteScroll from '../../../components/suite/SuiteScroll.astro';
import SuitePlano from '../../../components/suite/SuitePlano.astro';
import SuiteProceso from '../../../components/suite/SuiteProceso.astro';
import SuitePlanes from '../../../components/suite/SuitePlanes.astro';
import CtaDudas from '../../../components/CtaDudas.astro';
import TmPieza from '../../../components/giros/TmPieza.astro';
import GiroEscala from '../../../components/giros/GiroEscala.astro';
import { bannerTM, manifiestoTM, variantesTM, cortinaTM, casosTM, seccionesTM, planoTM, pasosTM, ticketTM, escalaTM, problemasTM, cifrasTM } from '../../../data/giros/telas-y-merceria';
---
<BaseLayout
  title="Sistema para tiendas de telas y mercerías — Sacs"
  description="Sistema para tiendas de telas y mercerías: venta por metro con fracción, la pieza con sus metros restantes y su baño, el saldo que avisa antes de volverse retazo, los avíos por pieza, docena y gruesa, los cuatro precios con medio mayoreo y el fiado de la costurera."
>
  <GiroBanner eyebrow={bannerTM.eyebrow} titulo={bannerTM.titulo} resalte={bannerTM.resalte} sub={bannerTM.sub} foto={bannerTM.foto} fotoAlt={bannerTM.fotoAlt} avisos={bannerTM.avisos} selloMarcas="negocios de moda y tiendas de telas en México y Latam" />

  <SuiteManifiesto intro={manifiestoTM.intro} frases={manifiestoTM.frases} cierre={manifiestoTM.cierre} />

  <SuiteVariantes eyebrow={variantesTM.eyebrow} titulo={variantesTM.titulo} resalte={variantesTM.resalte} sub={variantesTM.sub} ejeA={variantesTM.ejeA} filas={variantesTM.filas} matriz={variantesTM.matriz} unidad={variantesTM.unidad} genero={variantesTM.genero} leyendas={variantesTM.leyendas} remate={variantesTM.remate} />

  <SuiteCortina titulo={cortinaTM.titulo} pieAntes={cortinaTM.pieAntes} fotoAntes={cortinaTM.fotoAntes} fotoDespues={cortinaTM.fotoDespues} altAntes={cortinaTM.altAntes} altDespues={cortinaTM.altDespues} libreta={cortinaTM.libreta} filas={cortinaTM.filas} pieDespues={cortinaTM.pieDespues} />

  <SuiteProblemas colGenerico="Sistema de ropa" entrada={problemasTM.entrada} quienes={problemasTM.quienes} doc1={problemasTM.doc1} doc2={problemasTM.doc2} filas={problemasTM.filas} />

  <SuiteSalida frase="Si ya probaste un sistema de ropa y un desarrollo a la medida, la tercera conversación es distinta: esta ya sabe que las existencias no se suman." />

  <SuiteCifras foto={cifrasTM.foto} alt={cifrasTM.alt} frase={cifrasTM.frase} encuadre={cifrasTM.encuadre} datos={[
    { n: 3000, pre: '+', rotulo: 'NEGOCIOS DE MODA Y TELAS' },
    { n: 7600, pre: '+$', rotulo: 'MILLONES TRANSACCIONADOS' },
    { n: 20, pos: '+', rotulo: 'PERSONAS DE SOPORTE, EN MÉXICO' },
    { n: 1, pre: '#', rotulo: 'EN RETAIL ESPECIALIZADO' },
  ]} />

  <SuiteCasos eyebrow="Cuatro momentos del año" titulo="Dónde te sirve, en concreto" sub="Los cuatro momentos del año en que una tienda de telas gana o pierde el dinero. Toca cada uno." casos={casosTM} />

  <SuiteScroll eyebrow="Telas y mercería" titulo="La pared, el mostrador, la mercería y el cajón del retazo, con las mismas piezas" intro="Baja para ver cada pieza. Todos los ejemplos son de una tienda de telas real: el metro con fracción, la pieza con su baño y sus metros, la lista de la costurera con sus avíos, los cuatro precios y el saldo que avisa antes de morir en el cajón." secciones={seccionesTM} />

  <TmPieza />

  <GiroEscala encabezado="Tu tamaño" titulo="De la tienda del centro a la cadena con bodega propia." descripcion="El negocio cambia con cada tamaño: quién mide la pieza al recibirla, quién corta, quién fía, quién decide el remate del saldo y qué mira la dirección. Elige el tuyo." niveles={escalaTM} />

  <SuitePlano titulo="Tu tienda, por dentro." sub="Entra la costurera, recorre la pared de piezas, pide que le saquen el vino a la luz, pasa a la mercería por sus avíos y llega al mostrador a que le corten. Atrás están la bodega y el cajón del retazo. Toca cada zona y mira qué hace Sacs ahí." proyecto="Tu tienda de telas — planta baja" zonas={planoTM} todoRot="Telas y mercería" />

  <SuiteProceso titulo="Cambiar de sistema" resalte="sin cerrar la tienda." sub="Tienes el escolar encima y no puedes parar una semana. Así se hace, y lo hacemos nosotros: no te dejamos un manual y suerte." pasos={pasosTM} lineas={ticketTM.lineas} total={ticketTM.total} remate="<b>Tu histórico no se tira.</b> Se migran tus piezas con sus metros y su baño, tus saldos, tu mercería por pieza y por docena y, lo que más vale, <b>tus cuentas de fiado con cada costurera</b>. Nunca te pedimos volver a medir la bodega." />

  <SuitePlanes suite="Suite de Moda" />

  <SuiteSalida frase="Ya viste el precio. Lo que sigue es ver tus propias piezas con sus metros y tus saldos en pantalla." cta="Agenda una demo" />

  <CtaDudas demoDesc="Te mostramos Sacs con tus telas, tus baños y tus saldos reales. 30 min, sin compromiso." />
</BaseLayout>
