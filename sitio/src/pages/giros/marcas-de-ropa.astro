---
/**
 * Suite para Tiendas de Ropa.
 *
 * Formato "suite": una sola pagina donde el panel se queda fijo y va cambiando
 * mientras el visitante baja. Sustituye a la version anterior de bloques
 * genericos (POS personalizable / multi-sucursal), que decia lo mismo que
 * cualquier otro giro.
 *
 * Regla de contenido: todo ejemplo es de ROPA. Tallas, colores, temporadas y
 * prendas con nombre. Ver src/data/suite-ropa.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { seccionesRopa } from '../../data/suite-ropa';

const titulo = 'Suite para Tiendas de Ropa';
const desc =
  'El sistema para boutiques y marcas de moda: matriz de tallas y colores, curvas de compra, consignación a departamentales y control de todas tus sucursales.';
---

<BaseLayout title={`${titulo} — SACS`} description={desc}>
  <!-- ── Portada ── -->
  <header class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">SACS · Suite Moda</p>
      <h1 class="hero-title">El sistema que entiende<br /><span>tallas, colores y temporadas</span></h1>
      <p class="hero-sub">
        Todo lo que una boutique necesita, hecho para cómo trabaja una boutique. Sin adaptar
        un sistema de abarrotes a tu inventario.
      </p>
      <div class="hero-cta">
        <a href="/prueba-gratis" class="btn-sec">Prueba gratis</a>
        <a href="/contacto" class="btn-pri">Agenda una demo</a>
      </div>
      <p class="hero-note">9 funcionalidades pensadas para moda · Sin permanencia</p>
    </div>
  </header>

  <!-- ── Recorrido de funcionalidades ── -->
  <SuiteScroll
    eyebrow="Suite Moda"
    titulo="Todo tu negocio de ropa, en un solo lugar"
    intro="Baja para ver cada pieza. Todos los ejemplos son de una tienda de ropa real: tallas que se agotan, colores que nadie compra y prendas paradas de la temporada pasada."
    secciones={seccionesRopa}
  >
    <!-- Testimoniales intercalados: caen dentro del recorrido, no al final,
         para que la prueba social llegue junto al beneficio que la sostiene. -->
    <div slot="extra-consignacion" class="quote">
      <blockquote>
        Dejábamos producto en tres departamentales y cada corte era un pleito de Excel.
        Ahora sé qué se vendió y cuánto me deben sin llamar a nadie.
      </blockquote>
      <cite><b>Espacio para testimonial</b> — marca de ropa con presencia en departamentales</cite>
    </div>

    <div slot="extra-sucursales" class="quote">
      <blockquote>
        Antes le hablábamos por WhatsApp a la otra tienda para preguntar si había la talla.
        Se perdían ventas nada más por la flojera de preguntar.
      </blockquote>
      <cite><b>Espacio para testimonial</b> — boutique con 4 sucursales</cite>
    </div>

    <div slot="extra-reabasto" class="quote">
      <blockquote>
        Comprábamos parejo de todas las tallas. Terminábamos con puras XXL colgadas
        y sin M, que es la que de verdad se vende.
      </blockquote>
      <cite><b>Espacio para testimonial</b> — marca de moda femenina</cite>
    </div>
  </SuiteScroll>

  <FinalCTA />
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, #F8FAFC 0%, #fff 100%);
    border-bottom: 1px solid #F1F5F9;
    padding: 96px 24px 80px;
  }
  .hero-inner { max-width: 900px; margin: 0 auto; text-align: center; }
  .hero-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
    color: #2563EB; margin: 0 0 18px;
  }
  .hero-title {
    font-size: clamp(34px, 6vw, 68px); font-weight: 800; letter-spacing: -2px;
    line-height: 1.03; margin: 0 0 22px; color: #0F172A;
  }
  .hero-title span {
    background: linear-gradient(90deg, #2563EB, #7C3AED);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-sub {
    font-size: clamp(16px, 2vw, 20px); line-height: 1.6; color: #64748B;
    max-width: 60ch; margin: 0 auto 32px;
  }
  .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-pri, .btn-sec {
    display: inline-flex; align-items: center; justify-content: center;
    height: 52px; padding: 0 28px; border-radius: 12px;
    font-size: 15.5px; font-weight: 700; text-decoration: none; transition: all .16s ease;
  }
  .btn-pri { background: #2563EB; color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,.28); }
  .btn-pri:hover { background: #1D4ED8; transform: translateY(-1px); }
  .btn-sec { background: #fff; color: #0F172A; border: 1.5px solid #E5E7EB; }
  .btn-sec:hover { border-color: #CBD5E1; }
  .hero-note { margin: 22px 0 0; font-size: 13px; color: #94A3B8; font-weight: 600; }

  .quote {
    margin-top: 26px; border-left: 3px solid #2563EB;
    background: #F8FAFC; border-radius: 0 14px 14px 0; padding: 18px 22px;
  }
  .quote blockquote {
    margin: 0 0 10px; font-size: 15.5px; line-height: 1.6; color: #0F172A; font-weight: 500;
  }
  .quote cite { font-style: normal; font-size: 12.5px; color: #94A3B8; font-weight: 600; }
  .quote cite b { color: #64748B; }

  @media (max-width: 900px) {
    .hero { padding: 64px 18px 56px; }
  }
</style>
