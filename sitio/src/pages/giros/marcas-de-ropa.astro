---
/**
 * Suite para Tiendas de Ropa.
 *
 * Formato "suite": una sola pagina donde el panel se queda fijo y va cambiando
 * mientras el visitante baja. Sustituye a la version anterior de bloques
 * genericos (POS personalizable / multi-sucursal), que decia lo mismo que
 * cualquier otro giro.
 *
 * Regla de contenido: todo ejemplo es de ROPA. Tallas, colores, temporadas y
 * prendas con nombre. Ver src/data/suite-ropa.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuiteManifiesto from '../../components/suite/SuiteManifiesto.astro';
import SuiteVariantes from '../../components/suite/SuiteVariantes.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import SuiteCasos from '../../components/suite/SuiteCasos.astro';
import SuiteSalida from '../../components/suite/SuiteSalida.astro';
import SuiteProceso from '../../components/suite/SuiteProceso.astro';
import SuiteIntegral from '../../components/suite/SuiteIntegral.astro';
import CtaDudas from '../../components/CtaDudas.astro';
import SuiteCortina from '../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../components/suite/SuiteProblemas.astro';
import SuitePlanes from '../../components/suite/SuitePlanes.astro';
import SuiteCifras from '../../components/suite/SuiteCifras.astro';
import GiroBanner from '../../components/giros/GiroBanner.astro';
import ModaMarcacion from '../../components/giros/ModaMarcacion.astro';
import { seccionesRopa } from '../../data/suite-ropa';
import { cortinaModa, marcacionModa, casosModa, pasosModa, etapasModa } from '../../data/giros/moda';

const titulo = 'Suite para Tiendas de Ropa';
const desc =
  'El sistema para boutiques y marcas de moda: matriz de tallas y colores, existencia por talla en cada tienda, traspasos y control de todas tus sucursales.';
---

<BaseLayout title={`${titulo} — SACS`} description={desc}>
  <!-- ── Portada: la forma del Home. El mensaje a la izquierda, la tienda a
       la derecha y los avisos del sistema encima — pero avisos de moda. ── -->
  <GiroBanner
    eyebrow="SACS · Suite Moda"
    titulo="Tu tienda no vende productos."
    resalte="Vende tallas y colores."
    sub="Matriz de tallas y colores, existencia por talla en cada tienda y el traspaso entre ellas — con un mismo inventario para tu piso, tu tienda en línea, tu WhatsApp y tus marketplaces."
    foto="/images/hero-moda.webp"
    fotoAlt="Empleada de una boutique consultando existencias en una tablet frente a los racks de ropa"
    avisos={[
      { modulo: 'Talla agotada', texto: 'Blusa satinada negra: sin M ni L en Polanco', pos: 1, tono: 'rojo', sello: 'Hoy' },
      { modulo: 'Rebaja sugerida', texto: '38 piezas de la temporada pasada, en tres tiendas', pos: 2, tono: 'ambar', sello: 'Semana 12' },
      { modulo: 'Cambio de talla', texto: 'La M que pide está en Satélite · se aparta desde aquí', pos: 3, tono: 'azul', sello: 'Ahora' },
    ]}
  />

  <!-- ── Manifiesto: aqui se demuestra que entendemos el giro ── -->
  <SuiteManifiesto
    intro="Sabemos cómo se vende la ropa"
    frases={[
      'La <b>M</b> se acabó el primer fin de semana.',
      'La <b>XXL</b> lleva dos temporadas colgada.',
      '"¿Tendrás esta en <b>chica</b>?" — y hay que llamar a la otra tienda.',
      'Vendiste <b>en línea</b> una talla que ya se había vendido en el mostrador.',
      'Tu clienta pregunta por <b>WhatsApp</b> y nadie sabe si eso sigue disponible.',
      'Dejaste 40 vestidos en una <b>departamental</b> y nadie sabe cuántos se vendieron.',
      'Compraste parejo de todas las tallas porque <b>así se ha hecho siempre</b>.',
    ]}
    cierre="Ningún sistema de abarrotes entiende esto. Y hoy ya no basta con entender el mostrador: tu tienda física, tu tienda en línea, tus marketplaces y tu WhatsApp son el mismo negocio, con el mismo inventario y la misma clienta. Esa es la nueva era del retail y es la que llevamos años construyendo: cada pantalla que sigue funciona igual en el piso de venta que en digital, y encima puedes poner agentes de IA — programados por ti — para que hagan el trabajo repetitivo."
  />


  <!-- Entra una blusa y salen las veinticuatro que de verdad hay que comprar,
       guardar y contar. Aquí el eje es talla × color; en calzado es número. -->
  <SuiteVariantes
    eyebrow="Un solo modelo"
    titulo="Esto es lo que de verdad hay detrás de"
    resalte="“una blusa”."
    sub="Seis tallas en cuatro colores. Veinticuatro piezas distintas que comprar, guardar, contar y reponer — de un solo modelo. Y las que están en cero son justo las que te están pidiendo."
    ejeA={['XS', 'S', 'M', 'L', 'XL', 'XXL']}
    filas={[
      { nombre: 'Negro', img: '/images/blusa-negra.webp', alt: 'Blusa satinada negra' },
      { nombre: 'Vino', img: '/images/blusa-vino.webp', alt: 'Blusa satinada vino' },
      { nombre: 'Blanco', img: '/images/blusa-blanca.webp', alt: 'Blusa satinada blanca' },
      { nombre: 'Olivo', img: '/images/blusa-olivo.webp', alt: 'Blusa satinada verde olivo' },
    ]}
    matriz={[
      [2, 0, 0, 3, 5, 4],
      [1, 2, 0, 0, 4, 3],
      [3, 4, 1, 0, 2, 2],
      [2, 0, 0, 1, 3, 5],
    ]}
    unidad="piezas"
    genero="f"
    leyendas={['Con existencia', 'Quedan pocas', 'Agotada']}
  />

  <!-- ── La comparación que hace el propio visitante ── -->
  <SuiteCortina
    fotoAntes={cortinaModa.fotoAntes}
    fotoDespues={cortinaModa.fotoDespues}
    altAntes={cortinaModa.altAntes}
    altDespues={cortinaModa.altDespues}
    libreta={cortinaModa.libreta}
    filas={cortinaModa.filas}
  />

  <!-- ── Por qué lo que ya probó no le sirvió ── -->
  <SuiteProblemas />

  <!-- Salida: aquí muere la objeción de los dos caminos que ya probó -->
  <SuiteSalida frase="Si ya probaste un genérico y un desarrollo a la medida, la tercera conversación es distinta: esta ya sabe qué es una matriz de tallas." />

  <!-- ── Respiro fotográfico: la escala de la operación ── -->
  <SuiteCifras
    foto="/images/suite-moda-tienda.webp"
    alt="Tienda insignia de ropa de doble altura, con percheros, podios y un carro de cajas al fondo"
    frase="Desde una boutique hasta una cadena con centro de distribución."
    encuadre="center 38%"
    datos={[
      { n: 3000, pre: '+', rotulo: 'MARCAS ACTIVAS' },
      { n: 1, pos: ' semana', rotulo: 'PARA CAMBIARTE, SIN CERRAR UN DÍA' },
      { n: 24, pos: ' SKU', rotulo: 'DE UN MODELO, EN UN PASO' },
      { n: 4, pos: ' canales', rotulo: 'UN SOLO INVENTARIO' },
    ]}
  />






  <!-- Los cuatro momentos del año, con su escena -->
  <SuiteCasos
    eyebrow="Cuatro situaciones de siempre"
    titulo="Dónde te sirve, en concreto"
    sub="Las cuatro situaciones en las que una tienda de ropa gana o pierde el dinero. Toca cada una."
    casos={casosModa}
  />

  <!-- ── El recorrido de funcionalidades, con su panel pegajoso ── -->
  <SuiteScroll
    eyebrow="Suite Moda"
    titulo="Todo tu negocio de moda, físico y digital, en un solo lugar"
    intro="Baja para ver cada pieza. Todos los ejemplos son de una tienda de ropa real: la matriz de tallas y colores, la curva de compra por temporada y el cambio de talla en el mostrador. Y todo funciona igual en el probador que en tu tienda en línea, porque es el mismo inventario."
    secciones={seccionesRopa}
  />

  <!-- El bloque propio del giro: en moda la utilidad se decide al marcar -->
  <ModaMarcacion datos={marcacionModa} />

  <!-- Cómo se cambia sin cerrar -->
  <SuiteProceso
    titulo="Cambiar de sistema"
    resalte="sin cerrar la tienda."
    sub="Tienes tiendas operando y no puedes darte el lujo de parar una semana. Así se hace — y lo hacemos nosotros, no te dejamos un manual y suerte."
    pasos={pasosModa}
    remate="<b>Tu histórico no se tira.</b> Se migra lo que sirve —clientes, prendas, existencias— y lo demás queda consultable. Nunca te pedimos empezar de cero, porque nadie con cinco años de temporadas puede hacerlo."
  />

  <!-- Lo que todavía no se ha enseñado: que aquí cabe el negocio entero -->
  <SuiteIntegral
    eyebrow="Toda la operación, en un solo lugar"
    titulo="Y esto es solo lo que te enseñamos."
    resalte="Adentro cabe todo."
    sub="Una tienda de ropa no es solo el probador. Es lo que compras seis meses antes, lo que te queda al cierre de temporada, quién lo vendió y quién regresa. Las cuatro cosas viven en el mismo sistema — toca cada una."
    etapas={etapasModa}
    centro="Tu tienda"
    pie="<b>No son cuatro productos.</b> Son las cuatro cosas que tu tienda hace todos los días, en el mismo lugar y con los mismos datos: la prenda que se vendió en el probador ya descontó existencia, ya sumó puntos a la clienta, ya cuenta para la comisión de la vendedora y ya está en el reporte que abres el lunes."
  />

  <!-- ── El modelo comercial: la suite va dentro del plan ── -->
  <SuitePlanes suite="Suite de Moda" />

  <!-- Salida: quien se convence con el precio no debería tener que bajar más -->
  <SuiteSalida frase="Ya viste el precio. Lo que sigue es ver tu propia matriz de tallas en pantalla." cta="Agenda una demo" />

  <!-- El mismo cierre que la portada -->
  <CtaDudas demoDesc="Te mostramos SACS con tus modelos, tus tallas y tu venta real. 30 min, sin compromiso." />
</BaseLayout>

