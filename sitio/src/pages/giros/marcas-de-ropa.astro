---
/**
 * Suite para Tiendas de Ropa.
 *
 * Formato "suite": una sola pagina donde el panel se queda fijo y va cambiando
 * mientras el visitante baja. Sustituye a la version anterior de bloques
 * genericos (POS personalizable / multi-sucursal), que decia lo mismo que
 * cualquier otro giro.
 *
 * Regla de contenido: todo ejemplo es de ROPA. Tallas, colores, temporadas y
 * prendas con nombre. Ver src/data/suite-ropa.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import SuiteManifiesto from '../../components/suite/SuiteManifiesto.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { seccionesRopa } from '../../data/suite-ropa';

const titulo = 'Suite para Tiendas de Ropa';
const desc =
  'El sistema para boutiques y marcas de moda: matriz de tallas y colores, curvas de compra, consignación a departamentales y control de todas tus sucursales.';
---

<BaseLayout title={`${titulo} — SACS`} description={desc}>
  <!-- ── Portada: foto grande + alto contraste ── -->
  <header class="hero">
    <div class="hero-bg">
      <img
        src="/images/hero-moda-boutique.webp"
        alt="Vendedora atendiendo en una boutique junto a la terminal de punto de venta de SACS"
        width="1920" height="1280" fetchpriority="high" decoding="async"
      />
      <div class="hero-veil"></div>
    </div>

    <div class="hero-inner">
      <p class="hero-eyebrow">SACS · Suite Moda</p>
      <h1 class="hero-title">
        Tu tienda no vende<br /><span>productos.</span> Vende<br /><span>tallas y colores.</span>
      </h1>
      <p class="hero-sub">
        El sistema para boutiques y marcas de moda. Matriz de tallas, curvas de compra y
        consignación a departamentales, con un mismo inventario para tu piso de venta, tu
        tienda en línea, tus marketplaces y tu WhatsApp. Más agentes de IA que tú programas
        para que trabajen tu operación.
      </p>
      <div class="hero-cta">
        <a href="/contacto" class="btn-pri">Agenda una demo</a>
        <a href="/prueba-gratis" class="btn-sec">Prueba gratis</a>
      </div>
      <div class="hero-datos">
        <div><b>+3,000</b><span>marcas activas</span></div>
        <div><b>24 SKU</b><span>de un modelo, en un paso</span></div>
        <div><b>1 inventario</b><span>físico, en línea y WhatsApp</span></div>
        <div><b>11</b><span>funciones hechas para moda</span></div>
      </div>
    </div>
  </header>

  <!-- ── Manifiesto: aqui se demuestra que entendemos el giro ── -->
  <SuiteManifiesto
    intro="Sabemos cómo se vende la ropa"
    frases={[
      'La <b>M</b> se acabó el primer fin de semana.',
      'La <b>XXL</b> lleva dos temporadas colgada.',
      '"¿Tendrás esta en <b>chica</b>?" — y hay que llamar a la otra tienda.',
      'Vendiste <b>en línea</b> una talla que ya se había vendido en el mostrador.',
      'Tu clienta pregunta por <b>WhatsApp</b> y nadie sabe si eso sigue disponible.',
      'Dejaste 40 vestidos en una <b>departamental</b> y nadie sabe cuántos se vendieron.',
      'Compraste parejo de todas las tallas porque <b>así se ha hecho siempre</b>.',
    ]}
    cierre="Ningún sistema de abarrotes entiende esto. Y hoy ya no basta con entender el mostrador: tu tienda física, tu tienda en línea, tus marketplaces y tu WhatsApp son el mismo negocio, con el mismo inventario y la misma clienta. Esa es la nueva era del retail y es la que llevamos años construyendo: cada pantalla que sigue funciona igual en el piso de venta que en digital, y encima puedes poner agentes de IA — programados por ti — para que hagan el trabajo repetitivo."
  />

  <!-- ── Recorrido de funcionalidades ── -->
  <SuiteScroll
    eyebrow="Suite Moda"
    titulo="Todo tu negocio de ropa, físico y digital, en un solo lugar"
    intro="Baja para ver cada pieza. Todos los ejemplos son de una tienda de ropa real: tallas que se agotan, colores que nadie compra y prendas paradas de la temporada pasada. Y todo funciona igual en el mostrador que en tu tienda en línea, porque es el mismo inventario."
    secciones={seccionesRopa}
  />

  <FinalCTA />
</BaseLayout>

<style>
  /* El nav es fixed (71px). Sin padding-top el contenido se alinea abajo, crece
     mas que el viewport y el titulo termina DEBAJO de la barra: se veia cortado.
     El padding-top reserva esa franja y ademas deja respirar la foto arriba. */
  .hero {
    position: relative; min-height: 92vh; display: flex; align-items: flex-end;
    padding: 136px 24px 88px; overflow: hidden; background: #0A0A0B;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 56% 38%; }
  /* Velo DIRECCIONAL, en dos capas. Un velo parejo apagaba toda la foto y
     mataba el contraste que pide la portada. Aqui se oscurece el lado izquierdo
     (donde va el texto) y se deja brillar el derecho, que es justo donde estan
     la terminal y los percheros. La capa vertical solo asienta el pie. */
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(8,8,10,.94) 0%, rgba(8,8,10,.86) 26%, rgba(8,8,10,.55) 52%, rgba(8,8,10,.12) 76%, rgba(8,8,10,0) 100%),
      linear-gradient(180deg, rgba(8,8,10,.55) 0%, rgba(8,8,10,.12) 34%, rgba(8,8,10,.30) 72%, rgba(8,8,10,.78) 100%);
  }
  .hero-inner { position: relative; max-width: 1200px; margin: 0 auto; width: 100%; }
  .hero-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #60A5FA; margin: 0 0 20px;
  }
  .hero-title {
    font-size: clamp(38px, 7vw, 84px); font-weight: 800; letter-spacing: -2.6px;
    line-height: .98; margin: 0 0 24px; color: #fff; max-width: 16ch;
  }
  .hero-title span {
    background: linear-gradient(90deg, #60A5FA, #A78BFA);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-sub {
    font-size: clamp(16px, 1.8vw, 20px); line-height: 1.6; color: #D4D4D8;
    max-width: 56ch; margin: 0 0 34px;
  }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 52px; }
  .btn-pri, .btn-sec {
    display: inline-flex; align-items: center; justify-content: center;
    height: 54px; padding: 0 30px; border-radius: 12px;
    font-size: 16px; font-weight: 700; text-decoration: none; transition: all .16s ease;
  }
  .btn-pri { background: #2563EB; color: #fff; box-shadow: 0 6px 22px rgba(37,99,235,.42); }
  .btn-pri:hover { background: #1D4ED8; transform: translateY(-1px); }
  .btn-sec { background: rgba(255,255,255,.1); color: #fff; border: 1.5px solid rgba(255,255,255,.26); backdrop-filter: blur(6px); }
  .btn-sec:hover { background: rgba(255,255,255,.17); }
  .hero-datos {
    display: flex; gap: 44px; flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,.14); padding-top: 26px;
  }
  .hero-datos div { display: flex; flex-direction: column; gap: 3px; }
  .hero-datos b {
    font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; color: #fff; letter-spacing: -.6px;
  }
  .hero-datos span { font-size: 13px; color: #A1A1AA; font-weight: 600; }

  @media (max-width: 900px) {
    .hero { min-height: 88vh; padding: 104px 18px 56px; }
    .hero-bg img { object-position: 62% 32%; }
    /* En movil los 4 datos se acomodaban 2 + 1 + 1 porque "1 inventario" es
       ancho. Con grid quedan en una retícula 2x2 pareja. */
    .hero-datos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 18px; }
    .hero-datos b { font-size: 21px; }
    .hero-datos span { font-size: 12px; }
    .hero-cta { margin-bottom: 34px; }
  }
</style>
