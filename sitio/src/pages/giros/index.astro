---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { businessSectors } from '../../data/navigation';
import { giroIcons } from '../../data/giro-icons';
import { waDemoGiro, waLink } from '../../lib/whatsapp';
import { girosCasos } from '../../data/giros-casos';

// Los giros salen del MISMO arreglo que alimenta el mega-menú, así que agregar
// un giro allá lo publica aquí sin tocar esta página. Desde el giro moda-first
// (2026-08), los giros de moda encabezan la página y el resto se agrupa abajo.
const giros = businessSectors.filter((g) => g.moda); // Solo moda (Aaron, 14-sep-2026): el sitio es Fashion Commerce
const grupos = [
  {
    id: 'moda',
    titulo: 'Ropa, calzado y joyería',
    sub: 'Cada giro con sus propias personalizaciones: tallas, curvas, apartados, consignación y temporadas.',
    lista: businessSectors.filter((g) => g.moda),
  },
];

const waGenerico = waLink('¡Hola! Quiero agendar una demo en línea de Sacscloud para mi negocio.');
// El de "¿no ves tu giro?" deja la frase abierta a propósito: el prospecto
// completa su giro en el mismo mensaje y el asesor abre con esa información.
const waOtroGiro = waLink('¡Hola! Quiero agendar una demo en línea de Sacscloud. Mi giro es: ');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Giros de negocio que atiende SACS',
  itemListElement: giros.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.label,
    description: g.description,
    url: `https://www.sacscloud.com${g.href}`,
  })),
};
---

<BaseLayout
  title="Giros de negocio — SACS"
  description="SACS se configura para tu giro: ropa, zapaterías, joyerías, farmacias, ferreterías, minisúpers y más. Cada giro con sus propias personalizaciones."
  structuredData={structuredData}
>
  <section class="giros-hero">
    <div class="container giros-hero-inner">
      <span class="giros-eyebrow">Hecho a la medida de tu giro</span>
      <h1 class="giros-title">Un punto de venta que ya entiende tu negocio.</h1>
      <p class="giros-sub">
        No es el mismo sistema con otro logo. Cada giro trae sus propias personalizaciones —
        variantes, unidades, caducidades, temporadas— configuradas desde el primer día.
      </p>
      <div class="giros-hero-ctas">
        <a href={waGenerico} class="gh-btn gh-btn-wa" target="_blank" rel="noopener noreferrer" data-giro="Genérico" data-giro-contexto="hero-giros">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Agenda una demo en línea
        </a>
        <a href="/prueba-gratis" class="gh-btn gh-btn-outline">Prueba 7 días gratis</a>
      </div>
      <p class="giros-count">{giros.length} giros de moda con configuración propia</p>
    </div>
  </section>

  <section class="giros-grid-section">
    <div class="container">
      {grupos.map((grupo) => (
      <div class="giros-grupo">
      <div class="giros-grupo-head">
        <h2 class="giros-grupo-titulo">{grupo.titulo}</h2>
        <p class="giros-grupo-sub">{grupo.sub}</p>
      </div>
      <div class="giros-grid">
        {grupo.lista.map((g) => { const c = girosCasos[g.href]; return (
          <a href={g.href} class="giro-card" style={`--accent:${g.color}; --accent-bg:${g.bgColor};`} data-giro={g.label}>
            <div class="giro-card-media">
              <img src={c ? `/images/giros/${c.file}.webp` : g.image} alt={`Sacs para ${g.label}`} loading="lazy" decoding="async" width="960" height="640" />
            </div>
            <div class="giro-card-body">
              <h3 class="giro-card-title">{g.label}</h3>
              <p class="giro-card-caso">{c ? c.caso : g.description}</p>
              {c && <p class="giro-card-que"><span>Con Sacs</span>{c.que}</p>}
              <span class="giro-card-link">Ver cómo funciona para {g.label.toLowerCase()}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ); })}
      </div>
      </div>
      ))}
    </div>
  </section>

  <section class="giros-cta">
    <div class="container giros-cta-inner">
      <h2 class="giros-cta-title">¿No ves tu giro?</h2>
      <p class="giros-cta-sub">
        Si vendes moda, calzado o accesorios con otro formato (showroom, venta por catálogo, marca propia con maquila),
        cuéntanos cómo trabajas y te mostramos en vivo cómo quedaría configurado.
      </p>
      <a href={waOtroGiro} class="gh-btn gh-btn-wa" target="_blank" rel="noopener noreferrer" data-giro="Otro" data-giro-contexto="no-veo-mi-giro">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Cuéntanos tu giro por WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>


<style>
  /* ─── Hero ─── */
  .giros-hero {
    padding: 140px 0 56px;
    background: var(--color-bg-primary, #FAFAF8);
  }

  .giros-hero-inner {
    max-width: 760px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .giros-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-tertiary, #9ca3af);
  }

  .giros-title {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 5.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-text-primary);
    margin: 0;
  }

  .giros-sub {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .giros-hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
    width: 100%;
    max-width: 340px;
  }

  @media (min-width: 560px) {
    .giros-hero-ctas {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
  }

  .gh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 15px 26px;
    border-radius: 12px;
    text-decoration: none;
    line-height: 1;
    transition: all 0.2s ease;
  }

  .gh-btn-wa {
    background: #0B7A43;
    color: #fff;
  }

  .gh-btn-wa:hover {
    background: #1EBE5A;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.3);
    text-decoration: none;
    color: #fff;
  }

  .gh-btn-outline {
    background: transparent;
    color: var(--color-text-primary);
    border: 1.5px solid rgba(0, 0, 0, 0.15);
  }

  .gh-btn-outline:hover {
    border-color: rgba(0, 0, 0, 0.3);
    text-decoration: none;
  }

  .giros-count {
    font-size: 0.8125rem;
    color: var(--color-text-tertiary, #9ca3af);
    margin: 4px 0 0;
  }

  /* ─── Grid ─── */
  .giros-grid-section {
    padding: 24px 0 96px;
    background: var(--color-bg-primary, #FAFAF8);
  }

  .giros-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .giro-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 18px;
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .giro-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.07);
  }

  .giro-card-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--accent-bg);
  }

  .giro-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .giro-card:hover .giro-card-media img {
    transform: scale(1.04);
  }

  .giro-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 22px;
  }

  .giro-card-head {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    margin-bottom: 18px;
  }

  .giro-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 11px;
    background: var(--accent-bg);
    color: var(--accent);
  }

  .giro-card-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .giro-card-titles {
    min-width: 0;
  }

  .giro-card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 3px;
  }

  .giro-card-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .giro-card-title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .giro-card-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .giro-card-list {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .giro-card-list li {
    position: relative;
    padding-left: 15px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .giro-card-dot {
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .giro-card-list-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .giro-card-list-desc {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .giro-card-more {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-tertiary, #9ca3af);
    margin-bottom: 18px;
  }

  .giro-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .giro-card-wa {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 15px;
    border-radius: 9px;
    background: #0B7A43;
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .giro-card-wa:hover {
    background: #1EBE5A;
    color: #fff;
    text-decoration: none;
  }

  .giro-card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-texto, #3A62C4);
    text-decoration: none;
    transition: gap 0.18s ease;
  }

  .giro-card-link:hover {
    gap: 9px;
    text-decoration: none;
  }

  /* ─── CTA final ─── */
  .giros-cta {
    padding: 0 0 110px;
    background: var(--color-bg-primary, #FAFAF8);
  }

  .giros-cta-inner {
    max-width: 640px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-top: 56px;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
  }

  .giros-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .giros-cta-sub {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }
  .giros-grupo { margin-bottom: 56px; }
  .giros-grupo:last-child { margin-bottom: 0; }
  .giros-grupo-head { margin-bottom: 24px; }
  .giros-grupo-titulo { font-family: var(--font-display); font-size: clamp(1.375rem, 2.4vw, 1.75rem); font-weight: 700; color: var(--color-text-primary); }
  .giros-grupo-sub { margin-top: 6px; font-size: 0.9688rem; color: var(--color-text-secondary); }

  /* ── Tarjetas grandes (14-sep-2026): foto, caso de uso y qué hace Sacs ── */
  .giros-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .giro-card { display: flex; flex-direction: column; background: #fff; border: 1px solid #ECECE9; border-radius: 20px; overflow: hidden; text-decoration: none; color: #1D1D1F; transition: transform 0.35s cubic-bezier(0.2,0.7,0.2,1), box-shadow 0.35s; }
  .giro-card:hover { transform: translateY(-4px); box-shadow: 0 24px 60px -24px rgba(0,0,0,0.25); }
  .giro-card-media { aspect-ratio: 3 / 2; overflow: hidden; background: #F4F4F2; }
  .giro-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.9s cubic-bezier(0.2,0.7,0.2,1); }
  .giro-card:hover .giro-card-media img { transform: scale(1.04); }
  .giro-card-body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 10px; }
  .giro-card-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .giro-card-caso { font-size: 16px; line-height: 1.45; color: #1D1D1F; margin: 0; }
  .giro-card-que { font-size: 14px; line-height: 1.45; color: #6B6B68; margin: 0; padding-top: 10px; border-top: 1px solid #ECECE9; }
  .giro-card-que span { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: color-mix(in srgb, var(--accent, #4B7BE5) 70%, #000); margin-right: 8px; }
  .giro-card-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 14px; font-weight: 600; color: var(--color-primary-texto, #3A62C4); }
  @media (max-width: 1023px) { .giros-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
  @media (max-width: 640px) { .giros-grid { grid-template-columns: 1fr; } .giro-card-body { padding: 16px 18px 18px; } .giro-card-title { font-size: 20px; } }
</style>
