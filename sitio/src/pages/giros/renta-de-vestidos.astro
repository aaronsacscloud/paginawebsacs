---
/**
 * Landing RENTA DE VESTIDOS Y TRAJES (17-sep-2026). Misma estructura que marcas-de-ropa.astro; el
 * contenido vive en src/data/giros/renta-de-vestidos.ts y el bloque propio es ReCalendario ("El
 * calendario de cada vestido").
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GiroEnlaces from '../../components/giros/GiroEnlaces.astro';
import { servicioGiro } from '../../data/entidad';
import { breadcrumbGiro } from '../../lib/breadcrumb';
import GiroBanner from '../../components/giros/GiroBanner.astro';
import SuiteManifiesto from '../../components/suite/SuiteManifiesto.astro';
import SuiteVariantes from '../../components/suite/SuiteVariantes.astro';
import SuiteCortina from '../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../components/suite/SuiteProblemas.astro';
import SuiteSalida from '../../components/suite/SuiteSalida.astro';
import SuiteCifras from '../../components/suite/SuiteCifras.astro';
import SuiteCasos from '../../components/suite/SuiteCasos.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import SuitePlano from '../../components/suite/SuitePlano.astro';
import SuiteProceso from '../../components/suite/SuiteProceso.astro';
import SuitePlanes from '../../components/suite/SuitePlanes.astro';
import CtaDudas from '../../components/CtaDudas.astro';
import ReCalendario from '../../components/giros/ReCalendario.astro';
import GiroEscala from '../../components/giros/GiroEscala.astro';
import { bannerRE, manifiestoRE, variantesRE, cortinaRE, casosRE, seccionesRE, planoRE, pasosRE, ticketRE, escalaRE, problemasRE, cifrasRE } from '../../data/giros/renta-de-vestidos';
---
<BaseLayout
  title="Sistema para renta de vestidos y trajes — Sacs"
  description="Sistema para renta de vestidos y trajes: calendario por vestido con días de lavado, apartado amarrado a la fecha, depósito con foto de entrega y devolución."
  structuredData={[servicioGiro('/giros/renta-de-vestidos'), breadcrumbGiro('/giros/renta-de-vestidos')]}
>
  <GiroBanner eyebrow={bannerRE.eyebrow} titulo={bannerRE.titulo} resalte={bannerRE.resalte} sub={bannerRE.sub} foto={bannerRE.foto} fotoAlt={bannerRE.fotoAlt} avisos={bannerRE.avisos} selloMarcas="negocios de moda y fiesta en México y Latam" />

  <SuiteManifiesto intro={manifiestoRE.intro} frases={manifiestoRE.frases} cierre={manifiestoRE.cierre} />

  <SuiteVariantes eyebrow={variantesRE.eyebrow} titulo={variantesRE.titulo} resalte={variantesRE.resalte} sub={variantesRE.sub} ejeA={variantesRE.ejeA} filas={variantesRE.filas} matriz={variantesRE.matriz} unidad={variantesRE.unidad} genero={variantesRE.genero} umbralBajo={variantesRE.umbralBajo} leyendas={variantesRE.leyendas} remate={variantesRE.remate} />

  <SuiteCortina titulo={cortinaRE.titulo} pieAntes={cortinaRE.pieAntes} fotoAntes={cortinaRE.fotoAntes} fotoDespues={cortinaRE.fotoDespues} altAntes={cortinaRE.altAntes} altDespues={cortinaRE.altDespues} libreta={cortinaRE.libreta} filas={cortinaRE.filas} pieDespues={cortinaRE.pieDespues} />

  <SuiteProblemas colGenerico="Sistema de ropa" entrada={problemasRE.entrada} quienes={problemasRE.quienes} doc1={problemasRE.doc1} doc2={problemasRE.doc2} filas={problemasRE.filas} />

  <SuiteSalida frase="Si ya probaste un sistema de ropa y un desarrollo a la medida, la tercera conversación es distinta: esta ya sabe que el vestido tiene fecha." />

  <SuiteCifras foto={cifrasRE.foto} alt={cifrasRE.alt} frase={cifrasRE.frase} encuadre={cifrasRE.encuadre} datos={[
    { n: 3000, pre: '+', rotulo: 'NEGOCIOS DE MODA Y FIESTA' },
    { n: 7600, pre: '+$', rotulo: 'MILLONES TRANSACCIONADOS' },
    { n: 20, pos: '+', rotulo: 'PERSONAS DE SOPORTE, EN MÉXICO' },
    { n: 1, pre: '#', rotulo: 'EN RETAIL ESPECIALIZADO' },
  ]} />

  <SuiteCasos eyebrow="Cuatro momentos del año" titulo="Dónde te sirve, en concreto" sub="Los cuatro momentos del año en que una boutique de renta gana o pierde el dinero. Toca cada uno." casos={casosRE} />

  <SuiteScroll eyebrow="Renta de vestidos y trajes" titulo="El calendario, el mostrador, el taller y el WhatsApp, con las mismas piezas" intro="Baja para ver cada pieza. Todos los ejemplos son de una boutique de renta real: el calendario del vestido, el apartado con anticipo, el depósito, la cola de la costurera y el chat que contesta si está disponible." secciones={seccionesRE} />

  <ReCalendario />

  <GiroEscala encabezado="Tu tamaño" titulo="De la boutique de la colonia a la cadena con taller central." descripcion="El negocio cambia con cada tamaño: quién lleva el calendario, dónde está cada vestido, quién cose y qué mira la dirección. Elige el tuyo." niveles={escalaRE} />

  <SuitePlano titulo="Tu tienda, por dentro." sub="Entra la quinceañera con su mamá, ven el aparador, recorren los rieles por color, se prueban frente al espejo, apartan en el mostrador y se van. Atrás, el taller cose, suelta el ajuste y recibe lo que vuelve del lavado. Toca cada zona y mira qué hace Sacs ahí." proyecto="Tu boutique de renta — planta baja" zonas={planoRE} todoRot="Renta de vestidos y trajes" />

  <SuiteProceso titulo="Cambiar de sistema" resalte="sin cerrar la tienda." sub="Tienes junio o diciembre encima y no puedes parar una semana. Así se hace, y lo hacemos nosotros: no te dejamos un manual y suerte." pasos={pasosRE} lineas={ticketRE.lineas} total={ticketRE.total} remate="<b>Tu histórico no se tira.</b> Se migra lo que sirve: cada vestido con sus rentas, las fechas ya apartadas, los depósitos en garantía y las clientas con sus fechas. Nunca te pedimos empezar de cero antes de junio." />

  <SuitePlanes suite="Suite de Moda" />

  <SuiteSalida frase="Ya viste el precio. Lo que sigue es ver el calendario de tu propio vestido más pedido en pantalla." cta="Agenda una demo" />

  <GiroEnlaces giro="renta-de-vestidos" />

  <CtaDudas demoDesc="Te mostramos Sacs con tus vestidos, tus fechas de junio y tu lunes de devoluciones real. 30 min, sin compromiso." />
</BaseLayout>
