---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { businessSectors } from '../../data/navigation';
import { giroIcons } from '../../data/giro-icons';
import { waDemoGiro } from '../../lib/whatsapp';

interface Props {
  title: string;
  giro: string;
  description: string;
  color?: string;
}

const { title, giro, description, color = '#4B7BE5' } = Astro.props;

// El giro se resuelve por la ruta, así que la página hereda del menú sus
// especialidades, su ícono y su color sin repetir el contenido aquí.
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const sector = businessSectors.find((s) => s.href.endsWith(`/${slug}`));

const icon = sector ? giroIcons[sector.iconId] : '';
const accent = sector?.color ?? color;
const waHref = waDemoGiro(sector?.label ?? giro, sector?.description ?? description);
const especialidades = sector?.personalizations ?? [];
---

<BaseLayout title={`${giro} — SACS`} description={description}>
  <section class="giro-cs" style={`--accent:${accent};`}>
    <div class="giro-cs-inner container">
      <header class="giro-cs-head">
        {icon && <span class="giro-cs-icon" set:html={icon} />}
        <span class="giro-cs-eyebrow">SACS para {giro}</span>
        <h1 class="giro-cs-title">{sector?.description ?? title}</h1>
        <p class="giro-cs-subtitle">{description}</p>
        <div class="giro-cs-ctas">
          <a
            href={waHref}
            class="cs-btn cs-btn-wa"
            data-giro-contexto="pagina-giro"
            target="_blank"
            rel="noopener noreferrer"
            data-giro={giro}
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Agenda una demo de {giro}
          </a>
          <a href="/prueba-gratis" class="cs-btn cs-btn-outline">Prueba 7 días gratis</a>
        </div>
      </header>

      {especialidades.length > 0 && (
        <div class="giro-cs-especialidades">
          <h2 class="giro-cs-h2">Lo que SACS hace distinto para {giro.toLowerCase()}</h2>
          <div class="giro-cs-grid">
            {especialidades.map((p) => (
              <div class="giro-cs-item">
                <span class="giro-cs-dot" aria-hidden="true"></span>
                <span class="giro-cs-item-label">{p.label}</span>
                <span class="giro-cs-item-desc">{p.description}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="giro-cs-foot">
        <p class="giro-cs-note">
          Estamos preparando la página completa de <strong>{giro.toLowerCase()}</strong> con casos, precios y demo interactiva.
          Mientras tanto, un asesor te muestra en vivo cómo queda configurado para tu giro.
        </p>
        <div class="giro-cs-foot-links">
          <a href="/giros" class="giro-cs-link">Ver todos los giros</a>
          <span class="giro-cs-sep" aria-hidden="true">·</span>
          <a href="/contacto" class="giro-cs-link">Hablar con ventas</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .giro-cs {
    padding: 140px 0 100px;
    background: var(--color-bg-primary, #FAFAF8);
  }

  .giro-cs-inner {
    max-width: 940px;
  }

  .giro-cs-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .giro-cs-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: #fff;
    color: var(--accent);
    border: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    margin-bottom: 4px;
  }

  .giro-cs-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .giro-cs-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .giro-cs-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    line-height: 1.05;
    margin: 0;
  }

  .giro-cs-subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0;
  }

  .giro-cs-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 14px;
    width: 100%;
    max-width: 340px;
  }

  @media (min-width: 560px) {
    .giro-cs-ctas {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
  }

  .cs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 15px 26px;
    border-radius: 12px;
    text-decoration: none;
    text-align: center;
    line-height: 1;
    transition: all 0.2s ease;
  }

  .cs-btn-wa {
    background: #25D366;
    color: #fff;
  }

  .cs-btn-wa:hover {
    background: #1EBE5A;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.3);
    text-decoration: none;
    color: #fff;
  }

  .cs-btn-outline {
    background: transparent;
    color: var(--color-text-primary);
    border: 1.5px solid rgba(0, 0, 0, 0.15);
  }

  .cs-btn-outline:hover {
    border-color: rgba(0, 0, 0, 0.3);
    text-decoration: none;
  }

  .giro-cs-especialidades {
    margin-top: 72px;
  }

  .giro-cs-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    text-align: center;
    margin: 0 0 36px;
  }

  .giro-cs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 26px 32px;
  }

  .giro-cs-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 16px;
    position: relative;
  }

  .giro-cs-dot {
    position: absolute;
    left: 0;
    top: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .giro-cs-item-label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .giro-cs-item-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .giro-cs-foot {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
    text-align: center;
  }

  .giro-cs-note {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 620px;
    margin: 0 auto 16px;
  }

  .giro-cs-note strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .giro-cs-foot-links {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
  }

  .giro-cs-link {
    font-weight: 600;
    color: var(--color-primary, #4B7BE5);
    text-decoration: none;
  }

  .giro-cs-link:hover {
    text-decoration: underline;
  }

  .giro-cs-sep {
    color: var(--color-text-tertiary, #9ca3af);
  }
</style>
