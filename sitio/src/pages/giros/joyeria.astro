---
/**
 * Suite para Joyerías.
 *
 * Mismos bloques base, contenido 100% del giro. Lo que cambia el argumento
 * entero: aquí el producto no tiene precio fijo — vale lo que pesa por lo que
 * vale el gramo hoy. El SKU es modelo × metal × pureza y la unidad es el gramo.
 *
 * Bloque propio: el simulador del colchón del fino. Fuera de una joyería no
 * significa nada.
 *
 * OJO: la Suite Joyería es un complemento que se cotiza aparte, no viene dentro
 * de los cuatro planes — por eso SuitePlanes va en modo "complemento".
 *
 * Todo el contenido vive en src/data/giros/joyeria.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import SuiteManifiesto from '../../components/suite/SuiteManifiesto.astro';
import JoyGramo from '../../components/giros/JoyGramo.astro';
import SuiteCortina from '../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../components/suite/SuiteProblemas.astro';
import SuiteCasos from '../../components/suite/SuiteCasos.astro';
import SuiteSalida from '../../components/suite/SuiteSalida.astro';
import SuiteCifras from '../../components/suite/SuiteCifras.astro';
import JoyColchon from '../../components/giros/JoyColchon.astro';
import SuiteDireccion from '../../components/suite/SuiteDireccion.astro';
import SuiteMigracion from '../../components/suite/SuiteMigracion.astro';
import SuiteFormal from '../../components/suite/SuiteFormal.astro';
import SuitePlanes from '../../components/suite/SuitePlanes.astro';
import SuiteEnsamble from '../../components/suite/SuiteEnsamble.astro';
import PosMock from '../../components/suite/PosMock.astro';
import {
  seccionesJoyeria, casosJoyeria, cortinaJoyeria, sucursalesJoyeria,
  reglasJoyeria, diasJoyeria, cajaJoyeria, documentosJoyeria,
} from '../../data/giros/joyeria';

const titulo = 'Suite para Joyerías';
const desc =
  'El sistema para joyerías: precio por gramo con tu colchón del fino, factor por quilataje, costo histórico inmutable, repreciar en masa y apartados con precio congelado.';
---

<BaseLayout title={`${titulo} — SACS`} description={desc}>
  <!-- ── Portada: el sistema es el fondo ── -->
  <header class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-pos">
        <PosMock
          cajero="Lorena"
          caja="Matriz Centro"
          cliente="JORGE C."
          puntos="4,860 pts"
          tiles={[
            { t: 'Anillo 14K', c: '#C9A227' },
            { t: 'Cadena 10K', c: '#B8912B' },
            { t: 'Esclava 14K', c: '#D4B24C' },
            { t: 'Aretes oro blanco', c: '#9AA3B0' },
            { t: 'Dije y medalla', c: '#C08F3E' },
            { t: 'Plata .925', c: '#8A94A3' },
            { t: 'Bridal', c: '#6B5B8A' },
            { t: 'Reloj de marca', c: '#3F3F46' },
            { t: 'Compostura', c: '#5B87C4' },
            { t: 'Estuches', c: '#7A6A4E' },
          ]}
          lineas={[
            { nombre: 'Anillo solitario 14K', detalle: 'Talla 7 · 3.2 g netos', cant: 1, precio: '14,850.00' },
            { nombre: 'Grabado', detalle: 'Interior, 12 caracteres', cant: 1, precio: '350.00' },
          ]}
          subtotal="$13,103.45"
          iva="$2,096.55"
          total="$15,200.00"
          articulos="2 ARTÍCULOS · 1 PIEZA"
        />
      </div>
      <div class="hero-veil"></div>
    </div>

    <div class="hero-inner">
      <p class="hero-eyebrow">SACS · Suite Joyería</p>
      <h1 class="hero-title">
        Tu vitrina no vende<br /><span>piezas.</span> Vende<br /><span>gramos.</span>
      </h1>
      <p class="hero-sub">
        El sistema para joyerías. Tu precio del gramo de fino, el factor por quilataje que usa
        tu casa, el costo histórico que no se mueve y repreciar cientos de piezas viendo antes
        qué cambia — con un mismo inventario para tu piso, tu tienda en línea y tu WhatsApp.
      </p>
      <div class="hero-cta">
        <a href="/contacto" class="btn-pri">Agenda una demo</a>
        <a href="/prueba-gratis" class="btn-sec">Prueba gratis</a>
      </div>

      <div class="hero-datos">
        <div><b>+3,000</b><span>negocios activos</span></div>
        <div><b>3</b><span>quilatajes con su propio factor</span></div>
        <div><b>1 precio</b><span>del gramo para toda la casa</span></div>
        <div><b>0</b><span>precios que se mueven solos</span></div>
      </div>
    </div>
  </header>

  <!-- ── Aquí se demuestra que entendemos el giro ── -->
  <SuiteManifiesto
    intro="Sabemos cómo se vende el oro"
    frases={[
      'El oro subió en marzo y la vitrina sigue con el precio de <b>agosto pasado</b>.',
      'Dos anillos del mismo modelo, <b>uno pesa 2.4 y otro 3.1</b>.',
      'Reetiquetar cuatro mil piezas son <b>tres días con la tienda cerrada</b>.',
      'La esclava te la dejaron a un precio en enero y a otro en junio: <b>¿ganaste o te vendiste barato?</b>',
      'La hoja de cálculo del costeo <b>solo la entiende el dueño</b>.',
    ]}
    cierre="Ningún sistema genérico entiende esto: aquí el producto no tiene precio fijo. Vale lo que pesa por lo que vale el gramo, y el gramo lo decides tú — no el mercado. Dos piezas del mismo modelo no valen lo mismo porque no pesan lo mismo, y el costo con el que compraste ese metal no puede cambiar cuando el oro se mueve. Cada pantalla que sigue está hecha con esa lógica."
  />

  <!-- ── El momento fuerte: la corrida en 3D ── -->
  <!-- ── La animación propia de este giro: el gramo que se reparte.
       El cubo de tallas × colores diría lo mismo en cualquier boutique;
       el gramo solo significa algo donde la materia prima cotiza. ── -->
  <JoyGramo />
detrás de"
    resalte="“un anillo de oro”"
    sub="Ocho tallas por tres quilatajes, en tres sucursales. Y cada casilla pesa distinto: la talla 12 lleva un tercio más de oro que la 5. Mismo modelo, otro costo y otro precio."
    matriz={[
      [2, 3, 4, 3, 2, 1, 0, 0],
      [1, 4, 6, 5, 3, 2, 1, 0],
      [0, 1, 2, 2, 1, 0, 0, 0],
    ]}
    ejeA={['5', '6', '7', '8', '9', '10', '11', '12']}
    ejeB={['Oro 10K', 'Oro 14K', 'Oro 18K']}
    capas={3}
    leyendas={['En vitrina', 'Última pieza', 'Sin existencia']}
  />

  <!-- ── La comparación que hace el propio visitante ── -->
  <SuiteCortina
    eyebrow={cortinaJoyeria.eyebrow}
    titulo={cortinaJoyeria.titulo}
    sub={cortinaJoyeria.sub}
    fotoAntes={cortinaJoyeria.fotoAntes}
    fotoDespues={cortinaJoyeria.fotoDespues}
    altAntes={cortinaJoyeria.altAntes}
    altDespues={cortinaJoyeria.altDespues}
    libreta={cortinaJoyeria.libreta}
    pieAntes={cortinaJoyeria.pieAntes}
    filas={cortinaJoyeria.filas}
    pieDespues={cortinaJoyeria.pieDespues}
  />

  <!-- ── Por qué no le sirvió lo que ya probó ── -->
  <SuiteProblemas
    titulo={documentosJoyeria.titulo}
    entrada={documentosJoyeria.entrada}
    doc1={documentosJoyeria.doc1}
    doc2={documentosJoyeria.doc2}
    filas={documentosJoyeria.filas}
  />

  <!-- Salida: aquí muere la objeción de los dos caminos que ya probó -->
  <SuiteSalida frase="Si tu sistema no sabe qué es un factor por quilataje, no es cosa de configurarlo: no está hecho para joyería." />

  <!-- ── Respiro fotográfico: la escala ── -->
  <SuiteCifras
    foto="/images/suite-joy-tienda.webp"
    alt="Joyería insignia con vitrinas iluminadas y muro de ónix retroiluminado"
    frase="De una vitrina a una casa con varias sucursales y un solo precio del gramo."
    encuadre="center 40%"
    datos={[
      { n: 3000, pre: '+', rotulo: 'NEGOCIOS ACTIVOS EN SACS' },
      { n: 3, rotulo: 'QUILATAJES, CADA UNO CON SU FACTOR' },
      { n: 5, pos: ' días', rotulo: 'PARA ARRANCAR, SIN CERRAR' },
    ]}
  />

  <!-- ── Momentos reales, con su escena ── -->
  <SuiteCasos
    eyebrow="Cuatro momentos del año"
    titulo="Dónde te sirve, en momentos concretos"
    sub="No son funciones: son los cuatro momentos en los que una joyería gana o pierde dinero. Toca cada uno."
    casos={casosJoyeria}
  />

  <!-- Salida: el visitante acaba de reconocer su propio mostrador -->
  <SuiteSalida frase="Te lo mostramos con tu colchón, tus quilatajes y tus piezas — no con los de la demo." cta="Ver una demo con mi catálogo" />

  <!-- ── Recorrido de funcionalidades ── -->
  <SuiteScroll
    eyebrow="Suite Joyería"
    titulo="Todo tu negocio de joyería, físico y digital, en un solo lugar"
    intro="Baja para ver cada pieza. Todos los ejemplos son de una joyería real: el precio del gramo, el factor por quilataje, el costo que no se mueve y los apartados que llevan meses. Y todo funciona igual en el mostrador que en tu tienda en línea, porque es el mismo inventario."
    secciones={seccionesJoyeria}
  />

  <!-- ── El complemento propio de este giro: el colchón del fino ── -->
  <JoyColchon />

  <!-- ── Lo que ve el dueño ── -->
  <SuiteDireccion
    sub="Tus vitrinas abren sin ti. La pregunta no es si venden — es cuál se quedó con el colchón viejo, y por dónde se te va el margen cuando alguien regatea sin permiso."
    sucursales={sucursalesJoyeria}
    reglas={reglasJoyeria}
  />

  <!-- ── Cómo se cambia sin parar ── -->
  <SuiteMigracion dias={diasJoyeria} lineas={cajaJoyeria.lineas} total={cajaJoyeria.total} />

  <!-- ── La factura ── -->
  <SuiteFormal
    sub="El cliente pide factura por la pieza que acaba de comprar y se emite ahí mismo, con la venta abierta. Nadie anota el RFC en una libreta para capturarlo en la noche."
    receptor="JORGE C."
  />

  <!-- ── El modelo comercial ── -->
  <SuitePlanes suite="Suite Joyería" comoSeVende="complemento" />

  <!-- Salida: quien se convence con el precio no debería tener que
       bajar dos pantallas y media de animación para hacer clic -->
  <SuiteSalida frase="Ya viste cómo se cotiza. Lo que sigue es ver tu propio colchón del gramo en pantalla." cta="Agenda una demo" />

  <!-- ── Cierre ── -->
  <SuiteEnsamble giro="tu joyería" suyo="tu precio del gramo, tus factores, tus piezas" />
</BaseLayout>

<style>
  /* El nav es fixed (71px): sin padding-top el título queda debajo de la barra. */
  .hero {
    position: relative; min-height: 92vh; display: flex; align-items: flex-end;
    padding: 136px 24px 88px; overflow: hidden; background: #0A0A0B;
  }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; }
  .hero-bg::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(80% 70% at 76% 46%, rgba(37,99,235,.2) 0%, rgba(10,10,11,0) 62%);
  }
  .hero-veil {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg,
      rgba(8,8,10,.97) 0%, rgba(8,8,10,.95) 28%, rgba(8,8,10,.62) 45%,
      rgba(8,8,10,.16) 57%, rgba(8,8,10,0) 68%);
  }
  .hero-inner { position: relative; max-width: 1200px; margin: 0 auto; width: 100%; }
  .hero-eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: #60A5FA; margin: 0 0 20px;
  }
  .hero-title {
    font-size: clamp(38px, 7vw, 84px); font-weight: 800; letter-spacing: -2.6px;
    line-height: .98; margin: 0 0 24px; color: #fff; max-width: 16ch;
  }
  .hero-title span { color: #4B7BE5; }
  .hero-sub {
    font-size: clamp(16px, 1.8vw, 20px); line-height: 1.6; color: #D4D4D8;
    max-width: 56ch; margin: 0 0 34px;
  }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 52px; }
  .btn-pri, .btn-sec {
    display: inline-flex; align-items: center; justify-content: center;
    height: 54px; padding: 0 30px; border-radius: 12px;
    font-size: 16px; font-weight: 700; text-decoration: none; transition: all .16s ease;
  }
  .btn-pri { background: #2563EB; color: #fff; box-shadow: 0 6px 22px rgba(37,99,235,.42); }
  .btn-pri:hover { background: #1D4ED8; transform: translateY(-1px); }
  .btn-sec { background: rgba(255,255,255,.1); color: #fff; border: 1.5px solid rgba(255,255,255,.26); backdrop-filter: blur(6px); }
  .btn-sec:hover { background: rgba(255,255,255,.17); }
  .hero-datos {
    display: flex; gap: 44px; flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,.14); padding-top: 26px;
  }
  .hero-datos div { display: flex; flex-direction: column; gap: 3px; }
  .hero-datos b {
    font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; color: #fff; letter-spacing: -.6px;
  }
  .hero-datos span { font-size: 13px; color: #A1A1AA; font-weight: 600; }

  /* El punto de venta se dibuja a 980 px y se escala: nítido en cualquier
     pantalla y sin depender de una captura que envejece. */
  .hero-pos {
    position: absolute; right: -13%; top: 50%;
    transform: translateY(-46%) scale(.86); transform-origin: right center;
    filter: drop-shadow(0 40px 90px rgba(0,0,0,.65));
    opacity: 0; animation: posEntra 1s cubic-bezier(.16,1,.3,1) .25s forwards;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.35) 12%, #000 30%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.35) 12%, #000 30%);
  }
  @keyframes posEntra {
    from { opacity: 0; transform: translateY(-46%) scale(.84) translateX(34px); }
    to   { opacity: 1; transform: translateY(-46%) scale(.86); }
  }
  @media (min-width: 1600px) { .hero-pos { right: -8%; transform: translateY(-46%) scale(.95); } }
  @media (max-width: 1440px) { .hero-pos { right: -26%; transform: translateY(-46%) scale(.78); } }
  @media (min-width: 1181px) {
    .hero-sub { max-width: 44ch; }
    .hero-title { font-size: clamp(38px, 5vw, 66px); letter-spacing: -2px; }
  }
  @media (max-width: 1180px) {
    .hero-pos { right: -44%; transform: translateY(-44%) scale(.74); opacity: .3; animation: none; }
  }
  @media (max-width: 760px) { .hero-pos { display: none; } }

  @media (max-width: 900px) {
    .hero { min-height: 88vh; padding: 104px 18px 56px; }
    .hero-datos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 18px; }
    .hero-datos b { font-size: 21px; }
    .hero-datos span { font-size: 12px; }
    .hero-cta { margin-bottom: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-pos { opacity: 1; animation: none; }
  }
</style>
