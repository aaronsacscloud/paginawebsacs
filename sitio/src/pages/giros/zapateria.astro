---
/**
 * Suite para Zapaterías.
 *
 * Misma estructura que la de moda, contenido 100% del giro. Lo que cambia el
 * argumento entero: aquí la unidad es el PAR y la variante es el NÚMERO. El
 * dolor propio es la CORRIDA ROTA —te quedas con los extremos cuando se venden
 * los números de en medio—, que no existe en ningún otro giro. Ojo: un "par
 * descabalado" es un par disparejo; lo que se rompe aquí es la corrida.
 *
 * Bloque propio de esta página: la corrida cerrada contra la venta real. No es
 * reutilizable ni pretende serlo — fuera del calzado no significa nada. Cada
 * giro tendrá el suyo.
 *
 * Todo el contenido vive en src/data/giros/zapateria.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuiteManifiesto from '../../components/suite/SuiteManifiesto.astro';
import SuiteVariantes from '../../components/suite/SuiteVariantes.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import SuiteCortina from '../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../components/suite/SuiteProblemas.astro';
import SuiteCasos from '../../components/suite/SuiteCasos.astro';
import SuiteSalida from '../../components/suite/SuiteSalida.astro';
import SuiteCifras from '../../components/suite/SuiteCifras.astro';
import ZapCorridaCerrada from '../../components/giros/ZapCorridaCerrada.astro';
import ZapNivelacion from '../../components/giros/ZapNivelacion.astro';
import SuiteProceso from '../../components/suite/SuiteProceso.astro';
import SuiteIntegral from '../../components/suite/SuiteIntegral.astro';
import SuitePlanes from '../../components/suite/SuitePlanes.astro';
import CtaDudas from '../../components/CtaDudas.astro';
import GiroBanner from '../../components/giros/GiroBanner.astro';
import { seccionesZapateria, casosZapateria, cortinaZapateria, pasosZapateria, cajaZapateria, documentosZapateria, etapasZapateria,
  nivelacionZapateria,
} from '../../data/giros/zapateria';

const titulo = 'Suite para Zapaterías';
const desc =
  'El sistema para zapaterías: corrida completa con medios números, cambio de número sin ticket, apartados por quincena y pedido de temporada por remesas.';
---

<BaseLayout title={`${titulo} — SACS`} description={desc}>
  <!-- ── Portada: la forma del Home. El mensaje a la izquierda, la tienda a
       la derecha y los avisos del sistema encima — pero avisos de calzado, que
       es lo que enseña en la primera pantalla que el sistema habla el idioma
       del giro. ── -->
  <GiroBanner
    eyebrow="SACS · Suite Calzado"
    titulo="Tu tienda no vende modelos."
    resalte="Vende números."
    sub="Corrida completa con medios números, cambio de número en el mostrador, apartados por quincena y el pedido de temporada por remesas — con un mismo inventario para tu piso, tu tienda en línea, tu WhatsApp y tus marketplaces."
    foto="/images/hero-zapateria.webp"
    fotoAlt="Empleado de una zapatería consultando existencias en una tablet frente a los muros de calzado"
    avisos={[
      { modulo: 'Corrida rota', texto: 'Botín café: sin 23½ ni 24 en Centro', pos: 1, tono: 'rojo', sello: 'Hoy' },
      { modulo: 'Remesa del lunes', texto: '9 pares de Plaza Norte a Sur cierran su corrida', pos: 2, tono: 'azul', sello: 'Sugerida' },
      { modulo: 'Apartado por vencer', texto: 'Sra. Jiménez · 24½ · vence el viernes', pos: 3, tono: 'ambar', sello: '3 días' },
    ]}
  />

  <!-- ── Aquí se demuestra que entendemos el giro ── -->
  <SuiteManifiesto
    intro="Sabemos cómo se vende el calzado"
    frases={[
      'El <b>23½</b> se acabó el primer fin de semana.',
      'Del <b>27</b> te quedan tres pares desde la temporada pasada.',
      '"¿Me lo trae en el 24?" — y alguien camina a la <b>bodega</b> a ver.',
      'Ese modelo ya está roto: sin los números de en medio, <b>eso ya es saldo</b>.',
      'Le apretó el 26 y <b>lo compró en la otra tienda</b>.',
    ]}
    cierre="Ningún sistema de abarrotes entiende esto, y uno de ropa tampoco: aquí la unidad es el par, el SKU es modelo × color × número, y los medios números no son un detalle. Un modelo con la corrida rota es dinero muerto aunque el reporte diga que tienes diecisiete pares. Cada pantalla que sigue está hecha con esa lógica."
  />

  <!-- ── El momento fuerte: la corrida en 3D ── -->
  <!-- Entra un botín y salen los veintidós que de verdad tienes que comprar,
       guardar y contar. El cubo de casillas decía lo mismo y había que
       explicarlo con un párrafo. -->
  <SuiteVariantes
    eyebrow="Un solo modelo"
    titulo="Esto es lo que de verdad hay detrás de"
    resalte="“un botín de dama”."
    sub="Once números con medios, en dos colores. Veintidós pares distintos que comprar, guardar, contar y reponer — de un solo modelo. Y los que están en cero son justo los que te están pidiendo."
    ejeA={['22', '22½', '23', '23½', '24', '24½', '25', '25½', '26', '26½', '27']}
    filas={[
      { nombre: 'Café', img: '/images/botin-cafe.webp', alt: 'Botín de dama en piel café' },
      { nombre: 'Negro', img: '/images/botin-negro.webp', alt: 'Botín de dama en piel negra' },
    ]}
    matriz={[
      [1, 2, 0, 0, 0, 0, 3, 4, 3, 2, 2],
      [1, 1, 2, 0, 0, 1, 4, 5, 4, 2, 1],
    ]}
    unidad="pares"
    leyendas={['Con pares', 'Último par', 'Agotado']}
  />

  <!-- ── La comparación que hace el propio visitante ── -->
  <SuiteCortina
    eyebrow={cortinaZapateria.eyebrow}
    titulo={cortinaZapateria.titulo}
    sub={cortinaZapateria.sub}
    fotoAntes={cortinaZapateria.fotoAntes}
    fotoDespues={cortinaZapateria.fotoDespues}
    altAntes={cortinaZapateria.altAntes}
    altDespues={cortinaZapateria.altDespues}
    libreta={cortinaZapateria.libreta}
    pieAntes={cortinaZapateria.pieAntes}
    filas={cortinaZapateria.filas}
    pieDespues={cortinaZapateria.pieDespues}
  />

  <!-- ── Por qué no le sirvió lo que ya probó ── -->
  <SuiteProblemas
    titulo={documentosZapateria.titulo}
    entrada={documentosZapateria.entrada}
    doc1={documentosZapateria.doc1}
    doc2={documentosZapateria.doc2}
    filas={documentosZapateria.filas}
  />

  <!-- ── Salida: aquí es donde muere la objeción del sistema genérico ── -->
  <SuiteSalida frase="Si ya probaste un genérico y un desarrollo a la medida, la tercera conversación es distinta: esta ya sabe qué es una corrida." />

  <!-- ── Respiro fotográfico: la escala ── -->
  <SuiteCifras
    foto="/images/suite-zap-tienda.webp"
    alt="Pasillo central de una zapatería grande con muros de calzado a ambos lados, bancas de probador y clientes recorriendo los anaqueles"
    frase="Desde una zapatería hasta una cadena con bodega central."
    encuadre="center 40%"
    datos={[
      { n: 3000, pre: '+', rotulo: 'NEGOCIOS ACTIVOS EN SACS' },
      { n: 4, pos: ' canales', rotulo: 'CON UN SOLO INVENTARIO' },
      { n: 1, pos: ' semana', rotulo: 'PARA CAMBIARTE, SIN CERRAR UN DÍA' },
    ]}
  />

  <!-- ── Momentos reales, con su escena ── -->
  <SuiteCasos
    eyebrow="Cuatro situaciones de siempre"
    titulo="Dónde te sirve, en concreto"
    sub="Las cuatro situaciones en las que una zapatería gana o pierde el dinero. Toca cada una."
    casos={casosZapateria}
  />


  <!-- ── El complemento propio de este giro: la corrida cerrada ── -->
  <!-- ── El recorrido de funcionalidades, con su panel pegajoso ── -->
  <SuiteScroll
    eyebrow="Suite Calzado"
    titulo="Todo tu negocio de calzado, físico y digital, en un solo lugar"
    intro="Baja para ver cada pieza. Todos los ejemplos son de una zapatería real: la corrida con medios números, el cambio en el mostrador y el pedido por remesas. Y todo funciona igual en el mostrador que en tu tienda en línea, porque es el mismo inventario."
    secciones={seccionesZapateria}
  />

  <ZapCorridaCerrada />

  <!-- La respuesta al tablero: qué número sale de qué tienda y a cuál -->
  <ZapNivelacion datos={nivelacionZapateria} />

  <!-- ── Cómo se cambia sin parar ── -->
  <SuiteProceso
    titulo="Cambiar de sistema"
    resalte="sin cerrar la tienda."
    sub="Tienes tiendas operando y no puedes darte el lujo de parar una semana. Así se hace — y lo hacemos nosotros, no te dejamos un manual y suerte."
    pasos={pasosZapateria}
    remate="<b>Tu histórico no se tira.</b> Se migra lo que sirve —clientes, productos, existencias— y lo demás queda consultable. Nunca te pedimos empezar de cero, porque nadie con cinco años de ventas puede hacerlo."
    lineas={cajaZapateria.lineas}
    total={cajaZapateria.total}
  />

  <!-- Lo que todavía no se ha enseñado: que aquí cabe el negocio entero -->
  <SuiteIntegral
    eyebrow="Toda la operación, en un solo lugar"
    titulo="Y esto es solo lo que te enseñamos."
    resalte="Adentro cabe todo."
    sub="Una zapatería no es solo el mostrador. Es lo que compras, lo que te queda, quién lo vendió y quién regresa. Las cuatro cosas viven en el mismo sistema — toca cada una."
    etapas={etapasZapateria}
    centro="Tu zapatería"
    pie="<b>No son cuatro productos.</b> Son las cuatro cosas que tu tienda hace todos los días, en el mismo lugar y con los mismos datos: el par que se vendió en el mostrador ya descontó existencia, ya sumó puntos al cliente, ya cuenta para la comisión del vendedor y ya está en el reporte que abres el lunes."
  />

  <!-- ── El modelo comercial ── -->
  <SuitePlanes suite="Suite Calzado" />

  <!-- Salida: quien se convence con el precio no debería tener que
       bajar dos pantallas y media de animación para hacer clic -->
  <SuiteSalida frase="Ya viste el precio. Lo que sigue es ver tu propia corrida en pantalla." cta="Agenda una demo" />

  <!-- El mismo cierre que la portada -->
  <CtaDudas demoDesc="Te mostramos SACS con tus modelos, tus números y tu venta real. 30 min, sin compromiso." />
</BaseLayout>

