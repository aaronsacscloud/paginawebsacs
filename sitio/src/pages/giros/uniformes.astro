---
/**
 * Landing UNIFORMES (17-sep-2026): escolares, empresariales, médicos e industriales. Misma estructura
 * que marcas-de-ropa.astro; el contenido vive en src/data/giros/uniformes.ts y el bloque propio es
 * UnLista ("La lista manda").
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GiroBanner from '../../components/giros/GiroBanner.astro';
import SuiteManifiesto from '../../components/suite/SuiteManifiesto.astro';
import SuiteVariantes from '../../components/suite/SuiteVariantes.astro';
import SuiteCortina from '../../components/suite/SuiteCortina.astro';
import SuiteProblemas from '../../components/suite/SuiteProblemas.astro';
import SuiteSalida from '../../components/suite/SuiteSalida.astro';
import SuiteCifras from '../../components/suite/SuiteCifras.astro';
import SuiteCasos from '../../components/suite/SuiteCasos.astro';
import SuiteScroll from '../../components/suite/SuiteScroll.astro';
import SuitePlano from '../../components/suite/SuitePlano.astro';
import SuiteProceso from '../../components/suite/SuiteProceso.astro';
import SuitePlanes from '../../components/suite/SuitePlanes.astro';
import CtaDudas from '../../components/CtaDudas.astro';
import UnLista from '../../components/giros/UnLista.astro';
import GiroEscala from '../../components/giros/GiroEscala.astro';
import { bannerUN, manifiestoUN, variantesUN, cortinaUN, casosUN, seccionesUN, planoUN, pasosUN, ticketUN, escalaUN, problemasUN, cifrasUN } from '../../data/giros/uniformes';
---
<BaseLayout
  title="Sistema para tiendas y fábricas de uniformes — Sacs"
  description="Punto de venta para uniformes: listas por escuela que arman el pedido, apartados con anticipo, regreso a clases sin internet y bordado como servicio."
>
  <GiroBanner eyebrow={bannerUN.eyebrow} titulo={bannerUN.titulo} resalte={bannerUN.resalte} sub={bannerUN.sub} foto={bannerUN.foto} fotoAlt={bannerUN.fotoAlt} avisos={bannerUN.avisos} selloMarcas="negocios de moda y uniformes en México y Latam" />

  <SuiteManifiesto intro={manifiestoUN.intro} frases={manifiestoUN.frases} cierre={manifiestoUN.cierre} />

  <SuiteVariantes eyebrow={variantesUN.eyebrow} titulo={variantesUN.titulo} resalte={variantesUN.resalte} sub={variantesUN.sub} ejeA={variantesUN.ejeA} filas={variantesUN.filas} matriz={variantesUN.matriz} unidad={variantesUN.unidad} genero={variantesUN.genero} umbralBajo={variantesUN.umbralBajo} leyendas={variantesUN.leyendas} remate={variantesUN.remate} />

  <SuiteCortina fotoAntes={cortinaUN.fotoAntes} fotoDespues={cortinaUN.fotoDespues} altAntes={cortinaUN.altAntes} altDespues={cortinaUN.altDespues} libreta={cortinaUN.libreta} filas={cortinaUN.filas} pieDespues={cortinaUN.pieDespues} />

  <SuiteProblemas colGenerico="Sistema de ropa" entrada={problemasUN.entrada} quienes={problemasUN.quienes} doc1={problemasUN.doc1} doc2={problemasUN.doc2} filas={problemasUN.filas} />

  <SuiteSalida frase="Si ya probaste un sistema de ropa y un desarrollo a la medida, la tercera conversación es distinta: esta ya sabe qué es una lista de escuela y qué es un módulo." />

  <SuiteCifras foto={cifrasUN.foto} alt={cifrasUN.alt} frase={cifrasUN.frase} encuadre={cifrasUN.encuadre} datos={[
    { n: 3000, pre: '+', rotulo: 'NEGOCIOS DE MODA Y UNIFORMES ACTIVOS' },
    { n: 7600, pre: '+$', rotulo: 'MILLONES TRANSACCIONADOS' },
    { n: 20, pos: '+', rotulo: 'PERSONAS DE SOPORTE, EN MÉXICO' },
    { n: 1, pre: '#', rotulo: 'EN RETAIL ESPECIALIZADO' },
  ]} />

  <SuiteCasos eyebrow="Cuatro momentos del año" titulo="Dónde te sirve, en concreto" sub="Los cuatro momentos del ciclo escolar en que una tienda de uniformes gana o pierde el dinero. Toca cada uno." casos={casosUN} />

  <SuiteScroll eyebrow="Uniformes" titulo="La tienda, el módulo y el taller, con el mismo inventario" intro="Baja para ver cada pieza. Todos los ejemplos son de una tienda de uniformes real: la lista de la escuela, el apartado con anticipo, el módulo sin internet y la orden de bordado." secciones={seccionesUN} />

  <UnLista />

  <GiroEscala encabezado="Tu tamaño" titulo="De la tienda de la colonia a la fábrica con 150 tiendas." descripcion="El negocio cambia con cada tamaño: cuántas escuelas, cuántos módulos, quién corta y qué mira la dirección. Elige el tuyo." niveles={escalaUN} />

  <SuitePlano titulo="Tu tienda, por dentro." sub="Entra la mamá al mostrador, dice de qué escuela y qué grado, pasa al piso por escuela, al probador, paga y se va. Detrás está la bodega donde se arman las cajas del módulo y, afuera, el taller de bordado. Toca cada zona y mira qué hace Sacs ahí." proyecto="Tu tienda de uniformes — planta baja" zonas={planoUN} todoRot="Uniformes" />

  <SuiteProceso titulo="Cambiar de sistema" resalte="sin cerrar la tienda." sub="Tienes el regreso a clases encima y no puedes parar una semana. Así se hace, y lo hacemos nosotros: no te dejamos un manual y suerte." pasos={pasosUN} lineas={ticketUN.lineas} total={ticketUN.total} remate="<b>Tu histórico no se tira.</b> Se migra lo que sirve: listas por escuela, apartados vivos con su anticipo y su saldo, existencias por talla y las relaciones de tallas de tus empresas. Nunca te pedimos empezar de cero antes de agosto." />

  <SuitePlanes suite="Suite de Moda" />

  <SuiteSalida frase="Ya viste el precio. Lo que sigue es ver tus propias listas de escuela armando el pedido en pantalla." cta="Agenda una demo" />

  <CtaDudas demoDesc="Te mostramos Sacs con tus escuelas, tus listas y tu regreso a clases real. 30 min, sin compromiso." />
</BaseLayout>
