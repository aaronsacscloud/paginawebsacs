---
// Estado de cuenta del cliente.
//
// Se puede pedir de TODAS sus suscripciones o de las que se elijan
// (?subs=id,id). Eso importa: mandarle el total de todo cuando lo que se le
// está cobrando es una sola suscripción invita a la pregunta equivocada —"¿y
// esto otro por qué me lo cobran ahora?"— y una aclaración de esas cuesta más
// que el cobro.
//
// Llave = id (UUID) de la company. Solo datos del propio cliente.
import { supabase } from '../../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;
const q = Astro.url.searchParams;
const soloIds = (q.get('subs') || '').split(',').map(x => x.trim()).filter(Boolean);
const verPagos = q.get('pagos') !== '0';
const verPagar = q.get('pagar') !== '0';

const { data: company } = await supabase.from('companies').select('id, nombre, nombre_comercial, sacs_account').eq('id', id).single();
if (!company) return Astro.redirect('/404');

const { data: subsRaw } = await supabase
  .from('subscriptions')
  .select('id, nombre_plan, ciclo, precio, monto_proximo, proxima_factura, estado, fecha_inicio, total_pagado, mp_link_pago, mp_link_periodo')
  .eq('company_id', id)
  .in('estado', ['activa', 'pendiente_pago', 'programada'])
  .order('proxima_factura', { ascending: true, nullsFirst: false });
// "Próximo a pagar" = suscripciones recurrentes (las vitalicias son pago único).
let subs = (subsRaw || []).filter((s: any) => s.ciclo !== 'vitalicia');
if (soloIds.length) subs = subs.filter((s: any) => soloIds.includes(s.id));

// Pagos de ESAS suscripciones. El acumulado ya estaba en el CRM y no aparecía
// en el documento: ponerlo evita el "yo ya te pagué" y las capturas de ida y
// vuelta.
const idsSubs = subs.map((s: any) => s.id);
let pagos: any[] = [];
if (verPagos && idsSubs.length) {
  const { data } = await supabase.from('payments')
    .select('id, fecha, monto, metodo, referencia, subscription_id')
    .in('subscription_id', idsSubs).neq('estado', 'reembolsado')
    .order('fecha', { ascending: false }).limit(12);
  pagos = data || [];
}

const { data: contacts } = await supabase.from('contacts').select('nombre, apellido, email').eq('company_id', id).limit(3);
const contact = (contacts || [])[0] || null;

// ── formato ──
const money = (n: number | null | undefined) => '$' + Math.round(Number(n || 0)).toLocaleString('es-MX') + '.00';
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const MES3 = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function fmtFecha(d?: string | null) {
  if (!d) return '—';
  const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${day} de ${MESES[(m || 1) - 1]} de ${y}`;
}
function fmtCorta(d?: string | null) {
  if (!d) return '—';
  const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${String(day).padStart(2, '0')}/${String(m).padStart(2, '0')}/${y}`;
}
function fmtMesAno(d?: string | null) {
  if (!d) return '—';
  const [y, m] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${MES3[(m || 1) - 1]} ${String(y).slice(2)}`;
}
/** El periodo que cubre el cobro: la duda número uno de quien lo recibe. */
function periodo(s: any) {
  const fin = s.proxima_factura;
  if (!fin) return '—';
  const [y, m, d] = String(fin).slice(0, 10).split('-').map(Number);
  const ini = s.ciclo === 'mensual' ? new Date(y, (m || 1) - 2, d || 1) : new Date(y - 1, (m || 1) - 1, d || 1);
  const iniStr = `${ini.getFullYear()}-${String(ini.getMonth() + 1).padStart(2, '0')}-01`;
  return `${fmtMesAno(iniStr)} – ${fmtMesAno(fin)}`;
}

const CICLO: Record<string, string> = { mensual: 'Mensual', anual: 'Anual' };
const ESTADO: Record<string, { label: string; bg: string; color: string }> = {
  activa: { label: 'Activa', bg: '#EAF8F2', color: '#1E8A63' },
  pendiente_pago: { label: 'Pago pendiente', bg: '#FEF6E7', color: '#9a6a10' },
  programada: { label: 'Programada', bg: '#E3EDFD', color: '#2C5FC4' },
};
const hoyStr = new Date().toISOString().slice(0, 10);
const diasDe = (d: string) => Math.max(0, Math.floor((Date.parse(hoyStr) - Date.parse(String(d).slice(0, 10))) / 86400000));

const rows = subs.map((s: any) => {
  const monto = Number(s.monto_proximo ?? s.precio) || 0;
  const vencida = !!(s.proxima_factura && String(s.proxima_factura).slice(0, 10) < hoyStr);
  return { ...s, monto, vencida, dias: vencida ? diasDe(s.proxima_factura) : 0, pagos: pagos.filter((p: any) => p.subscription_id === s.id) };
});
// Lo de arriba es lo que se cobra AHORA, no la suma de todo lo que existe: si
// una venció y esa es la que estás cobrando, mezclarla con la que vence en
// diciembre le pide al cliente que reste para saber cuánto te deposita.
const vencidas = rows.filter((r: any) => r.vencida);
const alDia = rows.filter((r: any) => !r.vencida);
const cobrarAhora = vencidas.length ? vencidas : (alDia.length === 1 ? alDia : alDia.slice(0, 1));
const otras = rows.filter((r: any) => !cobrarAhora.includes(r));
const total = cobrarAhora.reduce((a: number, r: any) => a + r.monto, 0);
const totalTodo = rows.reduce((a: number, r: any) => a + r.monto, 0);
const pagado = pagos.reduce((a: number, p: any) => a + Number(p.monto || 0), 0);
const proximaMasCercana = cobrarAhora.map((r: any) => r.proxima_factura).filter(Boolean).sort()[0] || null;
const hayVencido = vencidas.length > 0;
const diasRetraso = Math.max(0, ...rows.map((r: any) => r.dias));
// El primer pago recibido: sirve para agradecer con un dato de verdad —"desde
// octubre de 2025"— en vez de una frase de cortesía sin contenido.
const desde = pagos.length ? pagos.map((p: any) => String(p.fecha).slice(0, 10)).sort()[0] : null;
// Un solo botón de pago: solo tiene sentido cuando se está cobrando UNA
// suscripción y esa tiene su liga viva de Mercado Pago. Con dos, el importe
// del botón no correspondería a ninguna de las dos ligas.
const linkPago = cobrarAhora.length === 1 && cobrarAhora[0].mp_link_pago ? cobrarAhora[0].mp_link_pago : null;
const parcial = soloIds.length > 0 && (subsRaw || []).filter((x: any) => x.ciclo !== 'vitalicia').length > rows.length;

const clienteNombre = [contact?.nombre, contact?.apellido].filter(Boolean).join(' ').trim() || company.nombre || 'Cliente';
const empresaNombre = company.nombre_comercial || company.nombre || '';
const folio = 'EC-' + String(id).slice(0, 8).toUpperCase();
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Estado de cuenta · {empresaNombre || clienteNombre} · SACS</title>
  <style>
    :root { --ink:#16181d; --muted:#6b7280; --faint:#a5a2af; --violeta:#9B8CFA; --tinta:#5B4BD6; --hondo:#3f2fb8; --rojo:#C0554E; --verde:#1E8A63; --line:#f0eff3; --paper:#fff; --bg:#eceef1; }
    * { box-sizing:border-box; }
    html,body { margin:0; padding:0; }
    body { background:var(--bg); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; -webkit-font-smoothing:antialiased; line-height:1.5; padding:26px 16px 60px; }
    .num { font-variant-numeric:tabular-nums; }
    .toolbar { max-width:620px; margin:0 auto 14px; display:flex; gap:10px; justify-content:flex-end; }
    .btn { display:inline-flex; align-items:center; gap:7px; height:40px; padding:0 16px; border-radius:10px; font-size:0.83rem; font-weight:700; cursor:pointer; font-family:inherit; border:1px solid #e6e6ea; background:#fff; color:var(--ink); text-decoration:none; }
    .btn-primary { background:var(--violeta); color:#fff; border-color:var(--violeta); }
    .doc { max-width:620px; margin:0 auto; background:var(--paper); border-radius:16px; overflow:hidden; box-shadow:0 1px 3px rgba(16,24,40,0.06), 0 14px 36px rgba(16,24,40,0.10); }
    .head { padding:22px 26px 18px; display:flex; justify-content:space-between; align-items:flex-start; gap:20px; border-bottom:1px solid var(--line); }
    .marca { font-size:1.25rem; font-weight:800; letter-spacing:-0.01em; }
    .firma { font-size:0.55rem; font-weight:800; color:#9c3d70; letter-spacing:0.11em; text-transform:uppercase; margin-top:3px; }
    .meta { text-align:right; font-size:0.7rem; color:var(--muted); line-height:1.7; }
    .meta b { color:#3f3b4d; }
    .eyebrow { font-size:0.6rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:var(--tinta); }
    .k { font-size:0.57rem; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; color:var(--faint); }
    .para { padding:15px 26px; border-bottom:1px solid var(--line); }
    .para .n { font-size:0.95rem; font-weight:800; margin-top:4px; }
    .para .c { font-size:0.74rem; color:var(--muted); }
    /* Lo que se debe, hasta arriba y en grande: un estado de cuenta se abre
       para saber cuánto y para cuándo. En lila, no en verde — el verde en este
       módulo significa pagado. */
    .hero { margin:16px 26px; border-radius:12px; padding:16px 18px; background:linear-gradient(135deg,#EEECFE,#E3EDFD); }
    .hero .k { color:var(--tinta); }
    .hero .v { font-size:1.85rem; font-weight:800; color:var(--hondo); letter-spacing:-0.02em; line-height:1.1; margin-top:4px; }
    .hero .d { font-size:0.75rem; color:var(--tinta); margin-top:5px; font-weight:600; }
    .hero .venc { display:inline-block; background:#FEF0EF; color:var(--rojo); border-radius:20px; padding:2px 9px; font-size:0.63rem; font-weight:800; margin-left:6px; }
    .sec { padding:0 26px; }
    .sec .k { margin:16px 0 9px; display:block; }
    .pl { border:1px solid var(--line); border-radius:11px; padding:12px 14px; margin-bottom:9px; }
    .pl .top { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
    .pl .nm { font-size:0.87rem; font-weight:800; }
    .pill { display:inline-block; padding:2px 8px; border-radius:999px; font-size:0.55rem; font-weight:800; }
    .pl .mo { margin-left:auto; font-size:0.95rem; font-weight:800; }
    .gr { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-top:10px; padding-top:10px; border-top:1px solid #f7f6fa; }
    .gr .c { font-size:0.54rem; font-weight:800; color:#b3b1bb; text-transform:uppercase; letter-spacing:0.06em; }
    .gr .v { font-size:0.76rem; font-weight:700; margin-top:2px; }
    .pago { display:flex; font-size:0.76rem; padding:4px 0; }
    .pago + .pago { border-top:1px solid #f7f6fa; }
    .hero .hl { font-size:0.72rem; color:var(--tinta); opacity:.75; margin-top:8px; font-weight:600; }
    .pl-alta { border-color:#f0c9c5; background:#fffbfb; }
    .otras { border:1px solid var(--line); border-radius:11px; overflow:hidden; }
    .ot { display:flex; align-items:baseline; gap:10px; padding:10px 14px; flex-wrap:wrap; }
    .ot + .ot { border-top:1px solid var(--line); }
    .ot .on { font-size:0.8rem; font-weight:700; }
    .ot .of { font-size:0.7rem; color:var(--muted); }
    .ot .om { margin-left:auto; font-size:0.8rem; font-weight:700; color:var(--muted); }
    .nota-otras { font-size:0.68rem; color:var(--faint); margin:7px 2px 0; }
    /* Un agradecimiento en vez del libro mayor: el detalle de cada pago no le
       dice nada nuevo a quien los hizo. */
    .gracias { margin:18px 26px 4px; border-radius:12px; padding:14px 16px; background:#EAF8F2; border:1px solid #cdeadd; }
    .gracias .gt { font-size:0.82rem; font-weight:800; color:var(--verde); }
    .gracias .gd { font-size:0.75rem; color:#2f6b52; line-height:1.6; margin-top:3px; }
    .gracias .gd b { color:var(--verde); }
    .cta { display:block; text-align:center; background:var(--violeta); color:#fff; border-radius:10px; padding:12px; font-size:0.84rem; font-weight:800; margin:8px 26px 16px; text-decoration:none; }
    .foot { padding:14px 26px 20px; border-top:1px solid var(--line); color:var(--muted); font-size:0.71rem; line-height:1.7; }
    .foot b { color:#3f3b4d; }
    @media (max-width:560px) {
      .head,.para,.sec,.foot { padding-left:18px; padding-right:18px; }
      .hero,.cta { margin-left:18px; margin-right:18px; }
      .gr { grid-template-columns:1fr 1fr; }
    }
    @media print {
      body { background:#fff; padding:0; }
      .toolbar, .cta { display:none !important; }
      .doc { box-shadow:none; border-radius:0; max-width:none; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button class="btn" id="copy-link">Copiar link</button>
    <button class="btn btn-primary" id="download-pdf">Descargar PDF</button>
  </div>

  <div class="doc">
    <div class="head">
      <div>
        <div class="marca">Sacs</div>
        <div class="firma">by Andy Araujo</div>
      </div>
      <div class="meta">
        <div class="eyebrow">Estado de cuenta</div>
        <div style="margin-top:6px"><b>Folio</b> {folio}</div>
        <div><b>Emitido</b> {fmtCorta(new Date().toISOString())}</div>
      </div>
    </div>

    <div class="para">
      <span class="k">Para</span>
      <div class="n">{clienteNombre}</div>
      <div class="c">{empresaNombre}{company.sacs_account ? ` · ${company.sacs_account}` : ''}</div>
    </div>

    {rows.length > 0 && (
      <div class="hero">
        <span class="k">{hayVencido ? 'Pago vencido' : 'Próximo pago'}</span>
        <div class="v num">{money(total)}</div>
        <div class="d">
          {hayVencido
            ? <>Venció el {fmtFecha(proximaMasCercana)}<span class="venc">{diasRetraso} {diasRetraso === 1 ? 'día' : 'días'} de retraso</span></>
            : <>Se cobra el {fmtFecha(proximaMasCercana)}</>}
        </div>
        <div class="hl">{cobrarAhora.map((r: any) => r.nombre_plan).join(' · ')}</div>
      </div>
    )}

    <div class="sec">
      <span class="k">{hayVencido ? 'Lo que se está cobrando' : 'Tu suscripción'}</span>
      {rows.length === 0 && <div style="color:var(--muted);font-size:0.85rem;padding-bottom:8px">No hay suscripciones con pagos próximos.</div>}
      {cobrarAhora.map((r: any) => (
        <div class={r.vencida ? 'pl pl-alta' : 'pl'}>
          <div class="top">
            <span class="nm">{r.nombre_plan}</span>
            {ESTADO[r.estado] && <span class="pill" style={`background:${ESTADO[r.estado].bg};color:${ESTADO[r.estado].color}`}>{ESTADO[r.estado].label}</span>}
            <span class="mo num">{money(r.monto)}</span>
          </div>
          <div class="gr">
            <div><div class="c">Periodicidad</div><div class="v">{CICLO[r.ciclo] || r.ciclo}</div></div>
            <div><div class="c">Periodo que cubre</div><div class="v">{periodo(r)}</div></div>
            <div><div class="c">{r.vencida ? 'Venció' : 'Vence'}</div><div class="v" style={r.vencida ? 'color:var(--rojo)' : ''}>{fmtCorta(r.proxima_factura)}</div></div>
          </div>
        </div>
      ))}

      {/* Las demás van abajo y en chico: son informativas, no lo que se está
          cobrando. Verlas con el mismo peso hace que el cliente sume de más. */}
      {otras.length > 0 && (
        <>
          <span class="k">Tus otras suscripciones</span>
          <div class="otras">
            {otras.map((r: any) => (
              <div class="ot">
                <span class="on">{r.nombre_plan}</span>
                <span class="of">{CICLO[r.ciclo] || r.ciclo} · se cobra el {fmtCorta(r.proxima_factura)}</span>
                <span class="om num">{money(r.monto)}</span>
              </div>
            ))}
          </div>
          <div class="nota-otras">Estas no entran en el cobro de arriba; se cobran en su propia fecha.</div>
        </>
      )}
    </div>

    {verPagos && pagos.length > 0 && (
      <div class="gracias">
        <div class="gt">Gracias por tu pago</div>
        <div class="gd">
          Agradecemos que confíes en <b>SACS Cloud</b>{desde ? <> desde {fmtFecha(desde).replace(/^\d+ de /, '')}</> : ''}. Seguimos trabajando para que tu operación
          esté cada día mejor.
        </div>
      </div>
    )}

    {verPagar && linkPago && (
      <a class="cta" href={linkPago} target="_blank" rel="noreferrer">Pagar {money(total)} en línea</a>
    )}

    <div class="foot">
      {hayVencido
        ? <>El monto de arriba corresponde a {cobrarAhora.length === 1 ? 'la suscripción vencida' : 'las suscripciones vencidas'}. El total de todas tus suscripciones activas es de <b>{money(totalTodo)}</b>, cada una en su fecha.</>
        : <>Resumen de tus suscripciones activas con <b>SACS</b> y sus próximos pagos.</>}
      {' '}Para cualquier aclaración escríbenos a <b>hola@sacscloud.com</b>.
      <div style="margin-top:8px">SACS · www.sacscloud.com</div>
    </div>
  </div>

  <script>
    document.getElementById('download-pdf')?.addEventListener('click', () => window.print());
    document.getElementById('copy-link')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(window.location.href); const p = btn.textContent; btn.textContent = 'Copiado'; setTimeout(() => { btn.textContent = p; }, 1600); } catch { /* */ }
    });
  </script>
</body>
</html>
