---
// Estado de cuenta CONSOLIDADO del cliente: TODAS sus suscripciones recurrentes
// y lo próximo a pagar, en un documento formal (PDF de 1 clic con imprimir).
// Llave = id (UUID) de la company. Solo datos del propio cliente.
import { supabase } from '../../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;

const { data: company } = await supabase.from('companies').select('id, nombre, sacs_account').eq('id', id).single();
if (!company) return Astro.redirect('/404');

const { data: subsRaw } = await supabase
  .from('subscriptions')
  .select('id, nombre_plan, ciclo, precio, monto_proximo, proxima_factura, estado')
  .eq('company_id', id)
  .in('estado', ['activa', 'pendiente_pago', 'programada'])
  .order('proxima_factura', { ascending: true, nullsFirst: false });
// "Próximo a pagar" = suscripciones recurrentes (las vitalicias son pago único).
const subs = (subsRaw || []).filter((s: any) => s.ciclo !== 'vitalicia');

const { data: contacts } = await supabase.from('contacts').select('nombre, apellido, email').eq('company_id', id).limit(3);
const contact = (contacts || [])[0] || null;

// ── formato ──
const money = (n: number | null | undefined) => '$' + Math.round(Number(n || 0)).toLocaleString('es-MX') + '.00';
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
function fmtFecha(d?: string | null) {
  if (!d) return '—';
  const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${day} de ${MESES[(m || 1) - 1]} de ${y}`;
}
function fmtCorta(d?: string | null) {
  if (!d) return '—';
  const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${String(day).padStart(2, '0')}/${String(m).padStart(2, '0')}/${y}`;
}
const CICLO: Record<string, string> = { mensual: 'Mensual', anual: 'Anual' };
const ESTADO: Record<string, { label: string; bg: string; color: string }> = {
  activa: { label: 'Activa', bg: '#e6f6f2', color: '#1A8F7A' },
  pendiente_pago: { label: 'Pago pendiente', bg: '#fff4e0', color: '#a06600' },
  programada: { label: 'Programada', bg: '#eef2fe', color: '#4B7BE5' },
};
const hoyStr = new Date().toISOString().slice(0, 10);

const rows = subs.map((s: any) => {
  const monto = Number(s.monto_proximo ?? s.precio) || 0;
  const vencida = !!(s.proxima_factura && String(s.proxima_factura).slice(0, 10) < hoyStr);
  return { ...s, monto, vencida };
});
const total = rows.reduce((a: number, r: any) => a + r.monto, 0);
const proximaMasCercana = rows.map((r: any) => r.proxima_factura).filter(Boolean).sort()[0] || null;

const clienteNombre = [contact?.nombre, contact?.apellido].filter(Boolean).join(' ').trim() || company.nombre || 'Cliente';
const empresaNombre = company.nombre || '';
const folio = 'EC-' + String(id).slice(0, 8).toUpperCase();
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Estado de cuenta · {empresaNombre || clienteNombre} · SACS</title>
  <style>
    :root { --ink:#16181d; --muted:#6b7280; --faint:#9aa0a8; --accent:#1A8F7A; --line:#e7e9ee; --paper:#fff; --bg:#eef0f3; }
    * { box-sizing:border-box; }
    html,body { margin:0; padding:0; }
    body { background:var(--bg); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; -webkit-font-smoothing:antialiased; line-height:1.5; padding:28px 16px 64px; }
    .num { font-variant-numeric:tabular-nums; }
    .toolbar { max-width:720px; margin:0 auto 16px; display:flex; gap:10px; justify-content:flex-end; }
    .btn { display:inline-flex; align-items:center; gap:7px; height:42px; padding:0 18px; border-radius:10px; font-size:0.85rem; font-weight:700; cursor:pointer; font-family:inherit; border:1px solid var(--line); background:#fff; color:var(--ink); text-decoration:none; }
    .btn-primary { background:var(--accent); color:#fff; border-color:var(--accent); }
    .doc { max-width:720px; margin:0 auto; background:var(--paper); border:1px solid var(--line); border-radius:16px; overflow:hidden; box-shadow:0 1px 3px rgba(16,24,40,0.06), 0 8px 32px rgba(16,24,40,0.06); }
    .doc-head { padding:34px 40px 26px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:flex-start; gap:20px; }
    .doc-head img { height:30px; }
    .doc-head .meta { text-align:right; font-size:0.72rem; color:var(--muted); line-height:1.7; }
    .doc-head .meta b { color:var(--ink); }
    .eyebrow { font-size:0.68rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--accent); }
    .section { padding:26px 40px; border-bottom:1px solid var(--line); }
    .section:last-child { border-bottom:none; }
    .label { font-size:0.66rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--faint); margin-bottom:4px; }
    .para-quien { font-size:1.05rem; font-weight:700; }
    .para-quien .sub { font-size:0.82rem; font-weight:400; color:var(--muted); margin-top:2px; }
    table { width:100%; border-collapse:collapse; }
    th { text-align:left; font-size:0.64rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:var(--faint); padding:0 0 10px; border-bottom:1px solid var(--line); }
    td { padding:13px 0; font-size:0.88rem; border-bottom:1px solid #f2f3f6; vertical-align:top; }
    tr:last-child td { border-bottom:none; }
    .right { text-align:right; }
    .plan { font-weight:700; }
    .pill { display:inline-block; padding:2px 9px; border-radius:999px; font-size:0.66rem; font-weight:700; }
    .venc { color:#b93333; font-weight:700; }
    .total { background:linear-gradient(180deg,#f6fbfa 0%,#eef8f5 100%); border:1px solid #cfe9e2; border-radius:14px; padding:20px 24px; display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; }
    .total .amount { font-size:2rem; font-weight:800; letter-spacing:-0.02em; }
    .total .when { text-align:right; font-size:0.8rem; color:var(--muted); }
    .foot { padding:22px 40px 30px; color:var(--muted); font-size:0.76rem; line-height:1.7; }
    .foot .brand { color:var(--ink); font-weight:800; }
    @media (max-width:560px) {
      .doc-head,.section,.foot { padding-left:22px; padding-right:22px; }
      .total { flex-direction:column; align-items:flex-start; } .total .when { text-align:left; }
      td, th { font-size:0.8rem; }
    }
    @media print {
      body { background:#fff; padding:0; }
      .toolbar { display:none !important; }
      .doc { box-shadow:none; border:none; border-radius:0; max-width:none; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button class="btn" id="copy-link">🔗 Copiar link</button>
    <button class="btn btn-primary" id="download-pdf">⬇ Descargar PDF</button>
  </div>

  <div class="doc">
    <div class="doc-head">
      <img src="/brand/sacs-wordmark-dark.svg" alt="SACS" />
      <div class="meta">
        <div class="eyebrow">Estado de cuenta</div>
        <div style="margin-top:6px"><b>Folio</b> {folio}</div>
        <div><b>Emitido</b> {fmtCorta(new Date().toISOString())}</div>
      </div>
    </div>

    <div class="section">
      <div class="label">Para</div>
      <div class="para-quien">
        {clienteNombre}
        {empresaNombre && empresaNombre !== clienteNombre && <div class="sub">{empresaNombre}</div>}
      </div>
    </div>

    <div class="section">
      <div class="label" style="margin-bottom:12px">Tus suscripciones — próximo a pagar</div>
      {rows.length === 0 ? (
        <div style="color:var(--muted);font-size:0.9rem">No hay suscripciones con pagos próximos.</div>
      ) : (
        <table>
          <thead>
            <tr>
              <th>Plan</th>
              <th>Periodicidad</th>
              <th>Próximo pago</th>
              <th class="right">Monto</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r: any) => (
              <tr>
                <td>
                  <div class="plan">{r.nombre_plan}</div>
                  {(ESTADO[r.estado]) && <span class="pill" style={`background:${ESTADO[r.estado].bg};color:${ESTADO[r.estado].color};margin-top:4px`}>{ESTADO[r.estado].label}</span>}
                </td>
                <td>{CICLO[r.ciclo] || r.ciclo}</td>
                <td class={r.vencida ? 'venc' : ''}>{fmtFecha(r.proxima_factura)}{r.vencida ? ' · vencido' : ''}</td>
                <td class="right num" style="font-weight:700">{money(r.monto)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    {rows.length > 0 && (
      <div class="section">
        <div class="total">
          <div>
            <div class="label">Total próximo a pagar</div>
            <div class="amount num">{money(total)}</div>
          </div>
          {proximaMasCercana && (
            <div class="when">
              <div class="label">Pago más próximo</div>
              <div style="font-weight:800;color:var(--ink);font-size:1rem">{fmtFecha(proximaMasCercana)}</div>
            </div>
          )}
        </div>
      </div>
    )}

    <div class="foot">
      Resumen de tus suscripciones activas con <span class="brand">SACS</span> y los próximos pagos. Para cualquier aclaración escríbenos a <b>hola@sacscloud.com</b>.
      <div style="margin-top:8px">SACS · www.sacscloud.com</div>
    </div>
  </div>

  <script>
    document.getElementById('download-pdf')?.addEventListener('click', () => window.print());
    document.getElementById('copy-link')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(window.location.href); const p = btn.textContent; btn.textContent = '✓ Copiado'; setTimeout(() => { btn.textContent = p; }, 1600); } catch { /* */ }
    });
  </script>
</body>
</html>
