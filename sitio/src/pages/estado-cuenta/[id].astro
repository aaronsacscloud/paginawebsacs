---
// Página PÚBLICA y formal del estado de suscripción del cliente.
// Llave = id (UUID) de la suscripción (no adivinable), mismo patrón que la
// cotización pública. Solo expone datos del propio cliente (plan, monto, próxima
// fecha, historial de pagos) — nada interno (ARR, salud, notas, otras cuentas).
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;

const { data: sub } = await supabase
  .from('subscriptions')
  .select('id, nombre_plan, ciclo, precio, monto_proximo, fecha_inicio, proxima_factura, estado, company_id, contact_id, pp_monto, pp_pct, pp_expira_at, cobranza_promesa, cobranza_estado, cobranza_nota, cobranza_promesa_estado, mp_link_pago, mp_link_periodo, saldo_favor')
  .eq('id', id)
  .single();

if (!sub) return Astro.redirect('/404');

const { data: company } = sub.company_id
  ? await supabase.from('companies').select('nombre, sacs_account').eq('id', sub.company_id).single()
  : { data: null };
const { data: contact } = sub.contact_id
  ? await supabase.from('contacts').select('nombre, apellido, email').eq('id', sub.contact_id).single()
  : { data: null };

const { data: paysRaw } = await supabase
  .from('payments')
  .select('fecha, monto, metodo, referencia, numero_acuse')
  .eq('subscription_id', id)
  .order('fecha', { ascending: false })
  .limit(12);
const pays = paysRaw || [];

// ── formato ──
const money = (n: number | null | undefined) =>
  '$' + Math.round(Number(n || 0)).toLocaleString('es-MX') + '.00';
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
function fmtFecha(d?: string | null) {
  if (!d) return '—';
  const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${day} de ${MESES[(m || 1) - 1]} de ${y}`;
}
function fmtFechaCorta(d?: string | null) {
  if (!d) return '—';
  const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
  if (!y) return '—';
  return `${String(day).padStart(2, '0')}/${String(m).padStart(2, '0')}/${y}`;
}

const CICLO: Record<string, string> = { mensual: 'Mensual', anual: 'Anual', vitalicia: 'Pago único' };
const METODO: Record<string, string> = { transferencia: 'Transferencia', tarjeta: 'Tarjeta', stripe: 'Tarjeta', efectivo: 'Efectivo', oxxo: 'OXXO', otro: 'Otro' };
const cicloLabel = CICLO[sub.ciclo] || 'Mensual';
const periodicidad = sub.ciclo === 'anual' ? 'cada año' : sub.ciclo === 'vitalicia' ? '' : 'cada mes';

const montoPagar = Number(sub.monto_proximo ?? sub.precio) || 0;
const esRecurrente = sub.ciclo !== 'vitalicia';
const vencida = !!(sub.proxima_factura && String(sub.proxima_factura).slice(0, 10) < new Date().toISOString().slice(0, 10) && sub.estado !== 'cancelada');

// Oferta de PRONTO PAGO (persistida en la sub, no manipulable por el cliente).
const ppExpiraMs = sub.pp_expira_at ? new Date(sub.pp_expira_at).getTime() : 0;
const ofertaValida = esRecurrente && sub.pp_monto != null && ppExpiraMs > Date.now();
const ppMonto = Number(sub.pp_monto) || 0;
const ppPct = Number(sub.pp_pct) || 0;
const ahorro = Math.max(0, montoPagar - ppMonto);

const ESTADO: Record<string, { label: string; bg: string; color: string }> = {
  activa: { label: 'Activa', bg: '#e6f6f2', color: '#1A8F7A' },
  pendiente_pago: { label: 'Pago pendiente', bg: '#fff4e0', color: '#a06600' },
  programada: { label: 'Programada', bg: '#eef2fe', color: '#4B7BE5' },
  pausada: { label: 'Pausada', bg: '#f3f4f6', color: '#6b7280' },
  cancelada: { label: 'Cancelada', bg: '#fdecea', color: '#b93333' },
};
const estadoInfo = ESTADO[sub.estado] || ESTADO.activa;

/* ── Lo que hace de esto un comprobante de cobranza ──
   El documento no solo dice "tienes un plan": dice CUÁNTO DEBES, DESDE CUÁNDO
   y —si la hubo— qué se prometió. Es lo que se manda cuando un cobro no pasó,
   y sin el atraso a la vista no sirve para eso. */
const HOY = new Date().toLocaleDateString('sv-SE');
const diasAtraso = (() => {
  const f = String(sub.proxima_factura || '').slice(0, 10);
  if (!f || f >= HOY || sub.estado === 'cancelada') return 0;
  return Math.floor((Date.parse(HOY + 'T12:00:00') - Date.parse(f + 'T12:00:00')) / 86400000);
})();
/* Lo que DEBE, no lo que cuesta un mes. Con una mensual atrasada, el cargo se
   repite cada periodo: al cliente de 248 días no se le cobran $900, se le
   cobran los nueve meses que lleva. Es el mismo conteo que hace la pantalla de
   Cobranza —mes a mes desde la fecha vencida, no dividiendo entre 30, porque
   un mes no dura 30 días— para que el papel diga la misma cifra que el CRM. */
const saldoFavor = Number(sub.saldo_favor || 0);
let periodosVencidos = 0;
if (diasAtraso > 0 && sub.ciclo === 'mensual') {
  const f = new Date(String(sub.proxima_factura).slice(0, 10) + 'T12:00:00');
  while (f.toLocaleDateString('sv-SE') <= HOY && periodosVencidos < 120) { periodosVencidos++; f.setMonth(f.getMonth() + 1); }
} else if (diasAtraso > 0) {
  periodosVencidos = 1;
}
const adeudo = periodosVencidos > 0
  ? Math.max(0, montoPagar * periodosVencidos - saldoFavor)
  : Math.max(0, montoPagar - saldoFavor);

const promesa = String(sub.cobranza_promesa || '').slice(0, 10);
const promesaVigente = !!promesa && promesa >= HOY && sub.cobranza_promesa_estado !== 'cumplida';
const promesaVencida = !!promesa && promesa < HOY && sub.cobranza_promesa_estado !== 'cumplida';

const clienteNombre = [contact?.nombre, contact?.apellido].filter(Boolean).join(' ').trim() || company?.nombre || 'Cliente';
const empresaNombre = company?.nombre || '';
const hoy = new Date();
const folio = 'EC-' + String(id).slice(0, 8).toUpperCase();
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Estado de cuenta · {empresaNombre || clienteNombre} · Sacscloud</title>
  <style>
    :root {
      --ink: #241d43; --muted: #6b7280; --faint: #a5a2af;
      --accent: #5B4BD6; --violeta: #9B8CFA; --tinta: #3f2fb8;
      --rojo: #C0554E; --verde: #1E8A63;
      --line: #f0eff3; --paper: #ffffff; --bg: #eceef1;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg); color: var(--ink);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased; line-height: 1.5;
      padding: 28px 16px 64px;
    }
    .num { font-variant-numeric: tabular-nums; }
    .toolbar {
      max-width: 720px; margin: 0 auto 16px; display: flex; gap: 10px; justify-content: flex-end;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 7px; height: 42px; padding: 0 18px;
      border-radius: 10px; font-size: 0.85rem; font-weight: 700; cursor: pointer;
      font-family: inherit; border: 1px solid var(--line); background: #fff; color: var(--ink);
      text-decoration: none;
    }
    .btn-primary { background: var(--violeta); color: #fff; border-color: var(--violeta); }
    .doc {
      max-width: 720px; margin: 0 auto; background: var(--paper);
      border-radius: 16px; overflow: hidden;
      box-shadow: 0 1px 3px rgba(16,24,40,0.06), 0 14px 36px rgba(16,24,40,0.10);
    }
    /* La cinta de la marca corona el documento, igual que la cotización. */
    .cinta { height: 4px; background: linear-gradient(90deg,#9B8CFA 0%,#7DA6F5 55%,rgba(244,168,205,.9) 100%); }
    .marca-nom { font-size: 1.3rem; font-weight: 800; letter-spacing: -.01em; color: var(--ink); }
    .marca-firma {
      font-size: .55rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; margin-top: 3px;
      background: linear-gradient(100deg,#7C6BF0 0%,#8E7DEF 35%,#D9538E 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    /* ── El adeudo: el ancla del documento ── */
    .adeudo {
      margin: 18px 34px; border-radius: 13px; padding: 18px 20px;
      background: linear-gradient(135deg,#EEECFE,rgba(244,168,205,.22));
      display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    }
    .adeudo.vencido { background: linear-gradient(135deg,#FEF0EF,rgba(244,168,205,.22)); }
    .adeudo .kk { font-size: .56rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
    .adeudo.vencido .kk { color: var(--rojo); }
    .adeudo .monto { font-size: 2rem; font-weight: 800; color: var(--tinta); letter-spacing: -.02em; line-height: 1.05; margin-top: 3px; }
    .adeudo.vencido .monto { color: #a53d36; }
    .adeudo .sub { font-size: .78rem; color: var(--accent); margin-top: 5px; font-weight: 600; }
    .adeudo.vencido .sub { color: var(--rojo); }
    .adeudo .caja { margin-left: auto; text-align: right; background: rgba(255,255,255,.72); border-radius: 11px; padding: 10px 14px; }
    .adeudo .caja .g { font-size: 1.5rem; font-weight: 800; color: var(--tinta); line-height: 1; }
    .adeudo.vencido .caja .g { color: #a53d36; }
    .adeudo .caja .t { font-size: .64rem; font-weight: 700; color: var(--accent); margin-top: 3px; }
    .adeudo.vencido .caja .t { color: var(--rojo); }
    /* De qué está hecha la cifra. Sin esto, "$7,731" en una mensual de $900 se
       lee como un error de sistema y la llamada empieza discutiendo el monto. */
    .adeudo .desglose {
      flex-basis: 100%; margin-top: 10px; padding-top: 9px;
      border-top: 1px solid rgba(255,255,255,.75);
      font-size: .74rem; font-weight: 600; color: var(--rojo); opacity: .92;
    }
    .sello-venc {
      display: inline-flex; align-items: center; gap: 6px; margin-top: 6px;
      background: #FEF0EF; color: var(--rojo); border-radius: 20px; padding: 4px 11px;
      font-size: .6rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
    }

    /* ── La promesa de pago, cuando la hubo ── */
    .promesa { margin: 0 34px 16px; border-radius: 12px; padding: 13px 16px; font-size: .82rem; line-height: 1.6; }
    .promesa.viva { background: #F3F0FE; color: #4C3BD0; }
    .promesa.rota { background: #FFF4E5; color: #9a6a10; }
    .promesa b { font-weight: 800; }
    .cta-pago {
      display: block; text-align: center; background: var(--violeta); color: #fff;
      border-radius: 10px; padding: 13px; font-size: .86rem; font-weight: 800;
      margin: 0 34px 18px; text-decoration: none;
    }
    .doc-head {
      padding: 24px 34px 20px; background: #fcfbfe; border-bottom: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: flex-start; gap: 20px;
    }
    .doc-head img { height: 30px; }
    .doc-head .meta { text-align: right; font-size: 0.72rem; color: var(--muted); line-height: 1.7; }
    .doc-head .meta b { color: var(--ink); }
    .eyebrow { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; color: var(--faint); }
    .h1 { font-size: 1.5rem; font-weight: 800; margin: 6px 0 0; letter-spacing: -0.01em; }
    .section { padding: 20px 34px; border-bottom: 1px solid var(--line); }
    .section:last-child { border-bottom: none; }
    .label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; }
    .para-quien { font-size: 1.05rem; font-weight: 700; }
    .para-quien .sub { font-size: 0.82rem; font-weight: 400; color: var(--muted); margin-top: 2px; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 32px; }
    .kv .label { margin-bottom: 3px; }
    .kv .val { font-size: 0.95rem; font-weight: 700; }
    .pill { display: inline-block; padding: 3px 11px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
    /* Bloque destacado del próximo pago */
    .highlight {
      background: linear-gradient(135deg,#EEECFE,rgba(244,168,205,.22));
      border: none; border-radius: 13px; padding: 20px 22px;
      display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap;
    }
    .highlight .amount { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; color: var(--tinta); }
    .highlight .per { font-size: 0.9rem; color: var(--muted); font-weight: 600; }
    .highlight .when { text-align: right; }
    .highlight .when .d { font-size: 1.05rem; font-weight: 800; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); padding: 0 0 8px; border-bottom: 1px solid var(--line); }
    td { padding: 11px 0; font-size: 0.86rem; border-bottom: 1px solid #f2f3f6; }
    tr:last-child td { border-bottom: none; }
    .right { text-align: right; }
    .foot { padding: 18px 34px 24px; color: var(--muted); font-size: 0.76rem; line-height: 1.7; }
    .foot .brand { color: var(--ink); font-weight: 800; }
    .note { font-size: 0.8rem; color: var(--muted); margin-top: 12px; }
    /* Oferta de pronto pago — destacada, acento ámbar de urgencia */
    .oferta { background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border: 1px solid #fdba74; border-radius: 14px; padding: 20px 22px; }
    .oferta-tag { display: inline-block; background: #b45309; color: #fff; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.04em; padding: 5px 12px; border-radius: 999px; margin-bottom: 14px; }
    .oferta-grid { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
    .oferta-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #9a6a2e; margin-bottom: 5px; }
    .oferta-amount { display: flex; align-items: baseline; gap: 12px; }
    .pp-now { font-size: 2.4rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; color: #7c2d12; }
    .pp-orig { font-size: 1.1rem; color: #b0836a; text-decoration: line-through; font-weight: 600; }
    .pp-ahorro { margin-top: 7px; font-size: 0.9rem; font-weight: 800; color: #15803d; }
    .pp-timer-wrap { text-align: right; }
    .pp-timer { font-size: 1.55rem; font-weight: 800; color: #9a3412; letter-spacing: 0.01em; }
    .pp-timer-sub { font-size: 0.72rem; color: #9a6a2e; margin-top: 3px; }
    @media (max-width: 560px) {
      .oferta-grid { flex-direction: column; align-items: flex-start; }
      .pp-timer-wrap { text-align: left; }
      .pp-now { font-size: 2rem; }
    }
    @media (max-width: 560px) {
      .doc-head, .section, .foot { padding-left: 22px; padding-right: 22px; }
      .grid2 { grid-template-columns: 1fr; gap: 16px; }
      .highlight { flex-direction: column; align-items: flex-start; }
      .highlight .when { text-align: left; }
      .h1 { font-size: 1.28rem; }
    }
    @media print {
      body { background: #fff; padding: 0; }
      .toolbar { display: none !important; }
      .doc { box-shadow: none; border: none; border-radius: 0; max-width: none; }
      .section, .doc-head { border-color: #f0eff3; }
      .adeudo, .promesa, .highlight { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .cta-pago { display: none !important; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button class="btn" id="copy-link">Copiar liga</button>
    <button class="btn btn-primary" id="download-pdf">Descargar PDF</button>
  </div>

  <div class="doc">
    <div class="cinta"></div>
    <div class="doc-head">
      <div>
        <div class="marca-nom">Sacscloud</div>
        <div class="marca-firma">{diasAtraso > 0 ? 'Sacscloud Cobranza' : 'Estado de cuenta'} · {folio}</div>
      </div>
      <div class="meta">
        <div class="eyebrow">Emitido</div>
        <div style="margin-top:4px"><b>{fmtFecha(hoy.toISOString())}</b></div>
        {empresaNombre && <div>{empresaNombre}</div>}
        {diasAtraso > 0 && <div class="sello-venc">Pago pendiente</div>}
      </div>
    </div>

    {/* ── Lo que se debe hoy ──
        El documento se manda cuando un cobro NO pasó: lo primero tiene que ser
        cuánto y desde cuándo, no el nombre del plan. Si va al corriente, el
        mismo bloque dice lo que toca y cuándo. */}
    {esRecurrente && sub.estado !== 'cancelada' && (
      <>
        <div class={diasAtraso > 0 ? 'adeudo vencido' : 'adeudo'}>
          <div>
            <span class="kk">{diasAtraso > 0 ? 'Saldo vencido' : 'Tu próximo pago'}</span>
            <div class="monto num">{money(adeudo)}</div>
            <div class="sub">
              {sub.nombre_plan} · {diasAtraso > 0 ? 'venció el' : 'se cobra el'} {fmtFecha(sub.proxima_factura)}
            </div>
            {periodosVencidos > 1 && (
              <div class="desglose">
                {periodosVencidos} periodos sin cubrir × {money(montoPagar)}
                {saldoFavor > 0 ? ` · menos ${money(saldoFavor)} a favor` : ''}
              </div>
            )}
          </div>
          {diasAtraso > 0 && (
            <div class="caja">
              <div class="g num">{diasAtraso}</div>
              <div class="t">{diasAtraso === 1 ? 'día de atraso' : 'días de atraso'}</div>
            </div>
          )}
        </div>

        {promesaVigente && (
          <div class="promesa viva">
            Quedamos en que este pago se cubre el <b>{fmtFecha(promesa)}</b>.
            {sub.cobranza_nota ? <> Nota: {sub.cobranza_nota}</> : null}
          </div>
        )}
        {promesaVencida && (
          <div class="promesa rota">
            Se acordó cubrirlo el <b>{fmtFecha(promesa)}</b> y a la fecha sigue pendiente. Escríbenos para acordar una nueva fecha.
          </div>
        )}
        {diasAtraso > 0 && sub.mp_link_pago && (
          <a class="cta-pago" href={sub.mp_link_pago} target="_blank" rel="noreferrer">Pagar {money(adeudo)}</a>
        )}
      </>
    )}

    <div class="section">
      <div class="label">Para</div>
      <div class="para-quien">
        {clienteNombre}
        {empresaNombre && empresaNombre !== clienteNombre && <div class="sub">{empresaNombre}</div>}
      </div>

      <div class="grid2" style="margin-top:20px">
        <div class="kv">
          <div class="label">Plan contratado</div>
          <div class="val">{sub.nombre_plan}</div>
        </div>
        <div class="kv">
          <div class="label">Periodicidad</div>
          <div class="val">{cicloLabel}</div>
        </div>
        <div class="kv">
          <div class="label">Estado</div>
          <div><span class="pill" style={`background:${estadoInfo.bg};color:${estadoInfo.color}`}>{estadoInfo.label}</span></div>
        </div>
        <div class="kv">
          <div class="label">Cliente desde</div>
          <div class="val">{fmtFecha(sub.fecha_inicio)}</div>
        </div>
      </div>
    </div>

    {esRecurrente && ofertaValida && (
      <div class="section">
        {ofertaValida && (
          <div id="pp-oferta">
            <div class="oferta">
              <div class="oferta-tag">🎉 Descuento por pronto pago · ahorra {ppPct}%</div>
              <div class="oferta-grid">
                <div>
                  <div class="oferta-label">Paga ahora y tu {cicloLabel.toLowerCase()} baja a</div>
                  <div class="oferta-amount">
                    <span class="num pp-now">{money(ppMonto)}</span>
                    <span class="num pp-orig">{money(montoPagar)}</span>
                  </div>
                  <div class="pp-ahorro num">Ahorras {money(ahorro)}</div>
                </div>
                <div class="pp-timer-wrap">
                  <div class="oferta-label" style="color:#8a3b00">Esta oferta termina en</div>
                  <div class="pp-timer num" id="pp-timer" data-exp={String(ppExpiraMs)}>—</div>
                  <div class="pp-timer-sub">Después vuelve a {money(montoPagar)}</div>
                </div>
              </div>
            </div>
            <div class="note">Tu fecha de pago programada es el <b>{fmtFecha(sub.proxima_factura)}</b>. Aprovecha el descuento pagando antes de que termine el contador.</div>
          </div>
        )}

      </div>
    )}

    {pays.length > 0 && (
      <div class="section">
        <div class="label" style="margin-bottom:6px">Historial de pagos</div>
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Método</th>
              <th>Referencia</th>
              <th class="right">Monto</th>
            </tr>
          </thead>
          <tbody>
            {pays.map((p: any) => (
              <tr>
                <td class="num">{fmtFechaCorta(p.fecha)}</td>
                <td>{METODO[p.metodo] || p.metodo || '—'}</td>
                <td style="color:var(--muted)">{p.numero_acuse || p.referencia || '—'}</td>
                <td class="right num" style="font-weight:700">{money(p.monto)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="foot">
      {diasAtraso > 0
        ? <>Este documento detalla el saldo pendiente de tu suscripción con <span class="brand">Sacscloud</span>.
            Si ya realizaste el pago o quieres acordar una fecha, escríbenos a <b>cobranza@sacscloud.com</b> y lo revisamos.</>
        : <>Este documento resume el estado de tu suscripción con <span class="brand">Sacscloud</span>.
            Para cualquier aclaración sobre tu plan o tus pagos, escríbenos a <b>hola@sacscloud.com</b>.</>}
      <div style="margin-top:8px">Sacscloud · www.sacscloud.com{diasAtraso > 0 ? ' · Cobranza' : ''}</div>
    </div>
  </div>

  <script>
    // Countdown de la oferta pronto pago. Al llegar a 0, oculta la oferta y
    // revela el precio regular (el precio con descuento NUNCA se cobra tarde).
    (function () {
      var el = document.getElementById('pp-timer');
      if (!el) return;
      var exp = Number(el.getAttribute('data-exp'));
      function two(n) { return String(n).padStart(2, '0'); }
      function tick() {
        var ms = exp - Date.now();
        if (ms <= 0) {
          var of = document.getElementById('pp-oferta'); if (of) of.style.display = 'none';
          return;
        }
        var s = Math.floor(ms / 1000);
        var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
        el.textContent = (d > 0 ? d + 'd ' : '') + two(h) + 'h ' + two(m) + 'm ' + two(ss) + 's';
        setTimeout(tick, 1000);
      }
      tick();
    })();

    document.getElementById('download-pdf')?.addEventListener('click', () => window.print());
    document.getElementById('copy-link')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(window.location.href);
        const prev = btn.textContent; btn.textContent = '✓ Liga copiada';
        setTimeout(() => { btn.textContent = prev; }, 1800);
      } catch { /* clipboard puede fallar sin https */ }
    });
  </script>
</body>
</html>
