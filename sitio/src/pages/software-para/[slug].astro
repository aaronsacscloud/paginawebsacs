---
// Las páginas que publica el MOTOR DE DEMANDA.
//
// `prerender = false`: se sirven al vuelo desde la base, con caché de CDN. Es lo
// que permite que el motor publique sin disparar un despliegue — y sin un
// despliegue no hay build que pagar ni ventana en la que los crons se detengan.
// El caché hace que, en la práctica, cada página se genere una vez por hora.
//
// Las páginas escritas a mano ganan sobre esta ruta: /
// sigue siendo el archivo de siempre.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContenidoMotor from '../../components/ContenidoMotor.astro';
import { leerPublicado, leerPieza, destinoSiMovida } from '../../lib/demanda/publicar';
import { getCurrentUser } from '../../lib/auth/scope';

export const prerender = false;

const { slug } = Astro.params;
/* `?borrador=1` con sesión del CRM: la vista previa real de una pieza que aún
   no está publicada. Sin sesión se ignora y se sirve solo lo publicado. */
const quierePrevia = Astro.url.searchParams.get('borrador') === '1';
const previa = quierePrevia && !!(await getCurrentUser(Astro.request).catch(() => null));
const pieza = slug ? (previa ? await leerPieza('software-para', slug, true) : await leerPublicado('software-para', slug)) : null;

if (!pieza) {
  // Movida a /guias/<giro>/…: 301, que es lo que conserva lo indexado.
  const destino = slug ? await destinoSiMovida('software-para', slug) : null;
  if (destino) return Astro.redirect(destino, 301);
  return new Response(null, { status: 404, statusText: 'No encontrado' });
}

Astro.response.headers.set('Cache-Control', previa ? 'private, no-store' : 'public, s-maxage=3600, stale-while-revalidate=86400');
---
<BaseLayout
  title={pieza.titulo}
  description={pieza.meta_desc || pieza.titulo}
  type="article"
  image={pieza.portada?.url}
  noindex={previa}
  structuredData={pieza.schema}
>
  <ContenidoMotor pieza={pieza} />
</BaseLayout>
