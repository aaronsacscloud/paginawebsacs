---
// Checklist de ENTREGA · Suite de Consignación (19-oct-2026).
//
// Un solo documento para que la orquestadora demuestre con el cliente, tableta
// en mano, un flujo ESTÁNDAR completo de punta a punta con un caso de prueba
// (una consignataria y las piezas A, B y C), y para que las particularidades
// del cliente se prueben, se decidan y se anoten ahí mismo.
//
// Tres vistas (ruta en el #hash, así el botón «atrás» funciona):
//  · Inicio            #/                 datos, avance y los procesos.
//  · Proceso (enfoque) #/p/<cap>/<etapa>  breadcrumb, lista de etapas y UNA
//                                         etapa a la vez (Demostrar, Decidir,
//                                         Dudas, Mejoras y fallas); al final
//                                         de cada proceso, su firma.
//  · Cierre            #/cierre           resumen, acuerdos, firma, historial.
//
// Lo que se captura vive en `entregas_checklist` (api/entrega/sesion), una
// fila por sesión, con ?s=<codigo> (orquestador) o ?c=<codigo> (cliente:
// solo lee y firma). Las firmas van en su propia columna. El contenido base
// está en lib/entrega/consignacion-guia.ts.
import { GUIA, CASO } from '../../lib/entrega/consignacion-guia';
export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Checklist de entrega · Suite de Consignación</title>
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <style is:inline>
    /* Estilo «Square»: blanco, gris neutro, un solo acento azul, bordes finos
       y mucho aire. El color solo dice estado (verde bien, rojo falla). */
    :root {
      --tx: #1a1a1a; --tx2: #5c5c5c; --tx3: #8f8f8f;
      --ln: #e3e3e3; --ln2: #f0f0f0; --bg: #ffffff; --bg2: #f7f7f7;
      --az: #006aff; --azh: #0055d4; --aza: #eaf2ff;
      --ve: #00a63e; --vet: #007a2e; --vea: #e7f7ec;
      --rj: #d4002b; --rjt: #b00024; --rja: #fdecef;
      --am: #c97a00; --amt: #8a5300; --ama: #fff4e0;
      --r: 8px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--bg); color: var(--tx); font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif; -webkit-text-size-adjust: 100%; }
    body { font-size: 15px; line-height: 1.5; }
    button, input, select, textarea { font: inherit; color: inherit; }
    h1 { font-size: 1.75rem; line-height: 1.2; margin: 0; font-weight: 700; letter-spacing: -.01em; }
    h2 { font-size: 1.25rem; margin: 0; font-weight: 700; letter-spacing: -.005em; }
    h3 { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--tx3); margin: 24px 0 10px; font-weight: 700; }
    .sub { color: var(--tx2); margin: 6px 0 0; }
    .oculto { display: none !important; }
    .vacio { color: var(--tx3); font-size: .875rem; padding: 6px 0; }

    /* Barra superior */
    .top { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,.96); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--ln); }
    .top .in { max-width: 1240px; margin: 0 auto; padding: 10px 20px; display: flex; gap: 12px; align-items: center; }
    .marca { font-size: .8125rem; font-weight: 700; white-space: nowrap; }
    .marca i { font-style: normal; color: var(--tx3); font-weight: 500; }
    .estado { font-size: .8125rem; color: var(--tx2); display: inline-flex; align-items: center; gap: 6px; margin-left: auto; white-space: nowrap; }
    .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--tx3); }
    .estado.ok .punto { background: var(--ve); } .estado.err .punto { background: var(--am); } .estado.sav .punto { background: var(--az); }
    .migas { max-width: 1240px; margin: 0 auto; padding: 0 20px 10px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: .875rem; }
    .migas a { color: var(--az); text-decoration: none; font-weight: 500; cursor: pointer; }
    .migas a:hover { text-decoration: underline; }
    .migas .sep { color: var(--tx3); }
    .migas .act { color: var(--tx); font-weight: 600; }

    /* Botones */
    .btn { text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 16px; border-radius: var(--r); border: 1px solid #d4d4d4; background: #fff; color: var(--tx); font-weight: 600; font-size: .875rem; cursor: pointer; white-space: nowrap; -webkit-tap-highlight-color: transparent; }
    .btn:hover { background: var(--bg2); }
    .btn.pri { background: var(--az); border-color: var(--az); color: #fff; }
    .btn.pri:hover { background: var(--azh); }
    .btn.peq { min-height: 36px; padding: 0 12px; font-size: .8125rem; }
    .btn.del { color: var(--rjt); }
    .btn.on { background: var(--tx); border-color: var(--tx); color: #fff; }
    .btn:disabled { opacity: .45; cursor: default; }
    .menu { position: relative; }
    .menu-lista { position: absolute; right: 0; top: calc(100% + 6px); background: #fff; border: 1px solid var(--ln); border-radius: var(--r); box-shadow: 0 8px 24px rgba(0,0,0,.08); min-width: 220px; padding: 6px; z-index: 40; }
    .menu-lista button { display: block; width: 100%; text-align: left; border: 0; background: none; padding: 10px 12px; border-radius: 6px; font-weight: 500; cursor: pointer; }
    .menu-lista button:hover { background: var(--bg2); }

    /* Campos */
    label.f { display: flex; flex-direction: column; gap: 6px; font-size: .8125rem; font-weight: 600; color: var(--tx2); }
    input[type=text], input[type=date], select, textarea { width: 100%; border: 1px solid #d4d4d4; border-radius: var(--r); padding: 10px 12px; background: #fff; font-size: 15px; font-weight: 400; color: var(--tx); min-height: 44px; }
    textarea { resize: vertical; min-height: 64px; }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--az); outline-offset: -1px; border-color: var(--az); }
    input:disabled, select:disabled, textarea:disabled { background: var(--bg2); color: var(--tx); opacity: 1; -webkit-text-fill-color: var(--tx); }
    .grid { display: grid; gap: 12px 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .acciones { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }

    /* Inicio */
    .wrap { max-width: 1240px; margin: 0 auto; padding: 28px 20px 120px; }
    .panel { border: 1px solid var(--ln); border-radius: 12px; padding: 20px; background: #fff; }
    .panel + .panel { margin-top: 16px; }
    .datos { display: grid; gap: 0; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--ln); border-radius: 12px; margin-top: 20px; }
    .datos div { padding: 14px 16px; border-left: 1px solid var(--ln); }
    .datos div:first-child { border-left: 0; }
    .datos span { display: block; font-size: .75rem; color: var(--tx3); font-weight: 500; }
    .datos b { font-weight: 600; }
    .kpis { display: grid; gap: 16px; grid-template-columns: repeat(4, 1fr); margin-top: 24px; }
    .kpi { border: 1px solid var(--ln); border-radius: 12px; padding: 16px 18px; }
    .kpi .l { font-size: .8125rem; color: var(--tx2); font-weight: 500; }
    .kpi .c { font-size: 2rem; font-weight: 700; letter-spacing: -.02em; margin-top: 2px; display: block; }
    .kpi .s { font-size: .8125rem; color: var(--tx3); }
    .kpi.rj .c { color: var(--rjt); }
    .caps { display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); }
    .cap.cierre { background: var(--bg2); }
    .cap { text-align: left; background: #fff; border: 1px solid var(--ln); border-radius: 12px; padding: 18px; cursor: pointer; display: flex; flex-direction: column; gap: 6px; min-height: 168px; transition: border-color .15s, box-shadow .15s; }
    .cap:hover { border-color: #bdbdbd; box-shadow: 0 4px 16px rgba(0,0,0,.06); }
    .cap .k { font-size: .75rem; font-weight: 600; color: var(--tx3); }
    .cap .nm { font-weight: 700; font-size: 1.0625rem; line-height: 1.3; }
    .cap .rs { font-size: .8125rem; color: var(--tx2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .cap .pie { margin-top: auto; display: flex; gap: 10px; align-items: center; font-size: .8125rem; color: var(--tx2); }
    .bar { flex: 1; height: 4px; background: var(--ln2); border-radius: 99px; overflow: hidden; }
    .bar i { display: block; height: 100%; background: var(--az); }
    .cap.done .bar i { background: var(--ve); }
    .cap .abrir { color: var(--az); font-weight: 600; font-size: .8125rem; }

    /* Vista de proceso: lista de etapas + una etapa a la vez */
    .proc { max-width: 1240px; margin: 0 auto; padding: 24px 20px 120px; display: grid; grid-template-columns: 280px 1fr; gap: 32px; align-items: start; }
    .pasos { position: sticky; top: 112px; border: 1px solid var(--ln); border-radius: 12px; padding: 8px; max-height: calc(100vh - 130px); overflow: auto; }
    .pasos .tit { padding: 10px 10px 6px; font-size: .75rem; color: var(--tx3); font-weight: 600; }
    .pasos .tit b { display: block; color: var(--tx); font-size: .9375rem; margin-top: 2px; }
    .pasos .bar { margin: 8px 10px 10px; }
    .paso { display: flex; gap: 10px; align-items: flex-start; width: 100%; text-align: left; border: 0; background: none; padding: 9px 10px; border-radius: 8px; cursor: pointer; font-size: .875rem; color: var(--tx2); }
    .paso:hover { background: var(--bg2); }
    .paso.on { background: var(--aza); color: var(--tx); font-weight: 600; }
    .paso .ic { flex: 0 0 auto; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid #c4c4c4; margin-top: 2px; display: inline-flex; align-items: center; justify-content: center; }
    .paso .ic.parcial { border-color: var(--az); background: linear-gradient(90deg, var(--az) 50%, transparent 50%); }
    .paso .ic.ok { border-color: var(--ve); background: var(--ve); }
    .paso .ic.falla { border-color: var(--rj); background: var(--rj); }
    .paso .ic svg { display: block; }
    .paso .tx { flex: 1; min-width: 0; }
    .paso .mt { display: block; font-size: .75rem; color: var(--tx3); font-weight: 500; }
    .sel-pasos { display: none; margin-bottom: 16px; }
    .foco-cab .k { font-size: .8125rem; color: var(--tx3); font-weight: 600; }
    .foco-cab h1 { margin-top: 4px; }
    .foco-meta { margin-top: 14px; display: grid; gap: 8px; }
    .foco-meta div { font-size: .9375rem; color: var(--tx2); }
    .foco-meta b { color: var(--tx); font-weight: 600; }
    .etiqueta { display: inline-flex; align-items: center; gap: 6px; font-size: .75rem; font-weight: 600; border-radius: 99px; padding: 3px 10px; background: var(--bg2); color: var(--tx2); }
    .etiqueta.ve { background: var(--vea); color: var(--vet); }
    .foco-pie { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--ln); }
    .nota-calc { margin-top: 14px; font-size: .875rem; background: var(--bg2); border-radius: var(--r); padding: 12px 14px; color: var(--tx2); }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { font-size: .8125rem; background: var(--bg2); border-radius: 6px; padding: 4px 9px; color: var(--tx2); }
    .chip.fil { background: var(--aza); color: var(--azh); }

    /* Puntos a validar */
    .lista { border: 1px solid var(--ln); border-radius: 12px; }
    .pt { display: grid; grid-template-columns: 1fr auto; gap: 10px 16px; align-items: center; padding: 14px 16px; border-top: 1px solid var(--ln); }
    .pt:first-child { border-top: 0; }
    .pt .txt { font-size: .9375rem; }
    .ctrl { display: flex; gap: 8px; align-items: center; }
    .seg { display: inline-flex; border: 1px solid #d4d4d4; border-radius: var(--r); overflow: hidden; }
    .seg button { border: 0; background: #fff; min-height: 40px; min-width: 84px; padding: 0 12px; font-size: .8125rem; font-weight: 600; color: var(--tx2); cursor: pointer; border-left: 1px solid #d4d4d4; }
    .seg button:first-child { border-left: 0; }
    .seg button.on.ok { background: var(--vea); color: var(--vet); }
    .seg button.on.falla { background: var(--rja); color: var(--rjt); }
    .seg button.on.na { background: var(--ln2); color: var(--tx); }
    .seg button:disabled { cursor: default; }
    .pt .nota { grid-column: 1 / -1; display: none; }
    .pt.con-nota .nota { display: block; }
    .pt .nota textarea { min-height: 52px; }
    .ta { position: relative; }
    .ta textarea { padding-right: 48px; }
    .mic { position: absolute; right: 6px; top: 6px; width: 34px; height: 34px; border-radius: 6px; border: 1px solid var(--ln); background: #fff; color: var(--tx2); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
    .mic.on { background: var(--rja); color: var(--rjt); border-color: #f3c2ca; animation: latido 1.2s infinite; }
    @keyframes latido { 50% { opacity: .55; } }
    .sin-voz .mic { display: none; }
    .sin-voz .ta textarea { padding-right: 12px; }
    .nrs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .nr { border: 1px solid var(--ln); background: #fff; color: var(--tx2); border-radius: 99px; padding: 5px 11px; font-size: .75rem; font-weight: 600; cursor: pointer; }
    .nr:hover { border-color: #bdbdbd; color: var(--tx); }
    .fotos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .fotos:empty { display: none; }
    .foto { position: relative; width: 84px; height: 84px; border-radius: 8px; overflow: hidden; border: 1px solid var(--ln); background: var(--bg2); }
    .foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .foto button { position: absolute; top: 3px; right: 3px; width: 24px; height: 24px; border-radius: 50%; border: 0; background: rgba(0,0,0,.6); color: #fff; font-size: 12px; cursor: pointer; }
    .foto.subiendo { display: flex; align-items: center; justify-content: center; font-size: .6875rem; color: var(--tx3); }
    body.pend .pt.hecho { display: none; }

    /* Sugerencias y hallazgos */
    .sug { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border: 1px dashed #cfcfcf; border-radius: var(--r); margin-top: 8px; }
    .sug .tp { font-size: .6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--azh); background: var(--aza); border-radius: 4px; padding: 2px 6px; white-space: nowrap; }
    .sug .tx { flex: 1; font-size: .875rem; }
    .sug.usada { opacity: .45; }
    .hall { border: 1px solid var(--ln); border-radius: 12px; padding: 14px 16px; margin-top: 10px; }
    .hrow { display: grid; gap: 10px 12px; align-items: end; }
    .hrow.a { grid-template-columns: 180px 1fr 1fr; align-items: start; }
    .hrow.b { grid-template-columns: repeat(4, minmax(0, 1fr)) auto; margin-top: 10px; }
    .hall textarea { min-height: 48px; }
    .lbl { display: block; font-size: .75rem; font-weight: 600; color: var(--tx3); margin-bottom: 4px; }
    .hall .acc { display: flex; gap: 6px; }
    .hall .x, .ctrl .x { width: 40px; padding: 0; }

    /* Firma */
    .firma-box { margin-top: 28px; border: 1px solid var(--ln); border-radius: 12px; padding: 18px; background: var(--bg2); }
    .firma-box h4 { margin: 0 0 4px; font-size: 1rem; font-weight: 700; }
    .firma-box .ley { font-size: .875rem; color: var(--tx2); margin: 0 0 12px; }
    .pad { position: relative; border: 1px dashed #bdbdbd; border-radius: var(--r); background: #fff; touch-action: none; height: 150px; }
    .pad svg { width: 100%; height: 100%; display: block; }
    .pad .ph { position: absolute; left: 12px; bottom: 10px; font-size: .75rem; color: var(--tx3); pointer-events: none; }
    .pad.con .ph { display: none; }
    .chk { display: flex; gap: 10px; align-items: center; font-size: .9375rem; margin-top: 12px; }
    .chk input { width: 22px; height: 22px; accent-color: var(--az); }
    .firmado { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    .firmado svg { width: 220px; height: 55px; border-bottom: 1px solid #bdbdbd; }
    .firmado .q { font-size: .875rem; color: var(--tx2); }
    .firmado .q b { color: var(--tx); }
    .aviso-cambio { margin-top: 12px; font-size: .875rem; background: var(--ama); color: var(--amt); border-radius: var(--r); padding: 10px 12px; }

    /* Mapa */
    .mapa svg { width: 100%; height: auto; display: block; margin-top: 8px; }
    .mapa .nd { cursor: pointer; }
    .mapa .nd:hover rect { fill: #f2f6ff; }
    .mapa .lec { margin-top: 12px; font-size: .9375rem; color: var(--tx2); }

    /* Resumen */
    .resumen-t { width: 100%; border-collapse: collapse; font-size: .875rem; margin-top: 12px; }
    .resumen-t th { text-align: left; font-size: .75rem; color: var(--tx3); font-weight: 600; padding: 8px; border-bottom: 1px solid var(--ln); }
    .resumen-t td { padding: 10px 8px; border-bottom: 1px solid var(--ln2); vertical-align: top; }
    .resumen-t td.pr { color: var(--tx2); font-size: .8125rem; }
    .tag { font-size: .75rem; font-weight: 600; border-radius: 99px; padding: 2px 9px; white-space: nowrap; display: inline-block; }
    .tag.Alta { background: var(--rja); color: var(--rjt); } .tag.Media { background: var(--ama); color: var(--amt); } .tag.Baja { background: var(--ln2); color: var(--tx2); }
    .filtro-res { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
    .pill { border: 1px solid var(--ln); background: #fff; border-radius: 99px; padding: 6px 12px; font-size: .8125rem; font-weight: 600; color: var(--tx2); cursor: pointer; }
    .pill.on { background: var(--tx); border-color: var(--tx); color: #fff; }
    .hist { list-style: none; padding: 0; margin: 8px 0 0; max-height: 420px; overflow: auto; }
    .hist li { display: grid; grid-template-columns: 130px 1fr; gap: 12px; padding: 9px 0; border-top: 1px solid var(--ln2); font-size: .875rem; }
    .hist li span { color: var(--tx3); }

    /* Inicio sin sesión, modal, toast */
    .inicio { max-width: 560px; margin: 48px auto; padding: 0 20px; }
    .recientes a { display: block; padding: 10px 0; border-top: 1px solid var(--ln2); color: var(--az); text-decoration: none; font-weight: 600; }
    .recientes a span { color: var(--tx3); font-weight: 400; font-size: .8125rem; margin-left: 6px; }
    .modal-fondo { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 60; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .modal { background: #fff; border-radius: 12px; max-width: 560px; width: 100%; padding: 24px; max-height: 90vh; overflow: auto; }
    .modal .liga { font-size: .8125rem; background: var(--bg2); border-radius: var(--r); padding: 10px 12px; word-break: break-all; margin: 12px 0; }
    .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%) translateY(20px); background: var(--tx); color: #fff; padding: 12px 16px; border-radius: var(--r); font-size: .875rem; opacity: 0; transition: .25s; pointer-events: none; z-index: 70; max-width: calc(100% - 32px); }
    .toast.on { opacity: 1; transform: translateX(-50%) translateY(0); }
    body.ro .solo-orq { display: none !important; }
    #imprimir { display: none; }

    /* v2: inicio en orden, bloques por etapa, caso de prueba, cierre de proceso */
    .pitch { margin-top: 18px; border: 1px solid #cfe0ff; background: var(--aza); border-radius: 12px; padding: 16px 18px; font-size: 1rem; line-height: 1.6; }
    .pitch .lbl { color: var(--azh); margin-bottom: 6px; }
    .ritmo { margin-top: 18px; border: 1px solid var(--ln); border-radius: 12px; padding: 14px 16px; background: var(--bg2); font-size: .9375rem; color: var(--tx2); }
    .seg.modo button { min-width: 0; min-height: 34px; padding: 0 14px; }
    .seg.modo button.on { background: var(--tx); color: #fff; }
    .modo-cab { display: inline-flex; gap: 6px; align-items: center; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--azh); background: var(--aza); border-radius: 99px; padding: 3px 10px; }
    .procs { border: 1px solid var(--ln); border-radius: 12px; overflow: hidden; }
    .prow { display: grid; grid-template-columns: 40px 1fr 200px 20px; gap: 16px; align-items: center; width: 100%; text-align: left; background: #fff; border: 0; border-top: 1px solid var(--ln); padding: 16px 18px; cursor: pointer; }
    .prow:first-child { border-top: 0; }
    .prow:hover { background: var(--bg2); }
    .prow .n { width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid #cfcfcf; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: .875rem; color: var(--tx2); }
    .prow.ok .n { background: var(--ve); border-color: var(--ve); color: #fff; }
    .prow.firm .n { background: var(--tx); border-color: var(--tx); color: #fff; }
    .prow .nm { font-weight: 700; font-size: 1rem; display: block; }
    .prow .rs { font-size: .8125rem; color: var(--tx2); display: block; margin-top: 2px; }
    .prow .av { font-size: .8125rem; color: var(--tx2); display: grid; gap: 6px; }
    .prow .av .bar { flex: none; }
    .prow .ch { color: var(--tx3); }
    .prow.fin { background: var(--bg2); }
    .interruptor { display: inline-flex; gap: 10px; align-items: center; cursor: pointer; font-size: .875rem; font-weight: 600; }
    .interruptor input { width: 40px; height: 22px; accent-color: var(--az); }
    .fila-ops { display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: 28px; }
    .caso-mini { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .caso-mini span { font-size: .8125rem; background: var(--bg2); border: 1px solid var(--ln); border-radius: 6px; padding: 4px 9px; color: var(--tx2); }
    .caso-mini b { color: var(--tx); font-weight: 600; }
    .caso-mini .vacio-c { color: var(--rjt); background: var(--rja); border-color: #f3c2ca; }
    .bloque { margin-top: 28px; }
    .bloque > h3 { margin-top: 0; display: flex; gap: 8px; align-items: center; }
    .bloque > h3 .num-b { display: inline-flex; width: 20px; height: 20px; border-radius: 50%; background: var(--tx); color: #fff; font-size: .6875rem; align-items: center; justify-content: center; letter-spacing: 0; }
    .hd { display: grid; gap: 4px; }
    .hd .h, .hd .d { font-size: .9375rem; }
    .hd .lb { display: inline-block; min-width: 86px; font-size: .6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--tx3); }
    .hd .d .lb { color: var(--vet); }
    .opc { font-size: .6875rem; font-weight: 600; color: var(--tx3); border: 1px solid var(--ln); border-radius: 99px; padding: 1px 8px; margin-left: 6px; vertical-align: middle; }
    body.corta .pt.opcional { display: none; }
    .dec { border: 1px solid var(--ln); border-radius: 12px; }
    .dec .q { padding: 14px 16px; border-top: 1px solid var(--ln); display: grid; gap: 8px; }
    .dec .q:first-child { border-top: 0; }
    .dec .q .t { font-size: .9375rem; font-weight: 600; }
    .dec .q.listo .t::after { content: '  ✓'; color: var(--ve); }
    .docs { margin-top: 18px; }
    .docs .lbl { display: block; font-size: .6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--tx3); margin-bottom: 8px; }
    .docs-l { display: flex; gap: 10px; flex-wrap: wrap; }
    .doc { display: flex; gap: 12px; align-items: center; border: 1px solid var(--ln); border-radius: 12px; padding: 12px 16px; background: #fff; color: var(--tx); text-decoration: none; min-width: 240px; }
    .doc:hover { background: var(--bg2); }
    .doc .ic { flex: none; width: 38px; height: 44px; border-radius: 6px; background: var(--rja); color: var(--rjt); font-size: .6875rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; }
    .doc b { display: block; font-size: .9375rem; }
    .doc small { display: block; font-size: .8125rem; color: var(--tx2); margin-top: 2px; }
    .nohace { border: 1px solid #f2dfb8; background: var(--ama); border-radius: 12px; padding: 14px 16px; }
    .nohace .tit { font-size: .8125rem; color: var(--amt); font-weight: 700; }
    .nohace .tit span { font-weight: 500; }
    .nohace .it { display: flex; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid #f2dfb8; font-size: .875rem; }
    .nohace .it:first-of-type { border-top: 0; }
    .nohace .it span { flex: 1; }
    .duda { border: 1px solid var(--ln); border-radius: 12px; padding: 12px 14px; margin-top: 10px; display: grid; gap: 10px; }
    .duda .fila { display: grid; grid-template-columns: 1fr 180px auto auto; gap: 10px; align-items: end; }
    .duda.resuelta { background: var(--vea); border-color: #c6ead3; }
    .caso-form { display: grid; gap: 14px 16px; grid-template-columns: repeat(2, 1fr); margin-top: 16px; }
    .fin-res { display: grid; gap: 12px; grid-template-columns: repeat(4, 1fr); margin-top: 20px; }
    .fin-res div { border: 1px solid var(--ln); border-radius: 12px; padding: 14px; }
    .fin-res span { display: block; font-size: .8125rem; color: var(--tx2); }
    .fin-res b { font-size: 1.5rem; }
    .lista-cierre { border: 1px solid var(--ln); border-radius: 12px; margin-top: 10px; }
    .lista-cierre .li { padding: 12px 16px; border-top: 1px solid var(--ln2); font-size: .875rem; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; }
    .lista-cierre .li:first-child { border-top: 0; }
    .lista-cierre .li .w { color: var(--tx3); font-size: .8125rem; }
    @media (max-width: 1000px) {
      .prow { grid-template-columns: 36px 1fr 20px; }
      .prow .av { grid-column: 2; }
      .caso-form { grid-template-columns: 1fr; }
      .fin-res { grid-template-columns: repeat(2, 1fr); }
      .duda .fila { grid-template-columns: 1fr 1fr; }
      .caps { grid-template-columns: repeat(2, 1fr); }
      .datos { grid-template-columns: repeat(3, 1fr); }
      .datos div:nth-child(4) { border-left: 0; }
      .datos div:nth-child(n+4) { border-top: 1px solid var(--ln); }
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .proc { grid-template-columns: 1fr; gap: 20px; }
      .pasos { display: none; }
      .sel-pasos { display: block; }
      .hrow.a { grid-template-columns: 1fr; }
      .hrow.b { grid-template-columns: 1fr 1fr; }
      .hall .acc { grid-column: 1 / -1; }
      .marca i { display: none; }
    }
    @media (max-width: 620px) {
      .caps { grid-template-columns: 1fr; }
      .pt { grid-template-columns: 1fr; }
      .ctrl { flex-wrap: wrap; }
      .seg { width: 100%; } .seg button { flex: 1; min-width: 0; }
    }
    @media print {
      body > *:not(#imprimir) { display: none !important; }
      #imprimir { display: block !important; padding: 0 8px; }
      .mic, .nrs, .solo-orq, .acciones, .sug, .foco-pie { display: none !important; }
      body { font-size: 11.5px; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .imp-sec { break-inside: avoid-page; margin-top: 22px; padding-top: 14px; border-top: 1px solid #e3e3e3; }
      .imp-cap { break-before: page; }
      .imp-cap:first-of-type { break-before: auto; }
    }
  </style>
</head>
<body>

  <!-- Sin ?s ni ?c: crear o abrir una sesión -->
  <div id="inicio" class="oculto">
    <div class="inicio">
      <div class="marca">Sacscloud <i>· Checklist de entrega</i></div>
      <h1 style="margin-top:10px">Suite de Consignación</h1>
      <p class="sub">Demostración con el cliente de los flujos de la suite, de inicio a fin, con un caso de prueba.</p>
      <div class="panel" style="margin-top:24px">
        <h2>Nueva sesión</h2>
        <p class="sub">Vende Tu Closet · Producción · orquesta Andrea Araujo. Se crea una liga propia; lo que se capture se guarda solo y se abre en cualquier dispositivo con la misma liga.</p>
        <div class="acciones"><button class="btn pri" id="btnNueva">Crear sesión</button></div>
      </div>
      <div class="panel">
        <h2>Abrir una sesión</h2>
        <div class="grid" style="margin-top:12px"><label class="f">Liga o código<input type="text" id="abrirCodigo" placeholder="Pega la liga de la sesión" autocomplete="off" /></label></div>
        <div class="acciones"><button class="btn" id="btnAbrir">Abrir</button></div>
        <div id="recientes" class="recientes" style="margin-top:8px"></div>
      </div>
    </div>
  </div>

  <div id="app" class="oculto">
    <header class="top">
      <div class="in">
        <span class="marca">Sacscloud <i>· Checklist de entrega · Suite de Consignación</i></span>
        <div class="seg modo" id="modo" role="tablist" aria-label="Sesión"><button data-modo="dueno">Dueño</button><button data-modo="equipo">Equipo</button></div>
        <span class="estado" id="estado"><span class="punto"></span><span id="estadoTxt">Cargando…</span></span>
        <button class="btn peq solo-orq oculto" id="btnPend">Solo pendientes</button>
        <button class="btn peq pri solo-orq" id="btnEnviar">Enviar al cliente</button>
        <div class="menu">
          <button class="btn peq" id="btnMas" aria-haspopup="true">Más</button>
          <div class="menu-lista oculto" id="menuMas">
            <button data-acc="pdf">Imprimir / PDF</button>
            <button data-acc="csv">Exportar a Excel</button>
            <button data-acc="liga" class="solo-orq">Copiar mi liga de orquestador</button>
            <button data-acc="cierre">Resumen y cierre</button>
          </div>
        </div>
      </div>
      <nav class="migas" id="migas" aria-label="Ruta"></nav>
    </header>

    <!-- INICIO -->
    <main id="vInicio" class="wrap oculto">
      <h1>Entrega · Suite de Consignación</h1>
      <p class="sub" id="intro"></p>
      <div class="datos" id="datos"></div>
      <div class="kpis" id="kpis"></div>
      <div class="fila-ops">
        <div>
          <h3 style="margin:0">Caso de prueba</h3>
          <div class="caso-mini" id="casoMini"></div>
        </div>
        <label class="interruptor solo-orq" title="Oculta los puntos opcionales para una sesión más corta"><input type="checkbox" id="chkCorta" /> Sesión corta: solo lo esencial</label>
      </div>
      <h3 style="margin-top:28px" id="titProcs">Procesos, en el orden en que vive una pieza</h3>
      <div class="procs" id="caps"></div>
      <div class="grid solo-orq" style="margin-top:20px; max-width:480px">
        <label class="f">Quién revisa por parte del cliente (opcional)<input type="text" data-meta="responsable" placeholder="Nombre" /></label>
      </div>
    </main>

    <!-- PROCESO (enfoque) -->
    <main id="vProceso" class="proc oculto">
      <aside class="pasos" id="pasos"></aside>
      <section>
        <select class="sel-pasos" id="selPasos" aria-label="Etapa"></select>
        <div id="foco"></div>
        <div class="foco-pie">
          <button class="btn" id="btnAnt">← Anterior</button>
          <button class="btn pri" id="btnSig">Siguiente →</button>
        </div>
      </section>
    </main>

    <!-- CIERRE -->
    <main id="vCierre" class="wrap oculto">
      <h1>Resumen y cierre</h1>
      <p class="sub">Lo que salió de la sesión: fallas por corregir, mejoras, dudas y decisiones del cliente.</p>
      <div class="filtro-res" id="filtroRes"></div>
      <div id="resumen"></div>
      <h3>Acuerdos de la sesión</h3>
      <div class="ta"><textarea data-cierre="acuerdos" placeholder="Lo que quedó decidido y los siguientes pasos"></textarea><button type="button" class="mic solo-orq" title="Dictar"></button></div>
      <div id="firmaCierre"></div>
      <div class="grid" style="margin-top:16px; max-width:480px">
        <label class="f">Orquestador Sacscloud que valida<input type="text" data-cierre="firmaSacs" /></label>
      </div>
      <h3 style="margin-top:36px">Historial de cambios</h3>
      <ul class="hist" id="hist"></ul>
    </main>
  </div>

  <div id="imprimir"></div>
  <div class="toast" id="toast"></div>
  <input type="file" id="fotoInput" accept="image/*" hidden />

  <script is:inline define:vars={{ GUIA, CASO }}>
  (function () {
    const ID_GUIA = 'consignacion-suite-v2';
    const API = '/api/entrega/sesion';
    const API_FOTO = '/api/entrega/foto';
    const LS = 'entrega:' + ID_GUIA + ':';
    const PRIOS = ['Alta', 'Media', 'Baja'];
    const DECIS = ['Pendiente', 'Aprobado', 'Descartado', 'Hecho'];
    const RESPS = ['Sacscloud', 'Cliente', 'Ambos'];
    const NOTAS_RAPIDAS = ['Funciona como lo necesitan', 'Funciona, pero confunde', 'Lo quieren distinto', 'No lo usan', 'Revisar con la dueña', 'Faltan datos del cliente'];
    const RES = { ok: 'Correcto', falla: 'Falla', na: 'No aplica', '': 'Sin revisar' };
    const FIJOS = { cliente: 'Vende Tu Closet', cuenta: 'vendetucloset', consultor: 'Andrea Araujo', ambiente: 'Producción' };
    const ICO_MIC = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>';
    const ICO_OK = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="4"><path d="M5 12l5 5 9-10"/></svg>';
    const $ = (s, r) => (r || document).querySelector(s);
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const sel = id => '#s-' + CSS.escape(id);

    let ROL = 'orq', codigo = null, cc = null;
    let S = null, F = {}, actualizado = '', base = null, timer = null, guardando = false, pendiente = false, reintento = null, filtroRes = '';
    let ruta = { v: 'inicio', cap: null, paso: null };
    const esCliente = () => ROL === 'cliente';

    function toast(t) { const el = $('#toast'); el.textContent = t; el.classList.add('on'); clearTimeout(el._t); el._t = setTimeout(() => el.classList.remove('on'), 2800); }
    function nuevoCodigo() { const a = new Uint8Array(12); crypto.getRandomValues(a); return Array.from(a, b => (b % 36).toString(36)).join('') + Date.now().toString(36).slice(-4); }
    function hoyLocal() { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
    function vacio() { return { meta: { cliente: FIJOS.cliente, cuenta: FIJOS.cuenta, fecha: hoyLocal(), consultor: FIJOS.consultor, responsable: '', ambiente: FIJOS.ambiente }, caso: {}, sec: {}, extras: [], procNota: {}, cierre: { acuerdos: '', firmaSacs: FIJOS.consultor }, corta: false, vista: 'dueno', log: [], _ts: Date.now() }; }
    function capDe(id) { return GUIA.capitulos.find(c => c.id === id) || GUIA.capitulos[0]; }
    function secsDe(cap) { return cap.secciones.concat((S.extras || []).filter(x => x.cap === cap.id)); }
    function est(id) {
      if (!S.sec[id]) S.sec[id] = {};
      const e = S.sec[id];
      e.puntos = e.puntos || {}; e.extra = e.extra || []; e.hall = e.hall || []; e.ocultos = e.ocultos || {}; e.dec = e.dec || {}; e.dudas = e.dudas || []; e.usadas = e.usadas || {};
      return e;
    }
    function secPorId(id) { for (const c of GUIA.capitulos) { const s = secsDe(c).find(x => x.id === id); if (s) return { cap: c, s }; } return null; }
    function corto(t, n) { t = String(t || ''); return t.length > (n || 60) ? t.slice(0, (n || 60) - 1) + '…' : t; }
    function numCap(cap) { return GUIA.capitulos.indexOf(cap); }
    function etiquetaCap(cap) { return cap.id === 'rep' ? 'Revisión final' : numCap(cap) === 0 ? 'Preparación' : 'Proceso ' + numCap(cap); }
    // Sesión con el DUEÑO (visión y reglas) o con el EQUIPO (detalle en pantalla).
    const esDueno = () => S.vista === 'dueno';
    function secsModo(cap, modo) { const d = (modo || S.vista) === 'dueno'; return secsDe(cap).filter(s => !!s.dueno === d); }
    function secDueno(cap) { return secsDe(cap).find(s => s.dueno); }
    function firmaId(cap, modo) { return cap.id + ((modo || S.vista) === 'dueno' ? '-d' : '-e'); }
    function numSec(cap, s) { return secsModo(cap).indexOf(s) + 1; }
    function pct(a, b) { return (b ? Math.round(a * 100 / b) : 0) + '%'; }
    function demos(s) { return s.demostrar || []; }
    function txtPunto(s, e, key) { if (key[0] === 'x') { const p = e.extra[+key.slice(1)]; return (p && p.t) || 'Punto agregado'; } const p = demos(s)[+key.slice(1)]; return p ? p.h + ' → ' + p.d : ''; }
    // Un punto cuenta si no lo quitó el orquestador y, en sesión corta, si es esencial.
    function cuenta(s, e, k) { const p = demos(s)[k]; return !e.ocultos[k] && !(S.corta && p && p.o); }

    // ── Historial ─────────────────────────────────────────────────────────
    function quien() { return esCliente() ? 'Cliente' : (S.meta.consultor || 'Orquestador'); }
    function logEv(texto) {
      if (esCliente()) return;
      S.log = S.log || []; S.log.push({ t: new Date().toISOString(), q: quien(), a: texto });
      if (S.log.length > 800) S.log = S.log.slice(-800);
    }
    function fechaCorta(iso) { try { return new Date(iso).toLocaleString('es-MX', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (e) { return iso; } }
    function pintarHist() {
      if (ruta.v !== 'cierre') return;
      const ev = (S.log || []).map(x => ({ t: x.t, q: x.q, a: x.a }));
      Object.keys(F).forEach(id => { const f = F[id]; const base = id.replace(/-[de]$/, ''); const nm = id === '__cierre' ? 'Cierre de la sesión' : (GUIA.capitulos.some(c => c.id === base) ? etiquetaCap(capDe(base)) + ' · ' + capDe(base).nombre + (/-d$/.test(id) ? ' (dueño)' : /-e$/.test(id) ? ' (equipo)' : '') : id); ev.push({ t: f.at, q: f.nombre + (f.desde === 'cliente' ? ' (desde su liga)' : ''), a: 'Firmó de enterado y aceptado · ' + nm }); });
      ev.sort((a, b) => (a.t < b.t ? 1 : -1));
      $('#hist').innerHTML = ev.length ? ev.slice(0, 300).map(x => '<li><span>' + esc(fechaCorta(x.t)) + '</span><div><b>' + esc(x.q) + '</b> · ' + esc(x.a) + '</div></li>').join('') : '<li><span></span><div class="vacio">Sin movimientos todavía.</div></li>';
    }

    // ── Guardado ───────────────────────────────────────────────────────────
    function local() { if (esCliente()) return; try { localStorage.setItem(LS + codigo, JSON.stringify(S)); } catch (e) {} }
    const clon = x => JSON.parse(JSON.stringify(x === undefined ? null : x));
    function guardarBase(datos, at) { base = clon(datos); actualizado = at || actualizado; if (esCliente()) return; try { localStorage.setItem(LS + codigo + ':base', JSON.stringify({ at: actualizado, d: base })); } catch (e) {} }

    // Fusión a tres bandas: «b» es lo último que este dispositivo vio del
    // servidor, «l» lo que tiene ahora y «r» lo que guardó otra tableta.
    // Lo que solo cambió de un lado se toma de ese lado; si los dos cambiaron
    // el mismo dato, gana este dispositivo. Así dos tabletas pueden llenar
    // procesos distintos al mismo tiempo sin borrarse nada. Modifica «l» en su
    // lugar para que los campos abiertos en pantalla sigan escribiendo en S.
    const igual = (a, b) => JSON.stringify(a) === JSON.stringify(b);
    const esObj = x => !!x && typeof x === 'object' && !Array.isArray(x);
    function fusionar(b, l, r) {
      if (igual(l, r) || igual(r, b)) return l;
      if (esObj(l) && esObj(r)) {
        const bb = esObj(b) ? b : {};
        new Set(Object.keys(l).concat(Object.keys(r))).forEach(k => {
          const v = fusionar(bb[k], l[k], r[k]);
          if (v === undefined) delete l[k]; else if (v !== l[k]) l[k] = v;
        });
        return l;
      }
      if (Array.isArray(l) && Array.isArray(r)) {
        const bb = Array.isArray(b) ? b : [], n = bb.length;
        if (l.length < n || r.length < n) { if (igual(l, bb)) l.splice(0, l.length, ...clon(r)); return l; }
        for (let i = 0; i < n; i++) { const v = fusionar(bb[i], l[i], r[i]); if (v !== l[i]) l[i] = v; }
        const vistos = new Set(l.map(x => JSON.stringify(x)));
        r.slice(n).forEach(x => { const k = JSON.stringify(x); if (!vistos.has(k)) { vistos.add(k); l.push(clon(x)); } });
        return l;
      }
      if (igual(l, b)) return r === undefined ? undefined : clon(r);
      return l;
    }
    // Junta en S lo que otra tableta guardó. Devuelve true si cambió algo en pantalla.
    function fusionarS(rem) {
      const antes = JSON.stringify(S), v = S.vista, ts = S._ts;
      fusionar(base || {}, S, rem || {});
      S.vista = v; S._ts = ts;
      if (Array.isArray(S.log)) S.log.sort((a, b) => (a.t < b.t ? -1 : a.t > b.t ? 1 : 0));
      return JSON.stringify(S) !== antes;
    }
    let repintar = false;
    function repintarSiSePuede() {
      if (ocupado()) { repintar = true; return; }
      repintar = false; const y = window.scrollY; render(); window.scrollTo(0, y);
    }
    document.addEventListener('focusout', () => { if (repintar) setTimeout(() => { if (repintar && !ocupado()) repintarSiSePuede(); }, 300); });
    function recordar() {
      try {
        const r = JSON.parse(localStorage.getItem(LS + 'recientes') || '[]').filter(x => x.c !== codigo);
        r.unshift({ c: codigo, n: (S.meta.cliente || 'Sesión') + ' · ' + (S.meta.fecha || ''), t: Date.now() });
        localStorage.setItem(LS + 'recientes', JSON.stringify(r.slice(0, 8)));
      } catch (e) {}
    }
    function estado(cls, txt) { $('#estado').className = 'estado ' + cls; $('#estadoTxt').textContent = txt; }
    function cambio() {
      if (esCliente()) return;
      S._ts = Date.now(); S._sinc = false; local();
      estado('sav', 'Cambios sin guardar…');
      clearTimeout(timer); timer = setTimeout(subir, 1000);
      if (ruta.v === 'proc') { pintarPasos(); avisosFirma(); } else if (ruta.v === 'cierre') avisosFirma();
    }
    async function subir() {
      if (esCliente()) return;
      if (guardando) { pendiente = true; return; }
      guardando = true; pendiente = false; estado('sav', 'Guardando…');
      try {
        const foto = JSON.stringify(S);
        const r = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ codigo, guia: ID_GUIA, cliente: S.meta.cliente, data: S, base: base ? actualizado : '' }) });
        const j = await r.json().catch(() => ({}));
        if (r.status === 409 && j.conflicto && j.sesion) {
          // Otra tableta guardó primero: se juntan los cambios de las dos y se vuelve a guardar.
          const cambio = fusionarS(j.sesion.data); normalizar();
          guardarBase(j.sesion.data || {}, j.sesion.updated_at);
          F = j.sesion.firmas || F;
          if (cambio) repintarSiSePuede();
          pendiente = true; return;
        }
        if (!r.ok || !j.ok) throw new Error(j.error || 'Error ' + r.status);
        cc = j.codigo_cliente || cc; guardarBase(JSON.parse(foto), j.updated_at);
        if (JSON.stringify(S) === foto) S._sinc = true; else pendiente = true;
        local(); recordar();
        estado('ok', 'Guardado ' + new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }));
        clearTimeout(reintento);
      } catch (e) {
        estado('err', e.message && /otra guía/.test(e.message) ? 'Esta liga es de una versión anterior: crea una sesión nueva' : 'Sin conexión: guardado en este dispositivo');
        clearTimeout(reintento); if (!/otra guía/.test(e.message || '')) reintento = setTimeout(subir, 10000);
      } finally {
        guardando = false;
        if (pendiente) subir();
      }
    }
    window.addEventListener('online', () => { if (S && !S._sinc) subir(); });

    // ── Arranque ───────────────────────────────────────────────────────────
    async function arrancar() {
      if (!(window.SpeechRecognition || window.webkitSpeechRecognition)) document.body.classList.add('sin-voz');
      document.querySelectorAll('.mic').forEach(m => { if (!m.innerHTML) m.innerHTML = ICO_MIC; });
      const q = new URLSearchParams(location.search);
      codigo = (q.get('s') || '').toLowerCase();
      const qc = (q.get('c') || '').toLowerCase();
      if (/^[a-z0-9]{12,40}$/.test(qc) && !/^[a-z0-9]{12,40}$/.test(codigo)) return arrancarCliente(qc);
      if (!/^[a-z0-9]{12,40}$/.test(codigo)) return pantallaInicio();
      $('#app').classList.remove('oculto');
      $('#intro').textContent = 'Cada proceso se ve en dos sesiones. Con el DUEÑO: la visión del proceso, los resultados y las reglas del negocio. Con el EQUIPO: el detalle en pantalla, con un caso de prueba. Cambia de sesión arriba (Dueño | Equipo). Lo que salga se anota; al día siguiente se revisa y se pule, y cuando queda se firma y se pasa al siguiente proceso.';
      let loc = null, lb = null; try { loc = JSON.parse(localStorage.getItem(LS + codigo) || 'null'); lb = JSON.parse(localStorage.getItem(LS + codigo + ':base') || 'null'); } catch (e) {}
      let fila = null, red = true;
      try {
        const r = await fetch(API + '?s=' + codigo, { cache: 'no-store' });
        const j = await r.json(); if (!j.ok) throw new Error(j.error);
        fila = j.sesion;
      } catch (e) { red = false; }
      const srv = fila && fila.data;
      if (fila) { F = fila.firmas || {}; cc = fila.codigo_cliente || null; }
      if (loc && !loc._sinc && (!srv || (loc._ts || 0) > (srv._ts || 0) || lb)) {
        // Hay cambios de este dispositivo que no alcanzaron a subir: se suben
        // sobre lo que había visto del servidor, y si alguien más guardó
        // mientras tanto, se fusionan en vez de pisarlo.
        if (lb && lb.d) { base = lb.d; actualizado = lb.at || ''; } else if (srv) { base = clon(srv); actualizado = fila.updated_at || ''; }
        S = loc; normalizar(); render(); subir();
      } else {
        S = srv || loc || vacio();
        if (srv) { const v = loc && loc.vista; guardarBase(srv, fila.updated_at); if (v) S.vista = v; }
        normalizar(); render();
        if (!red) estado('err', 'Sin conexión: trabajando en este dispositivo');
        else if (!srv) subir();
        else { S._sinc = true; local(); recordar(); estado('ok', 'Sesión cargada'); }
      }
      setInterval(refrescar, 20000);
    }

    async function arrancarCliente(c) {
      ROL = 'cliente'; cc = c; document.body.classList.add('ro');
      $('#app').classList.remove('oculto');
      $('#intro').textContent = 'Aquí está lo que se revisó contigo en la entrega de la Suite de Consignación, proceso por proceso. Al final de cada proceso puedes firmar de enterado y aceptado.';
      try {
        const r = await fetch(API + '?c=' + c, { cache: 'no-store' });
        const j = await r.json(); if (!j.ok) throw new Error(j.error);
        S = j.sesion.data || vacio(); F = j.sesion.firmas || {}; actualizado = j.sesion.updated_at || '';
        normalizar(); render(); estado('ok', 'Vista del cliente');
        setInterval(refrescar, 20000);
      } catch (e) {
        $('#app').innerHTML = '<div class="inicio"><div class="panel"><h2>Esta liga no está disponible</h2><p class="sub">Pide al orquestador que te la vuelva a enviar.</p></div></div>';
      }
    }

    function ocupado() { return !!document.querySelector('[data-pad].con') || [...document.querySelectorAll('[data-fnom]')].some(i => i.value) || (document.activeElement && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)); }
    async function refrescar() {
      if (document.hidden) return;
      try {
        const r = await fetch(API + (esCliente() ? '?c=' + cc : '?s=' + codigo), { cache: 'no-store' });
        const j = await r.json(); if (!j.ok || !j.sesion) return;
        const nuevas = JSON.stringify(j.sesion.firmas || {}) !== JSON.stringify(F);
        // El orquestador también recibe lo que otra tableta guardó, siempre que
        // aquí no haya cambios a medio subir (esos se fusionan al guardar).
        const cambiaData = Date.parse(j.sesion.updated_at || 0) !== Date.parse(actualizado || 0) && (esCliente() || (S._sinc && !guardando));
        if (!nuevas && !cambiaData) return;
        if (ocupado()) return;
        F = j.sesion.firmas || {};
        if (cambiaData) {
          const v = S.vista;
          if (esCliente()) { S = j.sesion.data; actualizado = j.sesion.updated_at; }
          else { fusionarS(j.sesion.data); guardarBase(j.sesion.data, j.sesion.updated_at); S._sinc = true; local(); }
          S.vista = v; normalizar();
        }
        const y = window.scrollY; render(); window.scrollTo(0, y);
        if (nuevas && !esCliente()) toast('Hay firmas nuevas del cliente');
      } catch (e) {}
    }

    function normalizar() {
      S.sec = S.sec || {}; S.extras = S.extras || []; S.cierre = S.cierre || {}; S.log = S.log || []; S.meta = S.meta || {}; S.caso = S.caso || {}; S.procNota = S.procNota || {};
      Object.keys(FIJOS).forEach(k => { S.meta[k] = FIJOS[k]; });
      if (!S.meta.fecha) S.meta.fecha = hoyLocal();
      if (!S.cierre.firmaSacs) S.cierre.firmaSacs = FIJOS.consultor;
      if (S.vista !== 'equipo') S.vista = 'dueno';
      document.body.classList.toggle('corta', !!S.corta);
    }

    function pantallaInicio() {
      $('#inicio').classList.remove('oculto');
      let r = []; try { r = JSON.parse(localStorage.getItem(LS + 'recientes') || '[]'); } catch (e) {}
      $('#recientes').innerHTML = r.length ? '<h3>Recientes en este dispositivo</h3>' + r.map(x => '<a href="?s=' + esc(x.c) + '">' + esc(x.n) + '<span>' + new Date(x.t).toLocaleDateString('es-MX') + '</span></a>').join('') : '';
      $('#btnNueva').onclick = () => {
        const c = nuevoCodigo();
        try { localStorage.setItem(LS + c, JSON.stringify(Object.assign(vacio(), { _sinc: false }))); } catch (e) {}
        location.search = '?s=' + c;
      };
      $('#btnAbrir').onclick = () => {
        const v = $('#abrirCodigo').value.trim(); const m = v.match(/[?&]s=([a-z0-9]{12,40})/i) || v.match(/^([a-z0-9]{12,40})$/i);
        if (!m) return toast('No reconozco esa liga o código.');
        location.search = '?s=' + m[1].toLowerCase();
      };
    }

    // ── Rutas ──────────────────────────────────────────────────────────────
    // Cada proceso: [mapa] + etapas + cierre del proceso (resumen, «¿qué cambiarías?» y firma).
    function listaPasos(cap) {
      const reglas = !esDueno() && secsModo(cap, 'dueno').some(s => (s.decidir || []).length) ? ['__reglas'] : [];
      return (cap.diagrama ? ['__mapa'] : []).concat(reglas, secsModo(cap).map(s => s.id), ['__fin']);
    }
    function leerRuta() {
      const h = location.hash.replace(/^#\/?/, '').split('/').filter(Boolean).map(decodeURIComponent);
      if (h[0] === 'p' && GUIA.capitulos.some(c => c.id === h[1])) {
        const cap = capDe(h[1]);
        // Una liga directa a una etapa abre la sesión (dueño/equipo) a la que pertenece.
        const sx = h[2] && secsDe(cap).find(x => x.id === h[2]);
        if (sx && (!!sx.dueno) !== esDueno()) S.vista = sx.dueno ? 'dueno' : 'equipo';
        const pasos = listaPasos(cap);
        return { v: 'proc', cap: cap.id, paso: pasos.includes(h[2]) ? h[2] : pasos[0] };
      }
      if (h[0] === 'cierre') return { v: 'cierre' };
      return { v: 'inicio' };
    }
    function ir(hash) { if (location.hash === hash) { render(); window.scrollTo(0, 0); } else location.hash = hash; }
    window.addEventListener('hashchange', () => { if (!S) return; render(); window.scrollTo(0, 0); });
    document.addEventListener('click', ev => { const a = ev.target.closest('[data-ir]'); if (a) { ev.preventDefault(); ir(a.dataset.ir); } });

    function render() {
      if (!S) return;
      ruta = leerRuta();
      $('#vInicio').classList.toggle('oculto', ruta.v !== 'inicio');
      $('#vProceso').classList.toggle('oculto', ruta.v !== 'proc');
      $('#vCierre').classList.toggle('oculto', ruta.v !== 'cierre');
      $('#btnPend').classList.toggle('oculto', ruta.v !== 'proc');
      document.querySelectorAll('[data-meta]').forEach(el => { el.value = S.meta[el.dataset.meta] || ''; el.oninput = () => { S.meta[el.dataset.meta] = el.value; cambio(); }; });
      document.querySelectorAll('[data-cierre]').forEach(el => { el.value = S.cierre[el.dataset.cierre] || ''; el.oninput = () => { S.cierre[el.dataset.cierre] = el.value; cambio(); }; });
      document.querySelectorAll('#modo [data-modo]').forEach(b => b.classList.toggle('on', b.dataset.modo === S.vista));
      if (ruta.v === 'inicio') pintarInicio();
      else if (ruta.v === 'proc') pintarProceso();
      else pintarCierre();
      pintarMigas();
      bloquear(document);
    }

    function nombrePaso(cap, id) {
      if (id === '__mapa') return 'Mapa del proceso';
      if (id === '__fin') return esDueno() ? 'Cierre con el dueño' : 'Cierre con el equipo';
      if (id === '__reglas') return 'Lo que decidió el dueño';
      const s = secsDe(cap).find(x => x.id === id); return s ? (s.dueno ? s.nombre : numSec(cap, s) + '. ' + s.nombre) : id;
    }
    function pintarMigas() {
      const m = ['<a data-ir="#/">Inicio</a>'];
      if (ruta.v === 'proc') {
        const cap = capDe(ruta.cap);
        m.push('<a data-ir="#/p/' + cap.id + '">' + esc(etiquetaCap(cap) + ' · ' + cap.nombre) + '</a>');
        m.push('<span class="act">' + esc(nombrePaso(cap, ruta.paso)) + '</span>');
      } else if (ruta.v === 'cierre') m.push('<span class="act">Resumen y cierre</span>');
      else m[0] = '<span class="act">Inicio</span>';
      $('#migas').innerHTML = m.join('<span class="sep">›</span>');
    }

    // Vista del cliente: todo se ve, nada se edita salvo la firma.
    function bloquear(root) {
      if (!esCliente()) return;
      root.querySelectorAll('input, textarea, select, .seg button').forEach(el => { if (!el.closest('[data-firma]') && !el.closest('#modo') && el.id !== 'selPasos') el.disabled = true; });
    }

    // ── Conteos ────────────────────────────────────────────────────────────
    function conteo(s) {
      const e = est(s.id); let tot = e.extra.length, hechos = 0, fallas = 0;
      demos(s).forEach((_, i) => { if (!cuenta(s, e, i)) return; tot++; const p = e.puntos[i]; if (p && p.e) { hechos++; if (p.e === 'falla') fallas++; } });
      e.extra.forEach(p => { if (p.e) { hechos++; if (p.e === 'falla') fallas++; } });
      const dec = (s.decidir || []).length, decOk = (s.decidir || []).filter((_, k) => (e.dec[k] || '').trim()).length;
      const dudas = e.dudas.filter(d => !d.ok).length;
      return { tot, hechos, fallas, hall: e.hall.length, dec, decOk, dudas };
    }
    function conteoCap(cap) {
      const t = { tot: 0, hechos: 0, fallas: 0, hall: 0, dec: 0, decOk: 0, dudas: 0 };
      secsModo(cap).forEach(s => { const c = conteo(s); Object.keys(t).forEach(k => { t[k] += c[k]; }); });
      t.firm = F[firmaId(cap)] ? 1 : 0;
      return t;
    }
    function totales() {
      const t = { tot: 0, hechos: 0, fallas: 0, hall: 0, dec: 0, decOk: 0, dudas: 0, firm: 0, procs: 0 };
      GUIA.capitulos.forEach(cap => { const c = conteoCap(cap); Object.keys(c).forEach(k => { if (k in t) t[k] += c[k]; }); t.procs++; });
      return t;
    }

    // ── INICIO ─────────────────────────────────────────────────────────────
    function pintarInicio() {
      const f = S.meta.fecha ? new Date(S.meta.fecha + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' }) : '—';
      $('#datos').innerHTML = [['Cliente', S.meta.cliente], ['Cuenta Sacscloud', S.meta.cuenta], ['Orquestador', S.meta.consultor], ['Inicio de la sesión', f], ['Ambiente', S.meta.ambiente]]
        .map(x => '<div><span>' + esc(x[0]) + '</span><b>' + esc(x[1]) + '</b></div>').join('');
      const T = totales();
      $('#kpis').innerHTML =
        '<div class="kpi"><span class="l">Demostrado</span><span class="c">' + pct(T.hechos, T.tot) + '</span><span class="s">' + T.hechos + ' de ' + T.tot + ' puntos</span></div>'
        + '<div class="kpi"><span class="l">Decisiones del cliente</span><span class="c">' + T.decOk + '<span style="font-size:1rem;color:var(--tx3)"> / ' + T.dec + '</span></span><span class="s">contestadas</span></div>'
        + '<div class="kpi rj"><span class="l">Fallas y dudas</span><span class="c">' + T.fallas + ' · ' + T.dudas + '</span><span class="s">fallas · dudas abiertas</span></div>'
        + '<div class="kpi"><span class="l">Procesos firmados</span><span class="c">' + T.firm + '<span style="font-size:1rem;color:var(--tx3)"> / ' + T.procs + '</span></span><span class="s">' + T.hall + ' mejoras y hallazgos</span></div>';
      $('#casoMini').innerHTML = CASO.slice(0, 6).map(c => '<span class="' + (S.caso[c.k] ? '' : 'vacio-c') + '">' + esc(c.l.split(' · ')[0]) + ': <b>' + esc(S.caso[c.k] || 'por anotar') + '</b></span>').join('')
        + '<a class="btn peq" data-ir="#/p/p0/p0-caso" style="min-height:30px">Editar</a>';
      $('#titProcs').textContent = (esDueno() ? 'Sesión con el dueño' : 'Sesión con el equipo') + ' · procesos en el orden en que vive una pieza';
      $('#chkCorta').checked = !!S.corta;
      $('#chkCorta').onchange = ev => { S.corta = ev.target.checked; document.body.classList.toggle('corta', S.corta); logEv(S.corta ? 'Activó la sesión corta (solo lo esencial)' : 'Volvió a la sesión completa'); cambio(); pintarInicio(); };
      $('#caps').innerHTML = GUIA.capitulos.map(cap => {
        const c = conteoCap(cap); const p = c.tot ? Math.round(c.hechos * 100 / c.tot) : 0;
        const ok = c.tot && c.hechos === c.tot;
        return '<button class="prow' + (c.firm ? ' firm' : ok ? ' ok' : '') + '" data-ir="#/p/' + esc(cap.id) + '">'
          + '<span class="n">' + (c.firm ? ICO_OK.replace('width="10" height="10"', 'width="14" height="14"') : esc(cap.id === 'rep' ? '✓' : numCap(cap))) + '</span>'
          + '<span><span class="nm">' + esc(cap.nombre) + '</span><span class="rs">' + esc(cap.resumen) + '</span></span>'
          + '<span class="av"><span class="bar"><i style="width:' + p + '%"></i></span><span>' + (c.tot ? c.hechos + '/' + c.tot + ' · ' : '') + (c.dec ? c.decOk + '/' + c.dec + ' decisiones' : '') + (c.firm ? ' · firmado' : '') + '</span></span>'
          + '<span class="ch">›</span></button>';
      }).join('')
        + '<button class="prow fin" data-ir="#/cierre"><span class="n">' + (F.__cierre ? ICO_OK.replace('width="10" height="10"', 'width="14" height="14"') : '★') + '</span><span><span class="nm">Resumen y cierre</span><span class="rs">Fallas por corregir, mejoras, dudas, decisiones, acuerdos y la firma final.</span></span><span class="av"><span>' + T.hall + ' anotaciones · ' + T.dudas + ' dudas abiertas</span></span><span class="ch">›</span></button>';
    }

    // ── PROCESO (enfoque) ──────────────────────────────────────────────────
    function estadoPaso(s) {
      const c = conteo(s);
      if (c.fallas) return 'falla';
      if ((c.tot || c.dec) && c.hechos === c.tot && c.decOk === c.dec) return 'ok';
      if (c.hechos || c.decOk) return 'parcial';
      return '';
    }
    function pintarPasos() {
      const cap = capDe(ruta.cap); const ct = conteoCap(cap);
      const items = listaPasos(cap).map(id => {
        const on = ruta.paso === id ? ' on' : '';
        const href = '#/p/' + cap.id + '/' + encodeURIComponent(id);
        if (id === '__mapa') return '<button class="paso' + on + '" data-ir="' + href + '"><span class="ic"></span><span class="tx">Mapa del proceso<span class="mt">Cómo funciona de punta a punta</span></span></button>';
        if (id === '__reglas') return '<button class="paso' + on + '" data-ir="' + href + '"><span class="ic"></span><span class="tx">Lo que decidió el dueño<span class="mt">Reglas que aplican al equipo</span></span></button>';
        if (id === '__fin') { const fz = F[firmaId(cap)]; return '<button class="paso' + on + '" data-ir="' + href + '"><span class="ic' + (fz ? ' ok' : '') + '">' + (fz ? ICO_OK : '') + '</span><span class="tx">' + esc(nombrePaso(cap, id)) + '<span class="mt">' + (fz ? 'Firmado' : '¿Qué cambiarías? y firma') + '</span></span></button>'; }
        const s = secsDe(cap).find(x => x.id === id); const c = conteo(s); const e = estadoPaso(s);
        return '<button class="paso' + on + '" data-ir="' + href + '"><span class="ic ' + e + '">' + (e === 'ok' ? ICO_OK : '') + '</span><span class="tx">' + esc(s.dueno ? s.nombre : numSec(cap, s) + '. ' + s.nombre)
          + '<span class="mt">' + (s.caso ? 'Datos del caso' : (c.tot ? c.hechos + '/' + c.tot : '') + (c.dec ? (c.tot ? ' · ' : '') + c.decOk + '/' + c.dec + ' decisiones' : '') + (c.fallas ? ' · ' + c.fallas + ' con falla' : '') + (c.dudas ? ' · ' + c.dudas + ' dudas' : '')) + '</span></span></button>';
      }).join('');
      $('#pasos').innerHTML = '<div class="tit"><span class="modo-cab">' + (esDueno() ? 'Sesión con el dueño' : 'Sesión con el equipo') + '</span><br>' + esc(etiquetaCap(cap)) + '<b>' + esc(cap.nombre) + '</b></div><div class="bar"><i style="width:' + pct(ct.hechos, ct.tot) + '"></i></div>' + items
        + '<div class="solo-orq" style="padding:8px 10px"><button class="btn peq" id="btnOtra" style="width:100%">Agregar etapa</button></div>';
      $('#selPasos').innerHTML = listaPasos(cap).map(id => '<option value="' + esc(id) + '"' + (ruta.paso === id ? ' selected' : '') + '>' + esc(nombrePaso(cap, id)) + '</option>').join('');
      $('#selPasos').onchange = ev => ir('#/p/' + cap.id + '/' + encodeURIComponent(ev.target.value));
      const b = $('#btnOtra'); if (b) b.onclick = () => agregarEtapa(cap);
    }

    function pintarProceso() {
      const cap = capDe(ruta.cap);
      pintarPasos();
      const pasos = listaPasos(cap); const i = pasos.indexOf(ruta.paso);
      if (ruta.paso === '__mapa') {
        $('#foco').innerHTML = '<div class="foco-cab"><span class="k">' + esc(etiquetaCap(cap)) + '</span><h1>' + esc(cap.nombre) + '</h1><p class="sub">' + esc(cap.resumen) + '</p></div>' + htmlMapa(cap.diagrama);
        $('#foco').querySelectorAll('[data-go]').forEach(g => g.onclick = () => ir('#/p/' + cap.id + '/' + encodeURIComponent(g.dataset.go)));
      } else if (ruta.paso === '__reglas') {
        $('#foco').innerHTML = htmlReglas(cap);
      } else if (ruta.paso === '__fin') {
        $('#foco').innerHTML = htmlFin(cap); enlazarFin(cap);
      } else {
        const s = secsDe(cap).find(x => x.id === ruta.paso);
        $('#foco').innerHTML = htmlSec(cap, s); enlazar(cap, s);
      }
      const ant = pasos[i - 1], sig = pasos[i + 1];
      const capSig = GUIA.capitulos[numCap(cap) + 1];
      $('#btnAnt').disabled = !ant; $('#btnAnt').onclick = () => ant && ir('#/p/' + cap.id + '/' + encodeURIComponent(ant));
      $('#btnSig').textContent = sig ? 'Siguiente →' : capSig ? 'Siguiente proceso →' : 'Ir al resumen y cierre →';
      $('#btnSig').onclick = () => ir(sig ? '#/p/' + cap.id + '/' + encodeURIComponent(sig) : capSig ? '#/p/' + capSig.id : '#/cierre');
    }

    // Mapa del proceso: rejilla de 5 columnas; cada caja abre su etapa.
    function htmlMapa(d) {
      const W = 128, H = 52, X = c => 92 + c * 144, Y = r => 84 + r * 130;
      const N = {}; d.nodos.forEach(n => { N[n.id] = n; });
      const filas = Math.max.apply(null, d.nodos.map(n => n.r)) + 1;
      const alto = Y(filas - 1) + H / 2 + 24;
      const lineas = [], etiquetas = [];
      d.flechas.forEach(f => {
        const a = N[f.de], b = N[f.a]; if (!a || !b) return;
        const ax = X(a.c) + (f.dx || 0), ay = Y(a.r), bx = X(b.c), by = Y(b.r);
        let p, lx, ly, anc = 'start';
        if (a.r === b.r) { const dir = b.c > a.c ? 1 : -1; p = 'M' + (X(a.c) + dir * W / 2) + ' ' + ay + 'H' + (bx - dir * W / 2); lx = (X(a.c) + bx) / 2; ly = ay - H / 2 - 8; anc = 'middle'; }
        else if (a.c === b.c || ax === bx) { p = 'M' + ax + ' ' + (ay + H / 2) + 'V' + (by - H / 2); ly = by - H / 2 - 12; if (ax > 600) { lx = ax - 8; anc = 'end'; } else { lx = ax + 8; } }
        else { const mid = ay + H / 2 + 39; p = 'M' + ax + ' ' + (ay + H / 2) + 'V' + mid + 'H' + bx + 'V' + (by - H / 2); lx = bx + 8; ly = mid - 8; }
        lineas.push('<path d="' + p + '" marker-end="url(#mapa-flecha)"/>');
        if (f.et) etiquetas.push('<text x="' + lx + '" y="' + ly + '" text-anchor="' + anc + '" font-size="11.5" fill="#5c5c5c">' + esc(f.et) + '</text>');
      });
      const cajas = d.nodos.map(n => '<g class="nd" data-go="' + esc(n.sec) + '" role="button" tabindex="0"><rect x="' + (X(n.c) - W / 2) + '" y="' + (Y(n.r) - H / 2) + '" width="' + W + '" height="' + H + '" rx="8" fill="' + (n.fin ? '#eaf2ff' : '#fff') + '" stroke="' + (n.fin ? '#006aff' : '#cfcfcf') + '" stroke-width="' + (n.fin ? 1.75 : 1.1) + '"/>'
        + '<text x="' + X(n.c) + '" y="' + (Y(n.r) - 3) + '" text-anchor="middle" font-size="13" font-weight="600" fill="#1a1a1a">' + esc(n.t) + '</text>'
        + '<text x="' + X(n.c) + '" y="' + (Y(n.r) + 15) + '" text-anchor="middle" font-size="11" fill="#5c5c5c">' + esc(n.s) + '</text></g>').join('');
      return '<section class="mapa panel" style="margin-top:24px">'
        + '<svg viewBox="0 0 760 ' + alto + '" role="img" aria-label="' + esc(d.titulo) + '" font-family="Inter, system-ui, sans-serif">'
        + '<defs><marker id="mapa-flecha" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#a8a8a8"/></marker></defs>'
        + '<text x="28" y="30" font-size="15" font-weight="700" fill="#1a1a1a">' + esc(d.titulo) + '</text>'
        + '<g fill="none" stroke="#a8a8a8" stroke-width="1.2">' + lineas.join('') + '</g>' + etiquetas.join('') + cajas + '</svg>'
        + '<p class="lec">' + esc(d.lectura) + ' Toca una caja para abrir su etapa.</p></section>';
    }

    // ── Piezas de UI ───────────────────────────────────────────────────────
    function htmlTxt(attr, valor, ph) { return '<div class="ta"><textarea ' + attr + ' placeholder="' + esc(ph || '') + '">' + esc(valor) + '</textarea><button type="button" class="mic solo-orq" title="Dictar">' + ICO_MIC + '</button></div>'; }
    function htmlFotos(arr) { return (arr || []).map((u, k) => '<div class="foto"><a href="' + esc(u) + '" target="_blank" rel="noopener"><img src="' + esc(u) + '" alt="Foto ' + (k + 1) + '" loading="lazy" /></a><button type="button" class="solo-orq" data-quitafoto="' + k + '" title="Quitar">✕</button></div>').join(''); }
    function opts(list, v, ph) { return (ph ? '<option value="">' + ph + '</option>' : '') + list.map(o => '<option' + (o === v ? ' selected' : '') + '>' + esc(o) + '</option>').join(''); }
    function chipsCaso(pieza) {
      if (!pieza) return '';
      const ks = pieza === 'ABC' ? ['A', 'B', 'C'] : pieza === 'cons' ? ['cons', 'folio'] : [pieza];
      return '<div class="caso-mini">' + ks.map(k => { const c = CASO.find(x => x.k === k); return '<span class="' + (S.caso[k] ? '' : 'vacio-c') + '">' + esc(c.l.split(' · ')[0]) + ': <b>' + esc(S.caso[k] || 'por anotar') + '</b></span>'; }).join('') + '</div>';
    }

    // PDF adjuntos a la etapa (p. ej. el resumen de la migración). Se abren por
    // la API con la liga de la sesión: sin liga válida no se descargan.
    function htmlDocs(s) {
      if (!(s.docs || []).length) return '';
      const llave = esCliente() ? 'c=' + encodeURIComponent(cc || '') : 's=' + encodeURIComponent(codigo || '');
      return '<div class="docs"><span class="lbl">Documentos para consultar</span><div class="docs-l">'
        + s.docs.map(d => '<a class="doc" target="_blank" rel="noopener" href="/api/entrega/doc?d=' + encodeURIComponent(d.d) + '&' + llave + '"><span class="ic">PDF</span><span><b>' + esc(d.t) + '</b><small>' + esc(d.s || '') + '</small></span></a>').join('')
        + '</div></div>';
    }
    function htmlSec(cap, s, imprimir) {
      const e = est(s.id); const c = conteo(s);
      const esRep = cap.id === 'rep';
      const nOcultos = demos(s).filter((_, k) => e.ocultos[k]).length;
      const pts = demos(s).map((p, k) => e.ocultos[k] ? '' : htmlPunto('b' + k, p, e.puntos[k] || {})).join('') + e.extra.map((p, k) => htmlPunto('x' + k, p, p)).join('');
      const hoy = (s.hoy || []).map(x => '<span class="chip">' + esc(x) + '</span>').join('');
      let h = '<article class="sec' + (imprimir ? ' imp-sec' : '') + '"' + (imprimir ? '' : ' id="s-' + esc(s.id) + '"') + '>'
        + '<div class="foco-cab"><span class="k">' + esc(etiquetaCap(cap)) + ' · ' + (s.dueno ? 'Sesión con el dueño' : 'Etapa ' + numSec(cap, s) + ' · sesión con el equipo') + '</span>'
        + '<h1>' + esc(s.nombre) + '</h1>'
        + (s.caso ? '' : '<div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">' + (c.tot ? '<span class="etiqueta">' + c.hechos + ' de ' + c.tot + ' demostrados</span>' : '') + (c.dec ? '<span class="etiqueta">' + c.decOk + ' de ' + c.dec + ' decisiones</span>' : '') + (c.fallas ? '<span class="etiqueta" style="background:var(--rja);color:var(--rjt)">' + c.fallas + ' con falla</span>' : '') + (c.dudas ? '<span class="etiqueta" style="background:var(--ama);color:var(--amt)">' + c.dudas + ' dudas abiertas</span>' : '') + '</div>')
        + '<div class="foco-meta">' + (s.donde ? '<div><b>Dónde:</b> ' + esc(s.donde) + '</div>' : '') + (s.para ? '<div><b>Qué pasa:</b> ' + esc(s.para) + '</div>' : '') + '</div>'
        + chipsCaso(s.pieza) + '</div>'
        + htmlDocs(s)
        + (s.pitch ? '<div class="pitch"><span class="lbl">Pitch para el cliente · léelo en voz alta</span>' + esc(s.pitch) + '</div>' : '')
        + (s.nota ? '<div class="nota-calc">' + esc(s.nota) + '</div>' : '')
        + (hoy ? '<h3>Lo que muestra hoy</h3><div class="chips">' + hoy + '</div>' : '');
      if (s.caso) {
        h += '<div class="caso-form">' + CASO.map(cf => '<label class="f">' + esc(cf.l) + '<input type="text" data-caso="' + cf.k + '" value="' + esc(S.caso[cf.k] || '') + '" placeholder="' + esc(cf.ph) + '" /></label>').join('') + '</div>';
        return h + '</article>';
      }
      if (s.editable) h += '<h3>Etapa</h3><div class="grid"><label class="f">Nombre<input type="text" data-ren value="' + esc(s.nombre) + '" /></label><label class="f">Dónde está<input type="text" data-donde value="' + esc(s.donde || '') + '" /></label></div>';
      // 1 · Demostrar
      h += '<div class="bloque"><h3><span class="num-b">1</span>Demostrar</h3><div class="lista">' + (pts || '<div class="pt"><div class="vacio">Sin puntos a demostrar en esta etapa.</div></div>') + '</div>'
        + '<div class="acciones solo-orq"><button class="btn peq" data-addpt>Agregar punto a demostrar</button>' + (nOcultos ? '<button class="btn peq" data-restaurar>Restaurar ' + nOcultos + (nOcultos === 1 ? ' punto quitado' : ' puntos quitados') + '</button>' : '') + '</div></div>';
      // 2 · Decidir con el cliente
      if ((s.decidir || []).length) {
        h += '<div class="bloque"><h3><span class="num-b">2</span>Decidir con el cliente</h3><div class="dec">'
          + s.decidir.map((q, k) => '<div class="q' + ((e.dec[k] || '').trim() ? ' listo' : '') + '" data-q="' + k + '"><span class="t">' + esc(q) + '</span>' + htmlTxt('data-dec="' + k + '"', e.dec[k] || '', 'Lo que decidió el cliente') + '</div>').join('')
          + '</div></div>';
      }
      // Solo orquestador: lo que hoy no hace
      if (!imprimir && (s.noHace || []).length) {
        h += '<div class="bloque solo-orq"><div class="nohace"><div class="tit">Para el orquestador: lo que hoy no hace <span>· verifícalo antes; si el cliente lo necesita, anótalo como mejora</span></div>'
          + s.noHace.map((t, k) => '<div class="it"><span>' + esc(t) + '</span>' + (e.usadas['n' + k] ? '<button class="btn peq" disabled>Anotado</button>' : '<button class="btn peq" data-nohace="' + k + '">Lo necesita</button>') + '</div>').join('')
          + '</div></div>';
      }
      // 3 · Dudas del cliente
      h += '<div class="bloque"><h3><span class="num-b">' + ((s.decidir || []).length ? 3 : 2) + '</span>Dudas del cliente</h3>'
        + (e.dudas.length ? e.dudas.map((d, k) => htmlDuda(d, k)).join('') : '<div class="vacio">Sin dudas.</div>')
        + '<div class="acciones solo-orq"><button class="btn peq" data-addduda>Agregar duda</button></div></div>';
      // 4 · Mejoras y fallas
      h += '<div class="bloque"><h3><span class="num-b">' + ((s.decidir || []).length ? 4 : 3) + '</span>' + (esRep ? 'Lo que le falta (campo, dato, filtro…)' : 'Mejoras y fallas') + '</h3>'
        + (e.hall.length ? e.hall.map((x, k) => htmlHall(cap, x, k)).join('') : '<div class="vacio">Sin anotaciones.</div>')
        + '<div class="acciones solo-orq"><button class="btn peq" data-addh>' + (esRep ? 'Agregar faltante' : 'Agregar mejora o falla') + '</button>' + (s.editable ? '<button class="btn peq del" data-delsec>Quitar etapa</button>' : '') + '</div></div>';
      return h + '</article>';
    }

    function htmlPunto(key, p, st) {
      const extra = key[0] === 'x';
      const b = (v, l) => '<button class="' + v + (st.e === v ? ' on' : '') + '" data-e="' + v + '">' + l + '</button>';
      const abierta = st.e === 'falla' || !!st.n || (st.fotos && st.fotos.length);
      const txt = extra ? '<input type="text" data-ptt value="' + esc(p.t || '') + '" placeholder="Hacemos… y debe pasar…" />'
        : '<div class="hd"><div class="h"><span class="lb">Hacemos</span>' + esc(p.h) + (p.o ? '<span class="opc">opcional</span>' : '') + '</div><div class="d"><span class="lb">Debe pasar</span>' + esc(p.d) + '</div></div>';
      return '<div class="pt' + (abierta ? ' con-nota' : '') + (st.e === 'ok' || st.e === 'na' ? ' hecho' : '') + (p.o ? ' opcional' : '') + '" data-pt="' + key + '"><div class="txt">' + txt + '</div>'
        + '<div class="ctrl"><div class="seg">' + b('ok', 'Correcto') + b('falla', 'Falla') + b('na', 'No aplica') + '</div><button class="btn peq solo-orq" data-abrirnota title="Nota o foto">Nota</button><button class="btn peq del x solo-orq" data-quitarpt title="Quitar este punto" aria-label="Quitar este punto">✕</button></div>'
        + '<div class="nota">' + htmlTxt('data-nota', st.n || '', 'Qué se vio / comentario del cliente')
        + '<div class="nrs solo-orq">' + NOTAS_RAPIDAS.map(x => '<button type="button" class="nr" data-nr="' + esc(x) + '">' + esc(x) + '</button>').join('') + '</div>'
        + '<div class="fotos" data-fotos>' + htmlFotos(st.fotos) + '</div>'
        + '<div class="acciones solo-orq"><button type="button" class="btn peq" data-addfoto>Agregar foto</button>'
        + (st.e === 'falla' ? (st.hz ? '<button type="button" class="btn peq" disabled>Ya está en mejoras y fallas</button>' : '<button type="button" class="btn peq" data-ahz>Pasar a mejoras y fallas</button>') : '')
        + '</div></div></div>';
    }

    function htmlDuda(d, k) {
      return '<div class="duda' + (d.ok ? ' resuelta' : '') + '" data-duda="' + k + '">'
        + '<div class="fila"><div><span class="lbl">Duda</span>' + htmlTxt('data-df="q"', d.q || '', '¿Qué preguntó el cliente?') + '</div>'
        + '<div><span class="lbl">La responde</span><select data-df="quien">' + opts(RESPS, d.quien, '—') + '</select></div>'
        + '<label class="chk" style="margin:0 0 10px"><input type="checkbox" data-df="ok"' + (d.ok ? ' checked' : '') + ' />Resuelta</label>'
        + '<button class="btn peq del x solo-orq" data-delduda title="Quitar">✕</button></div>'
        + '<div><span class="lbl">Respuesta</span>' + htmlTxt('data-df="r"', d.r || '', 'Cómo se resolvió') + '</div></div>';
    }

    function htmlHall(cap, h, k) {
      return '<div class="hall" data-h="' + k + '">'
        + '<div class="hrow a"><div><span class="lbl">Tipo</span><select data-hf="tipo">' + opts(cap.tipos, h.tipo, 'Tipo…') + '</select></div>'
        + '<div><span class="lbl">Qué pasó / qué falta</span>' + htmlTxt('data-hf="que"', h.que, '') + '</div>'
        + '<div><span class="lbl">Cómo lo quiere el cliente</span>' + htmlTxt('data-hf="uso"', h.uso, '') + '</div></div>'
        + '<div class="hrow b"><div><span class="lbl">Prioridad</span><select data-hf="prio">' + opts(PRIOS, h.prio, '—') + '</select></div>'
        + '<div><span class="lbl">Decisión</span><select data-hf="deci">' + opts(DECIS, h.deci || 'Pendiente') + '</select></div>'
        + '<div><span class="lbl">Responsable</span><select data-hf="resp">' + opts(RESPS, h.resp, '—') + '</select></div>'
        + '<div><span class="lbl">Fecha compromiso</span><input type="date" data-hf="fecha" value="' + esc(h.fecha || '') + '" /></div>'
        + '<div class="acc solo-orq"><button type="button" class="btn peq" data-addfoto title="Agregar foto">Foto</button><button class="btn peq del x" data-delh title="Quitar">✕</button></div></div>'
        + '<div class="fotos" data-fotos>' + htmlFotos(h.fotos) + '</div></div>';
    }

    function repintarSec(cap, s) {
      if (ruta.v !== 'proc' || ruta.paso !== s.id) return;
      const y = window.scrollY;
      $('#foco').innerHTML = htmlSec(cap, s); enlazar(cap, s); bloquear($('#foco'));
      window.scrollTo(0, y);
    }

    // ── Dictado por voz ────────────────────────────────────────────────────
    let rec = null, recBtn = null;
    function dictar(btn) {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition; if (!SR) return;
      const ta = btn.parentNode.querySelector('textarea');
      if (rec) { const igual = recBtn === btn; rec.stop(); if (igual) return; }
      rec = new SR(); rec.lang = 'es-MX'; rec.continuous = true; rec.interimResults = false; recBtn = btn; btn.classList.add('on');
      rec.onresult = ev => {
        let t = ''; for (let i = ev.resultIndex; i < ev.results.length; i++) if (ev.results[i].isFinal) t += ev.results[i][0].transcript;
        if (!t) return; t = t.trim(); t = t.charAt(0).toUpperCase() + t.slice(1);
        ta.value = (ta.value ? ta.value.replace(/\s+$/, '') + ' ' : '') + t; ta.dispatchEvent(new Event('input'));
      };
      rec.onerror = ev => { if (ev.error === 'not-allowed') toast('Permite el micrófono para dictar.'); };
      rec.onend = () => { btn.classList.remove('on'); if (recBtn === btn) { rec = null; recBtn = null; } };
      try { rec.start(); toast('Dictando… toca otra vez para terminar'); } catch (e) { btn.classList.remove('on'); rec = null; }
    }
    document.addEventListener('click', ev => { const m = ev.target.closest('.mic'); if (m) { ev.preventDefault(); dictar(m); } });

    // ── Fotos ──────────────────────────────────────────────────────────────
    let fotoDestino = null;
    $('#fotoInput').onchange = ev => { const f = ev.target.files && ev.target.files[0]; ev.target.value = ''; if (f && fotoDestino) subirFoto(f, fotoDestino); };
    function pedirFoto(destino) { fotoDestino = destino; $('#fotoInput').click(); }
    function comprimir(file) {
      return new Promise(res => {
        const img = new Image(); const url = URL.createObjectURL(file);
        img.onload = () => {
          const k = Math.min(1, 1600 / Math.max(img.width, img.height)); const c = document.createElement('canvas');
          c.width = Math.round(img.width * k); c.height = Math.round(img.height * k); c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          URL.revokeObjectURL(url); c.toBlob(b => res(b || file), 'image/jpeg', 0.78);
        };
        img.onerror = () => { URL.revokeObjectURL(url); res(file); };
        img.src = url;
      });
    }
    async function subirFoto(file, d) {
      if (!navigator.onLine) return toast('Sin conexión: la foto se sube cuando vuelva la señal.');
      const caja = d.caja(); if (caja) caja.insertAdjacentHTML('beforeend', '<div class="foto subiendo">Subiendo…</div>');
      try {
        const blob = await comprimir(file);
        const fd = new FormData(); fd.append('codigo', codigo); fd.append('file', new File([blob], 'foto.jpg', { type: blob.type || 'image/jpeg' }));
        const r = await fetch(API_FOTO, { method: 'POST', body: fd }); const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.error || 'No se pudo subir');
        d.arr().push(j.url); logEv('Agregó una foto · ' + d.donde); d.listo(); cambio();
      } catch (e) { toast(e.message || 'No se pudo subir la foto'); const s = caja && caja.querySelector('.subiendo'); if (s) s.remove(); }
    }
    function enlazarFotos(cont, getArr, donde, listo) {
      const caja = () => cont.querySelector('[data-fotos]');
      const add = cont.querySelector('[data-addfoto]');
      const destino = { caja, arr: getArr, donde, listo };
      if (add) add.onclick = () => pedirFoto(destino);
      cont.querySelectorAll('[data-quitafoto]').forEach(b => b.onclick = () => { getArr().splice(+b.dataset.quitafoto, 1); logEv('Quitó una foto · ' + donde); listo(); cambio(); });
      cont.querySelectorAll('textarea').forEach(ta => ta.addEventListener('paste', ev => {
        const it = [...((ev.clipboardData && ev.clipboardData.items) || [])].find(x => x.type && x.type.indexOf('image/') === 0);
        if (it) { ev.preventDefault(); subirFoto(it.getAsFile(), destino); }
      }));
    }

    function nuevoHall(tipo, que, fotos) { return { tipo: tipo || '', que: que || '', uso: '', prio: '', deci: 'Pendiente', resp: '', fecha: '', fotos: fotos || [] }; }

    function enlazar(cap, s) {
      const el = $(sel(s.id)); if (!el) return; const e = est(s.id);
      el.querySelectorAll('[data-caso]').forEach(i => i.oninput = () => { S.caso[i.dataset.caso] = i.value; cambio(); });
      el.querySelectorAll('[data-pt]').forEach(row => {
        const key = row.dataset.pt; const extra = key[0] === 'x'; const k = +key.slice(1);
        const obj = () => extra ? e.extra[k] : (e.puntos[k] = e.puntos[k] || {});
        row.querySelectorAll('[data-e]').forEach(b => b.onclick = () => {
          const p = obj(); p.e = p.e === b.dataset.e ? '' : b.dataset.e;
          logEv(s.nombre + ' · «' + corto(txtPunto(s, e, key)) + '» → ' + RES[p.e || '']);
          repintarSec(cap, s); cambio();
          if (p.e === 'falla') { const t = $(sel(s.id) + ' [data-pt="' + key + '"] [data-nota]'); if (t) t.focus({ preventScroll: true }); }
        });
        const nb = row.querySelector('[data-abrirnota]'); if (nb) nb.onclick = () => { row.classList.toggle('con-nota'); if (row.classList.contains('con-nota')) row.querySelector('[data-nota]').focus(); };
        row.querySelector('[data-nota]').oninput = ev => { obj().n = ev.target.value; cambio(); };
        row.querySelectorAll('[data-nr]').forEach(b => b.onclick = () => { const p = obj(); p.n = (p.n ? p.n.replace(/\s+$/, '') + ' · ' : '') + b.dataset.nr; row.querySelector('[data-nota]').value = p.n; cambio(); });
        const tt = row.querySelector('[data-ptt]'); if (tt) tt.oninput = ev => { obj().t = ev.target.value; cambio(); };
        const qp = row.querySelector('[data-quitarpt]');
        if (qp) qp.onclick = () => {
          logEv(s.nombre + ' · quitó el punto «' + corto(txtPunto(s, e, key)) + '»');
          if (extra) e.extra.splice(k, 1); else e.ocultos[k] = true;
          repintarSec(cap, s); cambio(); toast(extra ? 'Punto quitado' : 'Punto quitado · se puede restaurar abajo de la lista');
        };
        enlazarFotos(row.querySelector('.nota'), () => { const p = obj(); p.fotos = p.fotos || []; return p.fotos; }, s.nombre, () => repintarSec(cap, s));
        const ahz = row.querySelector('[data-ahz]');
        if (ahz) ahz.onclick = () => {
          const p = obj(); p.hz = true;
          e.hall.push(nuevoHall(cap.id === 'rep' ? 'Bug' : 'Bug', corto(txtPunto(s, e, key), 220) + (p.n ? ' — ' + p.n : ''), (p.fotos || []).slice()));
          logEv(s.nombre + ' · pasó a mejoras y fallas «' + corto(txtPunto(s, e, key)) + '»'); repintarSec(cap, s); cambio(); toast('Anotado: ponle prioridad y responsable');
        };
      });
      const rest = el.querySelector('[data-restaurar]');
      if (rest) rest.onclick = () => { e.ocultos = {}; logEv(s.nombre + ' · restauró los puntos quitados'); repintarSec(cap, s); cambio(); toast('Puntos restaurados'); };
      const addpt = el.querySelector('[data-addpt]');
      if (addpt) addpt.onclick = () => { e.extra.push({ t: '', e: '', n: '' }); logEv(s.nombre + ' · agregó un punto a demostrar'); repintarSec(cap, s); cambio(); const ins = document.querySelectorAll(sel(s.id) + ' [data-ptt]'); if (ins.length) ins[ins.length - 1].focus(); };
      // Decisiones
      el.querySelectorAll('[data-dec]').forEach(t => t.oninput = () => { e.dec[t.dataset.dec] = t.value; t.closest('.q').classList.toggle('listo', !!t.value.trim()); cambio(); });
      el.querySelectorAll('[data-dec]').forEach(t => t.onchange = () => { if (t.value.trim()) logEv(s.nombre + ' · decidió: «' + corto(s.decidir[+t.dataset.dec], 50) + '» → ' + corto(t.value, 60)); cambio(); });
      // Lo que hoy no hace → mejora
      el.querySelectorAll('[data-nohace]').forEach(b => b.onclick = () => {
        const k = +b.dataset.nohace; e.usadas['n' + k] = true;
        e.hall.push(nuevoHall(cap.id === 'rep' ? 'Reporte nuevo' : 'Mejora de proceso', s.noHace[k]));
        logEv(s.nombre + ' · el cliente necesita «' + corto(s.noHace[k]) + '»'); repintarSec(cap, s); cambio(); toast('Anotado como mejora: ponle prioridad');
      });
      // Dudas
      el.querySelectorAll('[data-duda]').forEach(row => {
        const k = +row.dataset.duda;
        row.querySelectorAll('[data-df]').forEach(f => {
          const ev = (f.tagName === 'SELECT' || f.type === 'checkbox') ? 'onchange' : 'oninput';
          f[ev] = () => {
            e.dudas[k][f.dataset.df] = f.type === 'checkbox' ? f.checked : f.value;
            if (f.type === 'checkbox') { row.classList.toggle('resuelta', f.checked); logEv(s.nombre + ' · duda ' + (f.checked ? 'resuelta' : 'reabierta') + ': «' + corto(e.dudas[k].q, 50) + '»'); }
            cambio();
          };
        });
        row.querySelector('[data-delduda]').onclick = () => { logEv(s.nombre + ' · quitó la duda «' + corto(e.dudas[k].q, 40) + '»'); e.dudas.splice(k, 1); repintarSec(cap, s); cambio(); };
      });
      const addd = el.querySelector('[data-addduda]');
      if (addd) addd.onclick = () => { e.dudas.push({ q: '', quien: '', r: '', ok: false }); logEv(s.nombre + ' · agregó una duda'); repintarSec(cap, s); cambio(); const t = document.querySelectorAll(sel(s.id) + ' [data-df="q"]'); if (t.length) t[t.length - 1].focus(); };
      // Mejoras y fallas
      el.querySelectorAll('[data-h]').forEach(row => {
        const k = +row.dataset.h;
        row.querySelectorAll('[data-hf]').forEach(f => {
          const ev = (f.tagName === 'SELECT' || f.type === 'date') ? 'onchange' : 'oninput';
          f[ev] = () => {
            const ant = e.hall[k][f.dataset.hf]; e.hall[k][f.dataset.hf] = f.value;
            if (f.dataset.hf === 'deci' || f.dataset.hf === 'prio' || f.dataset.hf === 'resp') logEv(s.nombre + ' · «' + corto(e.hall[k].que, 40) + '»: ' + f.dataset.hf.replace('deci', 'decisión').replace('prio', 'prioridad').replace('resp', 'responsable') + ' ' + (ant || '—') + ' → ' + (f.value || '—'));
            cambio();
          };
        });
        enlazarFotos(row, () => { const h = e.hall[k]; h.fotos = h.fotos || []; return h.fotos; }, s.nombre, () => repintarSec(cap, s));
        row.querySelector('[data-delh]').onclick = () => { logEv(s.nombre + ' · quitó «' + corto(e.hall[k].que, 40) + '»'); e.hall.splice(k, 1); repintarSec(cap, s); cambio(); toast('Quitado'); };
      });
      const addh = el.querySelector('[data-addh]');
      if (addh) addh.onclick = () => { e.hall.push(nuevoHall()); logEv(s.nombre + ' · agregó una mejora o falla'); repintarSec(cap, s); cambio(); const t = document.querySelectorAll(sel(s.id) + ' [data-hf="que"]'); if (t.length) t[t.length - 1].focus(); };
      const ren = el.querySelector('[data-ren]'); if (ren) ren.oninput = () => { s.nombre = ren.value; cambio(); };
      const don = el.querySelector('[data-donde]'); if (don) don.oninput = () => { s.donde = don.value; cambio(); };
      const del = el.querySelector('[data-delsec]');
      if (del) del.onclick = () => {
        if (del.dataset.arm !== '1') { del.dataset.arm = '1'; del.textContent = '¿Seguro? Sí, quitar'; setTimeout(() => { del.dataset.arm = ''; del.textContent = 'Quitar etapa'; }, 3500); return; }
        logEv('Quitó la etapa «' + s.nombre + '»'); S.extras = S.extras.filter(x => x !== s); delete S.sec[s.id]; cambio(); ir('#/p/' + cap.id);
      };
    }

    function agregarEtapa(cap) {
      const s = { id: 'x' + Date.now().toString(36), cap: cap.id, dueno: esDueno(), nombre: esDueno() ? 'Tema nuevo con el dueño' : 'Etapa nueva', donde: '', para: '', demostrar: [], decidir: [], noHace: [], editable: true };
      S.extras.push(s); logEv('Agregó una etapa al proceso «' + cap.nombre + '»'); cambio();
      ir('#/p/' + cap.id + '/' + s.id);
      setTimeout(() => { const r = $('[data-ren]'); if (r) { r.focus(); r.select(); } }, 50);
    }

    // En la sesión con el equipo: las reglas que ya decidió el dueño (solo lectura).
    function htmlReglas(cap) {
      const filas = secsModo(cap, 'dueno').flatMap(sd => (sd.decidir || []).map((q, k) => ({ q, r: est(sd.id).dec[k] })));
      return '<div class="foco-cab"><span class="k">' + esc(etiquetaCap(cap)) + ' · sesión con el equipo</span><h1>Lo que decidió el dueño</h1><p class="sub">Las reglas de este proceso que el equipo debe conocer antes de verlo en pantalla. Si alguna no cuadra con la operación, se anota como duda o mejora en la etapa.</p></div>'
        + '<div class="lista-cierre" style="margin-top:20px">' + filas.map(x => '<div class="li"><span>' + esc(x.q) + '</span><b>' + ((x.r || '').trim() ? esc(x.r) : '<span class="w">Pendiente con el dueño</span>') + '</b></div>').join('') + '</div>';
    }

    // ── Cierre de cada proceso (por sesión): resumen, «¿qué cambiarías?» y firma
    function htmlFin(cap, imprimir, modo) {
      modo = modo || S.vista; const dn = modo === 'dueno';
      const secs = secsModo(cap, modo);
      const c = { tot: 0, hechos: 0, fallas: 0, dec: 0, decOk: 0, dudas: 0 }; secs.forEach(s => { const x = conteo(s); Object.keys(c).forEach(k => { c[k] += x[k]; }); });
      const dudas = secs.flatMap(s => est(s.id).dudas.filter(d => !d.ok).map(d => d.q)).filter(Boolean);
      const decs = secs.flatMap(s => (s.decidir || []).map((q, k) => ({ q, r: est(s.id).dec[k] }))).filter(x => (x.r || '').trim());
      const nk = cap.id + (dn ? '-d' : '-e'); const fz = F[nk];
      return '<div class="' + (imprimir ? 'imp-sec' : '') + '"><div class="foco-cab"><span class="k">' + esc(etiquetaCap(cap)) + ' · ' + esc(cap.nombre) + '</span><h1>' + (dn ? 'Cierre con el dueño' : 'Cierre con el equipo') + '</h1></div>'
        + '<div class="fin-res"><div><span>Demostrado</span><b>' + c.hechos + '/' + c.tot + '</b></div><div><span>Con falla</span><b style="color:var(--rjt)">' + c.fallas + '</b></div><div><span>Decisiones</span><b>' + c.decOk + '/' + c.dec + '</b></div><div><span>Dudas abiertas</span><b>' + c.dudas + '</b></div></div>'
        + (decs.length ? '<h3>Lo que decidió el cliente</h3><div class="lista-cierre">' + decs.map(x => '<div class="li"><span>' + esc(x.q) + '</span><b>' + esc(x.r) + '</b></div>').join('') + '</div>' : '')
        + (dudas.length ? '<h3>Dudas abiertas</h3><div class="lista-cierre">' + dudas.map(q => '<div class="li"><span>' + esc(q) + '</span></div>').join('') + '</div>' : '')
        + '<div class="ritmo"><b>Cómo se cierra un proceso:</b> lo que salió hoy se revisa al día siguiente y se pule hasta que quede como lo necesitan. Cuando ya quedó, el cliente firma de enterado y se pasa al siguiente proceso.</div>'
        + '<h3>¿Qué cambiarías de este flujo?</h3>' + htmlTxt('data-procnota', S.procNota[nk] || '', dn ? 'Lo que el dueño cambiaría o necesita distinto' : 'Lo que el equipo cambiaría o necesita distinto')
        + htmlFirma(dn ? 'Firma del dueño · ' + cap.nombre : 'Firma del responsable del equipo · ' + cap.nombre, dn ? LEY_PROC : LEY_EQUIPO, fz, fz && fz.h !== huellaCap(cap, modo)) + '</div>';
    }
    function enlazarFin(cap) {
      const t = $('#foco [data-procnota]'); if (t) { t.oninput = () => { S.procNota[firmaId(cap)] = t.value; cambio(); }; }
      enlazarFirma($('#foco [data-firma]'), firmaId(cap), () => huellaCap(cap), () => { $('#foco').innerHTML = htmlFin(cap); enlazarFin(cap); bloquear($('#foco')); pintarPasos(); });
    }

    // ── Firma de enterado y aceptado ───────────────────────────────────────
    const LEY_PROC = 'Revisamos y pulimos este proceso con el orquestador. Queda como lo necesitamos y estoy de acuerdo con lo demostrado, las reglas que decidí y lo anotado.';
    const LEY_EQUIPO = 'Revisamos y pulimos este proceso en pantalla con el orquestador. Funciona como lo trabajamos y estoy de acuerdo con lo demostrado y lo anotado.';
    const LEY_CIERRE = 'Revisé con el orquestador los procesos de esta sesión. Estoy enterado y de acuerdo con lo demostrado, las decisiones, las mejoras y los acuerdos anotados.';
    function hashTxt(t) { let h = 5381; for (let i = 0; i < t.length; i++) h = ((h << 5) + h + t.charCodeAt(i)) | 0; return (h >>> 0).toString(36); }
    function huellaSec(e) { return [e.puntos, e.extra, e.hall, e.ocultos, e.dec, e.dudas]; }
    function huellaCap(cap, modo) { modo = modo || S.vista; return hashTxt(JSON.stringify([secsModo(cap, modo).map(s => huellaSec(est(s.id))), S.procNota[cap.id + (modo === 'dueno' ? '-d' : '-e')] || ''])); }
    function huellaTodo() { return hashTxt(JSON.stringify([GUIA.capitulos.map(c => [huellaCap(c, 'dueno'), huellaCap(c, 'equipo')]), S.cierre.acuerdos || ''])); }
    function fechaFirma(iso) { try { return new Date(iso).toLocaleString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch (e) { return iso; } }
    function htmlFirma(titulo, ley, f, cambioTras) {
      if (f) return '<div class="firma-box" data-firma><h4>' + esc(titulo) + '</h4><div class="firmado">'
        + '<svg viewBox="0 0 600 150" preserveAspectRatio="xMidYMid meet"><path d="' + esc(f.d) + '" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        + '<div class="q"><b>' + esc(f.nombre) + '</b>' + (f.puesto ? ' · ' + esc(f.puesto) : '') + '<br>Enterado y aceptado · ' + esc(fechaFirma(f.at)) + (f.desde === 'cliente' ? ' · desde su liga' : '') + '</div>'
        + '<button class="btn peq del solo-orq" data-quitarfirma style="margin-left:auto">Quitar firma</button></div>'
        + '<div class="aviso-cambio' + (cambioTras ? '' : ' oculto') + '" data-aviso>⚠️ Hubo cambios después de la firma. Revísenlos con el cliente y vuelvan a firmar si hace falta.</div></div>';
      return '<div class="firma-box" data-firma><h4>' + esc(titulo) + '</h4><p class="ley">' + esc(ley) + '</p>'
        + '<div class="grid"><label class="f">Nombre de quien firma<input type="text" data-fnom autocomplete="off" /></label><label class="f">Puesto<input type="text" data-fpue autocomplete="off" /></label></div>'
        + '<div class="pad" data-pad style="margin-top:12px"><svg viewBox="0 0 600 150" preserveAspectRatio="none"><path d="" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="ph">Firma aquí con el dedo o el lápiz</span></div>'
        + '<label class="chk"><input type="checkbox" data-facepto /><span>Enterado y aceptado.</span></label>'
        + '<div class="acciones"><button class="btn peq" data-flimpiar>Borrar trazo</button><button class="btn pri" data-ffirmar disabled>Firmar</button></div></div>';
    }
    async function guardarFirma(id, firma) {
      const r = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.assign({ accion: 'firmar', id, firma }, esCliente() ? { cc } : { codigo })) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) throw new Error(j.error || 'No se pudo guardar la firma.');
      F = j.firmas || {};
    }
    function enlazarFirma(box, id, huellaFn, repinta) {
      if (!box) return;
      const quitar = box.querySelector('[data-quitarfirma]');
      if (quitar) {
        quitar.onclick = async () => {
          if (quitar.dataset.arm !== '1') { quitar.dataset.arm = '1'; quitar.textContent = '¿Seguro? Sí, quitar'; setTimeout(() => { quitar.dataset.arm = ''; quitar.textContent = 'Quitar firma'; }, 3500); return; }
          try { await guardarFirma(id, null); logEv('Quitó la firma · ' + (id === '__cierre' ? 'Cierre' : capDe(id.replace(/-[de]$/, '')).nombre)); repinta(); cambio(); toast('Firma quitada'); }
          catch (e) { toast(e.message); }
        };
        return;
      }
      const pad = box.querySelector('[data-pad]'), svg = pad.querySelector('svg'), path = svg.querySelector('path');
      const nom = box.querySelector('[data-fnom]'), pue = box.querySelector('[data-fpue]'), acepto = box.querySelector('[data-facepto]'), btn = box.querySelector('[data-ffirmar]');
      let d = '', trazando = false;
      const listo = () => { btn.disabled = !(d.length > 20 && nom.value.trim().length >= 3 && acepto.checked); };
      const pt = ev => { const r = svg.getBoundingClientRect(); return Math.round((ev.clientX - r.left) * 600 / r.width) + ' ' + Math.round((ev.clientY - r.top) * 150 / r.height); };
      pad.onpointerdown = ev => { ev.preventDefault(); trazando = true; pad.setPointerCapture(ev.pointerId); d += 'M' + pt(ev); path.setAttribute('d', d); pad.classList.add('con'); };
      pad.onpointermove = ev => { if (!trazando || d.length > 30000) return; d += 'L' + pt(ev); path.setAttribute('d', d); };
      pad.onpointerup = pad.onpointercancel = () => { trazando = false; listo(); };
      box.querySelector('[data-flimpiar]').onclick = () => { d = ''; path.setAttribute('d', ''); pad.classList.remove('con'); listo(); };
      nom.oninput = listo; acepto.onchange = listo;
      btn.onclick = async () => {
        btn.disabled = true; btn.textContent = 'Firmando…';
        try {
          await guardarFirma(id, { nombre: nom.value.trim(), puesto: pue.value.trim(), d, h: huellaFn ? huellaFn() : '' });
          repinta(); toast('Firmado: enterado y aceptado');
        } catch (e) { btn.disabled = false; btn.textContent = 'Firmar'; toast(e.message); }
      };
    }
    function avisosFirma() {
      if (!S) return;
      if (ruta.v === 'proc' && ruta.paso === '__fin') {
        const cap = capDe(ruta.cap); const a = document.querySelector('#foco [data-aviso]'); const f = F[firmaId(cap)];
        if (f && a) a.classList.toggle('oculto', f.h === huellaCap(cap));
      }
      const ac = document.querySelector('#firmaCierre [data-aviso]');
      if (F.__cierre && ac) ac.classList.toggle('oculto', F.__cierre.h === huellaTodo());
    }

    // ── CIERRE GENERAL ─────────────────────────────────────────────────────
    function recolectar() {
      const fallas = [], mejoras = [], dudas = [], decs = [];
      GUIA.capitulos.forEach(cap => secsDe(cap).forEach(s => {
        const e = est(s.id); const donde = etiquetaCap(cap) + ' · ' + (s.dueno ? 'Con el dueño' : s.nombre);
        demos(s).forEach((p, k) => { const st = e.puntos[k]; if (cuenta(s, e, k) && st && st.e === 'falla' && !st.hz) fallas.push({ cap: cap.id, donde, que: p.h + ' → ' + p.d, nota: st.n || '' }); });
        e.extra.forEach(p => { if (p.e === 'falla' && !p.hz) fallas.push({ cap: cap.id, donde, que: p.t, nota: p.n || '' }); });
        e.hall.forEach(h => (h.tipo === 'Bug' ? fallas : mejoras).push(Object.assign({ cap: cap.id, donde }, h)));
        e.dudas.forEach(d => { if (d.q) dudas.push(Object.assign({ cap: cap.id, donde }, d)); });
        (s.decidir || []).forEach((q, k) => { if ((e.dec[k] || '').trim()) decs.push({ cap: cap.id, donde, q, r: e.dec[k] }); });
      }));
      const o = { Alta: 0, Media: 1, Baja: 2, '': 3 };
      const ord = (a, b) => (o[a.prio || ''] - o[b.prio || '']);
      return { fallas: fallas.sort(ord), mejoras: mejoras.sort(ord), dudas, decs };
    }
    function pintarCierre() {
      $('#filtroRes').innerHTML = '<button class="pill' + (!filtroRes ? ' on' : '') + '" data-fr="">Todos</button>' + GUIA.capitulos.map(c => '<button class="pill' + (filtroRes === c.id ? ' on' : '') + '" data-fr="' + esc(c.id) + '">' + esc(etiquetaCap(c)) + '</button>').join('');
      $('#filtroRes').querySelectorAll('[data-fr]').forEach(b => b.onclick = () => { filtroRes = b.dataset.fr; pintarCierre(); });
      const R = recolectar(); const f = x => !filtroRes || x.cap === filtroRes;
      const tag = p => p ? '<span class="tag ' + esc(p) + '">' + esc(p) + '</span>' : '';
      const tabla = (arr, vacio) => arr.length ? '<div class="lista-cierre">' + arr.map(x => '<div class="li"><span>' + tag(x.prio) + ' ' + esc(x.que) + (x.uso ? ' — <i>' + esc(x.uso) + '</i>' : '') + (x.nota ? ' — <i>' + esc(x.nota) + '</i>' : '') + '<br><span class="w">' + esc(x.donde) + (x.resp ? ' · responsable: ' + esc(x.resp) : '') + (x.fecha ? ' · ' + esc(x.fecha) : '') + '</span></span><span class="w">' + esc(x.deci || '') + '</span></div>').join('') + '</div>' : '<div class="vacio">' + vacio + '</div>';
      const D = R.dudas.filter(f);
      $('#resumen').innerHTML =
        '<h3>Fallas por corregir (' + R.fallas.filter(f).length + ')</h3>' + tabla(R.fallas.filter(f), 'Sin fallas.')
        + '<h3>Mejoras que pidió el cliente (' + R.mejoras.filter(f).length + ')</h3>' + tabla(R.mejoras.filter(f), 'Sin mejoras anotadas.')
        + '<h3>Dudas (' + D.filter(d => !d.ok).length + ' abiertas)</h3>' + (D.length ? '<div class="lista-cierre">' + D.map(d => '<div class="li"><span>' + esc(d.q) + (d.r ? '<br><span class="w">' + esc(d.r) + '</span>' : '') + '<br><span class="w">' + esc(d.donde) + (d.quien ? ' · la responde: ' + esc(d.quien) : '') + '</span></span><span class="w">' + (d.ok ? 'Resuelta' : 'Abierta') + '</span></div>').join('') + '</div>' : '<div class="vacio">Sin dudas.</div>')
        + '<h3>Decisiones del cliente (' + R.decs.filter(f).length + ')</h3>' + (R.decs.filter(f).length ? '<div class="lista-cierre">' + R.decs.filter(f).map(x => '<div class="li"><span>' + esc(x.q) + '<br><span class="w">' + esc(x.donde) + '</span></span><b>' + esc(x.r) + '</b></div>').join('') + '</div>' : '<div class="vacio">Sin decisiones registradas.</div>')
        + (function () {
            const it = []; GUIA.capitulos.forEach(c => ['dueno', 'equipo'].forEach(m => { const k = c.id + (m === 'dueno' ? '-d' : '-e'); if ((S.procNota[k] || '').trim() && (!filtroRes || c.id === filtroRes)) it.push('<div class="li"><span>' + esc(S.procNota[k]) + '<br><span class="w">' + esc(etiquetaCap(c) + ' · ' + c.nombre + (m === 'dueno' ? ' · dueño' : ' · equipo')) + '</span></span></div>'); }));
            return it.length ? '<h3>Lo que el cliente cambiaría</h3><div class="lista-cierre">' + it.join('') + '</div>' : '';
          })();
      pintarFirmaCierre();
      pintarHist();
    }
    function pintarFirmaCierre() {
      const f = F.__cierre;
      $('#firmaCierre').innerHTML = htmlFirma('Firma del cliente · cierre de la sesión', LEY_CIERRE, f, f && f.h !== huellaTodo());
      enlazarFirma($('#firmaCierre [data-firma]'), '__cierre', huellaTodo, () => { pintarFirmaCierre(); pintarHist(); });
    }

    // ── Barra ──────────────────────────────────────────────────────────────
    function ligaCliente() { return cc ? location.origin + location.pathname + '?c=' + cc : ''; }
    $('#modo').onclick = ev => {
      const b = ev.target.closest('[data-modo]'); if (!b || !S || b.dataset.modo === S.vista) return;
      S.vista = b.dataset.modo; logEv('Cambió a la sesión con el ' + (esDueno() ? 'dueño' : 'equipo')); if (!esCliente()) cambio();
      toast(esDueno() ? 'Sesión con el dueño: visión, resultados y reglas' : 'Sesión con el equipo: el detalle en pantalla');
      if (ruta.v === 'proc') ir('#/p/' + ruta.cap); else render();
    };
    $('#btnPend').onclick = () => {
      const on = document.body.classList.toggle('pend'); $('#btnPend').classList.toggle('on', on);
      toast(on ? 'Solo se ven los puntos sin revisar y las fallas' : 'Se ven todos los puntos');
    };
    $('#btnMas').onclick = ev => { ev.stopPropagation(); $('#menuMas').classList.toggle('oculto'); };
    document.addEventListener('click', ev => { if (!ev.target.closest('.menu')) $('#menuMas').classList.add('oculto'); });
    $('#menuMas').onclick = ev => {
      const b = ev.target.closest('[data-acc]'); if (!b) return; $('#menuMas').classList.add('oculto');
      ({ pdf: imprimir, csv: exportarCsv, liga: copiarLiga, cierre: () => ir('#/cierre') })[b.dataset.acc]();
    };
    async function copiarLiga() {
      const url = location.origin + location.pathname + '?s=' + codigo;
      try { await navigator.clipboard.writeText(url); toast('Tu liga de orquestador está copiada (no la compartas con el cliente)'); } catch (e) { toast(url); }
    }
    function imprimir() {
      const T = totales();
      let h = '<div class="marca">Sacscloud · Checklist de entrega</div><h1 style="margin-top:6px">Suite de Consignación</h1>'
        + '<p class="sub">' + esc(S.meta.cliente) + ' · ' + esc(S.meta.cuenta) + ' · Orquestador: ' + esc(S.meta.consultor) + ' · ' + esc(S.meta.fecha) + ' · ' + esc(S.meta.ambiente) + '</p>'
        + '<p class="sub">' + T.hechos + ' de ' + T.tot + ' puntos demostrados · ' + T.fallas + ' con falla · ' + T.decOk + '/' + T.dec + ' decisiones · ' + T.dudas + ' dudas abiertas · ' + T.firm + '/' + T.procs + ' procesos firmados</p>';
      GUIA.capitulos.forEach(cap => {
        h += '<section class="imp-cap"><h2 style="margin-top:24px">' + esc(etiquetaCap(cap) + ' · ' + cap.nombre) + '</h2>' + (cap.diagrama ? htmlMapa(cap.diagrama) : '');
        secsModo(cap, 'dueno').forEach(s => { h += htmlSec(cap, s, true); });
        h += htmlFin(cap, true, 'dueno');
        secsModo(cap, 'equipo').forEach(s => { h += htmlSec(cap, s, true); });
        h += htmlFin(cap, true, 'equipo') + '</section>';
      });
      $('#imprimir').innerHTML = h;
      setTimeout(() => window.print(), 150);
    }
    window.addEventListener('afterprint', () => { $('#imprimir').innerHTML = ''; });
    function exportarCsv() {
      const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
      const filas = [['Proceso', 'Sesión · etapa', 'Renglón', 'Tipo', 'Texto', 'Resultado / respuesta', 'Nota / cómo lo quiere', 'Prioridad', 'Responsable', 'Fecha compromiso', 'Estado', 'Fotos']];
      GUIA.capitulos.forEach(cap => {
        const pn = etiquetaCap(cap) + ' · ' + cap.nombre;
        secsDe(cap).forEach(s => {
          const e = est(s.id); const sn = s.dueno ? 'Dueño' : 'Equipo · ' + s.nombre;
          demos(s).forEach((p, k) => { if (!cuenta(s, e, k)) return; const st = e.puntos[k] || {}; filas.push([pn, sn, 'Demostrar', p.o ? 'Opcional' : 'Esencial', p.h + ' → ' + p.d, RES[st.e || ''], st.n || '', '', '', '', '', (st.fotos || []).join(' ')]); });
          e.extra.forEach(p => filas.push([pn, sn, 'Demostrar', 'Agregado', p.t, RES[p.e || ''], p.n || '', '', '', '', '', (p.fotos || []).join(' ')]));
          (s.decidir || []).forEach((dq, k) => filas.push([pn, sn, 'Decisión', '', dq, e.dec[k] || '', '', '', '', '', (e.dec[k] || '').trim() ? 'Contestada' : 'Pendiente', '']));
          e.dudas.forEach(d => filas.push([pn, sn, 'Duda', '', d.q, d.r || '', '', '', d.quien || '', '', d.ok ? 'Resuelta' : 'Abierta', '']));
          e.hall.forEach(h => filas.push([pn, sn, 'Mejora / falla', h.tipo, h.que, '', h.uso, h.prio, h.resp || '', h.fecha || '', h.deci || 'Pendiente', (h.fotos || []).join(' ')]));
        });
        ['dueno', 'equipo'].forEach(m => {
          const k = cap.id + (m === 'dueno' ? '-d' : '-e'); const sn = m === 'dueno' ? 'Dueño · cierre' : 'Equipo · cierre';
          if ((S.procNota[k] || '').trim()) filas.push([pn, sn, 'Qué cambiaría', '', S.procNota[k], '', '', '', '', '', '', '']);
          const f = F[k]; if (f) filas.push([pn, sn, 'Firma', '', f.nombre + (f.puesto ? ' · ' + f.puesto : ''), 'Enterado y aceptado', fechaFirma(f.at) + (f.h !== huellaCap(cap, m) ? ' · con cambios después de la firma' : ''), '', '', '', '', '']);
        });
      });
      const csv = '﻿' + filas.map(f => f.map(q).join(',')).join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = 'checklist-consignacion-vendetucloset-' + (S.meta.fecha || '') + '.csv';
      a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }

    $('#btnEnviar').onclick = async () => {
      if (!cc) { await subir(); }
      if (!cc) return toast('Sin conexión: guarda la sesión y vuelve a intentar.');
      const T = totales(); const R = recolectar(); const url = ligaCliente();
      const nombre = S.meta.responsable ? S.meta.responsable.split(' ')[0] : '';
      const fecha = S.meta.fecha ? new Date(S.meta.fecha + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }) : 'hoy';
      const txt = 'Hola' + (nombre ? ' ' + nombre : '') + ', te comparto el resumen de la revisión de la Suite de Consignación del ' + fecha + ': '
        + T.hechos + ' puntos demostrados, ' + T.decOk + ' decisiones tomadas, ' + R.mejoras.length + ' mejoras anotadas y ' + T.dudas + ' dudas por resolver. '
        + 'Aquí puedes ver el detalle, descargarlo en PDF y firmar de enterado cada proceso: ' + url;
      const lista = R.mejoras.concat(R.fallas).slice(0, 20).map(h => '• [' + (h.prio || 'Sin prioridad') + '] ' + h.donde + ': ' + corto(h.que, 120) + (h.resp ? ' (responsable: ' + h.resp + (h.fecha ? ', ' + h.fecha : '') + ')' : '')).join('\n');
      const cuerpo = txt + '\n\nPendientes principales:\n' + (lista || '• Sin pendientes') + (S.cierre.acuerdos ? '\n\nAcuerdos:\n' + S.cierre.acuerdos : '') + '\n\nSacscloud';
      const m = document.createElement('div'); m.className = 'modal-fondo';
      m.innerHTML = '<div class="modal"><h2>Enviar al cliente</h2><p class="sub">El cliente recibe su propia liga: ve todo lo revisado, lo descarga en PDF y firma de enterado. No puede editar nada.</p>'
        + '<div class="liga">' + esc(url) + '</div>'
        + '<div class="acciones"><a class="btn pri" target="_blank" rel="noopener" href="https://wa.me/?text=' + encodeURIComponent(txt) + '">WhatsApp</a>'
        + '<a class="btn" href="mailto:?subject=' + encodeURIComponent('Revisión de la Suite de Consignación · ' + S.meta.cliente + ' · ' + fecha) + '&body=' + encodeURIComponent(cuerpo) + '">Correo</a>'
        + '<button class="btn" data-copiar>Copiar liga</button><a class="btn" target="_blank" rel="noopener" href="' + esc(url) + '">Ver como cliente</a></div>'
        + '<div class="acciones"><button class="btn" data-cerrar>Cerrar</button></div></div>';
      document.body.appendChild(m);
      m.onclick = ev => { if (ev.target === m || ev.target.closest('[data-cerrar]')) m.remove(); };
      m.querySelector('[data-copiar]').onclick = async () => { try { await navigator.clipboard.writeText(url); toast('Liga del cliente copiada'); } catch (e) { toast(url); } };
      logEv('Preparó el envío del resumen al cliente'); cambio();
    };

    arrancar();
  })();
  </script>
</body>
</html>
