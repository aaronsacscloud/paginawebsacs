  <script is:inline>
  (function () {
    const ID_GUIA = 'consignacion-dashboard-reportes';
    const API = '/api/entrega/sesion';
    const LS = 'entrega:' + ID_GUIA + ':';
    const TIPOS = ['Campo / columna', 'Dato / cálculo', 'Filtro', 'Total / subtotal', 'Exportación', 'Gráfica / indicador', 'Reporte nuevo', 'Otro'];
    const PRIOS = ['Alta', 'Media', 'Baja'];
    const DECIS = ['Pendiente', 'Aprobado', 'Descartado', 'Hecho'];
    const $ = (s, r) => (r || document).querySelector(s);
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    let codigo = null, S = null, timer = null, guardando = false, pendiente = false, reintento = null;

    function toast(t) { const el = $('#toast'); el.textContent = t; el.classList.add('on'); clearTimeout(el._t); el._t = setTimeout(() => el.classList.remove('on'), 2600); }
    function nuevoCodigo() { const a = new Uint8Array(12); crypto.getRandomValues(a); return Array.from(a, b => (b % 36).toString(36)).join('') + Date.now().toString(36).slice(-4); }
    function vacio(cliente) { return { meta: { cliente: cliente || '', cuenta: '', fecha: new Date().toISOString().slice(0, 10), consultor: '', responsable: '', ambiente: '' }, sec: {}, extras: [], cierre: { acuerdos: '', firmaCliente: '', firmaSacs: '' }, cerradas: {}, _ts: Date.now() }; }
    function secs() { return GUIA.secciones.concat(S.extras || []); }
    function est(id) { if (!S.sec[id]) S.sec[id] = { puntos: {}, extra: [], hall: [], usadas: {} }; return S.sec[id]; }

    // ── Guardado: dispositivo siempre, servidor con espera de 1 s ───────────
    function local() { try { localStorage.setItem(LS + codigo, JSON.stringify(S)); } catch (e) {} }
    function recordar() {
      try {
        const r = JSON.parse(localStorage.getItem(LS + 'recientes') || '[]').filter(x => x.c !== codigo);
        r.unshift({ c: codigo, n: S.meta.cliente || 'Sin nombre', t: Date.now() });
        localStorage.setItem(LS + 'recientes', JSON.stringify(r.slice(0, 8)));
      } catch (e) {}
    }
    function estado(cls, txt) { const e = $('#estado'); e.className = 'estado ' + cls; $('#estadoTxt').textContent = txt; }
    function cambio() {
      S._ts = Date.now(); S._sinc = false; local();
      estado('sav', 'Cambios sin guardar…');
      clearTimeout(timer); timer = setTimeout(subir, 1000);
      pintarResumen();
    }
    async function subir() {
      if (guardando) { pendiente = true; return; }
      guardando = true; pendiente = false; estado('sav', 'Guardando…');
      try {
        const r = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ codigo, guia: ID_GUIA, cliente: S.meta.cliente, data: S }) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.error || 'Error ' + r.status);
        S._sinc = true; local(); recordar();
        estado('ok', 'Guardado ' + new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }));
        clearTimeout(reintento);
      } catch (e) {
        estado('err', 'Sin conexión: guardado en este dispositivo');
        clearTimeout(reintento); reintento = setTimeout(subir, 10000);
      } finally {
        guardando = false;
        if (pendiente) subir();
      }
    }
    window.addEventListener('online', () => { if (S && !S._sinc) subir(); });

    // ── Arranque ───────────────────────────────────────────────────────────
    async function arrancar() {
      if (!GUIA) { document.body.innerHTML = '<p style="padding:24px">La guía no está disponible.</p>'; return; }
      const q = new URLSearchParams(location.search);
      codigo = (q.get('s') || '').toLowerCase();
      if (!/^[a-z0-9]{12,40}$/.test(codigo)) return pantallaInicio();
      $('#app').classList.remove('oculto');
      let loc = null; try { loc = JSON.parse(localStorage.getItem(LS + codigo) || 'null'); } catch (e) {}
      let srv = null, red = true;
      try {
        const r = await fetch(API + '?s=' + codigo, { cache: 'no-store' });
        const j = await r.json(); if (!j.ok) throw new Error(j.error);
        srv = j.sesion && j.sesion.data;
      } catch (e) { red = false; }
      // Gana el servidor, salvo que este dispositivo tenga cambios que no alcanzó a subir.
      if (loc && !loc._sinc && (!srv || (loc._ts || 0) > (srv._ts || 0))) { S = loc; pintar(); subir(); return; }
      S = srv || loc || vacio('');
      pintar();
      if (!red) estado('err', 'Sin conexión: trabajando en este dispositivo');
      else if (!srv) subir();
      else { S._sinc = true; local(); recordar(); estado('ok', 'Sesión cargada'); }
    }

    function pantallaInicio() {
      $('#inicio').classList.remove('oculto');
      let r = []; try { r = JSON.parse(localStorage.getItem(LS + 'recientes') || '[]'); } catch (e) {}
      $('#recientes').innerHTML = r.length ? '<h3>Recientes en este dispositivo</h3>' + r.map(x => '<a href="?s=' + esc(x.c) + '">' + esc(x.n) + '<span>' + new Date(x.t).toLocaleDateString('es-MX') + '</span></a>').join('') : '';
      $('#btnNueva').onclick = () => {
        const c = nuevoCodigo(); const cliente = $('#nuevoCliente').value.trim();
        try { localStorage.setItem(LS + c, JSON.stringify(Object.assign(vacio(cliente), { _sinc: false }))); } catch (e) {}
        location.search = '?s=' + c;
      };
      $('#btnAbrir').onclick = () => {
        const v = $('#abrirCodigo').value.trim(); const m = v.match(/[?&]s=([a-z0-9]{12,40})/i) || v.match(/^([a-z0-9]{12,40})$/i);
        if (!m) return toast('No reconozco esa liga o código.');
        location.search = '?s=' + m[1].toLowerCase();
      };
    }

    // ── Pintado ────────────────────────────────────────────────────────────
    function conteo(s) {
      const e = est(s.id); const tot = s.puntos.length + e.extra.length; let hechos = 0, fallas = 0;
      s.puntos.forEach((_, i) => { const p = e.puntos[i]; if (p && p.e) { hechos++; if (p.e === 'falla') fallas++; } });
      e.extra.forEach(p => { if (p.e) { hechos++; if (p.e === 'falla') fallas++; } });
      return { tot, hechos, fallas, hall: e.hall.length };
    }

    function pintar() {
      document.querySelectorAll('[data-meta]').forEach(el => { el.value = S.meta[el.dataset.meta] || ''; el.oninput = () => { S.meta[el.dataset.meta] = el.value; cambio(); }; });
      document.querySelectorAll('[data-cierre]').forEach(el => { el.value = S.cierre[el.dataset.cierre] || ''; el.oninput = () => { S.cierre[el.dataset.cierre] = el.value; cambio(); }; });
      $('#secciones').innerHTML = secs().map((s, i) => htmlSec(s, i)).join('');
      secs().forEach(s => enlazar(s));
      pintarResumen();
    }

    function htmlSec(s, i) {
      const e = est(s.id); const c = conteo(s); const cerrada = S.cerradas[s.id];
      const hoy = (s.hoy || []).map(x => '<span class="chip">' + esc(x) + '</span>').join('');
      const fil = (s.filtros || []).map(x => '<span class="chip fil">' + esc(x) + '</span>').join('');
      const pts = s.puntos.map((t, k) => htmlPunto(s.id, 'b' + k, t, e.puntos[k] || {}, false)).join('') + e.extra.map((p, k) => htmlPunto(s.id, 'x' + k, p.t, p, true)).join('');
      const sug = (s.sugerencias || []).map((g, k) => '<div class="sug' + (e.usadas[k] ? ' usada' : '') + '"><span class="tp">' + esc(g.tipo) + '</span><span class="tx">' + esc(g.texto) + '</span><button class="btn peq" data-sug="' + k + '"' + (e.usadas[k] ? ' disabled' : '') + '>' + (e.usadas[k] ? 'En la tabla' : 'Agregar') + '</button></div>').join('');
      return '<section class="card sec' + (cerrada ? ' cerrada' : '') + '" id="s-' + esc(s.id) + '" data-sec="' + esc(s.id) + '">'
        + '<div class="sec-cab" data-tog><div class="num">' + (i + 1) + '</div><div class="t"><h2>' + esc(s.nombre) + '</h2>'
        + (s.donde ? '<div class="meta"><b>Dónde:</b> ' + esc(s.donde) + '</div>' : '')
        + (s.para ? '<div class="meta"><b>Para qué sirve:</b> ' + esc(s.para) + '</div>' : '')
        + '</div><span class="prog' + (c.tot && c.hechos === c.tot ? ' done' : '') + '" data-prog>' + c.hechos + '/' + c.tot + '</span>'
        + '<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>'
        + '<div class="cuerpo">'
        + (hoy || fil ? '<h3>Lo que muestra hoy</h3><div class="chips">' + hoy + fil + '</div>' : '')
        + (s.editable ? '<h3>Pantalla</h3><div class="grid"><label class="f">Nombre<input type="text" data-ren value="' + esc(s.nombre) + '" /></label><label class="f">Dónde está<input type="text" data-donde value="' + esc(s.donde || '') + '" /></label></div>' : '')
        + '<h3>Puntos a validar</h3><div data-pts>' + (pts || '<div class="vacio">Agrega los puntos que se van a revisar.</div>') + '</div>'
        + '<div class="acciones no-print"><button class="btn peq ter" data-addpt>Agregar punto a validar</button></div>'
        + (sug ? '<h3>Sugerencias para revisar con el cliente</h3>' + sug : '')
        + '<h3>Lo que le falta (campo, dato, filtro…)</h3>'
        + '<div class="hall-cab"><span>Tipo</span><span>Qué falta</span><span>Para qué lo usa el cliente</span><span>Prioridad</span><span>Decisión</span><span></span></div>'
        + '<div data-halls>' + (e.hall.length ? e.hall.map((h, k) => htmlHall(h, k)).join('') : '<div class="vacio">Sin faltantes anotados.</div>') + '</div>'
        + '<div class="acciones no-print"><button class="btn peq" data-addh>Agregar faltante</button>' + (s.editable ? '<button class="btn peq del" data-delsec>Quitar esta pantalla</button>' : '') + '</div>'
        + '</div></section>';
    }

    function htmlPunto(sid, key, t, p, extra) {
      const b = (v, l) => '<button class="' + v + (p.e === v ? ' on' : '') + '" data-e="' + v + '">' + l + '</button>';
      return '<div class="pt' + (p.e === 'falla' || p.n ? ' con-nota' : '') + '" data-pt="' + key + '"><div class="txt">' + (extra ? '<input type="text" data-ptt value="' + esc(t) + '" placeholder="Qué se valida" />' : esc(t)) + '</div>'
        + '<div class="seg">' + b('ok', 'Correcto') + b('falla', 'Falla') + b('na', 'No aplica') + '</div>'
        + '<div class="nota"><textarea data-nota placeholder="Qué se vio / comentario del cliente">' + esc(p.n || '') + '</textarea></div></div>';
    }

    function opts(list, v, ph) { return (ph ? '<option value="">' + ph + '</option>' : '') + list.map(o => '<option' + (o === v ? ' selected' : '') + '>' + esc(o) + '</option>').join(''); }
    function htmlHall(h, k) {
      return '<div class="hall" data-h="' + k + '">'
        + '<div><span class="lbl">Tipo</span><select data-hf="tipo">' + opts(TIPOS, h.tipo, 'Tipo…') + '</select></div>'
        + '<div class="ancho"><span class="lbl">Qué falta</span><textarea data-hf="que" placeholder="Campo, dato o filtro">' + esc(h.que) + '</textarea></div>'
        + '<div class="ancho"><span class="lbl">Para qué lo usa el cliente</span><textarea data-hf="uso" placeholder="La decisión o el trabajo que resuelve">' + esc(h.uso) + '</textarea></div>'
        + '<div><span class="lbl">Prioridad</span><select data-hf="prio">' + opts(PRIOS, h.prio, '—') + '</select></div>'
        + '<div><span class="lbl">Decisión</span><select data-hf="deci">' + opts(DECIS, h.deci || 'Pendiente') + '</select></div>'
        + '<button class="btn peq del x" data-delh title="Quitar">✕</button></div>';
    }

    function repintarSec(s) {
      const el = $('#s-' + CSS.escape(s.id)); const i = secs().indexOf(s);
      const tmp = document.createElement('div'); tmp.innerHTML = htmlSec(s, i); el.replaceWith(tmp.firstChild); enlazar(s); pintarResumen();
    }

    function enlazar(s) {
      const el = $('#s-' + CSS.escape(s.id)); const e = est(s.id);
      el.querySelector('[data-tog]').onclick = ev => { if (ev.target.closest('input,button,select,textarea')) return; S.cerradas[s.id] = !S.cerradas[s.id]; el.classList.toggle('cerrada'); cambio(); };
      el.querySelectorAll('[data-pt]').forEach(row => {
        const key = row.dataset.pt; const extra = key[0] === 'x'; const k = +key.slice(1);
        const obj = () => extra ? e.extra[k] : (e.puntos[k] = e.puntos[k] || {});
        row.querySelectorAll('[data-e]').forEach(b => b.onclick = () => {
          const p = obj(); p.e = p.e === b.dataset.e ? '' : b.dataset.e;
          row.querySelectorAll('[data-e]').forEach(x => x.classList.toggle('on', x.dataset.e === p.e));
          row.classList.toggle('con-nota', p.e === 'falla' || !!p.n);
          if (p.e === 'falla') row.querySelector('[data-nota]').focus();
          prog(s); cambio();
        });
        row.querySelector('[data-nota]').oninput = ev => { obj().n = ev.target.value; cambio(); };
        const tt = row.querySelector('[data-ptt]'); if (tt) tt.oninput = ev => { obj().t = ev.target.value; cambio(); };
      });
      el.querySelector('[data-addpt]').onclick = () => { e.extra.push({ t: '', e: '', n: '' }); repintarSec(s); cambio(); const ins = el.ownerDocument.querySelectorAll('#s-' + CSS.escape(s.id) + ' [data-ptt]'); if (ins.length) ins[ins.length - 1].focus(); };
      el.querySelectorAll('[data-sug]').forEach(b => b.onclick = () => {
        const k = +b.dataset.sug; const g = s.sugerencias[k]; e.usadas[k] = true;
        e.hall.push({ tipo: g.tipo, que: g.texto, uso: '', prio: '', deci: 'Pendiente' }); repintarSec(s); cambio(); toast('Agregado a la tabla de faltantes');
      });
      el.querySelectorAll('[data-h]').forEach(row => {
        const k = +row.dataset.h;
        row.querySelectorAll('[data-hf]').forEach(f => { const ev = f.tagName === 'SELECT' ? 'onchange' : 'oninput'; f[ev] = () => { e.hall[k][f.dataset.hf] = f.value; cambio(); }; });
        row.querySelector('[data-delh]').onclick = () => { e.hall.splice(k, 1); repintarSec(s); cambio(); toast('Faltante quitado'); };
      });
      el.querySelector('[data-addh]').onclick = () => { e.hall.push({ tipo: '', que: '', uso: '', prio: '', deci: 'Pendiente' }); repintarSec(s); cambio(); const t = document.querySelectorAll('#s-' + CSS.escape(s.id) + ' [data-hf="que"]'); if (t.length) t[t.length - 1].focus(); };
      const ren = el.querySelector('[data-ren]'); if (ren) ren.oninput = () => { s.nombre = ren.value; el.querySelector('h2').textContent = ren.value; cambio(); };
      const don = el.querySelector('[data-donde]'); if (don) don.oninput = () => { s.donde = don.value; cambio(); };
      const del = el.querySelector('[data-delsec]');
      if (del) del.onclick = () => {
        if (del.dataset.arm !== '1') { del.dataset.arm = '1'; del.textContent = '¿Seguro? Sí, quitar'; setTimeout(() => { del.dataset.arm = ''; del.textContent = 'Quitar esta pantalla'; }, 3500); return; }
        S.extras = S.extras.filter(x => x !== s); delete S.sec[s.id]; pintar(); cambio();
      };
    }

    function prog(s) {
      const c = conteo(s); const el = $('#s-' + CSS.escape(s.id) + ' [data-prog]');
      el.textContent = c.hechos + '/' + c.tot; el.classList.toggle('done', c.tot > 0 && c.hechos === c.tot);
    }

    function todosHall() {
      const out = [];
      secs().forEach(s => est(s.id).hall.forEach(h => out.push(Object.assign({ pantalla: s.nombre }, h))));
      const o = { Alta: 0, Media: 1, Baja: 2, '': 3 };
      return out.sort((a, b) => (o[a.prio || ''] - o[b.prio || '']));
    }

    function pintarResumen() {
      let tot = 0, hechos = 0, fallas = 0;
      secs().forEach(s => { const c = conteo(s); tot += c.tot; hechos += c.hechos; fallas += c.fallas; });
      const H = todosHall(); const altas = H.filter(h => h.prio === 'Alta').length;
      $('#kpis').innerHTML =
        '<div class="kpi"><span class="l">Avance</span><span class="c">' + (tot ? Math.round(hechos * 100 / tot) : 0) + '%</span><span class="s">' + hechos + ' de ' + tot + ' puntos revisados</span></div>'
        + '<div class="kpi ve"><span class="l">Correctos</span><span class="c">' + (hechos - fallas) + '</span><span class="s">incluye los que no aplican</span></div>'
        + '<div class="kpi rj"><span class="l">Con falla</span><span class="c">' + fallas + '</span><span class="s">puntos que no pasaron</span></div>'
        + '<div class="kpi am"><span class="l">Faltantes anotados</span><span class="c">' + H.length + '</span><span class="s">' + altas + ' de prioridad alta</span></div>';
      $('#nav').innerHTML = secs().map((s, i) => { const c = conteo(s); return '<button class="pill' + (c.tot && c.hechos === c.tot ? ' done' : '') + '" data-ir="' + esc(s.id) + '">' + (i + 1) + '. ' + esc(s.nombre) + ' <span class="n">' + c.hechos + '/' + c.tot + '</span></button>'; }).join('') + '<button class="pill" data-ir="__cierre">Resumen y cierre</button>';
      $('#nav').querySelectorAll('[data-ir]').forEach(b => b.onclick = () => {
        const id = b.dataset.ir; const el = id === '__cierre' ? $('#cierre') : $('#s-' + CSS.escape(id));
        if (id !== '__cierre' && S.cerradas[id]) { S.cerradas[id] = false; el.classList.remove('cerrada'); }
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 110, behavior: 'smooth' });
      });
      $('#resumen').innerHTML = H.length
        ? '<table class="resumen-t"><thead><tr><th>Prioridad</th><th>Pantalla</th><th>Tipo</th><th>Qué falta</th><th>Para qué</th><th>Decisión</th></tr></thead><tbody>'
          + H.map(h => '<tr><td>' + (h.prio ? '<span class="tag ' + esc(h.prio) + '">' + esc(h.prio) + '</span>' : '—') + '</td><td>' + esc(h.pantalla) + '</td><td>' + esc(h.tipo || '—') + '</td><td>' + esc(h.que) + '</td><td>' + esc(h.uso) + '</td><td>' + esc(h.deci || 'Pendiente') + '</td></tr>').join('')
          + '</tbody></table>'
        : '<div class="vacio">Todavía no hay faltantes anotados.</div>';
    }

    // ── Botones de la barra ────────────────────────────────────────────────
    $('#btnLiga').onclick = async () => {
      const url = location.origin + location.pathname + '?s=' + codigo;
      try { await navigator.clipboard.writeText(url); toast('Liga copiada'); } catch (e) { prompt('Copia la liga:', url); }
    };
    $('#btnPdf').onclick = () => { secs().forEach(s => { S.cerradas[s.id] = false; }); document.querySelectorAll('.sec.cerrada').forEach(x => x.classList.remove('cerrada')); setTimeout(() => window.print(), 100); };
    $('#btnCsv').onclick = () => {
      const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
      const filas = [['Sección', 'Pantalla', 'Tipo', 'Punto / faltante', 'Resultado', 'Nota / para qué', 'Prioridad', 'Decisión']];
      const R = { ok: 'Correcto', falla: 'Falla', na: 'No aplica', '': 'Sin revisar' };
      secs().forEach(s => {
        const e = est(s.id);
        s.puntos.forEach((t, k) => { const p = e.puntos[k] || {}; filas.push(['Punto a validar', s.nombre, '', t, R[p.e || ''], p.n || '', '', '']); });
        e.extra.forEach(p => filas.push(['Punto a validar', s.nombre, '', p.t, R[p.e || ''], p.n || '', '', '']));
        e.hall.forEach(h => filas.push(['Faltante', s.nombre, h.tipo, h.que, '', h.uso, h.prio, h.deci || 'Pendiente']));
      });
      const csv = '﻿' + filas.map(f => f.map(q).join(',')).join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = 'checklist-consignacion-' + (S.meta.cliente || 'cliente').toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-' + (S.meta.fecha || '') + '.csv';
      a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    };
    $('#btnOtra').onclick = () => {
      const s = { id: 'x' + Date.now().toString(36), nombre: 'Pantalla o reporte nuevo', donde: '', para: '', puntos: [], sugerencias: [], editable: true };
      S.extras = S.extras || []; S.extras.push(s); pintar(); cambio();
      const el = $('#s-' + CSS.escape(s.id)); el.scrollIntoView({ behavior: 'smooth', block: 'start' }); const r = el.querySelector('[data-ren]'); if (r) { r.focus(); r.select(); }
    };

    arrancar();
  })();
  </script>
</body>
</html>
