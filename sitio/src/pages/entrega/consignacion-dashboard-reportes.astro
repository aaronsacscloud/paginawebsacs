---
// Checklist de ENTREGA · Suite de Consignación · Dashboard y reportes
// (19-oct-2026).
//
// La usa el consultor en la tableta, con el cliente enfrente, para revisar el
// dashboard general y los reportes especiales de consignación: qué se valida
// en cada uno y qué le falta (un campo, un dato, un filtro). Todo se captura
// aquí mismo y se guarda solo en `entregas_checklist` (api/entrega/sesion),
// con respaldo en el dispositivo por si se cae la señal.
//
// Página estática: el contenido base vive en GUIA (abajo) y lo que se captura
// en la sesión de cada cliente, identificada por ?s=<codigo> en la liga.
export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Checklist de entrega · Consignación · Dashboard y reportes</title>
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700;9..40,800&display=swap" />
  <style is:inline>
    :root {
      --v: #9B8CFA; --vt: #5B4BD6; --vh: #4536BE; --va: #EEECFE; --vb: #ddd6fb;
      --az: #7DA6F5; --azt: #2C5FC4; --aza: #E3EDFD;
      --ro: #D9538E;
      --ve: #4FBF95; --vet: #1E8A63; --vea: #EAF8F2;
      --rj: #EF7A72; --rjt: #C0554E; --rja: #FEF0EF;
      --am: #E8A838; --amt: #9a6a10; --ama: #FFF4E5;
      --tx: #1d1b2e; --tx2: #5f5d72; --tx3: #8b8a99; --ln: #ececec; --bg: #f7f6fb; --card: #fff;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--bg); color: var(--tx); font-family: 'DM Sans', system-ui, -apple-system, sans-serif; -webkit-text-size-adjust: 100%; }
    body { font-size: 15px; line-height: 1.45; }
    button, input, select, textarea { font: inherit; color: inherit; }
    .cinta { height: 5px; background: linear-gradient(90deg,#9B8CFA,#7DA6F5 55%,rgba(244,168,205,.9)); }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 22px 16px 120px; }
    .firma { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; background: linear-gradient(100deg,#7C6BF0,#8E7DEF 35%,#D9538E); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .firma .marca { text-transform: none; letter-spacing: .02em; font-size: 13px; }
    h1 { font-size: 1.65rem; line-height: 1.2; margin: 6px 0 4px; font-weight: 800; }
    h2 { font-size: 1.2rem; margin: 0; font-weight: 800; }
    h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--tx3); margin: 18px 0 8px; font-weight: 800; }
    .sub { color: var(--tx2); margin: 0; }
    .card { background: var(--card); border: 1px solid var(--ln); border-radius: 12px; padding: 16px 18px; margin-top: 14px; }
    .ancla { background: linear-gradient(135deg,#EEECFE,rgba(244,168,205,.22)); border-color: var(--vb); }
    .grid { display: grid; gap: 10px 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
    label.f { display: flex; flex-direction: column; gap: 4px; font-size: .75rem; font-weight: 700; color: var(--tx2); text-transform: uppercase; letter-spacing: .05em; }
    input[type=text], input[type=date], select, textarea {
      width: 100%; border: 1px solid #dcdbe6; border-radius: 9px; padding: 10px 11px; background: #fff; font-size: 15px; text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--tx);
      min-height: 44px;
    }
    textarea { resize: vertical; min-height: 64px; }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--v); outline-offset: 0; border-color: var(--v); }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 16px; border-radius: 10px; border: 1.5px solid var(--v); background: #fff; color: var(--vt); font-weight: 700; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .btn:hover { background: var(--va); }
    .btn.pri { background: var(--v); color: #fff; }
    .btn.pri:hover { background: #7C6BF0; }
    .btn.ter { border-color: #d8d8de; color: var(--tx2); }
    .btn.peq { min-height: 36px; padding: 0 12px; font-size: .875rem; }
    .btn.del { border-color: #f0c4bd; color: var(--rjt); }
    .btn:disabled { opacity: .5; cursor: default; }
    .barra { position: sticky; top: 0; z-index: 20; background: rgba(247,246,251,.94); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--ln); }
    .barra .in { max-width: 1120px; margin: 0 auto; padding: 8px 16px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .estado { font-size: .8125rem; color: var(--tx2); display: inline-flex; align-items: center; gap: 6px; margin-right: auto; }
    .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--tx3); }
    .estado.ok .punto { background: var(--ve); } .estado.err .punto { background: var(--am); } .estado.sav .punto { background: var(--v); }
    .nav { display: flex; gap: 6px; overflow-x: auto; padding: 4px 16px 10px; max-width: 1120px; margin: 0 auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .pill { white-space: nowrap; border: 1px solid var(--ln); background: #fff; border-radius: 999px; padding: 7px 12px; font-size: .8125rem; font-weight: 600; color: var(--tx2); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
    .pill .n { font-size: .6875rem; background: var(--va); color: var(--vt); border-radius: 999px; padding: 1px 7px; font-weight: 800; }
    .pill.done { border-color: #bfe8d6; } .pill.done .n { background: var(--vea); color: var(--vet); }
    .kpis { display: grid; gap: 10px; grid-template-columns: repeat(4, 1fr); margin-top: 14px; }
    .kpi { background: #fff; border: 1px solid var(--ln); border-left: 3px solid var(--v); border-radius: 10px; padding: 13px 15px; display: flex; flex-direction: column; }
    .kpi .l { font-size: .625rem; text-transform: uppercase; letter-spacing: .08em; color: #999; font-weight: 800; }
    .kpi .c { font-size: 1.5rem; font-weight: 800; color: var(--vt); margin-top: 2px; }
    .kpi .s { font-size: .6875rem; color: #888; margin-top: auto; }
    .kpi.ve { border-left-color: var(--ve); } .kpi.ve .c { color: var(--vet); }
    .kpi.rj { border-left-color: var(--rj); } .kpi.rj .c { color: var(--rjt); }
    .kpi.am { border-left-color: var(--am); } .kpi.am .c { color: var(--amt); }
    .sec-cab { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; }
    .sec-cab .num { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 10px; background: var(--va); color: var(--vt); font-weight: 800; display: flex; align-items: center; justify-content: center; }
    .sec-cab .t { flex: 1; min-width: 0; }
    .sec-cab .prog { font-size: .75rem; font-weight: 800; color: var(--vt); background: var(--va); border-radius: 999px; padding: 3px 9px; white-space: nowrap; }
    .sec-cab .prog.done { background: var(--vea); color: var(--vet); }
    .meta { font-size: .8125rem; color: var(--tx2); margin-top: 3px; }
    .meta b { color: var(--tx); font-weight: 700; }
    .chev { transition: transform .2s; color: var(--tx3); flex: 0 0 auto; margin-top: 6px; }
    .sec.cerrada .chev { transform: rotate(-90deg); }
    .sec.cerrada .cuerpo { display: none; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { font-size: .8125rem; background: #f3f3f6; border-radius: 7px; padding: 4px 9px; color: var(--tx2); }
    .chip.fil { background: var(--aza); color: var(--azt); }
    .pt { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; align-items: center; padding: 10px 0; border-top: 1px solid #f1f1f4; }
    .pt:first-of-type { border-top: 0; }
    .pt .txt { font-size: .9375rem; }
    .pt .txt .extra { font-size: .6875rem; color: var(--vt); background: var(--va); border-radius: 5px; padding: 1px 6px; margin-left: 6px; font-weight: 700; }
    .seg { display: inline-flex; border: 1px solid #dcdbe6; border-radius: 10px; overflow: hidden; }
    .seg button { border: 0; background: #fff; min-height: 40px; min-width: 76px; padding: 0 10px; font-size: .8125rem; font-weight: 700; color: var(--tx2); cursor: pointer; border-left: 1px solid #dcdbe6; }
    .seg button:first-child { border-left: 0; }
    .seg button.on.ok { background: var(--vea); color: var(--vet); }
    .seg button.on.falla { background: var(--rja); color: var(--rjt); }
    .seg button.on.na { background: #f1f1f4; color: var(--tx2); }
    .pt .nota { grid-column: 1 / -1; display: none; }
    .pt.con-nota .nota { display: block; }
    .pt .nota textarea { min-height: 44px; }
    .sug { display: flex; gap: 10px; align-items: flex-start; padding: 9px 11px; border: 1px dashed var(--vb); border-radius: 10px; background: #fcfbff; margin-top: 8px; }
    .sug .tp { font-size: .6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--azt); background: var(--aza); border-radius: 5px; padding: 2px 6px; white-space: nowrap; margin-top: 2px; }
    .sug .tx { flex: 1; font-size: .875rem; }
    .sug.usada { opacity: .5; }
    .hall { border: 1px solid #e6e5ee; border-radius: 10px; padding: 10px 12px; margin-top: 10px; background: #fff; display: grid; gap: 8px; grid-template-columns: 170px 1fr 1fr 120px 140px 44px; align-items: start; }
    .hall-cab { display: grid; grid-template-columns: 170px 1fr 1fr 120px 140px 44px; gap: 8px; padding: 0 12px; font-size: .6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--tx3); margin-top: 6px; }
    .hall textarea { min-height: 44px; }
    .hall .x { min-height: 44px; width: 44px; padding: 0; }
    .hall .lbl { display: none; }
    .vacio { color: var(--tx3); font-size: .875rem; padding: 6px 0; }
    .acciones { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .resumen-t { width: 100%; border-collapse: collapse; font-size: .875rem; margin-top: 8px; }
    .resumen-t th { text-align: left; font-size: .6875rem; text-transform: uppercase; letter-spacing: .05em; color: var(--tx3); padding: 6px 8px; border-bottom: 1px solid var(--ln); }
    .resumen-t td { padding: 8px; border-bottom: 1px solid #f1f1f4; vertical-align: top; }
    .tag { font-size: .6875rem; font-weight: 800; border-radius: 5px; padding: 2px 7px; white-space: nowrap; display: inline-block; }
    .tag.Alta { background: var(--rja); color: var(--rjt); } .tag.Media { background: var(--ama); color: var(--amt); } .tag.Baja { background: #f1f1f4; color: var(--tx2); }
    .inicio { max-width: 620px; margin: 40px auto; }
    .recientes a { display: block; padding: 10px 0; border-top: 1px solid #f1f1f4; color: var(--vt); text-decoration: none; font-weight: 600; }
    .recientes a span { color: var(--tx3); font-weight: 400; font-size: .8125rem; margin-left: 6px; }
    .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%) translateY(20px); background: #2b2840; color: #fff; padding: 11px 16px; border-radius: 10px; font-size: .875rem; opacity: 0; transition: .25s; pointer-events: none; z-index: 50; max-width: calc(100% - 32px); }
    .toast.on { opacity: 1; transform: translateX(-50%) translateY(0); }
    .oculto { display: none !important; }
    @media (max-width: 900px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .hall-cab { display: none; }
      .hall { grid-template-columns: 1fr 1fr; }
      .hall .ancho { grid-column: 1 / -1; }
      .hall .lbl { display: block; font-size: .6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--tx3); margin-bottom: 3px; }
      .hall .x { width: auto; grid-column: 1 / -1; }
    }
    @media (max-width: 560px) {
      .pt { grid-template-columns: 1fr; }
      .seg { width: 100%; } .seg button { flex: 1; min-width: 0; }
    }
    @media print {
      .no-print, .barra, .nav, .sug, .acciones, .hall .x { display: none !important; }
      body { background: #fff; font-size: 12px; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .sec.cerrada .cuerpo { display: block; }
      .card { break-inside: avoid-page; }
      .wrap { padding-bottom: 0; }
    }
  </style>
</head>
<body>
  <div class="cinta"></div>

  <!-- Pantalla de inicio: sin ?s en la liga -->
  <div id="inicio" class="wrap oculto">
    <div class="inicio">
      <div class="firma"><span class="marca">Sacscloud</span> · Checklist de entrega</div>
      <h1>Suite de Consignación · Dashboard y reportes</h1>
      <p class="sub">Revisión con el cliente del dashboard general y de los reportes especiales de consignación: qué se valida y qué campo, dato o filtro les falta.</p>
      <div class="card ancla">
        <h2>Nueva sesión</h2>
        <p class="sub" style="margin-top:4px">Se crea una liga propia para este cliente. Lo que se capture se guarda solo y se puede abrir en cualquier dispositivo con la misma liga.</p>
        <div class="grid" style="margin-top:12px">
          <label class="f">Cliente<input type="text" id="nuevoCliente" placeholder="Nombre comercial" autocomplete="off" /></label>
        </div>
        <div class="acciones"><button class="btn pri" id="btnNueva">Crear sesión</button></div>
      </div>
      <div class="card">
        <h2>Abrir una sesión</h2>
        <div class="grid" style="margin-top:12px">
          <label class="f">Liga o código<input type="text" id="abrirCodigo" placeholder="Pega la liga de la sesión" autocomplete="off" /></label>
        </div>
        <div class="acciones"><button class="btn" id="btnAbrir">Abrir</button></div>
        <div id="recientes" class="recientes" style="margin-top:8px"></div>
      </div>
    </div>
  </div>

  <!-- La sesión -->
  <div id="app" class="oculto">
    <div class="barra no-print">
      <div class="in">
        <span class="estado" id="estado"><span class="punto"></span><span id="estadoTxt">Cargando…</span></span>
        <button class="btn peq" id="btnLiga">Copiar liga</button>
        <button class="btn peq" id="btnCsv">Exportar a Excel</button>
        <button class="btn peq ter" id="btnPdf">Imprimir / PDF</button>
      </div>
      <nav class="nav" id="nav"></nav>
    </div>

    <div class="wrap">
      <div class="firma"><span class="marca">Sacscloud</span> · Checklist de entrega</div>
      <h1>Suite de Consignación · Dashboard y reportes</h1>
      <p class="sub">Se recorre cada pantalla con el cliente. En cada punto se marca <b>Correcto</b>, <b>Falla</b> o <b>No aplica</b>; lo que le falte a la pantalla (un campo, un dato, un filtro, un total) se anota en su tabla. Todo se guarda solo.</p>

      <div class="card ancla" id="secMeta">
        <h2>Datos de la sesión</h2>
        <div class="grid" style="margin-top:12px">
          <label class="f">Cliente<input type="text" data-meta="cliente" /></label>
          <label class="f">Cuenta Sacscloud<input type="text" data-meta="cuenta" /></label>
          <label class="f">Fecha<input type="date" data-meta="fecha" /></label>
          <label class="f">Consultor<input type="text" data-meta="consultor" /></label>
          <label class="f">Responsable del cliente<input type="text" data-meta="responsable" /></label>
          <label class="f">Ambiente<select data-meta="ambiente"><option value="">—</option><option>Producción</option><option>Pruebas</option></select></label>
        </div>
      </div>

      <div class="kpis" id="kpis"></div>

      <div id="secciones"></div>

      <div class="card no-print" style="text-align:center">
        <p class="sub" style="margin-bottom:8px">¿El cliente usa una pantalla o reporte que no está en la lista?</p>
        <button class="btn" id="btnOtra">Agregar pantalla o reporte</button>
      </div>

      <div class="card" id="cierre">
        <h2>Resumen y cierre</h2>
        <p class="sub" style="margin-top:4px">Todo lo que se anotó como faltante, de mayor a menor prioridad.</p>
        <div id="resumen"></div>
        <h3>Acuerdos de la sesión</h3>
        <textarea data-cierre="acuerdos" placeholder="Lo que quedó decidido y los siguientes pasos"></textarea>
        <div class="grid" style="margin-top:12px">
          <label class="f">Valida por el cliente (nombre)<input type="text" data-cierre="firmaCliente" /></label>
          <label class="f">Valida por Sacscloud (nombre)<input type="text" data-cierre="firmaSacs" /></label>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script is:inline>
  // ── CONTENIDO BASE ─────────────────────────────────────────────────────
  // Cada sección = una pantalla del sistema. `puntos` = lo que se valida con
  // el cliente; `hoy` = lo que la pantalla ya muestra (campos y filtros);
  // `sugerencias` = faltantes a proponer, que el consultor pasa a la tabla
  // solo si el cliente los quiere.
  const GUIA = {
    secciones: [
      {
        id: 'dashboard',
        nombre: 'Dashboard de consignación',
        donde: 'Consignación › Dashboard',
        para: 'La foto del negocio de consignación: alertas del día, cuánto hay en inventario, cuánto se ha vendido y cuánto se debe a los consignatarios.',
        hoy: ['Franja de alertas', 'Consignatarios activos', 'Valor de inventario', 'Vendido', 'Comisión del negocio', 'Por pagar a consignatarios', 'Saldo a favor', 'Contratos por vencer (30 d)', 'Incidentes abiertos', 'Productos por estado', 'Cargos por servicios', 'Top consignatarios por ventas', 'Antigüedad del inventario', 'Rendimiento por consignatario'],
        filtros: ['Sin filtros'],
        puntos: [
          'Abre sin errores y en un tiempo aceptable con el volumen real del cliente.',
          'Las alertas que aparecen son las que el cliente quiere ver; las que no le sirven se pueden apagar en Configuración.',
          '«Consignatarios activos» coincide con el conteo del cliente.',
          '«Valor de inventario» cuadra con la suma de precios de las piezas disponibles (el cliente entiende que es a precio de venta).',
          '«Vendido» y «Comisión del negocio» se entienden como cifras de todo el histórico (no del mes).',
          '«Por pagar a consignatarios» coincide con la suma de liquidaciones pendientes del perfil de cada consignatario.',
          '«Saldo a favor» coincide con el saldo de los consignatarios.',
          '«Contratos por vencer» coincide con los contratos que vencen en 30 días.',
          'Los rangos de antigüedad (0–30, 31–60, 61–90, más de 90 días) le sirven al cliente para decidir rebajas o devoluciones.',
          '«Rendimiento por consignatario» muestra a todos los consignatarios que el cliente espera ver.',
          'Las cifras se entienden sin explicación: el cliente sabe qué significa cada tarjeta.'
        ],
        sugerencias: [
          { tipo: 'Filtro', texto: 'Rango de fechas (hoy, semana, mes, año) para Vendido y Comisión del negocio.' },
          { tipo: 'Filtro', texto: 'Filtro por sucursal.' },
          { tipo: 'Filtro', texto: 'Filtro por consignatario y por vendedor.' },
          { tipo: 'Dato / cálculo', texto: 'Valor de inventario neto (lo que se pagaría al consignatario) y comisión potencial, además del precio de venta.' },
          { tipo: 'Gráfica / indicador', texto: 'Tarjeta «Pagado a consignatarios» en el periodo.' },
          { tipo: 'Otro', texto: 'Tocar una alerta o una fila para ir al detalle (lista de piezas, contratos o liquidaciones).' },
          { tipo: 'Exportación', texto: 'Exportar el dashboard a Excel o PDF.' },
          { tipo: 'Dato / cálculo', texto: 'Que los rangos de antigüedad se ajusten a los días de «estancado» que configura el cliente.' },
          { tipo: 'Gráfica / indicador', texto: 'Tendencia mensual de ventas y comisión.' }
        ]
      },
      {
        id: 'inicio',
        nombre: 'Dashboard de inicio · pestaña Consignación',
        donde: 'Inicio › Dashboard › pestaña Consignación',
        para: 'El resumen de consignación dentro del dashboard general, con periodo y sucursal.',
        hoy: ['Utilidad neta', 'Por liquidar', 'Ya liquidado', 'Por consignatario', 'Por sucursal', 'Cargos'],
        filtros: ['Periodo', 'Sucursal'],
        puntos: [
          'La pestaña Consignación aparece y carga con la suite activa.',
          'Al cambiar el periodo, todas las cifras cambian de acuerdo con él.',
          'Al cambiar la sucursal, las cifras corresponden solo a esa sucursal.',
          'Las cifras coinciden con las del Dashboard de consignación para el mismo periodo.',
          'La tabla por consignatario muestra comisión y monto liquidado reales (no en cero).',
          'La tabla por sucursal muestra valor consignado, productos activos y liquidaciones reales.',
          '«Por liquidar» y «Ya liquidado» respetan el periodo elegido.',
          'Contratos vencidos, devoluciones pendientes y piezas liberadas muestran cifras reales.'
        ],
        sugerencias: [
          { tipo: 'Gráfica / indicador', texto: 'Tendencia del valor de inventario consignado.' },
          { tipo: 'Filtro', texto: 'Filtro por consignatario.' },
          { tipo: 'Otro', texto: 'Tocar una cifra para ir al reporte de detalle.' }
        ]
      },
      {
        id: 'venta',
        nombre: 'Reporte · Venta por consignación',
        donde: 'Consignación › Reportes (también Reportes › Ventas › Venta por consignación)',
        para: 'Una fila por pieza vendida: cuánto se vendió, cuánto le toca al consignatario, la comisión y el estado de su pago.',
