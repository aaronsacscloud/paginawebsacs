---
// Baja para los correos VIEJOS, que traían un link sin token.
//
// Solo se puede confirmar a mano (POST). Un GET jamás da de baja: los
// escáneres corporativos abren todos los links de un correo y darían de baja
// a media cartera sin que nadie lo pidiera.
import { darDeBaja } from '../../../lib/email/bajas';
import { tenantDeCasa } from '../../../lib/email/tenant';

export const prerender = false;

const email = String(Astro.url.searchParams.get('e') || '').trim().toLowerCase();
let hecho = false;
if (Astro.request.method === 'POST' && email) {
  const form = await Astro.request.formData();
  const confirmado = String(form.get('email') || '').trim().toLowerCase();
  // Se exige que reescriba (o confirme) su correo: sin token, es lo único que
  // demuestra que quien pide la baja es quien la recibe.
  if (confirmado === email) {
    const t = await tenantDeCasa();
    if (t) { await darDeBaja({ tenantId: t.id, email, origen: 'link-legacy' }); hecho = true; }
  }
}
---
<html lang="es"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Cancelar suscripción</title>
<style>
  :root{color-scheme:light dark}
  body{margin:0;min-height:100vh;display:grid;place-items:center;background:#F7F6FA;color:#221E33;
       font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;padding:24px}
  .c{background:#fff;border:1px solid #E7E3F0;border-radius:16px;padding:32px;max-width:460px;width:100%;
     box-shadow:0 8px 30px rgba(34,30,51,.07);text-align:center}
  h1{font-size:1.25rem;margin:0 0 8px}
  p{color:#6F6982;line-height:1.6;font-size:.92rem}
  input{border:1.5px solid #E7E3F0;border-radius:10px;padding:11px 13px;width:100%;box-sizing:border-box;
        font-size:.92rem;font-family:inherit;margin:10px 0}
  button{border:none;border-radius:10px;padding:12px 22px;background:#5B4BD6;color:#fff;font-size:.92rem;
         font-weight:700;cursor:pointer;font-family:inherit;width:100%}
  button:focus-visible{outline:3px solid #C3B8FA;outline-offset:2px}
  .ok{background:#EAF8F2;color:#1E8A63;border-radius:10px;padding:12px;font-weight:600;font-size:.9rem}
  @media (prefers-color-scheme:dark){
    body{background:#16131F;color:#ECE9F6}.c{background:#201C2E;border-color:#322D45}
    p{color:#9B94AD}input{background:#282237;color:#ECE9F6;border-color:#322D45}.ok{background:#1D2E28;color:#4CC79A}
  }
</style></head>
<body><div class="c">
{hecho ? (
  <><h1>Listo, te diste de baja</h1><div class="ok">No volverás a recibir correos de marketing.</div></>
) : (
  <>
    <h1>¿Cancelar tu suscripción?</h1>
    <p>Este enlace viene de un correo antiguo. Confirma tu dirección para procesarlo.</p>
    <form method="POST">
      <input type="email" name="email" value={email} placeholder="tu@correo.com" required />
      <button type="submit">Cancelar suscripción</button>
    </form>
  </>
)}
</div></body></html>
