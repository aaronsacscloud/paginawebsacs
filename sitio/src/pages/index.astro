---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FinalCTA from '../components/FinalCTA.astro';
import CtaDudas from '../components/CtaDudas.astro';
import Operador from '../components/home/Operador.astro';
import PatternIA from '../components/home/PatternIA.astro';
import FlujoIA from '../components/home/FlujoIA.astro';
import { modaSectors, modelosNegocio } from '../data/navigation';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SACS',
  url: 'https://sacs.com.mx',
  description: 'El sistema para marcas y tiendas de moda en México.',
};

// Los tres casos de moda que se enseñan en el home. Los datos completos viven
// en /casos-de-exito; aquí solo la tarjeta.
const casosHome = [
  {
    slug: 'liveshow',
    brand: 'Liveshow Merchandising',
    tagline: 'Shakira, Metallica, Karol G y Lady Gaga confían en SACS.',
    dato: '100+ puntos de venta simultáneos',
    image: '/images/case-shakira-merch.webp',
  },
  {
    slug: 'la-bella-pandita',
    brand: 'La Bella Pandita',
    tagline: 'De 1 tienda en Querétaro a 42 sucursales en todo México.',
    dato: '42 sucursales sincronizadas',
    image: '/images/case-bella-pandita.webp',
  },
  {
    slug: 'sandmade',
    brand: 'Sandmade Swimwear',
    tagline: 'Swimwear premium conectado de Tulum a Los Cabos.',
    dato: '8 boutiques turísticas',
    image: '/images/case-sandmade.webp',
  },
];
---

<BaseLayout
  title="Sacs — El sistema para marcas y tiendas de moda"
  description="Tallas, colores, temporadas y sucursales bajo control. Punto de venta, ecommerce y TikTok Shop sobre un solo inventario, con IA que lo mueve por ti."
  structuredData={websiteSchema}
>
  <Hero
    eyebrow="Software para el retail de moda"
    title="El sistema para marcas y tiendas de moda"
    subtitle="Tallas, colores, temporadas y sucursales bajo control. Punto de venta, tienda en línea, WhatsApp y TikTok Shop sobre un solo inventario — y una inteligencia que lo mueve por ti."
    primaryCTA={{ label: 'Prueba 7 dias gratis', href: '/prueba-gratis' }}
    secondaryCTA={{ label: 'Agenda una demo', href: '/contacto' }}
  >
    <Fragment slot="insignia">
      <PatternIA />
      <FlujoIA />
    </Fragment>
    <Operador slot="operador" />
  </Hero>

  <!-- ═══ ¿Cómo opera tu negocio? — el selector de camino ═══ -->
  <section class="modelos-section">
    <div class="modelos-container">
      <div class="modelos-header">
        <span class="modelos-eyebrow">Para tu operación</span>
        <h2 class="modelos-title">¿Cómo opera tu negocio?</h2>
        <p class="modelos-sub">El mismo sistema, contado para tu tamaño de operación.</p>
      </div>
      <div class="modelos-grid">
        {modelosNegocio.map((m) => (
          <a href={m.href} class="modelo-card">
            <h3 class="modelo-card-title">{m.label}</h3>
            <p class="modelo-card-desc">{m.description}</p>
            <span class="modelo-card-link">Ver cómo funciona <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Giros de moda ═══ -->
  <section class="girosmoda-section">
    <div class="modelos-container">
      <div class="modelos-header">
        <span class="modelos-eyebrow">Hecho a la medida de tu giro</span>
        <h2 class="modelos-title">Tu giro ya viene configurado</h2>
        <p class="modelos-sub">Ropa, calzado y joyería con sus propias personalizaciones desde el primer día.</p>
      </div>
      <div class="girosmoda-grid">
        {modaSectors.map((g) => (
          <a href={g.href} class="giromoda-card" style={`--gm-color:${g.color};`}>
            {g.image && <div class="giromoda-media"><img src={g.image} alt={g.label} width="600" height="400" loading="lazy" /></div>}
            <div class="giromoda-body">
              <h3 class="giromoda-title">{g.label}</h3>
              <p class="giromoda-desc">{g.description}</p>
              <span class="modelo-card-link">Ver personalizaciones <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </div>
          </a>
        ))}
      </div>
      <p class="girosmoda-otros">¿Vendes otra cosa? <a href="/giros">Sacs también opera otros comercios →</a></p>
    </div>
  </section>

  <!-- ═══ Casos de éxito de moda ═══ -->
  <section class="casoshome-section">
    <div class="modelos-container">
      <div class="modelos-header">
        <span class="modelos-eyebrow">Casos de éxito</span>
        <h2 class="modelos-title">Marcas de moda que ya operan con Sacs</h2>
      </div>
      <div class="casoshome-grid">
        {casosHome.map((c) => (
          <a href={`/casos-de-exito/${c.slug}`} class="casohome-card">
            <div class="casohome-media"><img src={c.image} alt={`${c.brand} — caso de éxito`} width="600" height="500" loading="lazy" /></div>
            <div class="casohome-body">
              <h3 class="casohome-brand">{c.brand}</h3>
              <p class="casohome-tagline">{c.tagline}</p>
              <span class="casohome-dato">{c.dato}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="girosmoda-otros"><a href="/casos-de-exito">Ver todos los casos →</a></p>
    </div>
  </section>

  <!-- ═══ CTA: ¿Aún tienes dudas? — ahora vive en su componente, porque las
       páginas de giro cierran con el mismo gesto ═══ -->
  <CtaDudas />

  <!-- ═══ Blog Section ═══ -->
  <section class="blog-home-section">
    <div class="blog-home-container">
      <div class="blog-home-header">
        <span class="blog-home-eyebrow">Blog</span>
        <h2 class="blog-home-title">Ideas para el retail de moda</h2>
        <p class="blog-home-subtitle">Tendencias, innovación y casos reales del fashion retail en México.</p>
      </div>
      <div class="blog-home-grid">
        <a href="/blog/bershka" class="blog-home-card blog-home-card--featured">
          <div class="blog-home-card-img-wrap">
            <img src="/images/blog-bershka-hero.webp" alt="Bershka — innovación retail" width="720" height="400" loading="lazy" class="blog-home-card-img" />
          </div>
          <div class="blog-home-card-body">
            <div class="blog-home-card-tags">
              <span class="blog-home-tag">Retail</span>
              <span class="blog-home-tag">Innovación</span>
            </div>
            <h3 class="blog-home-card-title">Cómo Bershka redefine la experiencia de compra en México</h3>
            <p class="blog-home-card-desc">Tecnología avanzada, diseño sostenible y estrategia omnicanal en su nueva tienda insignia.</p>
          </div>
        </a>
        <a href="/blog/machina" class="blog-home-card">
          <div class="blog-home-card-img-wrap">
            <img src="/images/blog-machina-hero.webp" alt="Machina — moda y tecnología" width="720" height="400" loading="lazy" class="blog-home-card-img" />
          </div>
          <div class="blog-home-card-body">
            <div class="blog-home-card-tags">
              <span class="blog-home-tag">Moda</span>
              <span class="blog-home-tag">Tecnología</span>
            </div>
            <h3 class="blog-home-card-title">Machina: la revolución mexicana que fusiona moda y tecnología</h3>
            <p class="blog-home-card-desc">Wearables inteligentes, la colaboración con Nike y el futuro del fashion retail.</p>
          </div>
        </a>
        <a href="/blog/bienvenida" class="blog-home-card">
          <div class="blog-home-card-body blog-home-card-body--no-img">
            <div class="blog-home-card-tags">
              <span class="blog-home-tag">Anuncios</span>
              <span class="blog-home-tag">SACS</span>
            </div>
            <h3 class="blog-home-card-title">Bienvenidos a SACS: comercio consciente desde el día uno</h3>
            <p class="blog-home-card-desc">Lanzamos SACS con una misión clara: que cada retailer en México tenga acceso a tecnología de clase mundial.</p>
            <span class="blog-home-card-link">Leer artículo <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>
      </div>
      <div class="blog-home-footer">
        <a href="/blog" class="blog-home-all-link">Ver todos los artículos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>

  <style>
    .blog-home-section {
      padding: clamp(80px, 10vw, 140px) 0;
      background: #fff;
    }

    .blog-home-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 clamp(20px, 4vw, 48px);
    }

    .blog-home-header {
      text-align: center;
      margin-bottom: 48px;
    }

    .blog-home-eyebrow {
      font-family: var(--font-body);
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-primary);
      display: block;
      margin-bottom: 12px;
    }

    .blog-home-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      color: var(--color-text-primary);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 12px;
    }

    .blog-home-subtitle {
      font-family: var(--font-body);
      font-size: clamp(1rem, 1.5vw, 1.125rem);
      color: var(--color-text-secondary);
      margin: 0;
    }

    .blog-home-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 16px;
    }

    .blog-home-card {
      text-decoration: none;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: var(--color-bg-primary);
      display: flex;
      flex-direction: column;
      transition: transform var(--duration-fast) var(--ease-default),
                  box-shadow var(--duration-fast) var(--ease-default);
    }

    .blog-home-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-xl);
      text-decoration: none;
    }

    .blog-home-card--featured {
      grid-row: span 2;
    }

    .blog-home-card-img-wrap {
      overflow: hidden;
    }

    .blog-home-card--featured .blog-home-card-img-wrap {
      height: 100%;
      min-height: 280px;
    }

    .blog-home-card:not(.blog-home-card--featured) .blog-home-card-img-wrap {
      height: 180px;
    }

    .blog-home-card--featured {
      display: grid;
      grid-template-rows: 1fr auto;
    }

    .blog-home-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s var(--ease-default);
    }

    .blog-home-card:hover .blog-home-card-img {
      transform: scale(1.04);
    }

    .blog-home-card-body {
      padding: 24px;
    }

    .blog-home-card-body--no-img {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
      padding: 32px 28px;
    }

    .blog-home-card-tags {
      display: flex;
      gap: 6px;
      margin-bottom: 12px;
    }

    .blog-home-tag {
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-primary);
      background: rgba(75, 123, 229, 0.08);
      padding: 4px 10px;
      border-radius: 4px;
    }

    .blog-home-card-title {
      font-family: var(--font-display);
      font-size: clamp(1.125rem, 2vw, 1.375rem);
      font-weight: 800;
      color: var(--color-text-primary);
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin: 0 0 8px;
    }

    .blog-home-card--featured .blog-home-card-title {
      font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    }

    .blog-home-card-desc {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    .blog-home-card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 700;
      color: var(--color-primary);
      margin-top: 16px;
      transition: gap 0.2s ease;
    }

    .blog-home-card:hover .blog-home-card-link {
      gap: 10px;
    }

    .blog-home-footer {
      text-align: center;
      margin-top: 40px;
    }

    .blog-home-all-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 700;
      color: var(--color-primary);
      text-decoration: none;
      padding: 12px 28px;
      border: 1.5px solid var(--color-primary);
      border-radius: 100px;
      transition: background 0.2s ease, color 0.2s ease, gap 0.2s ease;
    }

    .blog-home-all-link:hover {
      background: var(--color-primary);
      color: #fff;
      text-decoration: none;
      gap: 12px;
    }

    @media (max-width: 767px) {
      .blog-home-grid {
        grid-template-columns: 1fr;
      }

      .blog-home-card--featured {
        grid-row: span 1;
      }

      .blog-home-card--featured .blog-home-card-img-wrap {
        height: 200px;
        min-height: 0;
      }

      .blog-home-card--featured {
        display: flex;
      }
    }
  
    /* ─── Selector de camino + giros de moda + casos (home moda) ─── */
    .modelos-section { padding: clamp(64px, 8vw, 110px) 0; background: var(--color-bg-primary); }
    .girosmoda-section { padding: clamp(64px, 8vw, 110px) 0; background: #fff; }
    .casoshome-section { padding: clamp(64px, 8vw, 110px) 0; background: var(--color-bg-primary); }
    .modelos-container { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
    .modelos-header { text-align: center; margin-bottom: 44px; }
    .modelos-eyebrow {
      font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-primary);
      display: block; margin-bottom: 12px;
    }
    .modelos-title { font-family: var(--font-display); font-size: clamp(1.75rem, 3.4vw, 2.5rem); font-weight: 700; color: var(--color-text-primary); }
    .modelos-sub { margin-top: 10px; font-size: 1.0625rem; color: var(--color-text-secondary); }
    .modelos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .modelo-card {
      display: flex; flex-direction: column; gap: 10px;
      background: var(--color-bg-card); border: 1px solid var(--color-border-light);
      border-radius: 16px; padding: 28px 26px; text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .modelo-card:hover { transform: translateY(-3px); border-color: var(--color-primary); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
    .modelo-card-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); }
    .modelo-card-desc { font-size: 0.9375rem; line-height: 1.55; color: var(--color-text-secondary); flex: 1; }
    .modelo-card-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.875rem; font-weight: 600; color: var(--color-primary); }
    .girosmoda-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .giromoda-card {
      display: flex; flex-direction: column; background: var(--color-bg-card);
      border: 1px solid var(--color-border-light); border-radius: 16px; overflow: hidden;
      text-decoration: none; transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .giromoda-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
    .giromoda-media { aspect-ratio: 3 / 2; overflow: hidden; }
    .giromoda-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .giromoda-body { display: flex; flex-direction: column; gap: 8px; padding: 22px 24px 24px; }
    .giromoda-title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); }
    .giromoda-desc { font-size: 0.9375rem; color: var(--color-text-secondary); flex: 1; }
    .girosmoda-otros { text-align: center; margin-top: 32px; font-size: 0.9375rem; color: var(--color-text-secondary); }
    .girosmoda-otros a { color: var(--color-primary); font-weight: 600; text-decoration: none; }
    .casoshome-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .casohome-card {
      display: flex; flex-direction: column; background: var(--color-bg-card);
      border: 1px solid var(--color-border-light); border-radius: 16px; overflow: hidden;
      text-decoration: none; transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .casohome-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
    .casohome-media { aspect-ratio: 6 / 5; overflow: hidden; }
    .casohome-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .casohome-body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px; }
    .casohome-brand { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); }
    .casohome-tagline { font-size: 0.9rem; line-height: 1.5; color: var(--color-text-secondary); flex: 1; }
    .casohome-dato { font-size: 0.8125rem; font-weight: 700; color: var(--color-primary); }
    @media (max-width: 900px) {
      .modelos-grid, .girosmoda-grid, .casoshome-grid { grid-template-columns: 1fr; }
    }
</style>

  <FAQAccordion locale="es" />
  <FinalCTA locale="es" />

  <script>
    try {
      if (typeof ttq !== 'undefined') {
        ttq.track('ViewContent', { content_id: 'homepage', content_name: 'homepage', content_type: 'product' });
      }
    } catch {}
  </script>
</BaseLayout>
