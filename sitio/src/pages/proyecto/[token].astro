---
// Brief de proyecto por etapas. El cliente entra con un link — sin cuenta, sin
// contraseña — firma la portada y a partir de ahí contesta una etapa a la vez.
// Sacs aprueba cada etapa y esa aprobación abre la siguiente.
//
// La portada se pinta en el servidor (es un documento y tiene que verse
// completa aunque el JS tarde). Las etapas se pintan en el navegador desde
// /api/proyecto/estado, que es la única fuente de verdad de su estado.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { briefPorToken, etapasDe } from '../../lib/proyecto/store';
import { getSessionFromRequest } from '../../lib/auth/session';
import Joyas from '../../components/proyecto/Joyas.astro';
import JoyasBanda from '../../components/proyecto/JoyasBanda.astro';

export const prerender = false;

const { token } = Astro.params;
const brief = await briefPorToken(token || '');
if (!brief) return Astro.redirect('/404');
await etapasDe(brief.id);

// Si quien abre el link es alguien de Sacs con sesión, la misma página le
// muestra los controles de revisión. Un solo documento para los dos lados:
// el cliente ve lo suyo, nosotros vemos además el botón de aprobar.
const sesion = await getSessionFromRequest(Astro.request);
const esSacs = !!sesion && (sesion.role === 'founder' || sesion.role === 'cs');

const r: any = brief.resumen || {};
const firmado = !!brief.firmado_at;
const fechaFirma = brief.firmado_at
  ? new Date(brief.firmado_at).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---

<BaseLayout
  title={`Brief de proyecto · ${brief.cliente}`}
  description={`Documento de trabajo del proyecto ${brief.proyecto}`}
  bareLayout={true}
>
  <Joyas />
  <div class="pb" data-token={brief.token} data-firmado={firmado ? '1' : ''} data-sacs={esSacs ? '1' : ''}>

    <!-- ─────────────────────────── Encabezado ─────────────────────────── -->
    <header class="pb-top">
      <div class="pb-top-in">
        <div class="pb-marca">
          <img src="/images/sacs-wordmark.png" alt="Sacs" width="74" />
          <span class="pb-top-sep"></span>
          <span class="pb-top-cli">{brief.cliente}</span>
        </div>
        <button type="button" class="pb-top-est" id="pb-avance">Documento de trabajo</button>
      </div>
      {esSacs && (
        <div class="pb-modo-sacs">
          Estás viendo este brief como <b>Sacs</b>. Puedes aprobar o devolver
          cada etapa; el cliente no ve estos controles.
        </div>
      )}
    </header>

    <main class="pb-hoja">

      <!-- Lo que le toca, antes que nada. Solo aparece con el brief firmado:
           en la segunda visita y en la tercera, esto es lo único que importa. -->
      {firmado && <div id="pb-puerta" class="pb-puerta" hidden></div>}

      <!-- ── Portada ── -->
      <section class="pb-portada">
        <div class="pb-eyebrow">Brief de proyecto</div>
        <h1>{brief.proyecto}</h1>
        {r.entrada && <p class="pb-lede" set:html={r.entrada}></p>}

        <dl class="pb-meta">
          <div><dt>Cliente</dt><dd>{brief.cliente}</dd></div>
          {brief.contacto && <div><dt>Contacto</dt><dd>{brief.contacto}</dd></div>}
          {r.plazo && <div><dt>Plazo</dt><dd>{r.plazo}</dd></div>}
        </dl>
      </section>

      <!-- ── Qué vamos a construir (contexto, sin nada comercial: los montos
           y las formas de pago viven en la propuesta, no en el brief) ── -->
      {r.alcance?.length && (
        <section class="pb-sec pb-sec-plegable" data-plegada={firmado ? '1' : null}>
          <div class="pb-sec-h" role={firmado ? 'button' : null} tabindex={firmado ? '0' : null}>
            <span class="pb-num">01</span>
            <h2>Lo que vamos a construir</h2>
            {firmado && <span class="pb-plegar" aria-hidden="true"></span>}
          </div>
          <ul class="pb-lista">
            {r.alcance.map((a: string) => <li>{a}</li>)}
          </ul>
        </section>
      )}

      <!-- ── Responsabilidades ── -->
      {(r.hace_sacs?.length || r.hace_cliente?.length) && (
        <section class="pb-sec pb-sec-plegable" data-plegada={firmado ? '1' : null}>
          <div class="pb-sec-h" role={firmado ? 'button' : null} tabindex={firmado ? '0' : null}>
            <span class="pb-num">02</span>
            <h2>Quién hace qué</h2>
            {firmado && <span class="pb-plegar" aria-hidden="true"></span>}
          </div>
          <div class="pb-dos">
            {r.hace_sacs?.length && (
              <div class="pb-col">
                <h3>Sacs</h3>
                <ul class="pb-lista pb-lista-sm">{r.hace_sacs.map((x: string) => <li>{x}</li>)}</ul>
              </div>
            )}
            {r.hace_cliente?.length && (
              <div class="pb-col pb-col-oro">
                <h3>{brief.cliente}</h3>
                <ul class="pb-lista pb-lista-sm">{r.hace_cliente.map((x: string) => <li>{x}</li>)}</ul>
              </div>
            )}
          </div>
          {r.nota_tiempo && <p class="pb-aviso">{r.nota_tiempo}</p>}
        </section>
      )}

      <!-- ── Cómo trabajamos ── -->
      <section class="pb-sec pb-sec-plegable" data-plegada={firmado ? '1' : null}>
        <div class="pb-sec-h" role={firmado ? 'button' : null} tabindex={firmado ? '0' : null}>
          <span class="pb-num">03</span>
          <h2>Cómo se llena este brief</h2>
          {firmado && <span class="pb-plegar" aria-hidden="true"></span>}
        </div>
        <p class="pb-parr">
          El brief va por etapas. Se abre una a la vez: ustedes la contestan,
          la envían, Sacs la revisa y —cuando queda completa— la aprueba. Esa
          aprobación abre la siguiente. Nada se pierde: lo que escriban se
          guarda solo conforme lo escriben, y pueden volver otro día con el
          mismo link.
        </p>
        <p class="pb-parr">
          Se hace así por una razón práctica: si las cinco etapas se abren
          juntas, se contestan a medias y el proyecto arranca sobre supuestos.
          Una etapa aprobada es una decisión cerrada que ya no se rediscute.
        </p>
      </section>

      <!-- ── Firma ── -->
      <section class="pb-firma-sec pb-sec-plegable" id="firma" data-plegada={firmado ? '1' : null}>
        <div class="pb-sec-h" role={firmado ? 'button' : null} tabindex={firmado ? '0' : null}>
          <span class="pb-num">04</span>
          <h2>Firma de conformidad</h2>
          {firmado && <span class="pb-plegar" aria-hidden="true"></span>}
        </div>

        {firmado ? (
          <div class="pb-firmado">
            <div class="pb-firmado-check">✓</div>
            <div>
              <div class="pb-firmado-t">Brief firmado</div>
              <div class="pb-firmado-d">
                {brief.firmado_por}{brief.firmado_puesto ? ` · ${brief.firmado_puesto}` : ''} · {fechaFirma}
              </div>
            </div>
            {brief.firma_png && <img class="pb-firmado-img" src={brief.firma_png} alt="Firma" />}
          </div>
        ) : (
          <div class="pb-firma-caja">
            <p class="pb-parr">
              Firmar aquí abre el brief y deja asentado quién responde por él
              del lado de {brief.cliente}. No es un documento comercial: los
              montos y las formas de pago viven en la propuesta.
            </p>
            <div class="pb-campos">
              <label>
                <span>Nombre completo</span>
                <input type="text" id="f-nombre" value={brief.contacto || ''} autocomplete="name" />
              </label>
              <label>
                <span>Puesto</span>
                <input type="text" id="f-puesto" placeholder="Ej. Director general" />
              </label>
              <label>
                <span>Correo</span>
                <input type="email" id="f-email" value={brief.email || ''} autocomplete="email" />
              </label>
            </div>
            <label class="pb-avisos">
              <span class="pb-campo-t">CORREOS PARA AVISOS</span>
              <input type="text" id="f-avisos" value={brief.email || ''}
                placeholder="correo@ejemplo.com, otro@ejemplo.com" />
              <small>
                Cada vez que revisemos una etapa les llega ahí el aviso, con las
                preguntas que hayan quedado. Pueden poner varios, separados por comas.
              </small>
            </label>
            <span class="pb-campo-t">TU FIRMA</span>
            <div class="pb-firma-lienzo-w">
              <span class="pb-firma-hint">Firma con el dedo o el mouse</span>
              <!-- "Borrar" va SOBRE el lienzo y visible desde antes de trazar:
                   nadie firma bien a la primera con el dedo, y si no ve cómo
                   repetir, o firma fea o cierra la página. -->
              <button type="button" class="pb-firma-borrar" id="f-limpiar" hidden>Borrar</button>
              <canvas id="f-canvas" class="pb-firma-lienzo"></canvas>
              <div class="pb-firma-linea"></div>
            </div>
            <div class="pb-firma-acc">
              <button type="button" class="pb-btn" id="f-firmar" disabled>Firma para comenzar</button>
            </div>
            <div class="pb-error" id="f-error" hidden></div>
          </div>
        )}
      </section>

      <!-- ── Etapas ── -->
      <section class="pb-sec" id="etapas">
        <div class="pb-sec-h">
          <span class="pb-num">05</span>
          <h2>Las etapas</h2>
        </div>
        <div id="pb-etapas" class="pb-etapas">
          <div class="pb-cargando">Cargando…</div>
        </div>
      </section>

      <!-- ── Bitácora ── -->
      <section class="pb-sec pb-sec-log" id="bitacora" hidden>
        <div class="pb-sec-h">
          <span class="pb-num">06</span>
          <h2>Bitácora</h2>
        </div>
        <ol class="pb-log" id="pb-log"></ol>
      </section>

      <JoyasBanda />

      <footer class="pb-pie">
        <div>Sacscloud · Documento de trabajo del proyecto</div>
        <div class="pb-pie-sm">
          Este link es privado. Quien lo tenga puede leer y contestar el brief —
          no lo compartan fuera del equipo.
        </div>
        <div class="pb-pie-ayuda">
          <span>¿Se atoraron con algo? Nos escriben y lo resolvemos.</span>
          <a class="pb-btn-wa" href="https://wa.me/5215536634392" target="_blank" rel="noopener noreferrer">
            Escríbannos por WhatsApp
          </a>
        </div>
      </footer>
    </main>

    <div class="pb-guardado" id="pb-guardado" hidden>Guardado</div>
  </div>
</BaseLayout>

<style is:global>
.pb {
  --tinta: #14181D;
  --tinta-suave: #545C66;
  --tenue: #7C848D;
  --linea: #E6E9ED;
  --linea-fuerte: #D3D9E0;
  --papel: #FFFFFF;
  --papel-2: #FAFAF8;
  --oro: #A9854F;
  --oro-suave: #F7F1E5;
  --azul: #4B7BE5;
  --azul-suave: #EDF2FD;
  --verde: #1E8E62;
  --verde-suave: #E8F5EF;
  --ambar: #B57A12;
  --ambar-suave: #FBF2E0;
  --rojo: #C0442F;
  --rojo-suave: #FBEDEA;
  --serif: 'Iowan Old Style', Georgia, 'Times New Roman', serif;
  --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;

  background: var(--papel-2);
  color: var(--tinta);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.62;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
.pb *, .pb *::before, .pb *::after { box-sizing: border-box; }

/* ── Encabezado ── */
.pb-top {
  position: sticky; top: 0; z-index: 40;
  background: rgba(255,255,255,.88);
  backdrop-filter: saturate(160%) blur(12px);
  border-bottom: 1px solid var(--linea);
}
.pb-top-in {
  max-width: 900px; margin: 0 auto;
  padding: 13px clamp(20px, 5vw, 56px);
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}
.pb-marca { display: flex; align-items: center; gap: 12px; min-width: 0; }
.pb-marca img { display: block; height: 17px; width: auto; }
.pb-top-sep { width: 1px; height: 16px; background: var(--linea-fuerte); }
.pb-top-cli {
  font-family: var(--serif); font-size: .98rem; color: var(--tinta);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pb-top-est {
  font: inherit; font-family: var(--mono); font-size: .72rem; letter-spacing: .06em;
  color: var(--tinta-suave); white-space: nowrap; background: none;
  border: 1px solid var(--linea); border-radius: 20px; padding: 7px 13px;
  cursor: pointer; min-height: 34px;
}
.pb-top-est:hover { border-color: var(--linea-fuerte); color: var(--tinta); }
.pb-top-est[data-p]:not([data-p=""])::after {
  content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%;
  background: var(--ambar); margin-left: 8px; vertical-align: 1px;
}

/* ── Hoja ── */
.pb-hoja {
  max-width: 900px; margin: 0 auto;
  padding: clamp(36px, 6vw, 76px) clamp(20px, 5vw, 56px) 90px;
  background: var(--papel);
  border-left: 1px solid var(--linea);
  border-right: 1px solid var(--linea);
  min-height: calc(100vh - 52px);
}
@media (max-width: 940px) { .pb-hoja { border: 0; } }

.pb-eyebrow {
  font-family: var(--mono); font-size: .68rem; letter-spacing: .22em;
  text-transform: uppercase; color: var(--oro); font-weight: 600; margin-bottom: 16px;
}
.pb h1 {
  font-family: var(--serif); font-weight: 600;
  font-size: clamp(2rem, 5.4vw, 3rem); line-height: 1.06;
  letter-spacing: -.015em; margin: 0 0 .38em; text-wrap: balance;
}
.pb-lede { font-size: 1.1rem; color: var(--tinta-suave); max-width: 58ch; margin: 0; }

.pb-meta {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 20px 28px; margin: 34px 0 0;
  padding-top: 26px; border-top: 1px solid var(--linea);
}
.pb-meta div { margin: 0; }
.pb-meta dt {
  font-family: var(--mono); font-size: .66rem; letter-spacing: .14em;
  text-transform: uppercase; color: var(--tenue); margin-bottom: 5px;
}
.pb-meta dd { margin: 0; font-size: .96rem; color: var(--tinta); }

/* ── Secciones ── */
.pb-sec, .pb-firma-sec { margin: clamp(46px, 7vw, 72px) 0 0; }
.pb-sec-h { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; }
.pb-num {
  font-family: var(--mono); font-size: .72rem; color: var(--oro);
  font-weight: 600; letter-spacing: .06em;
}
.pb h2 {
  font-family: var(--serif); font-weight: 600; letter-spacing: -.01em;
  font-size: clamp(1.32rem, 3vw, 1.68rem); margin: 0;
}
.pb h3 {
  font-family: var(--sans); font-size: .74rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase; color: var(--tenue);
  margin: 0 0 12px;
}
.pb-parr { color: var(--tinta-suave); max-width: 64ch; margin: 0 0 .9em; }
.pb-parr:last-child { margin-bottom: 0; }

.pb-lista { list-style: none; padding: 0; margin: 0; }
.pb-lista li {
  position: relative; padding: 9px 0 9px 22px;
  border-bottom: 1px solid var(--linea); color: var(--tinta-suave);
}
.pb-lista li:last-child { border-bottom: 0; }
.pb-lista li::before {
  content: ''; position: absolute; left: 2px; top: 18px;
  width: 5px; height: 5px; border-radius: 50%; background: var(--oro);
}
.pb-lista-sm li { font-size: .93rem; padding-top: 7px; padding-bottom: 7px; }

.pb-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
@media (max-width: 700px) { .pb-dos { grid-template-columns: 1fr; gap: 20px; } }
.pb-col { padding: 20px 22px; border: 1px solid var(--linea); border-radius: 12px; background: var(--papel-2); }
.pb-col-oro { background: var(--oro-suave); border-color: #EADFC8; }
.pb-col-oro .pb-lista li { border-bottom-color: #EADFC8; }

.pb-aviso {
  margin: 20px 0 0; padding: 14px 18px; border-left: 3px solid var(--oro);
  background: var(--oro-suave); border-radius: 0 8px 8px 0;
  font-size: .92rem; color: #6C5423;
}

/* ── Firma ── */
.pb-firma-caja {
  border: 1px solid var(--linea); border-radius: 14px;
  padding: clamp(20px, 4vw, 30px); background: var(--papel-2);
}
.pb-campos { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin: 22px 0 22px; }
.pb-campos label { display: block; }
.pb-campos span, .pb-campo-t {
  display: block; font-family: var(--mono); font-size: .66rem;
  letter-spacing: .13em; text-transform: uppercase; color: var(--tenue); margin-bottom: 6px;
}
.pb input[type=text], .pb input[type=email], .pb input[type=url], .pb textarea {
  width: 100%; font: inherit; font-size: .95rem; color: var(--tinta);
  padding: 11px 13px; border: 1px solid var(--linea-fuerte); border-radius: 9px;
  background: var(--papel); transition: border-color .15s, box-shadow .15s;
}
.pb textarea { resize: vertical; min-height: 96px; line-height: 1.55; }
.pb input:focus, .pb textarea:focus {
  outline: none; border-color: var(--azul); box-shadow: 0 0 0 3px var(--azul-suave);
}
.pb input:disabled, .pb textarea:disabled { background: #F4F5F7; color: var(--tinta-suave); cursor: default; }

.pb-firma-lienzo-w { position: relative; }
.pb-firma-borrar {
  position: absolute; top: 9px; right: 10px; z-index: 2;
  font: inherit; font-size: .84rem; font-weight: 600; color: var(--tinta-suave);
  background: rgba(255,255,255,.92); border: 1px solid var(--linea-fuerte);
  border-radius: 8px; padding: 8px 14px; cursor: pointer; min-height: 40px;
}
.pb-firma-borrar:hover { color: var(--tinta); border-color: var(--tenue); }
.pb-firma-hint {
  position: absolute; top: 10px; left: 14px; font-size: .76rem; color: var(--tenue);
  pointer-events: none;
}
.pb-firma-lienzo {
  width: 100%; height: 160px; display: block; border: 1px solid var(--linea-fuerte);
  border-radius: 10px; background: var(--papel); touch-action: none; cursor: crosshair;
}
.pb-firma-linea {
  position: absolute; left: 40px; right: 40px; bottom: 38px;
  border-bottom: 1px dashed var(--linea-fuerte); pointer-events: none;
}
.pb-firma-acc { display: flex; gap: 10px; align-items: center; margin-top: 16px; flex-wrap: wrap; }

.pb-btn {
  font: inherit; font-size: .93rem; font-weight: 600; color: #fff;
  background: var(--tinta); border: 0; border-radius: 10px; padding: 12px 22px;
  cursor: pointer; transition: background .15s, transform .08s;
}
.pb-btn:hover { background: #000; }
.pb-btn:active { transform: translateY(1px); }
.pb-btn:disabled { background: var(--tenue); cursor: default; transform: none; }
.pb-btn-tenue {
  font: inherit; font-size: .88rem; color: var(--tinta-suave); background: transparent;
  border: 1px solid var(--linea-fuerte); border-radius: 10px; padding: 11px 16px; cursor: pointer;
}
.pb-btn-tenue:hover { border-color: var(--tenue); color: var(--tinta); }

.pb-error {
  margin-top: 14px; padding: 11px 15px; border-radius: 9px;
  background: var(--rojo-suave); color: var(--rojo); font-size: .9rem;
}

.pb-firmado {
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  padding: 20px 22px; border: 1px solid #CFE7DC; background: var(--verde-suave); border-radius: 14px;
}
.pb-firmado-check {
  width: 34px; height: 34px; flex: none; border-radius: 50%;
  background: var(--verde); color: #fff; display: grid; place-items: center; font-size: 1rem;
}
.pb-firmado-t { font-weight: 700; color: #14543C; }
.pb-firmado-d { font-size: .88rem; color: #2C6A50; }
.pb-firmado-img { height: 46px; width: auto; margin-left: auto; opacity: .8; mix-blend-mode: multiply; }

/* ── Etapas ── */
/* La puerta de entrada */
.pb-puerta {
  margin-bottom: 30px; padding: 22px 24px; border-radius: 14px;
  background: var(--tinta); color: #fff;
}
.pb-puerta-t { font-family: var(--serif); font-size: 1.42rem; font-weight: 600; margin-bottom: 6px; }
.pb-puerta p { margin: 0; font-size: .95rem; color: rgba(255,255,255,.76); line-height: 1.5; }
.pb-puerta p b { color: #fff; font-weight: 600; }
.pb-puerta-riel {
  height: 5px; border-radius: 3px; background: rgba(255,255,255,.2);
  overflow: hidden; margin: 14px 0 8px;
}
.pb-puerta-riel span { display: block; height: 100%; background: var(--oro-claro, #D6B87A); border-radius: 3px; }
.pb-puerta-n { font-size: .88rem; }
.pb-puerta-btn {
  margin-top: 18px; background: #fff; color: var(--tinta); min-height: 48px;
}
.pb-puerta-btn:hover { background: #F0F0F0; }

/* Secciones plegadas del documento */
.pb-sec-plegable[data-plegada] > .pb-sec-h { cursor: pointer; user-select: none; }
.pb-sec-plegable[data-plegada] .pb-sec-h h2 { flex: 1; }
.pb-sec-plegable[data-plegada] .pb-sec-h { display: flex; align-items: center; gap: 14px; }
.pb-plegar {
  width: 11px; height: 11px; flex: none; border-right: 2px solid var(--tenue);
  border-bottom: 2px solid var(--tenue); transform: rotate(45deg) translate(-2px, -2px);
  transition: transform .18s ease;
}
.pb-sec-plegable[data-plegada='0'] .pb-plegar { transform: rotate(-135deg) translate(-3px, -3px); }
.pb-sec-plegable[data-plegada='1'] > *:not(.pb-sec-h) { display: none; }
.pb-sec-plegable[data-plegada='1'] { margin-top: 20px; padding-bottom: 0; }
.pb-sec-plegable[data-plegada='1'] + .pb-sec-plegable[data-plegada='1'] { margin-top: 0; border-top: 1px solid var(--linea); padding-top: 20px; }

/* La respuesta ya enviada, cuando hay una pregunta abierta encima */
.pb-ya {
  margin: 4px 0 0; padding: 14px 16px; border-radius: 10px;
  background: var(--papel-2); border: 1px solid var(--linea);
}
.pb-ya-t {
  display: block; font-family: var(--mono); font-size: .7rem; letter-spacing: .1em;
  text-transform: uppercase; color: var(--tenue); margin-bottom: 6px;
}
.pb-ya p { margin: 0; font-size: .95rem; color: var(--tinta); white-space: pre-wrap; line-height: 1.55; }
.pb-editar {
  margin-top: 10px; font: inherit; font-size: .87rem; font-weight: 600; color: var(--tinta);
  background: none; border: 0; padding: 11px 0; cursor: pointer; min-height: 44px;
  text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px;
  text-decoration-color: var(--linea-fuerte);
}
.pb-editar:hover { text-decoration-color: var(--tinta); }
.pb-ya-por { display: block; font-size: .84rem; color: var(--tenue); margin: -2px 0 10px; line-height: 1.45; }
.pb-oculto { display: none; }

/* El sello de guardado */
.pb-autoguarda {
  margin: 14px 0 4px; padding: 11px 14px; border-radius: 9px;
  background: var(--papel-2); border: 1px dashed var(--linea-fuerte);
  font-size: .87rem; color: var(--tinta-suave); line-height: 1.45;
}

.pb-sello {
  margin-top: 9px; font-size: .8rem; color: var(--tenue);
  display: flex; align-items: center; gap: 7px;
}
/* `display: flex` le gana al `[hidden] { display: none }` del navegador: sin
   esta línea el sello vacío dejaba un punto gris suelto bajo cada campo. */
.pb-sello[hidden] { display: none; }
.pb-sello::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--linea-fuerte); flex: none;
}
.pb-sello[data-e=escribiendo]::before { background: var(--ambar); }
.pb-sello[data-e=ok] { color: var(--verde); }
.pb-sello[data-e=ok]::before { background: var(--verde); }
.pb-sello[data-e=error] { color: var(--rojo); }
.pb-sello[data-e=error]::before { background: var(--rojo); }

/* El chevron: la tarjeta se abre */
.pb-chev {
  width: 9px; height: 9px; flex: none; margin-left: 2px;
  border-right: 2px solid var(--tenue); border-bottom: 2px solid var(--tenue);
  transform: rotate(45deg) translate(-2px, -2px); transition: transform .18s ease;
}
.pb-et[data-abierta] .pb-chev { transform: rotate(-135deg) translate(-3px, -3px); }

.pb-pie-ayuda { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
.pb-pie-ayuda span { font-size: .86rem; color: var(--tinta-suave); }
.pb-btn-wa {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 48px; padding: 13px 22px; border-radius: 10px;
  border: 1px solid var(--linea-fuerte); background: var(--papel);
  color: var(--tinta); text-decoration: none; font-size: .93rem; font-weight: 600;
}
.pb-btn-wa:hover { border-color: var(--tinta); }

.pb-etapas { display: flex; flex-direction: column; gap: 14px; }

.pb-aviso-global {
  padding: 18px 22px; border-radius: 13px; border: 1px solid var(--linea-fuerte);
  background: var(--papel-2); display: flex; flex-direction: column; gap: 5px;
}
.pb-aviso-global strong { font-family: var(--serif); font-size: 1.16rem; font-weight: 600; }
.pb-aviso-global span { font-size: .9rem; color: var(--tinta-suave); }
.pb-aviso-global a { color: var(--tinta); text-decoration: none; border-bottom: 1px solid currentColor; }
.pb-aviso-global[data-tono=preguntas] { background: var(--ambar-suave); border-color: #EFDFBF; }
.pb-aviso-global[data-tono=preguntas] strong { color: var(--ambar); }
.pb-aviso-global[data-tono=preguntas] span, .pb-aviso-global[data-tono=preguntas] a { color: #7A5A18; }
.pb-aviso-global[data-tono=listo] { background: var(--verde-suave); border-color: #CFE7DC; }
.pb-aviso-global[data-tono=listo] strong { color: var(--verde); }
.pb-aviso-global[data-tono=espera] { background: var(--azul-suave); border-color: #CFE0FA; }
.pb-aviso-global[data-tono=espera] strong { color: var(--azul); }
.pb-cargando { color: var(--tenue); font-size: .93rem; padding: 20px 0; }

.pb-et {
  border: 1px solid var(--linea); border-radius: 14px; background: var(--papel);
  overflow: hidden; transition: border-color .18s, box-shadow .18s;
}
.pb-et[data-abierta] { border-color: var(--linea-fuerte); box-shadow: 0 1px 2px rgba(20,24,29,.04), 0 10px 30px rgba(20,24,29,.05); }
.pb-et[data-estado=bloqueada] { background: var(--papel-2); }

.pb-et-cab {
  display: flex; align-items: center; gap: 14px; width: 100%;
  padding: 18px 22px; background: none; border: 0; font: inherit;
  text-align: left; cursor: pointer; color: inherit;
}
.pb-et[data-estado=bloqueada] .pb-et-cab { cursor: pointer; }
.pb-et-n {
  width: 30px; height: 30px; flex: none; border-radius: 50%;
  display: grid; place-items: center; font-family: var(--mono); font-size: .8rem; font-weight: 600;
  background: #F0F2F5; color: var(--tenue);
}
.pb-et[data-estado=abierta] .pb-et-n, .pb-et[data-estado=cambios] .pb-et-n { background: var(--tinta); color: #fff; }
.pb-et[data-estado=enviada] .pb-et-n { background: var(--ambar-suave); color: var(--ambar); }
.pb-et[data-estado=aprobada] .pb-et-n { background: var(--verde); color: #fff; }
.pb-et-tit { flex: 1; min-width: 0; }
.pb-et-tit strong { display: block; font-family: var(--serif); font-size: 1.14rem; font-weight: 600; }
.pb-et-tit span { display: block; font-size: .85rem; color: var(--tenue); margin-top: 2px; }
.pb-et[data-estado=bloqueada] .pb-et-tit strong { color: var(--tenue); }

.pb-chip {
  flex: none; font-family: var(--mono); font-size: .68rem; letter-spacing: .1em;
  text-transform: uppercase; font-weight: 600; padding: 5px 10px; border-radius: 20px;
  background: #EDEFF2; color: #6B737C; white-space: nowrap;
}
.pb-chip[data-e=abierta] { background: var(--azul-suave); color: var(--azul); }
.pb-chip[data-e=enviada] { background: var(--ambar-suave); color: var(--ambar); }
.pb-chip[data-e=cambios] { background: var(--rojo-suave); color: var(--rojo); }
.pb-chip[data-e=aprobada] { background: var(--verde-suave); color: var(--verde); }

.pb-et-cuerpo { padding: 4px 22px 24px; border-top: 1px solid var(--linea); }

.pb-previa-nota {
  margin: 18px 0 4px; padding: 15px 18px; border-radius: 11px;
  background: var(--papel-2); border: 1px dashed var(--linea-fuerte);
}
.pb-previa-nota p { margin: 0; font-size: .92rem; color: var(--tinta-suave); }
.pb-previa { list-style: none; padding: 0; margin: 20px 0 0; }
.pb-previa li { padding: 9px 0 9px 20px; position: relative; border-bottom: 1px solid var(--linea); }
.pb-previa li:last-child { border-bottom: 0; }
.pb-previa li::before {
  content: ''; position: absolute; left: 3px; top: 17px;
  width: 5px; height: 5px; border-radius: 50%; background: var(--linea-fuerte);
}
.pb-previa li b { font-size: .95rem; font-weight: 600; color: var(--tinta-suave); }
.pb-previa li .pb-campo-req { color: var(--oro); font-weight: 400; white-space: nowrap; }
.pb-previa li em {
  font-family: var(--mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase;
  font-style: normal; color: var(--tenue); margin-left: 8px;
}
.pb-previa li span { display: block; font-size: .85rem; color: var(--tenue); margin-top: 2px; line-height: 1.45; }
.pb-previa-g {
  padding-left: 0 !important; border-bottom: 0 !important; margin-top: 16px;
  font-family: var(--mono); font-size: .64rem; letter-spacing: .15em;
  text-transform: uppercase; color: var(--oro); font-weight: 600;
}
.pb-previa-g::before { display: none; }
.pb-previa-g:first-child { margin-top: 0; }
.pb-et-intro { color: var(--tinta-suave); font-size: .94rem; max-width: 64ch; margin: 18px 0 4px; }
.pb-et-entrega {
  margin: 16px 0 26px; padding: 13px 16px; border-radius: 10px;
  background: var(--papel-2); border: 1px solid var(--linea); font-size: .88rem; color: var(--tinta-suave);
}
.pb-et-entrega b { color: var(--tinta); font-weight: 600; }

.pb-grupo {
  display: flex; align-items: center; gap: 12px;
  margin: 30px 0 2px; padding-top: 22px; border-top: 1px solid var(--linea);
}
.pb-grupo::after { content: ''; flex: 1; height: 1px; background: var(--linea); }
.pb-grupo span {
  font-family: var(--mono); font-size: .66rem; letter-spacing: .16em;
  text-transform: uppercase; color: var(--oro); font-weight: 600; white-space: nowrap;
}
.pb-grupo + .pb-campo { border-top: 0; padding-top: 14px; }

.pb-avance { margin: 0 0 6px; }
.pb-avance-riel {
  height: 4px; border-radius: 3px; background: var(--linea); overflow: hidden; margin-bottom: 8px;
}
.pb-avance-riel span {
  display: block; height: 100%; background: var(--oro); border-radius: 3px;
  transition: width .3s ease;
}
.pb-avance-txt { font-size: .8rem; color: var(--tenue); text-wrap: pretty; }
.pb-avance-txt b { color: var(--oro); }

.pb-campo { padding: 20px 0; border-top: 1px solid var(--linea); }
.pb-campo:first-of-type { border-top: 0; }
.pb-campo-lab { font-size: 1rem; font-weight: 600; color: var(--tinta); margin-bottom: 5px; }
.pb-campo-req { color: var(--oro); margin-left: 5px; font-weight: 400; }
.pb-campo-ayuda { font-size: .88rem; color: var(--tenue); margin-bottom: 13px; max-width: 62ch; line-height: 1.5; }

.pb-visitar {
  display: inline-flex; align-items: center; gap: 7px; margin-bottom: 13px;
  font-size: .88rem; font-weight: 600; color: var(--azul); text-decoration: none;
  padding: 8px 14px; border: 1px solid var(--azul-suave); border-radius: 9px;
  background: var(--azul-suave); transition: border-color .15s;
}
.pb-visitar:hover { border-color: var(--azul); }
.pb-visitar span { font-size: .8em; }
.pb-previa .pb-visitar { margin: 8px 0 2px; }

.pb-ops { display: flex; flex-direction: column; gap: 2px; }
.pb-op {
  display: flex; align-items: flex-start; gap: 11px; padding: 9px 12px;
  border-radius: 9px; cursor: pointer; transition: background .12s;
  font-size: .94rem; color: var(--tinta-suave);
}
.pb-op:hover { background: var(--papel-2); }
.pb-op input { margin: 3px 0 0; accent-color: var(--tinta); flex: none; width: 15px; height: 15px; }
.pb-op input:checked + span { color: var(--tinta); font-weight: 500; }

.pb-escala { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.pb-escala-ext { font-size: .82rem; color: var(--tenue); }
.pb-escala-pts { display: flex; gap: 6px; }
.pb-escala-pt {
  width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--linea-fuerte);
  background: var(--papel); cursor: pointer; font: inherit; font-size: .9rem; color: var(--tinta-suave);
  transition: all .15s;
}
.pb-escala-pt[aria-pressed=true] { background: var(--tinta); color: #fff; border-color: var(--tinta); }

.pb-links { display: flex; flex-direction: column; gap: 9px; }
.pb-link-fila { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.25fr) auto; gap: 8px; align-items: center; }
@media (max-width: 640px) { .pb-link-fila { grid-template-columns: 1fr; } }
.pb-quitar {
  width: 40px; height: 40px; flex: none; border: 1px solid var(--linea); border-radius: 8px;
  background: var(--papel); color: var(--tenue); cursor: pointer; font-size: 1rem; line-height: 1;
}
.pb-quitar:hover { color: var(--rojo); border-color: var(--rojo); }
.pb-agregar {
  align-self: flex-start; font: inherit; font-size: .87rem; color: var(--azul);
  background: none; border: 0; padding: 4px 0; cursor: pointer;
}
.pb-agregar:hover { text-decoration: underline; }

.pb-zona {
  border: 1.5px dashed var(--linea-fuerte); border-radius: 12px; padding: 20px;
  cursor: pointer; transition: all .15s; background: var(--papel-2);
}
.pb-zona:hover, .pb-zona[data-encima] { border-color: var(--azul); background: var(--azul-suave); }
.pb-zona-btn {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 48px; padding: 13px 22px; border-radius: 10px;
  background: var(--tinta); color: #fff; font-size: .95rem; font-weight: 600;
}
.pb-zona:hover .pb-zona-btn, .pb-zona[data-encima] .pb-zona-btn { background: #000; }
.pb-zona-s { font-size: .84rem; color: var(--tenue); margin-top: 10px; line-height: 1.45; }

.pb-pegalink { margin-top: 12px; }
.pb-pegalink > span { display: block; font-size: .84rem; color: var(--tenue); margin-bottom: 8px; line-height: 1.45; }
.pb-pegalink-fila { display: flex; gap: 8px; align-items: stretch; }
.pb-pegalink-fila input { flex: 1; min-width: 0; }
.pb-pegalink-fila .pb-add { flex: none; min-height: 46px; font-weight: 600; }

.pb-archivos { display: flex; flex-direction: column; gap: 7px; margin-top: 11px; }
.pb-arch {
  display: flex; align-items: center; gap: 11px; padding: 10px 13px;
  border: 1px solid var(--linea); border-radius: 9px; background: var(--papel); font-size: .89rem;
}
.pb-arch-ext {
  font-family: var(--mono); font-size: .6rem; font-weight: 700; letter-spacing: .05em;
  padding: 4px 7px; border-radius: 5px; background: var(--oro-suave); color: var(--oro); flex: none;
}
.pb-arch-n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--tinta); }
.pb-arch-p { color: var(--tenue); font-size: .8rem; flex: none; }
.pb-arch a {
  color: var(--tinta-suave); text-decoration: none; font-size: .84rem; font-weight: 600;
  padding: 10px 14px; min-height: 40px; display: flex; align-items: center; flex: none;
  border: 1px solid var(--linea); border-radius: 8px;
}
.pb-arch a:hover { color: var(--tinta); border-color: var(--linea-fuerte); }

.pb-et-pie {
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--linea);
}
.pb-et-pie-nota { font-size: .85rem; color: var(--tenue); margin-right: auto; }

.pb-nota-sacs {
  margin: 18px 0 0; padding: 15px 18px; border-radius: 10px;
  background: var(--ambar-suave); border-left: 3px solid var(--ambar);
}
.pb-nota-sacs .pb-campo-t { color: var(--ambar); }
.pb-nota-sacs p { margin: 0; font-size: .93rem; color: #6C5017; }

/* ── Correos de aviso ── */
.pb-avisos { display: block; margin-bottom: 22px; }
.pb-avisos small {
  display: block; margin-top: 7px; font-size: .82rem; color: var(--tenue); line-height: 1.5;
}

/* ── Lo que falta contestar ── */
.pb-pendientes {
  margin: 18px 0 4px; padding: 18px 20px; border-radius: 12px;
  background: var(--papel-2); border: 1px solid var(--linea-fuerte);
}
.pb-pendientes .pb-campo-t { color: var(--tinta); margin-bottom: 12px; }
.pb-pendientes ol { margin: 0; padding: 0; list-style: none; counter-reset: pend; }
.pb-pendientes li { border-top: 1px solid var(--linea); }
.pb-pendientes li:first-child { border-top: 0; }
.pb-pendientes a {
  display: flex; align-items: center; gap: 12px; padding: 14px 0;
  color: var(--tinta); text-decoration: none; min-height: 52px;
}
.pb-pendientes a::before {
  counter-increment: pend; content: counter(pend);
  width: 24px; height: 24px; flex: none; border-radius: 50%;
  background: var(--ambar); color: #fff; display: grid; place-items: center;
  font-family: var(--mono); font-size: .72rem; font-weight: 600;
}
.pb-pend-t { flex: 1; font-size: .96rem; font-weight: 500; line-height: 1.35; }
.pb-pend-c {
  width: 9px; height: 9px; flex: none;
  border-right: 2px solid var(--tenue); border-bottom: 2px solid var(--tenue);
  transform: rotate(-45deg);
}
.pb-pendientes a:active { opacity: .6; }

/* ── Hilo de conversación ── */
.pb-hilo {
  margin-top: 14px; padding: 14px 16px; border-radius: 11px;
  background: var(--papel-2); border: 1px solid var(--linea);
}
.pb-hilo-espera { background: var(--ambar-suave); border-color: #EFDFBF; border-left: 3px solid var(--ambar); }
.pb-msg { margin-bottom: 12px; }
.pb-msg:last-of-type { margin-bottom: 0; }
.pb-msg-de {
  display: block; font-family: var(--mono); font-size: .64rem; letter-spacing: .12em;
  text-transform: uppercase; color: var(--tenue); margin-bottom: 4px;
}
.pb-msg[data-de=sacs] .pb-msg-de { color: var(--ambar); }
.pb-msg p { margin: 0; font-size: .93rem; color: var(--tinta); line-height: 1.55; }
.pb-hilo-caja { margin-top: 12px; display: flex; flex-direction: column; gap: 9px; align-items: flex-start; }
.pb-hilo-caja textarea { min-height: 74px; }
.pb-hilo-ok {
  margin-top: 10px; font-family: var(--mono); font-size: .62rem; letter-spacing: .1em;
  text-transform: uppercase; color: var(--verde);
}
.pb-btn-chico {
  font: inherit; font-size: .86rem; font-weight: 600; color: #fff; background: var(--tinta);
  border: 0; border-radius: 9px; padding: 9px 18px; cursor: pointer;
}
.pb-btn-chico:hover { background: #000; }
.pb-btn-chico:disabled { background: var(--tenue); cursor: default; }

/* ── Caja de revisión por pregunta (solo Sacs) ── */
.pb-nota-campo { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
.pb-nota-campo textarea { min-height: 62px; font-size: .9rem; }
.pb-esq { display: flex; align-items: center; gap: 8px; font-size: .84rem; color: var(--tinta-suave); cursor: pointer; }
.pb-esq input { accent-color: var(--ambar); width: 15px; height: 15px; }
.pb-vacio { color: var(--tenue); font-style: italic; }

.pb-resumen { display: flex; flex-direction: column; gap: 14px; }
.pb-res { font-size: .93rem; }
.pb-res dt { font-weight: 600; color: var(--tinta); margin-bottom: 3px; }
.pb-res dd { margin: 0; color: var(--tinta-suave); white-space: pre-wrap; }
.pb-res { padding-bottom: 14px; border-bottom: 1px solid var(--linea); }
.pb-res:last-child { border-bottom: 0; }

/* ── Bitácora ── */
.pb-log { list-style: none; padding: 0; margin: 0; }
.pb-log li {
  display: flex; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--linea); font-size: .9rem;
}
.pb-log li:last-child { border-bottom: 0; }
.pb-log-f { font-family: var(--mono); font-size: .74rem; color: var(--tenue); flex: none; width: 108px; padding-top: 2px; }
.pb-log-a { color: var(--tinta); }
.pb-log-a span { color: var(--tenue); }

.pb-pie {
  margin-top: 70px; padding-top: 24px; border-top: 1px solid var(--linea);
  font-size: .82rem; color: var(--tenue);
}
.pb-pie-sm { margin-top: 5px; font-size: .78rem; }

.pb-modo-sacs {
  max-width: 900px; margin: 0 auto; padding: 9px clamp(20px, 5vw, 56px);
  font-size: .82rem; color: #6C5423; background: var(--oro-suave);
  border-top: 1px solid #EADFC8;
}
.pb-modo-sacs b { color: var(--oro); }

.pb-rev {
  margin-top: 22px; padding: 18px 20px; border: 1px solid #EADFC8;
  background: var(--oro-suave); border-radius: 12px;
}
.pb-rev .pb-campo-t { color: var(--oro); }
.pb-rev textarea { min-height: 70px; background: #fff; }
.pb-rev-acc { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
.pb-btn-verde { background: var(--verde); }
.pb-btn-verde:hover { background: #17734F; }

/* ══════════════════════════════════════════════════════════════════
   MÓVIL
   Esto no es el escritorio encogido. Medido a 390×844 antes de tocarlo:
   los 12 campos estaban a 15.2px —debajo de 16 iOS hace ZOOM en cada
   toque—, las pastillas de estado a 9px, la cabecera a 9.6px, y había
   2,884px de documento (3.4 pantallas) antes de llegar a lo que el
   cliente viene a hacer. Aquí se arregla eso.
   ══════════════════════════════════════════════════════════════════ */
@media (max-width: 720px) {

  /* ── Lo que iOS castiga ──
     Cualquier campo por debajo de 16px hace que Safari acerque la página
     al enfocarlo, y al salir se queda torcida. No es preferencia: es la
     diferencia entre poder contestar y pelearse con el zoom. */
  .pb input[type=text], .pb input[type=email], .pb input[type=url], .pb textarea {
    font-size: 16px;
    padding: 13px 14px;
  }
  .pb textarea { min-height: 112px; }

  /* ── La cabecera ──
     "0 DE 12 ETAPAS APROBADAS" a 9.6px al lado del nombre del cliente en
     390px no lo lee nadie. Se queda el contador corto, legible. */
  .pb-top-in { padding: 11px 16px; gap: 10px; }
  .pb-marca img { height: 15px; }
  .pb-top-cli { font-size: .95rem; }
  .pb-top-est { font-size: .72rem; letter-spacing: .06em; }

  .pb-hoja { padding-left: 16px; padding-right: 16px; padding-top: 30px; }

  /* ── Portada ──
     El titular y la entrada ocupaban media pantalla cada uno. */
  .pb-portada { padding-bottom: 4px; }
  .pb h1 { font-size: 1.95rem; line-height: 1.1; }
  .pb-lede { font-size: 1rem; line-height: 1.55; }
  .pb-meta { grid-template-columns: 1fr 1fr; gap: 16px 18px; margin-top: 26px; padding-top: 20px; }
  .pb-meta dt { font-size: .68rem; }
  .pb-meta dd { font-size: .92rem; }

  .pb-sec, .pb-firma-sec { margin-top: 40px; }
  .pb-sec-h { margin-bottom: 16px; }
  .pb h2 { font-size: 1.35rem; }
  .pb-parr, .pb-lista li { font-size: .95rem; }

  /* ── La tarjeta de etapa ──
     En escritorio son tres columnas: número, título+bajada, pastilla. En
     390px eso partía el título en dos y dejaba la bajada en un canal de
     200px. Aquí se apila: número y título arriba, la pastilla como
     etiqueta suya, y la bajada a todo lo ancho. */
  .pb-et-cab {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) 14px;
    grid-template-areas: 'n tit chev' 'x chip chip';
    align-items: start;
    gap: 6px 12px;
    padding: 16px;
  }
  /* El número se alinea con el título, no con el centro de un bloque de tres
     renglones: centrado se veía descuadrado. */
  .pb-et-n { grid-area: n; margin-top: 1px; }
  .pb-et-tit { grid-area: tit; min-width: 0; }
  .pb-et-cab .pb-chev { margin-top: 11px; }
  .pb-et-tit strong { font-size: 1.08rem; line-height: 1.25; }
  .pb-et-tit span { display: none; }
  .pb-et-cab .pb-chip { grid-area: chip; justify-self: start; }
  .pb-et-cab .pb-chev { grid-area: chev; margin: 0; }

  /* La bajada solo estorba en la lista: se lee al abrir la etapa, donde ya
     está el mismo texto en "Al aprobarse". */
  .pb-et[data-abierta] .pb-et-tit span { display: block; font-size: .85rem; margin-top: 4px; }

  /* El estado, legible. Antes: 9px, mayúsculas, espaciado y gris — la peor
     combinación posible para ojos de 55 años, y justo ahí vivía toda la
     información de "qué me toca". */
  .pb-chip {
    font-family: var(--sans); font-size: .8rem; font-weight: 600;
    padding: 5px 11px; letter-spacing: 0; text-transform: none;
  }
  .pb-msg-de, .pb-ya-t, .pb-campo-t, .pb-hilo-ok, .pb-previa li em {
    font-size: .78rem; letter-spacing: .04em; text-transform: none;
  }
  .pb-grupo span { font-size: .78rem; letter-spacing: .1em; }
  .pb-eyebrow, .pb-meta dt { font-size: .72rem; letter-spacing: .12em; }
  .pb-avance-txt, .pb-sello { font-size: .85rem; }
  .pb-log-f { font-size: .78rem; }

  /* El tirador de redimensionar no sirve al tacto y se lee como suciedad. */
  .pb textarea { resize: none; }

  /* La cabecera a 390px: el nombre del cliente se cortaba en "Ruben'…"
     porque la pastilla de estado le comía el renglón. El cliente ya sabe
     quién es; lo que necesita saber es en qué etapa va. */
  .pb-top-sep, .pb-top-cli { display: none; }
  .pb-top-in { justify-content: space-between; }
  .pb-top-est { min-height: 44px; font-size: .78rem; padding: 10px 14px; }

  /* Los datos de la portada, uno por renglón: en dos columnas el tercero
     quedaba solo con medio renglón vacío al lado. */
  .pb-meta {
    display: flex; flex-direction: column; gap: 0;
    margin-top: 22px; padding-top: 18px;
  }
  .pb-meta div {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--linea);
  }
  .pb-meta div:last-child { border-bottom: 0; }
  .pb-meta dt { margin-bottom: 0; }
  .pb-meta dd { text-align: right; }

  /* Ya firmado, la entrada de la portada es contexto que ya leyó. La puerta
     de arriba dice lo que importa. */
  .pb[data-firmado] .pb-lede { display: none; }
  .pb[data-firmado] .pb-portada h1 { font-size: 1.6rem; }

  /* Un encabezado plegable se toca con el pulgar. */
  .pb-sec-plegable[data-plegada] > .pb-sec-h { min-height: 52px; padding: 6px 0; margin-bottom: 0; }
  .pb-aviso-global a { padding: 11px 0; display: inline-block; }
  .pb-btn-wa { width: 100%; }

  .pb-puerta { padding: 20px 18px; margin-bottom: 26px; }
  .pb-puerta-t { font-size: 1.28rem; }
  .pb-puerta-btn { width: 100%; min-height: 50px; font-size: 1rem; }

  .pb-ya { padding: 13px 14px; }
  .pb-editar { min-height: 48px; }

  .pb-et-cuerpo { padding: 2px 16px 22px; }
  .pb-et-intro { font-size: .95rem; margin-top: 16px; }
  .pb-et-entrega { font-size: .88rem; padding: 12px 14px; margin-bottom: 20px; }

  /* ── Las preguntas ── */
  .pb-campo { padding: 18px 0; }
  .pb-campo-lab { font-size: 1.02rem; line-height: 1.35; }
  .pb-campo-ayuda { font-size: .89rem; }
  .pb-grupo { margin-top: 26px; padding-top: 20px; }

  /* Objetivos táctiles: una opción se toca con el pulgar, no con el ratón. */
  .pb-op { padding: 12px; min-height: 48px; align-items: center; }
  .pb-op input { width: 20px; height: 20px; margin-top: 0; }
  .pb-escala-pt { width: 52px; height: 52px; font-size: 1rem; }
  .pb-escala { justify-content: space-between; }
  .pb-escala-ext { font-size: .78rem; max-width: 40%; }
  .pb-quitar { width: 44px; height: 44px; }
  .pb-arch .pb-quitar, .pb-link-fila .pb-quitar { width: 44px; height: 44px; }
  .pb-agregar { padding: 10px 0; min-height: 44px; }
  .pb-zona { padding: 18px 16px; }
  .pb-zona-btn { width: 100%; min-height: 52px; font-size: 1rem; }
  .pb-pegalink-fila { flex-direction: column; }
  .pb-pegalink-fila .pb-add { width: 100%; min-height: 48px; }
  .pb-firma-borrar { min-height: 44px; }

  /* ── El hilo ── */
  .pb-hilo { padding: 14px; }
  .pb-msg p { font-size: .95rem; }
  .pb-hilo-caja .pb-btn-chico { width: 100%; min-height: 48px; }

  .pb-pendientes { padding: 16px; }

  .pb-aviso-global { padding: 16px; }
  .pb-aviso-global strong { font-size: 1.08rem; }

  /* ── Acciones a lo ancho ── */
  .pb-et-pie { flex-direction: column; align-items: stretch; gap: 14px; }
  .pb-et-pie .pb-btn { width: 100%; min-height: 50px; font-size: 1rem; }
  .pb-et-pie-nota { order: 2; font-size: .87rem; line-height: 1.45; }
  .pb-rev-acc { flex-direction: column; }
  .pb-rev-acc .pb-btn, .pb-rev-acc .pb-btn-tenue { width: 100%; min-height: 48px; }
  .pb-firma-acc { flex-direction: column-reverse; align-items: stretch; }
  .pb-firma-acc .pb-btn, .pb-firma-acc .pb-btn-tenue { width: 100%; min-height: 50px; }

  .pb-campos { grid-template-columns: 1fr; gap: 12px; }
  .pb-firma-caja { padding: 18px 16px; }
  .pb-firma-lienzo { height: 180px; }

  .pb-previa li b { font-size: .95rem; }
  .pb-previa li span { font-size: .87rem; }
  .pb-previa-g { font-size: .66rem; }
  .pb-visitar { min-height: 46px; padding: 12px 16px; }

  .pb-log-f { width: 82px; }
  .pb-res dd { font-size: .95rem; }
  .pb-nota-campo textarea { min-height: 90px; }

  .pb-guardado { bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }
}

/* Al saltar a una pregunta, la cabecera pegada se comía el título. */
.pb-campo, .pb-et, .pb-res, .pb-sec, .pb-firma-sec, .pb-hilo { scroll-margin-top: 76px; }

.pb-guardado {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  background: var(--tinta); color: #fff; padding: 9px 18px; border-radius: 20px;
  font-size: .84rem; z-index: 60; box-shadow: 0 6px 24px rgba(20,24,29,.24);
  animation: pbsube .2s ease;
}
@keyframes pbsube { from { opacity: 0; transform: translate(-50%, 8px); } }
</style>

<script>
  const raiz = document.querySelector('.pb');
  if (raiz) {
    const TOKEN = raiz.getAttribute('data-token');
    const SACS = !!raiz.getAttribute('data-sacs');
    const FIRMADO = !!raiz.getAttribute('data-firmado');

    // ── Firma ──────────────────────────────────────────────────────────
    const lienzo = document.getElementById('f-canvas');
    if (lienzo) {
      const ctx = lienzo.getContext('2d');
      let trazando = false, trazado = false;

      const medir = () => {
        const r = lienzo.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        // Redimensionar limpia el lienzo, así que solo se hace mientras no
        // haya nada dibujado: si no, el teclado del teléfono al abrirse
        // borraba la firma recién hecha.
        if (trazado) return;
        lienzo.width = Math.round(r.width * dpr);
        lienzo.height = Math.round(r.height * dpr);
        if (!ctx) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.strokeStyle = '#14181D';
        ctx.lineWidth = 2.1;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
      };
      medir();
      window.addEventListener('resize', medir);

      const punto = (e) => {
        const r = lienzo.getBoundingClientRect();
        const t = e.touches && e.touches.length ? e.touches[0] : e;
        return { x: t.clientX - r.left, y: t.clientY - r.top };
      };
      const abajo = (e) => {
        trazando = true;
        const p = punto(e);
        ctx && (ctx.beginPath(), ctx.moveTo(p.x, p.y));
      };
      const btnFirmar = document.getElementById('f-firmar');
      const btnBorrar = document.getElementById('f-limpiar');
      const encender = (hay) => {
        // "Borrar" solo existe cuando hay algo que borrar.
        if (btnBorrar) btnBorrar.hidden = !hay;
        if (!btnFirmar) return;
        btnFirmar.disabled = !hay;
        btnFirmar.textContent = hay ? 'Firmar y comenzar' : 'Firma para comenzar';
      };

      const mueve = (e) => {
        if (!trazando || !ctx) return;
        trazado = true;
        encender(true);
        const p = punto(e);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        const h = document.querySelector('.pb-firma-hint');
        if (h) h.style.display = 'none';
      };
      const arriba = () => { trazando = false; };

      lienzo.addEventListener('mousedown', abajo);
      lienzo.addEventListener('mousemove', mueve);
      window.addEventListener('mouseup', arriba);
      lienzo.addEventListener('touchstart', (e) => { e.preventDefault(); abajo(e); }, { passive: false });
      lienzo.addEventListener('touchmove', (e) => { e.preventDefault(); mueve(e); }, { passive: false });
      lienzo.addEventListener('touchend', arriba);

      document.getElementById('f-limpiar')?.addEventListener('click', () => {
        ctx && ctx.clearRect(0, 0, lienzo.width, lienzo.height);
        trazado = false;
        encender(false);
        const h = document.querySelector('.pb-firma-hint');
        if (h) h.style.display = '';
      });

      const err = document.getElementById('f-error');
      const fallo = (m) => { if (err) { err.textContent = m; err.hidden = false; } };

      document.getElementById('f-firmar')?.addEventListener('click', async (ev) => {
        const btn = ev.currentTarget;
        const nombre = (document.getElementById('f-nombre')?.value || '').trim();
        if (nombre.length < 3) return fallo('Escribe tu nombre completo.');
        if (!trazado) return fallo('Falta la firma: traza tu firma en el recuadro.');
        if (err) err.hidden = true;
        btn.disabled = true;
        btn.textContent = 'Firmando…';
        try {
          const res = await fetch('/api/proyecto/firmar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              token: TOKEN,
              nombre,
              puesto: document.getElementById('f-puesto')?.value || '',
              email: document.getElementById('f-email')?.value || '',
              avisos: document.getElementById('f-avisos')?.value || '',
              firma_png: lienzo.toDataURL('image/png'),
            }),
          });
          const d = await res.json();
          if (!res.ok) throw new Error(d.error || 'No se pudo firmar');
          location.reload();
        } catch (e) {
          btn.disabled = false;
          btn.textContent = 'Firmar y comenzar';
          fallo(e.message || 'No se pudo firmar. Intenta de nuevo.');
        }
      });
    }

    // ── Etapas ─────────────────────────────────────────────────────────
    const cajaEtapas = document.getElementById('pb-etapas');
    const cajaLog = document.getElementById('pb-log');
    const secLog = document.getElementById('bitacora');
    const avance = document.getElementById('pb-avance');
    const aviso = document.getElementById('pb-guardado');

    let DEF = [];        // definición del cuestionario
    let ETAPAS = [];     // estado en la base
    let HILOS = [];      // conversación por pregunta
    let borrador = {};   // clave → respuestas en edición
    let abierta = null;  // qué etapa está desplegada

    const CHIP = {
      bloqueada: 'Bloqueada',
      abierta: 'Por contestar',
      enviada: 'En revisión',
      cambios: 'Cambios pedidos',
      aprobada: 'Aprobada',
    };

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const kb = (n) => n > 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB';

    let temporizador = null;
    const decirGuardado = () => {
      if (!aviso) return;
      aviso.hidden = false;
      clearTimeout(temporizador);
      temporizador = setTimeout(() => { aviso.hidden = true; }, 1600);
    };

    async function cargar() {
      const res = await fetch('/api/proyecto/estado?token=' + encodeURIComponent(TOKEN));
      if (!res.ok) { if (cajaEtapas) cajaEtapas.innerHTML = '<div class="pb-cargando">No se pudo cargar.</div>'; return; }
      const d = await res.json();
      DEF = d.definicion || [];
      ETAPAS = d.etapas || [];
      HILOS = d.hilos || [];
      for (const e of ETAPAS) if (!(e.clave in borrador)) borrador[e.clave] = { ...(e.respuestas || {}) };
      // Se despliega sola la etapa en la que toca trabajar.
      if (abierta === null) {
        // El cliente aterriza en la etapa que le toca contestar; Sacs, en la
        // que está esperando revisión.
        const activa = SACS
          ? (ETAPAS.find((e) => e.estado === 'enviada') || ETAPAS.find((e) => e.estado === 'cambios') || ETAPAS.find((e) => e.estado === 'abierta'))
          : (ETAPAS.find((e) => e.estado === 'cambios') || ETAPAS.find((e) => e.estado === 'abierta'));
        abierta = activa ? activa.clave : null;
      }
      pintar();
      pintarLog(d.bitacora || []);
    }

    function pintarLog(log) {
      if (!cajaLog || !secLog) return;
      if (!log.length) return;
      secLog.hidden = false;
      cajaLog.innerHTML = log.map((l) => {
        const f = new Date(l.at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
        return '<li><span class="pb-log-f">' + esc(f) + '</span>' +
          '<span class="pb-log-a">' + esc(l.accion) +
          (l.detalle ? ' <span>· ' + esc(l.detalle) + '</span>' : '') + '</span></li>';
      }).join('');
    }

    function pintar() {
      if (!cajaEtapas) return;
      const aprobadas = ETAPAS.filter((e) => e.estado === 'aprobada').length;

      // La cabecera es la única superficie que lo acompaña durante toda la
      // página. Antes decía "0 de 12 aprobadas" — un cero que no se mueve en
      // semanas. Ahora dice dónde va y, si le toca algo, cuánto; y se toca.
      const enCurso = ETAPAS.find((e) => e.estado === 'cambios') || ETAPAS.find((e) => e.estado === 'abierta');
      const defCurso = enCurso ? DEF.find((d) => d.clave === enCurso.clave) : null;
      const faltan = defCurso
        ? defCurso.campos.filter((c) => esperaCliente(hiloDe(enCurso.clave, c.id))).length
        : 0;
      if (avance) {
        const corto = window.matchMedia('(max-width: 720px)').matches;
        if (!FIRMADO) avance.textContent = 'Sin firmar';
        else if (defCurso) {
          avance.textContent = corto
            ? 'Etapa ' + enCurso.orden + '/' + ETAPAS.length
            : 'Etapa ' + enCurso.orden + ' de ' + ETAPAS.length;
          avance.setAttribute('data-p', faltan ? String(faltan) : '');
        } else if (aprobadas === ETAPAS.length) avance.textContent = 'Brief completo';
        else avance.textContent = 'En revisión';
        avance.setAttribute('data-a', enCurso ? enCurso.clave : '');
      }
      pintarPuerta(enCurso, defCurso, faltan, aprobadas);

      // Un vistazo antes de la lista: en qué va el brief y, si hay preguntas
      // esperando, cuántas y de qué etapas. Sin esto el cliente tiene que abrir
      // las ocho para saber si le toca algo.
      // Firmado, la puerta de arriba ya cuenta esto — y con botón. Repetirlo
      // aquí era la cuarta vez que el cliente leía lo mismo antes de llegar a
      // la primera pregunta.
      let banner = '';
      const conPuerta = FIRMADO && !!document.getElementById('pb-puerta');
      const conPreg = ETAPAS.map((f) => {
        const def = DEF.find((d) => d.clave === f.clave);
        if (!def) return null;
        const n = def.campos.filter((c) => esperaCliente(hiloDe(f.clave, c.id))).length;
        return n ? { titulo: def.titulo, clave: f.clave, n } : null;
      }).filter(Boolean);
      const totalPreg = conPreg.reduce((a, x) => a + x.n, 0);
      const enTurno = ETAPAS.find((e) => e.estado === 'abierta' || e.estado === 'cambios');
      const defTurno = enTurno ? DEF.find((d) => d.clave === enTurno.clave) : null;

      if (conPuerta) {
        banner = '';
      } else if (!FIRMADO) {
        // Sin firma todas las etapas están bloqueadas, y el caso "no hay nada
        // que hacer" se leía como "estamos revisando lo que mandaste" — un
        // mensaje sobre algo que el cliente todavía no manda.
        banner = '<div class="pb-aviso-global">' +
          '<strong>Empieza firmando el brief</strong>' +
          '<span>Con la firma se abre la primera etapa. Son ' + ETAPAS.length +
          ', y solo se contesta una a la vez. <a href="#firma" data-firma>Ir a la firma</a></span></div>';
      } else if (totalPreg) {
        banner = '<div class="pb-aviso-global" data-tono="preguntas">' +
          '<strong>' + (totalPreg === 1 ? 'Hay una pregunta esperándote' : 'Hay ' + totalPreg + ' preguntas esperándote') + '</strong>' +
          '<span>' + conPreg.map((x) => '<a href="#" data-ver="' + x.clave + '">' + esc(x.titulo) + ' (' + x.n + ')</a>').join(' · ') + '</span>' +
          '</div>';
      } else if (defTurno) {
        const f = ETAPAS.find((e) => e.clave === defTurno.clave);
        const n = contar(defTurno, borrador[defTurno.clave] || {});
        banner = '<div class="pb-aviso-global">' +
          '<strong>Te toca: ' + esc(defTurno.titulo) + '</strong>' +
          '<span>' + n.hechas + ' de ' + n.total + ' contestadas' +
          (n.faltanReq ? ' · faltan ' + n.faltanReq + ' obligatorias para poder enviarla' : ' · ya puedes enviarla') +
          '</span></div>';
      } else if (aprobadas === ETAPAS.length) {
        banner = '<div class="pb-aviso-global" data-tono="listo">' +
          '<strong>El brief está completo</strong><span>Las ocho etapas quedaron aprobadas. Nos ponemos en contacto para arrancar.</span></div>';
      } else {
        banner = '<div class="pb-aviso-global" data-tono="espera">' +
          '<strong>Estamos revisando lo que mandaste</strong>' +
          '<span>Te avisamos por correo en cuanto quede aprobada o si nos falta algo.</span></div>';
      }

      cajaEtapas.innerHTML = (banner || '') + ETAPAS.map((fila) => {
        const def = DEF.find((d) => d.clave === fila.clave);
        if (!def) return '';
        // Una etapa bloqueada también se abre: se puede LEER lo que va a
        // pedir, aunque no se pueda contestar. Saber lo que viene deja preparar
        // el material con tiempo, que es la mitad del problema de un brief.
        const desplegada = abierta === fila.clave;
        return '<article class="pb-et" data-estado="' + fila.estado + '" data-clave="' + fila.clave + '"' +
          (desplegada ? ' data-abierta' : '') + '>' +
          '<button type="button" class="pb-et-cab" data-toggle="' + fila.clave + '">' +
            '<span class="pb-et-n">' + (fila.estado === 'aprobada' ? '✓' : def.orden) + '</span>' +
            '<span class="pb-et-tit"><strong>' + esc(def.titulo) + '</strong>' +
            '<span>' + esc(def.entrega) + '</span></span>' +
            '<span class="pb-chip" data-e="' + fila.estado + '">' + CHIP[fila.estado] + '</span>' +
            '<span class="pb-chev" aria-hidden="true"></span>' +
          '</button>' +
          (desplegada ? cuerpo(def, fila) : '') +
        '</article>';
      }).join('');

      cajaEtapas.querySelectorAll('[data-toggle]').forEach((b) => {
        b.addEventListener('click', () => {
          const c = b.getAttribute('data-toggle');
          if (!ETAPAS.some((e) => e.clave === c)) return;
          abierta = abierta === c ? null : c;
          pintar();
        });
      });
    }

    /**
     * Lo que le toca, arriba de todo y sin scroll.
     *
     * El documento mide ocho pantallas. Sin esto, cada visita nueva obligaba a
     * recorrer la portada, el alcance, quién hace qué y la firma antes de
     * llegar a la primera pregunta — tres pantallas de peaje, cada vez.
     */
    function pintarPuerta(enCurso, defCurso, faltan, aprobadas) {
      const caja = document.getElementById('pb-puerta');
      if (!caja) return;
      if (!enCurso) {
        if (aprobadas === ETAPAS.length) {
          caja.hidden = false;
          caja.innerHTML = '<div class="pb-puerta-t">El brief está completo</div>' +
            '<p>Las ' + ETAPAS.length + ' etapas quedaron aprobadas. Nos ponemos en contacto para arrancar.</p>';
        } else {
          caja.hidden = false;
          caja.innerHTML = '<div class="pb-puerta-t">Estamos revisando lo que mandaste</div>' +
            '<p>Te avisamos por correo en cuanto quede aprobada o si nos falta algo. No hay nada que hacer por ahora.</p>';
        }
        return;
      }
      const n = contar(defCurso, borrador[enCurso.clave] || {});
      const pct = Math.round((n.hechas / n.total) * 100);
      caja.hidden = false;
      caja.innerHTML =
        '<div class="pb-puerta-t">' +
          (faltan
            ? (faltan === 1 ? 'Sacs te dejó una pregunta' : 'Sacs te dejó ' + faltan + ' preguntas')
            : 'Te toca contestar') +
        '</div>' +
        '<p><b>Etapa ' + enCurso.orden + ' · ' + esc(defCurso.titulo) + '</b></p>' +
        '<div class="pb-puerta-riel"><span style="width:' + pct + '%"></span></div>' +
        '<p class="pb-puerta-n">' + n.hechas + ' de ' + n.total + ' preguntas contestadas' +
          (n.faltanReq ? ' · ' + n.faltanReq + ' obligatorias sin contestar' : '') + '</p>' +
        '<button type="button" class="pb-btn pb-puerta-btn" data-ver="' + enCurso.clave + '">Continuar ahí</button>';
    }

    const vacioCliente = (v) =>
      v === undefined || v === null || v === '' || (Array.isArray(v) && !v.length);

    const editable = (f) => f.estado === 'abierta' || f.estado === 'cambios';

    const hiloDe = (clave, campo) =>
      HILOS.find((h) => h.etapa_clave === clave && h.campo_id === campo) || null;

    /** Un hilo está esperando al CLIENTE si sigue abierto y hablamos nosotros al final. */
    const esperaCliente = (h) =>
      !!h && h.estado === 'abierto' && h.mensajes.length > 0 &&
      h.mensajes[h.mensajes.length - 1].de === 'sacs';

    const cuando = (iso) => {
      const d = new Date(iso);
      const min = Math.round((Date.now() - d.getTime()) / 60000);
      if (min < 60) return 'hace ' + Math.max(1, min) + ' min';
      if (min < 1440) return 'hace ' + Math.round(min / 60) + ' h';
      return d.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
    };

    /**
     * El hilo debajo de una pregunta. `responder` decide si se pinta la caja
     * para contestar — solo cuando la etapa es del cliente y el hilo lo espera.
     */
    function hilo(clave, campoId, responder) {
      const h = hiloDe(clave, campoId);
      if (!h || !h.mensajes.length) return '';
      const espera = esperaCliente(h);
      let out = '<div class="pb-hilo' + (espera ? ' pb-hilo-espera' : '') + '" data-hilo="' + campoId + '">';
      for (const m of h.mensajes) {
        out += '<div class="pb-msg" data-de="' + m.de + '">' +
          '<span class="pb-msg-de">' + (m.de === 'sacs' ? 'Sacs' : 'Ustedes') +
          ' · ' + cuando(m.at) + '</span>' +
          '<p>' + esc(m.texto).replace(/\n/g, '<br>') + '</p></div>';
      }
      if (espera && responder) {
        out += '<div class="pb-hilo-caja">' +
          '<textarea data-resp="' + campoId + '" placeholder="Contesta aquí"></textarea>' +
          '<button type="button" class="pb-btn-chico" data-enviaresp="' + campoId + '">Contestar</button>' +
          '</div>';
      } else if (h.estado === 'resuelto') {
        out += '<div class="pb-hilo-ok">Cerrado</div>';
      }
      return out + '</div>';
    }

    /**
     * Lo que va a pedir una etapa que todavía no se abre. Se enseñan las
     * preguntas —agrupadas y con su ayuda— pero sin un solo campo que se pueda
     * llenar: la regla de "una a la vez" no se toca, y aun así el cliente
     * puede ir juntando el material de las siguientes.
     */
    function vistaPrevia(def, fila) {
      // El motivo tiene que ser el REAL. Decir "se abre cuando firmes" a alguien
      // que ya firmó, o nombrar una etapa que ya está aprobada, se lee como
      // "no me registraron la firma" — y eso termina en una llamada.
      const trabando = ETAPAS
        .filter((e) => e.orden < fila.orden && e.estado !== 'aprobada')
        .sort((a, b) => a.orden - b.orden)[0];
      const defTrabando = trabando ? DEF.find((d) => d.clave === trabando.clave) : null;
      let motivo;
      if (!FIRMADO) motivo = 'Se abre en cuanto firmes el brief.';
      else if (defTrabando) {
        motivo = 'Se abre en cuanto quede aprobada la etapa ' + trabando.orden +
          ', <b>' + esc(defTrabando.titulo) + '</b>.';
      } else motivo = 'Se abre en cuanto terminemos la etapa anterior.';

      let h = '<div class="pb-previa-nota">' +
        '<span class="pb-campo-t">Todavía no se puede contestar</span>' +
        '<p>' + motivo + ' Mientras tanto, esto es lo que va a pedir — sirve para ir juntando el material.</p></div>';
      h += '<div class="pb-et-entrega"><b>Al aprobarse:</b> ' + esc(def.entrega) + '</div>';
      h += '<ul class="pb-previa">';
      for (const [titulo, campos] of porGrupo(def)) {
        if (titulo) h += '<li class="pb-previa-g">' + esc(titulo) + '</li>';
        for (const c of campos) {
          h += '<li><b>' + esc(c.etiqueta) +
            (c.requerido ? ' <span class="pb-campo-req">obligatorio</span>' : '') + '</b>' +
            (c.tipo === 'archivos' ? '<em>archivos</em>' : '') +
            (c.ayuda ? '<span>' + esc(c.ayuda) + '</span>' : '') +
            (c.enlace ? '<a class="pb-visitar" href="' + esc(c.enlace.url) + '" target="_blank" rel="noopener noreferrer">Abrir ' + esc(c.enlace.texto) + '<span aria-hidden="true">↗</span></a>' : '') +
            '</li>';
        }
      }
      return h + '</ul>';
    }

    /** Bloques de la etapa, en el orden en que aparece cada uno por primera vez. */
    function porGrupo(def) {
      const m = new Map();
      for (const c of def.campos) {
        const g = c.grupo || '';
        if (!m.has(g)) m.set(g, []);
        m.get(g).push(c);
      }
      return [...m.entries()];
    }

    function cuerpo(def, fila) {
      const puede = editable(fila);
      let h = '<div class="pb-et-cuerpo">';
      h += '<p class="pb-et-intro">' + esc(def.resumen) + '</p>';

      if (fila.estado === 'bloqueada') return h + vistaPrevia(def, fila) + '</div>';
      h += '<div class="pb-et-entrega"><b>Al aprobarse:</b> ' + esc(def.entrega) + '</div>';
      if (puede) {
        h += barra(def, borrador[fila.clave] || {}, fila.clave);
        h += '<div class="pb-autoguarda">No hay botón de guardar. Lo que escribas se guarda solo — ' +
          'puedes cerrar y volver cuando quieras.</div>';
      }

      // Lo que falta contestar, arriba y en una lista: el cliente no debería
      // tener que recorrer 16 preguntas buscando cuál tiene un comentario.
      const pend = def.campos.filter((c) => esperaCliente(hiloDe(fila.clave, c.id)));
      if (pend.length) {
        h += '<div class="pb-pendientes"><span class="pb-campo-t">' +
          (pend.length === 1 ? 'Sacs te dejó una pregunta' : 'Sacs te dejó ' + pend.length + ' preguntas') +
          '</span><ol>';
        // Filas tocables de verdad, no texto negro plano. Y sin el recorte de
        // la pregunta de Sacs: truncada a 130 caracteres se leía como texto
        // muerto, y el texto completo ya está abajo, en su hilo.
        for (const c of pend) {
          h += '<li><a href="#" data-ir="' + c.id + '">' +
            '<span class="pb-pend-t">' + esc(c.etiqueta) + '</span>' +
            '<span class="pb-pend-c" aria-hidden="true"></span></a></li>';
        }
        h += '</ol></div>';
      }
      if (fila.estado === 'cambios' && fila.nota_sacs) {
        h += '<div class="pb-nota-sacs"><span class="pb-campo-t">De parte de Sacs</span><p>' + esc(fila.nota_sacs) + '</p></div>';
      }

      if (!puede) {
        // Etapa enviada o aprobada: se lee, no se edita. Para Sacs, además,
        // cada respuesta trae su caja para comentar o repreguntar.
        const revisando = SACS && fila.estado === 'enviada';
        h += '<dl class="pb-resumen">';
        for (const c of def.campos) {
          const v = (fila.respuestas || {})[c.id];
          const vacia = v === undefined || v === null || (Array.isArray(v) && !v.length) || v === '';
          if (vacia && !revisando) { h += hilo(fila.clave, c.id, false); continue; }
          h += '<div class="pb-res" data-campo="' + c.id + '"><dt>' + esc(c.etiqueta) + '</dt>' +
            '<dd>' + (vacia ? '<i class="pb-vacio">Sin contestar</i>' : esc(leible(c, v))) + '</dd>';
          h += hilo(fila.clave, c.id, false);
          if (revisando) {
            h += '<div class="pb-nota-campo">' +
              '<textarea data-nota-campo="' + c.id + '" placeholder="Comentario o pregunta sobre esta respuesta"></textarea>' +
              '<label class="pb-esq"><input type="checkbox" data-es-preg="' + c.id + '" />' +
              '<span>Es una pregunta que deben contestar</span></label>' +
              '</div>';
          }
          h += '</div>';
        }
        h += '</dl>';
        if (revisando) {
          h += '<div class="pb-rev"><span class="pb-campo-t">Cierre de la revisión</span>' +
            '<textarea data-cierre="' + fila.clave + '" placeholder="Un párrafo para ellos (opcional)"></textarea>' +
            '<div class="pb-rev-acc">' +
            '<button type="button" class="pb-btn pb-btn-verde" data-responder="' + fila.clave + '">Mandar la revisión</button>' +
            '<span class="pb-et-pie-nota">Si dejas al menos una pregunta, la etapa regresa a ellos. Si no dejas ninguna, se aprueba y se abre la siguiente.</span>' +
            '</div><div class="pb-error" data-reverr="' + fila.clave + '" hidden></div></div>';
        }
        if (fila.estado === 'enviada' && !SACS) {
          h += '<div class="pb-et-pie"><span class="pb-et-pie-nota">Enviada. La estamos revisando — te avisamos por correo en cuanto quede aprobada o si nos falta algo.</span></div>';
        }
        if (SACS && fila.estado === 'aprobada') h += revision(fila);
        return h + '</div>';
      }

      // Los campos se pintan POR BLOQUE, no en el orden del archivo. Si se
      // recorriera el arreglo y solo se emitiera un encabezado al cambiar de
      // grupo, un campo fuera de lugar repetiría el encabezado más abajo —
      // ya pasó. Agrupando primero, el orden del archivo deja de importar.
      for (const [titulo, campos] of porGrupo(def)) {
        if (titulo) h += '<div class="pb-grupo"><span>' + esc(titulo) + '</span></div>';
        for (const c of campos) h += campo(c, borrador[fila.clave] || {}, fila.clave);
      }

      const nf = contar(def, borrador[fila.clave] || {});
      const pregAbiertas = def.campos.filter((c) => esperaCliente(hiloDe(fila.clave, c.id))).length;
      let nota, rotulo;
      if (pregAbiertas) {
        nota = 'Contesta primero lo que preguntó Sacs. Si la envías así, va a regresar igual.';
        rotulo = pregAbiertas === 1
          ? 'Ir a la pregunta de Sacs'
          : 'Ir a las ' + pregAbiertas + ' preguntas de Sacs';
      } else if (nf.faltanReq) {
        nota = 'Faltan ' + nf.faltanReq + ' obligatorias para poder enviarla.';
        rotulo = 'Faltan ' + nf.faltanReq + ' obligatorias';
      } else {
        nota = 'Al enviarla la revisamos y te contestamos por correo.';
        rotulo = 'Ya terminé esta etapa';
      }
      h += '<div class="pb-et-pie">' +
        '<span class="pb-et-pie-nota">' + nota + '</span>' +
        '<button type="button" class="pb-btn" data-enviar="' + fila.clave + '">' + rotulo + '</button>' +
      '</div>';
      h += '<div class="pb-error" data-err="' + fila.clave + '" hidden></div>';
      if (SACS) h += revision(fila);
      return h + '</div>';
    }

    // Controles de Sacs. Solo se pintan cuando la sesión es founder/cs; el
    // servidor los vuelve a exigir, así que esconderlos no es la seguridad,
    // es la interfaz.
    function revision(fila) {
      let h = '<div class="pb-rev"><span class="pb-campo-t">Revisión de Sacs</span>';
      if (fila.estado === 'enviada') {
        h += '<textarea data-nota="' + fila.clave + '" placeholder="Qué falta o qué hay que corregir (obligatorio si la devuelves)"></textarea>' +
          '<div class="pb-rev-acc">' +
            '<button type="button" class="pb-btn pb-btn-verde" data-rev="aprobar" data-c="' + fila.clave + '">Aprobar y abrir la siguiente</button>' +
            '<button type="button" class="pb-btn-tenue" data-rev="cambios" data-c="' + fila.clave + '">Devolver con cambios</button>' +
          '</div>';
      } else if (fila.estado === 'aprobada') {
        h += '<div class="pb-et-pie-nota" style="margin-bottom:10px">Aprobada' +
          (fila.aprobada_at ? ' el ' + new Date(fila.aprobada_at).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }) : '') + '.</div>' +
          '<div class="pb-rev-acc"><button type="button" class="pb-btn-tenue" data-rev="reabrir" data-c="' + fila.clave + '">Reabrir para que la corrijan</button></div>';
      } else {
        h += '<div class="pb-et-pie-nota">El cliente todavía no la envía.</div>';
      }
      return h + '<div class="pb-error" data-reverr="' + fila.clave + '" hidden></div></div>';
    }

    // Cuántas preguntas llevan contestadas y cuántas faltan de las
    // obligatorias. Se recalcula en cada repintado, sin pedirle nada al servidor.
    function contar(def, resp) {
      const lleno = (v) => !(v === undefined || v === null || v === '' ||
        (Array.isArray(v) && !v.length) ||
        (Array.isArray(v) && v.every((x) => x && typeof x === 'object' && !x.url && !x.nombre)));
      const total = def.campos.length;
      const hechas = def.campos.filter((c) => lleno(resp[c.id])).length;
      const faltanReq = def.campos.filter((c) => c.requerido && !lleno(resp[c.id])).length;
      return { total, hechas, faltanReq };
    }

    function barra(def, resp, clave) {
      const n = contar(def, resp);
      const pct = Math.round((n.hechas / n.total) * 100);
      const preg = clave
        ? def.campos.filter((c) => esperaCliente(hiloDe(clave, c.id))).length
        : 0;
      let cola;
      if (preg) {
        cola = ' · contesta ' + (preg === 1 ? 'la pregunta de Sacs' : 'las ' + preg + ' preguntas de Sacs');
      } else if (n.faltanReq) {
        cola = ' · faltan <b>' + n.faltanReq + '</b> obligatoria' + (n.faltanReq === 1 ? '' : 's');
      } else {
        cola = ' · ya puedes enviarla';
      }
      return '<div class="pb-avance">' +
        '<div class="pb-avance-riel"><span style="width:' + pct + '%"></span></div>' +
        '<span class="pb-avance-txt">' + n.hechas + ' de ' + n.total + ' contestadas' + cola +
        '</span></div>';
    }

    function leible(c, v) {
      if (Array.isArray(v)) {
        if (v.length && typeof v[0] === 'object') {
          return v.map((x) => x.url ? (x.url + (x.nota ? ' — ' + x.nota : '')) : (x.nombre || '')).join('\n');
        }
        return v.join(' · ');
      }
      if (c.tipo === 'escala') return v + ' de 5';
      return String(v);
    }

    function campo(c, resp, clave) {
      const v = resp[c.id];
      const esperando = clave ? esperaCliente(hiloDe(clave, c.id)) : false;
      let h = '<div class="pb-campo" data-campo="' + c.id + '"' +
        (esperando ? ' data-espera' : '') + '>';
      h += '<div class="pb-campo-lab">' + esc(c.etiqueta) +
        (c.requerido ? '<span class="pb-campo-req">obligatorio</span>' : '') + '</div>';
      if (c.ayuda) h += '<div class="pb-campo-ayuda">' + esc(c.ayuda) + '</div>';
      if (c.enlace) {
        h += '<a class="pb-visitar" href="' + esc(c.enlace.url) + '" target="_blank" rel="noopener noreferrer">' +
          'Abrir ' + esc(c.enlace.texto) + '<span aria-hidden="true">↗</span></a>';
      }

      // Con una pregunta de Sacs abierta, lo que ya contestó se LEE, y la caja
      // para cambiarlo queda detrás de un botón. Así solo hay una caja viva.
      if (esperando) {
        const yaHay = !vacioCliente(v);
        h += '<div class="pb-ya">' +
          '<span class="pb-ya-t">Tu respuesta</span>' +
          '<span class="pb-ya-por">Sacs preguntó algo sobre esta respuesta. Contéstale abajo, en el recuadro amarillo.</span>' +
          '<p>' + (yaHay ? esc(leible(c, v)).replace(/\n/g, '<br>') : '<i class="pb-vacio">Sin contestar</i>') + '</p>' +
          '<button type="button" class="pb-editar" data-editar="' + c.id + '">Editar mi respuesta</button>' +
          '</div><div class="pb-oculto" data-campo-edit="' + c.id + '">';
      }

      if (c.tipo === 'texto') {
        h += '<input type="text" data-v="' + c.id + '" value="' + esc(v || '') + '"' +
          (c.placeholder ? ' placeholder="' + esc(c.placeholder) + '"' : '') + ' />';

      } else if (c.tipo === 'parrafo') {
        h += '<textarea data-v="' + c.id + '"' + (c.placeholder ? ' placeholder="' + esc(c.placeholder) + '"' : '') +
          '>' + esc(v || '') + '</textarea>';

      } else if (c.tipo === 'opcion' || c.tipo === 'multiple') {
        const multi = c.tipo === 'multiple';
        const sel = multi ? (Array.isArray(v) ? v : []) : [v];
        h += '<div class="pb-ops">';
        for (const o of (c.opciones || [])) {
          const marcado = sel.indexOf(o) >= 0 ? ' checked' : '';
          h += '<label class="pb-op"><input type="' + (multi ? 'checkbox' : 'radio') + '" name="' + c.id +
            '" data-op="' + c.id + '" value="' + esc(o) + '"' + marcado + ' /><span>' + esc(o) + '</span></label>';
        }
        h += '</div>';
        if (c.otro) {
          const otro = multi ? (sel.filter((s) => (c.opciones || []).indexOf(s) < 0)[0] || '') : '';
          h += '<input type="text" class="pb-otro" data-otro="' + c.id + '" placeholder="Otro (escríbelo)" value="' + esc(otro) + '" style="margin-top:10px" />';
        }

      } else if (c.tipo === 'escala') {
        h += '<div class="pb-escala"><span class="pb-escala-ext">' + esc((c.extremos || [])[0] || '') + '</span><div class="pb-escala-pts">';
        for (let i = 1; i <= 5; i++) {
          h += '<button type="button" class="pb-escala-pt" data-esc="' + c.id + '" data-n="' + i +
            '" aria-pressed="' + (Number(v) === i) + '">' + i + '</button>';
        }
        h += '</div><span class="pb-escala-ext">' + esc((c.extremos || [])[1] || '') + '</span></div>';

      } else if (c.tipo === 'links') {
        const filas = Array.isArray(v) && v.length ? v : [{ url: '', nota: '' }];
        h += '<div class="pb-links" data-links="' + c.id + '">';
        for (const f of filas) h += filaLink(c.id, f, c.notaPh);
        h += '</div><button type="button" class="pb-agregar" data-mas="' + c.id + '">+ Agregar otro</button>';

      } else if (c.tipo === 'archivos') {
        const arr = Array.isArray(v) ? v : [];
        // En un teléfono "arrástralos aquí" no significa nada, y el recuadro
        // punteado se lee decorativo: lo único que parecía tocable era el texto
        // azul. Aquí el botón ES el objetivo, y nombra la cámara, que es el
        // camino real para una foto antigua.
        const enTelefono = window.matchMedia('(max-width: 720px)').matches;
        h += '<div class="pb-zona" data-zona="' + c.id + '">' +
          '<span class="pb-zona-btn">' +
            (enTelefono ? 'Tomar foto o elegir archivo' : 'Elige tus archivos') +
          '</span>' +
          '<div class="pb-zona-s">' +
            (enTelefono
              ? 'Varios a la vez, hasta 25 MB cada uno.'
              : 'Arrástralos aquí o elígelos. Varios a la vez, hasta 25 MB cada uno.') +
          '</div></div>' +
          '<input type="file" multiple hidden data-file="' + c.id + '" />' +
          '<div class="pb-pegalink">' +
            '<span>¿Pesa más de 25 MB? Súbelo a Drive o WeTransfer y pega el link:</span>' +
            '<div class="pb-pegalink-fila">' +
              '<input type="url" data-linkext="' + c.id + '" placeholder="https://drive.google.com/…" />' +
              '<button type="button" class="pb-btn-tenue pb-add" data-addlink="' + c.id + '">Agregar</button>' +
            '</div>' +
          '</div>' +
          '<div class="pb-archivos" data-lista="' + c.id + '">' + arr.map(chipArchivo).join('') + '</div>';
      }

      // El sello va pegado a SU campo. Puesto después del hilo quedaba debajo
      // del botón "Contestar", y ahí decían cosas opuestas: una caja que exige
      // apretar un botón y una línea que promete que se guarda solo.
      if (clave && c.tipo !== 'archivos') {
        h += '<div class="pb-sello" data-sello="' + c.id + '" hidden></div>';
      }
      if (esperando) h += '</div>';
      if (clave) h += hilo(clave, c.id, true);
      return h + '</div>';
    }

    const filaLink = (id, f, ph) =>
      '<div class="pb-link-fila" data-ph="' + esc(ph || '¿Qué exactamente te gustó?') + '">' +
        '<input type="url" data-lu="' + id + '" placeholder="https://…" value="' + esc(f.url || '') + '" />' +
        '<input type="text" data-ln="' + id + '" placeholder="' + esc(ph || '¿Qué exactamente te gustó?') + '" value="' + esc(f.nota || '') + '" />' +
        '<button type="button" class="pb-quitar" data-menos="' + id + '" aria-label="Quitar">×</button>' +
      '</div>';

    const chipArchivo = (a) =>
      '<div class="pb-arch">' +
        '<span class="pb-arch-ext">' +
          (a.externo ? 'LINK' : esc((a.nombre || '').split('.').pop().slice(0, 5).toUpperCase() || 'FILE')) +
        '</span>' +
        '<span class="pb-arch-n">' + esc(a.nombre) + '</span>' +
        '<span class="pb-arch-p">' + (a.peso ? kb(a.peso) : '') + '</span>' +
        '<a href="' + esc(a.url) + '" target="_blank" rel="noopener">Ver</a>' +
        '<button type="button" class="pb-quitar" data-quita-arch="' + esc(a.url) + '" aria-label="Quitar">×</button>' +
      '</div>';

    // ── Escritura ──────────────────────────────────────────────────────
    let pendiente = null;
    let ultimoCampo = null;
    function anotar(clave, id, valor) {
      borrador[clave] = borrador[clave] || {};
      borrador[clave][id] = valor;
      ultimoCampo = id;
      sello(id, 'Escribiendo…', 'escribiendo');
      refrescarBarra(clave);
      clearTimeout(pendiente);
      pendiente = setTimeout(() => guardar(clave), 900);
    }

    function sello(id, texto, estado) {
      const el = cajaEtapas?.querySelector('[data-sello="' + id + '"]');
      if (!el) return;
      el.hidden = false;
      el.textContent = texto;
      el.setAttribute('data-e', estado);
    }

    // Repintar la etapa entera en cada tecla perdería el foco del campo. Solo
    // se actualiza la barra.
    function refrescarBarra(clave) {
      const et = cajaEtapas?.querySelector('.pb-et[data-clave="' + clave + '"]');
      const caja = et?.querySelector('.pb-avance');
      const def = DEF.find((d) => d.clave === clave);
      if (!caja || !def) return;
      caja.outerHTML = barra(def, borrador[clave] || {}, clave);
    }

    async function guardar(clave, enviar) {
      const res = await fetch('/api/proyecto/guardar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: TOKEN, clave, respuestas: borrador[clave] || {}, enviar: !!enviar }),
      });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (ultimoCampo) sello(ultimoCampo, 'No se pudo guardar — revisa tu conexión', 'error');
        return d;
      }
      if (!enviar) {
        decirGuardado();
        const hora = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        if (ultimoCampo) sello(ultimoCampo, 'Guardado · ' + hora, 'ok');
      }
      return null;
    }

    // Un solo juego de escuchas, DELEGADO en el contenedor y colgado una vez.
    //
    // Antes se re-colgaban escuchas sobre todos los elementos cada vez que se
    // repintaba algo (conectar()), y el botón "+ Agregar otro" terminaba con
    // dos, tres, cuatro escuchas encima: un clic agregaba cuatro filas. Con
    // delegación el HTML nuevo funciona solo y no hay nada que volver a colgar.
    function delegar() {
      const cont = cajaEtapas;
      if (!cont) return;
      const claveDe = (el) => el.closest('.pb-et')?.getAttribute('data-clave');
      const campoDe = (el) => el.closest('.pb-campo')?.getAttribute('data-campo');

      const leerOpciones = (id) => {
        const c = cont.querySelector('.pb-campo[data-campo="' + id + '"]');
        const marcados = Array.from(c.querySelectorAll('[data-op]:checked')).map((x) => x.value);
        const otro = c.querySelector('[data-otro]');
        if (otro && otro.value.trim()) marcados.push(otro.value.trim());
        return marcados;
      };
      const leerLinks = (id) => {
        const caja = cont.querySelector('[data-links="' + id + '"]');
        return Array.from(caja.querySelectorAll('.pb-link-fila')).map((f) => ({
          url: f.querySelector('[data-lu]').value.trim(),
          nota: f.querySelector('[data-ln]').value.trim(),
        })).filter((x) => x.url);
      };

      // El teclado del teléfono tapa la mitad de abajo. Al enfocar una caja se
      // la trae al tercio superior para que ella Y su botón queden a la vista.
      cont.addEventListener('focusin', (e) => {
        const el = e.target;
        if (!el.matches('textarea, input[type=text], input[type=email], input[type=url]')) return;
        if (!window.matchMedia('(max-width: 720px)').matches) return;
        setTimeout(() => {
          const r = el.getBoundingClientRect();
          if (r.top > window.innerHeight * 0.42) {
            window.scrollBy({ top: r.top - window.innerHeight * 0.28, behavior: 'smooth' });
          }
        }, 260);
      });

      cont.addEventListener('input', (e) => {
        const el = e.target;
        if (el.matches('[data-v]')) return anotar(claveDe(el), el.getAttribute('data-v'), el.value);
        if (el.matches('[data-otro]')) {
          const id = el.getAttribute('data-otro');
          return anotar(claveDe(el), id, leerOpciones(id));
        }
        if (el.matches('[data-lu],[data-ln]')) {
          const id = el.getAttribute('data-lu') || el.getAttribute('data-ln');
          return anotar(claveDe(el), id, leerLinks(id));
        }
      });

      cont.addEventListener('change', (e) => {
        const el = e.target;
        if (el.matches('[data-op]')) {
          const id = el.getAttribute('data-op');
          return anotar(claveDe(el), id, el.type === 'radio' ? el.value : leerOpciones(id));
        }
        if (el.matches('[data-file]')) {
          return subir(claveDe(el), el.getAttribute('data-file'), el.files);
        }
      });

      cont.addEventListener('click', (e) => {
        const el = e.target.closest('[data-esc],[data-mas],[data-menos],[data-zona],[data-quita-arch],[data-enviar],[data-rev],[data-enviaresp],[data-ir],[data-responder],[data-ver],[data-editar],[data-addlink]');
        if (!el || !cont.contains(el)) return;
        const clave = claveDe(el);

        if (el.hasAttribute('data-esc')) {
          const id = el.getAttribute('data-esc');
          const c = cont.querySelector('.pb-campo[data-campo="' + id + '"]');
          c.querySelectorAll('[data-esc]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
          el.setAttribute('aria-pressed', 'true');
          return anotar(clave, id, Number(el.getAttribute('data-n')));
        }

        if (el.hasAttribute('data-mas')) {
          const id = el.getAttribute('data-mas');
          const caja = cont.querySelector('[data-links="' + id + '"]');
          const ph = caja.querySelector('.pb-link-fila')?.getAttribute('data-ph');
          caja.insertAdjacentHTML('beforeend', filaLink(id, {}, ph));
          return;
        }

        if (el.hasAttribute('data-menos')) {
          const id = el.getAttribute('data-menos');
          const caja = cont.querySelector('[data-links="' + id + '"]');
          if (caja.querySelectorAll('.pb-link-fila').length > 1) el.closest('.pb-link-fila').remove();
          else caja.querySelectorAll('input').forEach((i) => { i.value = ''; });
          return anotar(clave, id, leerLinks(id));
        }

        if (el.hasAttribute('data-addlink')) {
          const id = el.getAttribute('data-addlink');
          const inp = cont.querySelector('[data-linkext="' + id + '"]');
          const url = (inp?.value || '').trim();
          if (!/^https?:\/\/.+/.test(url)) { inp?.focus(); return; }
          borrador[clave] = borrador[clave] || {};
          const arr = (borrador[clave][id] || []).concat([{ url, nombre: url.replace(/^https?:\/\//, '').slice(0, 60), externo: true }]);
          borrador[clave][id] = arr;
          cont.querySelector('[data-lista="' + id + '"]').innerHTML = arr.map(chipArchivo).join('');
          inp.value = '';
          refrescarBarra(clave);
          return guardar(clave);
        }
        if (el.hasAttribute('data-zona')) {
          return cont.querySelector('[data-file="' + el.getAttribute('data-zona') + '"]')?.click();
        }

        if (el.hasAttribute('data-quita-arch')) {
          const url = el.getAttribute('data-quita-arch');
          const id = campoDe(el);
          const arr = (borrador[clave][id] || []).filter((a) => a.url !== url);
          borrador[clave][id] = arr;
          cont.querySelector('[data-lista="' + id + '"]').innerHTML = arr.map(chipArchivo).join('');
          refrescarBarra(clave);
          return guardar(clave);
        }

        if (el.hasAttribute('data-editar')) {
          const id = el.getAttribute('data-editar');
          cont.querySelector('[data-campo-edit="' + id + '"]')?.removeAttribute('class');
          el.closest('.pb-ya')?.remove();
          cont.querySelector('.pb-campo[data-campo="' + id + '"] textarea, .pb-campo[data-campo="' + id + '"] input')?.focus();
          return;
        }
        if (el.hasAttribute('data-ver')) {
          e.preventDefault();
          abierta = el.getAttribute('data-ver');
          pintar();
          cajaEtapas.querySelector('.pb-et[data-abierta]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        if (el.hasAttribute('data-ir')) {
          e.preventDefault();
          const destino = cont.querySelector('.pb-campo[data-campo="' + el.getAttribute('data-ir') + '"]');
          destino?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          destino?.querySelector('textarea[data-resp]')?.focus();
          return;
        }
        if (el.hasAttribute('data-enviaresp')) return contestarHilo(el, clave);
        if (el.hasAttribute('data-responder')) return mandarRevision(el);
        if (el.hasAttribute('data-enviar')) return enviarEtapa(el);
        if (el.hasAttribute('data-rev')) return revisarEtapa(el);
      });

      // Arrastrar y soltar sobre la zona del campo.
      const zonaDe = (e) => e.target.closest?.('[data-zona]');
      cont.addEventListener('dragover', (e) => {
        const z = zonaDe(e); if (!z) return;
        e.preventDefault(); z.setAttribute('data-encima', '');
      });
      cont.addEventListener('dragleave', (e) => zonaDe(e)?.removeAttribute('data-encima'));
      cont.addEventListener('drop', (e) => {
        const z = zonaDe(e); if (!z) return;
        e.preventDefault(); z.removeAttribute('data-encima');
        subir(claveDe(z), z.getAttribute('data-zona'), e.dataTransfer.files);
      });
    }

    async function contestarHilo(el, clave) {
      const campo = el.getAttribute('data-enviaresp');
      const caja = cajaEtapas.querySelector('textarea[data-resp="' + campo + '"]');
      const texto = (caja?.value || '').trim();
      if (!texto) { caja?.focus(); return; }
      el.disabled = true;
      el.textContent = 'Enviando…';
      const res = await fetch('/api/proyecto/contestar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: TOKEN, clave, campo, texto }),
      });
      if (!res.ok) {
        el.disabled = false;
        el.textContent = 'Contestar';
        return;
      }
      await cargar();
    }

    async function mandarRevision(el) {
      const clave = el.getAttribute('data-responder');
      const err = cajaEtapas.querySelector('[data-reverr="' + clave + '"]');
      if (err) err.hidden = true;
      const notas = [];
      cajaEtapas.querySelectorAll('[data-nota-campo]').forEach((t) => {
        const texto = (t.value || '').trim();
        if (!texto) return;
        const campo = t.getAttribute('data-nota-campo');
        const chk = cajaEtapas.querySelector('[data-es-preg="' + campo + '"]');
        notas.push({ campo, texto, pregunta: !!(chk && chk.checked) });
      });
      const cierre = cajaEtapas.querySelector('[data-cierre="' + clave + '"]')?.value || '';
      el.disabled = true;
      el.textContent = 'Mandando…';
      const res = await fetch('/api/proyecto/responder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: TOKEN, clave, notas, cierre }),
      });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) {
        el.disabled = false;
        el.textContent = 'Mandar la revisión';
        if (err) { err.textContent = d.error || 'No se pudo mandar'; err.hidden = false; }
        return;
      }
      abierta = d.aprobada ? (d.siguiente || null) : clave;
      await cargar();
    }

    async function enviarEtapa(el) {
      const clave = el.getAttribute('data-enviar');
      const def = DEF.find((d) => d.clave === clave);
      // Con preguntas de Sacs abiertas el botón no manda: lleva a la primera.
      const primera = def?.campos.find((c) => esperaCliente(hiloDe(clave, c.id)));
      if (primera) {
        const destino = cajaEtapas.querySelector('.pb-campo[data-campo="' + primera.id + '"]');
        destino?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => destino?.querySelector('textarea[data-resp]')?.focus(), 500);
        return;
      }
      const err = cajaEtapas.querySelector('[data-err="' + clave + '"]');
      err.hidden = true;
      el.disabled = true;
      el.textContent = 'Enviando…';
      const fallo = await guardar(clave, true);
      if (fallo) {
        el.disabled = false;
        el.textContent = 'Enviar etapa a revisión';
        err.textContent = fallo.faltan
          ? 'Falta contestar: ' + fallo.faltan.join(' · ')
          : (fallo.error || 'No se pudo enviar');
        err.hidden = false;
        err.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      abierta = null;
      await cargar();
    }

    async function revisarEtapa(el) {
      const clave = el.getAttribute('data-c');
      const accion = el.getAttribute('data-rev');
      const err = cajaEtapas.querySelector('[data-reverr="' + clave + '"]');
      const nota = cajaEtapas.querySelector('[data-nota="' + clave + '"]');
      if (err) err.hidden = true;
      el.disabled = true;
      const antes = el.textContent;
      el.textContent = 'Aplicando…';
      const res = await fetch('/api/proyecto/revisar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: TOKEN, clave, accion, nota: nota ? nota.value : '' }),
      });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) {
        el.disabled = false;
        el.textContent = antes;
        if (err) { err.textContent = d.error || 'No se pudo aplicar'; err.hidden = false; }
        return;
      }
      abierta = accion === 'aprobar' ? (d.siguiente || null) : clave;
      await cargar();
    }

    async function subir(clave, campoId, archivos) {
      const lista = cajaEtapas.querySelector('[data-lista="' + campoId + '"]');
      for (const f of Array.from(archivos || [])) {
        const fila = document.createElement('div');
        fila.className = 'pb-arch';
        fila.innerHTML = '<span class="pb-arch-ext">···</span><span class="pb-arch-n">' + esc(f.name) +
          '</span><span class="pb-arch-p">subiendo…</span>';
        lista.appendChild(fila);
        const fd = new FormData();
        fd.append('token', TOKEN);
        fd.append('campo', campoId);
        fd.append('file', f);
        try {
          const res = await fetch('/api/proyecto/subir', { method: 'POST', body: fd });
          const d = await res.json();
          if (!res.ok) throw new Error(d.error || 'No se pudo subir');
          borrador[clave] = borrador[clave] || {};
          borrador[clave][campoId] = (borrador[clave][campoId] || []).concat([d]);
          fila.remove();
          lista.innerHTML = borrador[clave][campoId].map(chipArchivo).join('');
          await guardar(clave);
        } catch (e) {
          fila.querySelector('.pb-arch-p').textContent = e.message || 'error';
          fila.querySelector('.pb-arch-p').style.color = '#C0442F';
        }
      }
    }

    // Secciones plegadas: con el brief firmado ya las leyó, y volver a
    // pasarlas en cada visita es peaje puro.
    document.querySelectorAll('.pb-sec-plegable').forEach((sec) => {
      const cab = sec.querySelector('.pb-sec-h');
      if (!cab || !sec.hasAttribute('data-plegada')) return;
      const alternar = () => {
        if (sec.getAttribute('data-plegada') === '1') sec.setAttribute('data-plegada', '0');
        else sec.setAttribute('data-plegada', '1');
      };
      cab.addEventListener('click', alternar);
      cab.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); alternar(); }
      });
    });

    document.getElementById('pb-puerta')?.addEventListener('click', (e) => {
      const b = e.target.closest('[data-ver]');
      if (!b) return;
      abierta = b.getAttribute('data-ver');
      pintar();
      cajaEtapas?.querySelector('.pb-et[data-abierta]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    avance?.addEventListener('click', () => {
      const c = avance.getAttribute('data-a');
      if (!c) { document.getElementById('firma')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
      abierta = c;
      pintar();
      cajaEtapas?.querySelector('.pb-et[data-abierta]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    delegar();
    cargar();
  }
</script>
