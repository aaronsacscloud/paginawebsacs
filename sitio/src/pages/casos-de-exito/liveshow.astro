---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTO_ID, ENTIDAD_ID } from '../../data/entidad';
import { breadcrumbCaso } from '../../lib/breadcrumb';
import CasoEnlaces from '../../components/CasoEnlaces.astro';

// Cita real, atribuible a una persona real del cliente (no de Sacs): nombre,
// cargo y empresa confirmados en el propio cuerpo de la página. Es el único
// de los 4 casos de éxito que cumple la barra para `Review` — los otros 3
// citan a "Equipo X" (sin nombre de persona) o a alguien de Sacs, no del
// cliente. NUNCA se agrega `aggregateRating`: no existe un número de reseñas
// ni una calificación real detrás de estas páginas.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Live Shows Merchandising: el recuerdo que te llevas del concierto, vendido al ritmo de un estadio lleno con SACS',
  description: 'Desde 2007, Live Shows Merchandising es líder en mercancía oficial de conciertos en América Latina. Así opera 100+ puntos de venta simultáneos —cada uno, una sucursal que no para de vender— con SACS.',
  about: { '@id': PRODUCTO_ID },
  author: { '@id': ENTIDAD_ID },
  review: {
    '@type': 'Review',
    reviewBody: 'En un concierto llegamos a perder el 20% de nuestras ventas en solo dos horas porque el sistema cayó.',
    author: {
      '@type': 'Person',
      name: 'Mariana López',
      jobTitle: 'Directora de Operaciones',
      worksFor: { '@type': 'Organization', name: 'Live Shows Merchandising' },
    },
    itemReviewed: { '@id': PRODUCTO_ID },
  },
};

const structuredData = [articleSchema, breadcrumbCaso('Live Shows Merchandising')];

const eventos = ['Conciertos', 'Festivales', 'Eventos especiales', 'Eventos deportivos', 'Obras de teatro', 'Musicales', 'Eventos culturales', 'Exhibiciones'];
const productos = ['Playeras', 'Chamarras', 'Sudaderas', 'Prendas de corte especial', 'Paliacates', 'Muñequeras', 'Llaveros', 'Pins', 'Posters', 'Tour books', 'Tazas', 'Cilindros'];
const recintos = ['Arenas', 'Estadios', 'Teatros', 'Foros', 'Parques de diversiones', 'Explanadas públicas'];
const paises = ['México', 'Costa Rica', 'Perú', 'Colombia', 'Argentina', 'Chile', 'Brasil', 'Estados Unidos'];
// Las mismas listas, ordenadas para ENSEÑAR algo (dueño, 4-oct-2026: «que sea
// más didáctico»): los recintos cerrados de menor a mayor aforo y los países
// de norte a sur, como se recorre la operación en el mapa.
const escalaRecintos = [
  { n: 'Foros', t: 14 }, { n: 'Teatros', t: 22 }, { n: 'Arenas', t: 32 }, { n: 'Estadios', t: 44 },
];
const aireLibre = ['Parques de diversiones', 'Explanadas públicas'];
const rutaPaises = ['Estados Unidos', 'México', 'Costa Rica', 'Colombia', 'Perú', 'Brasil', 'Chile', 'Argentina'];
---

<BaseLayout
  title="Live Shows Merchandising — Caso de éxito SACS"
  description="Desde 2007, Live Shows Merchandising es líder en mercancía oficial de conciertos en América Latina. Así vende con SACS a ritmo de estadio: 100+ puntos de venta, cada uno una sucursal que no para."
  structuredData={structuredData}
  preloadImage="/videos/ls-estadio-loop-poster.webp"
>

<!-- Hero: el estadio de fondo, el negocio al frente -->
<section class="ls-hero">
  <div class="ls-hero-media" aria-hidden="true">
    <video class="ls-hero-video" autoplay muted loop playsinline preload="metadata" poster="/videos/ls-estadio-loop-poster.webp" width="720" height="1280">
      <source src="/videos/ls-estadio-loop.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="ls-hero-text">
    <a href="/casos-de-exito" class="ls-back">&larr; Todos los casos de éxito</a>
    <span class="ls-tag">Merchandising de espectáculos · desde 2007</span>
    <h1 class="ls-hero-title">Live Shows Merchandising</h1>
    <p class="ls-hero-lead">Nadie sale de un concierto con «una playera». Sale con el recuerdo del artista que lo hizo cantar a todo pulmón. Live Shows lleva diecinueve años haciendo ese recuerdo —y vendiéndolo al ritmo de un estadio lleno, donde todo pasa en segundos.</p>
  </div>
</section>

<!-- Cifras -->
<section class="ls-stats" aria-label="Live Shows en cifras">
  <div class="ls-stats-inner">
    <div class="ls-stat"><span class="ls-stat-num">2007</span><span class="ls-stat-label">operando en el espectáculo</span></div>
    <div class="ls-stat"><span class="ls-stat-num">8</span><span class="ls-stat-label">países con oficina operativa</span></div>
    <div class="ls-stat"><span class="ls-stat-num">100+</span><span class="ls-stat-label">puntos de venta simultáneos</span></div>
    <div class="ls-stat"><span class="ls-stat-num">150K+</span><span class="ls-stat-label">transacciones sin error por temporada</span></div>
  </div>
</section>

<!-- Lo humano: el merch es moda y es memoria -->
<section class="ls-sec">
  <div class="ls-split">
    <div class="ls-split-text">
      <span class="ls-eyebrow">La moda que se vuelve recuerdo</span>
      <h2 class="ls-title">Te pones la playera y vuelves a esa noche.</h2>
      <p>Hay quien hace fila desde la mañana. Quien se viste como su artista, con encajes, botas y moños, solo para estar cerca. Para ellos la mercancía oficial no es un souvenir: es la prenda que se ponen años después y que les regresa la canción, el grito y la gente con la que estaban.</p>
      <p>Por eso Live Shows la trata como lo que es: <strong>moda</strong>. Diseño propio, cortes especiales, tallas, ediciones limitadas por ciudad y por fecha. Una prenda hecha para llevarse puesta el recuerdo de quien te inspira.</p>
    </div>
    <div class="ls-mosaic">
      <img src="/images/ls-fans-sacrifice.webp" alt="Fans vestidas como su artista posan en la tienda de The Sacrifice Tour" width="1200" height="900" loading="lazy" class="ls-mosaic-a" />
      <img src="/images/ls-fila-fans.webp" alt="Fila de fans afuera del estadio antes del concierto" width="899" height="677" loading="lazy" class="ls-mosaic-b" />
    </div>
  </div>
  <p class="ls-bigquote">«Nadie se lleva una playera.<br />Se lleva la noche.»</p>
</section>

<!-- El negocio: quién es Live Shows -->
<section class="ls-sec ls-sec--alt">
  <div class="ls-inner">
    <span class="ls-eyebrow">El negocio</span>
    <h2 class="ls-title">Los líderes del merch oficial en América Latina.</h2>
    <p class="ls-lead">Live Shows Merchandising empezó en 2007 y hoy fabrica y vende la mercancía de licencias internacionales y nacionales, con las exigencias de calidad que cada licencia pide. Su propio equipo de diseñadores conceptualiza, diseña y desarrolla cada producto según el proyecto, y viste también el punto de venta: cada stand lleva el branding de su gira.</p>
  </div>
  <div class="ls-biz">
    <figure class="ls-biz-photo">
      <div class="ls-biz-galeria">
        <img src="/images/ls-tienda-racks.webp" alt="Equipo de Live Shows acomodando playeras de giras por talla en los racks de la tienda" width="900" height="1200" loading="lazy" />
        <img src="/images/ls-playera-madonna.webp" alt="Playera oficial de Madonna, Who's That Girl World Tour" width="900" height="1200" loading="lazy" />
        <img src="/images/ls-playera-morrissey.webp" alt="Playera oficial de Morrissey con fotografía a color" width="900" height="1200" loading="lazy" />
        <img src="/images/ls-bolsas-mr-merch.webp" alt="Bolsas de Mr Merch Store selladas con la cinta de Live Shows Merchandising" width="900" height="1200" loading="lazy" />
      </div>
      <figcaption>De los racks por talla a la bolsa sellada de Mr Merch: playeras oficiales de cada gira, diseñadas y vendidas por la casa.</figcaption>
    </figure>
    <div class="ls-biz-cards" id="ls-biz-cards">
      <div class="ls-card">
        <div class="ls-card-h">
          <span class="ls-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z"/><path d="M14 7v10" stroke-dasharray="2 2"/></svg></span>
          <div class="ls-card-t"><h3>Dónde venden</h3>
          <span class="ls-num"><b data-n={eventos.length}>{eventos.length}</b> tipos de evento</span></div>
        </div>
        <div class="ls-chips">{eventos.map((e, i) => <span class="ls-chip ls-pop" style={`--i:${i}`}>{e}</span>)}</div>
      </div>
      <div class="ls-card">
        <div class="ls-card-h">
          <span class="ls-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4l-4 3 2 4 2-1v10h8V10l2 1 2-4-4-3c-.5 1.5-2 2.5-4 2.5S8.5 5.5 8 4z"/></svg></span>
          <div class="ls-card-t"><h3>Qué fabrican</h3>
          <span class="ls-num"><b data-n={productos.length}>{productos.length}</b>+ productos</span></div>
        </div>
        <div class="ls-chips">{productos.map((p, i) => <span class="ls-chip ls-pop" style={`--i:${i}`}>{p}</span>)}<span class="ls-chip ls-chip--muted ls-pop" style={`--i:${productos.length}`}>y mucho más</span></div>
      </div>
      <div class="ls-card">
        <div class="ls-card-h">
          <span class="ls-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20h18M5 20V10l7-5 7 5v10M9 20v-5h6v5"/></svg></span>
          <div class="ls-card-t"><h3>En qué recintos</h3>
          <span class="ls-num"><b data-n={escalaRecintos.length + aireLibre.length}>{escalaRecintos.length + aireLibre.length}</b> tipos de recinto</span></div>
        </div>
        <div class="ls-escala-k">Cerrados, por aforo</div>
        <div class="ls-escala">
          {escalaRecintos.map((r, i) => (
            <div class="ls-escala-p ls-pop" style={`--i:${i}`}>
              <span class="ls-escala-dot" style={`--t:${r.t}px`}></span>
              <span class="ls-escala-n">{r.n}</span>
            </div>
          ))}
        </div>
        <div class="ls-escala-k">Al aire libre</div>
        <div class="ls-chips">{aireLibre.map((r, i) => <span class="ls-chip ls-chip--aire ls-pop" style={`--i:${i + escalaRecintos.length}`}>{r}</span>)}</div>
      </div>
      <div class="ls-card">
        <div class="ls-card-h">
          <span class="ls-ico ls-ico--rosa" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <div class="ls-card-t"><h3>Oficinas operativas</h3>
          <span class="ls-num ls-num--rosa"><b data-n={rutaPaises.length}>{rutaPaises.length}</b> países</span></div>
        </div>
        <ol class="ls-ruta">
          {rutaPaises.map((p, i) => <li class="ls-pop" style={`--i:${i}`}><span class="ls-ruta-pin"></span>{p}</li>)}
        </ol>
        <p class="ls-card-note">De norte a sur: cubren la operación de venta en toda América Latina, en recintos abiertos o cerrados.</p>
      </div>
    </div>
  </div>
</section>

<!-- La escala: cada caja es una sucursal -->
<section class="ls-dark">
  <div class="ls-inner">
    <span class="ls-eyebrow ls-eyebrow--dark">El ritmo</span>
    <h2 class="ls-title ls-title--dark">Cada caja es una sucursal que no para de vender.</h2>
    <p class="ls-lead ls-lead--dark">Un estadio lleno no es una tienda: son decenas de tiendas abiertas al mismo tiempo, durante unas cuantas horas, con una fila que no se acaba hasta que se apagan las luces. Entre todos los módulos caen varias ventas <strong>por segundo</strong>, y cada módulo lleva su propio inventario, su propio dinero y su propio corte.</p>
  </div>
  <div class="ls-grid-wrap" aria-hidden="true">
    <div class="ls-grid" id="ls-grid"></div>
    <p class="ls-grid-cap">Cada punto, un módulo de venta. Cada destello, un cobro.</p>
  </div>
  <div class="ls-inner">
    <div class="ls-pillars">
      <div class="ls-pillar">
        <span class="ls-pillar-k">Ritmo</span>
        <h3>La fila no espera.</h3>
        <p>El cobro tiene que salir en segundos, con tarjeta o en efectivo, y la siguiente venta ya está en el mostrador. En hora pico, cada módulo vende varias veces por minuto.</p>
      </div>
      <div class="ls-pillar">
        <span class="ls-pillar-k">Seguridad</span>
        <h3>Ni una venta se pierde.</h3>
        <p>Si la señal del estadio se cae, la caja sigue cobrando: la venta queda guardada y sube sola cuando vuelve la conexión. Cada cobro queda a nombre de su módulo y de su vendedor.</p>
      </div>
      <div class="ls-pillar">
        <span class="ls-pillar-k">Control</span>
        <h3>Cien sucursales, un solo tablero.</h3>
        <p>Desde un solo lugar se ve qué se vende, dónde y a qué hora, y qué talla se está acabando en qué módulo, antes de que se acabe.</p>
      </div>
    </div>
    <blockquote class="ls-quote">
      <p>«En un concierto llegamos a perder el 20% de nuestras ventas en solo dos horas porque el sistema cayó.»</p>
      <cite>Mariana López, Directora de Operaciones · Live Shows Merchandising</cite>
    </blockquote>
    <p class="ls-after">Eso era antes. Con SACS: <strong>0%</strong> de ventas perdidas por caídas de sistema y <strong>150,000</strong> transacciones sin error en una temporada.</p>
  </div>
</section>

<!-- El sistema: un evento dentro de SACS -->
<section class="ls-sec">
  <div class="ls-inner">
    <span class="ls-eyebrow">Lo que manejan en SACS</span>
    <h2 class="ls-title">Un evento, de principio a fin, dentro del sistema.</h2>
    <p class="ls-lead">SACS es el sistema central de cada evento de Live Shows, pensado para alta demanda y señal intermitente. Así se ve una fecha dentro del sistema:</p>
    <ol class="ls-flow">
      <li class="ls-step">
        <span class="ls-step-k">Antes</span>
        <h3>La gira entra al sistema</h3>
        <ul>
          <li>El catálogo de la gira con sus diseños, tallas y precios del evento.</li>
          <li>El inventario se reparte desde el almacén a cada módulo de venta.</li>
          <li>Cada módulo opera como una sucursal, con su equipo y su caja.</li>
        </ul>
      </li>
      <li class="ls-step">
        <span class="ls-step-k">Durante</span>
        <h3>Se vende sin parar</h3>
        <ul>
          <li><strong>Modo offline:</strong> se cobra sin internet y todo se sincroniza solo, sin perder un registro.</li>
          <li><strong>Traspasos en tiempo real:</strong> un módulo pide mercancía a otro o al almacén central, con trazabilidad completa.</li>
          <li><strong>Alertas de agotado:</strong> el sistema avisa a logística cuando un producto se acaba en un módulo, para resurtir a tiempo.</li>
          <li><strong>Tablero en vivo:</strong> lo más vendido, los módulos con más movimiento y la venta por hora.</li>
        </ul>
      </li>
      <li class="ls-step">
        <span class="ls-step-k">Después</span>
        <h3>El cierre cuadra</h3>
        <ul>
          <li>Corte por módulo y por vendedor, en lugar de las más de 12 horas de auditoría manual de antes.</li>
          <li>98% de precisión de inventario por evento.</li>
          <li>Puntos físicos, pop-ups y tienda en línea en un mismo inventario.</li>
        </ul>
      </li>
    </ol>
  </div>
</section>

<!-- Las personas -->
<section class="ls-sec ls-sec--alt">
  <div class="ls-people">
    <div class="ls-people-text">
      <span class="ls-eyebrow">Las personas</span>
      <h2 class="ls-title">Detrás de cada stand hay un equipo.</h2>
      <p>Diseñadores que convierten una gira en una colección. Vendedores que atienden una fila de miles con una sonrisa y entregan la bolsa en segundos. Gente de logística que corre entre módulos para que la talla que buscas siga ahí.</p>
      <p>La tecnología se nota cuando falla. El trabajo de SACS es que no se note: que el equipo de Live Shows pueda mirar a la persona de enfrente y no a la pantalla.</p>
      <img src="/images/ls-mr-merch-equipo.webp" alt="Equipo de Mr Merch entregando bolsas a fans en el mostrador" width="1200" height="904" loading="lazy" class="ls-people-img" />
    </div>
    <figure class="ls-fan">
      <video controls playsinline preload="none" poster="/videos/ls-mr-merch-fan-poster.webp" width="720" height="1280" class="ls-fan-video">
        <source src="/videos/ls-mr-merch-fan.mp4" type="video/mp4" />
        <track kind="subtitles" src="/videos/ls-mr-merch-fan.es.vtt" srclang="es" label="Español" default />
      </video>
      <figcaption>Así se vive del otro lado del mostrador: una fan de Ghost recorre Mr Merch en la Ciudad de México y presume la edición limitada de la fecha.</figcaption>
    </figure>
  </div>
</section>

<!-- Caso destacado: Olivia Rodrigo -->
<section class="ls-sec">
  <div class="ls-inner">
    <span class="ls-eyebrow">Caso destacado</span>
    <h2 class="ls-title">Olivia Rodrigo en el Foro Sol.</h2>
    <p class="ls-lead">En el pop-up del concierto, Live Shows desplegó tablets 4G, inventario pre-asignado desde el ERP e integración en tiempo real con la tienda en línea.</p>
    <div class="ls-results">
      <div class="ls-result"><span class="ls-result-num">3,800</span><span class="ls-result-label">transacciones físicas en 8 horas</span></div>
      <div class="ls-result"><span class="ls-result-num">1,200</span><span class="ls-result-label">pedidos en línea con recogida inmediata</span></div>
      <div class="ls-result"><span class="ls-result-num">+15%</span><span class="ls-result-label">en ticket promedio</span></div>
    </div>
  </div>
</section>

<!-- Artistas y recintos -->
<section class="ls-sec ls-sec--alt">
  <div class="ls-inner">
    <span class="ls-eyebrow">En el escenario</span>
    <h2 class="ls-title">Artistas que venden su merch con SACS.</h2>
    <div class="ls-artists">
      {['Metallica', 'Shakira', 'Karol G', 'Lady Gaga', 'Iron Maiden', 'Melanie Martinez', 'Ghost', 'Olivia Rodrigo', 'Blink-182', 'Katy Perry', 'Elton John', 'Enjambre'].map((a) => <span class="ls-artist">{a}</span>)}
    </div>
    <h3 class="ls-subtitle">En los recintos más exigentes de Latinoamérica</h3>
    <div class="ls-chips">
      {['Estadio GNP Seguros, CDMX', 'Estadio Azteca, CDMX', 'Palacio de los Deportes, CDMX', 'Movistar Arena, Buenos Aires', 'Allianz Parque, São Paulo'].map((v) => <span class="ls-chip">{v}</span>)}
    </div>
  </div>
</section>

<CasoEnlaces
  giroHref="/giros/merchandising-eventos"
  giroNombre="merchandising de eventos"
  giroAncla="Live Shows despliega pop-ups y módulos de venta en conciertos y festivales: así resuelve Sacs el punto de venta sin internet y los traspasos entre módulos de un evento en vivo."
  funciones={[
    { slug: 'punto-de-venta', ancla: 'El modo offline que sincroniza cada transacción cuando vuelve la conexión, sin perder un registro.' },
    { slug: 'nivelacion-de-inventario', ancla: 'Las transferencias de inventario en tiempo real entre módulos durante el evento.' },
    { slug: 'tienda-en-linea', ancla: 'La operación omnicanal que une puntos físicos, pop-ups y tienda en línea en un solo inventario.' },
  ]}
/>

<!-- CTA -->
<section class="ls-cta">
  <div class="ls-cta-inner">
    <h2 class="ls-cta-title">¿Tu operación también se mide en segundos?</h2>
    <p class="ls-cta-sub">Platiquemos de tu próximo evento, tu gira o tu temporada.</p>
    <div class="ls-cta-actions">
      <a href="/contacto" class="ls-btn ls-btn--primary">Agenda una demo</a>
      <a href="/prueba-gratis" class="ls-btn ls-btn--ghost">Empieza gratis</a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  // Tarjetas de «El negocio»: al entrar a pantalla, las etiquetas aparecen en
  // cascada y las cifras cuentan hacia arriba. Una sola vez por tarjeta.
  const tarjetas = document.getElementById('ls-biz-cards');
  if (tarjetas && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tarjetas.classList.add('js-anim');
    const contar = (el: HTMLElement) => {
      const fin = Number(el.dataset.n || 0); const t0 = performance.now(); const dur = 900;
      const paso = (t: number) => { const k = Math.min(1, (t - t0) / dur); el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(paso); };
      el.textContent = '0'; requestAnimationFrame(paso);
    };
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        const card = e.target as HTMLElement;
        requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('on')));
        card.querySelectorAll<HTMLElement>('.ls-num b[data-n]').forEach(contar);
        io.unobserve(card);
      }
    }, { threshold: 0.25 });
    tarjetas.querySelectorAll('.ls-card').forEach((c) => io.observe(c));
  }

  // Rejilla de módulos: cada punto es un punto de venta; se ilumina al azar
  // como si cobrara. Solo corre mientras está en pantalla y la pestaña visible.
  const grid = document.getElementById('ls-grid');
  if (grid) {
    const n = window.matchMedia('(max-width: 768px)').matches ? 60 : 120;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < n; i++) frag.appendChild(document.createElement('span'));
    grid.appendChild(frag);
    const dots = Array.from(grid.children) as HTMLElement[];
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    let visible = false;
    const tick = () => {
      for (let k = 0; k < 4; k++) {
        const d = dots[Math.floor(Math.random() * dots.length)];
        d.classList.remove('on');
        requestAnimationFrame(() => requestAnimationFrame(() => d.classList.add('on')));
      }
    };
    const start = () => { if (!timer && visible && !document.hidden && !quieto) timer = window.setInterval(tick, 260); };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(grid);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>

<style>
  /* ── Hero ── */
  .ls-hero { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; min-height: 620px; background: #0b0a10; color: #fff; }
  .ls-hero-text { order: 0; display: flex; flex-direction: column; justify-content: center; padding: clamp(48px, 6vw, 96px) clamp(24px, 5vw, 72px); max-width: 680px; margin-left: auto; }
  .ls-hero-media { order: 1; position: relative; overflow: hidden; }
  .ls-hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #0b0a10 0%, rgba(11,10,16,0) 35%); }
  .ls-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ls-back { font-family: var(--font-body); font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.55); text-decoration: none; margin-bottom: 28px; }
  .ls-back:hover { color: #fff; }
  .ls-tag { display: inline-block; width: fit-content; padding: 6px 14px; border-radius: 6px; background: #C42A74; color: #fff; font-family: var(--font-body); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 18px; }
  .ls-hero-title { font-family: var(--font-display); font-size: clamp(2.6rem, 5.5vw, 4.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 20px; color: #fff; }
  .ls-hero-lead { font-family: var(--font-body); font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.65; color: rgba(255,255,255,0.72); margin: 0; max-width: 520px; }

  /* ── Cifras ── */
  .ls-stats { background: #1A1A1A; }
  .ls-stats-inner { max-width: 1040px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); }
  .ls-stat { padding: 32px 20px; text-align: center; border-right: 1px solid rgba(255,255,255,0.08); }
  .ls-stat:last-child { border-right: none; }
  .ls-stat-num { display: block; font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; color: #fff; letter-spacing: -0.03em; line-height: 1; }
  .ls-stat-label { display: block; margin-top: 6px; font-family: var(--font-body); font-size: 13px; color: rgba(255,255,255,0.55); }

  /* ── Secciones ── */
  .ls-sec { padding: clamp(64px, 8vw, 110px) 24px; background: #fff; }
  .ls-sec--alt { background: var(--color-bg-primary); }
  .ls-inner { max-width: 860px; margin: 0 auto; }
  .ls-eyebrow { display: block; font-family: var(--font-display); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #A3205F; margin-bottom: 14px; }
  .ls-eyebrow--dark { color: #FF7AB6; }
  .ls-title { font-family: var(--font-display); font-size: clamp(1.9rem, 3.8vw, 2.9rem); font-weight: 800; color: var(--color-text-primary); letter-spacing: -0.035em; line-height: 1.08; margin: 0 0 22px; }
  .ls-title--dark { color: #fff; }
  .ls-lead, .ls-split-text p, .ls-people-text p { font-family: var(--font-body); font-size: 17px; line-height: 1.7; color: var(--color-text-secondary); margin: 0 0 16px; }
  .ls-lead--dark { color: rgba(255,255,255,0.72); }
  .ls-lead strong, .ls-split-text strong { color: var(--color-text-primary); }
  .ls-lead--dark strong { color: #fff; }
  .ls-subtitle { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--color-text-primary); margin: 40px 0 0; letter-spacing: -0.02em; }

  /* ── Moda / recuerdo ── */
  .ls-split { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .ls-mosaic { position: relative; padding-bottom: 18%; }
  .ls-mosaic img { display: block; border-radius: 18px; object-fit: cover; }
  .ls-mosaic-a { width: 86%; height: auto; aspect-ratio: 4 / 3; }
  .ls-mosaic-b { position: absolute; right: 0; bottom: 0; width: 52%; height: auto; aspect-ratio: 4 / 3; border: 6px solid #fff; box-shadow: 0 12px 30px rgba(0,0,0,0.18); }
  .ls-bigquote { max-width: 1120px; margin: clamp(56px, 7vw, 88px) auto 0; text-align: center; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.6rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.08; color: #C42A74; }

  /* ── Negocio ── */
  .ls-biz { max-width: 1120px; margin: 40px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .ls-biz-photo { margin: 0; }
  .ls-biz-photo img { width: 100%; height: auto; border-radius: 18px; display: block; }
  .ls-biz-galeria { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ls-biz-galeria img { aspect-ratio: 3 / 4; object-fit: cover; border-radius: 16px; }
  .ls-biz-photo figcaption { font-family: var(--font-body); font-size: 13px; color: var(--color-text-tertiary); margin-top: 10px; line-height: 1.5; }
  .ls-biz-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ls-card { background: #fff; border: 1px solid var(--color-bg-secondary); border-radius: 16px; padding: 20px; }
  .ls-card h3 { font-family: var(--font-display); font-size: 1rem; font-weight: 800; color: var(--color-text-primary); margin: 0 0 12px; letter-spacing: -0.01em; }
  .ls-card-note { font-family: var(--font-body); font-size: 13px; color: var(--color-text-tertiary); line-height: 1.5; margin: 12px 0 0; }
  .ls-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .ls-sec .ls-inner > .ls-chips { margin-top: 16px; gap: 10px; }
  .ls-chip { font-family: var(--font-body); font-size: 13px; font-weight: 600; color: var(--color-text-secondary); background: var(--color-bg-primary); padding: 6px 12px; border-radius: 100px; }
  .ls-sec--alt .ls-inner > .ls-chips .ls-chip { background: #fff; border: 1px solid var(--color-bg-secondary); }
  .ls-chip--muted { background: transparent; color: var(--color-text-tertiary); }
  .ls-chip--pais { background: #FBE7F0; color: #8A1B50; }
  /* ── Tarjetas didácticas (4-oct-2026) ── */
  .ls-card-h { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .ls-card-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .ls-card-h h3 { margin: 0; }
  .ls-ico { width: 40px; height: 40px; border-radius: 10px; background: #EAF0FD; display: grid; place-items: center; flex: none; }
  .ls-ico svg { width: 19px; height: 19px; fill: none; stroke: var(--color-primary-texto); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ls-ico--rosa { background: #FBE7F0; }
  .ls-ico--rosa svg { stroke: #8A1B50; }
  .ls-num { font-family: var(--font-body); font-size: 12px; color: var(--color-text-tertiary); white-space: nowrap; line-height: 1.2; }
  .ls-num b { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--color-primary-texto); letter-spacing: -0.02em; margin-right: 3px; font-variant-numeric: tabular-nums; }
  .ls-num--rosa b { color: #8A1B50; }
  .ls-chip { transition: background .2s, color .2s, transform .2s; }
  .ls-chip:hover { background: #EAF0FD; color: var(--color-primary-texto); transform: translateY(-1px); }
  .ls-chip--muted:hover { background: transparent; color: var(--color-text-tertiary); transform: none; }
  .ls-escala-k { font-family: var(--font-body); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-text-tertiary); margin: 4px 0 10px; }
  .ls-escala { display: grid; grid-template-columns: repeat(4, 1fr); align-items: end; gap: 6px; margin-bottom: 16px; position: relative; }
  .ls-escala::before { content: ""; position: absolute; left: 8%; right: 8%; bottom: 28px; height: 2px; background: linear-gradient(90deg, #D6E1FA, var(--color-primary)); border-radius: 2px; }
  .ls-escala-p { display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; }
  .ls-escala-dot { width: var(--t); height: var(--t); border-radius: 50%; background: var(--color-primary); opacity: .85; box-shadow: 0 0 0 4px #fff; }
  .ls-escala-n { font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--color-text-secondary); }
  .ls-chip--aire { background: #EAF7F1; color: #1E7A55; }
  .ls-ruta { list-style: none; margin: 0; padding: 0 0 0 4px; display: grid; grid-template-columns: auto auto; justify-content: start; column-gap: 22px; position: relative; }
  .ls-ruta li { display: flex; align-items: center; gap: 10px; font-family: var(--font-body); font-size: 13.5px; font-weight: 600; color: #8A1B50; padding: 6px 0; position: relative; white-space: nowrap; }
  .ls-ruta li::after { content: ""; position: absolute; left: 5px; top: 22px; bottom: -8px; width: 2px; background: #F3C6DA; }
  .ls-ruta li:nth-child(4)::after, .ls-ruta li:last-child::after { display: none; }
  .ls-ruta { grid-auto-flow: column; grid-template-rows: repeat(4, auto); }
  .ls-ruta-pin { width: 12px; height: 12px; border-radius: 50%; background: #D9538E; box-shadow: 0 0 0 3px #FBE7F0; flex: none; position: relative; z-index: 1; }

  /* La animación solo arranca con JS (sin JS todo se ve quieto y completo) y
     respeta a quien pidió menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    .ls-biz-cards.js-anim .ls-card:not(.on) .ls-pop { opacity: 0; transform: translateY(8px) scale(.96); }
    .ls-biz-cards.js-anim .ls-pop { transition: opacity .45s ease, transform .45s cubic-bezier(.2,.8,.3,1.2); transition-delay: calc(var(--i, 0) * 45ms); }
    .ls-biz-cards.js-anim .ls-card:not(.on) .ls-escala-dot { transform: scale(0); }
    .ls-biz-cards.js-anim .ls-escala-dot { transition: transform .6s cubic-bezier(.2,.8,.3,1.4); transition-delay: calc(120ms + var(--i, 0) * 110ms); }
    .ls-biz-cards.js-anim .ls-card.on .ls-ruta-pin { animation: ls-pin 1.6s ease-out calc(var(--i, 0) * 120ms) 1 both; }
    @keyframes ls-pin { 0% { box-shadow: 0 0 0 0 rgba(217,83,142,.55); } 70% { box-shadow: 0 0 0 9px rgba(217,83,142,0); } 100% { box-shadow: 0 0 0 3px #FBE7F0; } }
  }

  /* ── Escala (oscuro) ── */
  .ls-dark { padding: clamp(64px, 8vw, 110px) 24px; background: #0b0a10; color: #fff; }
  .ls-grid-wrap { max-width: 980px; margin: 40px auto 48px; }
  .ls-grid { display: grid; grid-template-columns: repeat(20, 1fr); gap: 10px; }
  .ls-grid :global(span) { aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,0.12); }
  .ls-grid :global(span.on) { animation: ls-cobro 1.2s ease-out; }
  @keyframes ls-cobro {
    0% { background: #FF4FA0; box-shadow: 0 0 10px #FF4FA0; }
    100% { background: rgba(255,255,255,0.12); box-shadow: 0 0 0 transparent; }
  }
  .ls-grid-cap { font-family: var(--font-body); font-size: 13px; color: rgba(255,255,255,0.5); text-align: center; margin: 16px 0 0; }
  .ls-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ls-pillar { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 24px 22px; }
  .ls-pillar-k { font-family: var(--font-body); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #FF7AB6; }
  .ls-pillar h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: #fff; margin: 8px 0 8px; letter-spacing: -0.02em; }
  .ls-pillar p { font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.68); margin: 0; }
  .ls-quote { margin: 48px 0 0; padding-left: 24px; border-left: 4px solid #C42A74; }
  .ls-quote p { font-family: var(--font-body); font-size: clamp(1.15rem, 1.8vw, 1.4rem); font-style: italic; line-height: 1.55; color: #fff; margin: 0 0 10px; }
  .ls-quote cite { font-family: var(--font-body); font-size: 14px; font-style: normal; font-weight: 600; color: rgba(255,255,255,0.55); }
  .ls-after { font-family: var(--font-body); font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.72); margin: 24px 0 0; }
  .ls-after strong { color: #fff; }

  /* ── Flujo en SACS ── */
  .ls-flow { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 16px; }
  .ls-step { position: relative; background: var(--color-bg-primary); border-radius: 18px; padding: 24px; }
  .ls-step-k { display: inline-block; font-family: var(--font-body); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #fff; background: #1A1A1A; padding: 4px 10px; border-radius: 100px; }
  .ls-step h3 { font-family: var(--font-display); font-size: 1.3rem; font-weight: 800; color: var(--color-text-primary); margin: 12px 0 10px; letter-spacing: -0.02em; }
  .ls-step ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .ls-step li { font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: var(--color-text-secondary); padding-left: 22px; position: relative; }
  .ls-step li::before { content: '\2713'; position: absolute; left: 0; color: var(--color-secondary-texto); font-weight: 700; }
  .ls-step li strong { color: var(--color-text-primary); }

  /* ── Personas ── */
  .ls-people { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .ls-people-img { width: 100%; height: auto; border-radius: 18px; display: block; margin-top: 16px; }
  .ls-fan { margin: 0; position: sticky; top: 96px; }
  .ls-fan-video { width: 100%; height: auto; aspect-ratio: 9 / 16; border-radius: 18px; background: #000; display: block; }
  .ls-fan figcaption { font-family: var(--font-body); font-size: 13px; line-height: 1.5; color: var(--color-text-tertiary); margin-top: 10px; }

  /* ── Resultados ── */
  .ls-results { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 28px; }
  .ls-result { background: var(--color-bg-primary); border-radius: 16px; padding: 26px 20px; text-align: center; }
  .ls-result-num { display: block; font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--color-primary-texto); letter-spacing: -0.03em; line-height: 1; margin-bottom: 8px; }
  .ls-result-label { display: block; font-family: var(--font-body); font-size: 13px; line-height: 1.4; color: var(--color-text-secondary); }

  /* ── Artistas ── */
  .ls-artists { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .ls-artist { font-family: var(--font-display); font-size: 15px; font-weight: 800; color: #fff; background: #1A1A1A; padding: 10px 18px; border-radius: 100px; letter-spacing: -0.01em; }

  /* ── CTA ── */
  .ls-cta { padding: clamp(80px, 10vw, 140px) 24px; background: #0b0a10; text-align: center; }
  .ls-cta-inner { max-width: 640px; margin: 0 auto; }
  .ls-cta-title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #fff; letter-spacing: -0.03em; line-height: 1.1; margin: 0 0 12px; }
  .ls-cta-sub { font-family: var(--font-body); font-size: 1.1rem; color: rgba(255,255,255,0.62); margin: 0 0 32px; }
  .ls-cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .ls-btn { font-family: var(--font-body); font-size: 15px; font-weight: 700; padding: 14px 32px; border-radius: 100px; text-decoration: none; transition: transform 0.2s ease; }
  .ls-btn:hover { transform: translateY(-2px); text-decoration: none; }
  .ls-btn--primary { background: #fff; color: #1A1A1A; }
  .ls-btn--ghost { color: #fff; border: 1.5px solid rgba(255,255,255,0.3); }

  /* ── Móvil ── */
  @media (max-width: 900px) {
    .ls-biz { grid-template-columns: 1fr; }
    .ls-people { grid-template-columns: 1fr; }
    .ls-fan { position: static; max-width: 380px; width: 100%; margin: 0 auto; }
  }
  @media (max-width: 768px) {
    .ls-hero { grid-template-columns: 1fr; min-height: 0; }
    .ls-hero-media { order: 0; height: 52vh; min-height: 300px; }
    .ls-hero-media::after { background: linear-gradient(0deg, #0b0a10 0%, rgba(11,10,16,0) 40%); }
    .ls-hero-text { order: 1; padding: 8px 16px 44px; margin: 0; }
    .ls-back { position: absolute; top: 16px; left: 16px; z-index: 1; color: #fff; background: rgba(0,0,0,0.55); padding: 6px 12px; border-radius: 100px; font-size: 13px; }
    .ls-stats-inner { grid-template-columns: repeat(2, 1fr); }
    .ls-stat { padding: 22px 12px; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .ls-stat:nth-child(odd) { border-right: 1px solid rgba(255,255,255,0.08); }
    .ls-stat:nth-child(n+3) { border-bottom: none; }
    .ls-sec, .ls-dark { padding-left: 16px; padding-right: 16px; }
    .ls-split { grid-template-columns: 1fr; }
    .ls-mosaic-b { box-shadow: 0 4px 10px rgba(0,0,0,0.15); border-width: 4px; }
    .ls-biz-cards { grid-template-columns: 1fr; }
    .ls-grid { grid-template-columns: repeat(12, 1fr); gap: 8px; }
    .ls-pillars { grid-template-columns: 1fr; }
    .ls-results { grid-template-columns: 1fr; }
    .ls-step { padding: 20px 18px; }
  }
</style>
