---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbCaso } from '../../lib/breadcrumb';

const structuredData = breadcrumbCaso();

const cases = [
  {
    slug: 'liveshow',
    featured: true,
    brand: 'Live Shows Merchandising',
    tagline: 'La moda que se vuelve recuerdo.',
    tag: 'Moda · Merch oficial',
    tagColor: '#C42A74',
    image: '/images/ls-guts-fans.webp',
    imageAlt: 'Fan con la sudadera oficial del GUTS World Tour frente a la pared de playeras',
    image2: '/images/ls-guts-tote.webp',
    image2Alt: 'Tote bag oficial de GUTS gallery',
    image3: '/images/ls-guts-experiencia.webp',
    image3Alt: 'Instalación iluminada de la experiencia GUTS gallery',
    stats: [
      { num: '2007', label: 'líderes del merch oficial' },
      { num: '8', label: 'países con oficina' },
      { num: '100+', label: 'puntos de venta a la vez' },
      { num: '150K+', label: 'transacciones sin error' },
    ],
    quote: '"En un concierto perdimos 20% de ventas en dos horas porque el sistema colapsó. Con SACS eso no vuelve a pasar."',
    author: 'Mariana López, Directora de Operaciones',
    desc: 'Playeras, sudaderas y prendas de corte especial con diseño propio y ediciones limitadas por ciudad y por fecha: la prenda con la que te llevas puesto al artista que te inspira.',
    points: [
      { k: 'La moda', t: 'Te pones la playera y vuelves a esa noche.', d: 'Diseño propio, cortes especiales y ediciones limitadas para fans que se visten como su artista.' },
      { k: 'El ritmo', t: 'Cada caja es una sucursal que no para de vender.', d: 'Más de 100 módulos cobrando a la vez, con varias ventas por segundo en un estadio lleno.' },
      { k: 'La seguridad', t: 'Ni una venta se pierde.', d: 'Si la señal se cae, se sigue cobrando y todo se sincroniza solo. 0% de ventas perdidas.' },
      { k: 'El sistema', t: 'Un evento entero dentro de SACS.', d: 'Inventario por módulo, traspasos en pleno evento, alertas de agotado y corte por vendedor.' },
    ],
    highlights: [],
  },
  {
    slug: 'la-bella-pandita',
    brand: 'La Bella Pandita',
    tagline: 'De 1 tienda en Querétaro a 42 sucursales en todo México.',
    tag: 'Moda',
    tagColor: '#6C5CE7',
    image: '/images/case-bella-pandita.webp',
    stats: [
      { num: '42', label: 'sucursales sincronizadas' },
      { num: '+300%', label: 'customer lifetime value' },
      { num: '45%', label: 'clientes fidelizados' },
      { num: '98%', label: 'precisión de inventario' },
    ],
    quote: '"La Bella Pandita dejó de ser solo una marca de retail físico para convertirse en una operación omnicanal completamente integrada."',
    author: 'Equipo La Bella Pandita',
    desc: 'Cadena de boutiques de moda y novedades que escaló de 1 tienda piloto a 42 sucursales en 3 años. SACS digitalizó toda su operación: POS móvil, programa de lealtad con wallet digital, y sincronización en tiempo real de 12,500+ productos.',
    highlights: ['POS móvil — cobros en menos de 2 minutos', 'Recepción de mercancía de 4 horas a 30 minutos', 'Programa de lealtad con puntos y wallet digital', 'Flash sales y promociones automatizadas'],
  },
  {
    slug: 'sandmade',
    brand: 'Sandmade Swimwear',
    tagline: 'Swimwear premium conectado de Tulum a Los Cabos.',
    tag: 'Swimwear',
    tagColor: '#00B894',
    image: '/images/case-sandmade.webp',
    stats: [
      { num: '98%', label: 'precisión de inventario' },
      { num: '8', label: 'boutiques turísticas' },
      { num: '20s', label: 'tiempo por transacción' },
      { num: '45', label: 'días de implementación' },
    ],
    quote: '"Cada venta se convirtió en una oportunidad de conectar auténticamente con los clientes sin perder agilidad ni precisión."',
    author: 'Equipo Sandmade',
    desc: 'Marca de swimwear con boutiques en los destinos turísticos más exclusivos de México. SACS unificó sus 8 tiendas, e-commerce Shopify, Instagram y WhatsApp en un solo sistema con inventario en tiempo real.',
    highlights: ['Integración Shopify + Instagram + WhatsApp', 'Fulfillment de pickup en menos de 2 horas', 'Devoluciones procesadas en menos de 2 minutos', 'CEDIS conectado con todas las boutiques'],
  },
  {
    slug: 'casa-maca',
    brand: 'Casa Maca',
    tagline: 'Moda consciente que ahora opera con datos.',
    tag: 'Moda Consciente',
    tagColor: '#FDCB6E',
    tagTextColor: '#1A1A1A',
    image: '/images/case-casa-maca.webp',
    stats: [
      { num: '-80%', label: 'trabajo manual' },
      { num: '+25%', label: 'ticket promedio' },
      { num: '98%', label: 'precisión inventario' },
      { num: '30', label: 'días implementación' },
    ],
    quote: '"Casa Maca diseña desde la intuición, pero ahora opera con data."',
    author: 'Equipo Casa Maca',
    desc: 'Marca de moda sostenible en Guadalajara que pasó de Excel y procesos manuales a una operación omnicanal automatizada. 2 boutiques físicas + e-commerce + social commerce, todo conectado.',
    highlights: ['De Excel a automatización completa', 'Catálogo sincronizado en WhatsApp e Instagram', 'Programa de lealtad integrado al cobro', 'Publicación automática en redes sociales'],
  },
];
---

<BaseLayout
  title="Casos de éxito — Retailers que crecen con SACS"
  description="Descubre cómo retailers mexicanos transforman su operación con SACS. Desde 1 tienda hasta 42 sucursales."
  structuredData={structuredData}
>

<!-- Hero -->
<section class="ce-hero">
  <div class="ce-hero-inner">
    <span class="ce-eyebrow">Casos de éxito</span>
    <h1 class="ce-hero-title">Retailers reales.<br>Resultados reales.</h1>
    <p class="ce-hero-subtitle">De la mercancía oficial de conciertos en estadios llenos a boutiques de swimwear en Tulum. Así opera el retail con SACS.</p>
  </div>
</section>

<!-- Cases -->
{cases.map((c, idx) => c.featured ? (
  <section class="ce-feat" id={c.slug}>
    <div class="ce-feat-inner">
      <div class="ce-feat-visual">
        <img src={c.image} alt={c.imageAlt} width="1080" height="1080" loading="eager" class="ce-feat-img-a" />
        <img src={c.image3} alt={c.image3Alt} width="1080" height="1080" loading="lazy" class="ce-feat-img-c" />
        <img src={c.image2} alt={c.image2Alt} width="1080" height="1080" loading="lazy" class="ce-feat-img-b" />
        <span class="ce-feat-badge">Lookbook de concierto</span>
      </div>
      <div class="ce-feat-content">
        <span class="ce-feat-tag">{c.tag}</span>
        <h2 class="ce-feat-brand">{c.brand}</h2>
        <p class="ce-feat-tagline">{c.tagline}</p>
        <p class="ce-feat-desc">{c.desc}</p>
        <div class="ce-feat-stats">
          {c.stats.map((s) => (
            <div class="ce-feat-stat"><span class="ce-feat-stat-num">{s.num}</span><span class="ce-feat-stat-label">{s.label}</span></div>
          ))}
        </div>
      </div>
    </div>
    <div class="ce-feat-points">
      {c.points?.map((pt, i) => (
        <div class="ce-feat-point">
          <span class="ce-feat-point-k">{String(i + 1).padStart(2, '0')} · {pt.k}</span>
          <h3>{pt.t}</h3>
          <p>{pt.d}</p>
        </div>
      ))}
    </div>
    <div class="ce-feat-foot">
      <blockquote class="ce-feat-quote">
        <p>{c.quote}</p>
        <cite>— {c.author}</cite>
      </blockquote>
      <a href={`/casos-de-exito/${c.slug}`} class="ce-feat-link">
        Entra a la historia completa
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
) : (
  <section class={`ce-case ${idx % 2 === 1 ? 'ce-case--alt' : ''}`} id={c.slug}>
    <div class="ce-case-inner">
      <div class="ce-case-visual">
        <div class="ce-case-img-wrap">
          <img src={c.image} alt={`${c.brand} — caso de éxito SACS`} width="600" height="500" loading="lazy" class="ce-case-img" />
        </div>
      </div>
      <div class="ce-case-content">
        <span class="ce-case-tag" style={`background:color-mix(in srgb, ${c.tagColor} 66%, #000); color:${c.tagTextColor || '#fff'};`}>{c.tag}</span>
        <h2 class="ce-case-brand">{c.brand}</h2>
        <p class="ce-case-tagline">{c.tagline}</p>
        <div class="ce-case-stats">
          {c.stats.map((s) => (
            <div class="ce-stat">
              <span class="ce-stat-num">{s.num}</span>
              <span class="ce-stat-label">{s.label}</span>
            </div>
          ))}
        </div>
        <blockquote class="ce-case-quote">
          <p>{c.quote}</p>
          <cite>— {c.author}</cite>
        </blockquote>
        <p class="ce-case-desc">{c.desc}</p>
        <ul class="ce-case-highlights">
          {c.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
        <a href={`/casos-de-exito/${c.slug}`} class="ce-case-link">
          Ver caso completo
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
))}

<!-- CTA -->
<section class="ce-cta">
  <div class="ce-cta-inner">
    <h2 class="ce-cta-title">Tu negocio puede ser el siguiente.</h2>
    <p class="ce-cta-subtitle">Configura SACS en 15 minutos. Sin tarjeta de crédito.</p>
    <div class="ce-cta-actions">
      <a href="/prueba-gratis" class="ce-cta-btn ce-cta-btn--primary">Empieza gratis</a>
      <a href="/contacto" class="ce-cta-btn ce-cta-btn--secondary">Agenda una demo</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .ce-hero {
    padding: clamp(120px, 14vw, 180px) 0 clamp(60px, 8vw, 100px);
    text-align: center;
    background: #fff;
  }
  .ce-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ce-eyebrow {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-tertiary);
    margin-bottom: 16px;
    display: block;
  }
  .ce-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 24px;
  }
  .ce-hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Case Section ── */
  .ce-case {
    padding: clamp(60px, 8vw, 100px) 0;
    background: #fff;
    border-top: 1px solid rgba(0,0,0,0.04);
  }
  .ce-case--alt {
    background: var(--color-bg-primary);
  }
  .ce-case-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .ce-case--alt .ce-case-inner {
    direction: rtl;
  }
  .ce-case--alt .ce-case-inner > * {
    direction: ltr;
  }

  /* Visual */
  .ce-case-img-wrap {
    border-radius: 20px;
    overflow: hidden;
  }
  .ce-case-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 6 / 5;
  }

  /* Content */
  .ce-case-tag {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .ce-case-brand {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    margin: 12px 0 8px;
    line-height: 1.1;
  }
  .ce-case-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  /* Stats grid */
  .ce-case-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .ce-stat {
    background: var(--color-bg-secondary, #F5F3EE);
    border-radius: 12px;
    padding: 16px;
  }
  .ce-case--alt .ce-stat {
    background: #fff;
  }
  .ce-stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    display: block;
    line-height: 1;
  }
  .ce-stat-label {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-tertiary);
    margin-top: 4px;
    display: block;
  }

  /* Quote */
  .ce-case-quote {
    border-left: 3px solid var(--color-text-primary);
    padding-left: 20px;
    margin: 0 0 24px;
  }
  .ce-case-quote p {
    font-family: var(--font-body);
    font-size: 15px;
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .ce-case-quote cite {
    font-family: var(--font-body);
    font-size: 13px;
    font-style: normal;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  /* Description */
  .ce-case-desc {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  /* Highlights */
  .ce-case-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ce-case-highlights li {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-secondary);
    padding-left: 20px;
    position: relative;
  }
  .ce-case-highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-secondary-texto, #0E7A68);
    font-weight: 700;
  }

  /* Case link */
  .ce-case-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary-texto);
    text-decoration: none;
    margin-top: 20px;
    transition: gap 0.2s ease;
  }
  .ce-case-link:hover {
    gap: 10px;
  }


  /* ── Caso destacado (Live Shows): editorial de moda ── */
  .ce-feat { background: #0b0a10; color: #fff; padding: clamp(64px, 8vw, 110px) 0; }
  .ce-feat-inner, .ce-feat-points, .ce-feat-foot { max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }
  .ce-feat-inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
  .ce-feat-visual { position: relative; padding: 0 30% 12% 0; }
  .ce-feat-visual img { display: block; width: 100%; height: auto; object-fit: cover; }
  .ce-feat-img-a { aspect-ratio: 4 / 5; border-radius: 4px; }
  .ce-feat-img-b { position: absolute; right: 0; bottom: 0; width: 46% !important; aspect-ratio: 1; border-radius: 4px; border: 6px solid #0b0a10; }
  .ce-feat-img-c { position: absolute; right: 0; top: 0; width: 36% !important; aspect-ratio: 1; border-radius: 4px; }
  .ce-feat-badge { position: absolute; top: 16px; left: 16px; background: #fff; color: #0b0a10; font-family: var(--font-display); font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; padding: 8px 12px; }
  .ce-feat-tag { display: inline-block; font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #FF7AB6; border-bottom: 1px solid #FF7AB6; padding-bottom: 4px; }
  .ce-feat-brand { font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; color: #fff; margin: 18px 0 10px; }
  .ce-feat-tagline { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; color: #FF7AB6; margin: 0 0 18px; }
  .ce-feat-desc { font-family: var(--font-body); font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.72); margin: 0 0 28px; max-width: 520px; }
  .ce-feat-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(255,255,255,0.14); }
  .ce-feat-stat { padding: 18px 12px 0 0; }
  .ce-feat-stat-num { display: block; font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: #fff; }
  .ce-feat-stat-label { display: block; font-family: var(--font-body); font-size: 12px; line-height: 1.35; color: rgba(255,255,255,0.55); margin-top: 6px; }
  .ce-feat-points { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: clamp(48px, 6vw, 72px); }
  .ce-feat-point { border-top: 2px solid #C42A74; padding-top: 18px; }
  .ce-feat-point-k { font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #FF7AB6; }
  .ce-feat-point h3 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.25; color: #fff; margin: 10px 0 8px; }
  .ce-feat-point p { font-family: var(--font-body); font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.65); margin: 0; }
  .ce-feat-foot { display: flex; align-items: center; justify-content: space-between; gap: 32px; margin-top: clamp(40px, 5vw, 56px); }
  .ce-feat-quote { margin: 0; padding-left: 20px; border-left: 3px solid #C42A74; max-width: 640px; }
  .ce-feat-quote p { font-family: var(--font-body); font-size: 16px; font-style: italic; line-height: 1.6; color: rgba(255,255,255,0.85); margin: 0 0 8px; }
  .ce-feat-quote cite { font-family: var(--font-body); font-size: 13px; font-style: normal; font-weight: 600; color: rgba(255,255,255,0.5); }
  .ce-feat-link { flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #0b0a10; font-family: var(--font-body); font-size: 15px; font-weight: 700; padding: 14px 26px; border-radius: 100px; text-decoration: none; transition: gap 0.2s ease; }
  .ce-feat-link:hover { gap: 12px; text-decoration: none; }
  @media (max-width: 900px) {
    .ce-feat-inner { grid-template-columns: 1fr; }
    .ce-feat-points { grid-template-columns: repeat(2, 1fr); }
    .ce-feat-foot { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 560px) {
    .ce-feat-stats { grid-template-columns: repeat(2, 1fr); }
    .ce-feat-points { grid-template-columns: 1fr; }
    .ce-feat-img-b { border-width: 4px; }
    .ce-feat-link { width: 100%; justify-content: center; }
  }

  /* CTA */
  .ce-cta {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--color-text-primary);
    text-align: center;
  }
  .ce-cta-inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ce-cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .ce-cta-subtitle {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: rgba(255,255,255,0.6);
    margin: 0 0 32px;
  }
  .ce-cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .ce-cta-btn {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 100px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .ce-cta-btn:hover { transform: translateY(-2px); }
  .ce-cta-btn--primary {
    background: #fff;
    color: var(--color-text-primary);
  }
  .ce-cta-btn--secondary {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.3);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .ce-case-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .ce-case--alt .ce-case-inner {
      direction: ltr;
    }
    .ce-case-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
