---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbCaso } from '../../lib/breadcrumb';

const structuredData = breadcrumbCaso();

const cases = [
  {
    slug: 'liveshow',
    featured: true,
    brand: 'Live Shows Merchandising',
    tagline: 'La moda que se vuelve recuerdo.',
    tag: 'Moda · Merch oficial',
    tagColor: '#C42A74',
    image: '/images/ls-guts-fans.webp',
    imageAlt: 'Fan con la sudadera oficial del GUTS World Tour frente a la pared de playeras',
    image2: '/images/ls-guts-tote.webp',
    image2Alt: 'Tote bag oficial de GUTS gallery',
    image3: '/images/ls-guts-experiencia.webp',
    image3Alt: 'Instalación iluminada de la experiencia GUTS gallery',
    stats: [
      { num: '2007', label: 'líderes del merch oficial' },
      { num: '8', label: 'países con oficina' },
      { num: '100+', label: 'puntos de venta a la vez' },
      { num: '150K+', label: 'transacciones sin error' },
    ],
    quote: '"En un concierto perdimos 20% de ventas en dos horas porque el sistema colapsó. Con SACS eso no vuelve a pasar."',
    author: 'Mariana López, Directora de Operaciones',
    desc: 'Playeras, sudaderas y prendas de corte especial con diseño propio y ediciones limitadas por ciudad y por fecha: la prenda con la que te llevas puesto al artista que te inspira.',
    points: [
      { k: 'La moda', t: 'Te pones la playera y vuelves a esa noche.', d: 'Diseño propio, cortes especiales y ediciones limitadas para fans que se visten como su artista.' },
      { k: 'El ritmo', t: 'Cada caja es una sucursal que no para de vender.', d: 'Más de 100 módulos cobrando a la vez, con varias ventas por segundo en un estadio lleno.' },
      { k: 'La seguridad', t: 'Ni una venta se pierde.', d: 'Si la señal se cae, se sigue cobrando y todo se sincroniza solo. 0% de ventas perdidas.' },
      { k: 'El sistema', t: 'Un evento entero dentro de SACS.', d: 'Inventario por módulo, traspasos en pleno evento, alertas de agotado y corte por vendedor.' },
    ],
    highlights: [],
  },
  {
    slug: 'sthela',
    estilo: 'moda-claro',
    brand: 'Sthela & Co.',
    logo: '/images/sthela-logo.webp',
    tag: 'Moda femenina · Fabricante y mayorista',
    tagline: 'Un vestido para cada ocasión.',
    desc: 'Sthela & Co. es una marca jalisciense de moda femenina que diseña sus propias colecciones cada año: ropa casual, vestidos de fiesta, zapatos y accesorios. Vende al público en sus boutiques y en línea, y por mayoreo a otras boutiques del país, que cada edición la buscan en Intermoda. Al frente, sus dueñas: fashion icons que presentan la colección ellas mismas.',
    hechos: [
      { num: 'Diseño propio', label: 'colecciones nuevas cada año' },
      { num: 'Intermoda', label: 'fabricante y mayorista cada edición' },
      { num: 'Menudeo + mayoreo', label: 'al público y a otras boutiques' },
      { num: 'Boutiques propias', label: 'en Jalisco, y su ropa en boutiques de todo el país' },
    ],
    points: [
      { k: 'El diseño', t: 'Su propia colección, cada temporada.', d: 'Del cardigan y la blusa camisera al pantalón de vestir y el blazer oversized: todo combina, en los tonos de la temporada.' },
      { k: 'El mayoreo', t: 'La pasarela de las boutiques.', d: 'En Intermoda, boutiques de todo el país eligen sus muestrarios y hacen pedido directo con la marca.' },
      { k: 'Las boutiques', t: 'Para cada ocasión, en persona.', d: 'De la ropa casual al vestido de fiesta, con zapatos y accesorios para cerrar el look.' },
      { k: 'En línea', t: 'La tienda que nunca cierra.', d: 'sthela.com, Instagram y Facebook, con las mismas colecciones que en tienda.' },
    ],
    sucursales: [
      { zona: 'Zapopan', nombre: 'Los Cubos', dir: 'Av. Ignacio L. Vallarta 4825' },
      { zona: 'Guadalajara', nombre: 'Providencia', dir: 'Rubén Darío 1356, local 17' },
    ],
    videos: [
      { src: '/videos/sthela-intermoda-coleccion.mp4', poster: '/videos/sthela-intermoda-coleccion-poster.webp', cap: 'La colección en Intermoda' },
      { src: '/videos/sthela-vestido-loop.mp4', poster: '/videos/sthela-vestido-loop-poster.webp', cap: 'Vestido de noche', loop: true },
      { src: '/videos/sthela-intermoda-equipo.mp4', poster: '/videos/sthela-intermoda-equipo-poster.webp', cap: 'El equipo, cierre de edición' },
    ],
    web: 'https://sthela.com',
    sucursalesUrl: 'https://sthela.com/pages/ubicacion-y-horarios-de-las-sucursales',
    stats: [], quote: '', author: '', highlights: [], image: '',
  },
];
---

<BaseLayout
  title="Casos de éxito — Retailers que crecen con SACS"
  description="Marcas de moda reales que operan con SACS: del merch oficial de conciertos en estadios llenos a la moda femenina que se vende por mayoreo en Intermoda."
  structuredData={structuredData}
>

<!-- Hero -->
<section class="ce-hero">
  <div class="ce-hero-inner">
    <span class="ce-eyebrow">Casos de éxito</span>
    <h1 class="ce-hero-title">No venden una prenda. Venden <span class="ce-rot"><span>una forma de vestir.</span><span aria-hidden="true">una temporada.</span><span aria-hidden="true">un recuerdo.</span><span aria-hidden="true">una comunidad.</span></span></h1>
    <p class="ce-hero-subtitle">Trabajamos con empresarios que saben lo que hacen: líderes apasionados por su marca que construyen un ecosistema completo alrededor de ella. Por cómo hacen las cosas, sus marcas siguen creciendo.</p>
    <p class="ce-hero-proof"><span>Con ellos trabajamos:</span> <a href="#liveshow">Live Shows Merchandising</a> <a href="#sthela">Sthela &amp; Co.</a></p>
  </div>
</section>

<!-- Cases -->
{cases.map((c, idx) => c.estilo === 'moda-claro' ? (
  <section class="ce-claro" id={c.slug}>
    <div class="ce-claro-inner">
      <div class="ce-claro-head">
        <span class="ce-claro-tag">{c.tag}</span>
        <h2 class="ce-claro-brand"><img src={c.logo} alt={c.brand} width="1070" height="120" loading="lazy" /></h2>
        <p class="ce-claro-tagline">{c.tagline}</p>
      </div>
      <div class="ce-claro-reels">
        {c.videos?.map((v) => (
          <figure class={`ce-reel ${v.loop ? 'ce-reel--main' : ''}`}>
            {v.loop ? (
              <video autoplay muted loop playsinline preload="metadata" poster={v.poster} width="540" height="960"><source src={v.src} type="video/mp4" /></video>
            ) : (
              <video controls playsinline preload="none" poster={v.poster} width="540" height="960"><source src={v.src} type="video/mp4" /></video>
            )}
            <figcaption>{v.cap}</figcaption>
          </figure>
        ))}
      </div>
      <div class="ce-claro-body">
        <p class="ce-claro-desc">{c.desc}</p>
        <div class="ce-claro-hechos">
          {c.hechos?.map((h) => (
            <div class="ce-claro-hecho"><span class="ce-claro-hecho-num">{h.num}</span><span class="ce-claro-hecho-label">{h.label}</span></div>
          ))}
        </div>
      </div>
      <div class="ce-claro-points">
        {c.points?.map((pt, i) => (
          <div class="ce-claro-point">
            <span class="ce-claro-point-k">{String(i + 1).padStart(2, '0')} · {pt.k}</span>
            <h3>{pt.t}</h3>
            <p>{pt.d}</p>
          </div>
        ))}
      </div>
      <div class="ce-claro-foot">
        <div class="ce-claro-sucs">
          {c.sucursales?.map((sc) => (
            <div class="ce-claro-suc"><span class="ce-claro-suc-zona">{sc.zona}</span><strong>{sc.nombre}</strong><span>{sc.dir}</span></div>
          ))}
          <a href={c.sucursalesUrl} target="_blank" rel="noopener" class="ce-claro-suc ce-claro-suc--todas"><span class="ce-claro-suc-zona">Sucursales</span><strong>Ver todas →</strong><span>Ubicaciones y horarios</span></a>
        </div>
        <a href={c.web} target="_blank" rel="noopener" class="ce-claro-link">
          Conoce sthela.com
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
) : c.featured ? (
  <section class="ce-feat" id={c.slug}>
    <div class="ce-feat-inner">
      <div class="ce-feat-visual">
        <img src={c.image} alt={c.imageAlt} width="1080" height="1080" loading="eager" class="ce-feat-img-a" />
        <img src={c.image3} alt={c.image3Alt} width="1080" height="1080" loading="lazy" class="ce-feat-img-c" />
        <img src={c.image2} alt={c.image2Alt} width="1080" height="1080" loading="lazy" class="ce-feat-img-b" />
        <span class="ce-feat-badge">Lookbook de concierto</span>
      </div>
      <div class="ce-feat-content">
        <span class="ce-feat-tag">{c.tag}</span>
        <h2 class="ce-feat-brand">{c.brand}</h2>
        <p class="ce-feat-tagline">{c.tagline}</p>
        <p class="ce-feat-desc">{c.desc}</p>
        <div class="ce-feat-stats">
          {c.stats.map((s) => (
            <div class="ce-feat-stat"><span class="ce-feat-stat-num">{s.num}</span><span class="ce-feat-stat-label">{s.label}</span></div>
          ))}
        </div>
      </div>
    </div>
    <div class="ce-feat-points">
      {c.points?.map((pt, i) => (
        <div class="ce-feat-point">
          <span class="ce-feat-point-k">{String(i + 1).padStart(2, '0')} · {pt.k}</span>
          <h3>{pt.t}</h3>
          <p>{pt.d}</p>
        </div>
      ))}
    </div>
    <div class="ce-feat-foot">
      <blockquote class="ce-feat-quote">
        <p>{c.quote}</p>
        <cite>— {c.author}</cite>
      </blockquote>
      <a href={`/casos-de-exito/${c.slug}`} class="ce-feat-link">
        Entra a la historia completa
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
) : (
  <section class={`ce-case ${idx % 2 === 1 ? 'ce-case--alt' : ''}`} id={c.slug}>
    <div class="ce-case-inner">
      <div class="ce-case-visual">
        <div class="ce-case-img-wrap">
          <img src={c.image} alt={`${c.brand} — caso de éxito SACS`} width="600" height="500" loading="lazy" class="ce-case-img" />
        </div>
      </div>
      <div class="ce-case-content">
        <span class="ce-case-tag" style={`background:color-mix(in srgb, ${c.tagColor} 66%, #000); color:${c.tagTextColor || '#fff'};`}>{c.tag}</span>
        <h2 class="ce-case-brand">{c.brand}</h2>
        <p class="ce-case-tagline">{c.tagline}</p>
        <div class="ce-case-stats">
          {c.stats.map((s) => (
            <div class="ce-stat">
              <span class="ce-stat-num">{s.num}</span>
              <span class="ce-stat-label">{s.label}</span>
            </div>
          ))}
        </div>
        <blockquote class="ce-case-quote">
          <p>{c.quote}</p>
          <cite>— {c.author}</cite>
        </blockquote>
        <p class="ce-case-desc">{c.desc}</p>
        <ul class="ce-case-highlights">
          {c.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
        <a href={`/casos-de-exito/${c.slug}`} class="ce-case-link">
          Ver caso completo
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
))}

<!-- CTA -->
<section class="ce-cta">
  <div class="ce-cta-inner">
    <h2 class="ce-cta-title">Tu negocio puede ser el siguiente.</h2>
    <p class="ce-cta-subtitle">Configura SACS en 15 minutos. Sin tarjeta de crédito.</p>
    <div class="ce-cta-actions">
      <a href="/prueba-gratis" class="ce-cta-btn ce-cta-btn--primary">Empieza gratis</a>
      <a href="/contacto" class="ce-cta-btn ce-cta-btn--secondary">Agenda una demo</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  /* ── Hero: la palabra que cambia, sobre degradado rosa · morado · un toque naranja ── */
  .ce-hero {
    padding: clamp(120px, 14vw, 180px) 0 clamp(60px, 8vw, 100px);
    text-align: center;
    background:
      radial-gradient(ellipse 45% 55% at 6% 20%, rgba(219, 39, 119, 0.13), transparent 70%),
      radial-gradient(ellipse 45% 55% at 96% 30%, rgba(147, 51, 234, 0.12), transparent 70%),
      radial-gradient(ellipse 40% 35% at 55% 105%, rgba(249, 115, 22, 0.07), transparent 70%),
      #fff;
  }
  .ce-hero-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .ce-eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.4px;
    margin-bottom: 18px;
    background: linear-gradient(90deg, #DB2777, #9333EA 72%, #F97316);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ce-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 6.4vw, 4.6rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.045em;
    line-height: 1.04;
    margin: 0 auto 24px;
    max-width: 15ch;
    text-wrap: balance;
  }
  .ce-rot { display: inline-grid; vertical-align: bottom; }
  .ce-rot > span {
    grid-area: 1 / 1;
    background: linear-gradient(90deg, #DB2777, #9333EA 72%, #F97316);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0;
    animation: ce-rota 12s infinite;
  }
  .ce-rot > span:nth-child(2) { animation-delay: 3s; }
  .ce-rot > span:nth-child(3) { animation-delay: 6s; }
  .ce-rot > span:nth-child(4) { animation-delay: 9s; }
  @keyframes ce-rota {
    0% { opacity: 0; transform: translateY(0.45em); }
    4%, 22% { opacity: 1; transform: none; }
    26%, 100% { opacity: 0; transform: translateY(-0.45em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ce-rot > span { animation: none; }
    .ce-rot > span:first-child { opacity: 1; }
  }
  .ce-hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 640px;
    margin: 0 auto;
  }
  .ce-hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    margin: 32px 0 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }
  .ce-hero-proof a {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .ce-hero-proof a:hover { color: #9333EA; }
  @media (max-width: 560px) {
    .ce-hero-proof > span { flex-basis: 100%; }
  }

  /* ── Case Section ── */
  .ce-case {
    padding: clamp(60px, 8vw, 100px) 0;
    background: #fff;
    border-top: 1px solid rgba(0,0,0,0.04);
  }
  .ce-case--alt {
    background: var(--color-bg-primary);
  }
  .ce-case-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .ce-case--alt .ce-case-inner {
    direction: rtl;
  }
  .ce-case--alt .ce-case-inner > * {
    direction: ltr;
  }

  /* Visual */
  .ce-case-img-wrap {
    border-radius: 20px;
    overflow: hidden;
  }
  .ce-case-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 6 / 5;
  }

  /* Content */
  .ce-case-tag {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .ce-case-brand {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    margin: 12px 0 8px;
    line-height: 1.1;
  }
  .ce-case-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  /* Stats grid */
  .ce-case-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .ce-stat {
    background: var(--color-bg-secondary, #F5F3EE);
    border-radius: 12px;
    padding: 16px;
  }
  .ce-case--alt .ce-stat {
    background: #fff;
  }
  .ce-stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    display: block;
    line-height: 1;
  }
  .ce-stat-label {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-tertiary);
    margin-top: 4px;
    display: block;
  }

  /* Quote */
  .ce-case-quote {
    border-left: 3px solid var(--color-text-primary);
    padding-left: 20px;
    margin: 0 0 24px;
  }
  .ce-case-quote p {
    font-family: var(--font-body);
    font-size: 15px;
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .ce-case-quote cite {
    font-family: var(--font-body);
    font-size: 13px;
    font-style: normal;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  /* Description */
  .ce-case-desc {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  /* Highlights */
  .ce-case-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ce-case-highlights li {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-secondary);
    padding-left: 20px;
    position: relative;
  }
  .ce-case-highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-secondary-texto, #0E7A68);
    font-weight: 700;
  }

  /* Case link */
  .ce-case-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary-texto);
    text-decoration: none;
    margin-top: 20px;
    transition: gap 0.2s ease;
  }
  .ce-case-link:hover {
    gap: 10px;
  }


  /* ── Caso destacado (Live Shows): editorial de moda ── */
  .ce-feat { background: #0b0a10; color: #fff; padding: clamp(64px, 8vw, 110px) 0; }
  .ce-feat-inner, .ce-feat-points, .ce-feat-foot { max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }
  .ce-feat-inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
  .ce-feat-visual { position: relative; padding: 0 30% 12% 0; }
  .ce-feat-visual img { display: block; width: 100%; height: auto; object-fit: cover; }
  .ce-feat-img-a { aspect-ratio: 4 / 5; border-radius: 4px; }
  .ce-feat-img-b { position: absolute; right: 0; bottom: 0; width: 46% !important; aspect-ratio: 1; border-radius: 4px; border: 6px solid #0b0a10; }
  .ce-feat-img-c { position: absolute; right: 0; top: 0; width: 36% !important; aspect-ratio: 1; border-radius: 4px; }
  .ce-feat-badge { position: absolute; top: 16px; left: 16px; background: #fff; color: #0b0a10; font-family: var(--font-display); font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; padding: 8px 12px; }
  .ce-feat-tag { display: inline-block; font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #FF7AB6; border-bottom: 1px solid #FF7AB6; padding-bottom: 4px; }
  .ce-feat-brand { font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; color: #fff; margin: 18px 0 10px; }
  .ce-feat-tagline { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; color: #FF7AB6; margin: 0 0 18px; }
  .ce-feat-desc { font-family: var(--font-body); font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.72); margin: 0 0 28px; max-width: 520px; }
  .ce-feat-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(255,255,255,0.14); }
