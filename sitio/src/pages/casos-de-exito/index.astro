---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbCaso } from '../../lib/breadcrumb';

const structuredData = breadcrumbCaso();

const cases = [
  {
    slug: 'liveshow',
    featured: true,
    brand: 'Live Shows Merchandising',
    tagline: 'La moda que se vuelve recuerdo.',
    tag: 'Moda · Merch oficial',
    tagColor: '#C42A74',
    image: '/images/ls-guts-fans.webp',
    imageAlt: 'Fan con la sudadera oficial del GUTS World Tour frente a la pared de playeras',
    image2: '/images/ls-guts-tote.webp',
    image2Alt: 'Tote bag oficial de GUTS gallery',
    image3: '/images/ls-guts-experiencia.webp',
    image3Alt: 'Instalación iluminada de la experiencia GUTS gallery',
    stats: [
      { num: '2007', label: 'líderes del merch oficial' },
      { num: '8', label: 'países con oficina' },
      { num: '100+', label: 'puntos de venta a la vez' },
      { num: '150K+', label: 'transacciones sin error' },
    ],
    quote: '"En un concierto perdimos 20% de ventas en dos horas porque el sistema colapsó. Con SACS eso no vuelve a pasar."',
    author: 'Mariana López, Directora de Operaciones',
    desc: 'Playeras, sudaderas y prendas de corte especial con diseño propio y ediciones limitadas por ciudad y por fecha: la prenda con la que te llevas puesto al artista que te inspira.',
    points: [
      { k: 'La moda', t: 'Te pones la playera y vuelves a esa noche.', d: 'Diseño propio, cortes especiales y ediciones limitadas para fans que se visten como su artista.' },
      { k: 'El ritmo', t: 'Cada caja es una sucursal que no para de vender.', d: 'Más de 100 módulos cobrando a la vez, con varias ventas por segundo en un estadio lleno.' },
      { k: 'La seguridad', t: 'Ni una venta se pierde.', d: 'Si la señal se cae, se sigue cobrando y todo se sincroniza solo. 0% de ventas perdidas.' },
      { k: 'El sistema', t: 'Un evento entero dentro de SACS.', d: 'Inventario por módulo, traspasos en pleno evento, alertas de agotado y corte por vendedor.' },
    ],
    highlights: [],
  },
  {
    slug: 'sthela',
    estilo: 'moda-claro',
    brand: 'Sthela & Co.',
    logo: '/images/sthela-logo.webp',
    tag: 'Moda femenina · Fabricante y mayorista',
    tagline: 'Un vestido para cada ocasión.',
    desc: 'Sthela & Co. es una marca jalisciense de moda femenina que diseña sus propias colecciones cada año: ropa casual, vestidos de fiesta, zapatos y accesorios. Vende al público en sus boutiques y en línea, y por mayoreo a otras boutiques del país, que cada edición la buscan en Intermoda. Al frente, sus dueñas: fashion icons que presentan la colección ellas mismas.',
    hechos: [
      { num: 'Diseño propio', label: 'colecciones nuevas cada año' },
      { num: 'Intermoda', label: 'fabricante y mayorista cada edición' },
      { num: 'Menudeo + mayoreo', label: 'al público y a otras boutiques' },
      { num: 'Boutiques propias', label: 'en Jalisco, y su ropa en boutiques de todo el país' },
    ],
    points: [
      { k: 'El diseño', t: 'Su propia colección, cada temporada.', d: 'Del cardigan y la blusa camisera al pantalón de vestir y el blazer oversized: todo combina, en los tonos de la temporada.' },
      { k: 'El mayoreo', t: 'La pasarela de las boutiques.', d: 'En Intermoda, boutiques de todo el país eligen sus muestrarios y hacen pedido directo con la marca.' },
      { k: 'Las boutiques', t: 'Para cada ocasión, en persona.', d: 'De la ropa casual al vestido de fiesta, con zapatos y accesorios para cerrar el look.' },
      { k: 'En línea', t: 'La tienda que nunca cierra.', d: 'sthela.com, Instagram y Facebook, con las mismas colecciones que en tienda.' },
    ],
    sucursales: [
      { zona: 'Zapopan', nombre: 'Los Cubos', dir: 'Av. Ignacio L. Vallarta 4825' },
      { zona: 'Guadalajara', nombre: 'Providencia', dir: 'Rubén Darío 1356, local 17' },
    ],
    videos: [
      { src: '/videos/sthela-intermoda-coleccion.mp4', poster: '/videos/sthela-intermoda-coleccion-poster.webp', cap: 'La colección en Intermoda' },
      { src: '/videos/sthela-vestido-loop.mp4', poster: '/videos/sthela-vestido-loop-poster.webp', cap: 'Vestido de noche', loop: true },
      { src: '/videos/sthela-intermoda-equipo.mp4', poster: '/videos/sthela-intermoda-equipo-poster.webp', cap: 'El equipo, cierre de edición' },
    ],
    web: 'https://sthela.com',
    sucursalesUrl: 'https://sthela.com/pages/ubicacion-y-horarios-de-las-sucursales',
    stats: [], quote: '', author: '', highlights: [], image: '',
  },
  {
    slug: 'vende-tu-closet',
    estilo: 'lujo',
    brand: 'Vende Tu Clóset',
    tag: 'Lujo pre-loved · Consignación',
    lead: 'Vende Tu Clóset es una startup mexicana de consignación y venta de artículos de lujo pre-loved. Bolsas, ropa y accesorios de las grandes casas de moda, cada pieza revisada y autenticada antes de llegar a su nueva dueña.',
    historia: [
      { lugar: 'Coatepec, Veracruz', t: 'Nace en línea.', d: 'Instagram y TikTok hacen el resto: la confianza de sus clientes la lleva a crecer de forma exponencial.' },
      { lugar: 'Xalapa · febrero 2022', t: 'Corporativo y showroom.', d: 'En Torre JV, en la ciudad que la vio nacer.' },
      { lugar: 'Ciudad de México', t: 'A unos pasos de Masaryk.', d: 'Alejandro Dumas 135, Polanco: la avenida del lujo en México.' },
      { lugar: 'Guadalajara', t: 'Su tienda más grande.', d: 'A pocos minutos de Andares.' },
      { lugar: 'Monterrey', t: 'También en Nuevo León.', d: 'La expansión sigue.' },
    ],
    confianza: [
      { k: 'Certificación', d: 'Cada pieza se analiza y su autenticidad se verifica con la tecnología Entrupy.' },
      { k: 'Seguridad', d: 'Las compras están protegidas a través de su pasarela de pagos.' },
      { k: 'Atención', d: 'Todo su equipo está atento a cada solicitud, con una atención de calidad en todo momento.' },
    ],
    marcas: ['Chanel', 'Dior', 'Louis Vuitton', 'Hermès', 'Fendi', 'Prada', 'Saint Laurent', 'Bottega Veneta', 'Gucci', 'Balenciaga', 'Celine', 'Goyard', 'Cartier', 'Valentino'],
    ciudades: ['Ciudad de México', 'Xalapa', 'Guadalajara', 'Monterrey'],
    web: 'https://www.vtc.mx/',
    stats: [], quote: '', author: '', highlights: [], image: '',
  },
  {
    slug: 'las-alazanas',
    estilo: 'vaquero',
    brand: 'Talabartería Las Alazanas',
    tag: 'Ropa vaquera · Talabartería',
    lead: 'Las Alazanas viste a quienes viven el campo y el caballo todos los días. Sombreros de paja y fieltro, botas, camisas, cinturones y piezas de talabartería que salen de su propio taller, trabajadas a mano. Lo que venden es lo que viven: su equipo lleva la herradura de la marca en la espalda y su casa se llama #FamiliaAlazanas.',
    hechos: [
      { num: 'Taller propio', label: 'talabartería trabajada a mano' },
      { num: '4 sucursales', label: 'Edomex, Morelos y Yucatán' },
      { num: 'Tienda en línea', label: 'para quien vive lejos de una sucursal' },
    ],
    web: 'https://www.instagram.com/alazanast/',
    stats: [], quote: '', author: '', highlights: [], image: '',
  },
  {
    slug: 'mits',
    estilo: 'mits',
    brand: 'Mexico Is The Shit',
    tag: 'Moda mexicana · Hecho en México',
    lead: 'MITS es una marca hecha en México y pensada para recordarle al mundo que lo hecho en México está bien hecho. Del fútbol a la lucha libre, cada colección es una forma de expresar amor por la cultura mexicana, con un mensaje que se lleva puesto.',
    valores: ['Amor', 'Respeto', 'Confianza'],
    colecciones: ['Demasiado Fútbol', 'Lucha Libre x MITS', 'Sindicato Mexicano del Runner', 'MITS University', 'Mexico Is The Shit Racing', 'Demasiado Fino', 'Amor de MITS Amores'],
    web: 'https://mexicoistheshit.store/',
    stats: [], quote: '', author: '', highlights: [], image: '',
  },
];
---

<BaseLayout
  title="Casos de éxito — Retailers que crecen con SACS"
  description="Marcas de moda reales que operan con SACS: del merch oficial de conciertos en estadios llenos a la moda femenina que se vende por mayoreo en Intermoda."
  structuredData={structuredData}
>

<!-- Hero -->
<section class="ce-hero">
  <div class="ce-hero-inner">
    <span class="ce-eyebrow">Casos de éxito</span>
    <h1 class="ce-hero-title">No venden una prenda. Venden <span class="ce-rot"><span>una forma de vestir.</span><span aria-hidden="true">una temporada.</span><span aria-hidden="true">un recuerdo.</span><span aria-hidden="true">una comunidad.</span></span></h1>
    <p class="ce-hero-subtitle">Trabajamos con empresarios que saben lo que hacen: líderes apasionados por su marca que construyen un ecosistema completo alrededor de ella. Por cómo hacen las cosas, sus marcas siguen creciendo.</p>
    <p class="ce-hero-proof"><span>Con ellos trabajamos:</span> <a href="#liveshow">Live Shows Merchandising</a> <a href="#sthela">Sthela &amp; Co.</a> <a href="#vende-tu-closet">Vende Tu Clóset</a> <a href="#las-alazanas">Las Alazanas</a> <a href="#mits">Mexico Is The Shit</a></p>
  </div>
</section>

<!-- Cases -->
{cases.map((c, idx) => c.estilo === 'lujo' ? (
  <section class="ce-lujo" id={c.slug}>
    <div class="ce-lujo-inner">
      <div class="ce-lujo-top">
        <div class="ce-lujo-head">
          <img src="/images/vtc-logo-blanco.webp" alt="" width="287" height="220" loading="lazy" class="ce-lujo-mono" />
          <span class="ce-lujo-name">Vende Tu Clóset</span>
          <div class="ce-lujo-chips"><span class="ce-lujo-n1">Nº 1 en México</span><span class="ce-lujo-tag">{c.tag}</span></div>
          <h2 class="ce-lujo-title">La número 1 en lujo <em>pre&#8209;loved</em> de México.</h2>
          <p class="ce-lujo-lead">{c.lead}</p>
        </div>
        <div class="ce-lujo-fotos">
          <img src="/images/vtc-equipo.webp" alt="El equipo de Vende Tu Clóset en su stand, con bolsas de lujo en exhibición" width="1000" height="1248" loading="lazy" class="ce-lujo-foto-a" />
          <img src="/images/vtc-espejo.webp" alt="Clienta con vestido rojo frente al espejo «Good taste looks good on you» de Vende Tu Clóset" width="1000" height="1248" loading="lazy" class="ce-lujo-foto-b" />
        </div>
      </div>
    </div>
    <div class="ce-lujo-marcas" aria-label="Algunas de las casas que vende">
      <div class="ce-lujo-cinta">
        {[0, 1].map((n) => (
          <span class="ce-lujo-cinta-set" aria-hidden={n === 1 ? 'true' : undefined}>
            {c.marcas?.map((m) => <span>{m}</span>)}
          </span>
        ))}
      </div>
    </div>
    <div class="ce-lujo-inner">
      <div class="ce-lujo-puntos">
        <div class="ce-lujo-pilar"><h4>Su historia</h4><p>De vender en línea desde Coatepec, Veracruz, a cuatro sucursales a pasos de Masaryk, Andares y San Pedro.</p></div>
        <div class="ce-lujo-pilar"><h4>Cómo venden</h4><p>Instagram, TikTok, WhatsApp, su tienda en línea y sus showrooms: una pieza única en cuatro vitrinas.</p></div>
        <div class="ce-lujo-pilar"><h4>La confianza</h4><p>Cada pieza autenticada con Entrupy, consignación a 45 días y compras protegidas.</p></div>
      </div>
      <div class="ce-lujo-foot">
        <div class="ce-lujo-ciudades">
          <span class="ce-lujo-lugar">4 sucursales</span>
          <p>{c.ciudades?.join('\u00a0· ')}</p>
        </div>
        <a href={`/casos-de-exito/${c.slug}`} class="ce-lujo-link">
          Ver más de Vende Tu Clóset
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
) : c.estilo === 'mits' ? (
  <section class="ce-mits" id={c.slug}>
    <div class="ce-mits-inner">
      <div class="ce-mits-top">
        <div class="ce-mits-head">
          <span class="ce-mits-marca">MEXICO <span>IS THE</span> SHIT</span>
          <span class="ce-mits-tag">{c.tag}</span>
          <h2 class="ce-mits-title">¿Quién dice que en México no hay <em>moda y sentido de conciencia?</em></h2>
          <p class="ce-mits-lead">{c.lead}</p>
          <div class="ce-mits-valores" aria-label="Sus valores">
            {c.valores?.map((v) => <span>{v}</span>)}
          </div>
          <p class="ce-mits-lema">Amor, respeto y confianza: eso es MITS.</p>
        </div>
        <div class="ce-mits-mosaico">
          <img src="/images/mits-mujeres-espalda.webp" alt="Mujer con la playera «Mujeres en la lucha» de MITS frente a la pantalla de la colección" width="1000" height="1333" loading="lazy" class="ce-mits-foto ce-mits-foto--alta" />
          <figure class="ce-mits-reel">
            <video autoplay muted loop playsinline preload="none" poster="/videos/mits-cultura-poster.webp" width="540" height="960"><source src="/videos/mits-cultura.mp4" type="video/mp4" /></video>
          </figure>
          <img src="/images/mits-poncho.webp" alt="Mujer en la barra con el poncho «Mexico Is The Shit»" width="900" height="1200" loading="lazy" class="ce-mits-foto" />
        </div>
      </div>
    </div>
    <div class="ce-mits-greca" aria-hidden="true"></div>
    <div class="ce-mits-cinta" aria-label="Algunas de sus colecciones">
      <div class="ce-mits-cinta-track">
        {[0, 1].map((n) => (
          <span class="ce-mits-cinta-set" aria-hidden={n === 1 ? 'true' : undefined}>{c.colecciones?.map((m) => <span>{m}</span>)}</span>
        ))}
      </div>
    </div>
    <div class="ce-mits-inner">
      <div class="ce-mits-foot">
        <a href={`/casos-de-exito/${c.slug}`} class="ce-mits-mas">
          Conoce más de MITS
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href={c.web} target="_blank" rel="noopener" class="ce-mits-link">
          mexicoistheshit.store
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <span class="ce-mits-spread">Hecho en México · Spread the word</span>
      </div>
    </div>
  </section>
) : c.estilo === 'vaquero' ? (
  <section class="ce-vaq" id={c.slug}>
    <div class="ce-vaq-inner">
      <div class="ce-vaq-top">
        <div class="ce-vaq-head">
          <div class="ce-vaq-marca">
            <img src="/images/alazanas-logo.webp" alt="" width="213" height="203" loading="lazy" class="ce-vaq-logo" />
            <span class="ce-vaq-name">{c.brand}</span>
          </div>
          <span class="ce-vaq-tag">{c.tag}</span>
          <h2 class="ce-vaq-title">Ser vaquero no es una moda. <em>Es una forma de vivir.</em></h2>
          <p class="ce-vaq-lead">{c.lead}</p>
          <div class="ce-vaq-hechos">
            {c.hechos?.map((h) => (
              <div class="ce-vaq-hecho"><span class="ce-vaq-hecho-num">{h.num}</span><span class="ce-vaq-hecho-label">{h.label}</span></div>
            ))}
          </div>
        </div>
        <div class="ce-vaq-mosaico">
          <figure class="ce-vaq-taller">
            <div class="ce-vaq-piel">
              <video autoplay muted loop playsinline preload="metadata" poster="/videos/alazanas-taller-poster.webp" width="540" height="960"><source src="/videos/alazanas-taller.mp4" type="video/mp4" /></video>
            </div>
            <figcaption>Taller Alazanas · piel trabajada a mano</figcaption>
            <span class="ce-vaq-sello" aria-hidden="true">
              <svg viewBox="0 0 120 120" class="ce-vaq-sello-giro"><defs><path id="ce-vaq-circulo" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs><text><textPath href="#ce-vaq-circulo">#FAMILIAALAZANAS · TALABARTERÍA · TALLER PROPIO ·</textPath></text></svg>
              <img src="/images/alazanas-logo.webp" alt="" width="213" height="203" loading="lazy" />
            </span>
          </figure>
          <img src="/images/alazanas-sombreros.webp" alt="Pared de sombreros de paja y fieltro en Las Alazanas" width="900" height="1200" loading="lazy" class="ce-vaq-foto ce-vaq-foto--alta" />
          <img src="/images/alazanas-cliente.webp" alt="Cliente con sombrero negro y camisa de Las Alazanas recorriendo la tienda" width="900" height="973" loading="lazy" class="ce-vaq-foto" />
          <figure class="ce-vaq-reel">
            <video autoplay muted loop playsinline preload="none" poster="/videos/alazanas-tienda-poster.webp" width="540" height="960"><source src="/videos/alazanas-tienda.mp4" type="video/mp4" /></video>
          </figure>
        </div>
      </div>
      <div class="ce-vaq-foot">
        <a href={`/casos-de-exito/${c.slug}`} class="ce-vaq-mas">
          Conoce más de Las Alazanas
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href={c.web} target="_blank" rel="noopener" class="ce-vaq-link">
          Síguelos en Instagram
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
) : c.estilo === 'moda-claro' ? (
  <section class="ce-claro" id={c.slug}>
    <div class="ce-claro-inner">
      <div class="ce-claro-head">
        <span class="ce-claro-tag">{c.tag}</span>
        <h2 class="ce-claro-brand"><img src={c.logo} alt={c.brand} width="1070" height="120" loading="lazy" /></h2>
        <p class="ce-claro-tagline">{c.tagline}</p>
      </div>
      <div class="ce-claro-reels">
        {c.videos?.map((v) => (
          <figure class={`ce-reel ${v.loop ? 'ce-reel--main' : ''}`}>
            {v.loop ? (
              <video autoplay muted loop playsinline preload="metadata" poster={v.poster} width="540" height="960"><source src={v.src} type="video/mp4" /></video>
            ) : (
              <video controls playsinline preload="none" poster={v.poster} width="540" height="960"><source src={v.src} type="video/mp4" /></video>
            )}
            <figcaption>{v.cap}</figcaption>
          </figure>
        ))}
      </div>
      <div class="ce-claro-body">
        <p class="ce-claro-desc">{c.desc}</p>
        <div class="ce-claro-hechos">
          {c.hechos?.map((h) => (
            <div class="ce-claro-hecho"><span class="ce-claro-hecho-num">{h.num}</span><span class="ce-claro-hecho-label">{h.label}</span></div>
          ))}
        </div>
      </div>
      <div class="ce-claro-points">
        {c.points?.map((pt, i) => (
          <div class="ce-claro-point">
            <span class="ce-claro-point-k">{String(i + 1).padStart(2, '0')} · {pt.k}</span>
            <h3>{pt.t}</h3>
            <p>{pt.d}</p>
          </div>
        ))}
      </div>
      <div class="ce-claro-foot">
        <div class="ce-claro-sucs">
          {c.sucursales?.map((sc) => (
            <div class="ce-claro-suc"><span class="ce-claro-suc-zona">{sc.zona}</span><strong>{sc.nombre}</strong><span>{sc.dir}</span></div>
          ))}
          <a href={c.sucursalesUrl} target="_blank" rel="noopener" class="ce-claro-suc ce-claro-suc--todas"><span class="ce-claro-suc-zona">Sucursales</span><strong>Ver todas →</strong><span>Ubicaciones y horarios</span></a>
        </div>
        <a href={c.web} target="_blank" rel="noopener" class="ce-claro-link">
          Conoce sthela.com
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
) : c.featured ? (
  <section class="ce-feat" id={c.slug}>
    <div class="ce-feat-inner">
      <div class="ce-feat-visual">
        <img src={c.image} alt={c.imageAlt} width="1080" height="1080" loading="eager" class="ce-feat-img-a" />
        <img src={c.image3} alt={c.image3Alt} width="1080" height="1080" loading="lazy" class="ce-feat-img-c" />
        <img src={c.image2} alt={c.image2Alt} width="1080" height="1080" loading="lazy" class="ce-feat-img-b" />
        <span class="ce-feat-badge">Lookbook de concierto</span>
      </div>
      <div class="ce-feat-content">
        <span class="ce-feat-tag">{c.tag}</span>
        <h2 class="ce-feat-brand">{c.brand}</h2>
        <p class="ce-feat-tagline">{c.tagline}</p>
        <p class="ce-feat-desc">{c.desc}</p>
        <div class="ce-feat-stats">
          {c.stats.map((s) => (
            <div class="ce-feat-stat"><span class="ce-feat-stat-num">{s.num}</span><span class="ce-feat-stat-label">{s.label}</span></div>
          ))}
        </div>
      </div>
    </div>
    <div class="ce-feat-points">
      {c.points?.map((pt, i) => (
        <div class="ce-feat-point">
          <span class="ce-feat-point-k">{String(i + 1).padStart(2, '0')} · {pt.k}</span>
          <h3>{pt.t}</h3>
          <p>{pt.d}</p>
        </div>
      ))}
    </div>
    <div class="ce-feat-foot">
      <blockquote class="ce-feat-quote">
        <p>{c.quote}</p>
        <cite>— {c.author}</cite>
      </blockquote>
