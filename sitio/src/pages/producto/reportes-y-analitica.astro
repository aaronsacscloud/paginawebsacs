---
/**
 * /producto/reportes-y-analitica — rediseño con la línea de los plugins (5-oct-2026), como las páginas de «Vende»:
 * «solo dejamos la parte del video inicial» y lo demás nuevo, cambiando entre secciones la entrada y las animaciones.
 *
 * Recorrido: el video de siempre (ProductoHeroVideo) → todo lo que incluye → una pregunta, una respuesta con el scroll
 * (la pregunta se escribe sola y la pantalla real que la contesta) → el reporte en cuatro pasos → la talla que sí se
 * vende → ABC de moda, edad y GMROI → qué rematar → las rutinas de AXO que llegan por correo → el dashboard → cada prenda
 * vendida → lo que deja de pasar → preguntas → cierre.
 * Qué existe y qué no, y de dónde salen las pantallas: src/data/producto-reportes.ts.
 * Esta página estática le gana a src/pages/producto/[slug].astro para «reportes-y-analitica».
 *
 * 18-oct-2026: se quitaron RepRutinas, RepTablero y RepPrenda — el respaldo del VPS (a0d083c) subió la página
 * pero NO esos tres componentes, y el build completo del sitio fallaba. Regresan cuando se suban los archivos.
 */
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductoHeroVideo from '../../components/producto/ProductoHeroVideo.astro';
import VendeIncluye from '../../components/producto/comun/VendeIncluye.astro';
import ExpLista from '../../components/experiencia/ExpLista.astro';
import RepPregunta from '../../components/producto/reportes/RepPregunta.astro';
import RepArma from '../../components/producto/reportes/RepArma.astro';
import RepTalla from '../../components/producto/reportes/RepTalla.astro';
import RepAbc from '../../components/producto/reportes/RepAbc.astro';
import RepLiquida from '../../components/producto/reportes/RepLiquida.astro';
import GiroFAQ from '../../components/giros/GiroFAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getFeatureBySlug, getPillarForFeature } from '../../data/product';
import { pageContent } from '../../data/product-pages';
import { INCLUYE, RESUELVE, PREGUNTAS } from '../../data/producto-reportes';
import '../../styles/planeacion.css';

const slug = 'reportes-y-analitica';
const feature = getFeatureBySlug(slug)!;
const pillar = getPillarForFeature(slug)!;
const hero = pageContent[slug].hero;
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: PREGUNTAS.map((p) => ({ '@type': 'Question', name: p.question, acceptedAnswer: { '@type': 'Answer', text: p.answer } })) };
---
<ProductLayout title={feature.title} description={feature.description} currentSlug={slug} currentPillar={pillar.id} preloadImage={hero.videoPoster || hero.image}>
  <StructuredData data={faqSchema} />
  <ProductoHeroVideo titulo={hero.title} video={hero.video} poster={hero.videoPoster} imagen={hero.image} alt={hero.imageAlt} />

  <div class="pd exp">
    <div id="rep-incluye"><VendeIncluye folio={INCLUYE.folio} titulo={INCLUYE.titulo} intro={INCLUYE.intro} piezas={INCLUYE.piezas} /></div>
    <RepPregunta />
    <RepArma />
    <RepTalla />
    <RepAbc />
    <RepLiquida />
    <ExpLista id="rep-resuelve" tema="pd-fucsia" palabra="LO QUE RESUELVE" folio={RESUELVE.folio} titulo={RESUELVE.titulo} puntos={RESUELVE.puntos} />
  </div>

  <GiroFAQ title="Preguntas frecuentes sobre reportes y analítica" faqs={PREGUNTAS} />
  <FinalCTA />
</ProductLayout>

<script>
  import { iniciaEscenas } from '../../scripts/experiencia/escenas';
  iniciaEscenas();

  // Las escenas pegadas van debajo de la barra de «Controla» (sticky en /producto/*): su altura va en --sub.
  (() => {
    const sub = document.getElementById('product-subnav');
    if (!sub) return;
    const pon = () => document.documentElement.style.setProperty('--sub', Math.round(sub.getBoundingClientRect().height) + 'px');
    pon();
    new ResizeObserver(pon).observe(sub);
  })();

  // Lo que entra al verse (sin JS se ve completo).
  (() => {
    const rv = Array.from(document.querySelectorAll<HTMLElement>('.exp .rv'));
    if (!rv.length || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('js-rv');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    rv.forEach((el) => io.observe(el));
  })();

  const ph = (evento: string, props?: Record<string, unknown>) => { try { (window as any).sacsPH?.(evento, props); } catch { /* sin medición */ } };
  document.querySelector('.final-cta-btn')?.addEventListener('click', () => ph('producto_cta_prueba', { producto: 'reportes-y-analitica' }));
</script>
