---
/**
 * /producto/tienda-en-linea — rediseño con la línea de los plugins (5-oct-2026), como /producto/punto-de-venta:
 * «solo dejamos la parte del video inicial» (aquí, la portada animada: TiendaHero) y lo demás nuevo, cambiando entre
 * secciones la entrada y las animaciones.
 *
 * Recorrido: la portada de siempre → todo lo que incluye → del clic a sus manos con el scroll (las pantallas reales de la
 * tienda en el celular) → su cuenta → el probador virtual → el editor y tu dominio → un solo inventario → vende más →
 * métricas → lo que deja de pasar → preguntas → cierre.
 * Qué existe y de dónde salen las pantallas: src/data/producto-tienda.ts.
 * Esta página estática le gana a src/pages/producto/[slug].astro para «tienda-en-linea».
 */
import ProductLayout from '../../layouts/ProductLayout.astro';
import TiendaHero from '../../components/producto/tienda/TiendaHero.astro';
import VendeIncluye from '../../components/producto/comun/VendeIncluye.astro';
import ExpLista from '../../components/experiencia/ExpLista.astro';
import TieCamino from '../../components/producto/tienda/TieCamino.astro';
import TieCuenta from '../../components/producto/tienda/TieCuenta.astro';
import ProbadorVirtual from '../../components/squarespace/ProbadorVirtual.astro';
import TieEditor from '../../components/producto/tienda/TieEditor.astro';
import TieInventario from '../../components/producto/tienda/TieInventario.astro';
import TieVende from '../../components/producto/tienda/TieVende.astro';
import TieMetricas from '../../components/producto/tienda/TieMetricas.astro';
import GiroFAQ from '../../components/giros/GiroFAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getFeatureBySlug, getPillarForFeature } from '../../data/product';
import { pageContent } from '../../data/product-pages';
import { INCLUYE, RESUELVE, PREGUNTAS } from '../../data/producto-tienda';
import '../../styles/planeacion.css';

const slug = 'tienda-en-linea';
const feature = getFeatureBySlug(slug)!;
const pillar = getPillarForFeature(slug)!;
const hero = pageContent[slug].hero;
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: PREGUNTAS.map((p) => ({ '@type': 'Question', name: p.question, acceptedAnswer: { '@type': 'Answer', text: p.answer } })) };
---
<ProductLayout title={feature.title} description={feature.description} currentSlug={slug} currentPillar={pillar.id} preloadImage="/images/cm-boutique.webp">
  <StructuredData data={faqSchema} />
  <TiendaHero titulo={hero.title} subtitulo={hero.subtitle} />

  <div class="pd exp">
    <div id="tie-incluye"><VendeIncluye folio={INCLUYE.folio} titulo={INCLUYE.titulo} intro={INCLUYE.intro} piezas={INCLUYE.piezas} /></div>
    <TieCamino />
    <TieCuenta />
    <ProbadorVirtual />
    <TieEditor />
    <TieInventario />
    <TieVende />
    <TieMetricas />
    <ExpLista id="tie-resuelve" tema="pd-azul" palabra="LO QUE RESUELVE" folio={RESUELVE.folio} titulo={RESUELVE.titulo} puntos={RESUELVE.puntos} />
  </div>

  <GiroFAQ title="Preguntas frecuentes sobre la tienda en línea" faqs={PREGUNTAS} />
  <FinalCTA />
</ProductLayout>

<script>
  import { iniciaEscenas } from '../../scripts/experiencia/escenas';
  iniciaEscenas();

  // Las escenas pegadas van debajo de la barra de «Vende» (sticky en /producto/*): su altura va en --sub.
  (() => {
    const sub = document.getElementById('product-subnav');
    if (!sub) return;
    const pon = () => document.documentElement.style.setProperty('--sub', Math.round(sub.getBoundingClientRect().height) + 'px');
    pon();
    new ResizeObserver(pon).observe(sub);
  })();

  // Lo que entra al verse (sin JS se ve completo).
  (() => {
    const rv = Array.from(document.querySelectorAll<HTMLElement>('.exp .rv'));
    if (!rv.length || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('js-rv');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    rv.forEach((el) => io.observe(el));
  })();

  const ph = (evento: string, props?: Record<string, unknown>) => { try { (window as any).sacsPH?.(evento, props); } catch { /* sin medición */ } };
  document.querySelector('.final-cta-btn')?.addEventListener('click', () => ph('producto_cta_prueba', { producto: 'tienda-en-linea' }));
</script>
