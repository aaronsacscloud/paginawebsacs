---
/**
 * /producto/social-commerce — rediseño con la línea de los plugins (5-oct-2026), como /producto/punto-de-venta. Esta
 * página no tenía video: el iPad de arriba lleva la imagen de una dinámica en vivo dibujada con el diseño de Sacs.
 *
 * Recorrido: la portada → todo lo que incluye → una dinámica en vivo con el scroll → WhatsApp → los catálogos (el panel
 * de TikTok Shop por dentro y Facebook/Instagram) → ventas por canal → contenido para redes → lo que deja de pasar →
 * preguntas → cierre. Qué existe y qué se presenta como visión: src/data/producto-social.ts.
 * Esta página estática le gana a src/pages/producto/[slug].astro para «social-commerce».
 */
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductoHeroVideo from '../../components/producto/ProductoHeroVideo.astro';
import VendeIncluye from '../../components/producto/comun/VendeIncluye.astro';
import ExpLista from '../../components/experiencia/ExpLista.astro';
import SocVivo from '../../components/producto/social/SocVivo.astro';
import SocWhats from '../../components/producto/social/SocWhats.astro';
import SocCatalogo from '../../components/producto/social/SocCatalogo.astro';
import SocCanal from '../../components/producto/social/SocCanal.astro';
import SocContenido from '../../components/producto/social/SocContenido.astro';
import GiroFAQ from '../../components/giros/GiroFAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getFeatureBySlug, getPillarForFeature } from '../../data/product';
import { pageContent } from '../../data/product-pages';
import { INCLUYE, RESUELVE, PREGUNTAS, I } from '../../data/producto-social';
import '../../styles/planeacion.css';

const slug = 'social-commerce';
const HERO_IMG = `${I}hero-dinamica.webp`;
const feature = getFeatureBySlug(slug)!;
const pillar = getPillarForFeature(slug)!;
const hero = pageContent[slug].hero;
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: PREGUNTAS.map((p) => ({ '@type': 'Question', name: p.question, acceptedAnswer: { '@type': 'Answer', text: p.answer } })) };
---
<ProductLayout title={feature.title} description={feature.description} currentSlug={slug} currentPillar={pillar.id} preloadImage={HERO_IMG}>
  <StructuredData data={faqSchema} />
  <ProductoHeroVideo titulo={hero.title} imagen={HERO_IMG} alt="Dinámicas de Redes en Sacs: un live en Instagram con sus comentarios y las prendas de la dinámica, cada una con «Crear pedido» y «Crear apartado»" />

  <div class="pd exp">
    <div id="soc-incluye"><VendeIncluye folio={INCLUYE.folio} titulo={INCLUYE.titulo} intro={INCLUYE.intro} piezas={INCLUYE.piezas} /></div>
    <SocVivo />
    <SocWhats />
    <SocCatalogo />
    <SocCanal />
    <SocContenido />
    <ExpLista id="soc-resuelve" tema="pd-negro" palabra="LO QUE RESUELVE" folio={RESUELVE.folio} titulo={RESUELVE.titulo} puntos={RESUELVE.puntos} />
  </div>

  <GiroFAQ title="Preguntas frecuentes sobre Social & WhatsApp Commerce" faqs={PREGUNTAS} />
  <FinalCTA />
</ProductLayout>

<script>
  import { iniciaEscenas } from '../../scripts/experiencia/escenas';
  iniciaEscenas();

  // Las escenas pegadas van debajo de la barra de «Vende» (sticky en /producto/*): su altura va en --sub.
  (() => {
    const sub = document.getElementById('product-subnav');
    if (!sub) return;
    const pon = () => document.documentElement.style.setProperty('--sub', Math.round(sub.getBoundingClientRect().height) + 'px');
    pon();
    new ResizeObserver(pon).observe(sub);
  })();

  // Lo que entra al verse (sin JS se ve completo).
  (() => {
    const rv = Array.from(document.querySelectorAll<HTMLElement>('.exp .rv'));
    if (!rv.length || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('js-rv');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    rv.forEach((el) => io.observe(el));
  })();

  const ph = (evento: string, props?: Record<string, unknown>) => { try { (window as any).sacsPH?.(evento, props); } catch { /* sin medición */ } };
  document.querySelector('.final-cta-btn')?.addEventListener('click', () => ph('producto_cta_prueba', { producto: 'social-commerce' }));
</script>
