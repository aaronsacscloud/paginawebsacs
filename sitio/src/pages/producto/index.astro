---
/**
 * /producto — el índice de todo lo que Sacs hace.
 *
 * Existía como un andamio vacío desde el arranque del sitio: un archivo con el
 * comentario «el contenido irá aquí» dentro, publicado, indexable y en el
 * sitemap. El `/llms.txt` viejo incluso mandaba a los rastreadores de IA aquí
 * como una de las páginas clave del sitio. Lo cazó el motor de demanda al
 * contar las palabras REALES de cada página (sin el menú ni el pie).
 *
 * Por qué una página hub y no un redirect a /planes: hay veintiocho páginas de
 * función colgando de /producto/[slug] y ninguna página que las una. Un hub
 * concentra el tema —lo que un buscador entiende como autoridad sobre una
 * categoría— y le da a una IA un solo lugar del que sacar «qué hace este
 * software», en vez de veintiocho respuestas sueltas.
 *
 * Todo el contenido sale de src/data/product.ts, que ya describía cada función.
 * No se inventó nada: lo que faltaba era la página que lo mostrara junto.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pillars } from '../../data/product';
import { SITIO } from '../../data/entidad';

const total = pillars.reduce((n, p) => n + p.features.length, 0);

// El índice de funciones, para que un buscador y un modelo puedan leer la lista
// entera sin recorrer veintiocho páginas.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Funciones de Sacs',
  numberOfItems: total,
  itemListElement: pillars.flatMap((p, i) =>
    p.features.map((f, j) => ({
      '@type': 'ListItem',
      position: i * 100 + j + 1,
      name: f.label,
      description: f.description,
      url: `${SITIO}/producto/${f.slug}`,
    }))),
};
---

<BaseLayout
  title="Todo lo que hace Sacs para tiendas de moda"
  description={`Las ${total} funciones de Sacs para moda en cuatro etapas: vender, controlar, fidelizar y automatizar. Inventario por talla y color, tienda en línea y mayoreo.`}
  structuredData={schema}
>
  <section class="pr-cab">
    <div class="pr-wrap">
      <p class="pr-eyebrow">Producto</p>
      <h1>Todo lo que hace Sacs</h1>
      <p class="pr-sub">
        {total} funciones sobre una sola base de datos. No son módulos que se conectan entre sí:
        es un sistema donde una venta ya descontó el inventario de esa sucursal, actualizó la
        tienda en línea y movió el costo al resultado del mes.
      </p>
    </div>
  </section>

  {pillars.map((p) => (
    <section class="pr-pilar">
      <div class="pr-wrap">
        <header>
          <span class="pr-num" style={`--c:${p.color}`}>{p.num}</span>
          <h2>{p.verb}</h2>
          <p>{p.description}</p>
        </header>
        <ul class="pr-lista">
          {p.features.map((f) => (
            <li>
              <a href={`/producto/${f.slug}`}>
                <strong>{f.label}</strong>
                <span>{f.description}</span>
                {f.status === 'coming-soon' && <em>En camino</em>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="pr-pie">
    <div class="pr-wrap">
      <h2>¿Cuál de estas necesitas?</h2>
      <p>Depende de cómo operas y qué vendes. En una llamada de veinte minutos te decimos cuáles te sirven y cuáles no.</p>
      <div class="pr-botones">
        <a class="pr-b pr-b1" href="/contacto">Agendar una demostración</a>
        <a class="pr-b pr-b2" href="/planes">Ver planes y precios</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pr-wrap { max-width: 1100px; margin: 0 auto; padding: 0 var(--space-6); }
  @media (max-width: 640px) { .pr-wrap { padding: 0 var(--space-4); } }

  /* El nav es fijo y no empuja: con --space-20 pelado el eyebrow «PRODUCTO»
     salía cortado por la barra. Medido con navegador el 17-sep-2026. */
  .pr-cab { padding: calc(var(--nav-alto) + var(--space-8)) 0 var(--space-12); background: var(--gradient-cream); }
  .pr-eyebrow { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; color: var(--color-text-secondary); margin: 0 0 var(--space-3); }
  .pr-cab h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 6vw, 3.5rem); line-height: 1.05; letter-spacing: -.02em; margin: 0 0 var(--space-5); text-wrap: balance; }
  .pr-sub { font-size: 1.125rem; line-height: 1.65; color: var(--color-text-secondary); max-width: 62ch; margin: 0; }

  .pr-pilar { padding: var(--space-12) 0; border-top: 1px solid var(--color-border-light); }
  .pr-pilar header { display: grid; gap: var(--space-2); margin-bottom: var(--space-8); }
  .pr-num {
    width: 34px; height: 34px; border-radius: 50%; background: var(--c); color: #fff;
    display: grid; place-items: center; font-weight: 700; font-size: .875rem;
  }
  .pr-pilar h2 { font-family: var(--font-display); font-size: 1.875rem; margin: 0; letter-spacing: -.01em; }
  .pr-pilar header p { margin: 0; color: var(--color-text-secondary); }

  .pr-lista { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .pr-lista a {
    display: grid; gap: var(--space-1); text-decoration: none; height: 100%;
    padding: var(--space-5); border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg); background: #fff; transition: border-color .15s, transform .15s;
  }
  .pr-lista a:hover { border-color: var(--color-primary-texto); transform: translateY(-2px); }
  .pr-lista strong { font-size: 1.0625rem; color: var(--color-text-primary); }
  .pr-lista span { font-size: .9375rem; line-height: 1.55; color: var(--color-text-secondary); }
  .pr-lista em {
    font-style: normal; font-size: .6875rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--aviso-texto); background: var(--aviso-fondo); padding: 2px 8px; border-radius: 5px; justify-self: start; margin-top: var(--space-1);
  }

  .pr-pie { padding: var(--space-16) 0 var(--space-24); border-top: 1px solid var(--color-border-light); }
  .pr-pie h2 { font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 var(--space-3); }
  .pr-pie p { color: var(--color-text-secondary); max-width: 58ch; margin: 0 0 var(--space-6); }
  .pr-botones { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .pr-b { display: inline-block; padding: var(--space-3) var(--space-6); border-radius: var(--radius-full); font-weight: 600; text-decoration: none; font-size: .9375rem; }
  .pr-b1 { background: var(--color-primary-btn, #4470D8); color: #fff; }
  .pr-b1:hover { background: var(--color-primary-hover); }
  .pr-b2 { border: 1px solid var(--color-border); color: var(--color-text-primary); }
  .pr-b2:hover { border-color: var(--color-primary-texto); color: var(--color-primary-texto); }
</style>
