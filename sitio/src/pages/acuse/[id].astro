---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import { plans } from '../../data/plans';

export const prerender = false;

const { id } = Astro.params;
const isAdminMode = Astro.url.searchParams.has('admin');

const { data: payment } = await supabase.from('payments').select('*').eq('id', id).single();
if (!payment) return Astro.redirect('/404');

let quote: any = null;
let allPayments: any[] = [];
if (payment.quote_id) {
  const { data: q } = await supabase.from('quotes').select('id, numero, empresa, contacto, email, items, total, moneda, iva_incluido, created_at, estado, notas, company_id').eq('id', payment.quote_id).single();
  quote = q || null;
  const { data: pgs } = await supabase.from('payments').select('id, monto, fecha, numero_acuse, metodo').eq('quote_id', payment.quote_id).order('fecha', { ascending: true });
  allPayments = pgs || [];
}

// Pago de SUSCRIPCIÓN (renovación), sin cotización: armamos el recibo desde la
// sub + empresa + contacto.
let sub: any = null; let company: any = null; let contact: any = null;
if (!payment.quote_id && payment.subscription_id) {
  const { data: s } = await supabase.from('subscriptions').select('id, nombre_plan, ciclo, proxima_factura, company_id, contact_id').eq('id', payment.subscription_id).single();
  sub = s || null;
  if (sub?.company_id) { const { data: c } = await supabase.from('companies').select('nombre, sacs_account').eq('id', sub.company_id).single(); company = c || null; }
  const cid = payment.contact_id || sub?.contact_id;
  if (cid) { const { data: ct } = await supabase.from('contacts').select('nombre, apellido, email').eq('id', cid).single(); contact = ct || null; }
}
const pagadoPor = quote?.empresa || company?.nombre || '—';
const contactoNom = quote?.contacto || [contact?.nombre, contact?.apellido].filter(Boolean).join(' ').trim() || '';
const emailCli = quote?.email || contact?.email || '';
const CICLO_LBL: Record<string, string> = { mensual: 'Mensual', anual: 'Anual', vitalicia: 'Pago único' };

const fmt = (n: number) => '$' + Math.round(Number(n || 0)).toLocaleString('es-MX');
const fmtDecimal = (n: number) => Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtDate = (d: string | null) => {
  if (!d) return '—';
  const date = new Date(d.length === 10 ? d + 'T12:00:00' : d);
  if (isNaN(date.getTime())) return '—';
  const day = date.getDate();
  const month = date.toLocaleDateString('es-MX', { month: 'long' });
  const year = date.getFullYear();
  return `${day} de ${month} de ${year}`;
};

const metodoLabel: Record<string, string> = {
  transferencia: 'Transferencia bancaria',
  tarjeta: 'Tarjeta de crédito o débito',
  stripe: 'Tarjeta (Stripe)',
  stripe_subscription: 'Suscripción recurrente (Stripe)',
  efectivo: 'Efectivo',
  oxxo: 'OXXO',
  otro: 'Otro',
};
const metodoTexto = metodoLabel[payment.metodo] || payment.metodo || '—';

const monto = Number(payment.monto || 0);
const totalCotizacion = Number(quote?.total || 0);
const totalPagado = allPayments.reduce((s, p) => s + Number(p.monto || 0), 0);
const saldoRestante = Math.max(0, totalCotizacion - totalPagado);
const porcentajeCubierto = totalCotizacion > 0 ? Math.min(100, Math.round((totalPagado / totalCotizacion) * 100)) : 100;

const ivaIncluido = !!quote?.iva_incluido;
const subtotal = ivaIncluido ? monto / 1.16 : monto;
const ivaCalc = ivaIncluido ? monto - subtotal : 0;

const quoteItems = Array.isArray(quote?.items) ? quote.items : [];
let coveredItems: any[] = quoteItems;
if (Array.isArray(payment.items_cubiertos) && payment.items_cubiertos.length > 0) {
  const indices = new Set(payment.items_cubiertos.map((x: any) => Number(x)));
  const filtered = quoteItems.filter((_: any, i: number) => indices.has(i));
  if (filtered.length > 0) coveredItems = filtered;
}

const numeroPago = (() => {
  const idx = allPayments.findIndex(p => p.id === payment.id);
  return idx >= 0 ? idx + 1 : 1;
})();
const totalPagos = allPayments.length;

const acuseAbsoluteUrl = `https://www.sacscloud.com/acuse/${payment.id}`;
const cotizacionUrl = quote ? `/cotizacion/${quote.id}` : null;

/* ═══════════════════════════════════════════════════════════════════════════
   Lo que el cliente necesita saber además de "ya pagaste": cuándo es el
   próximo pago, cuántos días tiene y qué compró exactamente.
   ═══════════════════════════════════════════════════════════════════════════ */

// La plantilla. 'completa' trae el catálogo del plan renglón por renglón;
// 'limpia' resume por área y cabe en una hoja. Se elige con ?v=limpia al
// compartir; la predeterminada es la completa.
const plantilla = Astro.url.searchParams.get('v') === 'limpia' ? 'limpia' : 'completa';

// Los días naturales para pagar. Es una regla comercial, no una constante del
// documento: el día que sean 8, se cambia aquí y en el aviso de cobranza.
const DIAS_PARA_PAGAR = 5;

/** Suma días naturales a una fecha ISO y devuelve otra ISO (sin husos). */
function masDias(iso: string, n: number): string {
  const d = new Date(String(iso).slice(0, 10) + 'T12:00:00');
  d.setDate(d.getDate() + n);
  return d.toISOString().slice(0, 10);
}
const fmtCorto = (d?: string | null) => {
  if (!d) return '';
  const x = new Date(String(d).slice(0, 10) + 'T12:00:00');
  if (isNaN(x.getTime())) return '';
  return `${x.getDate()}/${x.toLocaleDateString('es-MX', { month: 'short' }).replace('.', '')}/${x.getFullYear()}`;
};

// El plan que se compró: el renglón de la cotización manda; si el pago fue de
// una suscripción sin cotización, se toma de ahí.
const planItem = quoteItems.find((i: any) => i.tipo === 'plan') || null;
const planKey = String(planItem?.nombre || sub?.nombre_plan || '').toLowerCase();
const planData = plans.find(p => p.id === planKey) || null;
const sucursalesPlan = Number(planItem?.sucursales || company?.sucursales || 1) || 1;
const cicloPlan = planItem?.periodo || sub?.ciclo || '';

// El catálogo COMPLETO del plan, incluido lo que hereda del plan de abajo: es
// el mismo recorrido que hace la cotización, así no hay dos listas que
// mantener y lo que ve en el acuse es lo que le vendimos.
const areasPlan: { category: string; items: string[] }[] = [];
if (planData) {
  let cur: any = planData; const visto = new Set<string>();
  while (cur && !visto.has(cur.id)) {
    visto.add(cur.id);
    for (const f of cur.features) if (f && typeof f === 'object' && 'category' in f) areasPlan.push(f as any);
    cur = cur.inheritsFrom ? plans.find(p => p.name === cur.inheritsFrom) : undefined;
  }
  areasPlan.reverse();
}

// El tipo de acompañamiento que se le acordó. Vive en el campo del cliente
// (Configuración › Cuentas › Clientes) y por eso no todos lo tienen.
const ACOMP: Record<string, string> = {
  autogestion: 'Autogestión',
  basico: 'Acompañamiento básico',
  implementacion: 'Implementación asistida',
  consultoria_andy: 'Consultoría Andy',
};
let empresaCliente: any = company;
if (!empresaCliente && quote?.company_id) {
  const { data: c } = await supabase.from('companies').select('nombre, sucursales, propiedades').eq('id', quote.company_id).maybeSingle();
  empresaCliente = c || null;
}
const acompKey = String(empresaCliente?.propiedades?.tipo_acompanamiento || '');
const acompLabel = ACOMP[acompKey] || (acompKey ? acompKey : '');

/* El próximo pago. Dos casos distintos y la diferencia importa:
   · Queda saldo de la cotización → lo que sigue es la SIGUIENTE PARCIALIDAD,
     con la fecha que se pactó. Decirle "tu renovación es en un año" cuando
     debe una parcialidad la semana entrante sería engañarlo.
   · Está cubierta → lo que sigue es la RENOVACIÓN de su suscripción. */
let prox: { fecha: string; monto: number; concepto: string } | null = null;
if (quote && saldoRestante > 0.5) {
  // Las parcialidades acordadas viven en el meta de la cotización.
  try {
    const raw = String(quote.notas || '');
    const i = raw.indexOf('\n---META---\n');
    const meta = i >= 0 ? JSON.parse(raw.slice(i + 13)) : {};
    const planPagos: any[] = Array.isArray(meta?.plan_pagos) ? [...meta.plan_pagos] : [];
    planPagos.sort((a, b) => String(a.fecha).localeCompare(String(b.fecha)));
    let cubierto = totalPagado;
    for (const x of planPagos) {
      const m = Number(x.monto || 0);
      if (cubierto >= m - 0.01) { cubierto -= m; continue; }
      prox = { fecha: String(x.fecha).slice(0, 10), monto: Math.round((m - cubierto) * 100) / 100, concepto: String(x.concepto || 'Siguiente parcialidad') };
      break;
    }
  } catch { /* sin plan: se queda sin bloque */ }
} else {
  // Renovación: la suscripción que nació de esta venta.
  let subRenov: any = sub;
  if (!subRenov && quote?.company_id) {
    const { data: sr } = await supabase.from('subscriptions')
      .select('nombre_plan, ciclo, proxima_factura, monto_proximo')
      .eq('company_id', quote.company_id).in('estado', ['activa', 'programada', 'pendiente_pago'])
      .order('proxima_factura', { ascending: true }).limit(1).maybeSingle();
    subRenov = sr || null;
  }
  if (subRenov?.proxima_factura) {
    prox = {
      fecha: String(subRenov.proxima_factura).slice(0, 10),
      monto: Number(subRenov.monto_proximo || monto),
      concepto: `Renovación ${subRenov.ciclo === 'mensual' ? 'mensual' : 'anual'}${planData ? ' del Plan ' + planData.name : ''}`,
    };
  }
}
const proxLimite = prox ? masDias(prox.fecha, DIAS_PARA_PAGAR) : '';
---

<BaseLayout
  title={`Acuse de pago ${payment.numero_acuse} — SACS`}
  description={`Confirmación de pago por ${fmt(monto)} de ${pagadoPor}`}
  noindex={true}
  bareLayout={true}
>

<div class="acuse-page">

  {/* ─── Acciones flotantes (no print) ─── */}
  <div class="acuse-actions no-print">
    <button class="acuse-action acuse-action--primary" id="btn-print" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Imprimir / Descargar PDF</span>
    </button>
    {cotizacionUrl && (
      <a class="acuse-action" href={cotizacionUrl}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M14 3h7v7M10 21H3v-7M21 3l-9 9M3 21l9-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Ver cotización</span>
      </a>
    )}
    <button class="acuse-action" id="btn-copiar" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 13a5 5 0 007.5.5l3-3a5 5 0 00-7-7l-1.5 1.5" stroke-linecap="round"/><path d="M14 11a5 5 0 00-7.5-.5l-3 3a5 5 0 007 7L12 19" stroke-linecap="round"/></svg>
      <span>Copiar liga</span>
    </button>
    {isAdminMode && (
      <button class="acuse-action" id="btn-resend" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Enviar por correo</span>
      </button>
    )}
  </div>

  <div class="acuse-doc" id="acuse-doc">

    {/* ─── Header ─── */}
    <div class="acuse-cinta"></div>
    <header class="acuse-header">
      <div class="acuse-brand">
        <div class="acuse-brand-nom">Sacscloud</div>
        <div class="acuse-brand-firma">Acuse de pago · {payment.numero_acuse}</div>
      </div>
      <div class="acuse-meta">
        <div class="acuse-meta-eyebrow">{fmtDate(payment.fecha)}</div>
        <div class="acuse-meta-numero">{fmt(monto)} {quote?.moneda || 'MXN'}</div>
        <div class="acuse-meta-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Pago confirmado</span>
        </div>
      </div>
    </header>

    {/* ─── Cliente + Cotización ─── */}
    <section class="acuse-block acuse-parties">
      <div class="acuse-party">
        <div class="acuse-party-label">Pagado por</div>
        <div class="acuse-party-name">{pagadoPor}</div>
        {contactoNom && <div class="acuse-party-detail">{contactoNom}</div>}
        {emailCli && <div class="acuse-party-detail acuse-party-detail--mono">{emailCli}</div>}
      </div>
      {quote && (
        <div class="acuse-party">
          <div class="acuse-party-label">Cotización</div>
          <div class="acuse-party-name">{quote.numero}</div>
          <div class="acuse-party-detail">Emitida el {fmtDate(quote.created_at)}</div>
          <div class="acuse-party-detail acuse-party-detail--mono">
            <a href={`/cotizacion/${quote.id}`}>www.sacscloud.com/cotizacion/{quote.id.slice(0, 8)}…</a>
          </div>
        </div>
      )}
      {!quote && sub && (
        <div class="acuse-party">
          <div class="acuse-party-label">Suscripción</div>
          <div class="acuse-party-name">{sub.nombre_plan}</div>
          <div class="acuse-party-detail">{CICLO_LBL[sub.ciclo] || sub.ciclo}{payment.periodo_cubierto ? ` · periodo ${payment.periodo_cubierto}` : ''}</div>
          {sub.proxima_factura && <div class="acuse-party-detail">Próxima renovación: {fmtDate(sub.proxima_factura)}</div>}
        </div>
      )}
    </section>

    {/* ─── Tu próximo pago ───
        Lo primero que un cliente pregunta después de "¿ya quedó?" es "¿y
        cuándo es el siguiente?". Va arriba de los detalles del pago por eso. */}
    {prox && (
      <section class="acuse-prox">
        <div class="acuse-prox-main">
          <div class="acuse-prox-k">Tu próximo pago</div>
          <div class="acuse-prox-fecha">{fmtDate(prox.fecha)}</div>
          <div class="acuse-prox-sub">{prox.concepto} · {fmt(prox.monto)} {quote?.moneda || 'MXN'}</div>
        </div>
        <div class="acuse-prox-ventana">
          <div class="acuse-prox-dias">{DIAS_PARA_PAGAR} días</div>
          <div class="acuse-prox-dias-t">naturales para pagar</div>
        </div>
        <div class="acuse-prox-nota">
          Del <b>{fmtCorto(prox.fecha)}</b> al <b>{fmtDate(proxLimite)}</b>. Después de esa fecha el servicio puede
          suspenderse hasta regularizar el pago.
        </div>
      </section>
    )}

    {/* ─── Datos del pago ─── */}
    <section class="acuse-block acuse-payment">
      <div class="acuse-section-title">Detalles del pago</div>
      <table class="acuse-table acuse-table--meta">
        <tbody>
          <tr><td>Método de pago</td><td><strong>{metodoTexto}</strong></td></tr>
          <tr><td>Fecha</td><td>{fmtDate(payment.fecha)}</td></tr>
          {payment.referencia && <tr><td>Referencia</td><td class="acuse-mono">{payment.referencia}</td></tr>}
          {totalPagos > 0 && <tr><td>Pago</td><td>{numeroPago} de {totalPagos}</td></tr>}
          {prox && saldoRestante <= 0.5 && (
            <tr><td>Cubre el periodo</td><td>{fmtCorto(payment.fecha)} — {fmtCorto(masDias(prox.fecha, -1))}</td></tr>
          )}
        </tbody>
      </table>

      <div class="acuse-totals">
        {ivaIncluido ? (
          <>
            <div class="acuse-totals-row"><span>Subtotal</span><span>${fmtDecimal(subtotal)} {quote?.moneda || 'MXN'}</span></div>
            <div class="acuse-totals-row"><span>IVA 16%</span><span>${fmtDecimal(ivaCalc)} {quote?.moneda || 'MXN'}</span></div>
          </>
        ) : null}
        <div class="acuse-totals-row acuse-totals-row--total">
          <span>Total pagado</span>
          <span class="acuse-totals-amount">{fmt(monto)} {quote?.moneda || 'MXN'}</span>
        </div>
      </div>
    </section>

    {/* ─── Lo que incluye tu plan ───
        No basta con el renglón "Plan Controla · $5,850": el cliente acaba de
        pagar y lo que quiere ver es qué le da eso. Sale del MISMO catálogo que
        usa la cotización —con lo que hereda del plan de abajo— así que no hay
        dos listas que se puedan desincronizar. */}
    {(coveredItems.length > 0 || areasPlan.length > 0) && (
      <section class="acuse-block">
        <div class="acuse-section-title">Lo que incluye tu plan</div>

        {planData ? (
          <>
            <div class="acuse-plan-nom">
              Plan {planData.name}{cicloPlan ? ` · ${cicloPlan === 'anual' ? 'Anual' : cicloPlan === 'mensual' ? 'Mensual' : cicloPlan}` : ''}
            </div>
            <div class="acuse-chips">
              <span class="acuse-chip">{sucursalesPlan} sucursal{sucursalesPlan > 1 ? 'es' : ''} cubierta{sucursalesPlan > 1 ? 's' : ''}</span>
              {acompLabel && <span class="acuse-chip acuse-chip--rosa">Acompañamiento: {acompLabel}</span>}
              {prox && saldoRestante <= 0.5 && <span class="acuse-chip acuse-chip--verde">Vigente hasta {fmtCorto(masDias(prox.fecha, -1))}</span>}
            </div>

            {plantilla === 'completa' ? (
              <>
                <div class="acuse-areas-full">
                  {areasPlan.map((a) => (
                    <div class="acuse-area-full">
                      <div class="acuse-area-full-t">{a.category}</div>
                      <ul>{a.items.map((i) => <li>{i}</li>)}</ul>
                    </div>
                  ))}
                </div>
                {planData.services?.length > 0 && (
                  <div class="acuse-servicios">
                    {planData.services.map((sv) => <span class="acuse-servicio">{sv}</span>)}
                  </div>
                )}
              </>
            ) : (
              <>
                <div class="acuse-areas">
                  {areasPlan.map((a) => (
                    <div class="acuse-area">
                      <div class="acuse-area-t">{a.category}</div>
                      <div class="acuse-area-n">{a.items.length} funciones</div>
                    </div>
                  ))}
                </div>
                {cotizacionUrl && <a class="acuse-verlo" href={cotizacionUrl}>Ver el detalle completo del plan →</a>}
              </>
            )}
          </>
        ) : null}

        {/* Los renglones que cubrió este pago: extras, implementaciones, lo
            que no es el plan. Con plan reconocido van debajo; sin él, son lo
            único que hay. */}
        {coveredItems.length > 0 && (
          <table class="acuse-table acuse-table--items" style={planData ? 'margin-top:18px' : ''}>
            <tbody>
              {coveredItems.map((it: any) => {
                const pdItem = it.tipo === 'plan' ? plans.find(p => p.id === String(it.nombre || '').toLowerCase()) : null;
                const label = it.tipo === 'plan'
                  ? `${it.titulo || `Plan ${pdItem?.name || it.nombre}`}${it.sucursales ? ` · ${it.sucursales} sucursal${Number(it.sucursales) > 1 ? 'es' : ''}` : ''}`
                  : it.nombre || 'Concepto';
                const sub2 = it.tipo === 'plan'
                  ? (it.periodo === 'anual' ? 'Renovación anual' : it.periodo === 'mensual' ? 'Suscripción mensual' : '')
                  : (it.recurrente ? (it.periodo_extra === 'anual' ? 'Servicio anual recurrente' : 'Servicio mensual recurrente') : 'Servicio único');
                return (
                  <tr>
                    <td>
                      <div class="acuse-item-name">{label}</div>
                      {sub2 && <div class="acuse-item-sub">{sub2}</div>}
                    </td>
                    <td class="acuse-item-amount">{fmt(it.subtotal || it.monto || 0)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
      </section>
    )}

    {/* ─── Concepto (pago de suscripción, sin cotización) ─── */}
    {!quote && sub && (
      <section class="acuse-block">
        <div class="acuse-section-title">Concepto</div>
        <table class="acuse-table acuse-table--items">
          <tbody>
            <tr>
              <td>
                <div class="acuse-item-name">{sub.nombre_plan}</div>
                <div class="acuse-item-sub">{CICLO_LBL[sub.ciclo] || sub.ciclo}{payment.periodo_cubierto ? ` · periodo ${payment.periodo_cubierto}` : ''}{sub.proxima_factura ? ` · vigente hasta ${fmtDate(sub.proxima_factura)}` : ''}</div>
              </td>
              <td class="acuse-item-amount">{fmt(monto)}</td>
            </tr>
          </tbody>
        </table>
      </section>
    )}

    {/* ─── Saldo de la cotización ─── */}
    {quote && totalCotizacion > 0 && plantilla === 'limpia' && (
      <section class="acuse-block">
        <div class="acuse-linea-saldo">
          Saldo de la cotización: <b>{saldoRestante > 0 ? `${fmt(saldoRestante)} por cubrir` : 'cubierto al 100 %'}</b>
          {' '}— {fmt(totalPagado)} de {fmt(totalCotizacion)} {quote?.moneda || 'MXN'}.
        </div>
      </section>
    )}

    {quote && totalCotizacion > 0 && plantilla === 'completa' && (
      <section class="acuse-block acuse-saldo">
        <div class="acuse-section-title">Saldo de la cotización</div>
        <div class="acuse-saldo-bar">
          <div class="acuse-saldo-bar-fill" style={`width:${porcentajeCubierto}%`}></div>
        </div>
        <div class="acuse-saldo-grid">
          <div class="acuse-saldo-stat">
            <div class="acuse-saldo-label">Pagado</div>
            <div class="acuse-saldo-value acuse-saldo-value--ok">{fmt(totalPagado)}</div>
          </div>
          <div class="acuse-saldo-stat">
            <div class="acuse-saldo-label">Total</div>
            <div class="acuse-saldo-value">{fmt(totalCotizacion)}</div>
          </div>
          <div class="acuse-saldo-stat">
            <div class="acuse-saldo-label">{saldoRestante > 0 ? 'Saldo restante' : 'Estado'}</div>
            <div class={`acuse-saldo-value ${saldoRestante > 0 ? 'acuse-saldo-value--pending' : 'acuse-saldo-value--ok'}`}>
              {saldoRestante > 0 ? fmt(saldoRestante) : 'Cubierto'}
            </div>
          </div>
        </div>

        {totalPagos > 1 && (
          <div class="acuse-history">
            <div class="acuse-history-label">Historial de pagos</div>
            {allPayments.map((p, i) => {
              const active = p.id === payment.id;
              const lbl = metodoLabel[p.metodo] || p.metodo;
              return (
                <a href={`/acuse/${p.id}`} class={`acuse-history-row${active ? ' is-current' : ''}`}>
                  <span class="acuse-history-num">{i + 1}.</span>
                  <span class="acuse-history-meta">
                    <span class="acuse-history-acuse">{p.numero_acuse}</span>
                    <span class="acuse-history-method">· {lbl}</span>
                  </span>
                  <span class="acuse-history-date">{fmtDate(p.fecha)}</span>
                  <span class="acuse-history-amount">{fmt(p.monto)}</span>
                </a>
              );
            })}
          </div>
        )}
      </section>
    )}

    {/* ─── Comprobante adjunto ─── */}
    {payment.comprobante_url && (
      <section class="acuse-block acuse-comprobante no-print">
        <div class="acuse-section-title">Comprobante adjunto</div>
        <a href={payment.comprobante_url} target="_blank" rel="noopener" class="acuse-comprobante-link">
          {/\.(jpg|jpeg|png|webp|gif)(\?|$)/i.test(payment.comprobante_url) ? (
            <img src={payment.comprobante_url} alt="Comprobante de pago" class="acuse-comprobante-img" loading="lazy" />
          ) : (
            <div class="acuse-comprobante-pdf">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zM14 2v6h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>Ver comprobante</span>
            </div>
          )}
        </a>
      </section>
    )}

    {/* ─── Notas internas (admin only) ─── */}
    {payment.notas && isAdminMode && (
      <section class="acuse-block acuse-notas no-print">
        <div class="acuse-section-title">Notas internas</div>
        <div class="acuse-notas-text">{payment.notas}</div>
      </section>
    )}

    {/* ─── Footer ─── */}
    <footer class="acuse-footer">
      <div class="acuse-footer-disclaimer">
        Este acuse confirma la recepción de tu pago. <b>No es un comprobante fiscal (CFDI)</b>;
        si necesitas factura, escríbenos a <a href="mailto:administracion@sacscloud.com">administracion@sacscloud.com</a>.
      </div>
      <div class="acuse-footer-meta">
        <span><b>Sacscloud</b> · sacscloud.com · administracion@sacscloud.com</span>
        <span>Documento generado el {fmtDate(payment.created_at || new Date().toISOString())}</span>
      </div>
    </footer>
  </div>
</div>

<style is:global>
  /* Hide global chrome on the acuse page (but keep it for screen if needed) */
  body:has(.acuse-page) .nav,
  body:has(.acuse-page) .wa-bar,
  body:has(.acuse-page) footer:not(.acuse-footer),
  body:has(.acuse-page) .skip-link {
    display: none !important;
  }
  body:has(.acuse-page) main { padding-top: 0 !important; }
</style>

<style>
  .acuse-page {
