---
// La MINUTA con el formato de los reportes de la casa (dueño, 1-oct-2026:
// «cambia este reporte de minuta a la de los reportes que tenemos para
// entregas», propuesta A).
//
// Misma portada, misma franja de cifras, mismos renglones revisables y la
// misma firma que Entregas y Trabajo en curso: el cliente que ya firmó uno no
// tiene que aprender otro documento. Cada ACUERDO se marca «de acuerdo» y al
// final se firma la conformidad de la minuta.
//
// Solo minutas de reunión. El resumen de un lead tiene su propio reporte y
// sigue en el formato anterior.
import CSS from '../reporte/_estilos';
import JS from '../reporte/_guion';
import Firma from '../reporte/_Firma.astro';
import { llaveAcuerdo } from '../../lib/crm/reporte-firma';
import { vinetas } from '../../lib/crm/marca';
import { esConsultoria, PESO_L } from '../../lib/crm/reuniones';
import { leerRevisionMinuta } from '../../lib/crm/minuta-revision';
import { supabase } from '../../lib/supabase';

const { b, m, cliente, tipo, sesionTxt, folio, fecha, duracion, marca, titulo, sigTitulo, sigResto, cuentaTxt } = Astro.props;

/* FIRMA solo en reuniones de CONSULTORÍA (dueño, 12-oct-2026); las demás
   salen sin firma. Se puede apagar por minuta (m.firma === false). La
   revisión vive en la bitácora de `activities` (ver minuta-revision.ts). */
const consultoria = esConsultoria((b.event_types as any)?.categoria);
const conFirma = consultoria && m.firma !== false;
const rv = conFirma ? await leerRevisionMinuta(b.id) : null;
const rep: any = conFirma
  ? { id: b.id, tipo: 'minuta', revisados: rv!.revisados, firma: rv!.firma }
  : { id: b.id, tipo: 'minuta', firma: null };
const revisados: Record<string, string> = rep.revisados || {};
/* ?crm=1: la vista previa dentro del CRM. Se ve igual que la del cliente pero
   sin su barra de botones (el CRM trae los suyos) y sin poder marcar ni
   firmar: el consultor no acepta por el cliente. */
const vistaCrm = Astro.url.searchParams.has('crm');
const firmado = !!rep.firma;

const money = (n: any) => '$' + Number(n || 0).toLocaleString('es-MX', { maximumFractionDigits: 0 });
const reviso = String(m.reviso || '').split(/\r?\n+/).map(x => x.trim()).filter(Boolean);
const acuerdos = vinetas(m.acuerdos);
const doCliente = vinetas(m.cliente);
const doNos = vinetas(m.sacs);
/* Lo estructurado de consultoría: flujos, autorizaciones (ligadas a su
   cotización) y compromisos del cliente con su PESO. */
const flujos: any[] = (Array.isArray(m.flujos) ? m.flujos : []).filter((f: any) => String(f?.titulo || '').trim());
const autorizados: any[] = (Array.isArray(m.autorizados) ? m.autorizados : []).filter((a: any) => String(a?.titulo || '').trim());
const ORDEN_PESO: Record<string, number> = { alta: 0, media: 1, baja: 2 };
const compromisos: any[] = (Array.isArray(m.compromisos) ? m.compromisos : []).filter((c: any) => String(c?.texto || '').trim())
  .sort((x: any, y: any) => (ORDEN_PESO[x.peso] ?? 1) - (ORDEN_PESO[y.peso] ?? 1));
// Estado de pago de las cotizaciones ligadas, leído al abrir: dice HOY si ya está pagada.
const cotIds = [...new Set(autorizados.map((a: any) => a.quote_id).filter(Boolean))] as string[];
const cots: Record<string, any> = {};
if (cotIds.length) {
  const [{ data: qs }, { data: ps }] = await Promise.all([
    supabase.from('quotes').select('id, numero, total, estado').in('id', cotIds),
    supabase.from('payments').select('quote_id, monto, estado').in('quote_id', cotIds),
  ]);
  for (const q of qs || []) cots[q.id] = { ...q, abonado: 0 };
  for (const p of ps || []) if (cots[p.quote_id] && !['anulado', 'cancelado', 'duplicado', 'reembolsado'].includes(String(p.estado || '').toLowerCase())) cots[p.quote_id].abonado += Number(p.monto || 0);
}
const estadoCot = (q: any) => !q ? null
  : (q.estado === 'paid' || (q.total > 0 && q.abonado >= q.total - 0.01)) ? { l: 'Pagada', c: 'pag' }
  : q.abonado > 0 ? { l: `Anticipo pagado · ${money(q.abonado)} de ${money(q.total)}`, c: 'par' }
  : q.estado === 'accepted' ? { l: 'Aceptada · por pagar', c: 'pen' } : { l: 'Por pagar', c: 'pen' };
const totalAutorizado = autorizados.reduce((a: number, x: any) => a + (x.sin_costo ? 0 : Number(x.monto || 0)), 0);
const fCorta = (d?: string | null) => d ? new Date(String(d).slice(0, 10) + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).replace('.', '') : '';
const hayMinuta = reviso.length || acuerdos.length || doCliente.length || doNos.length || flujos.length || autorizados.length || compromisos.length || String(m.siguiente || '').trim();

/* Una etiqueta por acuerdo solo cuando el texto la dice sin lugar a duda. Si
   no, el renglón va sin etiqueta: una etiqueta inventada en un documento que
   se firma es peor que ninguna. */
const etiqueta = (t: string) => /sin costo/i.test(t) ? { l: 'sin costo', c: 'sc' }
  : /personalizaci[oó]n/i.test(t) ? { l: 'personalización', c: 'per' }
  : /(por verificar|se verificar|verificar[aá]|se revisar[aá]|qued[oó] por|por definir|pendiente de)/i.test(t) ? { l: 'por revisar', c: 'rev' }
  : null;
const sinCosto = acuerdos.filter(a => /sin costo/i.test(a)).length;
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700;9..40,800&display=swap" />
  <style set:html={CSS}></style>
  <style>
    /* Lo propio de la minuta, sobre el sistema de los reportes. */
    .ac .chip{font-size:.6rem;font-weight:800;border-radius:20px;padding:2px 9px;white-space:nowrap;flex:none}
    .ac .c-rev{background:var(--ambar-a);color:var(--ambar-t)}
    .ac .c-per{background:var(--agua);color:var(--tinta)}
    .ac .c-sc{background:var(--verde-a);color:var(--verde-t)}
    .ac .tx{font-size:.88rem;color:var(--ink);line-height:1.55;font-weight:500;flex:1;min-width:0}
    .dos{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:6px}
    .lado{border:1px solid var(--borde);border-radius:14px;padding:14px 16px;background:#fff;min-width:0}
    .lado h4{margin:0 0 6px;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--tinta)}
    .lado.tu h4{color:var(--rosa-t)}
    .tarea{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-top:1px solid #f4f3f8;font-size:.84rem;color:var(--ink-2);line-height:1.5}
    .tarea:first-of-type{border-top:none}
    .tarea i{flex:none;width:7px;height:7px;border-radius:50%;background:var(--violeta);margin-top:8px}
    .lado.tu .tarea i{background:var(--rosa-s)}
    .lado .vacio{font-size:.8rem;color:var(--ink-3);padding:6px 0}
    .avisoM{background:var(--ambar-a);color:var(--ambar-t);font-size:.84rem;padding:14px 34px;line-height:1.6}
    .graba{margin-top:14px}
    .flujos{margin-top:4px}
    .fl{display:grid;grid-template-columns:34px 1fr auto auto;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #f1eff6}
    .fl:first-child{border-top:none}
    .fl-n{width:30px;height:30px;border-radius:50%;background:var(--agua);color:var(--tinta);font-weight:800;display:grid;place-items:center;font-size:.85rem}
    .fl-t{font-weight:700;color:var(--ink);font-size:.95rem;min-width:0}
    .quien{font-size:.68rem;font-weight:800;border-radius:20px;padding:3px 10px;white-space:nowrap}
    .q-sacs{background:var(--agua);color:var(--tinta)} .q-cli{background:#FBE7F0;color:#8A1B50}
    .fecha{font-size:.8rem;color:var(--ink-2);font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums}
    .aut{border:1.5px solid #cdeedd;background:var(--verde-a);border-radius:14px;padding:6px 16px;margin-top:6px}
    .au{display:flex;gap:12px;align-items:center;padding:11px 0;border-top:1px solid #d8f0e4}
    .au:first-child{border-top:none}
    .au .ok{width:24px;height:24px;border-radius:50%;background:var(--verde);display:grid;place-items:center;flex:none}
    .au .ok svg{width:14px;height:14px;fill:none;stroke:#fff;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
    .au-t{flex:1;min-width:0;font-weight:700;color:var(--ink);font-size:.93rem}
    .au-q{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:4px;font-weight:500;font-size:.78rem;color:var(--ink-2)}
    .cot{font-size:.66rem;font-weight:800;border-radius:20px;padding:2px 8px}
    .cot-pag{background:#fff;color:var(--verde-t)} .cot-par{background:#fff;color:var(--ambar-t)} .cot-pen{background:#fff;color:#C0554E}
    .au-m{font-weight:800;color:var(--verde-t);white-space:nowrap}
    .au-m.sc{font-size:.72rem;background:#fff;border-radius:20px;padding:3px 10px}
    .aut-tot{display:flex;justify-content:space-between;padding:11px 0 8px;border-top:1.5px dashed #bfe6d4;font-size:.82rem;color:var(--verde-t);font-weight:700}
    .cp{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:9px 0;border-top:1px solid #f4f3f8;font-size:.86rem;color:var(--ink-2);line-height:1.4}
    .lado .cp:first-of-type{border-top:none}
    .peso{font-size:.62rem;font-weight:800;border-radius:20px;padding:3px 9px;white-space:nowrap}
    .p-alta{background:#FEF0EF;color:#C0554E} .p-media{background:#FFF4E5;color:#9a6a10} .p-baja{background:#EAF8F2;color:#1E8A63}
    @media (max-width:640px){.fl{grid-template-columns:30px 1fr;}.fl .quien,.fl .fecha{grid-column:2}}
    @media (max-width:640px){.dos{grid-template-columns:1fr}.avisoM{padding:14px 18px}}
    @media print{.lado{break-inside:avoid}}
  </style>
</head>
<body>
<div class="shell">
  <div class="bar" style={vistaCrm ? 'display:none' : undefined}><b>{cliente} · {fecha}</b>
    <button class="btn" onclick="window.print()">Descargar PDF</button>
    <a class="btn2" style="text-decoration:none" href={`https://wa.me/?text=${encodeURIComponent(`Minuta de nuestra sesión del ${fecha}: ${Astro.url.href}`)}`} target="_blank" rel="noreferrer">Compartir por WhatsApp</a>
  </div>

  <div class="doc">
    <div class="cinta"></div>
    <div class="hero">
      <div class="chispas" aria-hidden="true">
        {[[18,6,16,.34],[13,17,62,.24],[21,34,10,.28],[11,47,72,.2],[16,63,22,.3],[10,74,66,.18],[14,86,40,.26]].map(([s,l,t,o], i) => (
          <svg width={s} height={s} viewBox="0 0 24 24" style={`left:${l}%;top:${t}%;opacity:${o};animation-delay:${(i * 0.45).toFixed(2)}s`}><path d="M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z" fill="#D9538E" /></svg>
        ))}
      </div>
      <div class="top">
        <div><div class="wm">Sacscloud</div><div class="wsub">{consultoria ? 'Minuta de consultoría' : 'Minuta de reunión'}</div></div>
        <div class="folio"><div class="t">Folio</div><div class="f">{folio}</div></div>
      </div>
      <h1>{(flujos.length || autorizados.length) ? 'Lo que revisamos, autorizamos y vamos a construir' : 'Lo que revisamos y acordamos'}</h1>
      <p class="sub">{cliente} · {tipo} · {fecha}{duracion}</p>
      <div class="sello">
        <svg width="11" height="11" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.6c.62 6.6 3.18 9.16 9.78 9.78-6.6.62-9.16 3.18-9.78 9.78-.62-6.6-3.18-9.16-9.78-9.78C8.82 10.76 11.38 8.2 12 1.6z" fill="#D9538E" /></svg>
        Sembramos relaciones, cosechamos constelaciones
      </div>
      <div class="quien">
        <div><div class="k">Cliente</div><div class="v">{cliente}</div></div>
        {cuentaTxt && <div><div class="k">Cuenta</div><div class="v">{cuentaTxt}</div></div>}
        <div><div class="k">Sesión</div><div class="v">{sesionTxt}</div></div>
        <div><div class="k">Participantes</div><div class="v">{[b.invitee_nombre || cliente, marca.firma || marca.nombre].filter(Boolean).join(' · ')}</div></div>
      </div>
    </div>

    <div class="ancla">
      {flujos.length > 0
        ? <div><div class="n" data-n={flujos.length}>0</div><div class="l">{flujos.length === 1 ? 'flujo de trabajo' : 'flujos de trabajo'}</div></div>
        : <div><div class="n" data-n={acuerdos.length}>0</div><div class="l">{acuerdos.length === 1 ? 'acuerdo' : 'acuerdos'}</div></div>}
      {autorizados.length > 0
        ? <div><div class="n v" data-n={autorizados.length}>0</div><div class="l">{autorizados.length === 1 ? 'autorización' : 'autorizaciones'}</div></div>
        : <div><div class="n v" data-n={sinCosto}>0</div><div class="l">sin costo adicional</div></div>}
      <div><div class="n" data-n={compromisos.length || doCliente.length}>0</div><div class="l">te tocan a ti</div></div>
      <div><div class="n" data-n={doNos.length}>0</div><div class="l">nos tocan a nosotros</div></div>
    </div>

    {!hayMinuta && <div class="avisoM">Esta reunión todavía no tiene minuta capturada. En cuanto se documente, esta misma liga la mostrará.</div>}

    <div class="cuerpo">
      <div class="st"><span class="x">Cómo leer este documento</span><span class="ln"></span></div>
      <p class="p">
        {conFirma
          ? <>Primero, lo que se revisó y los <b>flujos de trabajo</b> que vamos a construir. Después, cada <b>acuerdo</b>: márcalo como <b>de acuerdo</b> cuando lo leas, y lo que <b>autorizaste</b> en la reunión. Al final, lo que le toca a cada quien. Firma abajo para dejar la minuta autorizada.</>
          : <>Primero, lo que se revisó en la sesión. Después, cada <b>acuerdo</b> en su renglón. Al final, lo que le toca a cada quien y el siguiente paso.</>}
      </p>

      {(sigTitulo || sigResto) && (
        <div class="lila" style="margin-top:16px">
          <div class="t">Siguiente paso</div>
          {sigTitulo ? <div class="c">{sigTitulo}</div> : null}
          {sigResto && <div class="d" style="white-space:pre-wrap">{sigResto}</div>}
        </div>
      )}

      {reviso.length > 0 && <>
        <div class="st" style="margin-top:26px"><span class="x">Qué se revisó</span><span class="ln"></span></div>
        {reviso.map(p => <p class="p">{p}</p>)}
      </>}

      {flujos.length > 0 && <>
        <div class="st" style="margin-top:26px"><span class="x">Flujos de trabajo a realizar</span><span class="ln"></span></div>
        <div class="flujos">
          {flujos.map((f: any, i: number) => (
            <div class="fl"><span class="fl-n">{i + 1}</span><span class="fl-t">{f.titulo}</span>
              <span class={`quien q-${f.quien === 'cliente' ? 'cli' : 'sacs'}`}>{f.quien === 'cliente' ? 'Tú' : 'SACS'}</span>
              {f.fecha && <span class="fecha">{fCorta(f.fecha)}</span>}</div>
          ))}
        </div>
      </>}

      {acuerdos.length > 0 && <>
        <div class="st" style="margin-top:26px"><span class="x">{acuerdos.length === 1 ? 'El acuerdo' : `Los ${acuerdos.length} acuerdos`}</span><span class="ln"></span></div>
        <div class="ent ac">
          {acuerdos.map((a, i) => {
            const k = llaveAcuerdo(i);
            const hecho = !!revisados[k];
            const e = etiqueta(a);
            return (
              <div class={`it${hecho ? ' revisada' : ''}`}>
                <div class="enc"><span class="tx">{a}</span>{e && <span class={`chip c-${e.c}`}>{e.l}</span>}</div>
                {conFirma && (
                  <div class="pieit">
                    <button type="button" class={`rev${hecho ? ' on' : ''}`} data-k={k} data-acuerdo="1" aria-pressed={hecho ? 'true' : 'false'} disabled={firmado || vistaCrm}>
                      <span class="rk" aria-hidden="true"></span><span class="rt">{hecho ? 'De acuerdo' : 'Estoy de acuerdo'}</span>
                    </button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </>}

      {autorizados.length > 0 && <>
        <div class="st" style="margin-top:26px"><span class="x">Autorizado en esta reunión</span><span class="ln"></span></div>
        <div class="aut">
          {autorizados.map((a: any) => {
            const q = a.quote_id ? cots[a.quote_id] : null;
            const st = estadoCot(q);
            return (
              <div class="au">
                <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                <span class="au-t">{a.titulo}
                  {q && <span class="au-q">Depende de la cotización <b>{q.numero}</b>{st && <span class={`cot cot-${st.c}`}>{st.l}</span>}</span>}
                </span>
                {a.sin_costo ? <span class="au-m sc">sin costo</span> : (Number(a.monto) > 0 ? <span class="au-m">{money(a.monto)}</span> : null)}
              </div>
            );
          })}
          {totalAutorizado > 0 && <div class="aut-tot"><span>Total autorizado</span><span>{money(totalAutorizado)}</span></div>}
        </div>
      </>}

      {(doCliente.length > 0 || doNos.length > 0 || compromisos.length > 0) && <>
        <div class="st" style="margin-top:26px"><span class="x">Compromisos</span><span class="ln"></span></div>
        <div class="dos">
          <div class="lado tu"><h4>{compromisos.length ? 'Lo que te toca · por importancia' : 'Lo que te toca'}</h4>
            {compromisos.length ? compromisos.map((c: any) => (
                <div class="cp"><span class={`peso p-${c.peso || 'media'}`}>{PESO_L[c.peso as 'alta'] || 'Media'}</span><span>{c.texto}</span>{c.fecha ? <span class="fecha">{fCorta(c.fecha)}</span> : <span></span>}</div>
              ))
              : doCliente.length ? doCliente.map(t => <div class="tarea"><i></i><span>{t}</span></div>)
              : <div class="vacio">Nada de tu lado en esta sesión.</div>}
          </div>
          <div class="lado"><h4>Lo que nos toca</h4>
            {doNos.length ? doNos.map(t => <div class="tarea"><i></i><span>{t}</span></div>)
              : <div class="vacio">Nada de nuestro lado en esta sesión.</div>}
          </div>
        </div>
      </>}

      {b.grabacion_url && /^https?:\/\//i.test(String(b.grabacion_url)) && (
        <div class="graba"><a class="vid" href={b.grabacion_url} target="_blank" rel="noopener noreferrer"><span class="pl">▶</span> Ver la grabación de la sesión</a></div>
      )}

      <div inert={vistaCrm ? true : undefined}><Firma rep={rep} total={acuerdos.length} /></div>
    </div>

    <div class="pieE">
      <div class="fw">Sacscloud</div>
      <p>
        ¿Algo no quedó como lo platicamos? Contéstanos este mismo documento y lo corregimos.
        Documento de {marca.nombre}{marca.pie ? ` · ${marca.pie}` : ''}. Folio {folio}.
      </p>
    </div>
  </div>
</div>
<script define:vars={{ REP: b.id, API_BASE: '/api/minuta' }} set:html={JS}></script>
</body>
</html>
