---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingPage from '../components/scheduling/BookingPage';
import { supabase } from '../lib/supabase';

export const prerender = false;

// Load demo event type for inline booking
let bookingEventType: any = null;
let bookingQuestions: any[] = [];
try {
  const { data: et } = await supabase.from('event_types').select('*').eq('slug', 'demo').eq('activo', true).single();
  if (et) {
    bookingEventType = et;
    if (et.owner_id) {
      const { data: host } = await supabase.from('team_members').select('nombre, email').eq('id', et.owner_id).single();
      if (host) bookingEventType.team_members = host;
    }
    const { data: q } = await supabase.from('booking_questions').select('*').eq('event_type_id', et.id).eq('activo', true).order('orden');
    bookingQuestions = q || [];
  }
} catch {}

/* La calculadora de las páginas de giro manda su resultado en ?estimado. Si no
   se lee aquí, el visitante pone su número, llega a agendar y el dato se
   pierde justo cuando más sirve: es lo único que ya sabemos de su negocio. */
const estimadoRaw = Astro.url.searchParams.get('estimado');
const estimadoNum = estimadoRaw ? Number(estimadoRaw.replace(/[^0-9]/g, '')) : 0;
const estimado = estimadoNum > 0 ? '$' + estimadoNum.toLocaleString('es-MX') : '';
const de = Astro.url.searchParams.get('de') || '';
const deColchon = de === 'colchon';
const dePercha = de === 'percha';
const deConsigna = de === 'consigna';
const deMerch = de === 'merch';
const deNovias = de === 'novias';
const deActive = de === 'activewear';
const deRenta = de === 'renta'; // renta de vestidos: lo que renta un solo vestido en un mes
const deTb = de === 'tb'; // trajes de baño: lo que regresa a caja si remata a tiempo (no inventario atrapado)
const urlAgenda = estimado
  ? `/agendar/demo?estimado=${estimadoNum}${de ? `&de=${de}` : ''}`
  : '/agendar/demo';
---

<BaseLayout
  title="Agenda una demo — Sacs"
  description="Agenda una demo de 30 minutos. Cargamos tus productos y datos reales en Sacs para que veas punto de venta, inventario, CRM y reportes funcionando con tu negocio."
>

<!-- Hero -->
<section class="ct-hero">
  <div class="ct-hero-inner">
    <div class="ct-hero-text">
      <span class="ct-valor"><s>Sesión de consultoría: $9,000 MXN</s> <b>Hoy sin costo para ti</b></span>
      <h1 class="ct-h1">Una sesión de consultoría<br/>para tu marca, no una demo</h1>
      <p class="ct-lead">Un consultor especialista en retail de moda revisa tu operación con tus datos reales: tallas, colores, sucursales y canales. Es la misma sesión que cobramos a $9,000 MXN a las cadenas; para ti va sin costo y sin compromiso.</p>
      <div class="ct-session">
        <p class="ct-session-label">En la sesión de consultoría:</p>
        <div class="ct-session-steps">
          <div class="ct-session-step">
            <span class="ct-session-num">1</span>
            <div>
              <strong>Diagnóstico de tu operación</strong>
              <p>Cuántas tiendas tienes, cómo vendes hoy, dónde se te va el margen: tallas que faltan, curvas rotas, canales sin conectar.</p>
            </div>
          </div>
          <div class="ct-session-step">
            <span class="ct-session-num">2</span>
            <div>
              <strong>Abrimos Sacs con tus datos</strong>
              <p>Punto de venta, inventario por talla y color, CRM y reportes, configurados en vivo para tu giro con tus productos.</p>
            </div>
          </div>
          <div class="ct-session-step">
            <span class="ct-session-num">3</span>
            <div>
              <strong>Te llevas un plan por escrito</strong>
              <p>Minuta con hallazgos, prioridades y tiempos de implementación. Aunque no contrates, el diagnóstico es tuyo.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Inline stats -->
      <div class="ct-hero-stats">
        <div class="ct-hero-stat">
          <span class="ct-stat-num">3,000+</span>
          <span class="ct-stat-label">marcas activas</span>
        </div>
        <div class="ct-stat-sep"></div>
        <div class="ct-hero-stat">
          <span class="ct-stat-num">4.8/5</span>
          <span class="ct-stat-label">en Google</span>
        </div>
        <div class="ct-stat-sep"></div>
        <div class="ct-hero-stat">
          <span class="ct-stat-num">99.9%</span>
          <span class="ct-stat-label">uptime</span>
        </div>
      </div>

      <!-- Quote -->
      <blockquote class="ct-hero-quote">
        <p>"La plataforma nos dio el control que necesitabamos para escalar a 42 sucursales."</p>
        <cite>— La Bella Pandita</cite>
      </blockquote>

      <!-- Trusted -->
      <div class="ct-hero-trusted">
        <span class="ct-trusted-label">Confian en Sacs</span>
        <div class="ct-trusted-names">
          <span>La Bella Pandita</span>
          <span>Liveshow</span>
          <span>Casa Maca</span>
          <span>Sandmade</span>
        </div>
      </div>
    </div>
    <div class="ct-hero-cal" id="demo">
      {estimado && (
        <div class="estimado-aviso">
          <p>
            <b>{deColchon ? `Ese colchón mueve ${estimado} de tu catálogo` : dePercha ? `Traes un estimado de ${estimado} parado hoy en marcas que no rotan` : deConsigna ? `Traes un estimado de ${estimado} de comisión en el periodo` : deMerch ? `Traes una fecha de ${estimado} en juego` : deNovias ? `Traes un vestido de ${estimado} contra una fecha que no se mueve` : deActive ? `Traes ${estimado} parados en piezas viudas del drop` : deTb ? `Traes ${estimado} que regresan a caja si rematas a tiempo` : deRenta ? `Traes ${estimado} de renta en un mes con un solo vestido` : `Traes un estimado de ${estimado} al año en inventario atrapado`}.</b> Agenda abajo y
            lo revisamos con tu catálogo real en la sesión — normalmente la cifra cambia, para
            arriba o para abajo, en cuanto vemos tus números.
          </p>
        </div>
      )}

      <iframe src={urlAgenda} width="100%" height="800" frameborder="0" style="border:none;border-radius:16px;min-height:800px;"></iframe>
    </div>
  </div>
</section>

<!-- Social proof strip -->
<section class="ct-proof">
