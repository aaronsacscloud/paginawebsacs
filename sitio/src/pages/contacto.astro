</section>

<style>
  /* Aviso del estimado que llega desde la calculadora de una página de giro. */
  .estimado-aviso {
    max-width: 900px; margin: 0 auto 24px; padding: 18px 22px;
    background: #F3F7FF; border: 1px solid #C7DAFB; border-radius: 14px;
  }
  .estimado-aviso p { margin: 0; font-size: 15.5px; line-height: 1.6; color: #1F2937; }
  .estimado-aviso b { color: #1D4ED8; font-weight: 700; }
  @media (max-width: 700px) {
    .estimado-aviso { padding: 15px 16px; }
