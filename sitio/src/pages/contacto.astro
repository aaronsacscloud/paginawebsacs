  /* Hero stats */
  .ct-hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }
  .ct-stat-num {
    font-family: var(--font-display);
    font-size: 1.125rem;
