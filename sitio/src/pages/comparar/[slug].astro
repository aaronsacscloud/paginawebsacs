---
// Las páginas que publica el MOTOR DE DEMANDA.
//
// `prerender = false`: se sirven al vuelo desde la base, con caché de CDN. Es lo
// que permite que el motor publique sin disparar un despliegue — y sin un
// despliegue no hay build que pagar ni ventana en la que los crons se detengan.
// El caché hace que, en la práctica, cada página se genere una vez por hora.
//
// Comparativas honestas: Sacs frente a otra herramienta, con lo que cada una
// hace mejor. Una comparativa que solo gana es una que nadie cita.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContenidoMotor from '../../components/ContenidoMotor.astro';
import { leerPublicado } from '../../lib/demanda/publicar';

export const prerender = false;

const { slug } = Astro.params;
const pieza = slug ? await leerPublicado('comparar', slug) : null;

if (!pieza) return new Response(null, { status: 404, statusText: 'No encontrado' });

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
---
<BaseLayout
  title={pieza.titulo}
  description={pieza.meta_desc || pieza.titulo}
  type="article"
  structuredData={pieza.schema}
>
  <ContenidoMotor pieza={pieza} />
</BaseLayout>
