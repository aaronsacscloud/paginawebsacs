---
// El REPORTE DE TRABAJO EN CURSO que abre el cliente.
//
// El hermano del de entregas. Aquel contesta «¿qué me han hecho?»; este
// contesta «¿qué me están haciendo?» — la pregunta que el cliente hace entre
// una entrega y la siguiente, y que hasta hoy se respondía por WhatsApp de
// memoria.
//
// Cada renglón dice QUÉ VA A CAMBIAR dentro del sistema, que es exactamente lo
// que el cliente pidió ver: el título solo no le dice nada a quien no estuvo en
// la junta donde se acordó.
//
// Va agrupado POR MÓDULO, igual que el de entregas: los diecisiete trabajos de
// una cuenta salen de tres partes del sistema, y lo que el cliente quiere saber
// primero es «qué están haciendo de membresías». La etapa no se pierde: viaja
// como chip en cada renglón, que es donde de verdad se consulta.
// (Antes agrupaba por etapa y el módulo no aparecía; con seis etapas y tres
// módulos, el documento se leía como seis listas sueltas.)
//
// Y trae EL VIDEO que se le pasó a desarrollo: el mismo que grabó quien levantó
// la orden explicando lo que quiere. Eso es lo que convierte este documento en
// prueba de que se está trabajando, en vez de una promesa escrita.
//
// Usa los mismos estilos que el de entregas —dos documentos de la misma casa se
// ven iguales o no se ven de la misma casa— y se separa por el TONO: aquel va
// en verde, lo que ya entró; este en rosa, lo que está en camino.
//
// Lee la FOTO guardada, no la base viva: la liga tiene que decir en diciembre
// lo mismo que decía hoy. Lo interno —rebotes, quién la trabaja, cuántas veces
// se movió la fecha— ni siquiera está en la foto: se filtra al generar.
import Chispas from '../../components/reporte/ChispasDoc.astro';
import Sello from '../../components/reporte/SelloChispa.astro';
const { rep } = Astro.props;
const h = rep.hechos || {};

const dCorta = (d?: string | null) => d
  ? new Date(String(d).slice(0, 10) + 'T12:00:00').toLocaleDateString('es-MX', { day: '2-digit', month: 'short' }).replace(/\./g, '')
  : '';
const dLarga = (d?: string | null) => d
  ? new Date(String(d).slice(0, 10) + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

/* Cómo se le dice al cliente cada tipo. Misma traducción que el de entregas:
   `pendiente` es como el CRM llama por dentro a los bugs, y en un documento
   para el cliente se lee como que algo está sin hacer. */
const TIPO: Record<string, { l: string; c: string }> = {
  personalizacion: { l: 'personalización', c: 'per' },
  ajuste:          { l: 'ajuste',          c: 'aju' },
  pendiente:       { l: 'corrección',      c: 'cor' },
  modulo:          { l: 'módulo',          c: 'mod' },
  plugin:          { l: 'plugin',          c: 'plu' },
  otro:            { l: 'mejora',          c: 'aju' },
};
const tipoDe = (k: string) => TIPO[k] || TIPO.otro;

/* Los títulos vienen como bitácora del consultor —«Bug l Modulo de
   Reparaciones l Alertas desconfiguradas»—. Al cliente eso le dice tres veces
   lo mismo y la «l» se lee como un error de dedo. Misma limpieza que en el de
   entregas; adentro del CRM el título no se toca. */
const PREFIJO = /^\s*(bugs?|mejoras?|mejorar|ajustes?|correcci[oó]n|personalizaci[oó]n|pendiente)\s*[|lí·:–—-]\s*/i;
const limpiar = (t: string | null | undefined) => {
  let x = String(t || '').trim();
  for (let i = 0; i < 2; i++) x = x.replace(PREFIJO, '').trim();
  return x.replace(/\s+[l|]\s+/g, ' · ').replace(/\s{2,}/g, ' ').trim();
};

/* La especificación viene con saltos de línea y viñetas del consultor. Se
   parte en dos: lo que se lee de un vistazo y el resto, que se abre a mano.
   Recortar a secas dejaba frases colgando —el mismo problema que ya se había
   resuelto en el de entregas—, así que aquí se corta en el último punto. */
const parte = (t: string | null) => {
  const txt = String(t || '').trim();
  if (!txt) return { corto: '', resto: '' };
  const corrido = txt.replace(/\s*\n+\s*/g, ' · ').replace(/\s{2,}/g, ' ').trim();
  if (corrido.length <= 260) return { corto: corrido, resto: txt.includes('\n') ? txt : '' };
  const recorte = corrido.slice(0, 260);
  const corte = Math.max(recorte.lastIndexOf('. '), recorte.lastIndexOf(' · '), recorte.lastIndexOf(' '));
  return { corto: recorte.slice(0, corte > 150 ? corte + 1 : 260).trim() + '…', resto: txt };
};

const trabajos = h.trabajos || [];

/* ── Agrupado por MÓDULO ──
   La estructura real del documento: en qué parte del sistema estamos metidos.
   Dentro de cada módulo, los trabajos van en el orden en que avanzan —lo que
   ya está en revisión arriba, lo que no ha arrancado al final—, porque abrir
   un grupo con lo que todavía no empieza dice lo contrario de lo que este
   documento viene a decir.
   Lo que no tiene módulo cae en «Otros trabajos» y va al final: es lo menos
   clasificado, no lo primero. Con un solo grupo no se pinta encabezado. */
const grupos: { modulo: string; lista: any[] }[] = [];
for (const t of trabajos) {
  const k = t.modulo || 'Otros trabajos';
  const g = grupos.find(x => x.modulo === k);
  g ? g.lista.push(t) : grupos.push({ modulo: k, lista: [t] });
}
for (const g of grupos) g.lista.sort((a: any, b: any) => (a.orden || 9) - (b.orden || 9));
grupos.sort((a, b) => (a.modulo === 'Otros trabajos' ? 1 : 0) - (b.modulo === 'Otros trabajos' ? 1 : 0)
  || b.lista.length - a.lista.length);
const agrupar = grupos.length > 1;

/* Qué significa cada etapa, en una línea. Va en el chip como tooltip y en el
   pie del grupo: «en análisis» no le dice nada a quien no trabaja aquí. */
const PIE_ETAPA: Record<number, string> = {
  1: 'Estamos definiendo el detalle con nuestro equipo.',
  2: 'Ya se está programando.',
  3: 'Se está probando antes de entregártelo.',
  4: 'Terminado y en revisión final de nuestro lado.',
  5: 'Detenidas hasta que nos pases el dato que te pedimos.',
  6: 'En fila. Te avisamos en cuanto tengan fecha.',
};
---

<div class="hero">
  <Chispas capa="hero" color="#D9538E" />
  <div class="top">
    <div><div class="wm">Sacscloud</div><div class="wsub">Trabajo en curso</div></div>
    <div class="folio"><div class="t">Folio</div><div class="f">{rep.folio}</div></div>
  </div>
  <h1>Lo que estamos construyendo para ti</h1>
  <div class="sello">
    <Sello color="#D9538E" />
    Aquí se pule cada estrella
  </div>
  <div class="quien">
    {h.cuenta_sacs && <div><div class="k">Cuenta</div><div class="v">{h.cuenta_sacs}</div></div>}
    <div><div class="k">En tu cola</div><div class="v">{h.total}</div></div>
    <div><div class="k">Al</div><div class="v">{dLarga(h.periodo?.hasta)}</div></div>
  </div>
</div>

<div class="ancla">
  <Chispas capa="ancla" color="#EFA6CA" />
  <div><div class="n" data-n={h.total}>0</div><div class="l">en tu cola</div></div>
  <div><div class="n" data-n={h.en_curso}>0</div><div class="l">ya arrancadas</div></div>
  <div><div class="n" data-n={h.por_arrancar}>0</div><div class="l">por arrancar</div></div>
  <div><div class="n v" data-n={h.cortesias}>0</div><div class="l">sin costo adicional</div></div>
</div>

<div class="cuerpo">
  <div class="st"><span class="x">Cómo leer este documento</span><span class="ln"></span></div>
  <p class="p">
    Cada renglón es algo que pediste y que ya está en nuestra cola de trabajo. Dice <b>qué pasa hoy</b>,
    <b>qué va a cambiar</b> dentro del sistema y en qué etapa va. Va ordenado por la parte del sistema
    que estamos tocando.
    {h.con_video > 0 && <> Donde lo hay, trae el <b>video del encargo</b>: lo que le pasamos a nuestro
    equipo para construirlo, para que veas exactamente lo que se está haciendo.</>}
    {' '}Cuando quede, lo vas a ver en tu reporte de entregas con el video donde se ve operando.
  </p>

  {h.proxima && (
    <div class="lila" style="margin-top:14px">
      <div class="t">La próxima entrega</div>
      <div class="c">{dLarga(h.proxima)}</div>
      <div class="d">Es la fecha más cercana que tenemos comprometida contigo.</div>
    </div>
  )}

  {h.cortesias > 0 && (
    <div class="lila" style="margin-top:12px">
      <div class="t">Sin costo adicional</div>
      <div class="c">{h.cortesias === h.total
        ? (h.total === 1 ? 'El trabajo de tu cola' : `Los ${h.total}`)
        : `${h.cortesias} de los ${h.total}`}</div>
      <div class="d">Salieron de tus juntas y se hacen sin cargo.</div>
    </div>
  )}

  {grupos.map(g => (
    <div class="grupo">
      {agrupar && (
        <div class="gh">
          <Chispas capa="banda" color="#D9538E" />
          <span class="gn">{g.modulo}</span>
          <span class="gc">{g.lista.length === 1 ? '1 trabajo' : `${g.lista.length} trabajos`}</span>
          <span class="ln"></span>
        </div>
      )}
      <div class="ent">
        {g.lista.map((t: any) => {
          const k = tipoDe(t.categoria);
          const q = parte(t.cambio);
          const hoy = parte(t.hoy);
          return (
            <div class="it">
              <div class="enc">
                <span class="tt">{limpiar(t.titulo)}</span>
                {/* La etapa, en el renglón. Al agrupar por módulo deja de ser el
                    encabezado, y es el dato que más se consulta: «¿esta ya
                    arrancó?». Con su explicación en el tooltip. */}
                <span class="etp" title={PIE_ETAPA[t.orden] || ''}>{t.etapa}</span>
                <span class={`tipo t-${k.c}`}>{k.l}</span>
                {t.cortesia && <span class="sc">sin costo</span>}
                {t.fecha ? <span class="fe">{dCorta(t.fecha)}</span> : <span class="fe sf">sin fecha</span>}
              </div>
              {hoy.corto && <div class="dd"><b>Qué pasa hoy:</b> {hoy.corto}</div>}
              {q.corto && <div class="dd"><b>Qué va a cambiar:</b> {q.corto}</div>}
              {/* El video del encargo y el detalle completo, en el mismo
                  renglón: son las dos formas de profundizar y apiladas hacían
                  que cada trabajo midiera el doble. */}
              {(t.video || q.resto || hoy.resto) && (
                <div class="pieit">
                  {t.video && (
                    <a class="vid" href={t.video} target="_blank" rel="noopener noreferrer">
                      <span class="pl">▶</span> Ver lo que pedimos
                    </a>
                  )}
                  {(q.resto || hoy.resto) && (
                    <details>
                      <summary>Ver el detalle completo</summary>
                      <div class="mas">{[hoy.resto, q.resto].filter(Boolean).join('\n\n')}</div>
                    </details>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ))}

  {h.sin_fecha > 0 && h.sin_fecha < h.total && (
    <div class="mas">{h.sin_fecha} de los {h.total} todavía no tienen fecha. Te avisamos en cuanto la tengan.</div>
  )}
</div>

<div class="pieE">
  <div class="pl">Sacscloud</div>
  <div class="pieit">
    Este documento se generó con lo que hay en tu cuenta al {dLarga(h.periodo?.hasta)}.
    Si algo no coincide con lo que acordamos, dínoslo y lo corregimos.
  </div>
</div>
