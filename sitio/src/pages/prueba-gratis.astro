---
import { WHATSAPP_NUMBER } from '../lib/whatsapp';
// La "prueba gratis" ya NO usa un formulario que provisiona la cuenta sola.
// Cualquier botón de prueba gratis del sitio llega aquí y se redirige de
// inmediato a WhatsApp para SOLICITAR la prueba (proceso asistido por ventas).
// Se conserva el `ref` de partner (de /p/[slug]) dentro del mensaje.
export const prerender = false;

const WA_NUMBER = WHATSAPP_NUMBER;   // fuente única: src/lib/whatsapp.ts
const ref = (Astro.url.searchParams.get('ref') || '').trim().slice(0, 60);
const mensaje = `Hola 👋 Quiero solicitar una prueba gratis de SACS, por favor.${ref ? `\n\n(Referido por: ${ref})` : ''}`;
const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(mensaje)}`;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Prueba gratis — SACS</title>
  <meta http-equiv="refresh" content={`0;url=${waUrl}`} />
  <script define:vars={{ waUrl }}>window.location.replace(waUrl);</script>
  <style>
    :root { --ink:#16181d; --muted:#6b7280; --accent:#1A8F7A; --line:#e7e9ee; }
    * { box-sizing:border-box; }
    html,body { margin:0; padding:0; height:100%; }
    body {
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
      color:var(--ink); background:#f7f8fa; display:flex; align-items:center; justify-content:center;
      min-height:100vh; padding:24px; text-align:center;
    }
    .card { max-width:420px; width:100%; background:#fff; border:1px solid var(--line); border-radius:18px; padding:40px 32px; box-shadow:0 8px 40px rgba(16,24,40,0.06); }
    .card img { height:30px; margin-bottom:22px; }
    .wa { width:60px; height:60px; border-radius:16px; background:#25D366; display:flex; align-items:center; justify-content:center; margin:0 auto 18px; }
    h1 { font-size:1.3rem; font-weight:800; margin:0 0 8px; letter-spacing:-0.01em; }
    p { color:var(--muted); font-size:0.95rem; line-height:1.55; margin:0 0 22px; }
    .btn { display:inline-flex; align-items:center; gap:9px; background:#25D366; color:#fff; text-decoration:none; font-weight:700; font-size:1rem; padding:14px 26px; border-radius:12px; }
    .spin { width:20px; height:20px; border:2.5px solid rgba(0,0,0,0.12); border-top-color:var(--accent); border-radius:50%; display:inline-block; animation:sp 0.8s linear infinite; vertical-align:middle; margin-right:8px; }
    @keyframes sp { to { transform:rotate(360deg); } }
    .small { margin-top:18px; font-size:0.8rem; color:#9aa0a8; }
    .small a { color:var(--accent); text-decoration:none; }
  </style>
</head>
<body>
  <div class="card">
    <img src="/brand/sacs-wordmark-dark.svg" alt="SACS" />
    <div class="wa">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M17.5 14.4c-.3-.15-1.8-.9-2.1-1-.28-.1-.48-.15-.68.15-.2.3-.78 1-.96 1.2-.18.2-.35.22-.65.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.68-2.08-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.53.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.63-.93-2.23-.24-.58-.5-.5-.68-.5h-.58c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.1 3.2 5.08 4.5.71.3 1.26.48 1.7.62.71.22 1.36.2 1.87.12.57-.08 1.76-.72 2-1.42.25-.7.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.53 3.66 1.44 5.18L2 22l4.94-1.4A9.9 9.9 0 0012 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.7 0-3.28-.5-4.6-1.36l-.33-.2-2.93.83.8-2.86-.22-.35A7.94 7.94 0 014 12c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8z"/></svg>
    </div>
    <h1>Solicita tu prueba gratis</h1>
    <p><span class="spin"></span>Te estamos llevando a WhatsApp para activar tu prueba gratis con nuestro equipo.</p>
    <a class="btn" href={waUrl}>Abrir WhatsApp</a>
    <div class="small">¿No abre? <a href={waUrl}>Toca aquí</a> o escríbenos al +52 1 55 3663 4392.</div>
  </div>
</body>
</html>
