# La central de voz. Copiar a .env (nunca al repo).
PORT=8470
# El CRM que arma el prompt y ejecuta las herramientas (en el piloto local: http://127.0.0.1:4340)
CRM_BASE=https://www.sacscloud.com
# Secreto compartido con el CRM (VOZ_SECRET en sitio/.env y en Vercel)
VOZ_SECRET=
ANTHROPIC_API_KEY=
# Modelo que conversa (rápido) — el cierre lo hace el CRM con Sonnet
MODELO_VOZ=claude-haiku-4-5
