# La central de voz. Copiar a .env (nunca al repo).
PORT=8470
# El CRM que arma el prompt y ejecuta las herramientas (en el piloto local: http://127.0.0.1:4340)
CRM_BASE=https://www.sacscloud.com
# Secreto compartido con el CRM (VOZ_SECRET en sitio/.env y en Vercel)
VOZ_SECRET=
ANTHROPIC_API_KEY=
# Modelo que conversa (rápido) — el cierre lo hace el CRM con Sonnet
MODELO_VOZ=claude-haiku-4-5

# Motor voz-a-voz de OpenAI (Twilio Media Streams → /voz/media). Sin esta clave solo funciona ConversationRelay.
OPENAI_API_KEY=
MODELO_OPENAI=gpt-realtime-2.1
VOZ_OPENAI=marin
MODELO_TRANSCRIBE=gpt-4o-mini-transcribe
VAD_OPENAI=server          # server | semantic[:low|medium|high]
VAD_SILENCIO_MS=600
# DEBUG_OPENAI=1            # loguea cada evento de OpenAI (sin los deltas de audio)
